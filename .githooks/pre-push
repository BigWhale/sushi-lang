#!/usr/bin/env bash
# Pre-push quality gate: runs the FAST blocking checks CI does, so a push that
# would fail CI is stopped locally instead. Mirrors .github/workflows/test.yml
# stage 0 (lint/mypy) and stops there. The test suite is deliberately not here: it
# cost minutes on every push, and CI runs it on every push in any case.
#
# Install (once per clone):   git config core.hooksPath .githooks
# Bypass in an emergency:     git push --no-verify
set -u

# Run from the repository top level regardless of where the push was invoked.
TOPLEVEL="$(git rev-parse --show-toplevel)" || exit 1
cd "$TOPLEVEL" || exit 1

fail=0
# Git exports its own location variables to every hook it runs, and a push from a
# worktree sets GIT_DIR. GIT_DIR overrides an explicit -C, so any check that asks
# git about a path is answered about the repository being pushed instead. CI runs
# these same checks with none of it set, and this hook exists to predict CI, so it
# removes them here -- once, for every check.
run() {
  local label="$1"; shift
  echo "== pre-push: $label =="
  if ! env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_PREFIX "$@"; then
    echo "!! pre-push: $label FAILED"
    fail=1
  fi
}

# Ratcheted mypy package list -- keep in sync with test.yml.
MYPY_PKGS=(sushi_lang/internals sushi_lang/compiler sushi_lang/packager sushi_lang/sushi_stdlib)

run "ruff"   uv run ruff check sushi_lang tests .github/scripts docs/hooks docs/sushi-pygments
run "mypy"   uv run mypy "${MYPY_PKGS[@]}"

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "pre-push: blocking push -- fix the failures above or use 'git push --no-verify' to override."
  exit 1
fi
echo "pre-push: all checks passed."
exit 0
