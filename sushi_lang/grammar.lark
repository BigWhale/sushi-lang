?start: program

program: (_NEWLINE | DOC_BLOCK | toplevel)+
toplevel: use_stmt | const_def | var_def | struct_def | enum_def | perk_def | function_def | extend_stmt | external_block

const_def: PUBLIC? CONST type NAME "=" expr _NEWLINE
# Unit-level storage (docs/design/unit-storage.md): the same shape as a constant, and
# a different kind. A `const` has no address; a `var` has one.
var_def: PUBLIC? VAR type NAME "=" expr _NEWLINE
# `public use X` re-exports what X brings (docs/design/unit-namespaces.md section 8.1):
# the grammar takes the marker and an alias together, and the namespaces pass refuses
# the pair (CE3016), so the fault gets one located diagnostic and not a parse error.
use_stmt: PUBLIC? USE (stdlib_import | lib_import | user_import) [AS NAME] _NEWLINE
stdlib_import: LT use_path GT
lib_import: LT "lib" "/" use_path GT
user_import: STRING
use_path: NAME ("/" NAME)*
struct_def: PUBLIC? STRUCT NAME [type_params] ":" _NEWLINE _INDENT (DOC_BLOCK _NEWLINE | struct_field)+ _DEDENT
struct_field: type NAME _NEWLINE

enum_def: PUBLIC? ENUM NAME [type_params] ":" _NEWLINE _INDENT (DOC_BLOCK _NEWLINE | enum_variant)+ _DEDENT
# Generic type parameters, e.g. `struct Pair@(T, U):` / `fn id@(T)(T x) T:`.
type_params: AT "(" type_param_list ")"
type_param_list: type_param ("," type_param)*
type_param: ELLIPSIS? NAME [perk_constraints]
perk_constraints: ":" perk_constraint_list
perk_constraint_list: perk_constraint ("+" perk_constraint)*
perk_constraint: NAME ["." NAME]
enum_variant: NAME ["(" [enum_variant_fields] ")"] _NEWLINE
enum_variant_fields: type ("," type)*

perk_def: PUBLIC? PERK NAME [type_params] ":" _NEWLINE _INDENT (DOC_BLOCK _NEWLINE | perk_method)+ _DEDENT
perk_method: FN NAME "(" [parameters] ")" type ["|" type] _NEWLINE

// Foreign Function Interface (FFI) - unsafe external blocks
external_block: UNSAFE EXTERNAL STRING AS NAME [BECAUSE STRING] ":" _NEWLINE _INDENT (DOC_BLOCK _NEWLINE | extern_decl)+ _DEDENT
extern_decl: FN NAME "(" [ extern_params ] ")" type "=" STRING _NEWLINE
extern_params: typed_param ("," typed_param)* ["," ELLIPSIS]
             | ELLIPSIS

// Extension statements - unified to avoid LALR ambiguity
extend_stmt: EXTEND type extend_suffix
// The `static` marker declares a receiver-less method (#542, ruling Q2). It is read
// AFTER the target type, so a generic or namespaced target needs no lookahead. Inside
// an implementation block the marker exists only to be refused (CE4014): it must not
// ride the shared `function_def`, which also serves the top level and a nested
// statement. `method_name` widens the declaration slot the call site always had, so
// `extend Box static new(...)` is writable (ruling R3).
extend_suffix: WITH NAME ":" _NEWLINE _INDENT (DOC_BLOCK _NEWLINE | STATIC? function_def)+ _DEDENT  -> extend_with_def
             | STATIC? method_name [type_params] "(" [parameters] ")" type ["|" type] ":" block  -> extend_def

block: _NEWLINE _INDENT (_NEWLINE | DOC_BLOCK | statement)+ _DEDENT


function_def: PUBLIC? FN NAME [type_params] "(" [parameters] ")" type? ["|" type] ":" block

parameters: param ("," param)*
param: typed_param | variadic_param
     | BORROW_MODE NAME -> self_param
     | NOM NAME -> nom_self_param
typed_param: NOM? type NAME
variadic_param: ELLIPSIS type NAME

?statement: function_def
          | return_stmt
          | print_stmt
          | println_stmt
          | let_stmt
          | rebind_stmt
          | call_stmt
          | if_stmt
          | while_stmt
          | foreach_stmt
          | expand_stmt
          | match_stmt
          | break_stmt
          | continue_stmt


rebind_stmt: postfix ASSIGN_REBIND expr _NEWLINE

# `nom` marks a field TAKE (`return nom self.out`). The marker rides on the statement
# rather than on `?unary`, for the reason `nom_arg` states: at the expression level it
# would bind to the innermost operand and mark a cast's operand instead of the cast.
return_stmt: "return" NOM? expr _NEWLINE?
print_stmt: "print" "(" expr ")" _NEWLINE
println_stmt: "println" "(" expr ")" _NEWLINE

let_stmt: "let" [type] NAME "=" NOM? expr _NEWLINE
        | "let" [type] NAME "=" lambda_block       -> let_stmt
call_stmt: postfix _NEWLINE

if_stmt: IF "(" expr ")" ":" block elif_part* else_part?
elif_part: ELIF "(" expr ")" ":" block
else_part: ELSE ":" block

while_stmt: WHILE "(" expr ")" ":" block
// The `??` on the BINDER (`foreach(line?? in it)`) is the short form over a fallible
// iterator: the item is an ordinary Result and the marker propagates its Err, exactly
// as `??` does in any other position. A reference binding takes no marker -- a `peek`
// or `poke` binding points INTO storage, and there is nothing to unwrap there.
foreach_stmt: FOREACH "(" [type] NAME [DOUBLE_QUESTION] "in" expr ")" ":" block
            | FOREACH "(" BORROW_MODE NAME "in" expr ")" ":" block -> foreach_ref
expand_stmt: EXPAND "(" NAME "in" expr ")" ":" block

match_stmt: MATCH NOM? expr ":" _NEWLINE _INDENT match_arm+ _DEDENT
match_arm: (pattern | literal_pattern | wildcard_pattern) "->" (match_arm_inline | block)
literal_pattern: "-" (INT | HEX_INT | BIN_INT | OCT_INT) -> neg_literal_pattern
               | (INT | HEX_INT | BIN_INT | OCT_INT)
# A one-statement arm on the arrow. Every alternative here is a STATEMENT the
# block form already takes, plus a bare expression -- a rebind was the one missing
# and it is the shape a move out of a temporary wants (#552).
match_arm_inline: (return_stmt | print_stmt | println_stmt | call_stmt | rebind_stmt | break_stmt | continue_stmt | expr _NEWLINE)
pattern: [NAME "."] NAME "." NAME ["(" [pattern_list] ")"]
pattern_list: pattern_item ("," pattern_item)*
pattern_item: pattern | NAME | wildcard_pattern | own_pattern
            | BORROW_MODE NAME -> ref_binding
            | NOM NAME -> nom_binding
own_pattern: NAME "(" pattern_item ")"  -> own_pattern_call
wildcard_pattern: UNDERSCORE

break_stmt: BREAK _NEWLINE
continue_stmt: CONTINUE _NEWLINE

?type: BORROW_MODE type -> reference_t
     | FN "(" [fn_param_types] ")" "->" type ["|" type] -> fn_type_t
     | atom_type "[" array_size "]" -> array_t
     | atom_type "[" "]" -> dynamic_array_t
     | atom_type

?atom_type: "i8" -> i8_t
          | "i16" -> i16_t
          | "i32" -> i32_t
          | "i64" -> i64_t
          | "u8" -> u8_t
          | "u16" -> u16_t
          | "u32" -> u32_t
          | "u64" -> u64_t
          | "f32" -> f32_t
          | "f64" -> f64_t
          | "bool" -> bool_t
          | "string" -> string_t
          | "~" -> blank_t
          | NAME "." NAME AT "(" type_list ")" -> qualified_generic_type_t
          | NAME AT "(" type_list ")" -> generic_type_t
          | NAME "." NAME -> qualified_name_t
          | NAME -> name_t

type_list: type ("," type)*

# A fixed array's size: every base a numeric literal has, or the name of an integer
# constant. The builder reads it (CE2099); the grammar only says what may stand here.
array_size: INT | HEX_INT | BIN_INT | OCT_INT | NAME | NAME "." NAME

# A function type's parameter list carries a mode per parameter, unlike a generic
# argument list. `peek` / `poke` ride on the type; only `nom` needs a slot of its
# own (docs/design/borrow-model.md S6).
fn_param_types: fn_param_type ("," fn_param_type)*
fn_param_type: NOM? type

?expr: or_expr

or_expr: xor_expr (OR xor_expr)*
xor_expr: and_expr (XOR and_expr)*
and_expr: bitwise_or (AND bitwise_or)*
bitwise_or: bitwise_xor (BIT_OR bitwise_xor)*
bitwise_xor: bitwise_and (BIT_XOR bitwise_and)*
bitwise_and: equality (BIT_AND equality)*
equality: comparison ((EQEQ | NEQ) comparison)*
comparison: range ((LT | GT | LE | GE) range)*
range: shift ((RANGE | RANGE_INCLUSIVE) shift)?
shift: cast ((LSHIFT | RSHIFT) cast)*
cast: add (AS type)*
?add: mul ((PLUS | MINUS) mul)*
?mul: unary ((STAR | SLASH | MOD) unary)*

?unary: "-" unary        -> neg
      | NOT unary        -> not
      | BITNOT unary     -> bitnot
      | BORROW_MODE unary    -> borrow
      | postfix

?postfix: atom (call | method_call | member_access | index | try_op)*    -> maybe_call
# A call may carry explicit type arguments: `identity@(i32)(5)`. Free functions
# only -- `method_call` deliberately has no type-arg slot.
call: [AT "(" type_list ")"] "(" [args] ")"
method_call: "." method_name "(" [args] ")"
member_access: "." method_name
index: "[" expr "]"
try_op: DOUBLE_QUESTION
// A keyword after a DOT is a method name, never a statement: `new` has been admitted
// here since dynamic arrays, and `extend` joins it for `a.extend(b)` (#462). Contextual,
// so `extend i32 squared()` at statement position is unaffected.
method_name: NAME | NEW | EXTEND

?atom: FLOAT
     | HEX_INT
     | BIN_INT
     | OCT_INT
     | INT
     | TRUE
     | FALSE
     | STRING
     | CHAR_STRING
     | NAME
     | "~" -> blank_literal
     | "f64" -> f64_name
     | "f32" -> f32_name
     | array_literal
     | dynamic_array_new
     | dynamic_array_from
     | lambda_def
     | "(" expr ")"

// Lambda literals (closures). The opening `|` only appears where an atom is
// expected (prefix position), so it never collides with the infix bitwise-or
// `|` in `bitwise_or`. Zero-param form is `|~|` (a BITNOT `~` between the
// pipes) because the lexer munges `||` into a single OR token.
//
// Only the EXPRESSION-body lambda is a general expression (an `atom`). The
// BLOCK-body lambda (`|x|: <block>`) is NOT reachable through `expr`: it ends in
// a `_DEDENT` with no trailing `_NEWLINE`, so it is admitted only in the specific
// statement tails that can absorb a trailing block (currently a `let` RHS, see
// let_stmt). This keeps the newline-delimited statement model intact.
lambda_def: BIT_OR lambda_params BIT_OR expr       -> lambda_expr

lambda_block: BIT_OR lambda_params BIT_OR lambda_ret? ":" block

lambda_params: BITNOT                              -> lambda_no_params
             | lambda_param ("," lambda_param)*
lambda_param: NOM? type NAME    -> lambda_typed_param
            | NAME          -> lambda_bare_param
lambda_ret: "->" type ["|" type]

array_literal: "[" [array_elements] "]"
array_elements: array_element ("," array_element)*
// `value; count` repeats one element. It is an ELEMENT form, so runs and plain
// elements mix in one literal (#446, Ruling 2). `;` appears nowhere else.
array_element: expr (";" expr)?

dynamic_array_new: "new" "(" ")"
dynamic_array_from: "from" "(" array_literal ")"

// Arguments for function/struct calls
args: arg_list?

arg_list: positional_args
        | named_args

positional_args: positional_arg ("," positional_arg)*
?positional_arg: expr
              | expr ELLIPSIS   -> spread_arg
              | NOM expr        -> nom_arg

named_args: named_arg ("," named_arg)*
named_arg: NAME ":" expr

#
# Tokens
#
CONST: "const"
VAR.2: /var\b/
STRUCT: "struct"
ENUM: "enum"
PERK.2: /perk\b/
UNSAFE.2: /unsafe\b/
EXTERNAL.2: /external\b/
BECAUSE.2: /because\b/
FN: "fn"
EXTEND.2: /extend\b/
STATIC.2: /static\b/
WITH.2: /with\b/
USE: "use"
PUBLIC.2: /public\b/
MATCH: "match"
NEW: "new"

COMMENT: /#+[^\n]*/
// A doc block is ONE token, so the indenter never sees inside it and the
// interior layout is free. Two alternatives, one-liner first: a closer on the
// opening line, then a line-initial closer. A single lazy match enforces
// neither rule -- docs/design/documentation.md sections 2 and 4 measure what
// that costs. The priorities put DOC_BLOCK above COMMENT, which would
// otherwise claim a one-liner, and DOC_OPEN/DOC_CLOSE below DOC_BLOCK, so a
// bare delimiter matches only when a whole block could not.
DOC_BLOCK.10: /##:[^\n]*?:##|##:[\s\S]*?\n[ \t]*:##/
DOC_OPEN.5: /##:/
DOC_CLOSE.5: /:##/
// The inner group absorbs a run of full-line comments into the newline token
// itself, so it needs one lookahead: a doc block on its own line would
// otherwise be swallowed before any terminal priority applied.
_NEWLINE: /(\r?\n[ \t]*(?:#(?!#:)[^\n]*\r?\n[ \t]*)*)+/

TRUE: "true"
FALSE: "false"
STRING: /\"([^\"\\]|\\.)*\"/
CHAR_STRING: /'([^'\\]|\\.)*'/

ASSIGN_REBIND: ":="
UNDERSCORE: "_"
DOUBLE_QUESTION: "??"
AT: "@"

PLUS: "+"
MINUS: "-"
STAR: "*"
SLASH: "/"
MOD: "%"
EQEQ: "=="
NEQ.3: "!="
LE: "<="
GE: ">="
LT: "<"
GT: ">"
BIT_AND: "&"
BIT_OR: "|"
BIT_XOR: "^"
LSHIFT: "<<"
RSHIFT: ">>"
ELLIPSIS.4: "..."
RANGE_INCLUSIVE.3: "..="
RANGE.3: ".."

AND.2: /and\b/ | "&&"
OR.2: /or\b/ | "||"
XOR.2: /xor\b/ | "^^"
NOT.2: /not\b/ | "!"
BITNOT.2: "~"
IF.2: /if\b/
ELIF.2: /elif\b/
ELSE.2: /else\b/
WHILE.2: /while\b/
FOREACH.2: /foreach\b/
EXPAND.2: /expand\b/
BREAK.2: /break\b/
CONTINUE.2: /continue\b/
AS.2: /as\b/
BORROW_MODE.2: /peek\b/ | /poke\b/
NOM.2: /nom\b/

# A numeric terminal matches a PERMISSIVE superset: underscores anywhere in the
# digit runs. Placement is checked in `ast_builder/expressions/literals.py`, which
# is the one seam every consumer of these tokens goes through. The grammar cannot
# do it and still say WHY -- a terminal that simply failed to match reported the
# next token instead, so `0x_FF` came back as "unexpected token 'x_FF'" (CE6001).
# The rule the seam enforces: one underscore, between two digits.
#
# The explicit priorities keep the radix and float terminals ahead of INT, which
# they all overlap at a leading digit. INT is a terminal here rather than
# `%import common.INT` -- the stock one is /\d+/, which is why decimal was the
# one radix with no underscores at all.
HEX_INT.2: /0[xX][0-9a-fA-F_]+/
BIN_INT.2: /0[bB][01_]+/
OCT_INT.2: /0[oO][0-7_]+/
FLOAT.3: /\d[\d_]*\.[\d_]+([eE][+-]?[\d_]+)?|\d[\d_]*[eE][+-]?[\d_]+/
INT.1: /\d[\d_]*/

%import common.WS_INLINE
%import common.CNAME -> NAME

%declare _INDENT _DEDENT

%ignore WS_INLINE
%ignore COMMENT
// Ignored to keep Lark from deleting a terminal no rule names, never to
// discard one: reaching either delimiter is a diagnostic, raised from its
// lexer callback in `internals/parser.py`.
%ignore DOC_OPEN
%ignore DOC_CLOSE
