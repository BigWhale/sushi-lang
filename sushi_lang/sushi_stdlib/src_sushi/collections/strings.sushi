##:
Parses the text as a `i32` in the given base, strictly.

The text holds the digits of `base` and nothing else: no space, no `0x` or `0b` prefix,
no `_`, and it is not empty. A digit is `0`-`9`, then `a`-`z` or `A`-`Z` for 10 to 35.

One leading `-` is legal and nothing else: `+` is refused.

- Parameter base: The base, 2 to 36.
- Returns: `Maybe.Some(value)`, or `Maybe.None()` when the text is not a `i32` in that
  base, the value is out of range, or the base is outside 2 to 36.
- Example:
  ```sushi
  println("-7f".parse_i32(16).realise(0))
  ```
:##
extend string parse_i32(i32 base) Maybe@(i32):
    match strict_signed(self, base, 2147483647):
        Maybe.Some(v) -> return Maybe.Some(v as i32)
        Maybe.None -> return Maybe.None()

##:
Parses the text as a `i64` in the given base, strictly.

The text holds the digits of `base` and nothing else: no space, no `0x` or `0b` prefix,
no `_`, and it is not empty. A digit is `0`-`9`, then `a`-`z` or `A`-`Z` for 10 to 35.

One leading `-` is legal and nothing else: `+` is refused.

- Parameter base: The base, 2 to 36.
- Returns: `Maybe.Some(value)`, or `Maybe.None()` when the text is not a `i64` in that
  base, the value is out of range, or the base is outside 2 to 36.
- Example:
  ```sushi
  println("-7f".parse_i64(16).realise(0))
  ```
:##
extend string parse_i64(i32 base) Maybe@(i64):
    match strict_signed(self, base, 9223372036854775807):
        Maybe.Some(v) -> return Maybe.Some(v as i64)
        Maybe.None -> return Maybe.None()

##:
Copies the bytes from `start` to `end` of a string into a new string.

- Parameter s: The source text.
- Parameter start: The offset of the first byte to copy.
- Parameter end: The offset after the last byte to copy.
- Returns: A new string that holds the bytes of that range.
:##
fn cut_bytes(string s, i32 start, i32 end) string:
    let u8[] out = from([0; end - start])
    foreach(i in start..end):
        out[i - start] := s[i]
    return string.from_bytes(nom out)

##:
Tests if the bytes of `t` are in `s` at the offset `at`.

- Parameter s: The text to search.
- Parameter t: The bytes to find.
- Parameter at: The offset in `s`.
- Returns: True when `s` holds all the bytes of `t` from `at`.
:##
fn bytes_match_at(string s, string t, i32 at) bool:
    if (at < 0 or at + t.size() > s.size()):
        return false
    foreach(i in 0..t.size()):
        if (s[at + i] != t[i]):
            return false
    return true

##:
Tests if a byte is white space, with the set of `trim()`.

- Parameter b: The byte to test.
- Returns: True for the bytes 9 to 13 and 32.
:##
fn is_space_byte(u8 b) bool:
    return b == a' ' or (b >= a'\t' and b <= a'\r')

##:
Removes every repeat of `t` at the start of the text.

An empty `t` gives the text unchanged.

- Parameter t: The text to remove.
- Returns: A new string without the leading repeats of `t`.
- Example:
  ```sushi
  println("xxabc".trim_start_matches("x"))
  ```
:##
extend string trim_start_matches(string t) string:
    let i32 m = t.size()
    let i32 start = 0
    if (m > 0):
        while (bytes_match_at(self, t, start)):
            start := start + m
    return cut_bytes(self, start, self.size())

##:
Removes every repeat of `t` at the end of the text.

An empty `t` gives the text unchanged.

- Parameter t: The text to remove.
- Returns: A new string without the trailing repeats of `t`.
- Example:
  ```sushi
  println("a/b///".trim_end_matches("/"))
  ```
:##
extend string trim_end_matches(string t) string:
    let i32 m = t.size()
    let i32 end = self.size()
    if (m > 0):
        while (bytes_match_at(self, t, end - m)):
            end := end - m
    return cut_bytes(self, 0, end)

##:
Splits the text into lines.

The text is split at each `\n`. A `\r` immediately before the `\n` is removed, and a
`\r` anywhere else stays. A final `\n` does not start an empty last line, so `"a\n"`
gives one line and `""` gives none.

- Returns: The lines, each a new string without its line end.
- Example:
  ```sushi
  println("one\r\ntwo\n".lines().len())
  ```
:##
extend string lines() string[]:
    let string[] out = from([])
    let i32 n = self.size()
    let i32 start = 0
    foreach(i in 0..n):
        if (self[i] == a'\n'):
            let i32 end = i
            if (end > start and self[end - 1] == a'\r'):
                end := end - 1
            out.push(cut_bytes(self, start, end))
            start := i + 1
    if (start < n):
        out.push(cut_bytes(self, start, n))
    return out

##:
Splits the text at each run of white space.

White space is the set of `trim()`: the bytes 9 to 13 and 32. No token is empty, so a
text of white space alone gives no token.

- Returns: The tokens, each a new string.
- Example:
  ```sushi
  println(" Mostly \t Harmless ".split_whitespace().len())
  ```
:##
extend string split_whitespace() string[]:
    let string[] out = from([])
    let i32 n = self.size()
    let i32 start = -1
    foreach(i in 0..n):
        if (is_space_byte(self[i])):
            if (start >= 0):
                out.push(cut_bytes(self, start, i))
                start := -1
        elif (start < 0):
            start := i
    if (start >= 0):
        out.push(cut_bytes(self, start, n))
    return out

##:
Splits the text into its UTF-8 characters.

A character starts at each byte that is not a UTF-8 continuation byte, which is the
rule of `len()`, so `s.chars().len()` equals `s.len()`.

- Returns: One new string for each character, in order.
- Example:
  ```sushi
  println("caf\u00e9".chars().len())
  ```
:##
extend string chars() string[]:
    let string[] out = from([])
    let i32 n = self.size()
    let i32 start = -1
    foreach(i in 0..n):
        if ((self[i] & a'\xc0') != a'\x80'):
            if (start < 0):
                start := 0
            else:
                out.push(cut_bytes(self, start, i))
                start := i
    if (start >= 0):
        out.push(cut_bytes(self, start, n))
    return out

unsafe external "C" as libc because "printf rounding for to_fixed":
    fn snprintf(poke u8[] buf, i64 n, string fmt, ...) i32 = "snprintf"

##:
Writes an unsigned value in a base, with leading zeros to a width.

- Parameter v: The value.
- Parameter base: The base, 2 or 16.
- Parameter width: The least count of digits. A value of 0 or below adds no zero.
- Returns: The digits, lower case, as a new string.
:##
fn radix_digits(u64 v, u64 base, i32 width) string:
    let i32 count = 1
    let u64 rest = v / base
    while (rest > 0):
        count := count + 1
        rest := rest / base
    let i32 size = count
    if (width > size):
        size := width
    let u8[] out = from([a'0'; size])
    let u64 left = v
    let i32 i = size - 1
    while (left > 0):
        let u8 d = (left % base) as u8
        if (d < 10):
            out[i] := a'0' + d
        else:
            out[i] := a'a' + d - 10
        left := left / base
        i := i - 1
    return string.from_bytes(nom out)

##:
Writes a value with a count of digits after the point, through C `snprintf`.

- Parameter v: The value.
- Parameter p: The count of digits after the point. A value below 0 is 0.
- Returns: The text as a new string.
:##
fn fixed_digits(f64 v, i32 p) string:
    let i32 places = p
    if (places < 0):
        places := 0
    let u8[] probe = from([0; 1])
    let i32 need = libc.snprintf(poke probe, 1, "%.*f", places, v)
    let u8[] buf = from([0; need + 1])
    let i32 got = libc.snprintf(poke buf, (need + 1) as i64, "%.*f", places, v)
    buf.truncate(got)
    return string.from_bytes(nom buf)

##:
Writes the value in base 16, lower case, with no leading zero (`0` gives `"0"`).

- Returns: The digits as a new string.
- Example:
  ```sushi
  let u8 n = 10
  println(n.to_hex())
  ```
:##
extend u8 to_hex() string:
    return radix_digits(self as u64, 16, 0)

