##:
math -- the math module.

The free functions (`sqrt`, `pow`, `sin` and the others) and the constants `PI`, `E` and
`TAU` need `use <math>`. The methods of this file on the number types (`x.abs()`,
`a.min(b)`, `a.max(b)`, `a.divmod(b)`) need no import, because a method of a built-in
type needs none.
:##

unsafe external "C" as llvm because "the LLVM math intrinsics":
    fn sqrt(f64 x) f64 = "llvm.sqrt.f64"
    fn pow(f64 base, f64 exponent) f64 = "llvm.pow.f64"
    fn floor(f64 x) f64 = "llvm.floor.f64"
    fn ceil(f64 x) f64 = "llvm.ceil.f64"
    fn round(f64 x) f64 = "llvm.round.f64"
    fn trunc(f64 x) f64 = "llvm.trunc.f64"
    fn sin(f64 x) f64 = "llvm.sin.f64"
    fn cos(f64 x) f64 = "llvm.cos.f64"
    fn log(f64 x) f64 = "llvm.log.f64"
    fn log2(f64 x) f64 = "llvm.log2.f64"
    fn log10(f64 x) f64 = "llvm.log10.f64"
    fn exp(f64 x) f64 = "llvm.exp.f64"
    fn exp2(f64 x) f64 = "llvm.exp2.f64"
    fn fabs_f32(f32 a) f32 = "llvm.fabs.f32"
    fn fabs_f64(f64 a) f64 = "llvm.fabs.f64"
    fn minnum_f32(f32 a, f32 b) f32 = "llvm.minnum.f32"
    fn minnum_f64(f64 a, f64 b) f64 = "llvm.minnum.f64"
    fn maxnum_f32(f32 a, f32 b) f32 = "llvm.maxnum.f32"
    fn maxnum_f64(f64 a, f64 b) f64 = "llvm.maxnum.f64"

unsafe external "C" as libc because "the C library math functions":
    fn tan(f64 x) f64 = "tan"
    fn asin(f64 x) f64 = "asin"
    fn acos(f64 x) f64 = "acos"
    fn atan(f64 x) f64 = "atan"
    fn atan2(f64 y, f64 x) f64 = "atan2"
    fn sinh(f64 x) f64 = "sinh"
    fn cosh(f64 x) f64 = "cosh"
    fn tanh(f64 x) f64 = "tanh"
    fn hypot(f64 x, f64 y) f64 = "hypot"

##:
The ratio of the circumference of a circle to its diameter.
:##
public const f64 PI = 3.141592653589793

##:
The base of the natural logarithm.
:##
public const f64 E = 2.718281828459045

##:
Two times `PI`: one full turn, in radians.
:##
public const f64 TAU = 6.283185307179586

##:
Gives the square root of `x`. A negative `x` gives NaN.

- Parameter x: The value.
- Returns: The result, as an f64.
- Example:
  ```sushi
  println("{sqrt(9.0)}")
  ```
  This prints `3`.
:##
public fn sqrt(f64 x) f64:
    return llvm.sqrt(x)

##:
Gives `base` to the power `exponent`.

- Parameter base: The first value.
- Parameter exponent: The second value.
- Returns: The result, as an f64.
- Example:
  ```sushi
  println("{pow(2.0, 10.0)}")
  ```
  This prints `1024`.
:##
public fn pow(f64 base, f64 exponent) f64:
    return llvm.pow(base, exponent)

##:
Gives the largest whole number that is not more than `x`.

- Parameter x: The value.
- Returns: The result, as an f64.
- Example:
  ```sushi
  println("{floor(2.7)}")
  ```
  This prints `2`.
:##
public fn floor(f64 x) f64:
    return llvm.floor(x)

##:
Gives the smallest whole number that is not less than `x`.

- Parameter x: The value.
- Returns: The result, as an f64.
- Example:
  ```sushi
  println("{ceil(2.1)}")
  ```
  This prints `3`.
:##
public fn ceil(f64 x) f64:
    return llvm.ceil(x)

##:
Gives the whole number nearest to `x`. A half goes away from zero.

- Parameter x: The value.
- Returns: The result, as an f64.
- Example:
  ```sushi
  println("{round(2.5)}")
  ```
  This prints `3`.
:##
public fn round(f64 x) f64:
    return llvm.round(x)

##:
Gives `x` without its fraction, toward zero.

- Parameter x: The value.
- Returns: The result, as an f64.
- Example:
  ```sushi
  println("{trunc(-2.7)}")
  ```
  This prints `-2`.
:##
public fn trunc(f64 x) f64:
    return llvm.trunc(x)

