# toolchain/slib -- a .slib metadata reader, pure Sushi.
#
# The module ships as bundled .sushi source and is merged as a compilation
# unit when imported (`use <toolchain/slib>`). It reads the fixed 52-byte
# little-endian header and the msgpack metadata map of a version-4 .slib
# library. It mirrors the Python reader LibraryFormat.read_metadata_only and
# never reads a payload blob for its own sake; sizes reads only the two
# length fields that follow the metadata blob.
#
# Limitations: the four spare header fields are read and not validated. The
# reader targets metadata below 2 GiB; a hostile length casts to a negative
# count, reads nothing, and reports a decode error on the empty blob.

use <io/files>
use <io/fs>
public use <io/error>
use <encoding/msgpack>

##:
Why a .slib file could not be read.

`Io` carries the error of the open or of a read, so a directory, a file with no read
permission and a missing file each keep their own cause. `Truncated` is a file that
ends too early, and never a read that failed.
:##
public enum SlibError:
    Io(IoError)
    BadMagic()
    BadVersion(u32)
    Truncated()
    Decode(MpError)

# slib_le_uint: read nbytes little-endian bytes at off into a u64. The caller
# has already length-checked the buffer. The SlibError channel lets ?? compose.
fn slib_le_uint(peek u8[] h, i32 off, i32 nbytes) u64 | SlibError:
    let u64 acc = 0
    let i32 i = 0
    while (i < nbytes):
        acc := acc | ((h[off + i] as u64) << ((8 * i) as u64))
        i := i + 1
    return Result.Ok(acc)

# slib_open and slib_read: open() and read_bytes() with their IoError in the SlibError
# channel, so ?? composes.
fn slib_open(string path) File | SlibError:
    match open(path, FileMode.ReadB()):
        Result.Ok(nom f) -> return Result.Ok(f)
        Result.Err(e) -> return Result.Err(SlibError.Io(e))

fn slib_read(poke File f, i32 count) u8[] | SlibError:
    match f.read_bytes(count):
        Result.Ok(nom bytes) -> return Result.Ok(bytes)
        Result.Err(e) -> return Result.Err(SlibError.Io(e))

# slib_header_check: validate the magic and the version of a full 52-byte header.
fn slib_header_check(peek u8[] header) ~ | SlibError:
    let u8[] magic = from([0xf0, 0x9f, 0x8d, 0xa3, 0x53, 0x55, 0x53, 0x48, 0x49, 0x4c, 0x49, 0x42, 0xf0, 0x9f, 0x8d, 0xa3])
    let i32 i = 0
    while (i < 16):
        if (header[i] != magic[i]):
            return Result.Err(SlibError.BadMagic())
        i := i + 1
    let u64 version = slib_le_uint(peek header, 16, 4)??
    if (version != 4):
        return Result.Err(SlibError.BadVersion(version as u32))
    return Result.Ok(~)

# read_metadata: decode the metadata map of a .slib file into a MsgValue.
public fn read_metadata(string path) MsgValue | SlibError:
    let File f = slib_open(path)??
    let u8[] header = slib_read(poke f, 52)??
    if (header.len() < 52):
        return Result.Err(SlibError.Truncated())
    let i32 mlen = slib_le_uint(peek header, 44, 8)?? as i32
    let u8[] blob = slib_read(poke f, mlen)??
    slib_header_check(peek header)??
    if (blob.len() < mlen):
        return Result.Err(SlibError.Truncated())
    match decode(blob):
        Result.Ok(nom v) ->
            return Result.Ok(v)
        Result.Err(e) ->
            return Result.Err(SlibError.Decode(e))

# SlibSizes: the byte length of the two payload sections that follow the
# metadata blob. A source library records no bitcode, a binary one no source.
public struct SlibSizes:
    u64 source
    u64 bitcode

# sizes: the length of both payload sections, in one pass over the file.
# Container version 4 puts a length-prefixed SOURCE section between the metadata
# and the bitcode, so reaching the bitcode length means stepping over that
# section first. No report needs a blob itself, only its length.
public fn sizes(string path) SlibSizes | SlibError:
    let File f = slib_open(path)??
    let u8[] header = slib_read(poke f, 52)??
    if (header.len() < 52):
        return Result.Err(SlibError.Truncated())
    let i32 mlen = slib_le_uint(peek header, 44, 8)?? as i32
    let u8[] blob = slib_read(poke f, mlen)??
    let u8[] src_field = slib_read(poke f, 8)??
    if (src_field.len() < 8):
        slib_header_check(peek header)??
        return Result.Err(SlibError.Truncated())
    let u64 slen = slib_le_uint(peek src_field, 0, 8)??
    let u8[] src_blob = slib_read(poke f, slen as i32)??
    let u8[] size_field = slib_read(poke f, 8)??
    slib_header_check(peek header)??
    if (blob.len() < mlen):
        return Result.Err(SlibError.Truncated())
    if (src_blob.len() < (slen as i32)):
        return Result.Err(SlibError.Truncated())
    if (size_field.len() < 8):
        return Result.Err(SlibError.Truncated())
    let u64 bclen = slib_le_uint(peek size_field, 0, 8)??
    return Result.Ok(SlibSizes(slen, bclen))

# bitcode_size: the u64 length of the bitcode section alone.
public fn bitcode_size(string path) u64 | SlibError:
    let SlibSizes both = sizes(path)??
    return Result.Ok(both.bitcode)
