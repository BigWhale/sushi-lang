##:
A MessagePack decoder, written in Sushi. It decodes and does not encode.

`decode` reads one whole buffer as exactly one value, and gives a `MsgValue` tree. There
is no streaming entry. The `ext`, `fixext` and timestamp tags give
`MpError.Unsupported`. The buffer must be less than 2 GiB. The decoder compares each
length prefix with the bytes that are left when it reads the prefix. Thus a length that
the input cannot supply, `0xffffffff` included, is `Truncated` at the header.
:##

use <collections/strings>

##:
One decoded MessagePack value.

A map is two parallel arrays and not a hash table: a MessagePack key can be of any
kind, and the wire order stays visible.
:##
public enum MsgValue:
    ##: The `nil` value. :##
    Nil()
    ##: A `true` or `false` value. :##
    Bool(bool)
    ##: A signed integer, or an unsigned integer that fits in `i64`. :##
    Int(i64)
    ##: A `uint64` value that is more than the `i64` maximum. :##
    UInt(u64)
    ##: A float. A `float32` value widens to `f64`. :##
    Float(f64)
    ##: A string, validated as UTF-8. :##
    Str(string)
    ##: A binary payload. :##
    Bin(u8[])
    ##: An array of values, in wire order. :##
    Arr(MsgValue[])
    ##: A map: the keys and the values as parallel arrays, in wire order. :##
    Map(MsgValue[], MsgValue[])

##: Why a buffer did not decode. :##
public enum MpError:
    ##: The input ended. The payload is the offset of the read that could not complete. :##
    Truncated(i32)
    ##: The tag is ext, fixext, timestamp or `0xc1`. The payload is the tag byte. :##
    Unsupported(u8)
    ##: A string payload is not UTF-8. The payload is the offset after it. :##
    BadUtf8(i32)
    ##: Bytes stay after the root value. The payload is the offset of the first one. :##
    Trailing(i32)

##: The read position of the decoder in its buffer. :##
struct MpCursor:
    ##: The index of the next byte to read. :##
    i32 pos

##:
Reads the next byte.

- Parameter buf: The buffer.
- Parameter cur: The cursor. The read moves it one byte.
- Returns: The byte.
- Errors: `MpError.Truncated` at the end of the buffer.
:##
fn mp_take(peek u8[] buf, poke MpCursor cur) u8 | MpError:
    if (cur.pos >= buf.len()):
        return Result.Err(MpError.Truncated(cur.pos))
    let u8 b = buf[cur.pos]
    cur.pos := cur.pos + 1
    return Result.Ok(b)

##:
Reads an unsigned big-endian integer.

- Parameter buf: The buffer.
- Parameter cur: The cursor. The read moves it `nbytes` bytes.
- Parameter nbytes: The width in bytes: 1, 2, 4 or 8.
- Returns: The integer.
- Errors: `MpError.Truncated` when the buffer ends first.
:##
fn mp_be_uint(peek u8[] buf, poke MpCursor cur, i32 nbytes) u64 | MpError:
    let u64 acc = 0
    foreach(_ in 0..nbytes):
        let u8 b = mp_take(peek buf, poke cur)??
        acc := (acc << 8) | (b as u64)
    return Result.Ok(acc)

##:
Reads a length prefix as a count.

An element of an array or a map needs one byte or more, and a str or bin payload needs
exactly its count. Thus no count can be more than the bytes that are left. This function
refuses such a count where it reads it, so a length of 2^31 or more cannot cast to a
negative count and decode as an empty value.

- Parameter buf: The buffer.
- Parameter cur: The cursor. The read moves it `nbytes` bytes.
- Parameter nbytes: The width of the prefix in bytes: 1, 2 or 4.
- Returns: The count.
- Errors: `MpError.Truncated` when the count is more than the bytes that are left.
:##
fn mp_len(peek u8[] buf, poke MpCursor cur, i32 nbytes) i32 | MpError:
    let u64 raw = mp_be_uint(peek buf, poke cur, nbytes)??
    let u64 left = (buf.len() - cur.pos) as u64
    if (raw > left):
        return Result.Err(MpError.Truncated(cur.pos))
    return Result.Ok(raw as i32)

##:
Reads an unsigned value of a given width as a two's complement value.

This function does not fail. It has the `MpError` channel, so the dispatch can use `??`.

- Parameter v: The unsigned value.
- Parameter nbytes: The width in bytes: 1, 2, 4 or 8.
- Returns: The signed value.
- Errors: None.
:##
fn mp_signed(u64 v, i32 nbytes) i64 | MpError:
    if (nbytes == 8):
        return Result.Ok(v as i64)
    let i64 sv = v as i64
    let i64 half = 1
    half := half << (((8 * nbytes) - 1) as i64)
    if (sv >= half):
        return Result.Ok(sv - (half * 2))
    return Result.Ok(sv)

##:
Copies the next bytes into a new array.

`.ss()` clamps a range that goes past the end, so this function does the bounds check
itself. The fixstr path gets here with no `mp_len` check.

- Parameter buf: The buffer.
- Parameter cur: The cursor. The read moves it `count` bytes.
- Parameter count: The number of bytes to copy.
- Returns: The bytes.
- Errors: `MpError.Truncated` at the end of the buffer when it is too short.
:##
fn mp_take_bytes(peek u8[] buf, poke MpCursor cur, i32 count) u8[] | MpError:
    if (count > buf.len() - cur.pos):
        return Result.Err(MpError.Truncated(cur.pos))
    let u8[] out = buf.ss(cur.pos, count)
    cur.pos := cur.pos + count
    return Result.Ok(out)

##:
Reads a string payload and validates it as UTF-8.

- Parameter buf: The buffer.
- Parameter cur: The cursor. The read moves it `count` bytes.
- Parameter count: The length of the payload in bytes.
- Returns: A `MsgValue.Str`.
- Errors: `MpError.Truncated` or `MpError.BadUtf8`.
:##
fn mp_take_str(peek u8[] buf, poke MpCursor cur, i32 count) MsgValue | MpError:
    let u8[] raw = mp_take_bytes(peek buf, poke cur, count)??
    match raw.to_string_checked():
        Result.Ok(nom s) ->
            return Result.Ok(MsgValue.Str(s))
        Result.Err(_) ->
            return Result.Err(MpError.BadUtf8(cur.pos))

##:
Decodes the elements of an array.

- Parameter buf: The buffer.
- Parameter cur: The cursor. It moves past each element.
- Parameter count: The number of elements.
- Returns: A `MsgValue.Arr`.
- Errors: The first error of an element.
:##
fn mp_take_arr(peek u8[] buf, poke MpCursor cur, i32 count) MsgValue | MpError:
    let MsgValue[] items = from([])
    foreach(_ in 0..count):
        let MsgValue child = mp_decode_value(peek buf, poke cur)??
        items.push(child)
    return Result.Ok(MsgValue.Arr(items))

##:
Decodes the key and value pairs of a map into parallel arrays, in wire order.

- Parameter buf: The buffer.
- Parameter cur: The cursor. It moves past each key and each value.
- Parameter count: The number of pairs.
- Returns: A `MsgValue.Map`.
- Errors: The first error of a key or a value.
:##
fn mp_take_map(peek u8[] buf, poke MpCursor cur, i32 count) MsgValue | MpError:
    let MsgValue[] keys = from([])
    let MsgValue[] vals = from([])
    foreach(_ in 0..count):
        let MsgValue k = mp_decode_value(peek buf, poke cur)??
        keys.push(k)
        let MsgValue v = mp_decode_value(peek buf, poke cur)??
        vals.push(v)
    return Result.Ok(MsgValue.Map(keys, vals))

##:
Reads one tag byte and decodes one value.

The fix families (fixint, fixmap, fixarray, fixstr, negative fixint) are ranges of tags,
so each one has an `if` guard. Each single-byte tag has an arm in the `match`.

- Parameter buf: The buffer.
- Parameter cur: The cursor. It moves past the value.
- Returns: The value.
- Errors: An `MpError` that names the fault.
:##
fn mp_decode_value(peek u8[] buf, poke MpCursor cur) MsgValue | MpError:
    let u8 t = mp_take(peek buf, poke cur)??
    if (t <= 0x7f):
        return Result.Ok(MsgValue.Int(t as i64))
    if (t <= 0x8f):
        return Result.Ok(mp_take_map(peek buf, poke cur, (t & 0x0f) as i32)??)
    if (t <= 0x9f):
        return Result.Ok(mp_take_arr(peek buf, poke cur, (t & 0x0f) as i32)??)
    if (t <= 0xbf):
        return Result.Ok(mp_take_str(peek buf, poke cur, (t & 0x1f) as i32)??)
    if (t >= 0xe0):
        return Result.Ok(MsgValue.Int((t as i64) - 256))
    match t:
        0xc0 ->
            return Result.Ok(MsgValue.Nil())
        0xc2 ->
            return Result.Ok(MsgValue.Bool(false))
        0xc3 ->
            return Result.Ok(MsgValue.Bool(true))
        0xc4 ->
            let i32 n8 = mp_len(peek buf, poke cur, 1)??
            return Result.Ok(MsgValue.Bin(mp_take_bytes(peek buf, poke cur, n8)??))
        0xc5 ->
            let i32 n16 = mp_len(peek buf, poke cur, 2)??
            return Result.Ok(MsgValue.Bin(mp_take_bytes(peek buf, poke cur, n16)??))
        0xc6 ->
            let i32 n32 = mp_len(peek buf, poke cur, 4)??
            return Result.Ok(MsgValue.Bin(mp_take_bytes(peek buf, poke cur, n32)??))
        0xca ->
            let u64 bits32 = mp_be_uint(peek buf, poke cur, 4)??
            let f32 single = f32.from_bits(bits32 as u32)
            return Result.Ok(MsgValue.Float(single as f64))
        0xcb ->
            let u64 bits64 = mp_be_uint(peek buf, poke cur, 8)??
            return Result.Ok(MsgValue.Float(f64.from_bits(bits64)))
        0xcc ->
            return Result.Ok(MsgValue.Int(mp_be_uint(peek buf, poke cur, 1)?? as i64))
        0xcd ->
            return Result.Ok(MsgValue.Int(mp_be_uint(peek buf, poke cur, 2)?? as i64))
        0xce ->
            return Result.Ok(MsgValue.Int(mp_be_uint(peek buf, poke cur, 4)?? as i64))
        0xcf ->
            let u64 big = mp_be_uint(peek buf, poke cur, 8)??
            let u64 i64_max = 0x7fff_ffff_ffff_ffff
            if (big > i64_max):
                return Result.Ok(MsgValue.UInt(big))
            return Result.Ok(MsgValue.Int(big as i64))
        0xd0 ->
            return Result.Ok(MsgValue.Int(mp_signed(mp_be_uint(peek buf, poke cur, 1)??, 1)??))
        0xd1 ->
            return Result.Ok(MsgValue.Int(mp_signed(mp_be_uint(peek buf, poke cur, 2)??, 2)??))
        0xd2 ->
            return Result.Ok(MsgValue.Int(mp_signed(mp_be_uint(peek buf, poke cur, 4)??, 4)??))
        0xd3 ->
            return Result.Ok(MsgValue.Int(mp_signed(mp_be_uint(peek buf, poke cur, 8)??, 8)??))
        0xd9 ->
            let i32 s8 = mp_len(peek buf, poke cur, 1)??
            return Result.Ok(mp_take_str(peek buf, poke cur, s8)??)
        0xda ->
            let i32 s16 = mp_len(peek buf, poke cur, 2)??
            return Result.Ok(mp_take_str(peek buf, poke cur, s16)??)
        0xdb ->
            let i32 s32 = mp_len(peek buf, poke cur, 4)??
            return Result.Ok(mp_take_str(peek buf, poke cur, s32)??)
        0xdc ->
            let i32 a16 = mp_len(peek buf, poke cur, 2)??
            return Result.Ok(mp_take_arr(peek buf, poke cur, a16)??)
        0xdd ->
            let i32 a32 = mp_len(peek buf, poke cur, 4)??
            return Result.Ok(mp_take_arr(peek buf, poke cur, a32)??)
        0xde ->
            let i32 m16 = mp_len(peek buf, poke cur, 2)??
            return Result.Ok(mp_take_map(peek buf, poke cur, m16)??)
        0xdf ->
            let i32 m32 = mp_len(peek buf, poke cur, 4)??
            return Result.Ok(mp_take_map(peek buf, poke cur, m32)??)
        _ ->
            return Result.Err(MpError.Unsupported(t))

##:
Decodes one whole buffer as exactly one value.

- Parameter buf: The MessagePack bytes.
- Returns: The value tree.
- Errors: `MpError.Trailing` when bytes stay after the root value, and the other
  `MpError` variants when the value does not decode.
- Example:
```sushi
let u8[] buf = from([0x82, 0xa1, 0x61, 0x01, 0xa1, 0x62, 0x91, 0x02])
match decode(buf):
    Result.Ok(v) -> println(show(v)??)
    Result.Err(_) -> println("decode error")
```
:##
public fn decode(u8[] buf) MsgValue | MpError:
    let MpCursor cur = MpCursor(0)
    let MsgValue v = mp_decode_value(peek buf, poke cur)??
    if (cur.pos < buf.len()):
        return Result.Err(MpError.Trailing(cur.pos))
    return Result.Ok(v)

##:
Tells if a map key is the string `key`. A key of a different kind does not match.

- Parameter k: The map key.
- Parameter key: The string to compare.
- Returns: True when the key matches.
:##
fn mp_is_key(MsgValue k, string key) bool:
    match k:
        MsgValue.Str(s) -> return Result.Ok(s == key)
        _ -> return Result.Ok(false)

##:
The position of a string key in a map.

The scan goes in wire order, and the first key that matches wins. Use the position to
borrow the value in place (`vals[i]` inside a `MsgValue.Map(keys, vals)` arm) instead of
a copy of it.

- Parameter m: The map to scan.
- Parameter key: The string key to find.
- Returns: The position of the key, or `Maybe.None()` when the key is absent or `m` is not
  a map.
:##
public fn map_index(MsgValue m, string key) Maybe@(i32):
    match m:
        MsgValue.Map(keys, _) ->
            foreach(i in 0..keys.len()):
                if (mp_is_key(keys[i], key)??):
                    return Result.Ok(Maybe.Some(i))
            return Result.Ok(Maybe.None())
        _ ->
            return Result.Ok(Maybe.None())

##:
The value under a string key, as a deep copy. The tree does not change.

To read a string or a bool, use `map_get_str` or `map_get_bool`. To walk a subtree
without a copy, use `map_index`.

- Parameter m: The map to read.
- Parameter key: The string key to find.
- Returns: A copy of the value, or `Maybe.None()` when the key is absent or `m` is not a map.
:##
public fn map_get(MsgValue m, string key) Maybe@(MsgValue):
    match m:
        MsgValue.Map(_, vals) ->
            match map_index(m, key)??:
                Maybe.Some(i) -> return Result.Ok(Maybe.Some(vals[i].clone()))
                Maybe.None() -> return Result.Ok(Maybe.None())
        _ ->
            return Result.Ok(Maybe.None())

##:
The string under a string key. Only the string is copied, never the map.

- Parameter m: The map to read.
- Parameter key: The string key to find.
- Returns: The `Str` payload, or `Maybe.None()` when the key is absent, its value is not a
  `Str`, or `m` is not a map.
:##
public fn map_get_str(MsgValue m, string key) Maybe@(string):
    match m:
        MsgValue.Map(_, vals) ->
            match map_index(m, key)??:
                Maybe.Some(i) ->
                    match vals[i]:
                        MsgValue.Str(s) -> return Result.Ok(Maybe.Some(s.clone()))
                        _ -> return Result.Ok(Maybe.None())
                Maybe.None() -> return Result.Ok(Maybe.None())
        _ ->
            return Result.Ok(Maybe.None())

##:
The bool under a string key.

- Parameter m: The map to read.
- Parameter key: The string key to find.
- Returns: The `Bool` payload, or `Maybe.None()` when the key is absent, its value is not a
  `Bool`, or `m` is not a map.
:##
public fn map_get_bool(MsgValue m, string key) Maybe@(bool):
    match m:
        MsgValue.Map(_, vals) ->
            match map_index(m, key)??:
                Maybe.Some(i) ->
                    match vals[i]:
                        MsgValue.Bool(b) -> return Result.Ok(Maybe.Some(b))
                        _ -> return Result.Ok(Maybe.None())
                Maybe.None() -> return Result.Ok(Maybe.None())
        _ ->
            return Result.Ok(Maybe.None())

##:
Writes a value on one line. The output is the same on each run.

A float shows its raw IEEE-754 bits, so the output does not depend on float formatting.
A string shows between double quotes, with no escapes.

- Parameter v: The value to show.
- Returns: The text.
:##
public fn show(MsgValue v) string:
    match v:
        MsgValue.Nil() ->
            return Result.Ok("nil")
        MsgValue.Bool(b) ->
            if (b):
                return Result.Ok("true")
            return Result.Ok("false")
        MsgValue.Int(n) ->
            return Result.Ok("{n}")
        MsgValue.UInt(n) ->
            return Result.Ok("{n}u")
        MsgValue.Float(x) ->
            return Result.Ok("f64({x.to_bits()})")
        MsgValue.Str(s) ->
            return Result.Ok("\"{s}\"")
        MsgValue.Bin(bytes) ->
            let string[] bin_parts = from([])
            foreach(b in bytes.iter()):
                bin_parts.push("{b}")
            let string bin_body = ",".join(bin_parts)
            return Result.Ok("bin({bin_body})")
        MsgValue.Arr(items) ->
            let string[] arr_parts = from([])
            foreach(item in items.iter()):
                arr_parts.push(show(item)??)
            let string arr_body = ",".join(arr_parts)
            return Result.Ok("[{arr_body}]")
        MsgValue.Map(keys, vals) ->
            let string open_brace = '{'
            let string close_brace = '}'
            let string[] map_parts = from([])
            foreach(k in 0..keys.len()):
                let string ks = show(keys[k])??
                let string vs = show(vals[k])??
                map_parts.push("{ks}:{vs}")
            let string map_body = ",".join(map_parts)
            return Result.Ok("{open_brace}{map_body}{close_brace}")
