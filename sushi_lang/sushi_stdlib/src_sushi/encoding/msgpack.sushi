# encoding/msgpack -- a MessagePack decoder, pure Sushi, decode-only.
#
# The module ships as bundled .sushi source and is merged as a compilation unit
# when imported (`use <encoding/msgpack>`). It decodes one whole buffer into a
# MsgValue tree. There is no encoder and no streaming entry.
#
# Limitations: ext, fixext and timestamp tags give MpError.Unsupported. The
# decoder targets buffers below 2 GiB. A length prefix is checked against what
# is left in the buffer as it is read, so a length too large to satisfy -- a
# hostile 2^32-1 included -- is Truncated at the header (#463).

public enum MsgValue:
    Nil()
    Bool(bool)
    Int(i64)
    UInt(u64)
    Float(f64)
    Str(string)
    Bin(u8[])
    Arr(MsgValue[])
    Map(MsgValue[], MsgValue[])

public enum MpError:
    Truncated(i32)
    Unsupported(u8)
    BadUtf8(i32)
    Trailing(i32)

struct MpCursor:
    i32 pos

# mp_take: the next byte, or Truncated. The one place bounds are checked.
fn mp_take(peek u8[] buf, poke MpCursor cur) u8 | MpError:
    if (cur.pos >= buf.len()):
        return Result.Err(MpError.Truncated(cur.pos))
    let u8 b = buf[cur.pos]
    cur.pos := cur.pos + 1
    return Result.Ok(b)

# mp_be_uint: read nbytes big-endian bytes into a u64 (nbytes in 1, 2, 4, 8).
fn mp_be_uint(peek u8[] buf, poke MpCursor cur, i32 nbytes) u64 | MpError:
    let u64 acc = 0
    let i32 i = 0
    while (i < nbytes):
        let u8 b = mp_take(peek buf, poke cur)??
        acc := (acc << 8) | (b as u64)
        i := i + 1
    return Result.Ok(acc)

# mp_len: a length prefix as a count. Every element of an array or a map needs
# at least one byte, and a str or bin payload needs exactly its count, so a
# count above what is left in the buffer cannot be satisfied by any of the four
# families. Rejecting it where it is read is what keeps a length at or above
# 2^31 from casting to a negative count and decoding as an empty value (#463).
fn mp_len(peek u8[] buf, poke MpCursor cur, i32 nbytes) i32 | MpError:
    let u64 raw = mp_be_uint(peek buf, poke cur, nbytes)??
    let u64 left = (buf.len() - cur.pos) as u64
    if (raw > left):
        return Result.Err(MpError.Truncated(cur.pos))
    return Result.Ok(raw as i32)

# mp_signed: reinterpret a width-limited unsigned value as two's complement.
# It cannot fail; it shares the MpError channel so ?? composes in the dispatch.
fn mp_signed(u64 v, i32 nbytes) i64 | MpError:
    if (nbytes == 8):
        return Result.Ok(v as i64)
    let i64 sv = v as i64
    let i64 half = 1
    half := half << (((8 * nbytes) - 1) as i64)
    if (sv >= half):
        return Result.Ok(sv - (half * 2))
    return Result.Ok(sv)

# mp_take_bytes: copy the next count bytes into a fresh owned array.
fn mp_take_bytes(peek u8[] buf, poke MpCursor cur, i32 count) u8[] | MpError:
    let u8[] out = new()
    let i32 i = 0
    while (i < count):
        let u8 b = mp_take(peek buf, poke cur)??
        out.push(b)
        i := i + 1
    return Result.Ok(out)

# mp_take_str: read count payload bytes and validate them as UTF-8.
fn mp_take_str(peek u8[] buf, poke MpCursor cur, i32 count) MsgValue | MpError:
    let u8[] raw = mp_take_bytes(peek buf, poke cur, count)??
    match raw.to_string_checked():
        Result.Ok(s) ->
            return Result.Ok(MsgValue.Str(s.clone()))
        Result.Err(_) ->
            return Result.Err(MpError.BadUtf8(cur.pos))

# mp_take_arr: decode count child values into an Arr.
fn mp_take_arr(peek u8[] buf, poke MpCursor cur, i32 count) MsgValue | MpError:
    let MsgValue[] items = new()
    let i32 i = 0
    while (i < count):
        let MsgValue child = mp_decode_value(peek buf, poke cur)??
        items.push(child)
        i := i + 1
    return Result.Ok(MsgValue.Arr(items))

# mp_take_map: decode count key/value pairs into parallel arrays, wire order.
fn mp_take_map(peek u8[] buf, poke MpCursor cur, i32 count) MsgValue | MpError:
    let MsgValue[] keys = new()
    let MsgValue[] vals = new()
    let i32 i = 0
    while (i < count):
        let MsgValue k = mp_decode_value(peek buf, poke cur)??
        keys.push(k)
        let MsgValue v = mp_decode_value(peek buf, poke cur)??
        vals.push(v)
        i := i + 1
    return Result.Ok(MsgValue.Map(keys, vals))

# mp_decode_value: dispatch one tag byte and decode one value. The fix families
# (fixint, fixmap, fixarray, fixstr, negative fixint) are RANGES, so they stay
# as guards; every single-byte tag dispatches through the match.
fn mp_decode_value(peek u8[] buf, poke MpCursor cur) MsgValue | MpError:
    let u8 t = mp_take(peek buf, poke cur)??
    if (t <= 0x7f):
        return Result.Ok(MsgValue.Int(t as i64))
    if (t <= 0x8f):
        return Result.Ok(mp_take_map(peek buf, poke cur, (t & 0x0f) as i32)??)
    if (t <= 0x9f):
        return Result.Ok(mp_take_arr(peek buf, poke cur, (t & 0x0f) as i32)??)
    if (t <= 0xbf):
        return Result.Ok(mp_take_str(peek buf, poke cur, (t & 0x1f) as i32)??)
    if (t >= 0xe0):
        return Result.Ok(MsgValue.Int((t as i64) - 256))
    match t:
        0xc0 ->
            return Result.Ok(MsgValue.Nil())
        0xc2 ->
            return Result.Ok(MsgValue.Bool(false))
        0xc3 ->
            return Result.Ok(MsgValue.Bool(true))
        0xc4 ->
            let i32 n8 = mp_len(peek buf, poke cur, 1)??
            return Result.Ok(MsgValue.Bin(mp_take_bytes(peek buf, poke cur, n8)??))
        0xc5 ->
            let i32 n16 = mp_len(peek buf, poke cur, 2)??
            return Result.Ok(MsgValue.Bin(mp_take_bytes(peek buf, poke cur, n16)??))
        0xc6 ->
            let i32 n32 = mp_len(peek buf, poke cur, 4)??
            return Result.Ok(MsgValue.Bin(mp_take_bytes(peek buf, poke cur, n32)??))
        0xca ->
            let u64 bits32 = mp_be_uint(peek buf, poke cur, 4)??
            let f32 single = f32.from_bits(bits32 as u32)
            return Result.Ok(MsgValue.Float(single as f64))
        0xcb ->
            let u64 bits64 = mp_be_uint(peek buf, poke cur, 8)??
            return Result.Ok(MsgValue.Float(f64.from_bits(bits64)))
        0xcc ->
            return Result.Ok(MsgValue.Int(mp_be_uint(peek buf, poke cur, 1)?? as i64))
        0xcd ->
            return Result.Ok(MsgValue.Int(mp_be_uint(peek buf, poke cur, 2)?? as i64))
        0xce ->
            return Result.Ok(MsgValue.Int(mp_be_uint(peek buf, poke cur, 4)?? as i64))
        0xcf ->
            let u64 big = mp_be_uint(peek buf, poke cur, 8)??
            let u64 i64_max = 0x7fffffffffffffff
            if (big > i64_max):
                return Result.Ok(MsgValue.UInt(big))
            return Result.Ok(MsgValue.Int(big as i64))
        0xd0 ->
            return Result.Ok(MsgValue.Int(mp_signed(mp_be_uint(peek buf, poke cur, 1)??, 1)??))
        0xd1 ->
            return Result.Ok(MsgValue.Int(mp_signed(mp_be_uint(peek buf, poke cur, 2)??, 2)??))
        0xd2 ->
            return Result.Ok(MsgValue.Int(mp_signed(mp_be_uint(peek buf, poke cur, 4)??, 4)??))
        0xd3 ->
            return Result.Ok(MsgValue.Int(mp_signed(mp_be_uint(peek buf, poke cur, 8)??, 8)??))
        0xd9 ->
            let i32 s8 = mp_len(peek buf, poke cur, 1)??
            return Result.Ok(mp_take_str(peek buf, poke cur, s8)??)
        0xda ->
            let i32 s16 = mp_len(peek buf, poke cur, 2)??
            return Result.Ok(mp_take_str(peek buf, poke cur, s16)??)
        0xdb ->
            let i32 s32 = mp_len(peek buf, poke cur, 4)??
            return Result.Ok(mp_take_str(peek buf, poke cur, s32)??)
        0xdc ->
            let i32 a16 = mp_len(peek buf, poke cur, 2)??
            return Result.Ok(mp_take_arr(peek buf, poke cur, a16)??)
        0xdd ->
            let i32 a32 = mp_len(peek buf, poke cur, 4)??
            return Result.Ok(mp_take_arr(peek buf, poke cur, a32)??)
        0xde ->
            let i32 m16 = mp_len(peek buf, poke cur, 2)??
            return Result.Ok(mp_take_map(peek buf, poke cur, m16)??)
        0xdf ->
            let i32 m32 = mp_len(peek buf, poke cur, 4)??
            return Result.Ok(mp_take_map(peek buf, poke cur, m32)??)
        _ ->
            return Result.Err(MpError.Unsupported(t))

# decode: decode one whole buffer as exactly one value.
public fn decode(u8[] buf) MsgValue | MpError:
    let MpCursor cur = MpCursor(0)
    let MsgValue v = mp_decode_value(peek buf, poke cur)??
    if (cur.pos < buf.len()):
        return Result.Err(MpError.Trailing(cur.pos))
    return Result.Ok(v)

# map_get: scan a Map in wire order for a string key; clone the value out.
public fn map_get(MsgValue m, string key) Maybe@(MsgValue):
    match m:
        MsgValue.Map(keys, vals) ->
            let i32 i = 0
            while (i < keys.len()):
                match keys[i]:
                    MsgValue.Str(s) ->
                        if (s == key):
                            return Result.Ok(Maybe.Some(vals[i].clone()))
                        i := i + 1
                    _ ->
                        i := i + 1
            return Result.Ok(Maybe.None())
        _ ->
            return Result.Ok(Maybe.None())

# show: render a value on one line. Deterministic: floats print their raw
# IEEE-754 bits, strings print unescaped between plain double quotes.
public fn show(MsgValue v) string:
    match v:
        MsgValue.Nil() ->
            return Result.Ok("nil")
        MsgValue.Bool(b) ->
            if (b):
                return Result.Ok("true")
            return Result.Ok("false")
        MsgValue.Int(n) ->
            return Result.Ok("{n}")
        MsgValue.UInt(n) ->
            return Result.Ok("{n}u")
        MsgValue.Float(x) ->
            return Result.Ok("f64({x.to_bits()})")
        MsgValue.Str(s) ->
            return Result.Ok("\"{s}\"")
        MsgValue.Bin(bytes) ->
            let string bin_body = ""
            let i32 i = 0
            while (i < bytes.len()):
                let u8 b = bytes[i]
                if (i == 0):
                    bin_body := "{b}"
                else:
                    bin_body := "{bin_body},{b}"
                i := i + 1
            return Result.Ok("bin({bin_body})")
        MsgValue.Arr(items) ->
            let string arr_body = ""
            let i32 j = 0
            while (j < items.len()):
                let string shown = show(items[j])??
                if (j == 0):
                    arr_body := shown
                else:
                    arr_body := "{arr_body},{shown}"
                j := j + 1
            return Result.Ok("[{arr_body}]")
        MsgValue.Map(keys, vals) ->
            let string open_brace = '{'
            let string close_brace = '}'
            let string map_body = ""
            let i32 k = 0
            while (k < keys.len()):
                let string ks = show(keys[k])??
                let string vs = show(vals[k])??
                if (k == 0):
                    map_body := "{ks}:{vs}"
                else:
                    map_body := "{map_body},{ks}:{vs}"
                k := k + 1
            return Result.Ok("{open_brace}{map_body}{close_brace}")
