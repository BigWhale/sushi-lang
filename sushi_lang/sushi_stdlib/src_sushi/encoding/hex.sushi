##:
encoding/hex -- hexadecimal text of bytes and back, opt in with `use <encoding/hex>`.

`encode` writes two lower-case digits for each byte. `decode` reads upper and lower case
digits, two for each byte.
:##

##: The digits of `encode`, in the order of their values. :##
const string DIGITS = "0123456789abcdef"

##: Why a text did not decode. :##
public error HexError:
    ##: The text holds an odd count of digits. :##
    OddLength
    ##: A byte of the text is not a hex digit. The payload is its offset. :##
    BadDigit(i32)

##:
Writes each byte as two lower-case hex digits.

- Parameter data: The bytes.
- Returns: The hex text, two digits for each byte.
- Example:
```sushi
let u8[] data = from([0xde, 0xad, 0x01])
println(encode(data))
```
:##
public fn encode(u8[] data) string:
    let u8[] out = from([0; data.len() * 2])
    foreach(i in 0..data.len()):
        let u8 b = data[i]
        out[2 * i] := DIGITS[(b >> 4) as i32]
        out[2 * i + 1] := DIGITS[(b & 0x0f) as i32]
    return string.from_bytes(nom out)

##:
Reads hex text as bytes.

- Parameter text: The hex digits, upper or lower case, two for each byte.
- Returns: The bytes.
- Errors: `HexError.OddLength` when the count of digits is odd, and
  `HexError.BadDigit` with the offset of the first byte that is not a hex digit.
- Example:
```sushi
match decode("DEad01"):
    Result.Ok(bytes) -> println(bytes.len())
    Result.Err(_) -> println("not hex")
```
:##
public fn decode(string text) u8[] | HexError:
    let i32 n = text.size()
    if (n % 2 != 0):
        return Result.Err(HexError.OddLength)
    let u8[] out = from([0; n / 2])
    foreach(i in 0..n / 2):
        let i32 high = digit_value(text[2 * i])
        if (high < 0):
            return Result.Err(HexError.BadDigit(2 * i))
        let i32 low = digit_value(text[2 * i + 1])
        if (low < 0):
            return Result.Err(HexError.BadDigit(2 * i + 1))
        out[i] := (high * 16 + low) as u8
    return Result.Ok(out)

##:
Gives the value of one hex digit.

- Parameter b: The byte.
- Returns: The value from 0 to 15, or -1 when the byte is not a hex digit.
:##
fn digit_value(u8 b) i32:
    if (b >= a'0' and b <= a'9'):
        return (b - a'0') as i32
    if (b >= a'a' and b <= a'f'):
        return (b - a'a' + 10) as i32
    if (b >= a'A' and b <= a'F'):
        return (b - a'A' + 10) as i32
    return -1
