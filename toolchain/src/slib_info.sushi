##:
The `slib-info` tool: it prints the metadata report of a `.slib` library.

On the success path, the report is the same as the report of the Python fallback
(`print_library_info` in `sushi_lang/compiler/lib_info.py`), line for line. The exit code is 0
for a report or for `--help`, and 2 for a usage error or a read error. The design records
are in `docs/design/slib-info.md`.
:##

use <io/fs>
use <collections/strings>
use <encoding/msgpack>
use <sys/env>
use <toolchain/slib>

##: The escape that ends a style. :##
const string ESC_RESET = "\x1b[0m"
##: The escape for bold text. :##
const string ESC_BOLD = "\x1b[1m"
##: The escape for dim text. :##
const string ESC_DIM = "\x1b[2m"
##: The escape for italic text. :##
const string ESC_ITALIC = "\x1b[3m"
##: The escape for blue text. :##
const string ESC_BLUE = "\x1b[34m"
##: The escape for cyan text. :##
const string ESC_CYAN = "\x1b[36m"

##:
The options of one run: the doc blocks, and the six style strings.

Each style is an escape, or `""` in plain mode.
:##
struct Opts:
    ##: True to print the doc blocks. :##
    bool docs
    ##: The style for bold text. :##
    string bold
    ##: The style for dim text. :##
    string dim
    ##: The style for italic text. :##
    string italic
    ##: The style for a tag keyword. :##
    string blue
    ##: The style for a parameter name and for inline code. :##
    string cyan
    ##: The escape that ends a style. It is `""` in plain mode. :##
    string reset

##:
Makes the options of a run: the palette, or six empty strings.

- Parameter docs: True to print the doc blocks.
- Parameter colour: True to print in colour.
- Returns: The options.
:##
fn make_opts(bool docs, bool colour) Opts:
    if (colour):
        return Opts(docs, ESC_BOLD.clone(), ESC_DIM.clone(),
                              ESC_ITALIC.clone(), ESC_BLUE.clone(), ESC_CYAN.clone(),
                              ESC_RESET.clone())
    return Opts(docs, "", "", "", "", "", "")

##:
Gives the payload of a `Str` value.

- Parameter v: The value to read.
- Returns: The string, or `""` for a value of a different kind.
:##
fn str(MsgValue v) string:
    match v:
        MsgValue.Str(s) ->
            return s.clone()
        _ ->
            return ""

##:
Gives the `Str` value under a string key.

- Parameter m: The map to read.
- Parameter key: The key to find.
- Returns: The string, or `""` when the key is absent or its value is not a `Str`.
:##
fn get_str(MsgValue m, string key) string:
    return map_get_str(m, key).realise("")

##:
Gives the `Bool` value under a string key.

- Parameter m: The map to read.
- Parameter key: The key to find.
- Returns: The bool, or false when the key is absent or its value is not a `Bool`.
:##
fn get_bool(MsgValue m, string key) bool:
    return map_get_bool(m, key).realise(false)

##:
Gives the number of elements of an `Arr` value.

- Parameter v: The value to read.
- Returns: The count, or 0 for a value of a different kind.
:##
fn len(MsgValue v) i32:
    match v:
        MsgValue.Arr(items) ->
            return items.len()
        _ ->
            return 0

##:
Gives the number of elements of the `Arr` value under a string key.

- Parameter m: The map to read.
- Parameter key: The key to find.
- Returns: The count, or 0 when the key is absent.
:##
fn len_at(MsgValue m, string key) i32:
    match m:
        MsgValue.Map(_, vals) ->
            match map_index(m, key):
                Maybe.Some(at) -> return len(vals[at])
                Maybe.None() -> return 0
        _ ->
            return 0

##:
Joins the `Str` elements of an `Arr` value with a separator.

- Parameter list: The `Arr` value.
- Parameter sep: The text between two elements.
- Returns: The joined text, or `""` for a value that is not an `Arr`.
:##
fn join_strs(MsgValue list, string sep) string:
    match list:
        MsgValue.Arr(items) ->
            let string[] parts = from([])
            foreach(item in items.iter()):
                parts.push(str(item))
            return sep.join(parts)
        _ ->
            return ""

##:
Joins the `Str` elements of the `Arr` value under a string key with a separator.

- Parameter m: The map to read.
- Parameter key: The key to find.
- Parameter sep: The text between two elements.
- Returns: The joined text, or `""` when the key is absent.
:##
fn join_at(MsgValue m, string key, string sep) string:
    match m:
        MsgValue.Map(_, vals) ->
            match map_index(m, key):
                Maybe.Some(at) -> return join_strs(vals[at], sep)
                Maybe.None() -> return ""
        _ ->
            return ""

##:
Tells if a value is `Nil`.

- Parameter v: The value to read.
- Returns: True for a `Nil` value.
:##
fn is_nil(MsgValue v) bool:
    match v:
        MsgValue.Nil() ->
            return true
        _ ->
            return false

##:
Changes an interned type name to the `@(...)` spelling that a user reads.

The four rules are in `docs/design/slib-info.md` section 5.

- Parameter name: The interned name.
- Returns: The name in the surface spelling.
:##
fn to_surface(string name) string:
    if (not name.contains("<")):
        return name.clone()
    if (name.contains("->")):
        return name.clone()
    if (name.count("<") != name.count(">")):
        return name.clone()
    let string opened = name.replace("<", "@(")
    return opened.replace(">", ")")

##:
Prints the header of a section, when the section has members.

- Parameter title: The title of the section.
- Parameter n: The number of members.
- Parameter o: The options of the run.
- Returns: False when the section is empty and prints nothing.
:##
fn section(string title, i32 n, Opts o) bool:
    if (n == 0):
        return false
    println("{o.bold}{title}{o.reset} {o.dim}({n}){o.reset}:")
    return true

##:
Finds the Markdown mark that opens at `i`. The longest mark is tried first.

- Parameter line: The line of prose.
- Parameter i: The index to look at.
- Returns: The mark, or `""`.
:##
fn mark_at(string line, i32 i) string:
    let string one = line.char_at(i)
    if (one == "`"):
        return "`"
    if (one == "*"):
        if (i + 1 < line.len() and line.char_at(i + 1) == "*"):
            return "**"
        return "*"
    return ""

##:
Gives the escape for a Markdown mark.

- Parameter mark: The mark.
- Parameter o: The options of the run.
- Returns: The escape.
:##
fn style_of(string mark, Opts o) string:
    if (mark == "**"):
        return o.bold.clone()
    if (mark == "`"):
        return o.cyan.clone()
    return o.italic.clone()

##:
Finds the next position of `mark`, at `start` or after it.

- Parameter line: The line of prose.
- Parameter start: The index where the search starts.
- Parameter mark: The mark.
- Returns: The position, or `Maybe.None()` when the rest of the line has no such mark.
:##
fn close_at(string line, i32 start, string mark) Maybe@(i32):
    match line.s(start, line.len()).find(mark):
        Maybe.Some(at) -> return Maybe.Some(start + at)
        Maybe.None() -> return Maybe.None()

##:
Tells if a mark and its text are a span, or punctuation.

The rules are in `docs/design/slib-info.md` section 6.

- Parameter mark: The mark.
- Parameter inner: The text between the two marks.
- Returns: True for a span.
:##
fn is_span(string mark, string inner) bool:
    if (inner == ""):
        return false
    if (mark == "`"):
        return true
    let i32 last = inner.len() - 1
    if (inner.char_at(0) == " " or inner.char_at(last) == " "):
        return false
    return true

##:
Changes the Markdown marks of one line of prose into styles.

- Parameter line: The line of prose.
- Parameter o: The options of the run.
- Returns: The line. In plain mode the line does not change.
:##
fn render_inline(string line, Opts o) string:
    if (o.reset == ""):
        return line.clone()
    let string[] pieces = from([])
    let i32 n = line.len()
    let i32 i = 0
    while (i < n):
        let string mark = mark_at(line, i)
        if (mark == ""):
            pieces.push(line.char_at(i))
            i := i + 1
            continue
        let i32 mlen = mark.len()
        let i32 next = i + mlen
        match close_at(line, next, mark):
            Maybe.Some(close) ->
                let string inner = line.s(next, close)
                if (is_span(mark, inner)):
                    pieces.push(style_of(mark, o))
                    pieces.push(inner)
                    pieces.push("{o.reset}")
                    next := close + mlen
                else:
                    pieces.push(mark)
            Maybe.None() ->
                pieces.push(mark)
        i := next
    return "".join(pieces)

##:
Prints each line of a text with its indent, and an opener before the first line.

The lines after the first have a hanging indent past the opener.

- Parameter indent: The indent of each line.
- Parameter text: The text to print.
- Parameter opener: The text before the first line.
- Parameter opener_width: The visible width of the opener.
- Parameter o: The options of the run.
:##
fn print_lines(string indent, string text, string opener, i32 opener_width,
               Opts o) ~:
    let string pad = " ".repeat(opener_width)
    let string hang = "{indent}{pad}"
    let string[] lines = text.split("\n")
    foreach(i in 0..lines.len()):
        let string raw = lines[i]
        if (raw == ""):
            println("")
        else:
            let string line = render_inline(raw, o)
            if (i == 0):
                println("{indent}{opener}{line}")
            else:
                println("{hang}{line}")

##:
Prints one doc record: the summary, the body, the tags and the examples.

- Parameter doc: The doc record.
- Parameter owner: The manifest record of the declaration that the doc record documents.
- Parameter indent: The indent of each line.
- Parameter o: The options of the run.
- Returns: True when the record printed something.
:##
fn print_doc_record(MsgValue doc, MsgValue owner, string indent, Opts o) bool:
    if (not o.docs):
        return false
    if (is_nil(doc)):
        return false
    let bool printed = false
    let string summary = get_str(doc, "summary")
    let string body = get_str(doc, "body")
    if (summary != ""):
        print_lines(indent, summary, "", 0, o)
        printed := true
    if (body != ""):
        if (printed):
            println("")
        print_lines(indent, body, "", 0, o)
        printed := true
    printed := print_param_tags_at(owner, doc, indent, printed, o)
    let string returns = get_str(doc, "returns")
    if (returns != ""):
        if (printed):
            println("")
        print_lines(indent, returns, "- {o.blue}Returns{o.reset}: ", "- Returns: ".len(), o)
        printed := true
    let string errors = get_str(doc, "errors")
    if (errors != ""):
        if (printed):
            println("")
        print_lines(indent, errors, "- {o.blue}Errors{o.reset}: ", "- Errors: ".len(), o)
        printed := true
    printed := print_examples_at(doc, indent, printed, o)
    return printed

##:
Prints the `- Parameter` tags of a doc record, in the order of the parameters of the
owner.

- Parameter owner: The manifest record of the declaration that the doc record documents.
- Parameter doc: The doc record.
- Parameter indent: The indent of each line.
- Parameter printed: True when a part is already above the next part.
- Parameter o: The options of the run.
- Returns: True when a part is above the next part.
:##
fn print_param_tags_at(MsgValue owner, MsgValue doc, string indent, bool printed,
                       Opts o) bool:
    match owner:
        MsgValue.Map(_, vals) ->
            match map_index(owner, "params"):
                Maybe.Some(at) ->
                    return print_param_tags(vals[at], doc, indent, printed, o)
                Maybe.None() -> return printed
        _ ->
            return printed

##:
Prints a `- Parameter` tag for each declared parameter that the doc record documents.

- Parameter declared: The `params` array of the owner.
- Parameter doc: The doc record.
- Parameter indent: The indent of each line.
- Parameter printed: True when a part is already above the next part.
- Parameter o: The options of the run.
- Returns: True when a part is above the next part.
:##
fn print_param_tags(MsgValue declared, MsgValue doc, string indent, bool printed,
                    Opts o) bool:
    match declared:
        MsgValue.Arr(params) ->
            let bool p = printed
            foreach(param in params.iter()):
                let string pn = get_str(param, "name")
                let string ptext = param_text(doc, pn)
                if (ptext != ""):
                    if (p):
                        println("")
                    # The width is the PLAIN opener's, so it cannot drift from what prints.
                    let string pplain = "- Parameter {pn}: "
                    let string popener = "- {o.blue}Parameter{o.reset} {o.cyan}{pn}{o.reset}: "
                    print_lines(indent, ptext, popener, pplain.len(), o)
                    p := true
            return p
        _ ->
            return printed

##:
Gives the text of one `- Parameter` tag.

- Parameter doc: The doc record.
- Parameter name: The name of the parameter.
- Returns: The text, or `""` when the record does not document the parameter.
:##
fn param_text(MsgValue doc, string name) string:
    match doc:
        MsgValue.Map(_, vals) ->
            match map_index(doc, "params"):
                Maybe.Some(at) -> return get_str(vals[at], name)
                Maybe.None() -> return ""
        _ ->
            return ""

##:
Prints the examples of a doc record.

- Parameter doc: The doc record.
- Parameter indent: The indent of each line.
- Parameter printed: True when a part is already above the next part.
- Parameter o: The options of the run.
- Returns: True when a part is above the next part.
:##
fn print_examples_at(MsgValue doc, string indent, bool printed, Opts o) bool:
    match doc:
        MsgValue.Map(_, vals) ->
            match map_index(doc, "examples"):
                Maybe.Some(at) -> return print_examples(vals[at], indent, printed, o)
                Maybe.None() -> return printed
        _ ->
            return printed

##:
Prints each example: its caption, then its code.

- Parameter examples: The `examples` array.
- Parameter indent: The indent of each line.
- Parameter printed: True when a part is already above the next part.
- Parameter o: The options of the run.
- Returns: True when a part is above the next part.
:##
fn print_examples(MsgValue examples, string indent, bool printed, Opts o) bool:
    match examples:
        MsgValue.Arr(items) ->
            let bool p = printed
            foreach(ex in items.iter()):
                if (p):
                    println("")
                let string caption = get_str(ex, "caption")
                if (caption == ""):
                    println("{indent}- {o.blue}Example{o.reset}:")
                else:
                    print_lines(indent, caption, "- {o.blue}Example{o.reset}: ",
                                "- Example: ".len(), o)
                print_code(indent, get_str(ex, "code"), o)
                p := true
            return p
        _ ->
            return printed

##:
Prints the code of an example, dim and indented four spaces past its tag.

- Parameter indent: The indent of each line.
- Parameter code: The code.
- Parameter o: The options of the run.
:##
fn print_code(string indent, string code, Opts o) ~:
    let string[] lines = code.split("\n")
    foreach(line in lines.iter()):
        if (line == ""):
            println("")
        else:
            println("{indent}    {o.dim}{line}{o.reset}")

##:
Prints the doc record of one manifest record, when it has one.

- Parameter owner: The manifest record of the declaration that the doc record documents.
- Parameter indent: The indent of each line.
- Parameter o: The options of the run.
- Returns: True when something printed.
:##
fn print_doc(MsgValue owner, string indent, Opts o) bool:
    return print_doc_at(owner, "doc", owner, indent, o)

##:
Prints the doc record under a string key of a map.

- Parameter m: The map to read.
- Parameter key: The key to find.
- Parameter owner: The manifest record of the declaration that the doc record documents.
- Parameter indent: The indent of each line.
- Parameter o: The options of the run.
- Returns: True when something printed.
:##
fn print_doc_at(MsgValue m, string key, MsgValue owner, string indent, Opts o) bool:
    match m:
        MsgValue.Map(_, vals) ->
            match map_index(m, key):
                Maybe.Some(at) ->
                    return print_doc_record(vals[at], owner, indent, o)
                Maybe.None() -> return false
        _ ->
            return false

##:
Prints the blank line before a record, when the record before it printed a block.

- Parameter pending: True when the record before this one printed a block.
- Returns: False, the new `pending` value.
:##
fn open_record(bool pending) bool:
    if (pending):
        println("")
    return false

##:
Writes the parameter list of a function record, with the receiver mode first.

- Parameter f: The function record.
- Returns: The parameter list.
:##
fn render_params(MsgValue f) string:
    let string head = get_str(f, "self_mode")
    if (head != ""):
        head := "{head} self"
    match f:
        MsgValue.Map(_, vals) ->
            match map_index(f, "params"):
                Maybe.Some(at) -> return render_param_list(vals[at], nom head)
                Maybe.None() -> return head
        _ ->
            return head

##:
Writes each parameter of a `params` array after the receiver text.

- Parameter ps: The `params` array.
- Parameter out: The receiver text, or `""`.
- Returns: The parameter list.
:##
fn render_param_list(MsgValue ps, nom string out) string:
    match ps:
        MsgValue.Arr(items) ->
            let string[] parts = from([])
            if (out != ""):
                parts.push(out)
            foreach(p in items.iter()):
                let string t = to_surface(get_str(p, "type"))
                let string pn = get_str(p, "name")
                let string declared = get_str(p, "mode")
                let string mode = ""
                if (declared == "nom"):
                    mode := "nom "
                parts.push("{mode}{t} {pn}")
            return ", ".join(parts)
        _ ->
            return out

##:
Writes the signature of one function record, concrete or generic.

- Parameter f: The function record.
- Parameter o: The options of the run.
- Returns: The signature.
:##
fn render_signature(MsgValue f, Opts o) string:
    let string callable = render_callable(f, o)
    return "fn {callable}"

##:
Writes the signature of one function record with no `fn`, as an extension prints it.

- Parameter f: The function or extension record.
- Parameter o: The options of the run.
- Returns: The signature.
:##
fn render_callable(MsgValue f, Opts o) string:
    let string bare = get_str(f, "name")
    let string name = "{o.bold}{bare}{o.reset}"
    let string generic = render_type_params(f)
    let string params = render_params(f)
    let string ret = to_surface(get_str(f, "return_type"))
    let string err = get_str(f, "error_type")
    if (err == ""):
        return "{name}{generic}({params}) {ret}"
    let string serr = to_surface(err)
    return "{name}{generic}({params}) {ret} | {serr}"

##:
Prints one section of function records.

- Parameter m: The map to read.
- Parameter key: The key to find.
- Parameter title: The title of the section.
- Parameter o: The options of the run.
:##
fn print_signatures_at(MsgValue m, string key, string title, Opts o) ~:
    match m:
        MsgValue.Map(_, vals) ->
            match map_index(m, key):
                Maybe.Some(at) -> print_signatures(vals[at], title, o)
                Maybe.None() -> return ~
        _ ->
            return ~

##:
Prints each function record of an array, with its doc record.

- Parameter funcs: The array of function records.
- Parameter title: The title of the section.
- Parameter o: The options of the run.
:##
fn print_signatures(MsgValue funcs, string title, Opts o) ~:
    if (not section(title, len(funcs), o)):
        return ~
    match funcs:
        MsgValue.Arr(items) ->
            let bool pending = false
            foreach(f in items.iter()):
                pending := open_record(pending)
                let string sig = render_signature(f, o)
                println("  {sig}")
                pending := print_doc(f, "    ", o)
        _ ->
            return ~
    println("")

##:
Writes the `@(...)` type parameters of a generic record.

- Parameter gf: The generic record.
- Returns: The text, or `""` when there are none.
:##
fn render_type_params(MsgValue gf) string:
    match gf:
        MsgValue.Map(_, vals) ->
            match map_index(gf, "type_params"):
                Maybe.Some(at) -> return render_type_param_list(vals[at])
                Maybe.None() -> return ""
        _ ->
            return ""

##:
Writes a `type_params` array as `@(...)`, with the constraints.

- Parameter tps: The `type_params` array.
- Returns: The text, or `""` for an empty array.
:##
fn render_type_param_list(MsgValue tps) string:
    match tps:
        MsgValue.Arr(items) ->
            if (items.len() == 0):
                return ""
            let string[] parts = from([])
            foreach(tp in items.iter()):
                let string tname = get_str(tp, "name")
                let string cs = join_at(tp, "constraints", " + ")
                let string one = ""
                if (cs == ""):
                    one := "{tname}"
                else:
                    one := "{tname}: {cs}"
                parts.push(one)
            let string body = ", ".join(parts)
            return "@({body})"
        _ ->
            return ""

##:
Prints one section of constant or variable records.

- Parameter m: The map to read.
- Parameter key: The key to find.
- Parameter title: The title of the section.
- Parameter keyword: The keyword at the start of each line.
- Parameter o: The options of the run.
:##
fn print_bindings_at(MsgValue m, string key, string title, string keyword, Opts o) ~:
    match m:
        MsgValue.Map(_, vals) ->
            match map_index(m, key):
                Maybe.Some(at) -> print_bindings(vals[at], title, keyword, o)
                Maybe.None() -> return ~
        _ ->
            return ~

##:
Prints each constant or variable record of an array, with its doc record.

- Parameter list: The array of records.
- Parameter title: The title of the section.
- Parameter keyword: The keyword at the start of each line.
- Parameter o: The options of the run.
:##
fn print_bindings(MsgValue list, string title, string keyword, Opts o) ~:
    if (not section(title, len(list), o)):
        return ~
    match list:
        MsgValue.Arr(items) ->
            let bool pending = false
            foreach(c in items.iter()):
                pending := open_record(pending)
                let string t = to_surface(get_str(c, "type"))
                let string name = get_str(c, "name")
                println("  {keyword} {t} {name}")
                pending := print_doc(c, "    ", o)
        _ ->
            return ~
    println("")

##:
Writes the `@(T, U)` suffix of a generic struct or enum record.

- Parameter rec: The struct or enum record.
- Returns: The suffix, or `""`.
:##
fn render_named_type_params(MsgValue rec) string:
    if (not get_bool(rec, "is_generic")):
        return ""
    if (len_at(rec, "type_params") == 0):
        return ""
    let string body = join_at(rec, "type_params", ", ")
    return "@({body})"

##:
Prints the section of public structs.

- Parameter meta: The metadata map.
- Parameter o: The options of the run.
:##
fn print_structs(MsgValue meta, Opts o) ~:
    match meta:
        MsgValue.Map(_, vals) ->
            match map_index(meta, "structs"):
                Maybe.Some(at) -> print_struct_list(vals[at], o)
                Maybe.None() -> return ~
        _ ->
            return ~

##:
Prints each struct record, with its doc record and its fields.

- Parameter structs: The array of struct records.
- Parameter o: The options of the run.
:##
fn print_struct_list(MsgValue structs, Opts o) ~:
    if (not section("Public Structs", len(structs), o)):
        return ~
    match structs:
        MsgValue.Arr(items) ->
            let bool pending = false
            foreach(s in items.iter()):
                pending := open_record(pending)
                let string name = get_str(s, "name")
                let string generic = render_named_type_params(s)
                println("  struct {name}{generic}:")
                pending := print_doc(s, "    ", o)
                pending := print_fields_at(s, pending, o)
        _ ->
            return ~
    println("")

##:
Prints the fields of a struct record.

- Parameter s: The struct record.
- Parameter pending: True when the record before this one printed a block.
- Parameter o: The options of the run.
- Returns: True when the last record printed a block.
:##
fn print_fields_at(MsgValue s, bool pending, Opts o) bool:
    match s:
        MsgValue.Map(_, vals) ->
            match map_index(s, "fields"):
                Maybe.Some(at) -> return print_fields(vals[at], pending, o)
                Maybe.None() -> return pending
        _ ->
            return pending

##:
Prints each field record, with its doc record.

- Parameter fields: The array of field records.
- Parameter pending: True when the record before this one printed a block.
- Parameter o: The options of the run.
- Returns: True when the last record printed a block.
:##
fn print_fields(MsgValue fields, bool pending, Opts o) bool:
    match fields:
        MsgValue.Arr(items) ->
            let bool p = pending
            foreach(fld in items.iter()):
                p := open_record(p)
                let string ft = to_surface(get_str(fld, "type"))
                let string fname = get_str(fld, "name")
                println("    {ft} {fname}")
                p := print_doc(fld, "      ", o)
            return p
        _ ->
            return pending

##:
Prints the section of public enums.

- Parameter meta: The metadata map.
- Parameter o: The options of the run.
:##
fn print_enums(MsgValue meta, Opts o) ~:
    match meta:
        MsgValue.Map(_, vals) ->
            match map_index(meta, "enums"):
                Maybe.Some(at) -> print_enum_list(vals[at], o)
                Maybe.None() -> return ~
        _ ->
            return ~

##:
Prints each enum record, with its doc record and its variants.

- Parameter enums: The array of enum records.
- Parameter o: The options of the run.
:##
fn print_enum_list(MsgValue enums, Opts o) ~:
    if (not section("Public Enums", len(enums), o)):
        return ~
    match enums:
        MsgValue.Arr(items) ->
            let bool pending = false
            foreach(e in items.iter()):
                pending := open_record(pending)
                let string name = get_str(e, "name")
                let string generic = render_named_type_params(e)
                println("  enum {name}{generic}:")
                pending := print_doc(e, "    ", o)
                pending := print_variants_at(e, pending, o)
        _ ->
            return ~
    println("")

##:
Prints the variants of an enum record.

- Parameter e: The enum record.
- Parameter pending: True when the record before this one printed a block.
- Parameter o: The options of the run.
- Returns: True when the last record printed a block.
:##
fn print_variants_at(MsgValue e, bool pending, Opts o) bool:
    match e:
        MsgValue.Map(_, vals) ->
            match map_index(e, "variants"):
                Maybe.Some(at) -> return print_variants(vals[at], pending, o)
                Maybe.None() -> return pending
        _ ->
            return pending

##:
Writes the payload types of a variant record, each in the `@(...)` spelling.

- Parameter v: The variant record.
- Returns: The types joined with `", "`, or `""` when the record has none.
:##
fn render_data_types(MsgValue v) string:
    match v:
        MsgValue.Map(_, vals) ->
            match map_index(v, "data_types"):
                Maybe.Some(at) ->
                    match vals[at]:
                        MsgValue.Arr(types) ->
                            let string[] parts = from([])
                            foreach(t in types.iter()):
                                parts.push(to_surface(str(t)))
                            return ", ".join(parts)
                        _ ->
                            return ""
                Maybe.None() -> return ""
        _ ->
            return ""

##:
Prints each variant record, with its doc record.

- Parameter variants: The array of variant records.
- Parameter pending: True when the record before this one printed a block.
- Parameter o: The options of the run.
- Returns: True when the last record printed a block.
:##
fn print_variants(MsgValue variants, bool pending, Opts o) bool:
    match variants:
        MsgValue.Arr(items) ->
            let bool p = pending
            foreach(v in items.iter()):
                p := open_record(p)
                let string vname = get_str(v, "name")
                if (get_bool(v, "has_data")):
                    let string dt = render_data_types(v)
                    println("    {vname}({dt})")
                else:
                    println("    {vname}")
                p := print_doc(v, "      ", o)
            return p
        _ ->
            return pending

##:
Prints one section of generic structs or of generic enums.

- Parameter templates: The `templates` map, or `Nil` when the library has none.
- Parameter key: The key to find.
- Parameter title: The title of the section.
- Parameter keyword: The keyword at the start of each line.
- Parameter o: The options of the run.
:##
fn print_generic_named(MsgValue templates, string key, string title, string keyword,
                       Opts o) ~:
    match templates:
        MsgValue.Map(_, vals) ->
            match map_index(templates, key):
                Maybe.Some(at) -> print_generic_named_list(vals[at], title, keyword, o)
                Maybe.None() -> return ~
        _ ->
            return ~

##:
Prints each generic struct or enum record, with its doc record.

- Parameter list: The array of records.
- Parameter title: The title of the section.
- Parameter keyword: The keyword at the start of each line.
- Parameter o: The options of the run.
:##
fn print_generic_named_list(MsgValue list, string title, string keyword, Opts o) ~:
    if (not section(title, len(list), o)):
        return ~
    match list:
        MsgValue.Arr(items) ->
            let bool pending = false
            foreach(r in items.iter()):
                pending := open_record(pending)
                let string name = get_str(r, "name")
                let string generic = render_type_params(r)
                println("  {keyword} {name}{generic}:")
                pending := print_doc(r, "    ", o)
        _ ->
            return ~
    println("")

##:
Prints the method records of a perk or of an implementation.

- Parameter owner: The manifest record of the declaration that the doc record documents.
- Parameter pending: True when the record before this one printed a block.
- Parameter o: The options of the run.
- Returns: True when the last record printed a block.
:##
fn print_methods(MsgValue owner, bool pending, Opts o) bool:
    match owner:
        MsgValue.Map(_, vals) ->
            match map_index(owner, "methods"):
                Maybe.Some(at) -> return print_method_list(vals[at], pending, o)
                Maybe.None() -> return pending
        _ ->
            return pending

##:
Prints each method record, with its doc record.

- Parameter methods: The array of method records.
- Parameter pending: True when the record before this one printed a block.
- Parameter o: The options of the run.
- Returns: True when the last record printed a block.
:##
fn print_method_list(MsgValue methods, bool pending, Opts o) bool:
    match methods:
        MsgValue.Arr(items) ->
            let bool p = pending
            foreach(m in items.iter()):
                p := open_record(p)
                let string sig = render_signature(m, o)
                println("    {sig}")
                p := print_doc(m, "      ", o)
            return p
        _ ->
            return pending

##:
Prints the section of perks.

- Parameter templates: The `templates` map, or `Nil` when the library has none.
- Parameter o: The options of the run.
:##
fn print_perks(MsgValue templates, Opts o) ~:
    match templates:
        MsgValue.Map(_, vals) ->
            match map_index(templates, "perks"):
                Maybe.Some(at) -> print_perk_list(vals[at], o)
                Maybe.None() -> return ~
        _ ->
            return ~

##:
Prints each perk record, with its doc record and its methods.

- Parameter perks: The array of perk records.
- Parameter o: The options of the run.
:##
fn print_perk_list(MsgValue perks, Opts o) ~:
    if (not section("Perks", len(perks), o)):
        return ~
    match perks:
        MsgValue.Arr(items) ->
            let bool pending = false
            foreach(r in items.iter()):
                pending := open_record(pending)
                let string name = get_str(r, "name")
                println("  perk {name}:")
                pending := print_doc(r, "    ", o)
                pending := print_methods(r, pending, o)
        _ ->
            return ~
    println("")

##:
Writes the target of an implementation record, for example `Box@(T)`.

- Parameter r: The implementation record.
- Returns: The target.
:##
fn render_impl_target(MsgValue r) string:
    let string target = to_surface(get_str(r, "type"))
    if (len_at(r, "type_args") == 0):
        return target
    let string body = join_at(r, "type_args", ", ")
    return "{target}@({body})"

##:
Prints one array of implementation records.

- Parameter templates: The `templates` map, or `Nil` when the library has none.
- Parameter key: The key to find.
- Parameter pending: True when the record before this one printed a block.
- Parameter o: The options of the run.
- Returns: True when the last record printed a block.
:##
fn print_impls_at(MsgValue templates, string key, bool pending, Opts o) bool:
    match templates:
        MsgValue.Map(_, vals) ->
            match map_index(templates, key):
                Maybe.Some(at) -> return print_impl_records(vals[at], pending, o)
                Maybe.None() -> return pending
        _ ->
            return pending

##:
Prints each implementation record, with its doc record and its methods.

- Parameter impls: The array of implementation records.
- Parameter pending: True when the record before this one printed a block.
- Parameter o: The options of the run.
- Returns: True when the last record printed a block.
:##
fn print_impl_records(MsgValue impls, bool pending, Opts o) bool:
    match impls:
        MsgValue.Arr(items) ->
            let bool p = pending
            foreach(r in items.iter()):
                p := open_record(p)
                let string target = render_impl_target(r)
                let string contract = get_str(r, "perk")
                println("  extend {target} with {contract}:")
                p := print_doc(r, "    ", o)
                p := print_methods(r, p, o)
            return p
        _ ->
            return pending

##:
Prints the concrete and the generic-target implementations of perks, in one section.

- Parameter templates: The `templates` map, or `Nil` when the library has none.
- Parameter o: The options of the run.
:##
fn print_perk_impls(MsgValue templates, Opts o) ~:
    let i32 concrete_n = len_at(templates, "perk_impls")
    let i32 generic_n = len_at(templates, "generic_perk_impls")
    if (not section("Perk Implementations", concrete_n + generic_n, o)):
        return ~
    let bool pending = false
    pending := print_impls_at(templates, "perk_impls", pending, o)
    pending := print_impls_at(templates, "generic_perk_impls", pending, o)
    println("")

##:
Prints one array of extension method records.

- Parameter templates: The `templates` map, or `Nil` when the library has none.
- Parameter key: The key to find.
- Parameter pending: True when the record before this one printed a block.
- Parameter o: The options of the run.
- Returns: True when the last record printed a block.
:##
fn print_extensions_at(MsgValue templates, string key, bool pending, Opts o) bool:
    match templates:
        MsgValue.Map(_, vals) ->
            match map_index(templates, key):
                Maybe.Some(at) -> return print_extension_records(vals[at], pending, o)
                Maybe.None() -> return pending
        _ ->
            return pending

##:
Prints each extension method record, with its doc record.

- Parameter exts: The array of extension method records.
- Parameter pending: True when the record before this one printed a block.
- Parameter o: The options of the run.
- Returns: True when the last record printed a block.
:##
fn print_extension_records(MsgValue exts, bool pending, Opts o) bool:
    match exts:
        MsgValue.Arr(items) ->
            let bool p = pending
            foreach(e in items.iter()):
                p := open_record(p)
                let string target = to_surface(get_str(e, "type"))
                let string marker = ""
                if (get_bool(e, "static")):
                    marker := "static "
                let string sig = render_callable(e, o)
                println("  extend {target} {marker}{sig}")
                p := print_doc(e, "    ", o)
            return p
        _ ->
            return pending

##:
Prints the concrete and the template extension methods, in one section.

- Parameter templates: The `templates` map, or `Nil` when the library has none.
- Parameter o: The options of the run.
:##
fn print_extensions(MsgValue templates, Opts o) ~:
    let i32 concrete_n = len_at(templates, "extensions")
    let i32 generic_n = len_at(templates, "generic_extensions")
    if (not section("Extension Methods", concrete_n + generic_n, o)):
        return ~
    let bool pending = false
    pending := print_extensions_at(templates, "extensions", pending, o)
    pending := print_extensions_at(templates, "generic_extensions", pending, o)
    println("")

##:
Prints the section of the types that the library extends and does not declare.

- Parameter meta: The metadata map.
- Parameter o: The options of the run.
:##
fn print_foreign_extensions(MsgValue meta, Opts o) ~:
    match meta:
        MsgValue.Map(_, vals) ->
            match map_index(meta, "foreign_extensions"):
                Maybe.Some(at) -> print_foreign_list(vals[at], o)
                Maybe.None() -> return ~
        _ ->
            return ~

##:
Prints each foreign extension record.

- Parameter claims: The array of foreign extension records.
- Parameter o: The options of the run.
:##
fn print_foreign_list(MsgValue claims, Opts o) ~:
    if (not section("Foreign Extensions", len(claims), o)):
        return ~
    match claims:
        MsgValue.Arr(items) ->
            foreach(c in items.iter()):
                let string target = to_surface(get_str(c, "type"))
                let string method = get_str(c, "method")
                println("  extend {target} {method}")
        _ ->
            return ~
    println("")

##:
Prints the section of the units that the library holds.

- Parameter meta: The metadata map.
- Parameter o: The options of the run.
:##
fn print_units(MsgValue meta, Opts o) ~:
    match meta:
        MsgValue.Map(_, vals) ->
            match map_index(meta, "units"):
                Maybe.Some(at) -> print_unit_list(vals[at], meta, o)
                Maybe.None() -> return ~
        _ ->
            return ~

##:
Prints each unit name, with its doc record.

- Parameter units: The array of unit names.
- Parameter meta: The metadata map.
- Parameter o: The options of the run.
:##
fn print_unit_list(MsgValue units, MsgValue meta, Opts o) ~:
    if (not section("Units", len(units), o)):
        return ~
    match units:
        MsgValue.Arr(items) ->
            let bool pending = false
            foreach(u in items.iter()):
                pending := open_record(pending)
                let string name = str(u)
                println("  {name}")
                pending := print_unit_doc(meta, name, o)
        _ ->
            return ~
    println("")

##:
Prints the doc record of one unit from the `unit_docs` map.

- Parameter meta: The metadata map.
- Parameter name: The name of the unit.
- Parameter o: The options of the run.
- Returns: True when something printed.
:##
fn print_unit_doc(MsgValue meta, string name, Opts o) bool:
    match meta:
        MsgValue.Map(_, vals) ->
            match map_index(meta, "unit_docs"):
                Maybe.Some(at) ->
                    return print_doc_at(vals[at], name, MsgValue.Nil(), "    ", o)
                Maybe.None() -> return false
        _ ->
            return false

##:
Prints the section of re-exports.

- Parameter meta: The metadata map.
- Parameter o: The options of the run.
:##
fn print_reexports(MsgValue meta, Opts o) ~:
    match meta:
        MsgValue.Map(_, vals) ->
            match map_index(meta, "reexports"):
                Maybe.Some(at) -> print_reexport_list(vals[at], o)
                Maybe.None() -> return ~
        _ ->
            return ~

##:
Prints each re-export record as the `public use` statement that made it.

- Parameter records: The array of re-export records.
- Parameter o: The options of the run.
:##
fn print_reexport_list(MsgValue records, Opts o) ~:
    if (not section("Re-exports", len(records), o)):
        return ~
    match records:
        MsgValue.Arr(items) ->
            foreach(r in items.iter()):
                let string unit = get_str(r, "unit")
                let string path = get_str(r, "path")
                let string kind = get_str(r, "kind")
                let string target = "<{path}>"
                if (kind == "unit"):
                    target := "\"{path}\""
                println("  {unit}: public use {target}")
        _ ->
            return ~
    println("")

##:
The text, or `?` when the text is empty.

- Parameter text: The text.
- Returns: The text, or `?`.
:##
fn or_unknown(nom string text) string:
    if (text.len() == 0):
        return "?"
    return text

##:
Prints the section of dependencies.

- Parameter meta: The metadata map.
- Parameter o: The options of the run.
:##
fn print_dependencies(MsgValue meta, Opts o) ~:
    match meta:
        MsgValue.Map(_, vals) ->
            match map_index(meta, "dependencies"):
                Maybe.Some(at) -> print_dependency_list(vals[at], o)
                Maybe.None() -> return ~
        _ ->
            return ~

##:
Prints each dependency.

- Parameter deps: The array of dependency records.
- Parameter o: The options of the run.
:##
fn print_dependency_list(MsgValue deps, Opts o) ~:
    if (not section("Dependencies", len(deps), o)):
        return ~
    match deps:
        MsgValue.Arr(items) ->
            foreach(d in items.iter()):
                let string path = get_str(d, "path")
                let string line = "  <{path}>"
                if (get_str(d, "kind") == "library"):
                    let string name = or_unknown(nom get_str(d, "library_name"))
                    let string version = or_unknown(nom get_str(d, "library_version"))
                    line := "{line} ({name} {version})"
                let string users = join_at(d, "units", ", ")
                if (users.len() > 0):
                    line := "{line}, used by {users}"
                println(line)
        _ ->
            return ~
    println("")

##:
Prints each declaration section, in the order of the report.

- Parameter meta: The metadata map.
- Parameter templates: The `templates` map, or `Nil` when the library has none.
- Parameter o: The options of the run.
:##
fn print_declarations(MsgValue meta, MsgValue templates, Opts o) ~:
    print_signatures_at(meta, "public_functions", "Public Functions", o)
    print_signatures_at(templates, "generic_functions", "Generic Functions", o)
    print_bindings_at(meta, "public_constants", "Public Constants", "const", o)
    print_bindings_at(meta, "public_variables", "Public Variables", "var", o)
    print_structs(meta, o)
    print_generic_named(templates, "generic_structs", "Generic Structs", "struct", o)
    print_enums(meta, o)
    print_generic_named(templates, "generic_enums", "Generic Enums", "enum", o)
    print_perks(templates, o)
    print_perk_impls(templates, o)
    print_extensions(templates, o)
    print_foreign_extensions(meta, o)

##:
Prints each declaration section, with the `templates` map when the library has one.

- Parameter meta: The metadata map.
- Parameter o: The options of the run.
:##
fn print_declarations_at(MsgValue meta, Opts o) ~:
    match meta:
        MsgValue.Map(_, vals) ->
            match map_index(meta, "templates"):
                Maybe.Some(at) -> print_declarations(meta, vals[at], o)
                Maybe.None() -> print_declarations(meta, MsgValue.Nil(), o)
        _ ->
            print_declarations(meta, MsgValue.Nil(), o)

##:
Writes an integer with comma separators, as the Python `{n:,}` does.

- Parameter n: The integer.
- Returns: The text.
:##
fn group_thousands(u64 n) string:
    if (n < 1000):
        return "{n}"
    let u64 head = n / 1000
    let u64 tail = n % 1000
    let string hs = group_thousands(head)
    if (tail < 10):
        return "{hs},00{tail}"
    if (tail < 100):
        return "{hs},0{tail}"
    return "{hs},{tail}"

##:
Prints the whole report: the header, the sections, then the payload sizes.

A field that the kind of the library makes meaningless does not print.

- Parameter meta: The metadata map.
- Parameter sizes: The lengths of the payload sections.
- Parameter o: The options of the run.
:##
fn print_report(MsgValue meta, SlibSizes sizes, Opts o) ~:
    let string libname = get_str(meta, "library_name")
    let string libver = get_str(meta, "library_version")
    let string kind = get_str(meta, "kind")
    let string plat = get_str(meta, "platform")
    let string comp = get_str(meta, "compiler_version")
    let string req = get_str(meta, "requires_compiler")
    let string at = get_str(meta, "compiled_at")
    let string proto = get_str(meta, "sushi_lib_version")
    println("Library: {libname}")
    println("Version: {libver}")
    println("Kind: {kind}")
    if (kind != "source"):
        println("Platform: {plat}")
    println("Compiler: {comp}")
    if (req != ""):
        println("Requires compiler: {req}")
    println("Compiled: {at}")
    println("Protocol: {proto}")
    println("")
    print_units(meta, o)
    print_reexports(meta, o)
    print_declarations_at(meta, o)
    print_dependencies(meta, o)
    if (kind != "binary"):
        let string src = group_thousands(sizes.source)
        println("Source: {o.dim}{src}{o.reset} bytes")
    if (kind != "source"):
        let string bc = group_thousands(sizes.bitcode)
        println("Bitcode: {o.dim}{bc}{o.reset} bytes")

##:
Gives the words for an I/O error. The Python fallback gives the same words.

- Parameter e: The error.
- Returns: The words.
:##
fn io_cause(IoError e) string:
    match e:
        IoError.NotFound -> return "file not found"
        IoError.PermissionDenied -> return "permission denied"
        IoError.IsDirectory -> return "is a directory"
        IoError.AlreadyExists -> return "already exists"
        IoError.DiskFull -> return "no space left on device"
        IoError.TooManyOpen -> return "too many open files"
        IoError.InvalidInput -> return "invalid path"
        _ -> return "input/output error"

##:
Prints one diagnostic line to stderr, in the form of the compiler's diagnostics.

The library is named on the command line, so the line starts with `<command line>`,
as the Python fallback's line does.

- Parameter code: The error code.
- Parameter message: The message, with no full stop at the end.
:##
fn print_diagnostic(string code, string message) ~:
    stderr.write("<command line>: error [{code}]: {message}.\n")

##:
Prints the diagnostic for a library that the tool cannot read. The Python fallback
gives the same code for the same fault.

- Parameter path: The path of the library.
- Parameter e: The fault.
:##
fn print_fault(string path, SlibError e) ~:
    match e:
        SlibError.Io(io) ->
            print_diagnostic("CE3515", "cannot read library file '{path}': {io_cause(io)}")
        SlibError.BadMagic() ->
            print_diagnostic("CE3508", "invalid library file '{path}': not a valid .slib file (bad magic)")
        SlibError.BadVersion(v) ->
            print_diagnostic("CE3509", "unsupported library format version '{v}' in '{path}' (compiler supports version 4)")
        SlibError.Truncated(section, expected, actual) ->
            let string counts = "(expected {expected} bytes, got {actual})"
            match section:
                SlibSection.Metadata() ->
                    print_diagnostic("CE3510", "corrupted library file '{path}': metadata section truncated {counts}")
                SlibSection.Source() ->
                    print_diagnostic("CE3506", "corrupted library file '{path}': source section truncated {counts}")
                SlibSection.Bitcode() ->
                    print_diagnostic("CE3511", "corrupted library file '{path}': bitcode section truncated {counts}")
        SlibError.TooLarge(size) ->
            print_diagnostic("CE3513", "library file too large '{path}': {size} bytes exceeds maximum {SLIB_MAX_FILE_SIZE} bytes")
        SlibError.Decode(_) ->
            print_diagnostic("CE3512", "invalid library metadata in '{path}': the metadata does not decode as MessagePack")
        SlibError.Invalid(reason) ->
            print_diagnostic("CE3512", "invalid library metadata in '{path}': {reason}")

##: The summary line of the command, for `--help` and for each usage error. :##
const string USAGE = "usage: slib-info [--docs] [--color=WHEN] <file.slib>"

##: Prints the help text to stdout. :##
fn print_help() ~:
    println(USAGE)
    println("")
    println("Print the metadata report of a .slib library.")
    println("")
    println("Options:")
    println("  --docs          Print the documentation block of every symbol that has one.")
    println("  --color=WHEN    always, never, or auto (the default).")
    println("  -h, --help      Print this message and exit.")
    println("")
    println("Colour, highest precedence first: --color, then NO_COLOR, then")
    println("CLICOLOR_FORCE, then TERM=dumb, then whether stdout is a terminal.")

##:
Prints a usage error and the summary line to stderr.

- Parameter message: The error message.
:##
fn print_usage_error(string message) ~:
    stderr.write("Error: {message}\n")
    stderr.write("{USAGE}\n")

##:
Reads a library and prints its report.

- Parameter path: The path of the library.
- Parameter o: The options of the run.
- Returns: The exit code: 0 for a report, 2 for a read error.
:##
fn report(string path, Opts o) i32:
    match read_library(path):
        Result.Ok(library) ->
            print_report(library.metadata, library.sizes, o)
            return 0
        Result.Err(e) ->
            print_fault(path, e)
            return 2

##:
Tells if an environment variable is set. An empty value is set.

- Parameter name: The name of the variable.
- Returns: True when the variable is set.
:##
fn env_is_set(string name) bool:
    match getenv(name):
        Maybe.Some(_) ->
            return true
        Maybe.None() ->
            return false

##:
Gives the value of an environment variable.

- Parameter name: The name of the variable.
- Returns: The value, or `""` when the variable is not set.
:##
fn env_value(string name) string:
    match getenv(name):
        Maybe.Some(nom v) ->
            return v
        Maybe.None() ->
            return ""

##:
Makes the colour decision, with the five rungs of the colour ladder.

- Parameter choice: The value of `--color`: `always`, `never` or `auto`.
- Returns: True to print in colour.
:##
fn want_colour(string choice) bool:
    if (choice == "always"):
        return true
    if (choice == "never"):
        return false
    if (env_is_set("NO_COLOR")):
        return false
    if (env_is_set("CLICOLOR_FORCE")):
        if (env_value("CLICOLOR_FORCE") != "0"):
            return true
    if (env_value("TERM") == "dumb"):
        return false
    return stdout.is_terminal()

##:
Reads the command line in one pass, then prints the report or the help.

A flag can be in each position, and the one bare word is the path. `--help` wins over
each other word.

- Parameter args: The command line. The first element is the name of the program.
- Returns: The exit code: 0 for a report or the help, 2 for a usage error or a read error.
:##
fn run_tool(peek string[] args) i32:
    let string path = ""
    let bool show_docs = false
    let string colour = "auto"
    let i32 n = args.len()
    let i32 i = 1
    while (i < n):
        let string a = args[i]
        if (a == "-h" or a == "--help"):
            print_help()
            return 0
        if (a == "--docs"):
            show_docs := true
        elif (a.starts_with("--color=")):
            colour := a.s(8, a.len())
            if (colour != "always" and colour != "never" and colour != "auto"):
                print_usage_error("--color takes always, never or auto: {a}")
                return 2
        elif (a.starts_with("-")):
            print_usage_error("unknown option: {a}")
            return 2
        else:
            if (path != ""):
                print_usage_error("more than one file named: {a}")
                return 2
            path := a.clone()
        i := i + 1

    if (path == ""):
        stderr.write("{USAGE}\n")
        return 2
    if (not path.ends_with(".slib")):
        print_diagnostic("CE3516", "'{path}' is not a library file: the name of a .slib file ends in .slib")
        return 2
    let Opts o = make_opts(show_docs, want_colour(colour))
    return report(path, o)

fn main(string[] args) i32:
    if (args.len() > 0):
        return run_tool(peek args)
    return 2
