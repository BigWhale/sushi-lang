# The List@(T)-at-let half of #250. List@(i32) IS a StructType, so it reaches
# _clone_owning_struct_alias -- but the struct_needs_cleanup gate there reports False for
# it (that predicate scans for dynamic-array FIELDS; List's buffers are raw pointers), so
# the MemberAccess clone below it was never reached and the binding aliased the field.
# EXPECT_STDOUT_EXACT: "copy=2 src=2\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true

struct W:
    List@(i32) items

fn main() i32:
    let List@(i32) l = List.new()
    l.push(7)
    l.push(8)
    let W w = W(l)
    let List@(i32) b = w.items
    println("copy={b.len()} src={w.items.len()}")
    return Result.Ok(0)
