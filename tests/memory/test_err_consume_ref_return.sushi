# The RETURN sink with a reference source: handing the caller's borrowed value to
# ITS caller would give it a second owner.
# EXPECT_ERROR_CODE: CE2411
fn f(poke i32[] a) i32[]:
    return Result.Ok(a)

fn main() i32:
    let i32[] arr = from([1, 2, 3])
    let Result@(i32[], StdError) r = f(poke arr)
    if (r):
        println("after")
    return Result.Ok(0)
