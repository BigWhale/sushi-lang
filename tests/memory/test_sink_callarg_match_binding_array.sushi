# Sink matrix (match binding -> every sink): a borrowed enum-payload `match` binding of type `i32[]` handed to the call-argument (CONTROL -- the one sink that is correct today) sink.
#
# The invariant (docs/design/move-semantics.md S3): at every by-value ownership sink a
# bare OWNED Name moves, and anything that reads from a CONTINUING owner -- a borrowed
# pattern binding, a MemberAccess, an Own@(T).get() deref -- is CLONED so each owner
# frees exactly once. Only the call-argument sink implements this today; see MM.md S2.1.
#
# This is the CONTROL. It passes today and must keep passing: it is the
# reference implementation every other row in the matrix should match.
# EXPECT_STDOUT_EXACT: "eaten=3\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true

enum Shape:
    Poly(i32[])
    Empty

fn eat(i32[] a) i32:
    return Result.Ok(a.len())

fn main() i32:
    let Shape s = Shape.Poly(from([1, 2, 3]))
    match s:
        Shape.Poly(p) ->
            println("eaten={eat(p).realise(-1)}")
        Shape.Empty -> println("empty")
    return Result.Ok(0)
