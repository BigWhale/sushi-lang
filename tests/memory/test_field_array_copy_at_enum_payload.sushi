# The enum-constructor payload sink of #250, in its general (user enum) form. The return
# case (test_field_array_copy_at_return.sushi) is the same sink reached through Result.Ok,
# since a return wraps its value in an enum constructor -- this pins the shape directly,
# with no return involved, so a regression is attributed to the constructor and not to
# returns.py. move_owning_arg_into_container only moves a bare Name, so a MemberAccess
# payload was previously neither moved nor cloned and aliased the field.
# EXPECT_STDOUT_EXACT: "boxed=3\nsrc=3\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true

struct W:
    i32[] items

enum Box:
    Full(i32[])
    Empty

fn main() i32:
    let W w = W(from([1, 2, 3]))
    let Box bx = Box.Full(w.items)
    match bx:
        Box.Full(data) -> println("boxed={data.len()}")
        Box.Empty -> println("boxed=0")
    println("src={w.items.len()}")
    return Result.Ok(0)
