# The enum-payload sink with a reference source.
# EXPECT_ERROR_CODE: CE2411
fn f(poke i32[] a) ~:
    let Maybe@(i32[]) m = Maybe.Some(a)
    println(m.is_some())
    return Result.Ok(~)

fn main() i32:
    let i32[] arr = from([1, 2, 3])
    let Result@(~, StdError) r = f(poke arr)
    if (r):
        println("after")
    return Result.Ok(0)
