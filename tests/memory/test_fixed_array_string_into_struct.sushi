# The CONSTRUCTOR-FIELD sink for a fixed array of owning elements.
#
# Converted by Phase 9 (FIX.md X2). Before the flip this pinned an implicit copy: `Names(arr)`
# duplicated the `string[2]` at the sink and the source stayed usable. That tier is gone, so
# the clone is written by hand and the sink now receives a FRESH temp. What is still being
# tested is the sink itself -- a fixed array of owning elements handed to a constructor field
# must be stored and freed exactly once.
#
# The original defect this file was written for: `emit_value_clone` had no `ArrayType` arm
# while `emit_value_destructor` did, so the struct clone's gate PASSED for a `string[2]` field
# and then handed it to a no-op passthrough -- "clone fewer buffers -> double-free".
# `tests/memory/test_clone_fixed_array.sushi` pins `string[N].clone()` on its own.
#
# Interpolated (owned) strings are load-bearing: a literal has owned=0 and never frees, so it
# would pass this file whether or not the elements were really duplicated.
# EXPECT_STDOUT_EXACT: "n=a1 src=a1\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true

struct Names:
    string[2] items

fn main() i32:
    let i32 k = 1
    let string[2] arr = ["a{k}", "b{k}"]
    let Names n = Names(arr.clone())
    println("n={n.items[0]} src={arr[0]}")
    return Result.Ok(0)
