# EXPECT_STDOUT_EXACT: "8080\n9000\n"
# EXPECT_RUNTIME_EXIT: 0
# TEST_TYPE: runtime
# EXPECTED_OUTPUT: 8080
# EXPECTED_OUTPUT: 9000
# EXPECT_NO_LEAKS: true

# `set_port(poke cfg.port)` takes a `poke` borrow through `cfg`, which is itself a
# `poke` reference. It passes exclusive access to a strictly SMALLER place: one field.
# That is disjoint-field borrowing, the idiomatic way to hand a helper one field of a
# `poke` parameter, and Rust accepts it without a word. A whole-parameter forward
# (`inner(poke n)`) is equally silent since CW2409 was retired -- the gate for that is
# tests/memory/poke_forwarding/test_poke_pass_through_clean.sushi.
#
# The exit code here is load-bearing: if any diagnostic starts to fire on a field
# borrow, this test goes red (a warning exits 1), and that is the intended alarm, not a
# bug in the test.

struct Config:
    i32 port

fn set_port(poke i32 p) ~:
    p := 9000
    return Result.Ok(~)

fn update_config(poke Config cfg) ~:
    set_port(poke cfg.port)
    return Result.Ok(~)

fn main() i32:
    let Config c = Config(8080)
    println(c.port)
    update_config(poke c)
    println(c.port)
    return Result.Ok(0)
