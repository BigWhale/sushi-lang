# A CONSTRUCTION that owns heap is freed once when it is a field read's receiver
#
# The second shape #624 made writable: the struct is built for the read and nothing
# else names it (#610).
# EXPECT_STDOUT_EXACT: "2\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true

struct Row:
    string label
    i32 weight

fn main() i32:
    let i32 w = Row("mostly harmless", 2).weight
    println(w)
    return Result.Ok(0)
