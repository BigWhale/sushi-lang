# A rebind RE-INITIALIZES, so the binding stops being a BORROW: `b` starts as a borrowed
# view of the caller's array and then gets a value of its own, which it may hand away.
# The provenance triple survived the rebind, so this was a false CE2411.
# EXPECT_STDOUT_EXACT: "3\n0\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS
fn eat(i32[] a) i32:
    return Result.Ok(a.len())

fn run_test(peek i32[] src) i32:
    let i32[] b = src
    b := from([1, 2, 3])
    println(eat(b)??)
    return Result.Ok(0)

fn main() i32:
    let i32[] arr = from([9])
    println(run_test(peek arr).realise(-1))
    return Result.Ok(0)
