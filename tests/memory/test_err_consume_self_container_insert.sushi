# The container-insert sink, for `self`. A `List` stores its element shallowly and frees it,
# so pushing the receiver makes the list a second owner of the caller's buffer -- compiled
# clean, `double_frees=1`.
# EXPECT_ERROR_CODE: CE2411
struct Holder:
    string label

extend Holder stash(&poke List@(Holder) sink) i32:
    sink.push(self)
    return 1

fn main() i32:
    let List@(Holder) l = List.new()
    let Holder h = Holder("initial-{0}")
    let i32 x = h.stash(&poke l)
    println("len: {l.len()} x: {x}")
    l.free()
    return Result.Ok(0)
