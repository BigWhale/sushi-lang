# The payload does not have to be a struct. `Own@(Own@(i32)).get()` yields an
# Own@(i32) that `outer` still owns; passing it to a by-value owning parameter
# hands the callee a second owner and both free it (SIGABRT, exit 134).
#
# #106 covered exactly one shape of this -- an Own-typed `let` binding, which
# skipped RAII registration by name (`stmt.value.method != 'get'`). That guard
# reached one sink and one type, which is why this one stayed broken. The
# binding is now an independent copy instead, so every sink behaves alike.
# EXPECT_STDOUT_EXACT: "v=42\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true

fn takes(Own@(i32) x) i32:
    return Result.Ok(x.get())

fn run_test() i32:
    let Own@(i32) inner = Own.alloc(42)
    let Own@(Own@(i32)) outer = Own.alloc(inner)
    let i32 v = takes(outer.get())??
    println("v={v}")
    return Result.Ok(0)

fn main() i32:
    return Result.Ok(run_test().realise(99))
