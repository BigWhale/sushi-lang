# A `break` and a `return` leave a loop body that holds a `HashMap@(K, V)` local with
# owning keys and values. Each exit destroys the buckets and every entry once.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "round 0 has 2\nround 1 has 2\nbreak at 1\nround 0 has 2\nround 1 has 2\nreturn at 1\n"
use <collections/hashmap>

fn fill(i32 i) HashMap@(string, string):
    let HashMap@(string, string) m = HashMap.new()
    m.insert("a{i}", "first {i}")
    m.insert("b{i}", "second {i}")
    return m

fn on_break() i32:
    let i32 i = 0
    while (true):
        let HashMap@(string, string) m = fill(i)
        println("round {i} has {m.len()}")
        if (i == 1):
            println("break at {i}")
            break
        i := i + 1
    return i

fn on_return() i32:
    foreach(i in 0..5):
        let HashMap@(string, string) m = fill(i)
        println("round {i} has {m.len()}")
        if (i == 1):
            println("return at {i}")
            return i
    return 0

fn main() i32:
    let i32 a = on_break()
    let i32 b = on_return()
    return a + b - 2
