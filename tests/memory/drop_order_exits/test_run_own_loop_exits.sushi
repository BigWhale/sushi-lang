# A `break` and a `return` leave a loop body that holds an `Own@(T)` local. Each exit
# destroys the box and the string in its payload once.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "box 0\nbox 1\nbreak at 1\nbox 0\nbox 1\nbox 2\nreturn at 2\n"
struct Note:
    string text

fn on_break() i32:
    let i32 i = 0
    while (true):
        let Own@(Note) o = Own.alloc(Note("box {i}"))
        println(o.get().text)
        if (i == 1):
            println("break at {i}")
            break
        i := i + 1
    return i

fn on_return() i32:
    foreach(i in 0..5):
        let Own@(Note) o = Own.alloc(Note("box {i}"))
        println(o.get().text)
        if (i == 2):
            println("return at {i}")
            return i
    return 0

fn main() i32:
    let i32 a = on_break()
    let i32 b = on_return()
    return a + b - 3
