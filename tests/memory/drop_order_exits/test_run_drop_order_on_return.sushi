# A return destroys the owning locals in reverse declaration order, whatever registry
# holds each one: a List@(Res) declared between two structs is destroyed between them.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "a c 1\ndrop c\ndrop b-in-list\ndrop a\n"
struct Res:
    string name

extend Res with Drop:
    fn drop(poke self) ~:
        println("drop {self.name}")

fn mixed() i32:
    let Res a = Res("a")
    let List@(Res) l = List.new()
    l.push(Res("b-in-list"))
    let Res c = Res("c")
    println("{a.name} {c.name} {l.len()}")
    return Result.Ok(0)

fn main() i32:
    let i32 m = mixed().realise(1)
    return Result.Ok(m)
