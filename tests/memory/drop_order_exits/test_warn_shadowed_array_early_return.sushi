# A return inside a block that shadows an owning dynamic array destroys each array
# once: the inner one and the outer one, each through its own descriptor.
# Shadowing is legal but warned (CW1002), so this fixture must compile with the warning.
# EXPECT_ERROR_CODE: CW1002
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "2\n"
fn f() i32:
    let i32[] buf = from([1, 2, 3])
    if (buf.len() == 3):
        let i32[] buf = from([4, 5])
        return Result.Ok(buf.len())
    return Result.Ok(0)

fn main() i32:
    println(f().realise(9))
    return Result.Ok(0)
