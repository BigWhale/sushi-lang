# `realise`, `err` and `expect` over an owning payload. A temporary receiver gives its
# payload away on the path that reads it and drops on the other path. A named receiver
# stays usable, and a temporary default drops on the path that does not take it.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "vok\nd1\nd2\nvok\nd3\nvok\nvok\nerr verr\nnone\ntrue\nmsome\nmsome\nmsome\nm2\n"
# EXPECT_NO_LEAKS

error Bad:
    Oops(string)

fn get(bool ok) string | Bad:
    let string base = "v"
    if (ok):
        return Result.Ok("{base}ok")
    return Result.Err(Bad.Oops("{base}err"))

fn some(bool yes) Maybe@(string):
    let string base = "m"
    if (yes):
        return Maybe.Some("{base}some")
    return Maybe.None

fn main() i32:
    let string base = "d"
    println(get(true).realise("{base}0"))
    println(get(false).realise("{base}1"))
    let string fallback = "{base}2"
    println(get(false).realise(fallback))
    println(get(true).realise(fallback))
    let Result@(string, Bad) r = get(true)
    let Result@(string, Bad) q = get(false)
    println(q.realise("{base}3"))
    println(r.realise(fallback))
    println(r.realise("{base}4"))
    match get(false).err():
        Maybe.Some(Bad.Oops(s)) -> println("err {s}")
        Maybe.None -> println("none")
    match get(true).err():
        Maybe.Some(_) -> println("err")
        Maybe.None -> println("none")
    println(q.err().is_some())
    println(some(true).expect("no value"))
    let Maybe@(string) m = some(true)
    println(m.expect("no value"))
    println(m.realise("{base}5"))
    println(some(false).realise("m2"))
    return 0
