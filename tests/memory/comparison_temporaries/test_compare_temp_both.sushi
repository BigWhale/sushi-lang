# Two owning string temporaries, one on each side of ==, are both freed.
# EXPECT_STDOUT_EXACT: "true\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
use <collections/strings>

fn word(string s) string:
    return s.s(0, 8)

fn look(bool b) i32:
    if (b):
        return 1
    return 0

fn main() i32:
    let string a = "manifest x"
    let bool b = a.s(0, 8) == a.s(0, 8)
    println(b)
    return 0
