# A comparison of an owning string temporary in a second if test is freed, and a first arm that is taken frees nothing it did not make.
# EXPECT_STDOUT_EXACT: "first\nsecond\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
use <collections/strings>

fn word(string s) string:
    return Result.Ok(s.s(0, 8))

fn look(bool b) i32:
    if (b):
        return Result.Ok(1)
    return Result.Ok(0)

fn main() i32:
    let string a = "manifest x"
    let i32 i = 0
    while (i < 2):
        if (i == 0):
            println("first")
        elif (a.s(0, 8) == "manifest"):
            println("second")
        i := i + 1
    return Result.Ok(0)
