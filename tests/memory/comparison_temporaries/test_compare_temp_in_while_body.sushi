# A comparison of an owning string temporary in a while body is freed on each iteration.
# EXPECT_STDOUT_EXACT: "3\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
use <collections/strings>

fn word(string s) string:
    return s.s(0, 8)

fn look(bool b) i32:
    if (b):
        return 1
    return 0

fn main() i32:
    let string a = "manifest x"
    let i32 i = 0
    let i32 hits = 0
    while (i < 3):
        if (a.s(0, 8) == "manifest"):
            hits := hits + 1
        i := i + 1
    println(hits)
    return 0
