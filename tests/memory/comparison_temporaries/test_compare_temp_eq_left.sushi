# An owning string temporary on the left of == is freed.
# EXPECT_STDOUT_EXACT: "true\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
use <collections/strings>

fn word(string s) string:
    return s.s(0, 8)

fn look(bool b) i32:
    if (b):
        return 1
    return 0

fn main() i32:
    let bool b = word("manifest x") == "manifest"
    println(b)
    return 0
