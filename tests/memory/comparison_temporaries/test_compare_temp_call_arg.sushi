# A comparison of an owning string temporary as a bool call argument frees the temporary.
# EXPECT_STDOUT_EXACT: "1\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
use <collections/strings>

fn word(string s) string:
    return Result.Ok(s.s(0, 8))

fn look(bool b) i32:
    if (b):
        return Result.Ok(1)
    return Result.Ok(0)

fn main() i32:
    let string a = "manifest x"
    println(look(a.s(0, 8) == "manifest").realise(0))
    return Result.Ok(0)
