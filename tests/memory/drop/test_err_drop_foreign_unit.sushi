# R2b, the orphan rule narrowed to Drop: only the unit that declares the type may
# say what happens when it drops. A consumer's implementation would otherwise
# REPLACE a library's and silently stop a handle from closing.
# TEST_TYPE: error
# EXPECT_ERROR_CODE: CE4012
use "helpers/gadget"

extend Gadget with Drop:
    fn drop(poke self) ~:
        println("not yours to close")

fn main() i32:
    let Gadget g = Gadget(1)
    println("{g.id}")
    return Result.Ok(0)
