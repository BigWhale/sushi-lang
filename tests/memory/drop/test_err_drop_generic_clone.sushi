# A generic body that clones, instantiated at a resource type. The refusal is
# reported at the INSTANTIATION: the body clones only through the constraint `Clone`,
# and a type that holds a resource has no `Clone`, so the argument is what makes the
# call illegal (#1070).
# EXPECT_ERROR_CODE: CE4006
struct Handle:
    i32 id

extend Handle with Drop:
    fn drop(poke self) ~:
        println("drop {self.id}")

fn twice@(T: Clone)(peek T x) T:
    return x.clone()

fn main() i32:
    let Handle h = Handle(1)
    let Handle t = twice(peek h)
    println("{t.id}")
    return 0
