# A generic body that clones, instantiated at a resource type. The refusal is
# reported at the INSTANTIATION: one monomorphized body serves every argument, so
# the argument is what makes it illegal.
# TEST_TYPE: error
# EXPECT_ERROR_CODE: CE2431
struct Handle:
    i32 id

extend Handle with Drop:
    fn drop(poke self) ~:
        println("drop {self.id}")

fn twice@(T)(peek T x) T:
    return Result.Ok(x.clone())

fn main() i32:
    let Handle h = Handle(1)
    let Handle t = twice(peek h)??
    println("{t.id}")
    return Result.Ok(0)
