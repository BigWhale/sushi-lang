# Consuming a BORROW of a resource type is CE2411, unchanged. A field read is a
# borrow, and handing it to a `nom` parameter consumes it.
# TEST_TYPE: error
# EXPECT_ERROR_CODE: CE2411
struct Handle:
    i32 id

extend Handle with Drop:
    fn drop(poke self) ~:
        println("drop {self.id}")

struct Wrapper:
    Handle inner

fn eat(nom Handle h) ~:
    println("eating {h.id}")
    return Result.Ok(~)

fn main() i32:
    let Wrapper w = Wrapper(Handle(1))
    eat(nom w.inner)
    return Result.Ok(0)
