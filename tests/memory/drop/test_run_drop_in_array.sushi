# The same rule for a dynamic array: every slot drops exactly once.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "2\ndrop 1\ndrop 2\n"
struct Handle:
    i32 id

extend Handle with Drop:
    fn drop(poke self) ~:
        println("drop {self.id}")

fn main() i32:
    let Handle[] xs = from([Handle(1), Handle(2)])
    println("{xs.len()}")
    return Result.Ok(0)
