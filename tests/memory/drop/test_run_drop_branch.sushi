# Moved in one arm of an `if` and not the other. It drops exactly once on each
# path, which is the runtime move flag doing its work.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "eating 1\ndrop 1\nrun end\nrun end\ndrop 1\n"
struct Handle:
    i32 id

extend Handle with Drop:
    fn drop(poke self) ~:
        println("drop {self.id}")

fn eat(nom Handle h) ~:
    println("eating {h.id}")
    return Result.Ok(~)

fn run(bool go) ~:
    let Handle h = Handle(1)
    if (go):
        eat(nom h)
    println("run end")
    return Result.Ok(~)

fn main() i32:
    run(true)
    run(false)
    return Result.Ok(0)
