# CE2411's help offers `.clone()`, and a resource type has no clone. For a resource it
# must name `.share()` instead and say why: a rejection with no escape is what the clone
# gate exists to prevent.
# TEST_TYPE: error
# EXPECT_ERROR_CODE: CE2411
# EXPECT_STDERR_CONTAINS: ".share()"
struct Handle:
    i32 id

extend Handle with Drop:
    fn drop(poke self) ~:
        println("drop {self.id}")

struct Wrapper:
    Handle inner

fn eat(nom Handle h) ~:
    println("eating {h.id}")
    return Result.Ok(~)

fn steal(peek Wrapper w) ~:
    eat(nom w.inner)
    return Result.Ok(~)

fn main() i32:
    println("Mostly Harmless")
    return Result.Ok(0)
