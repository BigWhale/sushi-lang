# CE2411's help offers `.clone()`, and a resource type has no clone. For a resource it
# must say why, and it names `.share()` only for a type that has one (#1023): a rejection
# with no escape is what the clone gate exists to prevent.
# EXPECT_ERROR_CODE: CE2411
# EXPECT_STDERR_CONTAINS: "has no `share()` that gives a second owner"
struct Handle:
    i32 id

extend Handle with Drop:
    fn drop(poke self) ~:
        println("drop {self.id}")

struct Wrapper:
    Handle inner

fn eat(nom Handle h) ~:
    println("eating {h.id}")

fn steal(peek Wrapper w) ~:
    eat(nom w.inner)

fn main() i32:
    println("Mostly Harmless")
    return 0
