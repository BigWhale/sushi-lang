# A shadowing Own@(Res) in a nested block does not replace the outer entry: the inner
# one is dropped at the block exit and the outer one at the return.
# Shadowing is legal but warned (CW1002), so this fixture must compile with the warning.
# EXPECT_ERROR_CODE: CW1002
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "in inner\ndrop inner\nafter block\nin outer\ndrop outer\n"
struct Res:
    string name

extend Res with Drop:
    fn drop(poke self) ~:
        println("drop {self.name}")

fn run(bool go) i32:
    let Own@(Res) o = Own.alloc(Res("outer"))
    if (go):
        let Own@(Res) o = Own.alloc(Res("inner"))
        println("in {o.get().name}")
    println("after block")
    println("in {o.get().name}")
    return Result.Ok(0)

fn main() i32:
    let i32 r = run(true).realise(1)
    return Result.Ok(r)
