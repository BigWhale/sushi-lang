# An Own@(T) local in a `foreach` body is destroyed at the end of every iteration.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "10\n20\n30\ndone\n"
fn main() i32:
    let i32[] xs = from([1, 2, 3])
    foreach(x in xs.iter()):
        let Own@(i32) o = Own.alloc(x * 10)
        println(o.get())
    println("done")
    return Result.Ok(0)
