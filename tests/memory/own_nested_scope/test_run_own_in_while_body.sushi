# An Own@(T) local in a `while` body is destroyed at the end of every iteration.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "0\n1\n2\ndone\n"
fn main() i32:
    let i32 i = 0
    while (i < 3):
        let Own@(i32) o = Own.alloc(i)
        println(o.get())
        i := i + 1
    println("done")
    return Result.Ok(0)
