# A function value carries a clone, so CE2411's advice is something the user can take.
#
# A closure read out of a struct field or out of a container is a BORROW (closures T1.5):
# the struct and the container keep the environment and still free it. Consuming that
# borrow is CE2411 -- the negative twin is test_err_consume_closure_field.sushi -- and the
# diagnostic says "clone it to take an independent value". Before this file
# `h.handler.clone()` was not a rejection but a CE0000: a method call on a fn value was
# never validated at all, so dispatch fell through to the user extension-method path, which
# mangled the name to `fn(i32) - i32_clone` and died looking for a symbol nobody defines.
# Same failure mode as MM.md finding A2.
#
# The environment is duplicated through the fat pointer's `clone_ptr` slot, the structural
# inverse of the destructor's `drop_ptr`, so each owner frees exactly once. That is what
# the leak assertion checks. A double free would exit 133 and the interposer scores that as
# a SKIP, so read the runner's count, never the binary's exit code.
#
# Two consuming uses are covered here, a container insert and a return. A by-value ARGUMENT
# is deliberately absent: passing an owning closure to a by-value parameter leaks its
# environment, which is pre-existing and unrelated to cloning -- MM.md finding F12.
# EXPECT_STDOUT_EXACT: "15 17 19 21\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true

struct Holder:
    fn(i32) -> i32 handler

# A return is a consuming use: the caller becomes the owner, so the field must be cloned.
fn pick(peek Holder h) fn(i32) -> i32:
    return Result.Ok(h.handler.clone())

fn run() i32:
    let i32 k = 10
    let Holder h = Holder(|i32 x| x + k)

    # A container insert is a consuming use; the list owns and frees its own copy.
    let List@(fn(i32) -> i32) fns = List.new()
    fns.push(h.handler.clone())
    let i32 a = fns.get(0)??(5)??

    let fn(i32) -> i32 g = pick(peek h)??
    let i32 b = g(7)??

    # A container get-out borrows for the same reason a field read does.
    let fn(i32) -> i32 from_list = fns.get(0)??.clone()
    let i32 c = from_list(9)??

    # Every owner above is independent, so the original still works.
    let i32 d = h.handler(11)??

    fns.destroy()
    println("{a} {b} {c} {d}")
    return Result.Ok(0)

fn main() i32:
    let i32 rc = run().realise(1)
    return Result.Ok(rc)
