# A `let` bound FROM a reference binds a borrow, so consuming the binding is the same
# error (#310). It used to compile and double-free the caller's buffer.
# EXPECT_ERROR_CODE: CE2411
fn eat(i32[] a) ~:
    println("ate {a.len()}")
    return Result.Ok(~)

fn f(&poke i32[] a) ~:
    let i32[] b = a
    eat(b)
    return Result.Ok(~)

fn main() i32:
    let i32[] arr = from([1, 2, 3])
    let Result@(~, StdError) r = f(&poke arr)
    if (r):
        println("after")
    return Result.Ok(0)
