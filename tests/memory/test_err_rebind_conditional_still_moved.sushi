# F5 companion: a rebind on ONE branch of an `if` does not clear the move on the other
# path. The flow join is a union (moved on ANY path stays moved -- Rust's rule), so the
# use after the `if` is a use-after-move.
# EXPECT_ERROR_CODE: CE2405

fn take(string s) ~:
    println(s)
    return Result.Ok(~)

fn go(bool flag) ~:
    let string y = "yy"
    let string s = "m-{y}"
    take(s)
    if (flag):
        s := "new-{y}"
    println(s)
    return Result.Ok(~)

fn main() i32:
    let Result@(~, StdError) r = go(true)
    if (r):
        return Result.Ok(0)
    return Result.Ok(1)
