# Issue #253: a write through a match binding lands on a private copy and is lost.
# The binding is a read-only view (docs/design/ownership-conventions.md S8), so a
# mutating method through it must be a compile error, not a silent discard.
# EXPECT_ERROR_CODE: CE2414

enum Shape:
    Poly(i32[])
    Empty

fn main() i32:
    let Shape s = Shape.Poly(from([1, 2, 3]))
    match s:
        Shape.Poly(p) -> p.push(9)
        Shape.Empty -> println("empty")
    return Result.Ok(0)
