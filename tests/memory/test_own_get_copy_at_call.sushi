# The call-argument sink of #256. A by-value owning-struct parameter TAKES
# ownership (#134), so the callee frees the payload at its scope exit -- while
# `o` still frees the same inner Own@(Leafy) at ours. Two owners, one buffer.
#
# Not in the issue as filed; found by looking for the bug's shape where the
# reported trigger (a `let`) is absent.
# EXPECT_STDOUT_EXACT: "v=1\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true

struct Leafy:
    i32 x

struct Holder:
    i32 value
    Maybe@(Own@(Leafy)) next

fn takes(Holder h) i32:
    return Result.Ok(h.value)

fn run_test() i32:
    let Leafy l = Leafy(9)
    let Holder h = Holder(1, Maybe.Some(Own.alloc(l)))
    let Own@(Holder) o = Own.alloc(h)
    let i32 v = takes(o.get())??
    println("v={v}")
    return Result.Ok(0)

fn main() i32:
    return Result.Ok(run_test().realise(99))
