# F5 (fixed 2026-08-14): a rebind RE-INITIALIZES a binding, and the old value is freed.
#   1. `take(s)` then `s := "new-..."` compiles (the move no longer holds) and the NEW
#      buffer is freed at scope exit (the moved flag is cleared by the rebind).
#   2. A plain string rebind frees the OLD heap buffer before overwriting it.
#   3. The same two rules for a dynamic array.
# A CLOSURE rebind (`g := make(5)??`) is not covered here: it is rejected by a
# pre-existing validation defect, CE2002 "cannot assign fn(i32) -> i32 to
# fn(i32) -> i32" (an unresolved err_type in the FunctionType comparison). Filed
# with the Phase 12 batch; the backend's rebind path already frees the old env
# and clears the moved flag for the day that lands.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "m-yy\nnew-yy\nb-yy\n3\n2\n"
# EXPECT_NO_LEAKS: true

fn take(string s) ~:
    println(s)
    return Result.Ok(~)

fn eat(i32[] a) ~:
    println(a.len())
    return Result.Ok(~)

fn go() ~:
    let string y = "yy"
    let string s = "m-{y}"
    take(s)
    s := "new-{y}"
    println(s)
    let string a = "x-{y}"
    a := "b-{y}"
    println(a)
    let i32[] arr = from([1, 2, 3])
    eat(arr)
    arr := from([4, 5])
    println(arr.len())
    return Result.Ok(~)

fn main() i32:
    let Result@(~, StdError) r = go()
    if (r):
        return Result.Ok(0)
    return Result.Ok(1)
