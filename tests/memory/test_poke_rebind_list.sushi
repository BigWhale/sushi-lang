# A `&poke List@(i32)` rebind: the callee replaces the caller's list through the
# pointer. The old list's buffer must be freed by the rebind, the new one by the
# caller at scope exit.
# EXPECT_STDOUT_EXACT: "2\n77\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS
fn replace_list(&poke List@(i32) l) ~:
    let List@(i32) fresh = List.new()
    fresh.push(77)
    fresh.push(88)
    l := fresh
    return Result.Ok(~)

fn run_test() i32:
    let List@(i32) numbers = List.new()
    numbers.push(1)
    numbers.push(2)
    numbers.push(3)
    replace_list(&poke numbers)
    println(numbers.len())
    println(numbers.get(0)??)
    return Result.Ok(0)

fn main() i32:
    let i32 code = run_test().realise(1)
    return Result.Ok(code)
