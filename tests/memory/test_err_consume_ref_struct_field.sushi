# The struct-constructor sink with a reference source: the struct would own and free
# a buffer the caller still owns.
# EXPECT_ERROR_CODE: CE2411
struct Holder:
    i32[] items

fn f(poke i32[] a) ~:
    let Holder h = Holder(a)
    println(h.items.len())
    return Result.Ok(~)

fn main() i32:
    let i32[] arr = from([1, 2, 3])
    let Result@(~, StdError) r = f(poke arr)
    if (r):
        println("after")
    return Result.Ok(0)
