# Sink matrix (match binding -> every sink): a borrowed enum-payload `match` binding of type `i32[]` handed to the `HashMap.insert` sink.
#
# The invariant (docs/design/move-semantics.md S3): at every by-value ownership sink a
# bare OWNED Name moves, and anything that reads from a CONTINUING owner -- a borrowed
# pattern binding, a MemberAccess, an Own@(T).get() deref -- is CLONED so each owner
# frees exactly once. Only the call-argument sink implements this today; see MM.md S2.1.
# EXPECT_STDOUT_EXACT: "m=1\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
use <collections/hashmap>

enum Shape:
    Poly(i32[])
    Empty

fn main() i32:
    let Shape s = Shape.Poly(from([1, 2, 3]))
    let HashMap@(i32, i32[]) m = HashMap.new()
    match s:
        Shape.Poly(p) ->
            m.insert(1, p)
            println("m={m.len()}")
        Shape.Empty -> println("empty")
    m.free()
    return Result.Ok(0)
