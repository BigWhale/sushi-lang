# Sink matrix (match binding (enum-typed) -> sinks): a borrowed `match` binding whose type is a user ENUM handed to the struct-constructor field sink.
#
# The invariant (docs/design/move-semantics.md S3): at every by-value ownership sink a
# bare OWNED Name moves, and anything that reads from a CONTINUING owner -- a borrowed
# pattern binding, a MemberAccess, an Own@(T).get() deref -- is CLONED so each owner
# frees exactly once. Only the call-argument sink implements this today; see MM.md S2.1.
#
# Regression guard for the cell the deleted test_move_borrow_binding_* pins
# covered: an ENUM-typed binding, which `is_owned_local` never registers, so the
# gate answers 'borrow' without being asked the hard question. Passed before this
# branch and must keep passing -- it is the shape that gave false confidence.
# EXPECT_STDOUT_EXACT: "n=3\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true

enum Box:
    Full(i32[])
    Empty

enum Wrap:
    Has(Box)
    No

struct Holder:
    Box b

fn main() i32:
    let Wrap w = Wrap.Has(Box.Full(from([1, 2, 3])))
    match w:
        Wrap.Has(inner) ->
            let Holder h = Holder(inner)
            match h.b:
                Box.Full(xs) -> println("n={xs.len()}")
                Box.Empty -> println("n=0")
        Wrap.No -> println("no")
    return Result.Ok(0)
