# The `peek` twin of the `poke` consume (#301). The mode does not change the answer:
# both are borrows of the caller's value.
# EXPECT_ERROR_CODE: CE2411
fn eat(nom i32[] a) ~:
    println("ate {a.len()}")
    return Result.Ok(~)

fn f(peek i32[] a) ~:
    eat(nom a)
    return Result.Ok(~)

fn main() i32:
    let i32[] arr = from([1, 2, 3])
    let Result@(~, StdError) r = f(peek arr)
    if (r):
        println("after")
    return Result.Ok(0)
