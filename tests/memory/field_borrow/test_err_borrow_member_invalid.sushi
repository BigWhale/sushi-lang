# Test: Cannot borrow temporary values
# EXPECT_ERROR_CODE: CE2404
# Expected: CE2404 error

struct Config:
    i32 port

fn get_config() Config | StdError:
    return Result.Ok(Config(8080))

fn modify_port(poke i32 p) ~:
    p := 9000

fn main() i32:
    modify_port(poke get_config().port)
    return 0
