# EXPECT_STDOUT_EXACT: "8080\n8180\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true

struct Config:
    i32 port
    string host

fn modify_port(poke i32 p) ~:
    p := p + 100

fn main() i32:
    let Config cfg = Config(8080, "localhost")
    println(cfg.port)
    modify_port(poke cfg.port)
    println(cfg.port)
    return 0
