# An in-place array method through a `peek` borrow. `.fill()` and `.reverse()`
# write to the caller's buffer, so they are the same error as `.push()`.
# EXPECT_ERROR_CODE: CE2408
fn wipe(peek i32[] a) ~:
    a.fill(7)
    return Result.Ok(~)

fn run_test() i32:
    let i32[] xs = from([1, 2, 3])
    wipe(peek xs)
    println(xs.get(0)??)
    return Result.Ok(0)

fn main() i32:
    let i32 code = run_test().realise(1)
    return Result.Ok(code)
