# A field assignment through a `peek` reference. The store used to land in the
# caller's struct with no diagnostic, so a read-only parameter changed it.
# EXPECT_ERROR_CODE: CE2408
struct Counter:
    i32 n

fn bump(peek Counter c) ~:
    c.n := 42

fn run_test() i32:
    let Counter counter = Counter(1)
    bump(peek counter)
    println(counter.n)
    return 0

fn main() i32:
    let i32 code = run_test()
    return code
