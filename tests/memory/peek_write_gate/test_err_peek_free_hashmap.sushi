# `.free()` releases everything the map owns. Through a `peek` borrow it used to
# compile with no diagnostic, so a read-only parameter emptied the caller's map.
# EXPECT_ERROR_CODE: CE2408
use <collections/hashmap>

fn wreck(peek HashMap@(i32, string) m) ~:
    m.free()

fn run_test() i32:
    let HashMap@(i32, string) map = HashMap.new()
    map.insert(1, "one")
    wreck(peek map)
    println(map.len())
    return 0

fn main() i32:
    let i32 code = run_test()
    return code
