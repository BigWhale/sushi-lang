# Reading a field straight off `Own@(T).get()` without binding the value first.
#
# The backend's struct-type inference had one case for `.get()` -- a `Name`
# receiver whose semantic type is a dynamic array -- and every other receiver
# fell through to:
#
#   error [CE0069]: cannot infer struct type from DotCall: get
#
# which reports a user's ordinary code as an internal compiler defect. Binding
# first (`let Leafy back = o.get()`) already worked, so this was purely about the
# chained spelling.
# EXPECT_STDOUT_EXACT: "x=9\ny=9\n"
# EXPECT_RUNTIME_EXIT: 0

struct Leafy:
    i32 x

fn run_test() i32:
    let Leafy l = Leafy(9)
    let Own@(Leafy) o = Own.alloc(l)

    # inside interpolation ...
    println("x={o.get().x}")

    # ... and as a plain expression
    let i32 y = o.get().x
    println("y={y}")
    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
