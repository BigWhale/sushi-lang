# A List@(File) HOLDS a resource, so a clone of it would copy each descriptor and give it two
# owners that both close it (#770). CE2431 refuses it as it refuses a clone of a File.
# EXPECT_ERROR_CODE: CE2431
# EXPECT_STDERR_CONTAINS: "cannot clone 'List@(File)'"
use <io/fs>
use <collections/hashmap>

fn main() i32:
    let File f = open("/etc/hosts", FileMode.Read()).realise(stdin)
    let List@(File) handles = List.new()
    handles.push(nom f)
    let List@(File) copy = handles.clone()
    println("cloned")
    return Result.Ok(0)
