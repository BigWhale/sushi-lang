# A container of PLAIN values keeps its deep clone (#770 touches only a container that
# holds a resource). The clone is independent: a push to it leaves the source unchanged.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "1 2 1 2 1\n"
# EXPECT_NO_LEAKS
use <collections/hashmap>

fn main() i32:
    let List@(string) a = List.new()
    a.push("x".clone())
    let List@(string) b = a.clone()
    b.push("y".clone())
    let i32[] c = from([1])
    let i32[] d = c.clone()
    d.push(2)
    let HashMap@(i32, string) m = HashMap.new()
    m.insert(1, "one".clone())
    let HashMap@(i32, string) n = m.clone()
    println("{a.len()} {b.len()} {c.len()} {d.len()} {n.len()}")
    return Result.Ok(0)
