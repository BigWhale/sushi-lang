# A File[1] HOLDS a resource, so a clone of it would copy each descriptor and give it two
# owners that both close it (#770). CE2431 refuses it as it refuses a clone of a File.
# EXPECT_ERROR_CODE: CE2431
# EXPECT_STDERR_CONTAINS: "cannot clone 'File[1]'"
use <io/fs>
use <collections/hashmap>

fn main() i32:
    let File f = open("/etc/hosts", FileMode.Read()).realise(stdin)
    let File[1] handles = [f]
    let File[1] copy = handles.clone()
    println("cloned")
    return Result.Ok(0)
