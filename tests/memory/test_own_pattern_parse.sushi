# Test Own pattern with recursive enum types
# EXPECT_NO_LEAKS: true
# A recursive traversal BORROWS the structure. Passing an `Own(...)` match binding
# by value is CE2411 -- the binding borrows storage the Own still owns -- and cloning
# would deep-copy the whole remaining structure at every step.
enum Expr:
    IntLit(i32)
    BinOp(Own@(Expr), Own@(Expr), string)

fn test_pattern(&peek Expr expr) i32:
    match expr:
        Expr.IntLit(n) ->
            return Result.Ok(n)
        Expr.BinOp(Own(left), Own(right), _) ->
            # Recursively evaluate left and right
            let i32 left_val = test_pattern(&peek left).realise(0)
            let i32 right_val = test_pattern(&peek right).realise(0)
            return Result.Ok(left_val + right_val)
    return Result.Ok(0)

fn main() i32:
    # Test with IntLit
    let Expr e1 = Expr.IntLit(5)
    let i32 result = test_pattern(&peek e1).realise(-1)
    let i32 expected = 5
    return Result.Ok(result - expected)
