# Two `let`s of one name in one `while` body are an error.
# EXPECT_ERROR_CODES_EXACT: CE1006
# EXPECT_STDERR_CONTAINS: test_err_let_twice_in_a_while_body.sushi:9:9: error [CE1006]
# EXPECT_STDERR_CONTAINS: test_err_let_twice_in_a_while_body.sushi:8:9\n
fn main() i32:
    let i32 i = 0
    while (i < 2):
        let i32 k = i
        let i32 k = i + 1
        println(k)
        i := i + 1
    return 0
