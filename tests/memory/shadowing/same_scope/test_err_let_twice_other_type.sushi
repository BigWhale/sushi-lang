# A second `let` of one name in one block is an error when the types differ too.
# EXPECT_ERROR_CODES_EXACT: CE1006
# EXPECT_STDERR_CONTAINS: test_err_let_twice_other_type.sushi:7:5: error [CE1006]
# EXPECT_STDERR_CONTAINS: test_err_let_twice_other_type.sushi:6:5\n
fn main() i32:
    let string a = "one"
    let i32 a = 2
    println(a)
    return 0
