# A `let` in an extension method body that repeats a parameter name is an error.
# EXPECT_ERROR_CODES_EXACT: CE1006
# EXPECT_STDERR_CONTAINS: test_err_let_repeats_an_extension_parameter.sushi:6:5: error [CE1006]
# EXPECT_STDERR_CONTAINS: test_err_let_repeats_an_extension_parameter.sushi:5:21\n
extend i32 plus(i32 n) i32:
    let i32 n = 2
    return self + n

fn main() i32:
    println(1.plus(1))
    return 0
