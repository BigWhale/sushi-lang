# One name may be declared again in a sibling block, in a later loop, in each arm of a
# match, in each copy of an `expand` body, and in each `|` alternative of one arm.
# EXPECT_STDOUT_EXACT: "1\n2\n3\n4\n<1>\n<two>\n5\n6\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS
enum Pick:
    Left(i32)
    Right(i32)

fn show@(...Ts: Display)(...Ts args) ~:
    expand(v in args):
        let string s = "<{v}>"
        println(s)

fn side(Pick p) i32:
    match p:
        Pick.Left(n) | Pick.Right(n) -> return n

fn main() i32:
    let bool flag = true
    if (flag):
        let i32 a = 1
        println(a)
    else:
        let i32 a = 0
        println(a)
    foreach(x in 2..3):
        println(x)
    foreach(x in 3..4):
        println(x)
    let Maybe@(i32) m = Maybe.Some(4)
    match m:
        Maybe.Some(v) -> println(v)
        Maybe.None ->
            let i32 v = 0
            println(v)
    show(1, "two")
    println(side(Pick.Left(5)))
    println(side(Pick.Right(6)))
    return 0
