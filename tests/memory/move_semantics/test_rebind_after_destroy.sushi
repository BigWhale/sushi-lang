# A rebind RE-INITIALIZES, so an explicit `.destroy()` before it describes the OLD value
# (#294). Both halves must land together: the checker used to report a false CE2406 at the
# use, and with only the checker half fixed the backend freed the stale pointer -- which
# `malloc` had already handed to the NEW value -- and `o.get()` read freed memory.
# EXPECT_STDOUT_EXACT: "5\n7\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS
fn run_test() i32:
    let Own@(i32) o = Own.alloc(5)
    println(o.get())
    o.destroy()
    o := Own.alloc(7)
    println(o.get())
    return Result.Ok(0)

fn main() i32:
    let i32 code = run_test().realise(1)
    return Result.Ok(code)
