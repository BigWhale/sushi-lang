# The other half of the write gate: a READ through a `&peek` borrow stays legal.
# `.len()`, `.get()`, `.iter()`, an index and a field read take nothing and change
# nothing.
# (`.hash()` through a reference is an internal error, issue #308. It is the twin of
# #301's `.clone()` half and both are repaired at one site in PR 3.)
# EXPECT_STDOUT_EXACT: "3\n1\n6\n1\n2\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS
struct Holder:
    i32[] items

fn read_all(&peek i32[] a) i32:
    println(a.len())
    println(a.get(0)??)
    let i32 total = 0
    foreach(n in a.iter()):
        total := total + n
    println(total)
    println(a[0])
    return Result.Ok(total)

fn read_field(&peek Holder h) i32:
    return Result.Ok(h.items.len())

fn run_test() i32:
    let i32[] xs = from([1, 2, 3])
    let i32 total = read_all(&peek xs).realise(0)
    let Holder holder = Holder(from([7, 8]))
    println(read_field(&peek holder).realise(0))
    return Result.Ok(total - total)

fn main() i32:
    let i32 code = run_test().realise(1)
    return Result.Ok(code)
