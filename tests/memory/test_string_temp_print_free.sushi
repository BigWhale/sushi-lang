# X9 (MM.md F9) and B2: an owned `string` that no binding names must be freed.
# Four shapes, all through the print-arg frame's owned-bit-guarded value free:
#   1. a method result consumed straight as a print argument (`.realise()`),
#   2. the same through `??` in a helper function,
#   3. an extension method that returns an interpolated string,
#   4. a string-method result inside an interpolation (`"{s.upper()}"`, B2) --
#      alone, and concatenated with literal parts.
# The borrow shapes (`println(name)`, `"{name}"`) stay unregistered: their owner
# frees them, so this file also guards against the eager-registration double free.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "hi-there\nhi-there\nn-7\nHELLO\na HELLO b\nhi-there and Ford\n"
# EXPECT_NO_LEAKS: true
use <collections/strings>

extend i32 tagged() string:
    return "n-{self}"

fn go() string:
    let string base = "there"
    return Result.Ok("hi-{base}")

fn show() ~:
    println(go()??)
    println(7.tagged())
    return Result.Ok(~)

fn main() i32:
    println(go().realise("err"))
    let Result@(~, StdError) r = show()
    if (r):
        let string s = "hello"
        let string name = "Ford"
        let string b = "hi-{base_word().realise('eh')}"
        println("{s.upper()}")
        println("a {s.upper()} b")
        println("{b} and {name}")
        return Result.Ok(0)
    return Result.Ok(1)

fn base_word() string:
    return Result.Ok("there")
