# The escape CE2411 names must exist for a reference receiver: `.clone()` derefs, then
# deep-copies, and the copy is the callee's to own. It used to be CE0042 (#301), which
# left the rejection with no way out.
# EXPECT_STDOUT_EXACT: "ate 3\nafter: 3\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS
fn eat(i32[] a) ~:
    println("ate {a.len()}")
    return Result.Ok(~)

fn f(&poke i32[] a) ~:
    eat(a.clone())
    return Result.Ok(~)

fn main() i32:
    let i32[] arr = from([1, 2, 3])
    let Result@(~, StdError) r = f(&poke arr)
    if (r):
        println("after: {arr.len()}")
    return Result.Ok(0)
