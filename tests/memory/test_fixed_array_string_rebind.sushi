# The `let` sink for a fixed array of owning elements. Same root cause as
# test_fixed_array_string_into_struct: `_clone_owning_struct_alias`
# (`statements/variables.py:173`) returns early for anything that is not a StructType or
# EnumType, so an `ArrayType` RHS never reaches `emit_value_clone` -- which would not
# have handled it anyway. MM.md S2 row 5; no upstream issue.
#
# THIS PINS THE TIER PHASE 9 DELETES. Convert it there, do not convert it early. An
# explicit `arr.clone()` goes around the `let` sink this file exists to exercise, so the
# file stays green and asserts nothing. The explicit-clone shape is already pinned by
# tests/memory/test_clone_fixed_array.sushi.
# EXPECT_STDOUT_EXACT: "b=a1 src=a1\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true

fn main() i32:
    let i32 k = 1
    let string[2] arr = ["a{k}", "b{k}"]
    let string[2] b = arr
    println("b={b[0]} src={arr[0]}")
    return Result.Ok(0)
