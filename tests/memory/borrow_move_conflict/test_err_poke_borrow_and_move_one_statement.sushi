# The `poke` shape of borrow-then-move, and the one that corrupts memory today.
#
# `both(poke a, nom a)` gives the callee a mutable view of the caller's array AND the array
# itself by value. The pushes grow the buffer, so the by-value copy's data pointer is the
# one `realloc` released -- and the callee frees it again at scope exit. It compiled clean
# and reported `leaked=32 blocks=1 double_frees=1`, after printing `owned[0]: 2` out of
# freed memory.
# EXPECT_ERROR_CODE: CE2401
fn both(poke i32[] r, nom i32[] owned) i32:
    r.push(4)
    r.push(5)
    r.push(6)
    r.push(7)
    r.push(8)
    println("owned[0]: {owned[0]} owned len: {owned.len()}")
    return Result.Ok(1)

fn run_test() i32:
    let i32[] a = from([1, 2, 3])
    let i32 x = both(poke a, nom a)??
    println("x: {x}")
    return Result.Ok(0)

fn main() i32:
    let i32 code = run_test().realise(1)
    return Result.Ok(code)
