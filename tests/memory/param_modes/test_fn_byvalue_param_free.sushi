# The by-value-parameter ruling (2026-08-14), fn half: the CALLEE owns a by-value
# `fn(...)` parameter and frees its environment exactly once. Shapes covered:
#   1. a bare Name argument (the caller's binding is moved; the callee frees),
#   2. a temporary argument (`make(m)??` -- adopted in; the callee frees),
#   3. an inline lambda argument (adopted in; NOT caller-registered any more),
#   4. the same three through an INDIRECT call (`h(...)` where `h` is a fn value),
#      which uses the same callee-owns ABI -- a lifted lambda body registers its
#      parameters exactly like a plain function.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "12\n18\n24\n18\n27\n36\n"
# EXPECT_NO_LEAKS: true

fn make(i32 m) fn(i32) -> i32:
    return |i32 x| x * m

fn apply(fn(i32) -> i32 f, i32 v) i32:
    return f(v)

fn direct() ~ | StdError:
    println(apply(make(2), 6))
    let fn(i32) -> i32 g = make(3)
    println(apply(g, 6))
    println(apply(|i32 x| x * 4, 6))
    return Result.Ok(~)

fn indirect() ~ | StdError:
    let fn(fn(i32) -> i32, i32) -> i32 h = apply
    println(h(make(3), 6))
    let fn(i32) -> i32 g = make(9)
    println(h(g, 3))
    println(h(|i32 x| x * 6, 6))
    return Result.Ok(~)

fn main() i32:
    let Result@(~, StdError) a = direct()
    if (a.is_ok()):
        let Result@(~, StdError) b = indirect()
        if (b.is_ok()):
            return 0
    return 1
