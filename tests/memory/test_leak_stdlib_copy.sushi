# `copy()` frees everything it allocates, on the success path and on the error path (#291).
#
# It leaked 3 blocks on success -- two marshalled C strings and a 4096-byte buffer -- and 2
# on the error path. It has two `ret` instructions reached by four routes, which is why the
# marshalling moved to the call site and the buffer became a local rather than each exit
# growing a free.
# EXPECT_STDOUT_EXACT: "ok=0 err=-1\n"
# EXPECT_NO_LEAKS
use <io/files>

fn main() i32:
    match open('/tmp/sushi_leak_copy_src.txt', FileMode.Write()):
        FileResult.Ok(f) ->
            f.write("Mostly Harmless")
            f.close()
        FileResult.Err(_) ->
            return Result.Ok(1)

    let i32 ok = copy('/tmp/sushi_leak_copy_src.txt', '/tmp/sushi_leak_copy_dst.txt').realise(-1)
    # The error path: no such source, so the first open(2) fails.
    let i32 err = copy('/tmp/sushi_leak_copy_absent.txt', '/tmp/sushi_leak_copy_out.txt').realise(-1)
    println("ok={ok} err={err}")

    remove('/tmp/sushi_leak_copy_src.txt').realise(-1)
    remove('/tmp/sushi_leak_copy_dst.txt').realise(-1)
    return Result.Ok(0)
