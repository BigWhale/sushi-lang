# A string temporary compared in a while condition is freed on each evaluation.
# EXPECT_STDOUT_EXACT: "3\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
use <collections/strings>

fn look(string s) i32:
    return Result.Ok(s.len())

fn main() i32:
    let string a = "manifest x"
    let i32 i = 0
    while (a.s(0, 8) == "manifest" and i < 3):
        i := i + 1
    println(i)
    return Result.Ok(0)
