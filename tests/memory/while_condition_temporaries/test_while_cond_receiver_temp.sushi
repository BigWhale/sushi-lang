# A receiver temporary in a while condition is freed on each evaluation, not once at scope exit.
# EXPECT_STDOUT_EXACT: "3\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
use <collections/strings>

fn look(string s) i32:
    return s.len()

fn main() i32:
    let string a = "manifest x"
    let i32 i = 0
    while (a.s(0, 8).len() == 8 and i < 3):
        i := i + 1
    println(i)
    return 0
