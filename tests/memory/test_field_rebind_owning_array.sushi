# Assigning an owning value THROUGH a field (`h.data := a`) is an ownership sink: the
# source is consumed (a later use of `a` is CE2405), the buffer the field held is
# destroyed first, and scope exit frees everything exactly once. It did not use to be --
# the emit was a raw GEP + store, so `a` and `h.data` aliased one buffer and both freed
# it, because the rebind arm (now `_check_rebind` in `borrow/statements.py`) gated move
# marking on `isinstance(stmt.target, Name)` and never saw a field target.
# EXPECT_STDOUT_EXACT: "h=3\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true

struct Holder:
    i32[] data

fn main() i32:
    let i32[] a = from([1, 2, 3])
    let Holder h = Holder(from([9]))
    h.data := a
    println("h={h.data.len()}")
    return Result.Ok(0)
