# An owning TEMPORARY handed to a method's borrow parameter is freed exactly once
#
# The caller keeps a borrow parameter's value, and `make()??` names no binding, so
# without a caller-side owner nothing frees it. Only a syntactic inline `Lambda` used to
# be registered, so every other temporary shape leaked. It is the argument's provenance
# that decides now, not its syntax -- the same predicate a spilled receiver uses.
# EXPECT_STDOUT_EXACT: "3\n2\n1\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true

struct Box:
    i32 n

fn make() i32[]:
    return Result.Ok(from([1, 2, 3]))

fn fallback() i32[]:
    return Result.Ok(from([0]))

extend Box look(i32[] a) i32:
    return a.len()

fn plain_look(i32[] a) i32:
    return Result.Ok(a.len())

fn main() i32:
    let Box b = Box(1)
    println(b.look(make().realise(fallback().realise(from([1])))))
    let i32[] owned = from([7, 8])
    println(plain_look(owned.clone()).realise(-1))
    println(owned.len() - 1)
    return Result.Ok(0)
