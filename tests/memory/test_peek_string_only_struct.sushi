# The post-flip shape of tests/memory/test_copy_string_only_struct.sushi: a struct whose
# only owning content is a string, read through a borrow. The reader takes `&peek`, so
# the caller keeps the struct and can still read its field afterward, and the returned
# field is an explicit clone because the caller still owns the original.
#
# This shape is correct before and after Phase 9. The by-value shape it replaces is the
# COPY tier itself, and stays pinned in the file named above until Phase 9 deletes it.
# EXPECT_STDOUT_EXACT: "in=hi src=hi\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true

struct Named:
    string name
    i32 id

fn show(&peek Named n) string:
    return Result.Ok(n.name.clone())

fn main() i32:
    let Named a = Named(name: "hi", id: 1)
    let string got = show(&peek a).realise("?")
    println("in={got} src={a.name}")
    return Result.Ok(0)
