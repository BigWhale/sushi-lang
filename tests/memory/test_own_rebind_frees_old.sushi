# A rebind of an `Own@(T)` local must free the old allocation. The gate on the local
# rebind arm used to be the struct FIELD walk, which answers "owns nothing" for an
# Own / List / HashMap struct (their fields are raw pointers), so the old allocation
# leaked. The arm now asks the one ownership predicate.
# EXPECT_STDOUT_EXACT: "7\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS
fn run_test() i32:
    let Own@(i32) o = Own.alloc(5)
    o := Own.alloc(7)
    println(o.get())
    return Result.Ok(0)

fn main() i32:
    let i32 code = run_test().realise(1)
    return Result.Ok(code)
