# A borrowed string works as a HashMap key, and a borrowed map as a receiver.
#
# The lookup path is the one a `peek string` parameter idiom hits most: a helper takes
# the map and the key by borrow, and neither is consumed. `m.get(k)` must hash the key
# through the borrow and must not take ownership of either side, so the caller still
# owns the map and frees it.
# EXPECT_STDOUT_EXACT: "a=42 b=7 missing=-1\nstill_here=2\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true

use <collections/hashmap>

fn look(peek HashMap@(string, i32) m, peek string k) i32:
    return Result.Ok(m.get(k).realise(-1))

fn main() i32:
    let HashMap@(string, i32) m = HashMap.new()
    m.insert("a", 42)
    m.insert("b", 7)

    let string ka = "a"
    let string kb = "b"
    let string missing = "zz"

    println("a={look(peek m, peek ka).realise(-99)} b={look(peek m, peek kb).realise(-99)} missing={look(peek m, peek missing).realise(-99)}")
    println("still_here={m.len()}")

    m.free()
    return Result.Ok(0)
