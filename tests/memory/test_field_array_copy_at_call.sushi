# Same defect as test_field_array_copy_at_let.sushi, at the call-argument sink. The
# dispatcher does recognise the MemberAccess source (calls/dispatcher.py:242) but delegates
# to deep_copy_if_owning_struct, which declines to copy a bare DynamicArrayType -- so the
# callee frees the caller's buffer and `w` frees it again. Double free (SIGTRAP, rc=133).
# See BUGS.md entry 1.
# EXPECT_STDOUT_EXACT: "n=3 src=3\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true

struct W:
    i32[] items

fn total(i32[] xs) i32:
    return Result.Ok(xs.len())

fn main() i32:
    let W w = W(from([1, 2, 3]))
    let i32 n = total(w.items).realise(-1)
    println("n={n} src={w.items.len()}")
    return Result.Ok(0)
