# Issue #253 (foreach twin): a foreach binding is the same read-only view as a
# match binding, so a mutating method through it must be a compile error.
# EXPECT_ERROR_CODE: CE2414

struct Row:
    i32[] cells

fn main() i32:
    let List@(Row) rows = List.new()
    rows.push(Row(from([1, 2])))
    foreach(r in rows.iter()):
        r.cells.push(9)
    rows.free()
    return Result.Ok(0)
