# A `foreach` binding over owning elements must be usable by value at least once.
#
# The two halves disagree about what the binding IS. `borrow.py:465` registers it with
# `var_type=stmt.item_type` -- an OWNED local -- while `statements/loops.py:356-363`
# creates it with `register_cleanup=False`, a borrow. On top of that,
# `_check_loop_body` runs a silent discovery pass, so the move recorded for iteration N is
# already installed when the FIRST use is checked.
#
# Result: a single by-value use is rejected with CE2405 whose "moved here" note points at
# the SAME span as the use. This file must COMPILE and run. MM.md S2 row 9; no issue.
# EXPECT_STDOUT_EXACT: "n=3\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true

struct Holder:
    i32[] data

fn take(Holder h) i32:
    return Result.Ok(h.data.len())

fn main() i32:
    let List@(Holder) l = List.new()
    l.push(Holder(from([1, 2, 3])))
    foreach(e in l.iter()):
        println("n={take(e).realise(-1)}")
    return Result.Ok(0)
