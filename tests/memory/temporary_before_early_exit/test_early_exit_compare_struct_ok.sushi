# The control for the ?? exit: the value of a struct comparison operand is a temporary that owns
# a string, and the later sibling operand is Ok. The position frees it once.
# EXPECT_STDOUT_EXACT: "false\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true

fn fails() string | StdError:
    return Result.Err(StdError.Error)

fn ok() string | StdError:
    return Result.Ok("z")

fn mk(i32 a) string:
    return "{a}{a}"

struct Tag:
    string s

fn tag(i32 a) Tag:
    return Tag(mk(a))

fn tag_fails() Tag | StdError:
    return Result.Err(StdError.Error)

fn tag_ok() Tag | StdError:
    return Result.Ok(Tag("z"))

fn c1(i32 a) string | StdError:
    let bool b = tag(a) == tag_ok()??
    let string x = "{b}"
    return Result.Ok(x)

fn main() i32:
    println(c1(7).realise("err"))
    return 0
