# The value of a struct that a nested construction makes is a temporary that owns a string. A later sibling
# operand leaves through ??. The exit frees the temporary once.
# EXPECT_STDOUT_EXACT: "err\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true

fn fails() string | StdError:
    return Result.Err(StdError.Error)

fn ok() string | StdError:
    return Result.Ok("z")

fn mk(i32 a) string:
    return "{a}{a}"

struct Pair:
    string a
    string b

struct Outer:
    Pair p
    string c

fn c1(i32 a) string | StdError:
    let Outer o = Outer(Pair(mk(a), mk(a)), fails()??)
    let string x = "{o.p.a}{o.p.b}{o.c}"
    return Result.Ok(x)

fn main() i32:
    println(c1(7).realise("err"))
    return 0
