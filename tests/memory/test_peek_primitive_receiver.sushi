# A borrowed primitive is a first-class receiver too.
#
# The same defect as `test_peek_string_receiver`, and not string-specific: a borrow is a
# pointer, `try_emit_primitive_method` tested `str(semantic_type)` against a list of
# primitive names, and `&peek i32` is not in that list. So `.hash()` on a borrowed
# primitive matched no built-in, fell through to the user extension-method path, and died
# there as a bare `KeyError: 'Extension method not found: i32_hash'` -- a CE0000 internal
# compiler error for a program that is perfectly legal.
#
# `.hash()` and `.to_str()` are PRIMITIVE methods. They dispatch separately from the
# stdlib string methods, so a fix for one does not cover the other. Both are exercised.
#
# `.to_str()` binds to a local rather than being interpolated directly. Interpolating a
# method result leaks the string it returns, which is a PRE-EXISTING defect and not a
# borrow one -- it leaks identically for an owned receiver.
# EXPECT_STDOUT_EXACT: "hash_equal=1\nstr=42\nsum=45\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true

fn borrowed_hash(&peek i32 x) u64:
    return Result.Ok(x.hash())

fn borrowed_to_str(&peek i32 x) string:
    return Result.Ok(x.to_str())

fn add_borrowed(&peek i32 a, &peek i32 b) i32:
    return Result.Ok(a + b)

fn main() i32:
    let i32 n = 42
    let i32 m = 3

    let string shown = borrowed_to_str(&peek n).realise("?")
    println("hash_equal={borrowed_hash(&peek n).realise(0 as u64) == n.hash()}")
    println("str={shown}")
    println("sum={add_borrowed(&peek n, &peek m).realise(-1)}")
    return Result.Ok(0)
