# `.clone()` of a struct whose field is a capturing closure.
#
# `docs/design/move-semantics.md:174-176` states there is "no CE0052-style exclusion:
# emit_value_clone already handles every shape RAII handles". A capturing-closure field is
# a shape it does not handle -- the heap environment is aliased rather than duplicated, so
# the clone and the original both free it.
# EXPECT_STDOUT_EXACT: "h2=15\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true

struct Handler:
    fn(i32) -> i32 f

fn main() i32:
    let i32 k = 10
    let Handler h = Handler(|i32 x| x + k)
    let Handler h2 = h.clone()
    println("h2={h2.f(5).realise(-1)}")
    return Result.Ok(0)
