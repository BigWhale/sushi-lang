# The control for #256, and a regression pin on WHERE the fix goes.
#
# Reading a field straight off a get-out is not an ownership sink -- nothing
# takes a second owner -- so it has always run clean, and it must stay that
# way. Deep-copying inside `emit_own_get` would fix the other five shapes at a
# stroke and break this one: the copy would belong to no owner and leak.
#
# Unlike array/List/HashMap get-outs (which return Maybe@(T), so `arr.get(0)??.f`
# is not even expressible -- CE0067), Own.get() returns bare T and chains. That
# is why the copy belongs at the sinks, not at the access site.
# EXPECT_STDOUT_EXACT: "value=1\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true

struct Leafy:
    i32 x

struct Holder:
    i32 value
    Maybe@(Own@(Leafy)) next

fn run_test() i32:
    let Leafy l = Leafy(9)
    let Holder h = Holder(1, Maybe.Some(Own.alloc(l)))
    let Own@(Holder) o = Own.alloc(h)
    println("value={o.get().value}")
    return Result.Ok(0)

fn main() i32:
    return Result.Ok(run_test().realise(99))
