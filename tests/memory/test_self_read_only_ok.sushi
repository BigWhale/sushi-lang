# The green half of #326: READING through `self` is unaffected.
#
# Registering `self` in the borrow checker's state is what makes the write rejections
# possible, and it had to leave three shapes alone: a plain field read, a read-only
# method under it, and `.clone()` -- of the receiver itself and of an owning field --
# which is the escape CE2411 names. (A bare `return self` on a `string` receiver was a
# fourth legal shape until the #338 ruling: it handed out a dangling view, so it is
# CE2411 now, and the Display idiom is spelled `return self.clone()`.)
# EXPECT_STDOUT_EXACT: "n: 7\nlen: 3\nsaid: hi-1\ncopy: initial-0\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS
struct Counter:
    i32 n

struct Bag:
    i32[] items

struct Holder:
    string label

extend Counter value() i32:
    return self.n

extend Bag size() i32:
    return self.items.len()

extend string say_it() string:
    return self.clone()

extend Holder copy_label() string:
    return self.label.clone()

fn run_test() i32:
    let Counter c = Counter(7)
    println("n: {c.value()}")

    let Bag b = Bag(from([1, 2, 3]))
    println("len: {b.size()}")

    let string greeting = "hi-{1}"
    println("said: {greeting.say_it()}")

    let Holder h = Holder("initial-{0}")
    println("copy: {h.copy_label()}")
    return Result.Ok(0)

fn main() i32:
    let i32 code = run_test().realise(1)
    return Result.Ok(code)
