# The green half of #326: READING through `self` is unaffected, and so is the one legal
# move of it.
#
# Registering `self` in the borrow checker's state is what makes the write rejections
# possible, and it had to leave four shapes alone: a plain field read, a read-only method
# under it, a bare `return self` on a `string` receiver -- the `extend T with Display`
# idiom the whole corpus uses, which the backend keeps safe by clearing the returned
# string's owned bit -- and `.clone()` of an owning field, which is the escape CE2411 names.
# EXPECT_STDOUT_EXACT: "n: 7\nlen: 3\nsaid: hi-1\ncopy: initial-0\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS
struct Counter:
    i32 n

struct Bag:
    i32[] items

struct Holder:
    string label

extend Counter value() i32:
    return self.n

extend Bag size() i32:
    return self.items.len()

extend string say_it() string:
    return self

extend Holder copy_label() string:
    return self.label.clone()

fn run_test() i32:
    let Counter c = Counter(7)
    println("n: {c.value()}")

    let Bag b = Bag(from([1, 2, 3]))
    println("len: {b.size()}")

    let string greeting = "hi-{1}"
    println("said: {greeting.say_it()}")

    let Holder h = Holder("initial-{0}")
    println("copy: {h.copy_label()}")
    return Result.Ok(0)

fn main() i32:
    let i32 code = run_test().realise(1)
    return Result.Ok(code)
