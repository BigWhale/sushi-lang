# Test error: Own pattern on non-Own field
# EXPECT_ERROR_CODE: CE2109
enum Container:
    Box(i32)
    Empty()

fn test_error(Container c) i32:
    match c:
        Container.Box(Own(value)) ->  # ERROR: i32 is not Own@(T)
            return value
        Container.Empty() ->
            return 0

fn main() i32:
    return 0
