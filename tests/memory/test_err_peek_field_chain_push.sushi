# The receiver is a FIELD of the `&peek` parameter, not the parameter itself. The
# root of the chain decides, so this is the same error.
# EXPECT_ERROR_CODE: CE2408
struct Holder:
    i32[] items

fn grow(&peek Holder h) ~:
    h.items.push(9)
    return Result.Ok(~)

fn run_test() i32:
    let Holder holder = Holder(from([1, 2]))
    grow(&peek holder)
    println(holder.items.len())
    return Result.Ok(0)

fn main() i32:
    let i32 code = run_test().realise(1)
    return Result.Ok(code)
