# The marked enum crosses the boundary, variants and all.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "calm true\n"

use "helpers/moods"

fn name_of(Mood m) string:
    match m:
        Mood.Calm -> return "calm"
        Mood.Cross -> return "cross"

fn main() i32:
    let string n = name_of(Mood.Calm)
    let bool hidden = is_hidden()
    println("{n} {hidden}")
    return 0
