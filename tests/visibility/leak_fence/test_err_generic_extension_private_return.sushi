# CE3009: a PUBLIC extension on a generic target hands its return type out, as the
# perk implementation beside it does. Only the perk half was pinned (#656).
# EXPECT_ERROR_CODE: CE3009

struct Secret:
    i32 code

public struct Box@(T):
    T held

public extend Box@(T) peel() Secret:
    return Secret(1)

fn main() i32:
    let Box@(i32) b = Box(7)
    println("{b.peel().code}")
    return 0
