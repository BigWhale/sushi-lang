# CE3009: an EXTENSION on a generic target is as visible as its target type, the
# same rule the perk implementation beside it reads. One predicate answers for both,
# and only the perk half was pinned (#656).
# EXPECT_ERROR_CODE: CE3009

struct Secret:
    i32 code

public struct Box@(T):
    T held

extend Box@(T) peel() Secret:
    return Secret(1)

fn main() i32:
    let Box@(i32) b = Box(7)
    println("{b.peel().code}")
    return Result.Ok(0)
