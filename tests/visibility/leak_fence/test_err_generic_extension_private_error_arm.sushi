# The ERROR ARM of the same fence, on a public extension of a generic target. The
# `| E` channel hands the enum out exactly as a return type does (#656).
# EXPECT_ERROR_CODE: CE3009

error Fault:
    Bad

public struct Box@(T):
    T held

public extend Box@(T) checked() i32 | Fault:
    return Result.Err(Fault.Bad)

fn main() i32:
    let Box@(i32) b = Box(7)
    println("{b.checked().realise(0)}")
    return 0
