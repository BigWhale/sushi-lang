# CE3009: privacy on a type is worth nothing if a public signature hands the
# type out anyway. Rust answers this with E0446.
# EXPECT_ERROR_CODE: CE3009

struct Point:
    i32 x

public fn origin() Point:
    return Result.Ok(Point(0))

fn main() i32:
    let Point p = origin().realise(Point(1))
    println("{p.x}")
    return Result.Ok(0)
