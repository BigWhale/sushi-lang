# The PARAMETER position of the same fence, on a generic extension target. One
# predicate answers for every position, so each one carries a fixture (#656).
# EXPECT_ERROR_CODE: CE3009

struct Secret:
    i32 code

public struct Box@(T):
    T held

extend Box@(T) weigh(peek Secret s) i32:
    return s.code

fn main() i32:
    let Box@(i32) b = Box(7)
    let Secret s = Secret(3)
    println("{b.weigh(peek s)}")
    return Result.Ok(0)
