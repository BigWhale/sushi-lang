# A slice of a unit variable is a shared borrow of the variable: a `poke` of the same
# variable in one call is CE2407, as for a local array.
# EXPECT_ERROR_CODES_EXACT: CE2407

var i32[] buf = from([])

fn take(peek i32[] a, poke i32[] b) ~:
    b.push(a.len())

fn main() i32:
    take(peek buf[0..2], poke buf)
    return 0
