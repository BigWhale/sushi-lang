# The `var` change lifts nothing for a `const`: a constant still has no address, so
# a `poke` of one is CE2400 exactly as before.
# EXPECT_ERROR_CODE: CE2400

const i32 LIMIT = 10

fn bump(poke i32 n) ~:
    n := n + 1
    return Result.Ok(~)

fn main() i32:
    bump(poke LIMIT)
    return Result.Ok(0)
