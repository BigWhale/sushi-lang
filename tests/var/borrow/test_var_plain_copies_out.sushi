# A PLAIN unit variable copies out freely: a `let`, a return and an argument all take
# a copy, and the variable is untouched. Only an owning type is fenced (CE2436).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "5 5 6\n5\n"
# EXPECT_NO_LEAKS

var i32 counter = 5

fn current() i32:
    return Result.Ok(counter)

fn plus_one(i32 n) i32:
    return Result.Ok(n + 1)

fn main() i32:
    let i32 copy = counter
    let i32 got = current().realise(0)
    let i32 more = plus_one(counter).realise(0)
    copy := copy + 100
    println("{got} {counter} {more}")
    println("{counter}")
    return Result.Ok(0)
