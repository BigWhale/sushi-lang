# Returning an owning unit variable by value would hand its storage to the caller,
# who frees it. Refused, like every other move out of one.
# EXPECT_ERROR_CODE: CE2436

var i32[] table = from([])

fn take() i32[]:
    return table

fn main() i32:
    let i32[] got = take()
    println("{got.len()}")
    return 0
