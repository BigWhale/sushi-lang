# A unit variable of an enum type starts as a constant variant and is rebound at run
# time, from a function, like any other storage.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "plus\nminus\nplus\n"

enum Sign:
    Plus
    Minus

var Sign current = Sign.Plus

fn show() ~:
    match current:
        Sign.Plus -> println("plus")
        Sign.Minus -> println("minus")
    return Result.Ok(~)

fn flip() ~:
    match current:
        Sign.Plus ->
            current := Sign.Minus
        Sign.Minus ->
            current := Sign.Plus
    return Result.Ok(~)

fn main() i32:
    show()
    flip()
    show()
    flip()
    show()
    return Result.Ok(0)
