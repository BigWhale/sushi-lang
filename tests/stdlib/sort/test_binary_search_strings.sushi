# The needle of `.binary_search(v)` is a borrow: an owning needle stays usable.
# EXPECT_STDOUT_EXACT: "1 kiwi1\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
use <collections/sort>

fn main() i32:
    let string[] words = from(["fig{0}", "kiwi{1}", "lime{2}"])
    let string needle = "kiwi{1}"
    let i32 at = words.binary_search(needle).realise(-1)
    println("{at} {needle}")
    return 0
