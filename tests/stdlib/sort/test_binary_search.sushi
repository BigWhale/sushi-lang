# `.binary_search(v)`: a hit, a miss below the first element, a miss above the last
# element, a miss between two elements, and an empty array.
# EXPECT_STDOUT_EXACT: "2\nnone\nnone\nnone\nnone\n0\n4\n"
# EXPECT_RUNTIME_EXIT: 0
use <collections/sort>

fn show(Maybe@(i32) m) ~:
    match m:
        Maybe.Some(i) -> println(i)
        Maybe.None() -> println("none")

fn main() i32:
    let i32[] xs = from([1, 3, 5, 7, 9])
    show(xs.binary_search(5))
    show(xs.binary_search(0))
    show(xs.binary_search(10))
    show(xs.binary_search(4))
    let i32[] empty = from([])
    show(empty.binary_search(1))
    show(xs.binary_search(1))
    show(xs.binary_search(9))
    return 0
