# `.sort()` is stable too: two values that `<` cannot tell apart keep their order.
# A float -0.0 and 0.0 are equal under `<`, and print differently.
# EXPECT_STDOUT_EXACT: "[-1, -0, 0, -0, 2]\n"
# EXPECT_RUNTIME_EXIT: 0
use <collections/sort>

fn main() i32:
    let f64[] xs = from([2.0, -0.0, 0.0, -1.0, -0.0])
    xs.sort()
    println("{xs}")
    return 0
