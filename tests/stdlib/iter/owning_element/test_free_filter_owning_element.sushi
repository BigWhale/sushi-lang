# The free filter keeps an owning element type: each kept string is a clone.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "ab\ncde\n"
use <collections/strings>
use <collections/iter>

fn run() i32:
    let List@(string) xs = List.new()
    xs.push("ab")
    xs.push("x")
    xs.push("cde")
    let List@(string) kept = filter(xs, |string s| s.len() > 1)
    foreach(s in kept.iter()):
        println(s)
    return 0

fn main() i32:
    return run()
