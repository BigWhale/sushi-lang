# The free map reads an owning element type: each string is borrowed by the step.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "2\n3\n"
use <collections/strings>
use <collections/iter>

fn run() i32:
    let List@(string) xs = List.new()
    xs.push("ab")
    xs.push("cde")
    let List@(i32) lens = map(xs, |string s| s.len())??
    foreach(n in lens.iter()):
        println(n)
    return Result.Ok(0)

fn main() i32:
    return Result.Ok(run().realise(1))
