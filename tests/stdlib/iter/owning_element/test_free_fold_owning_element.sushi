# The free fold reads an owning element type: each string is borrowed by the step.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "5\n"
use <collections/strings>
use <collections/iter>

fn run() i32:
    let List@(string) xs = List.new()
    xs.push("ab")
    xs.push("cde")
    let i32 total = fold(xs, 0, |i32 acc, string s| acc + s.len())
    println(total)
    return 0

fn main() i32:
    return run()
