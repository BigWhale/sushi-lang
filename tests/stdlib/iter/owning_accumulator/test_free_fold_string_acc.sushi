# The free fold threads an owning accumulator: the step takes it and gives a new one.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "<123\n"
use <collections/strings>
use <collections/iter>

fn run() i32:
    let List@(i32) ns = List.new()
    ns.push(1)
    ns.push(2)
    ns.push(3)
    let string s = fold(ns, "<", |string acc, i32 x| acc.concat("{x}"))??
    println(s)
    return Result.Ok(0)

fn main() i32:
    return Result.Ok(run().realise(1))
