# The array fold method threads an owning accumulator: the step takes it and gives a new one.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "<123\n"
use <collections/strings>
use <collections/iter>

fn run() i32:
    let i32[] ns = from([1, 2, 3])
    let string s = ns.fold("<", |string acc, i32 x| acc.concat("{x}"))
    println(s)
    return 0

fn main() i32:
    return run()
