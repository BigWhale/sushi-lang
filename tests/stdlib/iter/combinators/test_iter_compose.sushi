# collections/iter: compose(g, f) builds f-after-g. compose(nom inc, nom dbl) applied to 10 is
# dbl(inc(10)) = dbl(11) = 22.
# EXPECT_STDOUT_EXACT: "22\n"
use <collections/iter>

fn inc(i32 x) i32:
    return x + 1

fn dbl(i32 x) i32:
    return x * 2

fn run() i32:
    let fn(i32) -> i32 h = compose(nom inc, nom dbl)
    return h(10)

fn main() i32:
    println(run())
    return 0
