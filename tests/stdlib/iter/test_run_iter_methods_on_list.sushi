# collections/iter, the method form: .map/.filter/.fold on List@(T), each handled
# with '??' at its own call.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "10\n"
use <collections/iter>

fn run() i32:
    let List@(i32) xs = List.new()
    xs.push(1)
    xs.push(2)
    xs.push(3)
    let List@(i32) ds = xs.map(|i32 x| x * 2)??
    let List@(i32) big = ds.filter(|i32 x| x > 2)??
    let i32 total = big.fold(0, |i32 acc, i32 x| acc + x)??
    return Result.Ok(total)

fn main() i32:
    println("{run().realise(-1)}")
    return Result.Ok(0)
