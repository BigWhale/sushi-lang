# is_ascii_digit in the positions a user writes.
# The receiver is a u8 local, a string byte, a byte literal and an array element.
# The call is also an operand of and / not in an if.
# A byte from 128 to 255 is not a digit.
# EXPECT_STDOUT_EXACT: "local=true\nlocal=false\nstring=3\nliteral=true\nliteral=false\nif=yes\nnot=yes\narray=2\nhigh=false\n"

use <text/ascii>
use <collections/strings>

fn main() i32:
    let u8 c = a'5'
    println("local={c.is_ascii_digit()}")
    let u8 d = a'/'
    println("local={d.is_ascii_digit()}")

    let string s = "a1b22:"
    let i32 n = 0
    let i32 i = 0
    while (i < s.size()):
        if (s[i].is_ascii_digit()):
            n := n + 1
        i := i + 1
    println("string={n}")

    println("literal={a'7'.is_ascii_digit()}")
    println("literal={a'x'.is_ascii_digit()}")

    if (c.is_ascii_digit() and a'0'.is_ascii_digit()):
        println("if=yes")
    if (not a':'.is_ascii_digit()):
        println("not=yes")

    let u8[] bytes = from([a'0', a'/', a':', a'9'])
    let i32 m = 0
    foreach(b in bytes.iter()):
        if (b.is_ascii_digit()):
            m := m + 1
    println("array={m}")

    println("high={a'\xe9'.is_ascii_digit()}")
    return 0
