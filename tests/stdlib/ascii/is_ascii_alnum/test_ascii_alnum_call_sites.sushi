# is_ascii_alnum in the positions a user writes.
# EXPECT_STDOUT_EXACT: "true\nfalse\ntrue true false\ntrue\nfalse\nboth\nnot alnum\n3\nfalse\n"

use <text/ascii>
use <collections/strings>

fn main() i32:
    let u8 local = a'5'
    println(local.is_ascii_alnum())
    let u8 under = a'_'
    println(under.is_ascii_alnum())

    let string s = "Z9-"
    print("{s[0].is_ascii_alnum()} ")
    print("{s[1].is_ascii_alnum()} ")
    println(s[2].is_ascii_alnum())

    println(a'q'.is_ascii_alnum())
    println(a'/'.is_ascii_alnum())

    if (a'0'.is_ascii_alnum() and a'z'.is_ascii_alnum()):
        println("both")
    if (not a':'.is_ascii_alnum()):
        println("not alnum")

    let u8[] bytes = from([a'a', a'1', a'B', a'@'])
    let i32 n = 0
    foreach(b in bytes.iter()):
        if (b.is_ascii_alnum()):
            n := n + 1
    println(n)

    println(a'\xe9'.is_ascii_alnum())
    return 0
