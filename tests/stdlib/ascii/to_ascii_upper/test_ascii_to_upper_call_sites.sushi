# to_ascii_upper in the positions a user writes.
# The receivers are a u8 local, a string byte, a byte literal, and an array element.
# A byte from 128 to 255 does not change.
# EXPECT_STDOUT_EXACT: "71\n77 79 83 84 32 52 50\n90\n90\n96\n123\nand-not ok\n65 77 90 48 224\n233\n225\n"

use <text/ascii>
use <collections/strings>

fn main() i32:
    let u8 b = a'g'
    println(b.to_ascii_upper())

    let string s = "MoSt 42"
    let i32 i = 0
    while (i < s.size()):
        if (i > 0):
            print(" ")
        print(s[i].to_ascii_upper())
        i := i + 1
    println("")

    println(a'z'.to_ascii_upper())
    println(a'Z'.to_ascii_upper())
    println(a'`'.to_ascii_upper())
    println(a'{'.to_ascii_upper())

    if (b.to_ascii_upper() == a'G' and not (a'5'.to_ascii_upper() != a'5')):
        println("and-not ok")

    let u8[] bytes = from([a'a', a'm', a'Z', a'0', a'\xe0'])
    let i32 n = 0
    foreach(x in bytes.iter()):
        if (n > 0):
            print(" ")
        print(x.to_ascii_upper())
        n := n + 1
    println("")

    println(a'\xe9'.to_ascii_upper())
    println(a'\xe1'.to_ascii_upper())
    return 0
