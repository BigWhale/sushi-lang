# is_ascii_lower in the positions that a user writes.
# The receivers are a u8 local, a string byte, a byte literal and an array element.
# The call is also an operand of `and` and `not`.
# A byte from 128 to 255 is never a lowercase letter.
# EXPECT_STDOUT_EXACT: "true\nfalse\n0 2 4\ntrue\nfalse\nmixed\n2\nfalse\nfalse\n"
# EXPECT_NO_LEAKS: true
use <text/ascii>
use <collections/strings>

fn main() i32:
    let u8 c = a'm'
    let u8 d = 77
    println(c.is_ascii_lower())
    println(d.is_ascii_lower())

    let string s = "aBcDe"
    let string found = ""
    foreach(i in 0..s.size()):
        if (s[i].is_ascii_lower()):
            if (found == ""):
                found := "{i}"
            else:
                found := "{found} {i}"
    println(found)

    println(a'z'.is_ascii_lower())
    println(a'Z'.is_ascii_lower())

    if (c.is_ascii_lower() and not d.is_ascii_lower()):
        println("mixed")

    let u8[] word = from([a'S', a'u', a'S', a'h', a'I'])
    let i32 lower = 0
    foreach(b in word.iter()):
        if (b.is_ascii_lower()):
            lower := lower + 1
    println(lower)

    println(a'\xe9'.is_ascii_lower())
    println(a'\xff'.is_ascii_lower())
    return 0
