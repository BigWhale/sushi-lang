
# Issue #140: a HashMap can hold a `List@(T)` value -- `insert` MOVES it in, and `free`
# destroys the entry exactly once through the List branch of the recursive destructor.
# Before #140 a List value leaked with no crash, because the generic struct destructor
# freed nothing for it.
# https://github.com/BigWhale/sushi-lang/issues/140
#
# The read is a BORROW since #242, so the get-out is bound and read in place rather than
# passed by value to a helper (that would be CE2411 -- a second owner of the map's entry).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "42\n"
# EXPECT_NO_LEAKS: true

use <collections/hashmap>

fn make_list() List@(i32):
    let List@(i32) xs = List.new()
    xs.push(42)
    xs.push(43)
    return Result.Ok(xs)

fn run() i32:
    let HashMap@(i32, List@(i32)) map = HashMap.new()
    map.insert(5, make_list()??)
    let i32 out = -2
    match map.get(5):
        Maybe.Some(lst) ->
            match lst.get(0):
                Maybe.Some(v) ->
                    out := v
                Maybe.None ->
                    out := -1
        Maybe.None ->
            out := -2
    map.free()
    return Result.Ok(out)

fn main() i32:
    println(run().realise(0))
    return Result.Ok(0)
