
# Issue #140, restated for #242: `HashMap.get()` hands back a BORROW of the stored value.
#
# This file asserted the OPPOSITE until #242. `get` used to deep-copy the value out, so the
# returned List was independent of the stored one; the copy was the compiler inserting one
# the user never asked for, and it is gone. The map keeps the value and still frees it, so a
# get-out may be read but not consumed -- `test_err_consume_read_hashmap_get.sushi` pins the
# rejection, and this file pins that the read itself stays free and leak-clean.
#
# Two gets of the same key see the same stored length, and `free` releases one buffer.
# https://github.com/BigWhale/sushi-lang/issues/140
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "1 1\n"
# EXPECT_NO_LEAKS: true

use <collections/hashmap>

fn make_list() List@(i32):
    let List@(i32) xs = List.new()
    xs.push(7)
    return Result.Ok(xs)

fn run() i32:
    let HashMap@(i32, List@(i32)) map = HashMap.new()
    map.insert(1, make_list()??)   # stored list has length 1

    let i32 first = -1
    match map.get(1):
        Maybe.Some(lst) ->
            first := lst.len()
        Maybe.None ->
            first := -1

    let i32 second = -1
    match map.get(1):
        Maybe.Some(lst) ->
            second := lst.len()
        Maybe.None ->
            second := -1

    println("{first} {second}")
    map.free()
    return Result.Ok(0)

fn main() i32:
    return Result.Ok(run().realise(1))
