# extension has no leading dot; a hidden file's leading dot is not an extension.
# EXPECT_STDOUT_EXACT: "txt\ngz\n\n\n\n"

use <io/path>

fn main() i32:
    println(extension("a/b.txt"))
    println(extension("archive.tar.gz"))
    println(extension(".bashrc"))
    println(extension("no_ext"))
    println(extension("dir.d/plain"))
    return 0
