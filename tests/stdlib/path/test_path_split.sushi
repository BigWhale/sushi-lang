# basename is the part after the last slash; dirname is the rest, trailing
# slashes stripped unless the head is all slashes.
# EXPECT_STDOUT_EXACT: "b.txt\n\nfile\n/a\na\n/\n\n"

use <io/path>

fn main() i32:
    println(basename("/a/b.txt"))
    println(basename("a/"))
    println(basename("file"))
    println(dirname("/a/b.txt"))
    println(dirname("a/b"))
    println(dirname("/"))
    println(dirname("file"))
    return 0
