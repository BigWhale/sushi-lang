# normalize collapses doubled slashes and resolves . and .. lexically.
# EXPECT_STDOUT_EXACT: "a/b\n/a/c\na\n../x\n.\n/\n"
# EXPECT_NO_LEAKS: true

use <io/path>

fn main() i32:
    println(normalize("a//b"))
    println(normalize("/a/./b/../c"))
    println(normalize("./a"))
    println(normalize("../x"))
    println(normalize(""))
    println(normalize("/.."))
    return 0
