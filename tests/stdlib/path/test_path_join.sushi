# join follows the POSIX rule set: an absolute child replaces the base.
# EXPECT_STDOUT_EXACT: "a/b\na/b\n/b\nb\na/\n"

use <io/path>

fn main() i32:
    println(join("a", "b"))
    println(join("a/", "b"))
    println(join("a", "/b"))
    println(join("", "b"))
    println(join("a", ""))
    return 0
