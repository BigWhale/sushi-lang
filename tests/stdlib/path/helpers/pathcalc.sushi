# pathcalc: the io/path differential helper. Each stdin line is
# `op|a|b` (b only for join); the answer prints as one line.

use <io/fs>
use <io/buf>
use <io/path>

fn answer(string op, string a, string b) string:
    if (op == "join"):
        return Result.Ok(join(a, b)??)
    if (op == "basename"):
        return Result.Ok(basename(a)??)
    if (op == "dirname"):
        return Result.Ok(dirname(a)??)
    if (op == "extension"):
        return Result.Ok(extension(a)??)
    if (op == "normalize"):
        return Result.Ok(normalize(a)??)
    return Result.Ok("unknown op: {op}")

fn run() ~ | IoError:
    let BufReader@(File) r = buf_reader(nom stdin.share()??, 8192)??
    foreach(line?? in r.lines()):
        let string[] parts = line.split("|")
        if (parts.len() >= 3):
            let string op = parts.get(0).realise("")
            let string a = parts.get(1).realise("")
            let string b = parts.get(2).realise("")
            println(answer(op, a, b).realise("?"))
    return Result.Ok(~)

fn main() i32:
    match run():
        Result.Ok(_) -> return Result.Ok(0)
        Result.Err(_) -> return Result.Ok(1)
