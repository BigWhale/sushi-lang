# A length is an i64 (ADR 0001, the contract step), and Sushi has no implicit narrowing:
# `let i32 n = map.len()` of a `HashMap@(K, V)` is refused. `as i32` is the escape.
# EXPECT_ERROR_CODES_EXACT: CE2002
use <collections/hashmap>

fn main() i32:
    let HashMap@(i32, i32) map = HashMap.new()
    let i32 c = map.len()
    let i32 ok = map.len() as i32
    println("{c} {ok}")
    map.free()
    return 0
