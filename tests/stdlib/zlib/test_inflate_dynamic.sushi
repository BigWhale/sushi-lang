# inflate_raw over a dynamic-Huffman block (BTYPE=10). Python zlib only chooses
# a dynamic block when the tree pays for itself, so the fixture is the first 256
# bytes of README.md at level 6. This is the case that exercises the code-length
# alphabet and its three repeat codes (16, 17, 18).
# EXPECT_STDOUT_EXACT: "len=256 adler=2333497549\n"
# EXPECT_NO_LEAKS: true

use <compression/zlib>

fn show(u8[] blob) ~:
    match inflate_raw(blob):
        Result.Ok(out) ->
            println("len={out.len()} adler={adler32(out)??}")
        Result.Err(e) ->
            println("err={zlib_error_text(e)??}")
    return Result.Ok(~)

fn run_test() i32:
    let u8[] dyn_readme = from([
        0x25, 0x8e, 0xb1, 0x4e, 0xc4, 0x30, 0x10, 0x44, 0xfb, 0x7c, 0xc5, 0xa0,
        0x6b, 0xb9, 0x5c, 0x8f, 0xa8, 0x68, 0x68, 0x28, 0x90, 0xe0, 0x03, 0xce,
        0x8e, 0x37, 0xf1, 0x82, 0xf1, 0x46, 0xde, 0xb5, 0x22, 0xff, 0xfd, 0x39,
        0x66, 0xda, 0x79, 0x7a, 0x33, 0x17, 0x7c, 0x55, 0x8d, 0x8c, 0x0f, 0x97,
        0xb7, 0x69, 0x7a, 0x7d, 0xba, 0x5e, 0xf1, 0xe6, 0xc2, 0x46, 0x08, 0xce,
        0x1c, 0x58, 0xb1, 0x57, 0x9f, 0x58, 0x23, 0x05, 0xf8, 0x06, 0x8b, 0x84,
        0xbb, 0x3f, 0x7b, 0xbd, 0xe3, 0x47, 0x3c, 0x38, 0x63, 0xde, 0xd8, 0x62,
        0xf5, 0xb7, 0x43, 0xca, 0xef, 0x9a, 0xe4, 0xd0, 0x9b, 0x91, 0xda, 0xdc,
        0xfe, 0xd2, 0x33, 0x8e, 0xc8, 0x4b, 0x9c, 0x70, 0x26, 0x4a, 0x0a, 0x3a,
        0x04, 0xef, 0xac, 0x06, 0x0e, 0x58, 0xa5, 0x80, 0xdc, 0x12, 0x51, 0x68,
        0x17, 0x65, 0x93, 0xd2, 0x66, 0x7c, 0x77, 0xc0, 0x0e, 0x81, 0x56, 0xee,
        0x1a, 0xb8, 0x42, 0xa3, 0x2e, 0xd6, 0x0f, 0x28, 0xed, 0xae, 0x38, 0xa3,
        0xd4, 0x5e, 0x4e, 0xd1, 0xbf, 0x77, 0xd6, 0xf1, 0x7f, 0x91, 0xb2, 0xd7,
        0xce, 0xe7, 0x30, 0x36, 0x3e, 0x9b, 0x45, 0xc9, 0xa8, 0x99, 0x0d, 0xc9,
        0x35, 0x2a, 0xc3, 0x14, 0x78, 0x5d, 0xa9, 0x50, 0xb6, 0xce, 0x70, 0xde,
        0x4e, 0xfc, 0x01
    ])
    show(dyn_readme)??
    return Result.Ok(0)

fn main() i32:
    let i32 r = run_test().realise(99)
    return Result.Ok(r)
