# inflate_raw over fixed-Huffman blocks (BTYPE=01). The cases cover an empty
# block, a single literal, short text, a repeat that exercises back-references,
# a 300-byte run at the maximum match length, prose with many matches, and
# incompressible bytes that stay literals. Python zlib produces a fixed block
# for every one of these at level 6.
# EXPECT_STDOUT_EXACT: "len=0 adler=1\nlen=1 adler=4325442\nlen=15 adler=777324008\nlen=30 adler=2987133821\nlen=300 adler=3634917805\nlen=360 adler=801145401\nlen=16 adler=1142556758\n"
# EXPECT_NO_LEAKS: true

use <compression/zlib>

fn show(u8[] blob) ~:
    match inflate_raw(blob):
        Result.Ok(out) ->
            println("len={out.len()} adler={adler32(out)??}")
        Result.Err(e) ->
            println("err={zlib_error_text(e)??}")
    return Result.Ok(~)

fn run_test() i32:
    let u8[] fx_empty = from([0x03, 0x00])
    show(fx_empty)??

    let u8[] fx_one = from([0x73, 0x04, 0x00])
    show(fx_one)??

    let u8[] fx_text = from([
        0xf3, 0xcd, 0x2f, 0x2e, 0xc9, 0xa9, 0x54, 0xf0, 0x48, 0x2c, 0xca, 0xcd,
        0x49, 0x2d, 0x2e, 0x06, 0x00
    ])
    show(fx_text)??

    let u8[] fx_abc = from([0x4b, 0x4c, 0x4a, 0x4e, 0xc4, 0x8d, 0x00])
    show(fx_abc)??

    let u8[] fx_run = from([0x4b, 0x4c, 0x1c, 0x05, 0xc4, 0x02, 0x00])
    show(fx_run)??

    let u8[] fx_prose = from([
        0x2b, 0xc9, 0x48, 0x55, 0x28, 0x2c, 0xcd, 0x4c, 0xce, 0x56, 0x48, 0x2a,
        0xca, 0x2f, 0xcf, 0x53, 0x48, 0xcb, 0xaf, 0x50, 0xc8, 0x2a, 0xcd, 0x2d,
        0x28, 0x56, 0xc8, 0x2f, 0x4b, 0x2d, 0x52, 0x28, 0x01, 0x4a, 0xe7, 0x24,
        0x56, 0x55, 0x2a, 0xa4, 0xe4, 0xa7, 0xeb, 0x81, 0x79, 0xa3, 0x8a, 0xc9,
        0x52, 0x0c, 0x00
    ])
    show(fx_prose)??

    let u8[] fx_rand = from([
        0x9b, 0x67, 0x5e, 0xb9, 0xb3, 0xde, 0xab, 0x46, 0xf4, 0xf3, 0x9c, 0x03,
        0x09, 0x31, 0x6f, 0x4f, 0x98, 0x00, 0x00
    ])
    show(fx_rand)??
    return Result.Ok(0)

fn main() i32:
    let i32 r = run_test().realise(99)
    return Result.Ok(r)
