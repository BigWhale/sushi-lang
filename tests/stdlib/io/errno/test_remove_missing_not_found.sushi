# remove on a missing path reports NotFound (regression guard for the retrofit).
# EXPECT_STDOUT_EXACT: "not found\n"

use <io/files>
use <io/fs>

fn main() i32:
    match remove("/tmp/sushi_errno_missing_file.txt"):
        Result.Ok(_) ->
            println("removed")
        Result.Err(e) ->
            match e:
                FileError.NotFound -> println("not found")
                _ -> println("other")
    return Result.Ok(0)
