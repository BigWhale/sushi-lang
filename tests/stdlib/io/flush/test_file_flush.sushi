# flush() pushes buffered bytes to the file before close().
# EXPECT_STDOUT_EXACT: "size after flush: 5\ncleanup ok\n"
# EXPECT_NO_LEAKS: true

use <io/files>
use <io/fs>

fn main() i32:
    let string path = "/tmp/sushi_flush_test.txt"
    match open(path, FileMode.Write()):
        Result.Ok(poke f) ->
            f.write("hello")
            f.flush()
            match file_size(path):
                Result.Ok(n) -> println("size after flush: {n}")
                Result.Err(_) -> println("no size")
            f.close()
        Result.Err(_) ->
            println("open failed")
            return Result.Ok(1)
    match remove(path):
        Result.Ok(_) -> println("cleanup ok")
        Result.Err(_) -> println("cleanup failed")
    return Result.Ok(0)
