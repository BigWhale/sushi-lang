# into_parts() takes the reader whole, as into_inner() does, so a later mention
# of the reader is refused.
# EXPECT_ERROR_CODE: CE2435
use <io/fs>
use <io/buf>

fn run(string path) ~ | IoError:
    let File f = open(path, FileMode.Read())??
    let BufReader@(File) r = BufReader.new(nom f, 64)
    let (File back, _) = r.into_parts()
    println(r.read_line()??.realise(""))
    back.close()??
    return Result.Ok(~)

fn main() i32:
    match run("/tmp/sushi_buf_parts_spent.txt"):
        Result.Ok(_) -> println("ok")
        Result.Err(_) -> println("failed")
    return 0
