# read_dir on a missing path reports NotFound.
# EXPECT_STDOUT_EXACT: "not found\n"
# EXPECT_NO_LEAKS: true

use <io/files>

fn main() i32:
    match read_dir("/tmp/sushi_read_dir_missing"):
        Result.Ok(_) ->
            println("listed a missing directory")
        Result.Err(e) ->
            match e:
                FileError.NotFound -> println("not found")
                _ -> println("other")
    return Result.Ok(0)
