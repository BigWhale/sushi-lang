# `copy` gives the destination the permission bits of the source, and the umask does not
# remove bits: a source of 0o777 gives a destination of 0o777.
# EXPECT_STDOUT_EXACT: "true\ntrue\ntrue\n"
# EXPECT_NO_OPEN_FDS
use <io/files>

unsafe external "C" as libc because "to set the mode of the source file":
    fn chmod(string path, i32 mode) i32 = "chmod"

fn copied_mode(i32 bits) i32:
    let string src = "/tmp/sushi_copy_mode_src.txt"
    let string dst = "/tmp/sushi_copy_mode_dst.txt"
    let i32 fd = fd_open(src, 1, 420).realise(-1)
    fd_write(fd, from([1, 2, 3])).realise(0 as i64)
    fd_close(fd).realise(-1)
    libc.chmod(src, bits)
    copy(src, dst).realise(-1)
    let i32 got = mode(dst).realise(0) & 0o777
    remove(src).realise(-1)
    remove(dst).realise(-1)
    return got

fn main() i32:
    println(copied_mode(0o600) == 0o600)
    println(copied_mode(0o755) == 0o755)
    println(copied_mode(0o777) == 0o777)
    return 0
