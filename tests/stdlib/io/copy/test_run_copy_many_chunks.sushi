# `copy` copies a file of more than one chunk, with a last chunk that is not full, and
# gives the count 0.
# EXPECT_STDOUT_EXACT: "0\n10007\ntrue\n"
# EXPECT_NO_OPEN_FDS
# EXPECT_NO_LEAKS
use <io/files>

fn same(u8[] a, u8[] b) bool:
    if (a.len() != b.len()):
        return false
    let i64 i = 0
    while (i < a.len()):
        if (a[i] != b[i]):
            return false
        i := i + 1
    return true

fn main() i32:
    let string src = "/tmp/sushi_copy_chunks_src.bin"
    let string dst = "/tmp/sushi_copy_chunks_dst.bin"
    let u8[] data = from([])
    let i32 i = 0
    while (i < 10007):
        data.push((i % 251) as u8)
        i := i + 1
    let i32 out = fd_open(src, 1, 420).realise(-1)
    fd_write(out, data).realise(0 as i64)
    fd_close(out).realise(-1)
    println(copy(src, dst).realise(-1))
    let i32 back = fd_open(dst, 0, 420).realise(-1)
    let u8[] got = fd_read(back, 20000 as i64).realise(from([]))
    let u8[] rest = fd_read(back, 20000 as i64).realise(from([]))
    while (rest.len() > 0):
        got.extend(rest)
        rest := fd_read(back, 20000 as i64).realise(from([]))
    fd_close(back).realise(-1)
    println(got.len())
    println(same(got, data))
    remove(src).realise(-1)
    remove(dst).realise(-1)
    return 0
