# `copy` opens an existing destination with O_TRUNC, and then gives it the permission bits
# of the source.
# EXPECT_STDOUT_EXACT: "true\n3\n"
# EXPECT_NO_OPEN_FDS
use <io/files>

unsafe external "C" as libc because "to set the mode of the two files":
    fn chmod(string path, i32 mode) i32 = "chmod"

fn make(string path, u8[] data, i32 bits) i32:
    let i32 fd = fd_open(path, 1, 420).realise(-1)
    fd_write(fd, data).realise(0 as i64)
    fd_close(fd).realise(-1)
    return libc.chmod(path, bits)

fn main() i32:
    let string src = "/tmp/sushi_copy_existing_src.txt"
    let string dst = "/tmp/sushi_copy_existing_dst.txt"
    make(src, from([1, 2, 3]), 0o755)
    make(dst, from([9, 9, 9, 9, 9, 9, 9, 9]), 0o600)
    copy(src, dst).realise(-1)
    println((mode(dst).realise(0) & 0o777) == 0o755)
    println(file_size(dst).realise(0 as i64))
    remove(src).realise(-1)
    remove(dst).realise(-1)
    return 0
