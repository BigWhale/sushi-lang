# read_at() takes the offset as an ARGUMENT, so the descriptor's own position does not
# move: a read at 7 and then a read at 0 answer the bytes at 7 and at 0, and a sequential
# read afterwards still starts at the beginning.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_NO_OPEN_FDS: true
# EXPECT_STDOUT_EXACT: "at 7: Harmless\nat 0: Mostly\nposition 0\nMostly Harmless\n"
use <io/files>
use <io/fs>

fn probe(string path) ~ | IoError:
    let File f = open(path, FileMode.Read())??
    let u8[] tail = f.read_at(7 as i64, 8)??
    println("at 7: {tail.to_string()}")
    let u8[] head = f.read_at(0 as i64, 6)??
    println("at 0: {head.to_string()}")
    let i64 at = f.tell()??
    println("position {at}")
    let string all = f.read_all()??
    println("{all}")
    return Result.Ok(~)

fn main() i32:
    match open("read_at_probe.txt", FileMode.Write()):
        Result.Ok(w) -> w.write("Mostly Harmless")
        Result.Err(_) ->
            println("open failed")
            return Result.Ok(1)

    match probe("read_at_probe.txt"):
        Result.Ok(_) -> ~
        Result.Err(_) -> println("probe failed")

    remove("read_at_probe.txt").realise(0)
    return Result.Ok(0)
