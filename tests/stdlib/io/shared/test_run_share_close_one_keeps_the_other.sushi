# A share() receiver is a plain borrow and its answer is a second OWNER: closing the copy
# spends only the copy, and closing the original spends only the original. Either way the
# handle left standing still reads, because each one holds its own descriptor.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_NO_OPEN_FDS: true
# EXPECT_STDOUT_EXACT: "copy closed, original reads: Mostly Harmless\noriginal closed, copy reads: Mostly Harmless\n"
use <io/files>
use <io/fs>
use <io/contracts>

fn close_the_copy(string path) string | IoError:
    let File f = open(path, FileMode.Read())??
    let File twin = f.share()??
    twin.close()??
    return Result.Ok(f.read_all()??)

fn close_the_original(string path) string | IoError:
    let File f = open(path, FileMode.Read())??
    let File twin = f.share()??
    f.close()??
    return Result.Ok(twin.read_all()??)

fn main() i32:
    match open("share_close_probe.txt", FileMode.Write()):
        Result.Ok(nom w) -> w.write("Mostly Harmless")
        Result.Err(_) ->
            println("open failed")
            return Result.Ok(1)

    let string a = close_the_copy("share_close_probe.txt").realise("failed")
    println("copy closed, original reads: {a}")
    let string b = close_the_original("share_close_probe.txt").realise("failed")
    println("original closed, copy reads: {b}")

    remove("share_close_probe.txt").realise(0)
    return Result.Ok(0)
