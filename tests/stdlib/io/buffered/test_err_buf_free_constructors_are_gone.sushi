# buf_reader and buf_writer are deleted, not aliased: BufReader.new and BufWriter.new
# are the only spellings (#571).
# EXPECT_ERROR_CODE: CE2008
use <io/fs>
use <io/buf>
use <io/contracts>

fn work() ~ | IoError:
    let File f = open("gone.txt", FileMode.Read())??
    let BufReader@(File) r = buf_reader(nom f, 64)??
    let File g = open("gone-too.txt", FileMode.Write())??
    let BufWriter@(File) w = buf_writer(nom g, 64)??
    return Result.Ok(~)

fn main() i32:
    return Result.Ok(0)
