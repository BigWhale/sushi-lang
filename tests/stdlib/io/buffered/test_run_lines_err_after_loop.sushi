# The loop runs to its end and the function fails AFTER it, so the iterator is already
# destroyed by the time the error path runs. Nothing may be freed twice.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_NO_OPEN_FDS: true
# EXPECT_STDOUT_EXACT: "[alpha]\n[beta]\nrefused\n"
use <io/fs>
use <io/buf>
use <io/contracts>

fn setup(string path) ~ | IoError:
    let File w = open(path, FileMode.Write())??
    w.write("alpha\nbeta\n")??
    w.close()??
    return Result.Ok(~)

fn run(string path) ~ | IoError:
    setup(path)??
    let File f = open(path, FileMode.Read())??
    let BufReader@(File) r = BufReader.new(nom f, 8)??
    foreach(line?? in r.lines()):
        println("[{line}]")
    return Result.Err(IoError.Closed)

fn main() i32:
    match run("/tmp/sushi_lines_after.txt"):
        Result.Ok(_) -> println("ok")
        Result.Err(_) -> println("refused")
    return Result.Ok(0)
