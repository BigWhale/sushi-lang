# The point of the generic: one copy of the buffering code per handle type. This names all
# four instantiations -- BufReader and BufWriter over File and over TcpStream -- so a
# monomorphization that only worked for File would not compile. No socket is opened; the
# instantiation is what is under test.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_NO_OPEN_FDS: true
# EXPECT_STDOUT_EXACT: "Mostly Harmless\n"
use <io/fs>
use <io/buf>
use <net/tcp>

fn over_file(string path) ~ | IoError:
    let File f = open(path, FileMode.Read())??
    let BufReader@(File) r = buf_reader(nom f, 64)??
    println(r.read_line()??.realise(""))
    let File rb = r.into_inner()
    rb.close()??
    let File wf = open(path, FileMode.Write())??
    let BufWriter@(File) w = buf_writer(nom wf, 64)??
    w.write_line("x")??
    w.finish()??
    return Result.Ok(~)

fn over_socket(string host) ~ | IoError:
    match connect(host, 9):
        Result.Ok(nom s) ->
            let BufReader@(TcpStream) r = buf_reader(nom s, 64)??
            println(r.read_line()??.realise(""))
            let TcpStream sb = r.into_inner()
            match sb.close():
                Result.Ok(_) -> println("closed")
                Result.Err(_) -> println("close failed")
        Result.Err(_) ->
            println("no socket")
    match connect(host, 9):
        Result.Ok(nom s2) ->
            let BufWriter@(TcpStream) w = buf_writer(nom s2, 64)??
            w.write_line("y")??
            w.finish()??
        Result.Err(_) ->
            println("no socket")
    return Result.Ok(~)

fn main() i32:
    println("Mostly Harmless")
    return Result.Ok(0)
