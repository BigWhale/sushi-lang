# The price of a `poke self` contract: a write through an UNMARKED `File` parameter is a
# write through a borrow (CE2422). Declare it `poke File out`, and pass `poke stdout`.
# EXPECT_ERROR_CODE: CE2422

use <io/fs>

fn banner(File out) ~ | IoError:
    out.write("Mostly Harmless\n")??
    return Result.Ok(~)

fn main() i32:
    match banner(stdout):
        Result.Ok(_) -> return Result.Ok(0)
        Result.Err(_) -> return Result.Ok(1)
