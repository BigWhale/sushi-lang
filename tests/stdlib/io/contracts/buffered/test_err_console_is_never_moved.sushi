# A console handle is storage the program keeps: handing it to a `nom` parameter is
# refused (CE2436). `stdout.share()` or a fresh `File(fd: STDOUT_FD, owned: false)` gives
# a buffered writer its own handle instead.
# EXPECT_ERROR_CODE: CE2436

use <io/fs>
use <io/buf>
use <io/contracts>

fn run() ~ | IoError:
    let BufWriter@(File) w = BufWriter.new(nom stdout, 64)??
    w.finish()??
    return Result.Ok(~)

fn main() i32:
    match run():
        Result.Ok(_) -> return Result.Ok(0)
        Result.Err(_) -> return Result.Ok(1)
