# A TcpStream satisfies Reader and Writer, so the same generic serves a socket and a file.
# Connect before accept: a listening socket completes the connection itself, so accept()
# answers at once and this needs no second process.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_OPEN_FDS: true
# EXPECT_STDOUT_EXACT: "sent through the contract\nserver read: Mostly Harmless\n"
use <net/tcp>
use <io/contracts>

fn emit@(W: Writer)(poke W dst, string line) ~ | IoError:
    dst.write(line)??
    dst.flush()??
    return Result.Ok(~)

fn first_text@(R: Reader)(poke R src) string | IoError:
    return Result.Ok(src.read(64)??)

fn main() i32:
    let TcpListener server = tcp_listen("127.0.0.1", 0, 1).realise(TcpListener(-1))
    let i32 port = server.local_port().realise(0)
    if (port == 0):
        println("no port")
        return Result.Ok(1)

    match tcp_connect("127.0.0.1", port):
        Result.Ok(nom client) ->
            match emit(poke client, "Mostly Harmless"):
                Result.Ok(_) -> println("sent through the contract")
                Result.Err(_) -> println("send failed")
            match server.accept():
                Result.Ok(nom session) ->
                    let string got = first_text(poke session).realise("")
                    println("server read: {got}")
                Result.Err(_) -> println("accept failed")
        Result.Err(_) -> println("connect failed")

    return Result.Ok(0)
