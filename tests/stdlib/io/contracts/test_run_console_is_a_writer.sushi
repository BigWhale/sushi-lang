# stdout is a File CONSTANT, so it satisfies Writer like any other handle. This is the
# reason R6 refused to leave the console a builtin: a builtin could never enter a generic,
# so BufWriter over the terminal would have been impossible on day one.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "Mostly Harmless\n"
use <io/fs>
use <io/contracts>

fn emit@(W: Writer)(W dst, string line) ~ | IoError:
    dst.write(line)??
    dst.write("\n")??
    dst.flush()??
    return Result.Ok(~)

fn main() i32:
    match emit(stdout, "Mostly Harmless"):
        Result.Ok(_) -> ~
        Result.Err(_) -> return Result.Ok(1)
    return Result.Ok(0)
