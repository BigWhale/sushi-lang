# readln() moves the file position, as readch(), writeln() and tell() do, so it takes a
# poke receiver like them. A read-only File cannot call it.
# EXPECT_ERROR_CODE: CE2422
use <io/fs>

fn first_line(File f) string:
    match f.readln():
        Result.Ok(Maybe.Some(nom line)) -> return line
        Result.Ok(Maybe.None()) -> return ""
        Result.Err(_) -> return ""

fn main() i32:
    return 0
