# A program that writes no tuple type and no tuple literal still calls
# `split_once`: the row's `(string, string)` is interned from the row itself.
# EXPECT_STDOUT_EXACT: "some\nnone\nsome x\n"
# EXPECT_NO_LEAKS
# EXPECT_RUNTIME_EXIT: 0
use <collections/strings>

fn main() i32:
    if ("a=b".split_once("=").is_some()):
        println("some")
    match "ab".rsplit_once("="):
        Maybe.Some(_) -> println("some")
        Maybe.None -> println("none")
    match "x:y".rsplit_once(":"):
        Maybe.Some(parts) -> println("some {parts.0}")
        Maybe.None -> println("none")
    return 0
