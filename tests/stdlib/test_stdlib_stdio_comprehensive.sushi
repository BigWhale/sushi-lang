# TEST_TYPE: runtime
# STDIN_INPUT: "Testing!\n"
# EXPECT_STDOUT_EXACT: "Test 1: Basic write\nTest 2: Write bytes: Hello\nTest 3: Enter a line (or skip with empty): You entered: Testing!\n"
# EXPECT_STDERR_CONTAINS: "stderr: This is an error message"
# EXPECT_RUNTIME_EXIT: 0

use <io/fs>
use <collections/strings>

# Reads one line and substitutes an empty string for the end of the file. readln()
# answers Maybe@(string) now, so a caller that does not care which of the two it got
# says so once, here, rather than losing the distinction at every call.
extend File line_or_empty() string:
    match self.readln():
        Result.Ok(Maybe.Some(line)) -> return line.clone()
        Result.Ok(Maybe.None) -> return ""
        Result.Err(_) -> return ""

fn main() i32:
    # Test 1: Basic write operations
    stdout.write("Test 1: Basic write\n")
    stderr.write("stderr: This is an error message\n")

    # Test 2: Write bytes
    let u8[] bytes = from([72, 101, 108, 108, 111])  # "Hello" in ASCII
    stdout.write("Test 2: Write bytes: ")
    stdout.write_bytes(bytes)
    stdout.write("\n")

    # Test 3: Read and write
    stdout.write("Test 3: Enter a line (or skip with empty): ")
    let string line = stdin.line_or_empty()
    if (line.len() > 0):
        stdout.write("You entered: ")
        stdout.write(line)
        stdout.write("\n")
    else:
        stdout.write("(empty line)\n")

    return Result.Ok(0)
