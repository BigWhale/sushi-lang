# remove_all on a path it cannot check (a name longer than the file system takes, so
# lstat fails with ENAMETOOLONG) answers Err: only a missing path is success. The
# condition holds for root too, where a mode-000 parent does not stop a read. A
# missing path is still Ok. The fixture works in its own directory.
# EXPECT_STDOUT_EXACT: "made\ntoo long: Err\nmissing: Ok\ncleaned: true\n"
# EXPECT_NO_LEAKS: true

use <io/files>
use <io/fs>
use <collections/strings>

unsafe external "C" as posix because "the test names its directory by the process id":
    fn getpid() i32 = "getpid"

fn main() i32:
    let i32 pid = posix.getpid()
    let string root = "/tmp/sushi_fs_remove_all_unreadable_{pid}"
    match mkdir_all(root, 0o755):
        Result.Ok(_) -> println("made")
        Result.Err(_) ->
            println("mkdir_all failed")
            return Result.Ok(1)

    let string name = "a".repeat(300)
    match remove_all("{root}/{name}"):
        Result.Ok(_) -> println("too long: Ok")
        Result.Err(_) -> println("too long: Err")

    match remove_all("{root}/missing"):
        Result.Ok(_) -> println("missing: Ok")
        Result.Err(_) -> println("missing: Err")

    match remove_all(root):
        Result.Ok(_) ->
            let bool cleaned = not exists(root)
            println("cleaned: {cleaned}")
        Result.Err(_) -> println("cleanup failed")
    return Result.Ok(0)
