# read_library reads a whole library that the compiler built: the manifest has the
# shape of a manifest, and the length of the source section comes back.
# RUN_IN_FIXTURE_DIR
# BUILD_LIB_AT: demo.sushi -> demo.slib
# EXPECT_STDOUT_EXACT: "demo true\n"
# EXPECT_NO_LEAKS: true

use <encoding/msgpack>
use <toolchain/slib>

fn main() i32:
    match read_library("demo.slib"):
        Result.Ok(library) ->
            let string name = map_get_str(library.metadata, "library_name").realise("?")
            println("{name} {library.sizes.source > 0}")
        Result.Err(_) ->
            println("a fault")
    return 0
