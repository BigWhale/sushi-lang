# Each reader checks the magic first, and compares each declared length with the size
# of the file before it reads. A short file with a bad magic is BadMagic, not
# Truncated. A file cut inside its bitcode is Truncated for read_library, which
# compares every length; read_metadata reads only what the header declares, and sizes
# reads the bitcode length without comparing it. A
# metadata length past the end of the file is Truncated, and nothing reads that many
# bytes. The fixture removes its directory.
# EXPECT_STDOUT_EXACT: "short: BadMagic BadMagic BadMagic\ncut: Ok Ok Truncated(Bitcode, 100, 10)\nlong: Truncated Truncated Truncated(Metadata, 1099511627776, 45)\n"
# EXPECT_NO_LEAKS: true
# EXPECT_NO_OPEN_FDS: true

use <io/fs>
use <collections/strings>
use <toolchain/slib>

const string ROOT = "/tmp/sushi_slib_truncated_and_bad_magic"

fn push_le(poke u8[] out, u64 value, i32 count) ~:
    foreach(i in 0..count):
        out.push(((value >> ((8 * i) as u64)) & 0xff) as u8)

fn image(u64 meta_len, u64 bitcode_len) u8[]:
    let u8[] meta = from([0x81])
    meta.push(0xac)
    meta.extend("library_name".to_bytes())
    meta.push(0xa4)
    meta.extend("demo".to_bytes())
    let u8[] out = from([0xf0, 0x9f, 0x8d, 0xa3, 0x53, 0x55, 0x53, 0x48, 0x49, 0x4c, 0x49, 0x42, 0xf0, 0x9f, 0x8d, 0xa3])
    push_le(poke out, 5, 4)
    push_le(poke out, 0, 8)
    push_le(poke out, 0, 8)
    push_le(poke out, 0, 8)
    push_le(poke out, meta_len, 8)
    out.extend(meta)
    push_le(poke out, 0, 8)
    push_le(poke out, bitcode_len, 8)
    push_le(poke out, 0, 8)
    push_le(poke out, 0, 2)
    return out

fn write_file(string path, peek u8[] bytes) bool:
    match open(path, FileMode.WriteB()):
        Result.Ok(nom out) ->
            out.write_bytes(bytes)
            out.close()
            return true
        Result.Err(_) ->
            return false

fn plain(SlibError e) string:
    match e:
        SlibError.BadMagic() -> return "BadMagic"
        SlibError.Truncated(_, _, _) -> return "Truncated"
        _ -> return "another SlibError"

fn section(SlibSection s) string:
    match s:
        SlibSection.Metadata() -> return "Metadata"
        SlibSection.Source() -> return "Source"
        SlibSection.Bitcode() -> return "Bitcode"

fn fault(SlibError e) string:
    match e:
        SlibError.BadMagic() -> return "BadMagic"
        SlibError.Truncated(s, expected, actual) ->
            return "Truncated({section(s)}, {expected}, {actual})"
        _ -> return "another SlibError"

fn check(string name) ~:
    let string path = "{ROOT}/{name}.slib"
    let string a = "Ok"
    match read_metadata(path):
        Result.Ok(_) -> a := "Ok"
        Result.Err(e) -> a := plain(e)
    let string b = "Ok"
    match sizes(path):
        Result.Ok(_) -> b := "Ok"
        Result.Err(e) -> b := plain(e)
    let string c = "Ok"
    match read_library(path):
        Result.Ok(_) -> c := "Ok"
        Result.Err(e) -> c := fault(e)
    println("{name}: {a} {b} {c}")

fn run_test() i32:
    if (mkdir_all(ROOT, 0o755).is_err()):
        return 1
    let u8[] short = "hello!".to_bytes()
    write_file("{ROOT}/short.slib", peek short)
    let u8[] cut = image(19, 100)
    write_file("{ROOT}/cut.slib", peek cut)
    let u8[] long = image(1099511627776, 0)
    write_file("{ROOT}/long.slib", peek long)
    check("short")
    check("cut")
    check("long")
    remove_all(ROOT)
    return 0

fn main() i32:
    remove_all(ROOT)
    return run_test()
