# toolchain/slib reads the metadata map back from a well-formed v3 .slib file.
# The test writes its own fixture: a 52-byte header and a one-key msgpack map.
# EXPECT_STDOUT_EXACT: "{"library_name":"demo"}\n"
# EXPECT_NO_LEAKS: true

use <io/files>
use <encoding/msgpack>
use <toolchain/slib>

fn fixture_header(u8 version, u8 mlen) u8[]:
    let u8[] h = from([0xf0, 0x9f, 0x8d, 0xa3, 0x53, 0x55, 0x53, 0x48, 0x49, 0x4c, 0x49, 0x42, 0xf0, 0x9f, 0x8d, 0xa3])
    h.push(version)
    let i32 i = 0
    while (i < 27):
        h.push(0)
        i := i + 1
    h.push(mlen)
    let i32 j = 0
    while (j < 7):
        h.push(0)
        j := j + 1
    return Result.Ok(h)

fn valid_fixture() u8[]:
    let u8[] b = fixture_header(3, 19)??
    b.push(0x81)
    b.push(0xac)
    b.push(0x6c)
    b.push(0x69)
    b.push(0x62)
    b.push(0x72)
    b.push(0x61)
    b.push(0x72)
    b.push(0x79)
    b.push(0x5f)
    b.push(0x6e)
    b.push(0x61)
    b.push(0x6d)
    b.push(0x65)
    b.push(0xa4)
    b.push(0x64)
    b.push(0x65)
    b.push(0x6d)
    b.push(0x6f)
    return Result.Ok(b)

fn write_fixture(string path, u8[] bytes) i32:
    match open(path, FileMode.WriteB()):
        FileResult.Ok(out) ->
            out.write_bytes(bytes)
            out.close()
            return Result.Ok(0)
        FileResult.Err(_) ->
            return Result.Ok(1)
    return Result.Ok(1)

fn run_test() i32:
    let u8[] fixture = valid_fixture()??
    if (write_fixture("test_slib_valid.slib", fixture)?? != 0):
        println("cannot write fixture")
        return Result.Ok(1)
    match slib_read_metadata("test_slib_valid.slib"):
        Result.Ok(meta) ->
            println(mp_show(meta)??)
        Result.Err(_) ->
            println("read failed")
    return Result.Ok(0)

fn main() i32:
    let i32 r = run_test().realise(99)
    return Result.Ok(r)
