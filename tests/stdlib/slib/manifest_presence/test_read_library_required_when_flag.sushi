# A variant record must hold data_types when its has_data field is true, and can leave
# it out when has_data is false. read_library gives the path of the missing field, as
# the Python reader does. Each file is a whole container with empty payload sections.
# The fixture removes its directory.
# EXPECT_STDOUT_EXACT: "Invalid(missing required field 'enums[0].variants[0].data_types')\nOk\n"
# EXPECT_NO_LEAKS: true
# EXPECT_NO_OPEN_FDS: true

use <io/fs>
use <collections/strings>
use <toolchain/slib>

const string ROOT = "/tmp/sushi_read_library_required_when_flag"

fn push_le(poke u8[] out, u64 value, i32 count) ~:
    foreach(i in 0..count):
        out.push(((value >> ((8 * i) as u64)) & 0xff) as u8)

fn push_str(poke u8[] out, string s) ~:
    out.push(0xa0 | (s.size() as u8))
    out.extend(s.to_bytes())

fn manifest(u8 has_data) u8[]:
    let u8[] out = from([0x87])
    push_str(poke out, "library_name")
    push_str(poke out, "demo")
    push_str(poke out, "library_version")
    push_str(poke out, "1.0.0")
    push_str(poke out, "platform")
    push_str(poke out, "darwin")
    push_str(poke out, "compiler_version")
    push_str(poke out, "0.13.0")
    push_str(poke out, "compiled_at")
    push_str(poke out, "now")
    push_str(poke out, "sushi_lib_version")
    push_str(poke out, "1")
    push_str(poke out, "enums")
    out.push(0x91)
    out.push(0x82)
    push_str(poke out, "name")
    push_str(poke out, "Shape")
    push_str(poke out, "variants")
    out.push(0x91)
    out.push(0x82)
    push_str(poke out, "name")
    push_str(poke out, "Circle")
    push_str(poke out, "has_data")
    out.push(has_data)
    return out

fn image(peek u8[] meta) u8[]:
    let u8[] out = from([0xf0, 0x9f, 0x8d, 0xa3, 0x53, 0x55, 0x53, 0x48, 0x49, 0x4c, 0x49, 0x42, 0xf0, 0x9f, 0x8d, 0xa3])
    push_le(poke out, 4, 4)
    push_le(poke out, 0, 24)
    push_le(poke out, meta.len() as u64, 8)
    out.extend(meta)
    push_le(poke out, 0, 16)
    return out

fn write_image(string path, peek u8[] meta) bool:
    match open(path, FileMode.WriteB()):
        Result.Ok(nom out) ->
            out.write_bytes(image(peek meta))
            out.close()
            return true
        Result.Err(_) ->
            return false

fn check(string path) ~:
    match read_library(path):
        Result.Ok(_) -> println("Ok")
        Result.Err(SlibError.Invalid(reason)) -> println("Invalid({reason})")
        Result.Err(_) -> println("another SlibError")

fn run_test() i32:
    if (mkdir_all(ROOT, 0o755).is_err()):
        return 1
    let u8[] flagged = manifest(0xc3)
    write_image("{ROOT}/flagged.slib", peek flagged)
    let u8[] plain = manifest(0xc2)
    write_image("{ROOT}/plain.slib", peek plain)
    check("{ROOT}/flagged.slib")
    check("{ROOT}/plain.slib")
    remove_all(ROOT)
    return 0

fn main() i32:
    remove_all(ROOT)
    return run_test()
