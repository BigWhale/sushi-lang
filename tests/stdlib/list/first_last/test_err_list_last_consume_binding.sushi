# A `let` bound from `last()` on a List borrows, as one bound from `get()` does, so a
# consuming use of the binding is refused.
# EXPECT_ERROR_CODES_EXACT: CE2411
fn eat(nom string s) ~:
    println(s)

fn f() ~ | StdError:
    let List@(string) words = List.new()
    words.push("a")
    let string tail = words.last().or_err(nom StdError.Error)??
    eat(nom tail)
    return Result.Ok(~)

fn main() i32:
    let Result@(~, StdError) r = f()
    if (r.is_ok()):
        println("done")
    return 0
