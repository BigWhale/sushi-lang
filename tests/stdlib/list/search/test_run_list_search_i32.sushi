# `contains`, `index_of` and `index_of_from` on a `List@(i32)`: the rule of the array
# methods of those names. The start of `index_of_from` is clamped into 0..len(). Each
# index line prints the index, or -1 for None.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "true\nfalse\n0\n3\n-1\n0\n0\n2\n4\n-1\n-1\n2\n4\n-1\n3\n-1\n1\nfalse\n-1\n-1\n-1\n"
fn run_test() i32:
    let List@(i32) l = List.new()
    l.push(7)
    l.push(3)
    l.push(7)
    l.push(5)
    l.push(7)

    println(l.contains(7))
    println(l.contains(9))
    println(l.index_of(7).realise(-1))
    println(l.index_of(5).realise(-1))
    println(l.index_of(9).realise(-1))

    println(l.index_of_from(7, -1).realise(-1))
    println(l.index_of_from(7, 0).realise(-1))
    println(l.index_of_from(7, 2).realise(-1))
    println(l.index_of_from(7, 4).realise(-1))
    println(l.index_of_from(7, 5).realise(-1))
    println(l.index_of_from(7, 10).realise(-1))
    println(l.index_of_from(7, 1).realise(-1))
    println(l.index_of_from(7, 3).realise(-1))
    println(l.index_of_from(3, 2).realise(-1))
    println(l.index_of_from(5, 3).realise(-1))
    println(l.index_of_from(9, 0).realise(-1))
    let i32 start = -7
    println(l.index_of_from(3, start).realise(-1))

    let List@(i32) empty = List.new()
    println(empty.contains(1))
    println(empty.index_of(1).realise(-1))
    println(empty.index_of_from(1, 0).realise(-1))
    println(empty.index_of_from(1, -1).realise(-1))
    return 0

fn main() i32:
    return run_test()
