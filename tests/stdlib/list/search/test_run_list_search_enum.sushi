# A `List@(Maybe@(i32))` compares by variant, then by payload. Each index line prints the
# index, or -1 for None.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "true\nfalse\n1\n0\n3\n2\n-1\n1\n-1\n-1\n"
fn run_test() i32:
    let List@(Maybe@(i32)) ms = List.new()
    ms.push(Maybe.Some(1))
    ms.push(Maybe.None())
    ms.push(Maybe.Some(1))
    ms.push(Maybe.None())

    println(ms.contains(Maybe.None()))
    println(ms.contains(Maybe.Some(2)))
    println(ms.index_of(Maybe.None()).realise(-1))
    println(ms.index_of(Maybe.Some(1)).realise(-1))
    println(ms.index_of_from(Maybe.None(), 2).realise(-1))
    println(ms.index_of_from(Maybe.Some(1), 1).realise(-1))
    println(ms.index_of_from(Maybe.Some(1), 3).realise(-1))
    println(ms.index_of_from(Maybe.None(), -1).realise(-1))
    println(ms.index_of_from(Maybe.None(), 4).realise(-1))
    println(ms.index_of_from(Maybe.None(), 9).realise(-1))
    return 0

fn main() i32:
    return run_test()
