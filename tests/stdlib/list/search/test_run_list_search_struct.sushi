# A `List@(T)` of structs reads the derived equality, or the `Eq` implementation where
# the element has one. Each index line prints the index, or -1 for None.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "true\nfalse\n0\n2\n-1\n0\n-1\n-1\ntrue\n2\n"
struct Point:
    i32 x
    i32 y

struct Tagged:
    i32 key
    i32 noise

extend Tagged with Eq:
    fn eq(Tagged other) bool:
        return self.key == other.key

fn run_test() i32:
    let List@(Point) pts = List.new()
    pts.push(Point(1, 2))
    pts.push(Point(3, 4))
    pts.push(Point(1, 2))

    println(pts.contains(Point(3, 4)))
    println(pts.contains(Point(4, 3)))
    println(pts.index_of(Point(1, 2)).realise(-1))
    println(pts.index_of_from(Point(1, 2), 1).realise(-1))
    println(pts.index_of_from(Point(3, 4), 2).realise(-1))
    println(pts.index_of_from(Point(1, 2), -1).realise(-1))
    println(pts.index_of_from(Point(1, 2), 3).realise(-1))
    println(pts.index_of_from(Point(1, 2), 8).realise(-1))

    let List@(Tagged) tags = List.new()
    tags.push(Tagged(5, 0))
    tags.push(Tagged(6, 0))
    tags.push(Tagged(5, 1))
    println(tags.contains(Tagged(5, 99)))
    println(tags.index_of_from(Tagged(5, 99), 1).realise(-1))
    return 0

fn main() i32:
    return run_test()
