# Truncated carries the offset of the read that could not complete, on every path:
# a length prefix (bin 8), the fixstr path with no prefix, a string inside an array,
# and a fixed-width integer.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "Truncated(2)\nTruncated(1)\nTruncated(2)\nTruncated(2)\n"
use <encoding/msgpack>

fn check(u8[] buf) i32:
    match decode(buf):
        Result.Err(MpError.Truncated(off)) ->
            println("Truncated({off})")
        _ ->
            println("other")
    return Result.Ok(0)

fn main() i32:
    check(from([0xc4, 0x05, 0x01])).realise(1)
    check(from([0xa3, 0x61])).realise(1)
    check(from([0x92, 0xa5, 0x61, 0x62])).realise(1)
    check(from([0xcd, 0x01])).realise(1)
    return Result.Ok(0)
