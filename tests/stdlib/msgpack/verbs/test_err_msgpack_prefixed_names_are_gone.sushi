# mp_decode, mp_map_get and mp_show are deleted, not aliased (#571).
# EXPECT_ERROR_CODE: CE2008
use <encoding/msgpack>

fn run_test() i32:
    let u8[] buf = from([0x81, 0xa1, 0x61, 0x01])
    let MsgValue m = mp_decode(buf).realise(MsgValue.Nil())
    let Maybe@(MsgValue) found = mp_map_get(m, "a")??
    let string shown = mp_show(m)??
    println(shown)
    return Result.Ok(0)

fn main() i32:
    let i32 r = run_test().realise(99)
    return Result.Ok(r)
