# <encoding/msgpack> spells its three free functions by their verb: decode(), map_get()
# and show(). The mp_ prefix named the unit, and the import already does (#571).
# EXPECT_STDOUT_EXACT: "{"a":1,"b":[2]}\na=1\nzz missing\n"
# EXPECT_NO_LEAKS: true

use <encoding/msgpack>

fn lookup(MsgValue m, string key) ~:
    let Maybe@(MsgValue) found = map_get(m, key)??
    match found:
        Maybe.Some(v) ->
            let string shown = show(v)??
            println("{key}={shown}")
        Maybe.None() ->
            println("{key} missing")
    return Result.Ok(~)

fn run_test() i32:
    let u8[] buf = from([0x82, 0xa1, 0x61, 0x01, 0xa1, 0x62, 0x91, 0x02])
    match decode(buf):
        Result.Ok(m) ->
            println(show(m)??)
            lookup(m, "a")??
            lookup(m, "zz")??
        Result.Err(_) ->
            println("decode failed")
    return Result.Ok(0)

fn main() i32:
    let i32 r = run_test().realise(99)
    return Result.Ok(r)
