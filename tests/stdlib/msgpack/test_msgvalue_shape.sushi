# Construct and match each MsgValue variant by hand, before the decoder exists.
# This test fires the first-user enum shapes: an owned array of (key, value) tuples
# (Map), string and u8[] payloads (Str, Bin), and the recursive Arr.
# EXPECT_STDOUT_EXACT: "nil\nbool true\nint -42\nuint 18446744073709551615\nfloat 4614253070214989087\nstr Mostly Harmless\nbin 3\narr 2\nmap 1\n"
# EXPECT_NO_LEAKS: true

use <encoding/msgpack>

fn describe(MsgValue v) string:
    match v:
        MsgValue.Nil() ->
            return "nil"
        MsgValue.Bool(b) ->
            if (b):
                return "bool true"
            return "bool false"
        MsgValue.Int(n) ->
            return "int {n}"
        MsgValue.UInt(n) ->
            return "uint {n}"
        MsgValue.Float(x) ->
            return "float {x.to_bits()}"
        MsgValue.Str(s) ->
            return "str {s}"
        MsgValue.Bin(b) ->
            return "bin {b.len()}"
        MsgValue.Arr(items) ->
            return "arr {items.len()}"
        MsgValue.Map(pairs) ->
            return "map {pairs.len()}"

fn run_test() i32:
    let MsgValue v_nil = MsgValue.Nil()
    println(describe(v_nil))

    let MsgValue v_bool = MsgValue.Bool(true)
    println(describe(v_bool))

    let MsgValue v_int = MsgValue.Int(-42)
    println(describe(v_int))

    let MsgValue v_uint = MsgValue.UInt(18446744073709551615)
    println(describe(v_uint))

    let MsgValue v_float = MsgValue.Float(3.14)
    println(describe(v_float))

    let MsgValue v_str = MsgValue.Str("Mostly Harmless")
    println(describe(v_str))

    let u8[] blob = from([1, 2, 3])
    let MsgValue v_bin = MsgValue.Bin(blob)
    println(describe(v_bin))

    let MsgValue[] kids = from([MsgValue.Int(1), MsgValue.Nil()])
    let MsgValue v_arr = MsgValue.Arr(kids)
    println(describe(v_arr))

    let (MsgValue, MsgValue)[] pairs = from([(MsgValue.Str("k"), MsgValue.Int(7))])
    let MsgValue v_map = MsgValue.Map(pairs)
    println(describe(v_map))

    return 0

fn main() i32:
    let i32 r = run_test()
    return r
