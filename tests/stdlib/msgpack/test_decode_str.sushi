# Decode the string tags: fixstr, str8, str16, str32, with an empty string and
# multi-byte UTF-8. The renderer quotes strings and does not escape them.
# EXPECT_STDOUT_EXACT: ""hello"\n""\n"café"\n"abc"\n"hi"\n"x"\n"
# EXPECT_NO_LEAKS: true

use <encoding/msgpack>

fn check(u8[] buf) ~:
    match decode(buf):
        Result.Ok(v) ->
            println(show(v)??)
        Result.Err(e) ->
            match e:
                MpError.Truncated(off) ->
                    println("Truncated({off})")
                MpError.Unsupported(t) ->
                    println("Unsupported({t})")
                MpError.BadUtf8(off) ->
                    println("BadUtf8({off})")
                MpError.Trailing(p) ->
                    println("Trailing({p})")
    return Result.Ok(~)

fn run_test() i32:
    let u8[] b_hello = from([0xa5, 0x68, 0x65, 0x6c, 0x6c, 0x6f])
    check(b_hello)??
    let u8[] b_empty = from([0xa0])
    check(b_empty)??
    let u8[] b_cafe = from([0xa5, 0x63, 0x61, 0x66, 0xc3, 0xa9])
    check(b_cafe)??
    let u8[] b_str8 = from([0xd9, 0x03, 0x61, 0x62, 0x63])
    check(b_str8)??
    let u8[] b_str16 = from([0xda, 0x00, 0x02, 0x68, 0x69])
    check(b_str16)??
    let u8[] b_str32 = from([0xdb, 0x00, 0x00, 0x00, 0x01, 0x78])
    check(b_str32)??
    return Result.Ok(0)

fn main() i32:
    let i32 r = run_test().realise(99)
    return Result.Ok(r)
