# A str or bin payload copies its bytes in one step. A payload that claims more
# bytes than the buffer holds is Truncated, through the length prefix (bin 8,
# str 8) and through the fixstr path, which reads no length prefix. A payload that
# fits exactly decodes, and the cursor stops after it.
# EXPECT_STDOUT_EXACT: "Truncated(2)\nTruncated(2)\nTruncated(2)\nTruncated(4)\nbin(7,8)\n"hi"\n"ok"\n""\n[bin(9),5]\n["ab",bin()]\n"
# EXPECT_NO_LEAKS: true

use <encoding/msgpack>

fn check(u8[] buf) ~:
    match decode(buf):
        Result.Ok(v) ->
            println(show(v)??)
        Result.Err(e) ->
            match e:
                MpError.Truncated(off) ->
                    println("Truncated({off})")
                MpError.Unsupported(t) ->
                    println("Unsupported({t})")
                MpError.BadUtf8(off) ->
                    println("BadUtf8({off})")
                MpError.Trailing(p) ->
                    println("Trailing({p})")
    return Result.Ok(~)

fn run_test() ~:
    check(from([0xc4, 0x05, 0x01]))??
    check(from([0xd9, 0x04, 0x61]))??
    check(from([0xa3, 0x61]))??
    check(from([0x92, 0xa5, 0x61, 0x62]))??
    check(from([0xc4, 0x02, 0x07, 0x08]))??
    check(from([0xd9, 0x02, 0x68, 0x69]))??
    check(from([0xa2, 0x6f, 0x6b]))??
    check(from([0xa0]))??
    check(from([0x92, 0xc4, 0x01, 0x09, 0x05]))??
    check(from([0x92, 0xa2, 0x61, 0x62, 0xc4, 0x00]))??
    return Result.Ok(~)

fn main() i32:
    match run_test():
        Result.Ok(_) -> return Result.Ok(0)
        Result.Err(_) -> return Result.Ok(1)
