# Test exponential functions: exp, exp2
use <math>

fn main() i32:
    # Test exp (e^x)
    let f64 exp_0 = exp(0.0)
    let f64 exp_1 = exp(1.0)
    let f64 exp_2 = exp(2.0)

    # Test exp2 (2^x)
    let f64 exp2_0 = exp2(0.0)
    let f64 exp2_1 = exp2(1.0)
    let f64 exp2_3 = exp2(3.0)
    let f64 exp2_10 = exp2(10.0)

    # Verify exp(0) = 1
    if ((exp_0 - 1.0).abs() > 0.0001):
        return 1

    # Verify exp(1) = E
    if ((exp_1 - E).abs() > 0.0001):
        return 2

    # Verify exp(2) = E^2
    let f64 e_squared = E * E
    if ((exp_2 - e_squared).abs() > 0.0001):
        return 3

    # Verify exp2(0) = 1
    if ((exp2_0 - 1.0).abs() > 0.0001):
        return 4

    # Verify exp2(1) = 2
    if ((exp2_1 - 2.0).abs() > 0.0001):
        return 5

    # Verify exp2(3) = 8
    if ((exp2_3 - 8.0).abs() > 0.0001):
        return 6

    # Verify exp2(10) = 1024
    if ((exp2_10 - 1024.0).abs() > 0.0001):
        return 7

    # Verify exp/log round-trip
    let f64 x = 3.5
    let f64 roundtrip = exp(log(x))
    if ((roundtrip - x).abs() > 0.0001):
        return 8

    # Verify exp2/log2 round-trip
    let f64 roundtrip2 = exp2(log2(x))
    if ((roundtrip2 - x).abs() > 0.0001):
        return 9

    return 0
