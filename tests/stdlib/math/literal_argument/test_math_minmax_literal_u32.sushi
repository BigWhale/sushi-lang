# A bare literal argument of min or max takes the type of the other argument (#842).
# The compare is unsigned: 4000000000 is the LARGER value. Two literals keep i32.
# EXPECT_STDOUT_EXACT: "4000000000\n1\n4000000000\n1\n4\n"
# EXPECT_RUNTIME_EXIT: 0
use <math>

fn main() i32:
    let u32 b = 4000000000
    let u32 hi = max(b, 1)
    let u32 lo = min(1, b)
    println("{hi}")
    println("{lo}")
    println("{max(1, b)}")
    println("{min(b, 1)}")
    let i32 both = max(3, 4)
    println("{both}")
    return Result.Ok(0)
