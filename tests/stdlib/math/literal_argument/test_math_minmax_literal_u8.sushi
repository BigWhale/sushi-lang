# A literal argument of `a.min(b)` or `a.max(b)` takes the type of the receiver (#842).
# EXPECT_STDOUT_EXACT: "200\n3\n200\n3\n"
# EXPECT_RUNTIME_EXIT: 0
use <math>

fn main() i32:
    let u8 b = 200
    let u8 hi = b.max(3)
    let u8 lo = b.min(3)
    println("{hi}")
    println("{lo}")
    println("{b.max(3)}")
    println("{b.min(3)}")
    return 0
