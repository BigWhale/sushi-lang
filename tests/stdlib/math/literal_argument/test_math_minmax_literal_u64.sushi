# A literal argument of `a.min(b)` or `a.max(b)` takes the type of the receiver (#842).
# EXPECT_STDOUT_EXACT: "18000000000000000000\n7\n18000000000000000000\n7\n"
# EXPECT_RUNTIME_EXIT: 0
use <math>

fn main() i32:
    let u64 b = 18000000000000000000
    let u64 hi = b.max(7)
    let u64 lo = b.min(7)
    println("{hi}")
    println("{lo}")
    println("{b.max(7)}")
    println("{b.min(7)}")
    return 0
