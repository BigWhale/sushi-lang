# `a.min(b)` and `a.max(b)` on each unsigned width compare as unsigned values: a value
# with the top bit set is a large value, never a negative one.
# EXPECT_STDOUT_EXACT: "u8 1 200\nu16 7 60000\nu32 7 4000000000\nu64 7 18000000000000000000\n"
# EXPECT_RUNTIME_EXIT: 0

fn main() i32:
    let u8 a8 = 200
    println("u8 {a8.min(1)} {a8.max(1)}")

    let u16 a16 = 60000
    let u16 b16 = 7
    println("u16 {a16.min(b16)} {a16.max(b16)}")

    let u32 a32 = 4000000000
    println("u32 {a32.min(7)} {a32.max(7)}")

    let u64 a64 = 18000000000000000000
    let u64 b64 = 7
    println("u64 {b64.min(a64)} {b64.max(a64)}")
    return 0
