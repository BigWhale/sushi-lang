# Test logarithmic functions: log, log2, log10
use <math>

fn main() i32:
    # Test log (natural logarithm)
    let f64 log_1 = log(1.0)
    let f64 log_e = log(E)

    # Test log2
    let f64 log2_1 = log2(1.0)
    let f64 log2_2 = log2(2.0)
    let f64 log2_8 = log2(8.0)

    # Test log10
    let f64 log10_1 = log10(1.0)
    let f64 log10_10 = log10(10.0)
    let f64 log10_100 = log10(100.0)

    # Verify log(1) = 0
    if (log_1.abs() > 0.0001):
        return 1

    # Verify log(E) = 1
    if ((log_e - 1.0).abs() > 0.0001):
        return 2

    # Verify log2(1) = 0
    if (log2_1.abs() > 0.0001):
        return 3

    # Verify log2(2) = 1
    if ((log2_2 - 1.0).abs() > 0.0001):
        return 4

    # Verify log2(8) = 3
    if ((log2_8 - 3.0).abs() > 0.0001):
        return 5

    # Verify log10(1) = 0
    if (log10_1.abs() > 0.0001):
        return 6

    # Verify log10(10) = 1
    if ((log10_10 - 1.0).abs() > 0.0001):
        return 7

    # Verify log10(100) = 2
    if ((log10_100 - 2.0).abs() > 0.0001):
        return 8

    # Verify log/exp round-trip
    let f64 x = 2.5
    let f64 roundtrip = log(exp(x))
    if ((roundtrip - x).abs() > 0.0001):
        return 9

    return 0
