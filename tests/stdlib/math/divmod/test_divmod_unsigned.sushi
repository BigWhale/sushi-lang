# `divmod` on every unsigned width divides as an unsigned value: a value with the
# top bit set is a large value, never a negative one.
# EXPECT_STDOUT_EXACT: "u8 28 4\nu16 8571 3\nu32 571428571 3\nu64 2571428571428571428 4\nu8 3 1\n"
# EXPECT_RUNTIME_EXIT: 0
use <math>

fn main() i32:
    let u8 a8 = 200
    let u8 b8 = 7
    let (u8 q8, u8 r8) = divmod(a8, b8).realise((0, 0))
    println("u8 {q8} {r8}")

    let u16 a16 = 60000
    let u16 b16 = 7
    let (u16 q16, u16 r16) = divmod(a16, b16).realise((0, 0))
    println("u16 {q16} {r16}")

    let u32 a32 = 4000000000
    let u32 b32 = 7
    let (u32 q32, u32 r32) = divmod(a32, b32).realise((0, 0))
    println("u32 {q32} {r32}")

    let u64 a64 = 18000000000000000000
    let u64 b64 = 7
    let (u64 q64, u64 r64) = divmod(a64, b64).realise((0, 0))
    println("u64 {q64} {r64}")

    let u8 seven = 7
    let (u8 q, u8 r) = divmod(seven, 2).realise((0, 0))
    println("u8 {q} {r}")
    return 0
