# A perk hash satisfies the hash half of the key gate, but a ptr field still has
# no equality (CE5010: a ptr is an opaque handle), and the probe must compare keys.
# EXPECT_ERROR_CODE: CE2055

use <collections/hashmap>

unsafe external "C" as libc because "a ptr field is the one struct the compiler cannot hash":
    fn strlen(string s) i64 = "strlen"

struct Handle:
    ptr h

perk Hashable:
    fn hash() u64

extend Handle with Hashable:
    fn hash() u64:
        return 7 as u64

fn main() i32:
    let HashMap@(Handle, string) m = HashMap.new()
    m.free()
    return Result.Ok(0)
