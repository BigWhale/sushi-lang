# A binder of pairs() borrows the map's entry, as the key and the value of
# entries() do. To consume one is the consuming use of a borrow.
# EXPECT_ERROR_CODE: CE2411
use <collections/hashmap>

fn keep(nom string s) string:
    return s

fn main() i32:
    let HashMap@(string, i32) ages = HashMap.new()
    ages.insert("Arthur", 42)
    foreach((name, _) in ages.pairs()):
        println(keep(nom name))
    return 0
