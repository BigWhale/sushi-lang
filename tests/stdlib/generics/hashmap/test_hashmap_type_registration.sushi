# Test that HashMap@(K, V) is recognized as a valid generic type, with a built-in key
# and with a user struct as the value.

use <collections/hashmap>
fn main() i32:
    let HashMap@(i32, Point) map = HashMap.new()
    if (map.len() != 0):
        return Result.Ok(1)
    return Result.Ok(0)

struct Point:
    i32 x
    i32 y
