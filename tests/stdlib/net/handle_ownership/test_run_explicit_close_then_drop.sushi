# An explicit close() followed by scope exit closes the descriptor exactly once.
# close() writes -1 into the binding, so the drop that follows is a no-op and the
# kernel is not asked to close a number it may already have given to somebody else.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_OPEN_FDS: true
# EXPECT_STDOUT_EXACT: "closed\ndone\n"
use <net/tcp>

fn shut(poke TcpListener listener) ~:
    match listener.close():
        Result.Ok(_) -> println("closed")
        Result.Err(_) -> println("close failed")
    return Result.Ok(~)

fn main() i32:
    if (true):
        let TcpListener listener = tcp_listen("127.0.0.1", 0, 1).realise(TcpListener(-1))
        shut(poke listener)
    println("done")
    return Result.Ok(0)
