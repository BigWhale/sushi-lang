# A socket MOVES now. Handing one to a `nom` parameter transfers it, and reading the
# old binding afterwards is CE2405 -- the copy that held a live descriptor is gone.
# TEST_TYPE: error
# EXPECT_ERROR_CODE: CE2405
use <net/tcp>

fn adopt(nom TcpListener listener) ~:
    println("adopted")
    return Result.Ok(~)

fn main() i32:
    let TcpListener listener = tcp_listen("127.0.0.1", 0, 1).realise(TcpListener(-1))
    adopt(nom listener)
    println("{listener.fd}")
    return Result.Ok(0)
