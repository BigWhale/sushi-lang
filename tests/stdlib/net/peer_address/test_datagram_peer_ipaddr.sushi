# The sender of a datagram, read as an IpAddr through Datagram.peer(). With
# only `use <net/udp>`, the caller names the type and calls .text() on it.
# EXPECT_STDOUT_EXACT: "got Mostly Harmless\nfrom 127.0.0.1\nfrom loopback true\n"
# EXPECT_NO_LEAKS: true
# TIMEOUT_SECONDS: 20

use <net/udp>
use <collections/strings>

fn main() i32:
    let UdpSocket a = bind("127.0.0.1", 0).realise(UdpSocket(-1))
    let UdpSocket b = bind("127.0.0.1", 0).realise(UdpSocket(-1))
    if (a.fd < 0 or b.fd < 0):
        println("bind failed")
        return 1
    if (not a.set_timeouts(5000, 5000).is_ok() or not b.set_timeouts(5000, 5000).is_ok()):
        println("set_timeouts failed")
        return 1

    let i32 port_b = b.local_port().realise(-1)
    let u8[] greeting = "Mostly Harmless".to_bytes()
    a.send_to(greeting, "127.0.0.1", port_b).realise(-1)
    match b.recv_from(64):
        Result.Ok(dg) ->
            println("got {dg.data.to_string()}")
            match dg.peer():
                Result.Ok(sender) ->
                    let IpAddr s = sender
                    println("from {s.text()}")
                    println("from loopback {s.is_loopback()}")
                Result.Err(_) -> println("peer failed")
        Result.Err(_) -> println("recv_from failed")
    return 0
