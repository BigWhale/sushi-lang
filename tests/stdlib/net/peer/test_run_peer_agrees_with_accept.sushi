# One method reads every TCP peer address: accept(), peer() and peer_ip() give
# one IpAddr for one connection, from the address bits the kernel wrote. The
# port of peer() on the server side is the client's own port. On a dual-stack
# listener the IPv4 client is the V4-mapped V6 address in all three.
# EXPECT_STDOUT_EXACT: "127.0.0.1 true true true\n::1 true true true\n::ffff:127.0.0.1 true true true\n"
# EXPECT_NO_LEAKS
# EXPECT_NO_OPEN_FDS
# TIMEOUT_SECONDS: 20
use <net/tcp>

fn check(string bind, string target) ~ | NetError:
    let TcpListener listener = listen(bind, 0, 8)??
    let TcpStream client = connect(target, listener.local_port()??)??
    let (TcpStream served, IpAddr from_accept) = listener.accept()??
    let (IpAddr from_peer, i32 port) = served.peer()??
    let IpAddr from_peer_ip = served.peer_ip()??
    let bool same_peer = from_peer == from_accept
    let bool same_peer_ip = from_peer_ip == from_accept
    let bool client_port = port == client.local_port()??
    println("{from_accept.text()} {same_peer} {same_peer_ip} {client_port}")
    return Result.Ok(~)

fn run(string bind, string target) ~:
    if (check(bind, target).is_err()):
        println("{bind} failed")

fn main() i32:
    run("127.0.0.1", "127.0.0.1")
    run("::1", "::1")
    run("::", "127.0.0.1")
    return 0
