# sock_tcp_listen sets SO_REUSEADDR before every bind, and this is what that
# buys: a port whose last connection is still in TIME_WAIT binds again at once.
# Without the option the second listen answers EADDRINUSE.
# EXPECT_STDOUT_EXACT: "the port is busy\nbound it again anyway\nclosed\n"
# EXPECT_NO_LEAKS: true
# TIMEOUT_SECONDS: 20

use <net/socket>

fn main() i32:
    let i32 lfd = sock_tcp_listen("127.0.0.1", 0, 8).realise(-1)
    let i32 port = sock_local_port(lfd).realise(-1)

    # A connection made and torn down leaves the pair in TIME_WAIT, which is
    # what makes the port genuinely busy for the second bind below.
    let i32 cfd = sock_tcp_connect("127.0.0.1", port).realise(-1)
    let i32 afd = sock_tcp_accept(lfd).realise(-1)
    sock_close(cfd).realise(-1)
    sock_close(afd).realise(-1)
    sock_close(lfd).realise(-1)
    println("the port is busy")

    match sock_tcp_listen("127.0.0.1", port, 8):
        Result.Ok(again) ->
            println("bound it again anyway")
            match sock_close(again):
                Result.Ok(_) -> println("closed")
                Result.Err(_) -> println("close failed")
        Result.Err(_) -> println("wrong: the address was refused")

    return Result.Ok(0)
