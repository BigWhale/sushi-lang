# The u8[] handed to sock_send is a BORROW: the caller keeps the buffer and may
# read it again afterwards. sock_send is the first FREE stdlib function to take
# an array -- the file write_bytes twin is a method -- so the rule gets its own
# test rather than riding along in the round trip.
# EXPECT_STDOUT_EXACT: "sent 15\nthe buffer still reads Mostly Harmless\nclosed\n"
# EXPECT_NO_LEAKS: true
# TIMEOUT_SECONDS: 20

use <net/socket>
use <collections/strings>

fn main() i32:
    let i32 lfd = sock_tcp_listen("127.0.0.1", 0, 8).realise(-1)
    let i32 port = sock_local_port(lfd).realise(-1)
    let i32 cfd = sock_tcp_connect("127.0.0.1", port).realise(-1)
    let i32 afd = sock_tcp_accept(lfd).realise(-1)
    sock_set_send_timeout(cfd, 5000).realise(-1)

    let u8[] payload = "Mostly Harmless".to_bytes()
    let i32 sent = sock_send(cfd, payload).realise(-1)
    println("sent {sent}")
    println("the buffer still reads {payload.to_string()}")

    sock_close(cfd).realise(-1)
    sock_close(afd).realise(-1)
    match sock_close(lfd):
        Result.Ok(_) -> println("closed")
        Result.Err(_) -> println("close failed")

    return Result.Ok(0)
