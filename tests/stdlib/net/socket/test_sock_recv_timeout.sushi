# A receive timeout is a bound rather than a hang. With nothing sent, recv on a
# socket carrying SO_RCVTIMEO answers EAGAIN, and on a BLOCKING socket -- which
# every socket here is -- EAGAIN can only mean the timeout the caller asked for
# expired. That is why the errno table reads it as TimedOut.
# EXPECT_STDOUT_EXACT: "recv timed out\nclosed\n"
# EXPECT_NO_LEAKS: true
# TIMEOUT_SECONDS: 20

use <net/socket>
use <net/error>

fn main() i32:
    let i32 lfd = sock_tcp_listen("127.0.0.1", 0, 8).realise(-1)
    let i32 port = sock_local_port(lfd).realise(-1)
    let i32 cfd = sock_tcp_connect("127.0.0.1", port).realise(-1)
    let i32 afd = sock_tcp_accept(lfd).realise(-1)

    sock_set_recv_timeout(afd, 200).realise(-1)
    match sock_recv(afd, 64):
        Result.Ok(got) -> println("wrong: {got.len()} bytes arrived from nobody")
        Result.Err(e) ->
            match e:
                NetError.TimedOut -> println("recv timed out")
                _ -> println("wrong: some other variant")

    sock_close(cfd).realise(-1)
    sock_close(afd).realise(-1)
    match sock_close(lfd):
        Result.Ok(_) -> println("closed")
        Result.Err(_) -> println("close failed")

    return Result.Ok(0)
