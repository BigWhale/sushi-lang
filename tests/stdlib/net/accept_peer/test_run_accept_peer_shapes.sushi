# The pair that accept() answers is an ordinary tuple. A match takes the stream with a
# `nom` binding in a tuple pattern, a `_` element drops the stream at once and closes
# its descriptor, and a dual-stack listener answers an IPv4 client as a V4-mapped V6
# address.
# EXPECT_STDOUT_EXACT: "matched 127.0.0.1\nserver got 42\ndropped stream, kept 127.0.0.1\nmapped true\nmapped low 281472812449793\n"
# EXPECT_NO_LEAKS: true
# EXPECT_NO_OPEN_FDS: true
# TIMEOUT_SECONDS: 20

use <net/tcp>
use <collections/strings>

fn take(nom TcpStream s, nom TcpStream c) ~ | NetError:
    s.set_timeouts(5000, 5000)??
    c.set_timeouts(5000, 5000)??
    c.send_all("42".to_bytes())??
    let u8[] heard = s.recv_exact(2)??
    println("server got {heard.to_string()}")
    return Result.Ok(~)

fn matched() ~ | NetError:
    let TcpListener listener = listen("127.0.0.1", 0, 8)??
    listener.set_timeout(5000)??
    let TcpStream client = connect("127.0.0.1", listener.local_port()??)??
    match listener.accept():
        Result.Ok((nom served, peer)) ->
            println("matched {peer.text()}")
            take(nom served, nom client)??
        Result.Err(e) ->
            return Result.Err(e)
    return Result.Ok(~)

fn dropped() ~ | NetError:
    let TcpListener listener = listen("127.0.0.1", 0, 8)??
    listener.set_timeout(5000)??
    let TcpStream client = connect("127.0.0.1", listener.local_port()??)??
    client.set_timeouts(5000, 5000)??
    let (_, IpAddr peer) = listener.accept()??
    println("dropped stream, kept {peer.text()}")
    return Result.Ok(~)

fn mapped() ~ | NetError:
    let TcpListener listener = listen("::", 0, 8)??
    listener.set_timeout(5000)??
    let TcpStream client = connect("127.0.0.1", listener.local_port()??)??
    let (TcpStream served, IpAddr peer) = listener.accept()??
    client.set_timeouts(5000, 5000)??
    served.set_timeouts(5000, 5000)??
    println("mapped {peer.is_v4_mapped()}")
    match peer:
        IpAddr.V4(_) -> println("not a V6 address")
        IpAddr.V6(_, low) -> println("mapped low {low}")
    return Result.Ok(~)

fn main() i32:
    if (not matched().is_ok()):
        println("matched failed")
        return 1
    if (not dropped().is_ok()):
        println("dropped failed")
        return 1
    if (not mapped().is_ok()):
        println("mapped failed")
        return 1
    return 0
