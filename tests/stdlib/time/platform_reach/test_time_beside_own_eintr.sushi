# `<time>` reads `<sys/platform>` inside its own unit. A program that imports `<time>` and
# declares its own `EINTR` gets no clash and no warning, and its own value is the one it reads.
# EXPECT_STDOUT_EXACT: "EINTR = 99\nmsleep(0) = 0\n"
# EXPECT_RUNTIME_EXIT: 0
use <time>

const i32 EINTR = 99

fn main() i32:
    println("EINTR = {EINTR}")
    println("msleep(0) = {msleep(0 as i64).realise(7)}")
    return 0
