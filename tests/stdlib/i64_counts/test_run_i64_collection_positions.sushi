# enumerate, find_from, binary_search and StringBuilder.size() take and answer an i64
# position or count (ADR 0001).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "0 Arthur\n1 Ford\n0 Arthur\n1 Ford\n0 10\n1 20\nfind 4\nsearch 1\nsize 6\n"
use <collections/iter>
use <collections/strings>
use <collections/sort>

fn main() i32:
    let List@(string) names = List.new()
    names.push("Arthur")
    names.push("Ford")
    let List@((i64, string)) a = enumerate(names)
    foreach((i64 i, string name) in a.iter()):
        println("{i} {name}")
    let List@((i64, string)) b = names.enumerate()
    foreach((i64 i, string name) in b.iter()):
        println("{i} {name}")
    let i32[] scores = from([10, 20])
    let List@((i64, i32)) c = scores.enumerate()
    foreach((i64 i, i32 v) in c.iter()):
        println("{i} {v}")

    let i64 start = 2
    let Maybe@(i64) found = "abcabc".find_from("bc", start)
    println("find {found.realise(-1)}")

    let i32[] xs = from([1, 3, 5])
    let Maybe@(i64) hit = xs.binary_search(3)
    println("search {hit.realise(-1)}")

    let StringBuilder sb = StringBuilder.new()
    sb.push("Mostly")
    let i64 size = sb.size()
    println("size {size}")
    return 0
