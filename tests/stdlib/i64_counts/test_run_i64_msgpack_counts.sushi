# decode_prefix answers the count of bytes it read as an i64, and map_index answers
# an i64 position (ADR 0001).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "1 used 1\n"hi" used 3\ndone 4\nindex b=1\n"
use <encoding/msgpack>

fn walk(u8[] stream) i64 | MpError:
    let i64 at = 0
    while (at < stream.len()):
        let (MsgValue v, i64 used) = decode_prefix(stream.s(at, stream.len()))??
        println("{show(v)} used {used}")
        at := at + used
    return Result.Ok(at)

fn main() i32:
    let u8[] stream = from([0x01, 0xa2, 0x68, 0x69])
    match walk(stream):
        Result.Ok(n) -> println("done {n}")
        Result.Err(e) -> println("walk failed {e.text()}")

    let u8[] map = from([0x82, 0xa1, 0x61, 0x01, 0xa1, 0x62, 0x02])
    let MsgValue m = decode(map).realise(MsgValue.Nil())
    let Maybe@(i64) at = map_index(m, "b")
    match at:
        Maybe.Some(i) -> println("index b={i}")
        Maybe.None -> println("index b=none")
    return 0
