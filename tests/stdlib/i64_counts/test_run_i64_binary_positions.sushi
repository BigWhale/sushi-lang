# The binary readers take an i64 position (ADR 0001).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "513 258\n67305985 16909060\n578437695752307201 72623859790382856\nnone\n"
use <encoding/binary>

fn main() i32:
    let u8[] buf = from([1 as u8, 2, 3, 4, 5, 6, 7, 8])
    let i64 at = 0
    let i64 past = 7
    println("{buf.read_u16_le(at).realise(0)} {buf.read_u16_be(at).realise(0)}")
    println("{buf.read_u32_le(at).realise(0)} {buf.read_u32_be(at).realise(0)}")
    println("{buf.read_u64_le(at).realise(0)} {buf.read_u64_be(at).realise(0)}")
    match buf.read_u16_le(past):
        Maybe.Some(v) -> println("{v}")
        Maybe.None -> println("none")
    return 0
