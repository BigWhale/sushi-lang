# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "small_in_range:true\nlow_reached:true\nhigh_reached:true\nwide_in_range:true\n"
#
# `rand_range(min, max)` gives a value in [min, max). It reaches both ends of a small
# range, and the widest i32 range stays in its bounds.
use <random>

fn main() i32:
    let bool small_in_range = true
    let bool low_reached = false
    let bool high_reached = false
    let i32 i = 0
    while (i < 2000):
        let i32 x = rand_range(-3, 4)
        if (x < -3 or x >= 4):
            small_in_range := false
        if (x == -3):
            low_reached := true
        if (x == 3):
            high_reached := true
        i := i + 1
    println("small_in_range:{small_in_range}")
    println("low_reached:{low_reached}")
    println("high_reached:{high_reached}")

    let bool wide_in_range = true
    let i32 j = 0
    while (j < 1000):
        let i32 y = rand_range(-2147483648, 2147483647)
        if (y == 2147483647):
            wide_in_range := false
        j := j + 1
    println("wide_in_range:{wide_in_range}")
    return 0
