# The socket levels, options and the `struct timeval` layout of `<sys/platform>` are
# right for this host (#1089): each option is set and read back, and a receive timeout
# written in the platform's layout expires.
# EXPECT_STDOUT_EXACT: "SO_REUSEADDR: ok\nSO_ERROR: ok\nSO_RCVTIMEO: ok\nSO_SNDTIMEO: ok\nSO_NOSIGPIPE: ok\nthe timeout expires: ok\nEAGAIN: ok\nsend without SIGPIPE: ok\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
use <sys/platform>
use "helpers/check"

unsafe external "C" as libc because "checking the socket options against the host":
    fn calloc(i64 count, i64 size) ptr = "calloc"
    fn free(ptr p) ~ = "free"
    fn socket(i32 domain, i32 kind, i32 protocol) i32 = "socket"
    fn setsockopt(i32 s, i32 level, i32 name, ptr value, u32 length) i32 = "setsockopt"
    fn getsockopt(i32 s, i32 level, i32 name, ptr value, ptr length) i32 = "getsockopt"
    fn recv(i32 s, poke u8[] buf, i64 n, i32 flags) i64 = "recv"
    fn send(i32 s, u8[] buf, i64 n, i32 flags) i64 = "send"
    fn close(i32 s) i32 = "close"

fn fill_timeval(ptr tv, i64 seconds, i64 micros) ~:
    tv.store_i64(0, seconds)
    if (TIMEVAL_USEC_BYTES == 4):
        tv.store_i32(TIMEVAL_USEC_OFFSET, micros as i32)
    else:
        tv.store_i64(TIMEVAL_USEC_OFFSET, micros)
    return Result.Ok(~)

fn micros_of(ptr tv) i64:
    if (TIMEVAL_USEC_BYTES == 4):
        return Result.Ok(tv.load_i32(TIMEVAL_USEC_OFFSET) as i64)
    return Result.Ok(tv.load_i64(TIMEVAL_USEC_OFFSET))

fn read_int(i32 s, i32 name) i32:
    let ptr value = libc.calloc(1, 4)
    let ptr length = libc.calloc(1, 4)
    length.store_u32(0, 4)
    let i32 rc = libc.getsockopt(s, SOL_SOCKET, name, value, length)
    let i32 read = value.load_i32(0)
    libc.free(value)
    libc.free(length)
    if (rc != 0):
        return Result.Ok(-1)
    return Result.Ok(read)

fn timeout_round_trip(i32 s, i32 name) bool:
    let ptr tv = libc.calloc(1, TIMEVAL_SIZE as i64)
    fill_timeval(tv, 2, 500000)??
    let i32 set = libc.setsockopt(s, SOL_SOCKET, name, tv, TIMEVAL_SIZE as u32)
    let ptr back = libc.calloc(1, TIMEVAL_SIZE as i64)
    let ptr length = libc.calloc(1, 4)
    length.store_u32(0, TIMEVAL_SIZE as u32)
    let i32 got = libc.getsockopt(s, SOL_SOCKET, name, back, length)
    let bool same = set == 0 and got == 0 and back.load_i64(0) == 2 and micros_of(back).realise(0) == 500000
    libc.free(tv)
    libc.free(back)
    libc.free(length)
    return Result.Ok(same)

fn main() i32:
    let i32 s = libc.socket(AF_INET, SOCK_STREAM, IPPROTO_TCP)
    let ptr one = libc.calloc(1, 4)
    one.store_i32(0, 1)
    let i32 reuse = libc.setsockopt(s, SOL_SOCKET, SO_REUSEADDR, one, 4)
    let i32 f1 = expect_true("SO_REUSEADDR", reuse == 0 and read_int(s, SO_REUSEADDR).realise(0) != 0).realise(1)
    let i32 f2 = expect("SO_ERROR", read_int(s, SO_ERROR).realise(-1) as i64, 0).realise(1)
    let i32 f3 = expect_true("SO_RCVTIMEO", timeout_round_trip(s, SO_RCVTIMEO).realise(false)).realise(1)
    let i32 f4 = expect_true("SO_SNDTIMEO", timeout_round_trip(s, SO_SNDTIMEO).realise(false)).realise(1)
    let i32 nosig = 0
    if (SO_NOSIGPIPE != 0):
        nosig := libc.setsockopt(s, SOL_SOCKET, SO_NOSIGPIPE, one, 4)
    let i32 f5 = expect("SO_NOSIGPIPE", nosig as i64, 0).realise(1)
    let i64 sent = libc.send(s, from([0 as u8]), 1, MSG_NOSIGNAL)
    let i32 c1 = libc.close(s)

    let i32 u = libc.socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP)
    let ptr short = libc.calloc(1, TIMEVAL_SIZE as i64)
    let bool filled = fill_timeval(short, 0, 200000).is_ok()
    let i32 set = libc.setsockopt(u, SOL_SOCKET, SO_RCVTIMEO, short, TIMEVAL_SIZE as u32)
    let u8[] buf = from([0; 8])
    let i64 got = libc.recv(u, poke buf, 8, 0)
    let i32 code = errno()
    let i32 f6 = expect_true("the timeout expires", filled and set == 0 and got == -1).realise(1)
    let i32 f7 = expect("EAGAIN", code as i64, EAGAIN as i64).realise(1)
    let i32 c2 = libc.close(u)
    let i32 f8 = expect_true("send without SIGPIPE", sent == -1).realise(1)
    libc.free(short)
    libc.free(one)
    return Result.Ok(f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8 + c1 + c2)
