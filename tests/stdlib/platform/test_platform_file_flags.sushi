# The `open` flags and the `lseek` whences of `<sys/platform>` are right for this host
# (#1089): C creates, truncates and appends with them, and seeks with the whences.
# RUN_IN_FIXTURE_DIR
# EXPECT_STDOUT_EXACT: "O_CREAT | O_TRUNC | O_WRONLY: ok\nO_APPEND: ok\nSEEK_END: ok\nSEEK_SET: ok\nSEEK_CUR: ok\nO_RDONLY: ok\nO_RDWR | O_TRUNC: ok\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
use <sys/platform>
use <collections/strings>
use "helpers/check"

unsafe external "C" as libc because "checking the open flags against the host":
    fn open(string path, i32 flags, ...) i32 = "open"
    fn write(i32 fd, u8[] buf, i64 n) i64 = "write"
    fn read(i32 fd, poke u8[] buf, i64 n) i64 = "read"
    fn lseek(i32 fd, i64 offset, i32 whence) i64 = "lseek"
    fn close(i32 fd) i32 = "close"
    fn unlink(string path) i32 = "unlink"

fn main() i32:
    let string path = "scratch.txt"
    let i32 created = libc.open(path, O_CREAT | O_TRUNC | O_WRONLY, 0o644)
    let i64 first = libc.write(created, "Mostly".to_bytes(), 6)
    let i32 c1 = libc.close(created)
    let i32 f1 = expect_true("O_CREAT | O_TRUNC | O_WRONLY", created >= 0 and first == 6).realise(1)

    let i32 appending = libc.open(path, O_WRONLY | O_APPEND)
    let i64 moved = libc.lseek(appending, 0, SEEK_SET)
    let i64 second = libc.write(appending, " Harmless".to_bytes(), 9)
    let i32 c2 = libc.close(appending)
    let i32 reading = libc.open(path, O_RDONLY)
    let i64 size = libc.lseek(reading, 0, SEEK_END)
    let i32 f2 = expect_true("O_APPEND", moved == 0 and second == 9 and size == 15).realise(1)
    let i32 f3 = expect("SEEK_END", size, 15).realise(1)
    let i32 f4 = expect("SEEK_SET", libc.lseek(reading, 7, SEEK_SET), 7).realise(1)
    let i32 f5 = expect("SEEK_CUR", libc.lseek(reading, 1, SEEK_CUR), 8).realise(1)
    let u8[] buf = from([0; 16])
    let i64 got = libc.read(reading, poke buf, 16)
    buf.truncate(got as i32)
    let i32 f6 = expect_true("O_RDONLY", buf.to_string() == "armless").realise(1)
    let i32 c3 = libc.close(reading)

    let i32 cutting = libc.open(path, O_RDWR | O_TRUNC)
    let i32 f7 = expect("O_RDWR | O_TRUNC", libc.lseek(cutting, 0, SEEK_END), 0).realise(1)
    let i32 c4 = libc.close(cutting)
    let i32 gone = libc.unlink(path)
    return Result.Ok(f1 + f2 + f3 + f4 + f5 + f6 + f7 + c1 + c2 + c3 + c4 + gone)
