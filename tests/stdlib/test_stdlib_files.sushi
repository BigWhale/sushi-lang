# EXPECT_STDOUT_EXACT: "Read line 1: Mostly Harmless\nRead char: L\nFile is open\nFile I/O tests complete!\n"
# EXPECT_RUNTIME_EXIT: 0
# Test stdlib file I/O methods
# This test exercises all 12 file methods using the stdlib IR implementation

use <io/files>
use <io/fs>

fn main() i32:
    # Test writing to a file
    let Result@(File, FileError) result = open("/tmp/sushi_test_file.txt", FileMode.Write())
    match result:
        Result.Ok(poke f) ->
            # Test write and writeln
            f.write("Mostly ")
            f.writeln("Harmless")
            f.write("Line 2")
            f.close()
        Result.Err(_) ->
            println("Failed to open file for writing")
            return Result.Ok(1)

    # Test reading from the file
    let Result@(File, FileError) read_result = open("/tmp/sushi_test_file.txt", FileMode.Read())
    match read_result:
        Result.Ok(poke f) ->
            # Test readln
            let string line1 = f.readln().realise('')
            println("Read line 1: {line1}")

            # Test readch
            let string ch1 = f.readch().realise('')
            println("Read char: {ch1}")

            f.close()
        Result.Err(_) ->
            println("Failed to open file for reading")
            return Result.Ok(1)

    # Test is_open
    let Result@(File, FileError) check_result = open("/tmp/sushi_test_file.txt", FileMode.Read())
    match check_result:
        Result.Ok(poke f) ->
            if (f.is_open()):
                println("File is open")
            f.close()
        Result.Err(_) ->
            println("Failed")

    println("File I/O tests complete!")
    return Result.Ok(0)
