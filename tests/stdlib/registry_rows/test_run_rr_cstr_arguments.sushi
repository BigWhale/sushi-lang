# A `cstr` parameter of a registry row takes a string from a literal, from a heap string
# and from a borrowed parameter. The C copy lives for the call alone.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "literal:false\nheap:false\nparam:false\nheap again:false\nloop:3\n"
use <io/files>

fn probe(string path) bool:
    return exists(path)

fn main() i32:
    println("literal:{exists('rr_no_such_file_literal.txt')}")
    let string stem = "rr_no_such"
    let string heap = "{stem}_file_heap.txt"
    println("heap:{exists(heap)}")
    println("param:{probe(heap)}")
    println("heap again:{is_dir(heap)}")
    let i32 count = 0
    while (count < 10):
        if (is_file(heap)):
            println("unexpected")
        count := count + 1
        if (count == 3):
            break
    println("loop:{count}")
    return 0
