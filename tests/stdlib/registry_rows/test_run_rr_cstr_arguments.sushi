# A `cstr` parameter of a registry row takes a string from a literal, from a heap string
# and from a borrowed parameter. The C copy lives for the call alone.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "literal:true\nheap:true\nparam:true\nheap again:true\nloop:3\n"
use <net/socket>

fn probe(string host) bool:
    return sock_dns_resolve(host).is_ok()

fn main() i32:
    println("literal:{sock_dns_resolve('127.0.0.1').is_ok()}")
    let string stem = "127.0.0"
    let string heap = "{stem}.1"
    println("heap:{sock_dns_resolve(heap).is_ok()}")
    println("param:{probe(heap)}")
    println("heap again:{sock_dns_resolve(heap).is_ok()}")
    let i32 count = 0
    while (count < 10):
        if (not sock_dns_resolve(heap).is_ok()):
            println("unexpected")
        count := count + 1
        if (count == 3):
            break
    println("loop:{count}")
    return 0
