# push_u32_le and push_u32_be append the 4 bytes of a u32.
# le puts the least significant byte first, be the most significant byte first.
# The values are 0, 1, the maximum, two mixed patterns, and a push onto a non-empty array.
# Each line prints the length, then each byte by index.
# EXPECT_STDOUT_EXACT: "le\n4: 0 0 0 0\n4: 1 0 0 0\n4: 255 255 255 255\n4: 4 3 2 1\n4: 1 127 255 128\n5: 9 4 3 2 1\nbe\n4: 0 0 0 0\n4: 0 0 0 1\n4: 255 255 255 255\n4: 1 2 3 4\n4: 128 255 127 1\n5: 9 1 2 3 4\n"
# EXPECT_NO_LEAKS: true
use <encoding/binary>

fn show(u8[] b) string:
    let string s = "{b.len()}:"
    foreach(i in 0..b.len()):
        s := "{s} {b[i]}"
    return s

fn le(u32 v) string:
    let u8[] buf = from([])
    buf.push_u32_le(v)
    return show(buf)

fn be(u32 v) string:
    let u8[] buf = from([])
    buf.push_u32_be(v)
    return show(buf)

fn main() i32:
    println("le")
    println(le(0))
    println(le(1))
    println(le(0xFFFF_FFFF))
    println(le(0x0102_0304))
    println(le(0x80FF_7F01))
    let u8[] a = from([9])
    a.push_u32_le(0x0102_0304)
    println(show(a))

    println("be")
    println(be(0))
    println(be(1))
    println(be(0xFFFF_FFFF))
    println(be(0x0102_0304))
    println(be(0x80FF_7F01))
    let u8[] b = from([9])
    b.push_u32_be(0x0102_0304)
    println(show(b))
    return 0
