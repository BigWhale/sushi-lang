# A unit that calls only <encoding/binary> methods uses its import: --warn-unused gives
# no unused-use warning, and the module itself has no dead declaration.
# COMPILER_FLAGS: --warn-unused
# EXPECT_STDOUT_EXACT: "513\n"
# EXPECT_STDERR_EMPTY: true

use <encoding/binary>

fn main() i32:
    let u8[] buf = from([])
    buf.push_u16_be(0x0102)
    println(buf.read_u16_le(0).realise(0))
    return 0
