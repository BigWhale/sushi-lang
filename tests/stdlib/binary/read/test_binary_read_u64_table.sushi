# read_u64_le and read_u64_be over the known bytes 0x01 0x02 ... (11 bytes).
# Every offset that holds 8 bytes, then the edges: a negative offset, the first offset
# past the last full value (len - 8 + 1), the length itself, an empty array, an array
# shorter than 8 bytes, the i32 maximum and the i32 minimum. Each edge answers None.
# High bytes are not sign-extended.
# EXPECT_STDOUT_EXACT: "at 0 le=578437695752307201 be=72623859790382856\nat 1 le=650777868590383874 be=144964032628459529\nat 2 le=723118041428460547 be=217304205466536202\nat 3 le=795458214266537220 be=289644378304612875\nat -1 le=none be=none\nat 4 le=none be=none\nat 11 le=none be=none\nempty le=none be=none\nshort le=none be=none\nmax le=none be=none\nmin le=none be=none\nhigh le=17940646550795321087 be=18446460386757245432\n"
# EXPECT_NO_LEAKS

use <encoding/binary>

fn show(Maybe@(u64) m) string:
    match m:
        Maybe.Some(v) -> return "{v}"
        Maybe.None() -> return "none"

fn line(u8[] buf, i32 at, string tag) ~:
    println("{tag} le={show(buf.read_u64_le(at))} be={show(buf.read_u64_be(at))}")

fn main() i32:
    let u8[] buf = from([0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b])
    foreach(at in 0..4):
        line(buf, at, "at {at}")
    line(buf, -1, "at -1")
    line(buf, 4, "at 4")
    line(buf, 11, "at 11")

    let u8[] empty = from([])
    line(empty, 0, "empty")

    let u8[] short = from([0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07])
    line(short, 0, "short")

    line(buf, 2147483647, "max")
    line(buf, -2147483647 - 1, "min")

    let u8[] high = from([0xff, 0xfe, 0xfd, 0xfc, 0xfb, 0xfa, 0xf9, 0xf8])
    line(high, 0, "high")
    return 0
