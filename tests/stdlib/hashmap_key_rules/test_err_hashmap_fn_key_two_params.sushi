# The same key rule for a function key whose parameter list holds a comma (#789).
# EXPECT_ERROR_CODE: CE2054
use <collections/hashmap>

fn add(i32 a, i32 b) i32:
    return Result.Ok(a + b)

fn main() i32:
    let HashMap@(fn(i32, i32) -> i32, string) m = HashMap.new()
    m.insert(add, "add")
    m.free()
    return Result.Ok(0)
