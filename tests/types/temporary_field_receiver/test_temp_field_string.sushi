# A built-in method on a string field of a temporary struct (#1148).
# EXPECT_STDOUT_EXACT: "6\nMOSTLY\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS

use <collections/strings>

struct S:
    string s

fn st() S:
    return S("mostly".lower())

fn main() i32:
    println(st().s.len())
    println(st().s.upper())
    return 0
