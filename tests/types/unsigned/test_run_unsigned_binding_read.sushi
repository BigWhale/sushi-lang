# The read shapes that already printed unsigned before issue #379 was fixed --
# a `foreach` binding, a `match` binding, and a `const`. They are the control
# column: the bug was in the shapes with no Pass 2 stamp, not in the formatter.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "255\n4294967295\n18446744073709551615\n65535\n4294967295\n40000\n"
const u32 BIG = 4294967295

enum Held:
    Small(u16)
    Large(u32)

fn main() i32:
    let u8[] d8 = from([255 as u8])
    let u32[] d32 = from([4294967295 as u32])
    let u64[] d64 = from([18446744073709551615 as u64])

    foreach(v in d8.iter()):
        println(v)
    foreach(v in d32.iter()):
        println(v)
    foreach(v in d64.iter()):
        println("{v}")

    let Held h = Held.Small(65535 as u16)
    match h:
        Held.Small(n) -> println(n)
        Held.Large(n) -> println(n)

    println(BIG)
    println("{40000 as u16}")

    return Result.Ok(0)
