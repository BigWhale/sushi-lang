# Design 2.4 (E3): `Result` is not an error type, in the `| E` spelling and in the
# `Result@(T, E)` spelling. The inner `Result` is legal; the outer `E` is not.
# EXPECT_ERROR_CODES_EXACT: CE2084, CE2084
error AppError:
    Empty

fn short_form() i32 | Result@(i32, AppError):
    return Result.Ok(1)

fn long_form() Result@(i32, Result@(i32, AppError)):
    return Result.Ok(2)

fn main() i32:
    return 0
