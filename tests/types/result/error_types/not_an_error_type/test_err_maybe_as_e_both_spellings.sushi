# Design 2.4 (E3): `Maybe` is not an error type, in the `| E` spelling and in the
# `Result@(T, E)` spelling. CE2084 carries the rule, and CE2086 is retired.
# EXPECT_ERROR_CODES_EXACT: CE2084, CE2084
error AppError:
    Empty

fn short_form() i32 | Maybe@(AppError):
    return Result.Ok(1)

fn long_form() Result@(i32, Maybe@(AppError)):
    return Result.Ok(2)

fn main() i32:
    return 0
