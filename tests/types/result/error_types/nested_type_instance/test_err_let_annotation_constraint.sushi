# A perk constraint at a generic type instance that a template builds from a `let`
# annotation: `Box@(T)` with an unconstrained `T`. The template check refuses it once, at the
# annotation in the template, with a help that adds the constraint. The analysis does not stop,
# so the copy for the call `outer(nom 5)` adds no second refusal, and the unused `b` is a warning.
# EXPECT_ERROR_CODES_EXACT: CW1001, CE4006
# EXPECT_STDERR_CONTAINS: let_annotation_constraint.sushi:15:9: error [CE4006]
# EXPECT_STDERR_CONTAINS: add 'Named' to the constraints of 'T'
perk Named:
    fn named() i32

struct Box@(T: Named):
    T v

fn outer@(T)(nom T x) i32:
    let Box@(T) b = Box(x)
    return 0

fn main() i32:
    println(outer(nom 5))
    return 0
