# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "PASS: FileError works\nPASS: IoError works\nPASS: EnvError works\n"
# EXPECT_STDERR_EMPTY: true

# Tests using multiple stdlib error types in one program

use <io/fs>
use <sys/env>

fn file_operation(i32 code) string | FileError:
    if (code == 1):
        return Result.Err(FileError.NotFound)
    return Result.Ok("file data")

fn io_operation(i32 code) string | IoError:
    if (code == 1):
        return Result.Err(IoError.NotFound)
    return Result.Ok("io data")

fn env_operation(i32 code) string | EnvError:
    if (code == 1):
        return Result.Err(EnvError.NotFound)
    return Result.Ok("env data")

fn main() i32:
    match file_operation(1):
        Result.Err(FileError.NotFound) ->
            println("PASS: FileError works")
        _ ->
            println("FAIL: FileError failed")
            return 1

    match io_operation(1):
        Result.Err(IoError.NotFound) ->
            println("PASS: IoError works")
        _ ->
            println("FAIL: IoError failed")
            return 1

    match env_operation(1):
        Result.Err(EnvError.NotFound) ->
            println("PASS: EnvError works")
            return 0
        _ ->
            println("FAIL: EnvError failed")
            return 1
