# Design 4 (C9): the parameter of `or_err` is `nom`, and a mode is marked at both ends.
# An argument with no `nom` marker is refused, as for every `nom` parameter.
# EXPECT_ERROR_CODES_EXACT: CE2427
# EXPECT_STDERR_CONTAINS: parameter 'e'
error AppError:
    Empty

fn first(i32[] xs) i32 | AppError:
    let i32 v = xs.get(0).or_err(AppError.Empty)??
    return Result.Ok(v)

fn main() i32:
    let i32[] xs = from([1])
    println(first(xs).realise(0))
    return 0
