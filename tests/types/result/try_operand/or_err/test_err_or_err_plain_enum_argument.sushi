# Design 4 (E3): `E` of `or_err` is judged at each instance. A plain enum is not an error
# type, so the call that solves `E` to one is refused.
# EXPECT_ERROR_CODES_EXACT: CE2084
# EXPECT_STDERR_CONTAINS: 'Colour' is a plain enum, not an error type
enum Colour:
    Red

fn main() i32:
    let Maybe@(i32) m = Maybe.Some(1)
    println(m.or_err(nom Colour.Red).is_ok())
    return 0
