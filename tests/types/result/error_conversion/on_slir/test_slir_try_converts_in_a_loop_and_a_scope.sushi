# A `??` that converts in a loop with a `break`, and in a nested scope with an owning
# local. The `Err` path drops the locals of each scope that it leaves, then returns.
# EXPECT_STDOUT_EXACT: "ok 6\nerr AppError.Token(TokenError.Bad("token -1"))\nerr AppError.Token(TokenError.Bad("token -2"))\nok 0\n"
# EXPECT_NO_LEAKS
error TokenError:
    Bad(string)

error AppError:
    Token(TokenError)

extend TokenError as AppError:
    return AppError.Token(self)

fn tokenize(i32 n) i32 | TokenError:
    if (n < 0):
        return Result.Err(TokenError.Bad("token {n}"))
    return Result.Ok(n)

fn walk(i32[] xs) i32 | AppError:
    let string head = "walk"
    let i32 sum = 0
    foreach(x in xs.iter()):
        let string note = "at {x}"
        if (x == 99):
            break
        sum := sum + tokenize(x)?? + note.len() - note.len()
    return Result.Ok(sum + head.len() - head.len())

fn nested(i32 n) i32 | AppError:
    let i32 v = 0
    if (n != 0):
        let string inner = "inner {n}"
        while (true):
            let string step = "step"
            v := tokenize(n)?? + inner.len() - step.len()
            break
    return Result.Ok(v)

fn show(Result@(i32, AppError) r) ~:
    match r:
        Result.Ok(v) -> println("ok {v}")
        Result.Err(e) -> println("err {e}")

fn main() i32:
    show(walk(from([1, 2, 3, 99, -5])))
    show(walk(from([1, -1])))
    show(nested(-2))
    show(nested(0))
    return 0
