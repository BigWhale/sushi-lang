# Design 3.2 (C2) and 3.6: a generic function casts its `nom` operand with `as`. For one
# instance the cast calls the declared conversion. For the instance whose type argument
# is the target, the cast is an identity cast, and it moves the operand. Each string is
# freed one time.
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "AppError.Token(TokenError.Bad("t 1"))\nAppError.Note("n 2")\n"
error TokenError:
    Bad(string)

error AppError:
    Token(TokenError)
    Note(string)

extend TokenError as AppError:
    return AppError.Token(self)

fn wrap@(E)(nom E e) AppError:
    return e as AppError

fn main() i32:
    println(wrap(nom TokenError.Bad("t {1}")))
    println(wrap(nom AppError.Note("n {2}")))
    return 0
