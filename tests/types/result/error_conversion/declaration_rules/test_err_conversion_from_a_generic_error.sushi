# Design 3.6 (C6): the source of a conversion is a non-generic error type. An instance
# of a generic error type is refused as a source.
# EXPECT_ERROR_CODE: CE2520
# EXPECT_ERROR_CODES_EXACT: CE2520
error DecodeError@(T):
    BadByte(T)

error AppError:
    Decode

extend DecodeError@(i32) as AppError:
    return AppError.Decode

fn main() i32:
    return 0
