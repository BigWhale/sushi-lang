# Design 3.6 (C6): the target of a conversion is a non-generic error type. An instance
# of a generic error type is refused as a target.
# EXPECT_ERROR_CODE: CE2520
# EXPECT_ERROR_CODES_EXACT: CE2520
error LowError:
    Bad

error Wrap@(T):
    Held(T)
    Low

extend LowError as Wrap@(i32):
    return Wrap.Low

fn main() i32:
    return 0
