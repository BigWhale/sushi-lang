# Design 3.4 and 7: two declarations of one pair are the duplicate-function error, with
# a note at the first declaration.
# EXPECT_ERROR_CODES_EXACT: CE0101
# EXPECT_STDERR_CONTAINS: = note:
# EXPECT_STDERR_CONTAINS: test_err_conversion_declared_twice.sushi:13:
error LowError:
    Bad

error AppError:
    Low
    Other

extend LowError as AppError:
    return AppError.Low

extend LowError as AppError:
    return AppError.Other

fn main() i32:
    return 0
