# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "PASS: i32 works\nPASS: string works\nPASS: bool works\n"
# EXPECT_STDERR_EMPTY: true

# Tests Result@(T, E) with primitive types

fn test_i32() i32 | StdError:
    return Result.Ok(42)

fn test_string() string | StdError:
    return Result.Ok("Mostly Harmless")

fn test_bool() bool | StdError:
    return Result.Ok(true)

fn main() i32:
    match test_i32():
        Result.Ok(value) ->
            if (value == 42):
                println("PASS: i32 works")
            else:
                println("FAIL: i32 wrong value")
                return 1
        Result.Err(_) ->
            println("FAIL: i32 got error")
            return 1

    match test_string():
        Result.Ok(value) ->
            if (value == "Mostly Harmless"):
                println("PASS: string works")
            else:
                println("FAIL: string wrong value")
                return 1
        Result.Err(_) ->
            println("FAIL: string got error")
            return 1

    match test_bool():
        Result.Ok(value) ->
            if (value):
                println("PASS: bool works")
            else:
                println("FAIL: bool wrong value")
                return 1
        Result.Err(_) ->
            println("FAIL: bool got error")
            return 1

    return 0
