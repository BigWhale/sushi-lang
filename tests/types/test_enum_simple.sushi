# Simple enum test - unit variants

enum Color:
    Red
    Green
    Blue

fn test_color() Color:
    return Result.Ok(Color.Red())

fn main() i32:
    let Result@(Color, StdError) result = test_color()
    match result.realise(Color.Blue()):
        Color.Red -> return Result.Ok(0)
        Color.Green -> return Result.Ok(1)
        Color.Blue -> return Result.Ok(2)
