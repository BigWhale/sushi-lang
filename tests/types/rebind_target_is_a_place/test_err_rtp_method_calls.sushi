# The result of a method call is no place, so it cannot be rebound (#1284).
# EXPECT_ERROR_CODES_EXACT: CE2130, CE2130, CE2130
# EXPECT_STDERR_CONTAINS: "test_err_rtp_method_calls.sushi:13:5: error [CE2130]"
# EXPECT_STDERR_CONTAINS: "test_err_rtp_method_calls.sushi:14:5: error [CE2130]"
# EXPECT_STDERR_CONTAINS: "test_err_rtp_method_calls.sushi:15:5: error [CE2130]"
struct P:
    i32 x

fn main() i32:
    let i32[] a = from([1, 2, 3])
    let Maybe@(i32) m = Maybe.Some(1)
    let Own@(P) o = Own.alloc(P(1))
    a.len() := 3
    m.realise(0) := 1
    o.get() := P(2)
    return 0
