# Guard against CE2095 over-rejecting. A DYNAMIC `Node[]` is a heap buffer, so
# it is real indirection and the type is finite -- unlike the fixed `S[3]` in
# test_err_infinite_struct_fixed_array.sushi, which is stored inline.
#
# The two differ by one `isinstance` in the by-value cycle walk, so this pins the
# distinction: broaden that walk to cover DynamicArrayType and this test starts
# failing with CE2095.
#
# Widened from declaration-only to CONSTRUCTION by #257. The dynamic-array shape
# failed differently from the List one -- `TypeError: Can only insert
# {i32, i32, {}*} at [1] in {i32, {i32, i32, {}*}}` -- because the struct's own
# LLVM type had captured the empty `{}` placeholder while a freshly computed
# `Node[]` had the resolved element, so the two disagreed at the constructor.
# EXPECT_STDOUT_EXACT: "v=1 n=0\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true

struct Node:
    i32 value
    Node[] kids

fn main() i32:
    let Node root = Node(1, from([]))
    println("v={root.value} n={root.kids.len()}")
    return Result.Ok(0)
