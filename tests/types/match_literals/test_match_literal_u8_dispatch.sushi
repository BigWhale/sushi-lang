# Integer literal match on a u8 scrutinee (#415): the decoder tag-dispatch
# shape. The literals take the scrutinee's type, so 0xc0 is a u8 here.
# EXPECT_STDOUT_EXACT: "nil\nfalse\ntrue\nother\n"

fn tag_name(u8 t) string:
    match t:
        0xc0 ->
            return Result.Ok("nil")
        0xc2 ->
            return Result.Ok("false")
        0xc3 ->
            return Result.Ok("true")
        _ ->
            return Result.Ok("other")

fn run_test() i32:
    let u8[] tags = from([0xc0, 0xc2, 0xc3, 0x7f])
    let i32 i = 0
    while (i < tags.len()):
        println(tag_name(tags[i])??)
        i := i + 1
    return Result.Ok(0)

fn main() i32:
    let i32 r = run_test().realise(99)
    return Result.Ok(r)
