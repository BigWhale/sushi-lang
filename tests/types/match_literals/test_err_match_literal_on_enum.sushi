# A literal arm does not fit an enum scrutinee (#415).
# EXPECT_ERROR_CODE: CE2076

enum Color:
    Red()
    Green()

fn f(Color c) string:
    match c:
        1 ->
            return Result.Ok("one")
        _ ->
            return Result.Ok("other")

fn main() i32:
    let Color c = Color.Red()
    println(f(c).realise("err"))
    return Result.Ok(0)
