# Integer literal match arms across widths and radixes (#415): a u64 scrutinee
# with a full-width hex arm, a binary arm, and an octal arm; an i64 scrutinee
# with the i64 minimum.
# EXPECT_STDOUT_EXACT: "max\nfive\neight\nother\ni64 min\nother\n"

fn wide(u64 v) string:
    match v:
        0xffff_ffff_ffff_ffff ->
            return "max"
        0b101 ->
            return "five"
        0o10 ->
            return "eight"
        _ ->
            return "other"

fn low(i64 v) string:
    match v:
        -9223372036854775808 ->
            return "i64 min"
        _ ->
            return "other"

fn main() i32:
    println(wide(18446744073709551615))
    println(wide(5))
    println(wide(8))
    println(wide(0))
    println(low(-9223372036854775808))
    println(low(1))
    return 0
