# Integer literal match arms across widths and radixes (#415): a u64 scrutinee
# with a full-width hex arm, a binary arm, and an octal arm; an i64 scrutinee
# with the i64 minimum.
# EXPECT_STDOUT_EXACT: "max\nfive\neight\nother\ni64 min\nother\n"

fn wide(u64 v) string:
    match v:
        0xffff_ffff_ffff_ffff ->
            return Result.Ok("max")
        0b101 ->
            return Result.Ok("five")
        0o10 ->
            return Result.Ok("eight")
        _ ->
            return Result.Ok("other")

fn low(i64 v) string:
    match v:
        -9223372036854775808 ->
            return Result.Ok("i64 min")
        _ ->
            return Result.Ok("other")

fn main() i32:
    println(wide(18446744073709551615).realise("err"))
    println(wide(5).realise("err"))
    println(wide(8).realise("err"))
    println(wide(0).realise("err"))
    println(low(-9223372036854775808).realise("err"))
    println(low(1).realise("err"))
    return Result.Ok(0)
