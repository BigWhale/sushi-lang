# A field read whose receiver is a struct CONSTRUCTION compiles
#
# The other half of #624: a `Call` had no arm either, so `Point(7, 3).y` was CE0067.
# EXPECT_STDOUT_EXACT: "3\n"
# EXPECT_RUNTIME_EXIT: 0

struct Point:
    i32 x
    i32 y

fn main() i32:
    let i32 v = Point(7, 3).y
    println("{v}")
    return Result.Ok(0)
