# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "25\n"

# Returning structs from functions

struct Point:
    i32 x
    i32 y

fn make_point(i32 x, i32 y) Point:
    return Point(x, y)

fn main() i32:
    let Point p = make_point(10, 15)
    let i32 result = p.x + p.y
    println(result)
    return 0
