# Error: Accessing non-existent field
# The code moved from CE0029 to CE2106 with #630: the fault is a typo, so the
# typecheck pass answers it at the read instead of letting it reach the backend.
# EXPECT_ERROR_CODE: CE2106

struct Point:
    i32 x
    i32 y

fn main() i32:
    let Point p = Point(10, 20)
    print(p.z)
    return Result.Ok(0)
