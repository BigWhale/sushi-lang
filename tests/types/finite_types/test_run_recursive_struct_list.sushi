# A struct whose self-reference goes through `List@(T)` (#240). The List owns a
# heap buffer, so the indirection is real and the type is finite -- but declaring
# it was a `CE0000` RecursionError, same as the `Own@(T)` shapes, because the
# cycle was in the struct-field walk and not in any particular wrapper. This is a
# third distinct resolution path (a generic STRUCT type argument, where
# `Maybe@(Own@(T))` goes through a generic enum), so it is worth pinning
# separately.
#
# Widened from declaration-only to CONSTRUCTION by #257, which fixed the two
# backend defects behind `Tree(1, List.new())`: the struct's LLVM type was a
# LiteralStructType placeholder that could never be back-filled (so the element
# stayed the incomplete `{}*`), and the out-of-line destructor's element loop was
# emitted through the ambient builder into the wrong function.
# EXPECT_STDOUT_EXACT: "v=1 n=0\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true

struct Tree:
    i32 value
    List@(Tree) kids

fn main() i32:
    let Tree root = Tree(1, List.new())
    println("v={root.value} n={root.kids.len()}")
    return Result.Ok(0)
