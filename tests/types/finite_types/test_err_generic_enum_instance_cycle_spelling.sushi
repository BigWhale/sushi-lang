# The enum twin: a generic enum whose payload is its own instantiation. The caret
# stands at the template and the name reads in the surface spelling (#700).
# EXPECT_ERROR_CODE: CE2095
# EXPECT_STDERR_CONTAINS: recursive type 'Tree@(i32)'
# EXPECT_STDERR_CONTAINS: Tree@(i32) refers to Tree@(i32)
# EXPECT_STDERR_CONTAINS: test_err_generic_enum_instance_cycle_spelling.sushi:8:6

enum Tree@(T):
    Leaf(T)
    Node(Tree@(T))

fn main() i32:
    let Tree@(i32) t = Tree.Leaf(1)
    match t:
        Tree.Leaf(v) -> return Result.Ok(v)
        Tree.Node(_) -> return Result.Ok(0)
