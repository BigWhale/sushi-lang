# A List@(T) of dynamic arrays hashes each element as an array: equal elements give equal
# hashes, and a changed element changes the hash. The element copy of the value hash used
# to refuse an array (CE0052).
# EXPECT_STDOUT_EXACT: "same=true\ndifferent=false\n"
# EXPECT_NO_LEAKS

fn main() i32:
    let List@(i32[]) a = List.new()
    a.push(from([1, 2]))
    let List@(i32[]) b = List.new()
    b.push(from([1, 2]))
    let List@(i32[]) c = List.new()
    c.push(from([1, 3]))
    println("same={a.hash() == b.hash()}")
    println("different={a.hash() == c.hash()}")
    return Result.Ok(0)
