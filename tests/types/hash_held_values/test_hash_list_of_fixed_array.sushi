# A List@(T) of fixed arrays hashes each element as an array.
# EXPECT_STDOUT_EXACT: "same=true\ndifferent=false\n"
# EXPECT_NO_LEAKS

fn main() i32:
    let List@(i32[3]) a = List.new()
    a.push([1, 2, 3])
    let List@(i32[3]) b = List.new()
    b.push([1, 2, 3])
    let List@(i32[3]) c = List.new()
    c.push([1, 2, 4])
    println("same={a.hash() == b.hash()}")
    println("different={a.hash() == c.hash()}")
    return Result.Ok(0)
