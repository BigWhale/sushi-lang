# The override makes a holder of F hashable, so the HashMap key rule no longer refuses
# the key for its hash (CE2054). It refuses it for its EQUALITY (CE2055): the probe
# compares two keys field by field, and a function value has no equality.
# EXPECT_ERROR_CODE: CE2055
# EXPECT_STDERR_CONTAINS: "does not support equality comparison"

use <collections/hashmap>

struct F:
    fn(i32) -> i32 f
    i32 n

extend F with Hashable:
    fn hash() u64:
        return self.n as u64

struct H:
    F inner

fn main() i32:
    let HashMap@(H, i32) m = HashMap.new()
    m.insert(H(F(|i32 x| x + 1, 5)), 42)
    println("found {m.get(H(F(|i32 x| x * 2, 5))).realise(0)}")
    m.free()
    return Result.Ok(0)
