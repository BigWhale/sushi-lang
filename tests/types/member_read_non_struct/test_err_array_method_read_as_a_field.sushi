# A built-in method is not a field. The read is refused and the note says what the
# name actually is, exactly as the struct receiver answers (#630, #661).
# EXPECT_ERROR_CODE: CE2106
# EXPECT_STDERR_CONTAINS: is a method, not a field
fn main() i32:
    let i32[] rows = from([1, 2, 3])
    let i32 v = rows.extend
    println("{v}")
    return Result.Ok(0)
