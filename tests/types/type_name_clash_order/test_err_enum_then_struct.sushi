# An enum and a struct share one type name, and source order decides (#1069).
# The enum is first, so it holds the name; the struct is the error, with a
# note at the enum.
# EXPECT_ERROR_CODES_EXACT: CE0006
# EXPECT_STDERR_CONTAINS: :13:8: error [CE0006]: struct 'Box' already defined as enum
# EXPECT_STDERR_CONTAINS: already defined as an enum here
# EXPECT_STDERR_CONTAINS: :9:6

enum Box:
    Big
    Huge

struct Box:
    i32 w

fn main() i32:
    return Result.Ok(0)
