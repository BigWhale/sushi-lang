
# Issue #140: a HashMap can hold a struct value with a `T[]` field -- `insert` MOVES a named
# owning local in, and `free` destroys the entry exactly once.
# https://github.com/BigWhale/sushi-lang/issues/140
#
# The read is a BORROW since #242, so the get-out is bound and read in place rather than
# passed by value to a helper (that would be CE2411 -- a second owner of the map's entry).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "3\n"
# EXPECT_NO_LEAKS: true

use <collections/hashmap>

struct Items:
    i32[] data

fn run() i32:
    let HashMap@(i32, Items) map = HashMap.new()
    let i32[] xs = from([1, 2, 3])
    let Items it = Items(xs)      # named owning local -> insert must MOVE it (no double-free)
    map.insert(7, it)
    let i32 out = -2
    match map.get(7):
        Maybe.Some(found) ->
            out := found.data.len()
        Maybe.None ->
            out := -2
    map.free()
    return Result.Ok(out)

fn main() i32:
    println(run().realise(0))
    return Result.Ok(0)
