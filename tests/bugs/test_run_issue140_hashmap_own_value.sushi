
# Issue #140: a HashMap can hold an `Own@(T)` value -- `insert` MOVES a named owning local
# in, and `free` destroys the entry exactly once.
# https://github.com/BigWhale/sushi-lang/issues/140
#
# The read is a BORROW since #242, so the get-out is bound and read in place rather than
# passed by value to a helper. Passing it by value would hand the callee a second owner of
# the map's entry, which is CE2411.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "99\n"
# EXPECT_NO_LEAKS: true

use <collections/hashmap>

fn run() i32:
    let HashMap@(i32, Own@(i32)) map = HashMap.new()
    let Own@(i32) boxed = Own.alloc(99)   # named owning Own local -> insert must MOVE it
    map.insert(3, boxed)
    let i32 out = -2
    match map.get(3):
        Maybe.Some(o) ->
            out := o.get()
        Maybe.None ->
            out := -2
    map.free()
    return Result.Ok(out)

fn main() i32:
    println(run().realise(0))
    return Result.Ok(0)
