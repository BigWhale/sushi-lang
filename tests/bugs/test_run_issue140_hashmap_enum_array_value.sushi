
# Issue #140: a HashMap can hold an enum value with a `T[]` payload -- the enum constructor
# MOVES the named array in, and `free` destroys the entry exactly once.
# https://github.com/BigWhale/sushi-lang/issues/140
#
# The read is a BORROW since #242, so the get-out is bound and read in place rather than
# passed by value to a helper (that would be CE2411 -- a second owner of the map's entry).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "3\n"
# EXPECT_NO_LEAKS: true

use <collections/hashmap>

enum Status:
    Active
    Items(i32[])

fn run() i32:
    let HashMap@(i32, Status) map = HashMap.new()
    let i32[] xs = from([10, 20, 30])   # enum constructor must MOVE this named array arg
    map.insert(1, Status.Items(xs))
    let i32 out = -2
    match map.get(1):
        Maybe.Some(s) ->
            match s:
                Status.Items(arr) ->
                    out := arr.len()
                Status.Active ->
                    out := -1
        Maybe.None ->
            out := -2
    map.free()
    return Result.Ok(out)

fn main() i32:
    println(run().realise(0))
    return Result.Ok(0)
