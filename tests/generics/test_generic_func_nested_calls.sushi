# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0

# Test: Nested generic function calls
fn identity@(T)(nom T x) T:
    return Result.Ok(x)

fn wrap@(U)(nom U y) U:
    let U result = identity(nom y)??
    return Result.Ok(result)

fn double_wrap@(V)(nom V z) V:
    let V result = wrap(nom z)??
    return Result.Ok(result)

fn run_test() i32:
    # Test deeply nested calls with i32
    let i32 a = double_wrap(nom 42)??
    if (a != 42):
        return Result.Ok(1)

    # Test with string
    let string s = double_wrap(nom "test")??
    if (s != "test"):
        return Result.Ok(2)

    # Test with bool
    let bool b = double_wrap(nom true)??
    if (not b):
        return Result.Ok(3)

    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
