# Two generic T[] extensions chained in the iterable of a foreach (#1143).
# EXPECT_STDOUT_EXACT: "10\n20\n10\n20\n"
# EXPECT_NO_LEAKS
extend T[] twice() T[]:
    let T[] out = new()
    foreach(x in self.iter()):
        out.push(x.clone())
    foreach(x in self.iter()):
        out.push(x.clone())
    return out

extend T[] listed() List@(T):
    let List@(T) out = List.new()
    foreach(x in self.iter()):
        out.push(x.clone())
    return out

fn main() i32:
    let i32[] scores = from([10, 20])
    foreach(p in scores.twice().listed().iter()):
        println("{p}")
    return 0
