# The same rule for a `Maybe@(T)` payload (#801).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "42\n"

enum Wrap@(T):
    One(Maybe@(T))
    Zero

fn first@(U)(Maybe@(U) m, U fallback) U:
    return m.realise(fallback)

fn main() i32:
    let Maybe@(i32) m = Maybe.Some(42)
    let Wrap@(i32) w = Wrap.One(m)
    match w:
        Wrap.One(v) -> println(first(v, 0))
        Wrap.Zero -> println(0)
    return 0
