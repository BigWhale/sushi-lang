# A generic function that recurses with the same type argument has one copy.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "3\n"
fn count_down@(U)(nom U x, i32 n) i32:
    if (n == 0):
        return 0
    return count_down(nom x, n - 1) + 1

fn main() i32:
    println(count_down(nom 1, 3))
    return 0
