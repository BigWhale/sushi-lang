# A method-level type argument that grows through the body of its own method. Each
# copy names a new copy with a larger type argument, so the chain has no end.
# EXPECT_ERROR_CODES_EXACT: CE0151
# EXPECT_STDERR_CONTAINS: test_err_method_type_argument_grows.sushi:12:12: error [CE0151]
# EXPECT_STDERR_CONTAINS: test_err_method_type_argument_grows.sushi:16:13
struct Box@(T):
    T v

extend Box@(T) grow@(U)(nom U x, i32 n) i32:
    if (n == 0):
        return 0
    return self.grow(nom Box(x), n - 1) + 1

fn main() i32:
    let Box@(i32) b = Box(0)
    println(b.grow(nom 1, 3))
    return 0
