# A method-level type parameter that recurses with the same type argument has one copy.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "3\n"
struct Box@(T):
    T v

extend Box@(T) count_down@(U)(nom U x, i32 n) i32:
    if (n == 0):
        return 0
    return self.count_down(nom x, n - 1) + 1

fn main() i32:
    let Box@(i32) b = Box(0)
    println(b.count_down(nom 1, 3))
    return 0
