# A generic function that calls itself with a written type argument. The chain has
# two copies, wrap@(i32) and wrap@(Box@(i32)), and it ends.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "5\n5\n5\n1\n"
struct Box@(T):
    T v

fn wrap@(U)(nom U x, i32 n) U:
    if (n > 0):
        let Box@(i32) inner = wrap(nom Box(5), n - 1)
        println(inner.v)
    return x

fn main() i32:
    println(wrap(nom 1, 3))
    return 0
