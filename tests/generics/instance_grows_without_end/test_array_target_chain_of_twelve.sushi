# A chain of twelve extend T[] methods, each one calls the next. Each copy is cut
# at the call site, and the chain makes no new type, so every copy is cut.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "11\n"
extend T[] a1() i32:
    return self.a2() + 1

extend T[] a2() i32:
    return self.a3() + 1

extend T[] a3() i32:
    return self.a4() + 1

extend T[] a4() i32:
    return self.a5() + 1

extend T[] a5() i32:
    return self.a6() + 1

extend T[] a6() i32:
    return self.a7() + 1

extend T[] a7() i32:
    return self.a8() + 1

extend T[] a8() i32:
    return self.a9() + 1

extend T[] a9() i32:
    return self.a10() + 1

extend T[] a10() i32:
    return self.a11() + 1

extend T[] a11() i32:
    return self.a12() + 1

extend T[] a12() i32:
    return 0

fn main() i32:
    let i32[] xs = from([1, 2, 3])
    println(xs.a1())
    return 0
