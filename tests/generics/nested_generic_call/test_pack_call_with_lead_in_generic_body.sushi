# A variadic generic with a leading type parameter, called inside a generic body. A
# hole needs `Display`, so both templates constrain the parameter they print or pass
# on (#1070).
# EXPECT_STDOUT_EXACT: "42 2\ns 2\n"
# EXPECT_RUNTIME_EXIT: 0

fn lead_and_rest@(H: Display, ...Ts)(H head, ...Ts rest) i32:
    println("{head} 2")
    return 2

fn outer@(T: Display)(T x) i32:
    let i32 n = lead_and_rest(x, "a", x)
    return n

fn main() i32:
    outer(42)
    outer("s")
    return 0
