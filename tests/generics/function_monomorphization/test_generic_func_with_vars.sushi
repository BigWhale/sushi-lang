# Test generic functions using type parameters in variable declarations
# This tests body substitution where T appears in let statements

fn create_pair@(T: Clone)(nom T first, nom T second) T:
    # Variable declaration with generic type - use both params
    let T result = first.clone()
    # Copy second to temp and back to ensure both are used
    let T temp = second
    result := temp
    result := first
    return result

fn compute@(T)(nom T value) T:
    # Multiple variable declarations with generic type
    let T a = value
    let T b = a
    let T c = b
    return c

fn run_test() i32:
    # Test with i32
    let i32 num1 = create_pair(nom 10, nom 20)
    let i32 num2 = compute(nom 42)

    # Test with string (still need to call to ensure monomorphization)
    if (create_pair(nom "hello", nom "world") == ""):
        return 10
    if (compute(nom "test") == ""):
        return 11

    # Verify values are correct
    if (num1 != 10):
        return 1
    if (num2 != 42):
        return 2

    return 0

fn main() i32:
    let i32 result = run_test()
    return result
