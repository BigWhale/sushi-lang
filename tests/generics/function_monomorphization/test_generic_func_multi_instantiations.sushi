# Test same generic function instantiated with many different types
# This ensures monomorphization creates separate versions correctly

fn triple@(T)(nom T value) T:
    # Just return the value (simplified version)
    return value

fn run_test() i32:
    # Instantiate with i32
    let i32 v1 = triple(nom 42)
    if (v1 != 42):
        return 1

    # Instantiate with i64
    let i64 v2 = triple(nom 100 as i64)
    if (v2 != 100 as i64):
        return 2

    # Instantiate with i8
    let i8 v3 = triple(nom 10 as i8)
    if (v3 != 10 as i8):
        return 3

    # Instantiate with u32
    let u32 v4 = triple(nom 200 as u32)
    if (v4 != 200 as u32):
        return 4

    # Instantiate with u64
    let u64 v5 = triple(nom 300 as u64)
    if (v5 != 300 as u64):
        return 5

    # Instantiate with f64
    let f64 v6 = triple(nom 3.14)
    if (v6 < 3.13 or v6 > 3.15):
        return 6

    # Instantiate with string
    if (triple(nom "test") == ""):
        return 10

    # Call again with already-instantiated types to verify they work
    let i32 v8 = triple(nom 999)
    if (v8 != 999):
        return 7

    # Another string call
    if (triple(nom "again") == ""):
        return 11

    return 0

fn main() i32:
    let i32 result = run_test()
    return result
