# Test complex type name mangling for generic functions
# Struct types should be included in mangled names

struct Point:
    i32 x
    i32 y

struct Box:
    i32 value

perk Numbered:
    fn number() i32

extend Point with Numbered:
    fn number() i32:
        return self.x

extend Box with Numbered:
    fn number() i32:
        return self.value

fn process_point@(T: Numbered)(T value) i32:
    # Read a number to use the value
    let i32 x = value.number()
    return x

fn process_box@(T: Numbered)(T value) i32:
    # Read a number to use the value
    let i32 v = value.number()
    return v

fn run_test() i32:
    let Point p = Point(10, 20)
    let Box b = Box(100)

    # Call process with Point struct - should monomorphize to process_point__Point
    let i32 result1 = process_point(p)
    if (result1 != 10):
        return 1

    # Call process with Box struct - should monomorphize to process_box__Box
    let i32 result2 = process_box(b)
    if (result2 != 100):
        return 2

    return 0

fn main() i32:
    let i32 result = run_test()
    return result
