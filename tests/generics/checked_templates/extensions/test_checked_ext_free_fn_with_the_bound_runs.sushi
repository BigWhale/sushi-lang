# A function template whose parameter promises the bound may call a bounded extension
# (#1070).
# EXPECT_STDOUT_EXACT: "2\n"
# EXPECT_NO_LEAKS: true

extend List@(T: Clone) dup_first() List@(T):
    let List@(T) out = List.new()
    foreach(x in self.iter()):
        out.push(x.clone())
        out.push(x.clone())
        return out
    return out

fn dup_all@(T: Clone)(List@(T) xs) List@(T):
    return xs.dup_first()

fn main() i32:
    let List@(string) xs = List.new()
    xs.push("towel")
    println(dup_all(xs).len())
    return 0
