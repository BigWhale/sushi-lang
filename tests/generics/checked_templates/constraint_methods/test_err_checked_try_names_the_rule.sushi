# `??` on a Result whose error type is a type parameter: the help gives the rule, and
# names no conversion to declare, because no conversion can name a type parameter
# (#1070, R8).
# EXPECT_ERROR_CODES_EXACT: CE2511
# EXPECT_STDERR_CONTAINS: "a type parameter has no conversion, so only the same error type propagates"

fn unwrap@(E)(Result@(i32, E) r) i32 | StdError:
    return Result.Ok(r??)

fn main() i32:
    println("Mostly Harmless")
    return 0
