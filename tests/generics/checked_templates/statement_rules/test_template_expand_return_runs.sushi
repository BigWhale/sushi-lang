# A `return` inside an `expand` runs: the first element answers. The `expand` may run
# zero times, as a loop may, so the template ends with a `return` after it (#1070).
# EXPECT_STDOUT_EXACT: "1\n"

fn first@(...Ts: Display)(...Ts args) string:
    expand(a in args):
        return "{a}"
    return "none"

fn main() i32:
    println(first(1, 2))
    return 0
