# A `return` that does not spell `Result.Ok(...)` or `Result.Err(...)` in a
# generic-target extension template with a channel is CE2030 at the template, also
# when no call instantiates it (#1070).
# EXPECT_ERROR_CODES_EXACT: CE2030

struct Box@(T):
    T item

extend Box@(T) size() i32 | StdError:
    return 1

fn main() i32:
    println("Mostly Harmless")
    return 0
