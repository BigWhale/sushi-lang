# A statement after a `return` in a method of a perk implementation on a generic
# target is CE0140 at the template, also when no call instantiates it (#1070).
# EXPECT_ERROR_CODES_EXACT: CE0140

perk Sized:
    fn size() i32

struct Box@(T):
    T item

extend Box@(T) with Sized:
    fn size() i32:
        return 1
        println("dead")

fn main() i32:
    println("Mostly Harmless")
    return 0
