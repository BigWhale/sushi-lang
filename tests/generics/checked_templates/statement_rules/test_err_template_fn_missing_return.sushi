# A generic function template whose body can reach its end with no `return` is CE0107
# at the template, also when no call instantiates it (#1070).
# EXPECT_ERROR_CODES_EXACT: CE0107

fn pick@(T)(nom T item, bool keep) T:
    if (keep):
        return item

fn main() i32:
    println("Mostly Harmless")
    return 0
