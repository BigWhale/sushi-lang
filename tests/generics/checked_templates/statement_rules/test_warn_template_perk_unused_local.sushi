# A local that a method of a perk implementation on a generic target never reads is
# CW1001 at the template, once, also when no call instantiates it (#1070).
# EXPECT_ERROR_CODES_EXACT: CW1001
# EXPECT_STDERR_CONTAINS: :14:9: warning [CW1001]: unused variable 'spare'.

perk Sized:
    fn size() i32

struct Box@(T):
    T item

extend Box@(T) with Sized:
    fn size() i32:
        let i32 spare = 1
        return 1

fn main() i32:
    println("Mostly Harmless")
    return 0
