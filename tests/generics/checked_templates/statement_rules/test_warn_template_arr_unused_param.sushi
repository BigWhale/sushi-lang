# A parameter that a `T[]` extension template never reads is CW1001 at the template,
# and the text names a parameter (#1070).
# EXPECT_ERROR_CODES_EXACT: CW1001
# EXPECT_STDERR_CONTAINS: :6:21: warning [CW1001]: unused parameter 'spare'.

extend T[] size(i32 spare) i32:
    return self.len()

fn main() i32:
    println("Mostly Harmless")
    return 0
