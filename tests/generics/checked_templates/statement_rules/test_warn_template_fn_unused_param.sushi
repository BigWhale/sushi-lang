# A parameter that a generic function template never reads is CW1001 at the template,
# and the text names a parameter, not a variable (#1070).
# EXPECT_ERROR_CODES_EXACT: CW1001
# EXPECT_STDERR_CONTAINS: :6:29: warning [CW1001]: unused parameter 'spare'.

fn pick@(T)(nom T item, i32 spare) T:
    return item

fn main() i32:
    println("Mostly Harmless")
    return 0
