# A constraint the caller's argument breaks is reported at the call, and the template
# body adds nothing (#1070): it promises `Hashable`, and a struct that holds a function
# value has no hash.
# EXPECT_ERROR_CODES_EXACT: CE4006

struct Handler:
    fn(i32) -> i32 f

fn digest@(T: Hashable)(T x) u64:
    return x.hash()

fn main() i32:
    let Handler h = Handler(|i32 n| n + 1)
    println(digest(h))
    return 0
