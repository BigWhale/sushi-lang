# A generic function written as a value in a template passes the template's type
# parameter on: the value's constraint must be one the parameter promises (#1070).
# `outer` is never called.
# EXPECT_ERROR_CODES_EXACT: CE4006

fn hasher@(U: Hashable)(U x) u64:
    return x.hash()

fn outer@(T)(T x) u64:
    let fn(T) -> u64 g = hasher
    return g(x)

fn main() i32:
    println("Mostly Harmless")
    return 0
