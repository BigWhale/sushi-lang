# A lambda parameter of a type parameter is checked per instance for the owning-type
# rule (#1070, R7): the template does not know whether `T` owns. With `i32` it does not.
# EXPECT_STDOUT_EXACT: "5\n"

fn apply@(T)(T x, fn(T) -> T f) T:
    let fn(T) -> T same = |T y| y
    return f(same(x))

fn main() i32:
    println(apply(4, |i32 n| n + 1))
    return 0
