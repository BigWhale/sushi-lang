# An array perk template is checked where it is written (#1070): `==` on two elements
# needs `Eq`.
# EXPECT_ERROR_CODES_EXACT: CE2514

perk Same:
    fn same() bool

extend T[] with Same:
    fn same() bool:
        return self[0] == self[1]

fn main() i32:
    println("Mostly Harmless")
    return 0
