# The help of a refused move in a template keeps the constraints that `T` already has
# (#1070, R5): it adds 'Clone' to them.
# EXPECT_ERROR_CODES_EXACT: CE2411
# EXPECT_STDERR_CONTAINS: '@(T: Hashable + Eq + Clone)'

use <collections/hashmap>

fn count@(T: Hashable + Eq)(T k) i32:
    let HashMap@(T, i32) m = HashMap.new()
    m.insert(k, 1)
    let i32 n = m.len()
    m.free()
    return n

fn main() i32:
    println(count(3))
    return 0
