# E3 at a method-level type argument stays per instance (#1070, R8): the template hands
# its `E` to a method whose `E` is an error type, and the copy for `i32` reports it.
# EXPECT_ERROR_CODES_EXACT: CE2084

struct Tag:
    i32 n

extend Tag fail@(E)(nom E e) i32 | E:
    return Result.Err(e)

fn outer@(E)(nom E e) i32:
    return Tag(1).fail(nom e).realise(0)

fn main() i32:
    println(outer(nom 5))
    return 0
