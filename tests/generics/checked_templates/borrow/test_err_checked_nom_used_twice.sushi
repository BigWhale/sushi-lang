# A template is borrow-checked where it is written (#1070, R5): an opaque `T` moves, so
# a second hand-over of `a` is a use after the move, even with no call of the template.
# EXPECT_ERROR_CODES_EXACT: CE2405

fn keep@(T: Display)(nom T x) i32:
    println("{x}")
    return 1

fn twice@(T: Display)(nom T a) i32:
    let i32 n = keep(nom a)
    let i32 m = keep(nom a)
    return n + m

fn main() i32:
    println("Mostly Harmless")
    return 0
