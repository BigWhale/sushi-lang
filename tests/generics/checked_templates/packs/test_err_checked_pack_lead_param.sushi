# The lead parameters of a pack template are opaque too, and the template is checked
# where it is written: a hole needs `Display` (#1070).
# EXPECT_ERROR_CODES_EXACT: CE2035

fn f@(H, ...Ts)(H h, ...Ts r) ~:
    println("{h}")
    expand(_ in r):
        println("Mostly Harmless")

fn main() i32:
    println("Mostly Harmless")
    return 0
