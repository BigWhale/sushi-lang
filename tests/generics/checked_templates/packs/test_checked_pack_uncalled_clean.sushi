# A correct pack template that no call instantiates checks clean where it is written
# (#1070): a lead parameter, a method through a constraint, a hole, a Maybe, a tuple and
# its destructure, an array, a lambda that captures the element, a `??`, a `foreach`
# with a `??` binder, a nested `expand` and a call of another pack template with an
# element. Each `expand` binds an opaque element type, and no instance over one reaches
# the backend.
# EXPECT_STDOUT_EXACT: "Mostly Harmless\n"
# EXPECT_STDERR_EMPTY: true

perk Render:
    fn render() string

struct Steps:
    i32 n

extend Steps next(poke self) Maybe@(Result@(i32, StdError)):
    if (self.n >= 3):
        return Maybe.None
    self.n := self.n + 1
    return Maybe.Some(Result.Ok(self.n))

fn count_all@(...Us: Render)(...Us items) i32:
    let i32 n = 0
    expand(item in items):
        if (item.render() != ""):
            n := n + 1
    return n

fn checked@(U: Render)(U x) i32 | StdError:
    if (x.render() == ""):
        return Result.Err(StdError.Error)
    return Result.Ok(1)

fn shapes@(T: Display, ...Ts: Render + Display)(T head, ...Ts args) i32 | StdError:
    println("{head}")
    let i32 total = 0
    expand(a in args):
        println(a.render())
        println("{a}")
        match Maybe.Some(a):
            Maybe.Some(m) -> println(m.render())
            Maybe.None -> println("none")
        let (x, n) = (a, 1)
        println(x.render())
        total := total + n + from([a]).len()
        let fn() -> string f = |~| a.render()
        println(f())
        total := total + checked(a)??
        foreach(step?? in Steps(0)):
            total := total + step
        expand(b in args):
            println("{a}{b}")
        total := total + count_all(a, a)
    return Result.Ok(total)

fn main() i32:
    println("Mostly Harmless")
    return 0
