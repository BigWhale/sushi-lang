# An element of a pack is opaque, so a parameter of a concrete type does not take it
# (#1070, R6).
# EXPECT_ERROR_CODES_EXACT: CE2006

fn eat(nom string s) ~:
    println(s)

fn feed@(...Ts: Display)(...Ts args) ~:
    expand(a in args):
        eat(nom a)

fn main() i32:
    println("Mostly Harmless")
    return 0
