# F8 (fixed 2026-08-14): Pass 1.5 collects an instantiation from a non-Name argument.
# `f(p.clone())` is the argument shape the clone idiom produces; the collector's
# argument inference falls back to the receiver's type for `.clone()` (clone returns
# its receiver's type by definition, and the interned instance does not exist until
# Pass 1.6, so Pass 2's clone inference cannot answer at collection time).
# This file replaces the CE2061 known-hole pin test_err_infer_from_non_name_arg.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "42\n"
# EXPECT_NO_LEAKS: true

struct Pair@(T, U):
    T first
    U second

fn get_first@(A, B)(Pair@(A, B) p) A:
    return Result.Ok(p.first.clone())

fn run() i32:
    let Pair@(i32, string) p = Pair(42, "test")
    let i32 first = get_first(p.clone())??
    println(first)
    return Result.Ok(first)

fn main() i32:
    let i32 rc = run().realise(99)
    if (rc == 42):
        return Result.Ok(0)
    return Result.Ok(1)
