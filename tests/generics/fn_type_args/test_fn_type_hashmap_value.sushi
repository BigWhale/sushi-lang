# A function type as the VALUE of a HashMap: its parameter list holds a comma (#794).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "1\n5\n"
use <collections/hashmap>

fn add(i32 a, i32 b) i32:
    return a + b

fn main() i32:
    let HashMap@(string, fn(i32, i32) -> i32) m = HashMap.new()
    m.insert("add", add)
    println("{m.len()}")
    match m.get("add"):
        Maybe.Some(f) -> println("{f(2, 3)}")
        Maybe.None -> println("none")
    m.free()
    return 0
