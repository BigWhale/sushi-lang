# A List of a function type whose own parameter is a function type (#794).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "1\n14\n"

fn twice(i32 x) i32:
    return x * 2

fn apply(fn(i32) -> i32 f, i32 x) i32:
    return f(x)

fn main() i32:
    let List@(fn(fn(i32) -> i32, i32) -> i32) l = List.new()
    l.push(apply)
    println("{l.len()}")
    match l.get(0):
        Maybe.Some(g) -> println("{g(twice, 7)}")
        Maybe.None -> println("none")
    return 0
