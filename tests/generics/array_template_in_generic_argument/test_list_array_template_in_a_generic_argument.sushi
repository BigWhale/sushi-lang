# An array template that answers a List, with a foreach and an equality on the element
# in its body, called inside the argument of a generic call (#1161).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "7\n"

struct P:
    i32 x

extend (T: Eq + Clone)[] collect() List@(T):
    let List@(T) out = List.new()
    foreach(e in self.iter()):
        if (e == e):
            out.push(e.clone())
    return out

fn k@(T: Hashable)(T x) i32:
    return 7 + (x.hash() * 0) as i32

fn main() i32:
    let P[] ps = from([P(3)])
    println(k(ps.collect()))
    return 0
