# An array template called inside the argument of a generic call is checked with the
# resolved element type (#1161).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "7\n"

struct P:
    i32 x

extend (T: Display)[] firsts() string:
    return "{self[0]}"

fn k@(T: Hashable)(T x) i32:
    return 7 + (x.hash() * 0) as i32

fn main() i32:
    let P[] ps = from([P(3)])
    println(k(ps.firsts()))
    return 0
