# A wrong type-argument count in a generic function's return is refused where it is
# written, with no instance of the function (#807).
# EXPECT_ERROR_CODE: CE2062
# EXPECT_STDERR_CONTAINS: test_err_template_arity_fn_return.sushi:9:18: error [CE2062]
struct Box@(T, U):
    T a
    U b

fn make@(T)(T v) Box@(T, T, T):
    return Result.Ok(Box(v, v))

fn main() i32:
    return Result.Ok(0)
