# A wrong type-argument count in a generic enum's payload is refused where it is
# written, with no instance of the enum (#807).
# EXPECT_ERROR_CODE: CE2062
# EXPECT_STDERR_CONTAINS: test_err_template_arity_enum_payload.sushi:10:5: error [CE2062]
struct Box@(T, U):
    T a
    U b

enum Slot@(T):
    Full(Box@(T))
    Empty

fn main() i32:
    return Result.Ok(0)
