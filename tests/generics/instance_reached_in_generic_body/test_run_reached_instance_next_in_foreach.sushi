# `Feed@(string)` is named only by the return type of `feed_of@(T)`, called from
# `count@(T)` with `T = string`. The instance is an instance like one that `main` writes,
# so its `next()` signature names a known `Maybe@(Result@(string, Bad))` (#1146).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "2\n"

error Bad:
    Oops

struct Feed@(T):
    T[] items
    i32 at

extend Feed@(T: Clone) next(poke self) Maybe@(Result@(T, Bad)):
    let i32 at = self.at
    self.at := self.at + 1
    match self.items.get(at):
        Maybe.Some(v) -> return Maybe.Some(Result.Ok(v.clone()))
        Maybe.None -> return Maybe.None

fn feed_of@(T)(nom T[] items) Feed@(T):
    return Feed(items, 0)

fn count@(T: Clone)(nom T[] items) i32:
    let i32 n = 0
    foreach(_ in feed_of(nom items)):
        n := n + 1
    return n

fn main() i32:
    println(count(nom from(["a", "b"])))
    return 0
