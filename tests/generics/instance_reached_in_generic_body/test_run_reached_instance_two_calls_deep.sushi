# The instance is reached two generic calls deep: `count@(T)` calls `walk@(T)`, which
# calls `feed_of@(T)`. Every method of `Feed@(string)` gets a signature of known types,
# the one that no call names too (#1146).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "Arthur\nFord\n2\n"

error Bad:
    Oops

struct Feed@(T):
    T[] items
    i32 at

extend Feed@(T) next(poke self) Maybe@(Result@(T, Bad)):
    let i32 at = self.at
    self.at := self.at + 1
    match self.items.get(at):
        Maybe.Some(v) -> return Maybe.Some(Result.Ok(v.clone()))
        Maybe.None -> return Maybe.None

extend Feed@(T) peek_all() Maybe@(List@(T)):
    if (self.items.len() == 0):
        return Maybe.None
    let List@(T) out = List.new()
    foreach(v in self.items.iter()):
        out.push(v.clone())
    return Maybe.Some(out)

fn feed_of@(T)(nom T[] items) Feed@(T):
    return Feed(items, 0)

fn walk@(T)(nom T[] items) Feed@(T):
    return feed_of(nom items)

fn count@(T: Display)(nom T[] items) i32:
    let i32 n = 0
    foreach(r in walk(nom items)):
        match r:
            Result.Ok(v) -> println(v)
            Result.Err(_) -> println("bad")
        n := n + 1
    return n

fn main() i32:
    println(count(nom from(["Arthur", "Ford"])))
    return 0
