# A reached instance with an `| E` method that no call names: `Feed@(string)` comes
# from a generic body alone, and its `taken()` answers `Result@(List@(string), Bad)`,
# a type that nothing else in the program names (#1146).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "2\n"

error Bad:
    Oops

struct Feed@(T):
    T[] items
    i32 at

extend Feed@(T: Clone) taken() List@(T) | Bad:
    if (self.items.len() == 0):
        return Result.Err(Bad.Oops)
    let List@(T) out = List.new()
    foreach(v in self.items.iter()):
        out.push(v.clone())
    return Result.Ok(out)

fn feed_of@(T)(nom T[] items) Feed@(T):
    return Feed(items, 0)

fn size@(T)(nom T[] items) i32:
    let Feed@(T) f = feed_of(nom items)
    return f.items.len()

fn main() i32:
    println(size(nom from(["Arthur", "Ford"])))
    return 0
