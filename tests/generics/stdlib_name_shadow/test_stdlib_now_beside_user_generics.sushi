# A real `use <time>` call to `now()` still answers the stdlib Result, beside user
# generics that carry the names of other stdlib functions.
# EXPECT_STDOUT_EXACT: true\n7\n8\n
use <time>

fn copy@(T)(T x) T:
    return Result.Ok(x)

fn setenv@(T)(T x) T:
    return Result.Ok(x)

fn main() i32:
    let i64 t = now().realise(0 as i64)
    println(t > (0 as i64))
    println(copy(7).realise(0))
    println(setenv(8).realise(0))
    return Result.Ok(0)
