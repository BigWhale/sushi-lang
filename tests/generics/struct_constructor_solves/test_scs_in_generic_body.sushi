# A generic struct constructor in the body of a generic function solves its type
# arguments from its arguments: a foreach iterable and a println have no expected
# type (#1150).
# EXPECT_STDOUT_EXACT: "6\n3\n2\n"
struct Feed@(T):
    T[] items
    i32 at

extend Feed@(T) next(poke self) Maybe@(T):
    if (self.at >= self.items.len()):
        return Maybe.None()
    let T v = self.items[self.at]
    self.at := self.at + 1
    return Maybe.Some(v)

fn total@(T)(nom T[] items) i32:
    let i32 n = 0
    foreach(r in Feed(items, 0)):
        if (r == r):
            n := n + 1
    return n

fn first_len@(T)(nom T[] items) i32:
    return Feed(items, 0).items.len()

fn main() i32:
    let i32 sum = 0
    foreach(v in Feed(from([1, 2, 3]), 0)):
        sum := sum + v
    println(sum)
    println(total(nom from([true, false, true])))
    let i64[] wide = from([4, 5])
    println(first_len(nom wide))
    return 0
