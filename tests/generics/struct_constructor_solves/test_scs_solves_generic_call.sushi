# A generic struct constructor given straight to a generic call solves that call,
# and an expected type still wins over the arguments (#1150).
# EXPECT_STDOUT_EXACT: "5\n200\n3000000000\n"
struct Box@(T):
    T v

fn unbox@(T: Clone)(Box@(T) b) T:
    return b.v.clone()

fn main() i32:
    println(unbox(Box(5)))
    let Box@(u8) small = Box(200)
    println(small.v)
    let Box@(i64) big = Box(3000000000)
    println(big.v)
    return 0
