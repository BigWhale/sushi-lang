# An unknown generic name in a payload of a generic enum is CE2001, and the instance
# adds no second report (#859).
# EXPECT_ERROR_CODE: CE2001
# EXPECT_STDERR_CONTAINS: unknown type 'Gone'
enum Slot@(T):
    A(Gone@(T))
    B(T)

fn main() i32:
    let Slot@(i32) s = Slot.B(1)
    match s:
        Slot.A(_) -> println("a")
        Slot.B(v) -> println(v)
    return Result.Ok(0)
