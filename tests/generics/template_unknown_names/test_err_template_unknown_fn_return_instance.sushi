# An unknown type name in the return type of a generic function is CE2001 at the
# return type, once, when a call makes an instance (#859).
# EXPECT_ERROR_CODE: CE2001
# EXPECT_STDERR_CONTAINS: test_err_template_unknown_fn_return_instance.sushi:5:15: error [CE2001]: unknown type 'Missing'
fn f@(T)(T v) Missing:
    return Result.Ok(v)

fn main() i32:
    f(1).realise(0)
    return Result.Ok(0)
