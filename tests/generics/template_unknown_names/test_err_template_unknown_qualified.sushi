# A qualified name in a template that its namespace does not hold is CE2001 with the
# nearest member in the help (#859).
# EXPECT_ERROR_CODE: CE2001
# EXPECT_STDERR_CONTAINS: did you mean 'fs.File'?
use <io/fs> as fs

struct Holder@(T):
    fs.Fil h
    T v

fn main() i32:
    println("Mostly Harmless")
    return Result.Ok(0)
