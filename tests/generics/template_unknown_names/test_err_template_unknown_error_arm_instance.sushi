# An unknown type name in the error arm of a generic function is CE2001 at the error
# arm, once, when a call makes an instance (#859).
# EXPECT_ERROR_CODE: CE2001
# EXPECT_STDERR_CONTAINS: test_err_template_unknown_error_arm_instance.sushi:5:21: error [CE2001]: unknown type 'Absent'
fn g@(T)(T v) i32 | Absent:
    return Result.Ok(0)

fn main() i32:
    let i32 r = g(1).realise(0)
    println(r)
    return Result.Ok(0)
