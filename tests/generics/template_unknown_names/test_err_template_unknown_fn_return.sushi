# An unknown type name in the return type of a generic function with no instance is
# CE2001 at the return type (#859).
# EXPECT_ERROR_CODE: CE2001
# EXPECT_STDERR_CONTAINS: test_err_template_unknown_fn_return.sushi:5:15: error [CE2001]: unknown type 'Missing'
fn f@(T)(T v) Missing:
    return Result.Ok(v)

fn main() i32:
    println("Mostly Harmless")
    return Result.Ok(0)
