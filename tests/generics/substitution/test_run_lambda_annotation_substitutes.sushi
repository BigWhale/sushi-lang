# A lambda carries its own parameter and return annotations. They were copied unchanged,
# so a monomorphized body held a `fn(T) -> T` the declared type could not accept (#602).
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "3\n"

fn apply@(T)(T v) T:
    let fn(T) -> T f = |T x| x
    return Result.Ok(f(v)??)

fn main() i32:
    let i32 r = apply@(i32)(3).realise(0)
    println("{r}")
    return Result.Ok(0)
