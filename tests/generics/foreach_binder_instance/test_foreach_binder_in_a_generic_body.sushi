# A generic call on a foreach binder inside a generic body. No other call makes
# k@(i32) (#1155).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "7\n7\n"

fn k@(T)(T x) i32:
    return 7 + (x.hash() * 0) as i32

fn o@(T)(T[] xs) i32:
    foreach(e in xs.iter()):
        println(k(e))
    return 1

fn main() i32:
    let i32[] xs = from([1, 2])
    let i32 r = o(xs)
    return r - 1
