# An explicit generic call behind an alias names the function as written, as a
# concrete function behind an alias does.
# EXPECT_ERROR_CODE: CE2009
# EXPECT_STDERR_CONTAINS: 'ap.pair' expects 2, got 3
use "helpers/inferred_arity_pair" as ap

fn main() i32:
    let i32 n = ap.pair@(i32)(1, 2, 3).realise(0)
    println("{n}")
    return Result.Ok(0)
