# A generic static with a | E channel is solved from its ARGUMENT: `nom T item` names T,
# so `??` binds T from the value handed in, and no stamp is needed (#573).
# EXPECT_STDOUT_EXACT: "40\n"
perk Loud:
    fn shout() i32 | StdError

struct Cat:
    i32 n

extend Cat with Loud:
    fn shout() i32 | StdError:
        return self.n * 10

struct Box@(T: Loud):
    T item
    i32 first

extend Box@(T) static holding(nom T item) Box@(T) | StdError:
    let i32 f = item.shout()??
    return Box(nom item, f)

fn work() i32:
    let Box@(Cat) b = Box.holding(nom Cat(4))??
    println("{b.first}")
    return Result.Ok(0)

fn main() i32:
    let i32 r = work().realise(1)
    return Result.Ok(r)

