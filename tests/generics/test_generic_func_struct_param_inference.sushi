# Test: Generic function with nested generic struct parameters
# Type inference extracts both type parameters from a named generic parameter
# (e.g., Pair@(A, B) binds A and B from the argument's concrete type).
#
# The parameters stay by value, and each call gets its own copy through a local. Two other
# shapes were tried and neither is available: `&peek Pair@(A, B)` is CE2060, because
# inference cannot bind A and B through a reference parameter, and passing `p.clone()`
# directly is CE2061, because the monomorphizer infers only from a Name argument. Binding
# the copy first keeps the argument a Name, so the inference this file tests still runs.
# MM.md section 2.F, findings F7 and F8. Both holes are pinned as current behaviour by
# test_err_peek_generic_param_inference.sushi and test_err_infer_from_non_name_arg.sushi;
# when those two go red, Phase 9.5 has fixed the inference and the four clone-locals
# below can go.

struct Pair@(T, U):
    T first
    U second

fn get_first@(A, B)(Pair@(A, B) p) A:
    return Result.Ok(p.first.clone())

fn get_second@(A, B)(Pair@(A, B) p) B:
    return Result.Ok(p.second.clone())

fn run_test() i32:
    let Pair@(i32, string) p = Pair(42, "test")

    let Pair@(i32, string) pa = p.clone()
    let i32 first = get_first(pa)??
    if (first != 42):
        return Result.Ok(1)

    let Pair@(i32, string) pb = p.clone()
    let string second = get_second(pb)??
    if (second != "test"):
        return Result.Ok(2)

    # Test with different types
    let Pair@(string, i32) p2 = Pair("hello", 99)
    let Pair@(string, i32) p2a = p2.clone()
    let string first2 = get_first(p2a)??
    if (first2 != "hello"):
        return Result.Ok(3)

    let Pair@(string, i32) p2b = p2.clone()
    let i32 second2 = get_second(p2b)??
    if (second2 != 99):
        return Result.Ok(4)

    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
