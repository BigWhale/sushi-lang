public perk Puts:
    fn put(i32 k) i32

public struct Holder@(T):
    T v

public extend Holder@(T: Clone) count(i32 k) i32:
    let T[] held = from([self.v.clone()])
    return held.len() + k

extend Holder@(T: Clone) with Puts:
    fn put(i32 k) i32:
        let T[] held = from([self.v.clone()])
        return held.len() + k
