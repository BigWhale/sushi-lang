# A private function used as a VALUE in the copy of an extension method on a
# generic target (#1064).
# EXPECT_STDOUT_EXACT: "4\n2\n"
use "helpers/ecopy_cst"

fn plain(i32 x) i32:
    return Result.Ok(x)

struct Box@(T):
    T v

extend Box@(T) run() i32:
    let fn(i32) -> i32 f = plain
    return f(4).realise(0)

fn main() i32:
    let Box@(bool) b = Box(true)
    println(b.run())
    println(tick(1).realise(0))
    return Result.Ok(0)
