# A constant behind a `use ... as` alias in the copy of an extension method on a
# generic target (#1065).
# EXPECT_STDOUT_EXACT: "7\n"
use "helpers/ecopy_cst" as c

struct Box@(T):
    T v

extend Box@(T) run() i32:
    return c.SEVEN

fn main() i32:
    let Box@(bool) b = Box(true)
    println(b.run())
    return Result.Ok(0)
