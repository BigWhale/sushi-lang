# A perk implementation on a generic target whose method calls a private function.
# Its copy already goes home to the unit of its template; this keeps it so.
# EXPECT_STDOUT_EXACT: "4\n2\n"
use "helpers/ecopy_cst"

fn plain(i32 x) i32:
    return x

perk Runs:
    fn run() i32

struct Box@(T):
    T v

extend Box@(T) with Runs:
    fn run() i32:
        return plain(4)

fn main() i32:
    let Box@(bool) b = Box(true)
    println(b.run())
    println(tick(1))
    return 0
