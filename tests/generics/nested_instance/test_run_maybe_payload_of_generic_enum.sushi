# A `Maybe@(B)` payload of a generic enum: the nested instance is published to the enum
# table, so the `finite-types` walk and the derive pass both find it (#577, face c).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "false\nempty\n"

enum Slot@(B):
    Filled(Maybe@(B))
    Empty

fn show(Slot@(string) s) i32:
    match s:
        Slot.Filled(m) -> println("{m.is_some()}")
        Slot.Empty -> println("empty")
    return 0

fn main() i32:
    let Slot@(string) s = Slot.Filled(Maybe.None())
    let Slot@(string) e = Slot.Empty
    let i32 a = show(s)
    let i32 b = show(e)
    return a + b
