# A `Maybe@(B)` field of a generic struct names an instance that no annotation and no
# call spells. It is reached only through the substituted field, and the substituted
# instance is interned and gets its built-in methods (#577, face a).
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "3 false\n"

struct Pair@(A, B):
    A first
    Maybe@(B) second

fn main() i32:
    let Pair@(i32, string) p = Pair(3, Maybe.None())
    println("{p.first} {p.second.is_some()}")
    return Result.Ok(0)
