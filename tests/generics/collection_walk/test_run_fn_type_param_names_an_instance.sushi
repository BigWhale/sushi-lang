# A function TYPE holds types too, and a generic instance in its return is named by the
# parameter that carries it. The walk had no function arm either (#603).
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "Mostly Harmless\n"

struct Box@(T):
    T item

fn apply(fn(i32) -> Box@(string) f) i32:
    match f(1):
        Result.Ok(b) -> println(b.item)
        Result.Err(_) -> println("no box")
    return Result.Ok(0)

fn main() i32:
    println("Mostly Harmless")
    return Result.Ok(0)
