# The same function type in the RETURN position (#603).
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "Mostly Harmless\n"

struct Box@(T):
    T item

fn pick(nom fn(i32) -> Box@(string) f) fn(i32) -> Box@(string):
    return Result.Ok(f)

fn main() i32:
    println("Mostly Harmless")
    return Result.Ok(0)
