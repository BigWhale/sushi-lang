# A generic callee whose type arguments come only from a generic function
# value is not solved: the callee is CE2060 and the value is CE2093 (#1029).
# EXPECT_ERROR_CODES_EXACT: CE2060, CE2093
fn gen@(T)(T x) i32:
    let u64 h = x.hash()
    return Result.Ok(7 + (h & 0) as i32)

fn apply1@(T)(fn(T) -> i32 f) i32:
    return Result.Ok(0)

fn main() i32:
    println(apply1(gen).realise(0))
    return Result.Ok(0)
