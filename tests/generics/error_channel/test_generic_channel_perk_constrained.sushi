# A perk-CONSTRAINED generic keeps its channel too. This is the shape every buffered
# helper wants: `fn drain@(R: Reader)(R r) u8[] | IoError` (#538).
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "24\n"

enum ScaleError:
    Zero

perk Sized:
    fn size() i32

struct Crate:
    i32 weight

extend Crate with Sized:
    fn size() i32:
        return self.weight

fn scaled@(S: Sized)(S item, i32 factor) i32 | ScaleError:
    if (factor == 0):
        return Result.Err(ScaleError.Zero)
    return Result.Ok(item.size() * factor)

fn measure(i32 factor) i32 | ScaleError:
    let Crate box = Crate(8)
    let i32 total = scaled(box, factor)??
    return Result.Ok(total)

fn main() i32:
    match measure(3):
        Result.Ok(n) -> println("{n}")
        Result.Err(_) -> println("failed")
    return Result.Ok(0)
