# EXPECT_STDOUT_EXACT: "5 hi\n"
# EXPECT_RUNTIME_EXIT: 0
# Explicit call-site type arguments (issue #137): identity@(i32)(nom 5).
fn identity@(T)(nom T x) T:
    return x

fn main() i32:
    let i32 a = identity@(i32)(nom 5)
    let string s = identity@(string)(nom "hi")
    println("{a} {s}")
    return 0
