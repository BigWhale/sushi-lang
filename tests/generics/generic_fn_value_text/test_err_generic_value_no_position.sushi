# A generic function is a function value only where the position states its function
# type. Here no position does, and the text says so (#1105).
# EXPECT_ERROR_CODE: CE2093
# EXPECT_STDERR_CONTAINS: "this position states no function type"
use <collections/iter>

fn identity@(T)(T x) T:
    return x

fn main() i32:
    let i32[] xs = from([1, 2, 3])
    let i32[] ys = map(xs, identity)
    println(ys.len())
    return 0
