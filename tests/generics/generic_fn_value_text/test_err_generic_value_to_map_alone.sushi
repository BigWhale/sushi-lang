# A generic function value in a position that states no function type is CE2093 alone
# (#1105): the generic callee that cannot be solved without it gives no CE2060 beside it.
# EXPECT_ERROR_CODES_EXACT: CE2093
use <collections/iter>

fn identity@(T)(T x) T:
    return x

fn main() i32:
    let i32[] xs = from([1, 2, 3])
    let i32[] ys = map(xs, identity)
    println(ys.len())
    return 0
