# A generic enum variant built from its payload, given straight to a generic
# call, solves the call (#1152).
# EXPECT_STDOUT_EXACT: "1\n1\n"
enum Slot@(T):
    Full(T)
    Empty

fn one@(T: Eq)(Slot@(T) s) i32:
    if (s == s):
        return 1
    return 0

fn main() i32:
    println(one(Slot.Full(5)))
    println(one(Slot.Full(true)))
    return 0
