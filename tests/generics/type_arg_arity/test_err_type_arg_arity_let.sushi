# EXPECT_ERROR_CODE: CE2062
# EXPECT_STDERR_CONTAINS: generic 'Box' expects 1 type argument(s), got 2
# A written type with too many type arguments names the declaration, not an unknown type.
struct Box@(T):
    T v

fn main() i32:
    let Box@(i32, i32) b = Box(1)
    println(b.v)
    return Result.Ok(0)
