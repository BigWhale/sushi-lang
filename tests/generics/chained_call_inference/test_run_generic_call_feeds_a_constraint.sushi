# A generic call chained through a BARE extension method, then handed to a constrained
# generic. The chain's receiver is the inner call's substituted return, so the extension
# resolves and the constraint is checked against a real type (#556).
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "seeded 1\n9\n"

perk Countable:
    fn count() i32

struct Crate:
    i32 weight

extend Crate with Countable:
    fn count() i32:
        return self.weight

extend Crate heavier() Crate:
    return Crate(self.weight + 2)

fn make@(T)(nom T seed) Crate:
    println("seeded {seed}")
    return Result.Ok(Crate(7))

fn total@(C: Countable)(C c) i32:
    return Result.Ok(c.count())

fn main() i32:
    println("{total(make(nom 1).realise(Crate(0)).heavier()).realise(-1)}")
    return Result.Ok(0)
