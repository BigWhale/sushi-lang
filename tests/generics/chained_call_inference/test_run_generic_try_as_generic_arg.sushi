# The same shape through `??` rather than `.realise()`: the inner generic call is typed
# from its substituted signature and the `??` unwraps that, so the outer generic solves
# its parameter (#556).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "carried 7\n"

fn wrap@(T)(nom T v) T:
    return v

fn carry@(U: Display)(nom U v) string:
    return "carried {v}"

fn run() string:
    let string said = carry(nom wrap(nom 7))
    return said

fn main() i32:
    println(run())
    return 0
