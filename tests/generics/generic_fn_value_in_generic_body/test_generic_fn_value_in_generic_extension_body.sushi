# A generic function value is solved inside the copy of an extension and of a
# perk implementation on a generic target, as it is in a function (#1036).
# EXPECT_STDOUT_EXACT: "8\n8\n1\n"
fn gen@(T: Clone)(T x) T:
    return x.clone()

fn apply_t@(T)(fn(T) -> T f, T x) T:
    return f(x)

struct Box@(T):
    T v

extend Box@(T: Clone) run() T:
    return apply_t(gen, self.v)

perk Runs:
    fn go() i32

extend Box@(T: Display + Clone) with Runs:
    fn go() i32:
        let fn(T) -> T f = gen
        let T k = f(self.v)
        println(k)
        return 1

fn main() i32:
    let Box@(i32) b = Box(8)
    println(b.run())
    println(b.go())
    return 0
