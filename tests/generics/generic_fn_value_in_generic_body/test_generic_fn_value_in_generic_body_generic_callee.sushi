# A generic function value passed to a generic callee inside a generic body
# is solved against the type argument of the enclosing instance (#1036).
# EXPECT_STDOUT_EXACT: "5\n2.5\n"
fn gen@(T: Clone)(T x) T:
    return x.clone()

fn apply@(T)(fn(T) -> T f, T x) T:
    return f(x)

fn outer@(U: Clone)(U u) U:
    return apply(gen, u)

fn main() i32:
    println(outer(5))
    println(outer(2.5))
    return 0
