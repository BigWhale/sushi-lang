# A generic function value is solved by a `let`, a `return`, a struct field
# and a rebind inside the body of a generic function, and a position that
# names the type parameter solves it for each instance (#1036).
# EXPECT_STDOUT_EXACT: "5\n1\n6\nx\n3\ny\n9\n"
fn gen@(T: Clone)(T x) T:
    return x.clone()

fn id_i(i32 x) i32:
    return x

struct H:
    fn(i32) -> i32 f

fn use_let@(U: Clone)(U u) U:
    let fn(U) -> U f = gen
    return f(u)

fn use_ret@(U: Display + Clone)(U u) fn(U) -> U:
    println(u)
    return gen

fn use_field@(U: Display)(U u) i32:
    println(u)
    let H h = H(gen)
    return h.f(3)

fn use_rebind@(U: Display)(U u) i32:
    println(u)
    let fn(i32) -> i32 f = id_i
    f := gen
    return f(9)

fn main() i32:
    println(use_let(5))
    let fn(i32) -> i32 g = use_ret(1)
    println(g(6))
    println(use_field("x"))
    println(use_rebind("y"))
    return 0
