# A generic function value behind an alias is solved inside the body of a
# generic function, as the bare name is (#1036).
# EXPECT_STDOUT_EXACT: "one\n4\n"
use "helpers/libinner" as l

fn apply_c(fn(i32) -> i32 f) i32:
    return f(4)

fn inner@(U: Display)(U u) i32:
    println(u)
    return apply_c(l.gen)

fn main() i32:
    println(inner("one"))
    return 0
