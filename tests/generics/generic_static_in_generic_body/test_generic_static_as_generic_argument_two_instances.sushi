# Two instances of the generic body, so two copies of the static: each copy is made one
# time (#1153).
# EXPECT_STDOUT_EXACT: "5\ntrue\n"
struct Box@(T):
    T v

fn unbox@(T)(nom Box@(T) b) T:
    return nom b.v

extend Box@(T) static of(nom T v) Box@(T):
    return Box(v)

fn o@(T)(nom T x) T:
    return unbox(nom Box.of(nom x))

fn main() i32:
    println(o(nom 5))
    println(o(nom true))
    return 0
