# A generic call on realise() of a Maybe of a struct. No other call makes k@(P)
# (#1156).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "7\n"

struct P:
    i32 x

fn k@(T)(T x) i32:
    return 7 + (x.hash() * 0) as i32

fn main() i32:
    let Maybe@(P) m = Maybe.Some(P(3))
    println(k(m.realise(P(0))))
    return 0
