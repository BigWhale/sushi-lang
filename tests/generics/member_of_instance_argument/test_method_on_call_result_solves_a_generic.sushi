# A generic call on a method of a call result. No other call makes k@(i32) (#1156).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "7\n"

fn k@(T: Hashable)(T x) i32:
    return 7 + (x.hash() * 0) as i32

fn mkl() List@(i32):
    let List@(i32) l = List.new()
    l.push(1)
    return l

fn main() i32:
    println(k(mkl().len()))
    return 0
