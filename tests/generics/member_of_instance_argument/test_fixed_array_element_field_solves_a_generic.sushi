# A generic call on a field of an element of a fixed array of a struct. No other call
# makes k@(i32) (#1156).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "7\n"

struct P:
    i32 x

fn k@(T)(T x) i32:
    return 7 + (x.hash() * 0) as i32

fn main() i32:
    let P[2] ps = [P(3), P(4)]
    println(k(ps[0].x))
    return 0
