# A generic call on get() of a List of a struct. No other call makes
# k@(Maybe@(P)) (#1156).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "7\n"

struct P:
    i32 x

fn k@(T)(T x) i32:
    return 7 + (x.hash() * 0) as i32

fn main() i32:
    let List@(P) l = List.new()
    l.push(P(3))
    println(k(l.get(0)))
    return 0
