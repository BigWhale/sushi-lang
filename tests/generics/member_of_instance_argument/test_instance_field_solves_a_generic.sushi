# A generic call on a field of a generic-instance local. No other call makes k@(i32)
# (#1156).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "7\n"

struct Box@(T):
    T v

fn k@(T: Hashable)(T x) i32:
    return 7 + (x.hash() * 0) as i32

fn main() i32:
    let Box@(i32) b = Box(3)
    println(k(b.v))
    return 0
