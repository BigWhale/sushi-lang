# A generic call on len() of what the <collections/iter> zip answers. No other call
# makes k@(i32) (#1156).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "7\n"

use <collections/iter>

fn k@(T)(T x) i32:
    return 7 + (x.hash() * 0) as i32

fn main() i32:
    let i32[] xs = from([1, 2])
    let string[] ys = from(["a", "b"])
    println(k(xs.zip(ys).len()))
    return 0
