# A generic call on len() of what the <collections/iter> map answers. No other call
# makes k@(i32) (#1156).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "7\n"

use <collections/iter>

fn k@(T: Hashable)(T x) i32:
    return 7 + (x.hash() * 0) as i32

fn double(i32 x) i32:
    return x * 2

fn main() i32:
    let List@(i32) l = List.new()
    l.push(1)
    println(k(map(l, double).len()))
    return 0
