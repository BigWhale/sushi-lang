# A KNOWN HOLE, PINNED AS CURRENT BEHAVIOUR. This file passes today and MUST go red the
# moment Phase 9.5 fixes the inference. When it does, that is the fix landing, not a
# regression: delete this file and convert the three workaround sites named below.
#
# MM.md section 2.F finding F8: the monomorphizer collects an instantiation only from a
# Name argument, so `f(p.clone())` -- the argument shape the clone idiom produces -- is
# never collected. The mangled symbol is then absent from the function table and the call
# fails as CE2061, which is registered as an INTERNAL error. A user writing the idiom the
# compiler asks for gets an internal-compiler-error code, so this hole is louder than F7
# and worse to meet.
#
# The workaround is to bind the copy to a local first, which keeps the argument a Name.
# Three sites are shaped around this hole and are the ones to revisit:
#   tests/generics/test_generic_func_struct_param_inference.sushi  (4 clone-locals)
#   tests/generics/test_run_issue214_nested_generic_call_in_arg.sushi
#   docs/examples/24-perks-constraints.sushi  (a teaching example -- users copy this)
#
# The twin hole is test_err_peek_generic_param_inference.sushi (finding F7).
# EXPECT_ERROR_CODE: CE2061

struct Pair@(T, U):
    T first
    U second

fn get_first@(A, B)(Pair@(A, B) p) A:
    return Result.Ok(p.first.clone())

fn run() i32:
    let Pair@(i32, string) p = Pair(42, "test")
    let i32 first = get_first(p.clone())??
    return Result.Ok(first)

fn main() i32:
    let i32 rc = run().realise(99)
    println(rc)
    return Result.Ok(0)
