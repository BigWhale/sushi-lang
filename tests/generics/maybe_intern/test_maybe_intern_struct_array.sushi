# A `Maybe@(Point[])` annotation meets the instance the monomorphize pass published with
# the element resolved. One type seen at two resolution depths is one type (#793).
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "none\n"

struct Point:
    i32 x

fn main() i32:
    let Maybe@(Point[]) m = Maybe.None
    match m:
        Maybe.Some(v) -> println("{v.len()}")
        Maybe.None -> println("none")
    return Result.Ok(0)
