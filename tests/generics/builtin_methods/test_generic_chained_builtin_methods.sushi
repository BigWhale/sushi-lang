# Chained built-in method calls inside a generic body (issue #269): the
# instantiation-collection inference reads the family return-type tables, so
# every chain link is typed -- hash/to_str included, which the old private
# table did not know.
# EXPECT_STDOUT_EXACT: "FORD PREFECT\n5\ntrue\n1\n"
# EXPECT_RUNTIME_EXIT: 0

use <collections/strings>

fn shout@(T: Display)(T value) string:
    return value.to_str().upper()

fn measure@(T: Display)(T value) i32:
    return value.to_str().len()

fn describe@(T: Hashable)(T value) string:
    return value.hash().to_str()

fn main() i32:
    println(shout("ford prefect"))
    println(measure(12345))
    let string h = describe(42)
    println(h.len() > 0)
    println("abc".find("b").realise(-1))
    return 0
