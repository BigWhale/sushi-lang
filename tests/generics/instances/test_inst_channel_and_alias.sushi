# A generic with a channel and a generic behind an alias, with written type arguments.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "x\n2\n3\n1\n9\n"
use "helpers/inst_lib" as shelf

error InstFault:
    Odd

fn inst_even@(T: Display)(T x, i32 n) i32 | InstFault:
    println("{x}")
    if (n % 2 == 1):
        return Result.Err(InstFault.Odd)
    return Result.Ok(n)

fn inst_run() i32 | InstFault:
    let i32 a = inst_even("x", 2)??
    println(a)
    return Result.Ok(shelf.inst_echo@(i32)(nom 3))

fn main() i32:
    println(inst_run().realise(0))
    println(inst_even(1, 3).realise(9))
    return 0
