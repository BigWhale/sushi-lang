# Test: Generic function with struct type parameter
# The call infers T = Point from its argument, and the instance returns the value it was given.

struct Point:
    i32 x
    i32 y

fn identity@(T)(T value) T:
    return value

fn main() i32:
    let Point p = identity(Point(3, 4))
    if (p.x != 3 or p.y != 4):
        return 1
    return 0
