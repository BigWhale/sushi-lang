# Test: Generic function with multiple type parameters
# The call infers T and U, two different types, from its two arguments.

struct Pair@(A, B):
    A first
    B second

fn swap@(T, U)(T a, U b) Pair@(U, T):
    return Result.Ok(Pair(b, a))

fn main() i32:
    let Pair@(bool, i32) p = swap(42, true).realise(Pair(false, 0))
    if (p.first != true or p.second != 42):
        return Result.Ok(1)
    return Result.Ok(0)
