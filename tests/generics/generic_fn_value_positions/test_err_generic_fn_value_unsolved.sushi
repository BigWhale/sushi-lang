# A parameter type that does not solve the type arguments of a generic function
# leaves the function value CE2093 (#1021).
# EXPECT_ERROR_CODES_EXACT: CE2093
fn gen@(T: Hashable)(T x) i32:
    let u64 h = x.hash()
    return 7 + (h & 0) as i32

fn apply(fn(i32, i32) -> i32 f) i32:
    return f(1, 2)

fn main() i32:
    println(apply(gen))
    return 0
