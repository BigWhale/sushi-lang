# A generic function value is solved by the Ok arm of the receiver in a
# `.realise(default)` default (#1021).
# EXPECT_STDOUT_EXACT: "7\n"
fn gen@(T)(T x) i32:
    let u64 h = x.hash()
    return 7 + (h & 0) as i32

fn pick() fn(i32) -> i32 | StdError:
    return Result.Err(StdError.Error)

fn main() i32:
    let fn(i32) -> i32 f = pick().realise(gen)
    println(f(1))
    return 0
