# A generic function is a function value in a rebind: the declared type of the
# variable solves its type arguments (#1021).
# EXPECT_STDOUT_EXACT: "6\n7\n"
fn gen@(T)(T x) i32:
    let u64 h = x.hash()
    return 7 + (h & 0) as i32

fn six(i32 x) i32:
    return 6 + x * 0

fn main() i32:
    let fn(i32) -> i32 f = six
    println(f(1))
    f := gen
    println(f(1))
    return 0
