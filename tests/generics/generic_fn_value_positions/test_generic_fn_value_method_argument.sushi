# A generic function value is solved by the parameter type of a method and of
# a static method (#1021).
# EXPECT_STDOUT_EXACT: "7\n8\n"
fn g1@(T: Hashable)(T x) i32:
    let u64 h = x.hash()
    return 7 + (h & 0) as i32

fn g2@(T: Hashable)(T x) i32:
    let u64 h = x.hash()
    return 8 + (h & 0) as i32

struct Box:
    i32 v

extend Box run(fn(i32) -> i32 f) i32:
    return f(self.v)

extend Box static make(fn(i32) -> i32 f) Box:
    return Box(f(1))

fn main() i32:
    let Box b = Box(1)
    println(b.run(g1))
    let Box c = Box.make(g2)
    println(c.v)
    return 0
