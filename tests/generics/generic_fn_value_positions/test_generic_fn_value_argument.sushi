# A generic function is a function value in an argument position: the
# parameter type solves its type arguments, and no other call is needed (#1021).
# EXPECT_STDOUT_EXACT: "7\n"
fn gen@(T)(T x) i32:
    let u64 h = x.hash()
    return Result.Ok(7 + (h & 0) as i32)

fn apply(fn(i32) -> i32 f) i32:
    return Result.Ok(f(1).realise(0))

fn main() i32:
    println(apply(gen).realise(0))
    return Result.Ok(0)
