# A generic function is a function value in a return: the declared return type
# solves its type arguments (#1021).
# EXPECT_STDOUT_EXACT: "7\n"
fn gen@(T: Hashable)(T x) i32:
    let u64 h = x.hash()
    return 7 + (h & 0) as i32

fn pick() Result@(fn(i32) -> i32, StdError):
    return Result.Ok(gen)

fn main() i32:
    match pick():
        Result.Ok(f) -> println(f(1))
        Result.Err(_) -> println("none")
    return 0
