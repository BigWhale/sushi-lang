# A generic function is a function value in a struct field and in an enum
# payload: the declared field and payload types solve its type arguments (#1021).
# EXPECT_STDOUT_EXACT: "7\n7\n"
fn gen@(T)(T x) i32:
    let u64 h = x.hash()
    return Result.Ok(7 + (h & 0) as i32)

struct Holder:
    fn(i32) -> i32 f

enum Op:
    Apply(fn(string) -> i32)

fn main() i32:
    let Holder h = Holder(gen)
    println(h.f(1).realise(0))
    let Op o = Op.Apply(gen)
    match o:
        Op.Apply(g) -> println(g("x").realise(0))
    return Result.Ok(0)
