# A generic function behind an alias is a function value in an argument
# position, as the bare name is (#1021).
# EXPECT_STDOUT_EXACT: "7\n"
use "helpers/libpos" as l

fn apply(fn(i32) -> i32 f) i32:
    return Result.Ok(f(1).realise(0))

fn main() i32:
    println(apply(l.gen).realise(0))
    return Result.Ok(0)
