# One level deeper: `Box@(string)` is named nowhere the instantiate pass walks. It exists
# only once `outer@(string)` is monomorphized and its body's `let Box@(T)` is
# substituted. A LATE instantiation gets its extension and its perk implementation
# exactly as an early one does (#555).
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "box labelled\n1\n"

perk Show:
    fn show() string

struct Box@(T):
    T item

extend Box@(T) with Show:
    fn show() string:
        return "box"

extend Box@(T) label() string:
    return "labelled"

fn wrap@(T)(nom T v) Box@(T):
    return Result.Ok(Box(v))

fn outer@(T)(nom T v) i32:
    let Box@(T) b = wrap(nom v)??
    println("{b.show()} {b.label()}")
    return Result.Ok(1)

fn main() i32:
    let i32 n = outer(nom "Mostly Harmless").realise(0)
    println("{n}")
    return Result.Ok(0)
