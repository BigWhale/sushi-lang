# In a generic static body, a generic call inside println. No other call makes
# k@(i32) (#1157).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "7\n3\n"

struct Box@(T):
    T v

fn k@(T)(T x) i32:
    return 7 + (x.hash() * 0) as i32

extend Box@(T) static of(T v) Box@(T):
    println(k(v))
    return Box(v)

fn main() i32:
    let Box@(i32) b = Box.of(3)
    println(b.v)
    return 0
