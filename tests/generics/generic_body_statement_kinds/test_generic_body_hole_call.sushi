# In a generic body, a generic call in an interpolation hole of println. No other call
# makes k@(i32) (#1157).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "k 7\n1\n"

fn k@(T: Hashable)(T x) i32:
    return 7 + (x.hash() * 0) as i32

fn o@(T: Hashable)(T x) i32:
    println("k {k(x)}")
    return 1

fn main() i32:
    println(o(5))
    return 0
