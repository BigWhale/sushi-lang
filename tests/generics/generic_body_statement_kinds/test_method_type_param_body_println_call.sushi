# In a method with a method-level type parameter, a generic call inside println. No
# other call makes k@(string) (#1157).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "7\n1\n"

struct Crate:
    i32 weight

fn k@(T: Hashable)(T x) i32:
    return 7 + (x.hash() * 0) as i32

extend Crate show@(U: Hashable)(U u) i32:
    println(k(u))
    return 1

fn main() i32:
    let Crate c = Crate(2)
    println(c.show("a"))
    return 0
