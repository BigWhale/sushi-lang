# In a generic body, a generic call on a match binding in an inline arm. No other call
# makes k@(T) for the payload type (#1157).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "7\n"

fn k@(T)(T x) i32:
    return 7 + (x.hash() * 0) as i32

fn o@(T)(T x) i32:
    let i32 r = 0
    let Maybe@(T) m = Maybe.Some(x)
    match m:
        Maybe.Some(z) -> r := k(z)
        Maybe.None -> r := 0
    return r

fn main() i32:
    println(o(5))
    return 0
