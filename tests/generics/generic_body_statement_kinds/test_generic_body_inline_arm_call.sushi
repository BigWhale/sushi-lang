# In a generic body, a generic call in an inline match arm. No other call makes
# k@(i32) (#1157).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "7\n"

fn k@(T: Hashable)(T x) i32:
    return 7 + (x.hash() * 0) as i32

fn o@(T: Hashable)(T x) i32:
    let i32 r = 0
    let Maybe@(i32) m = Maybe.Some(3)
    match m:
        Maybe.Some(_) -> r := k(x)
        Maybe.None -> r := 0
    return r

fn main() i32:
    println(o(5))
    return 0
