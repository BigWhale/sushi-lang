# In an array template body, a generic call inside println. No other call makes
# k@(i32) (#1157).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "7\n1\n"

fn k@(T: Hashable)(T x) i32:
    return 7 + (x.hash() * 0) as i32

extend (T: Hashable)[] probe() i32:
    println(k(self[0]))
    return 1

fn main() i32:
    let i32[] xs = from([4])
    println(xs.probe())
    return 0
