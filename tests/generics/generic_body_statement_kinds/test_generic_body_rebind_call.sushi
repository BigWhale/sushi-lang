# In a generic body, a generic call on the right side of a rebind. No other call makes
# k@(i32) (#1157).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "7\n"

fn k@(T)(T x) i32:
    return 7 + (x.hash() * 0) as i32

fn o@(T)(T x) i32:
    let i32 r = 0
    r := k(x)
    return r

fn main() i32:
    println(o(5))
    return 0
