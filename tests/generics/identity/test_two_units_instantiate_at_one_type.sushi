# Both units instantiate their own `twin@(T)` at i32. The two instances share a
# mangled base name, so each must carry its unit or one body answers both (#495).
# EXPECT_STDOUT_EXACT: "m twin\nc twin\n7 5\n"
use "helpers/twin_c"

fn twin@(T)(nom T x) T:
    println("m twin")
    return Result.Ok(x)

fn main() i32:
    let i32 a = twin(nom 7).realise(0)
    let i32 b = twin_c_use().realise(0)
    println("{a} {b}")
    return Result.Ok(0)
