# A declared P local as the second argument binds the same type parameter as the
# declared P[] local (#1134).
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "2\n"
struct P:
    i32 x

fn cnt@(T: Hashable)(T[] xs, T d) i32:
    return xs.len() + ((d.hash() * 0) as i32)

fn main() i32:
    let P[] ps = from([P(1), P(2)])
    let P q = P(0)
    println(cnt(ps, q))
    return 0
