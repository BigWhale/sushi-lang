# A declared List@(P) local and a P argument bind one type parameter (#1134).
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "2\n"
struct P:
    i32 x

fn cnt@(T)(List@(T) xs, T d) i32:
    return xs.len() + ((d.hash() * 0) as i32)

fn main() i32:
    let List@(P) ps = List.new()
    ps.push(P(1))
    ps.push(P(2))
    println(cnt(ps, P(0)))
    return 0
