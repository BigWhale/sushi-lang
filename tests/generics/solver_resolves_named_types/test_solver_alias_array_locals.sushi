# A struct and an enum from another unit, written behind an alias, in declared array
# locals (#1134).
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "2\n3\n"
use "helpers/solver_shapes" as sh

fn cnt@(T)(T[] xs, T d) i32:
    return xs.len() + ((d.hash() * 0) as i32)

fn main() i32:
    let sh.Pt[] ps = from([sh.Pt(1), sh.Pt(2)])
    let sh.Pt q = sh.Pt(0)
    println(cnt(ps, q))
    let sh.Mark[] ms = from([sh.Mark.On(), sh.Mark.Off(), sh.Mark.On()])
    let sh.Mark m = sh.Mark.Off()
    println(cnt(ms, m))
    return 0
