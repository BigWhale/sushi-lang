# A Maybe read through an array element keeps the element type (#769).
# Maybe@(f64) and Maybe@(i64) have one LLVM layout, so a type read off the layout
# is a guess, and a wrong guess reads the payload bits as the other type.
# EXPECT_STDOUT_EXACT: "1.5 5000000000\n"
# EXPECT_RUNTIME_EXIT: 0

fn main() i32:
    let Maybe@(f64)[] reals = from([Maybe.Some(1.5)])
    let Maybe@(i64)[] wholes = from([Maybe.Some(5000000000)])
    let f64 a = reals[0].realise(0.0)
    let i64 b = wholes[0].realise(0)
    println("{a} {b}")
    return Result.Ok(0)
