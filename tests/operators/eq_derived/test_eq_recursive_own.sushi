# A type that reaches itself through `Own@(T)` compares: the equality of the chain
# calls itself for the next link.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "true\nfalse\nfalse\n"
# EXPECT_NO_LEAKS: true

enum Chain:
    End
    Link(i32, Own@(Chain))

fn chain(i32 a, i32 b) Chain:
    return Chain.Link(a, Own.alloc(Chain.Link(b, Own.alloc(Chain.End))))

fn main() i32:
    let Chain x = chain(1, 2)
    let Chain y = chain(1, 2)
    let Chain z = chain(1, 3)
    println(x == y)
    println(x == z)
    println(x == Chain.End)
    return 0
