# The derived equality is also the method `eq`, on a struct and on a primitive.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "true\nfalse\ntrue\n"

struct Point:
    i32 x
    i32 y

fn main() i32:
    let Point p = Point(1, 2)
    println(p.eq(Point(1, 2)))
    println(p.eq(Point(2, 1)))
    let i32 n = 4
    println(n.eq(4))
    return 0
