# `Maybe` and `Result` are enums, so `==` compares them too. The right operand takes
# its type from the left one.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "true\nfalse\ntrue\ntrue\nfalse\n"

fn main() i32:
    let Maybe@(i32) m = Maybe.Some(3)
    println(m == Maybe.Some(3))
    println(m == Maybe.None)
    let Maybe@(i32) none = Maybe.None
    println(none == Maybe.None)
    let Result@(i32, StdError) ok = Result.Ok(1)
    println(ok == Result.Ok(1))
    println(ok == Result.Err(StdError.Error))
    return 0
