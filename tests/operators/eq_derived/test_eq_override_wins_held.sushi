# An `Eq` implementation wins everywhere: at `==` on the type, and at a field of it
# inside a derived equality.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "true\ntrue\nfalse\n"

struct Loose:
    i32 key
    i32 noise

extend Loose with Eq:
    fn eq(Loose other) bool:
        return self.key == other.key

struct Holder:
    Loose loose
    i32 id

fn main() i32:
    println(Loose(1, 2) == Loose(1, 3))
    println(Holder(Loose(1, 2), 5) == Holder(Loose(1, 9), 5))
    println(Holder(Loose(1, 2), 5) == Holder(Loose(1, 2), 6))
    return 0
