# `==` and `!=` on a struct compare every field, a nested struct, a string, an array
# and a List included. The compiler derives the equality; no perk is written.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "true\nfalse\nfalse\nfalse\ntrue\nfalse\n"
# EXPECT_NO_LEAKS: true

struct Inner:
    i32 a
    bool b

struct Record:
    string name
    Inner inner
    i32[] tags
    List@(u8) bytes

fn make(string name, i32 a, i32 tag, u8 last) Record:
    let List@(u8) bytes = List.new()
    bytes.push(1)
    bytes.push(last)
    return Record(name.clone(), Inner(a, true), from([7, tag]), bytes)

fn main() i32:
    let Record r = make("arthur", 1, 2, 3)
    let Record same = make("arthur", 1, 2, 3)
    let Record other_name = make("ford", 1, 2, 3)
    let Record other_tag = make("arthur", 1, 9, 3)
    println(r == same)
    println(r == other_name)
    println(r == other_tag)
    println(r == make("arthur", 5, 2, 3))
    println(r != make("arthur", 1, 2, 4))
    println(r != same)
    return 0
