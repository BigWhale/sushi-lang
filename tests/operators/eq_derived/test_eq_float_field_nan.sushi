# A float held in a type compares by the total rule: two NaNs are equal and -0.0 equals
# 0.0. A bare float `==` stays IEEE, so a NaN is not equal to itself there.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "true\ntrue\nfalse\nfalse\n"

struct Sample:
    f64 value

fn zero() f64:
    return 0.0

fn main() i32:
    let f64 nan = zero() / zero()
    println(Sample(nan) == Sample(nan))
    println(Sample(-0.0) == Sample(0.0))
    println(Sample(1.0) == Sample(nan))
    println(nan == nan)
    return 0
