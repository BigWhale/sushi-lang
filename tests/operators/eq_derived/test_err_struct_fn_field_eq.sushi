# A struct that holds a function value has no derived equality, and the diagnostic says
# which field stops it.
# EXPECT_ERROR_CODE: CE2514
# EXPECT_STDERR_CONTAINS: field 'f' -> a function value

struct Handler:
    i32 id
    fn(i32) -> i32 f

fn twice(i32 x) i32:
    return x * 2

fn main() i32:
    let Handler a = Handler(1, twice)
    let Handler b = Handler(1, twice)
    if (a == b):
        return 1
    return 0
