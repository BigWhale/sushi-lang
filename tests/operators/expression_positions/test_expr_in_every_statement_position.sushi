# EXPECT_STDOUT_EXACT: "7\n7\n9\n12\n10\n6\n8\n8\ntrue\ntrue\n-8\n-9\nfalse\nover\n2\n3\n3\n26\n24\n5\n108\n36\n40\narm 40\n-1\nMostly Harmless\n"
# Every position that holds an expression, with an expression whose outermost
# parse node is a different operator level. One reader answers the same question
# in each of them -- which direct child is the expression -- so one fixture walks
# print, println, return, let, rebind, const, var, a match scrutinee, a match arm
# on the arrow, if, elif, while, foreach, an index, a call argument, a named
# argument, an array element and a lambda body.

const i32 BASE = 3 + 4

var i32 counter = 10

struct Box:
    i32 n

fn twice(i32 n) i32:
    return Result.Ok(n * 2)

# An extension body returns bare, so the multiplication stands at the return.
extend i32 tripled() i32:
    return self * 3

fn shout(i32 n) i32:
    println("arm {n}")
    return Result.Ok(n)

fn tag_of(i32 n) i32:
    match n + 1:
        4 -> return Result.Ok(40)
        5 -> shout(twice(20)??)?? + 1
        _ -> return Result.Ok(0)
    return Result.Ok(-1)

fn seen(peek i32 n) i32:
    return Result.Ok(n + 100)

fn main() i32:
    print("{BASE}\n")
    println(BASE)

    let i32 sum = 4 + 5
    println(sum)

    sum := sum + 3
    println(sum)

    println(counter as i64 as i32)

    counter := counter - 4
    println(counter)

    let i32 shifted = 1 << 3
    println(shifted)

    let i32 masked = shifted & 9
    println(masked)

    let bool same = masked == 8
    println(same)

    let bool either = same or false
    println(either)

    let i32 negated = -shifted
    println(negated)

    let i32 flipped = ~shifted
    println(flipped)

    println(not either)

    if (sum > 10):
        println("over")
    elif (sum > 4):
        println("under")

    let i32 spin = 0
    while (spin < 2):
        spin := spin + 1
    println(spin)

    let i32 total = 0
    foreach(i in 0..3):
        total := total + i
    println(total)

    let i32[] cells = from([sum + 1, 2, 3])
    println(cells[1 + 1])

    println(twice(sum + 1).realise(0))

    let Box b = Box(n: sum * 2)
    println(b.n)

    let fn(i32) -> i32 bump = |i32 x| x + 1
    println(bump(4).realise(0))

    println(seen(peek masked).realise(0))

    println(sum.tripled())

    println(tag_of(3).realise(0))
    println(tag_of(4).realise(0))

    println("Mostly Harmless")
    return Result.Ok(0)
