# The derived order of a struct reads the fields in declaration order: the first field
# that differs decides.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "true\nfalse\ntrue\ntrue\ntrue\n-1\n0\n1\n"

struct Version:
    i32 major
    i32 minor

fn main() i32:
    let Version a = Version(1, 9)
    let Version b = Version(2, 0)
    println(a < b)
    println(b < a)
    println(Version(1, 2) < Version(1, 3))
    println(Version(1, 3) >= Version(1, 3))
    println(Version(3, 0) > Version(2, 99))
    println(a.compare(b))
    println(a.compare(Version(1, 9)))
    println(b.compare(a))
    return 0
