# A float held in a type orders by the total rule: a NaN after every number, all NaNs
# equal, and -0.0 equal to 0.0.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "true\n0\n0\ntrue\n"

struct Sample:
    f64 value

fn zero() f64:
    return 0.0

fn main() i32:
    let f64 nan = zero() / zero()
    let f64 inf = 1.0 / zero()
    println(Sample(inf) < Sample(nan))
    println(Sample(nan).compare(Sample(nan)))
    println(Sample(-0.0).compare(Sample(0.0)))
    println(Sample(-inf) < Sample(-1.0))
    return 0
