# A `List@(T)` and an array held in a type order element by element; a prefix is less.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "true\ntrue\nfalse\n"
# EXPECT_NO_LEAKS: true

struct Row:
    List@(i32) cells

struct Tags:
    i32[] ids

fn row(i32 a, i32 b) Row:
    let List@(i32) cells = List.new()
    cells.push(a)
    cells.push(b)
    return Row(cells)

fn main() i32:
    println(row(1, 2) < row(1, 3))
    println(Tags(from([1])) < Tags(from([1, 0])))
    println(Tags(from([2])) < Tags(from([1, 9])))
    return 0
