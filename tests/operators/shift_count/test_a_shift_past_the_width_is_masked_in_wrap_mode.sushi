# COMPILER_FLAGS: --overflow=wrap
# EXPECT_STDOUT_EXACT: "Mostly Harmless\n144\n18\n36\n15\n240\n240\n"
# A count the compiler cannot read is not refused, so the operator has to answer
# something. In wrap mode the count is masked to the width, as Rust does: on a u8,
# 8 is 0, 17 is 1 and 200 is 0. In trap mode it is RE2034.

fn shl_u8(u8 value, u8 places) u8:
    return value << places

fn shr_u8(u8 value, u8 places) u8:
    return value >> places

fn main() i32:
    println("Mostly Harmless")

    println("{shl_u8(0x12, 3)}")
    println("{shl_u8(0x12, 8)}")
    println("{shl_u8(0x12, 17)}")

    println("{shr_u8(0xF0, 4)}")
    println("{shr_u8(0xF0, 8)}")
    println("{shr_u8(0xF0, 200)}")

    return 0
