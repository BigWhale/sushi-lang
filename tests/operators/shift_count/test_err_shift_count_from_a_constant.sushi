# EXPECT_ERROR_CODE: CE2512
# A count spelled as a constant is as provable as a literal one, and naming it is
# exactly how a byte-assembly loop writes it.

const i32 BYTE_BITS = 8

fn main() i32:
    let u8 high = 0x12
    let u8 shifted = high << BYTE_BITS
    println("{shifted}")
    return Result.Ok(0)
