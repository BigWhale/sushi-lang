# EXPECT_STDOUT_EXACT: "Mostly Harmless\nle-true\nge-true\nlt-false\ngt-false\n"
# Two equal strings: both inclusive operators are true and both strict operators
# are false.

fn main() i32:
    println("Mostly Harmless")

    let string a = "same"
    let string b = "same"

    if (a <= b):
        println("le-true")
    if (a >= b):
        println("ge-true")
    if (not (a < b)):
        println("lt-false")
    if (not (a > b)):
        println("gt-false")

    return Result.Ok(0)
