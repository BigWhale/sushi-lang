# #327: `&poke self` -- the mutable receiver. The receiver arrives by POINTER, so a
# field write through `self` reaches the CALLER's value; `&peek self` states the
# read-only default explicitly. Call sites are unchanged.
# EXPECT_STDOUT_EXACT: "3\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS
struct Counter:
    i32 n

extend Counter bump(&poke self) ~:
    self.n := self.n + 1
    return ~

extend Counter total(&peek self) i32:
    return self.n

fn main() i32:
    let Counter c = Counter(1)
    c.bump()
    c.bump()
    println(c.total())
    return Result.Ok(0)
