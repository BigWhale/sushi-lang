# A FRESH temporary is rejected by the same rule: the statement discards the value, so
# the write is dead either way (Swift rejects the same shape). Before the gate this was
# a CE0129 ICE -- Pass 3 stamped no ownership decision for the push argument.
# EXPECT_ERROR_CODE: CE2429
fn main() i32:
    from([1, 2]).push(9)
    return Result.Ok(0)
