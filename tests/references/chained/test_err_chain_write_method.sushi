# #407 / #352 ruling: a write receiver must reach its root through member and index
# steps only. `o.get()` is a call boundary, so the value past it is a temporary copy;
# the push would land on the copy and be lost. Before the gate this compiled, printed
# the old length, and the leak counters balanced -- silent wrong data.
# EXPECT_ERROR_CODE: CE2429
struct Holder:
    i32[] items

fn main() i32:
    let Own@(Holder) o = Own.alloc(Holder(from([1, 2, 3])))
    o.get().items.push(9)
    o.destroy()
    return Result.Ok(0)
