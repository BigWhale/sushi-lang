# Shape four of the sixth kind was gated before the ruling: a `poke` borrow of an
# unbound chained expression has no stable address, so CE2404 rejects it. This pins
# that the ruling does not disturb it.
# EXPECT_ERROR_CODE: CE2404
struct Holder:
    i32[] items

fn grow(poke i32[] a) ~:
    a.push(9)
    return Result.Ok(~)

fn main() i32:
    let Own@(Holder) o = Own.alloc(Holder(from([1, 2, 3])))
    grow(poke o.get().items)
    o.destroy()
    return Result.Ok(0)
