# EXPECT_STDOUT_EXACT: "24\n24\n"
# EXPECT_RUNTIME_EXIT: 0
# Minimal reference test
# EXPECT_NO_LEAKS: true

fn test(poke i32 x) i32 | StdError:
    println(x)
    return Result.Ok(42)

fn main() i32:
    let i32 i = 24
    let Result@(i32, StdError) result = test(poke i)
    if (result.is_ok()):
        println(i)
        return 0
    return 1
