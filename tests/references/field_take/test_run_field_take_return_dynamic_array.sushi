# `return nom w.cells` takes a dynamic-array field out of an owned struct and returns
# it. The function returned the field's ADDRESS in place of the descriptor, and the IR
# did not verify (an internal error).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "3 2\n"
struct W:
    i32[] cells
    string name

fn take_cells(nom W w) i32[]:
    return nom w.cells

fn main() i32:
    let W w = W(from([1, 2, 3]), "w{1}")
    let i32[] got = take_cells(nom w)
    println("{got.len()} {got[1]}")
    return 0
