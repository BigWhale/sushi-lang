# #327: a match binding is a read-only view, so calling a `poke self` method on one
# is CE2414 -- the write could never reach the owner.
# EXPECT_ERROR_CODE: CE2414
struct Counter:
    i32 n

extend Counter bump(poke self) ~:
    self.n := self.n + 1
    return ~

fn make() Counter:
    return Result.Ok(Counter(1))

fn main() i32:
    match make():
        Result.Ok(c) -> c.bump()
        Result.Err(_) -> println("e")
    return Result.Ok(0)
