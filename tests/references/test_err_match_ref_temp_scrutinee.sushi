# #300 phase 3: a reference binding needs the scrutinee to HAVE storage -- a temporary
# has none (the backend would spill a copy and the write would land on storage nobody
# reads), so it is CE2404, the no-stable-address code.
# EXPECT_ERROR_CODE: CE2404
enum Shape:
    Poly(i32[])
    Empty

fn make() Shape:
    return Result.Ok(Shape.Poly(from([1])))

fn main() i32:
    match make().realise(Shape.Empty):
        Shape.Poly(poke p) ->
            p.push(9)
        Shape.Empty -> println("empty")
    return Result.Ok(0)
