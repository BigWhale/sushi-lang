# #344: the field-assignment shape of the same rule. The store landed on the binding's
# own copy, so the owner kept its old value and the write was silently lost.
# EXPECT_ERROR_CODE: CE2426
struct Inner:
    i32 n
    i32[] items

struct Outer:
    Inner inner

fn main() i32:
    let Outer o = Outer(Inner(1, from([1, 2])))
    let Inner i = o.inner
    i.n := 42
    return Result.Ok(0)
