# Ruling R11: `match nom r:` CONSUMES the local, exactly as `f(nom r)` does, so a later
# mention of `r` is a use after move.
# TEST_TYPE: error
# EXPECT_ERROR_CODE: CE2405
fn make() i32[]:
    return Result.Ok(from([1, 2, 3]))

fn eat(nom i32[] xs) ~:
    println("eating {xs.len()}")
    return Result.Ok(~)

fn main() i32:
    let Result@(i32[], StdError) r = make()
    match nom r:
        Result.Ok(nom xs) -> eat(nom xs)
        Result.Err(_) -> println("failed")
    match r:
        Result.Ok(ys) -> println(ys.len())
        Result.Err(_) -> println("failed")
    return Result.Ok(0)
