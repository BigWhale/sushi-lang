# Ruling R11: `Ok(nom x)` on a scrutinee the match owns TAKES the payload, so it may be
# handed to a `nom` parameter. The arm is the new owner, and the match frees nothing.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "eating 3\n"
fn make() i32[]:
    return Result.Ok(from([1, 2, 3]))

fn eat(nom i32[] xs) ~:
    println("eating {xs.len()}")
    return Result.Ok(~)

fn main() i32:
    match make():
        Result.Ok(nom xs) -> eat(nom xs)
        Result.Err(_) -> println("failed")
    return Result.Ok(0)
