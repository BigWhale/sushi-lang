# CE2414's help offered `.clone()`, and a resource type has no clone (ruling R3). For a
# resource payload it must name `.share()` instead, exactly as CE2411's help does.
# TEST_TYPE: error
# EXPECT_ERROR_CODE: CE2414
# EXPECT_STDERR_CONTAINS: ".share()"
struct Handle:
    i32 id

extend Handle with Drop:
    fn drop(poke self) ~:
        println("drop {self.id}")

extend Handle bump(poke self) ~:
    self.id := self.id + 1

enum Slot:
    Full(Handle)
    Empty

fn main() i32:
    let Slot s = Slot.Full(Handle(1))
    match s:
        Slot.Full(h) -> h.bump()
        Slot.Empty -> println("empty")
    return Result.Ok(0)
