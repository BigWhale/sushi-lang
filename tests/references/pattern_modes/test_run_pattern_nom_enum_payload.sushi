# A `nom` pattern binding takes a `Maybe@(string)` payload out of the variant whole.
# `match nom s:` hands a local over and the arm gives the value to a `nom` parameter; a
# temporary scrutinee keeps the value to the end of the arm. Each string is destroyed
# once.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "ate note 1\nheld note 2\nempty\n"
enum Shape:
    Tagged(Maybe@(string))
    Blank

fn make(i32 n) Shape:
    if (n == 0):
        return Shape.Blank
    return Shape.Tagged(Maybe.Some("note {n}"))

fn eat(nom Maybe@(string) m) ~:
    let string v = m.realise("none")
    println("ate {v}")

fn main() i32:
    let Shape s = make(1)
    match nom s:
        Shape.Tagged(nom m) -> eat(nom m)
        Shape.Blank -> println("empty")
    match make(2):
        Shape.Tagged(nom m) ->
            let string v = m.realise("none")
            println("held {v}")
        Shape.Blank -> println("empty")
    match make(0):
        Shape.Tagged(nom m) -> eat(nom m)
        Shape.Blank -> println("empty")
    return 0
