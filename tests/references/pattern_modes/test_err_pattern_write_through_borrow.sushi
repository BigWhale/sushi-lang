# Ruling R11 leaves the bare binding alone: it is still a read-only view, so a mutating
# method through it is still CE2414. The two markers are what the help now names.
# TEST_TYPE: error
# EXPECT_ERROR_CODE: CE2414
# EXPECT_STDERR_CONTAINS: "`poke`"
enum Slot:
    Full(i32[])
    Empty

fn main() i32:
    let Slot s = Slot.Full(from([1, 2, 3]))
    match s:
        Slot.Full(p) -> p.push(9)
        Slot.Empty -> println("empty")
    return Result.Ok(0)
