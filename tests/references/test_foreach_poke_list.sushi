# #300 phase 1: List@(T) elements mutate in place through a `&poke` binding --
# List.iter() walks the same {index, length, T*} view an array's iter() does.
# EXPECT_STDOUT_EXACT: "10\n12\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS
fn main() i32:
    let List@(i32) xs = List.new()
    xs.push(5)
    xs.push(6)
    foreach(&poke r in xs.iter()):
        r := r * 2
    foreach(v in xs.iter()):
        println(v)
    xs.free()
    return Result.Ok(0)
