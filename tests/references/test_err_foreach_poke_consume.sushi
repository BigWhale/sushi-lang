# #300 phase 1: a reference binding is a BORROW, so consuming what it points at
# (here: an owning field of the element, into a by-value parameter) is CE2411,
# with .clone() as the escape -- the same rule every reference parameter follows.
# EXPECT_ERROR_CODE: CE2411
fn eat(i32[] a) i32:
    return Result.Ok(a.len())

struct Row:
    i32[] cells

fn main() i32:
    let Row[] rows = from([Row(from([1]))])
    foreach(&poke r in rows.iter()):
        match eat(r.cells):
            Result.Ok(n) -> println(n)
            Result.Err(_) -> println("e")
    return Result.Ok(0)
