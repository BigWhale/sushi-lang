# A `poke self` method takes its receiver's ADDRESS, and a constant has no frame slot.
# The unit next door declares a `var` of this name and is collected first, so a reader
# that asks the FLAT constant table finds storage where this unit has a constant.
# EXPECT_ERROR_CODE: CE2400

use "helpers/rival_names"

const i32 GUARD = 1

extend i32 bump(poke self) ~:
    self := self + 1

fn main() i32:
    GUARD.bump()
    println("{GUARD}")
    return Result.Ok(0)
