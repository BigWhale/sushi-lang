# A unit `var` is storage in the data segment, so a `poke self` method reaches it. The
# unit next door declares a CONSTANT of this name and is collected first, so a reader
# that asks the FLAT constant table finds a constant where this unit has storage.
# EXPECT_STDOUT_EXACT: "1\n"

use "helpers/rival_names"

var i32 SCRATCH = 0

extend i32 lift(poke self) ~:
    self := self + 1

fn main() i32:
    SCRATCH.lift()
    println("{SCRATCH}")
    return Result.Ok(0)
