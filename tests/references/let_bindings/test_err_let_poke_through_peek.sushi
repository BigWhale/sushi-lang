# A `poke` binding out of a `peek` parameter would write the caller's value through a
# read-only borrow (CE2408).
# EXPECT_ERROR_CODE: CE2408

struct Holder:
    i32 n

fn bump(peek Holder h) ~:
    let poke i32 n = h.n
    n := n + 1
    return Result.Ok(~)

fn main() i32:
    let Holder h = Holder(1)
    bump(peek h)
    println("{h.n}")
    return Result.Ok(0)
