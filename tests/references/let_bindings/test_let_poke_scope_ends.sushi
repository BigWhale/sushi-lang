# The binding is block-scoped: once its block ends the owner is free again, so the
# rebind below is legal where it would be CE2412 inside the block.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "5\n100\n"
# EXPECT_NO_LEAKS

struct Holder:
    i32 n

fn main() i32:
    let Own@(Holder) o = Own.alloc(Holder(1))
    let bool bump = true
    if (bump):
        let poke Holder h = o.get()
        h.n := 5
    println("{o.get().n}")
    o := Own.alloc(Holder(100))
    println("{o.get().n}")
    return Result.Ok(0)
