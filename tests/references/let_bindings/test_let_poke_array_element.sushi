# A `let poke` may point at an ELEMENT: the index is bounds-checked once, at the binding,
# and the write lands in the array's buffer.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "1 2\n1 9\n"
# EXPECT_NO_LEAKS

struct Row:
    i32 n

fn main() i32:
    let Row[] rows = from([Row(1), Row(2)])
    println("{rows[0].n} {rows[1].n}")
    let poke Row r = rows[1]
    r.n := 9
    println("{rows[0].n} {rows[1].n}")
    return Result.Ok(0)
