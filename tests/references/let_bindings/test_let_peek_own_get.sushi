# `let peek` reads through a pointer into the payload and copies nothing out.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "7 Mostly\n"
# EXPECT_NO_LEAKS

struct Holder:
    i32 n
    string name

fn main() i32:
    let Own@(Holder) o = Own.alloc(Holder(7, "Mostly"))
    let peek Holder v = o.get()
    println("{v.n} {v.name}")
    return Result.Ok(0)
