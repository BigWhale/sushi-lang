# A `let poke` needs a PLACE -- a local, a field, an element, an Own's payload. A call
# result is a temporary with no stable address (CE2404).
# EXPECT_ERROR_CODE: CE2404

struct Holder:
    i32 n

fn make() Holder:
    return Holder(1)

fn main() i32:
    let poke Holder h = make()
    h.n := 2
    return 0
