# A `let poke` may point at a FIELD of a local: the binding aliases the field's storage,
# and a mutating method through it grows the owner's array.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "0\n2 5\n"
# EXPECT_NO_LEAKS

struct Holder:
    i32 n
    i32[] items

fn main() i32:
    let Holder h = Holder(1, from([]))
    println("{h.items.len()}")
    let poke i32[] items = h.items
    items.push(5)
    items.push(6)
    println("{h.items.len()} {h.items[0]}")
    return Result.Ok(0)
