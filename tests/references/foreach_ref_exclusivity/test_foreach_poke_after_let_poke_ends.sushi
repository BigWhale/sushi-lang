# The `let poke` binding lives in an inner block that ends before the loop, so the
# `foreach(poke r in a.iter())` item is the only writer of `a` and the loop compiles.
# EXPECT_STDOUT_EXACT: "4\n7 7 7 7\n"
# EXPECT_NO_LEAKS

fn main() i32:
    let i32[] a = from([1, 2, 3])
    if (a.len() > 0):
        let poke i32[] w = a
        w.push(9)
    foreach(poke r in a.iter()):
        r := 7
    println(a.len())
    println("{a[0]} {a[1]} {a[2]} {a[3]}")
    return Result.Ok(0)
