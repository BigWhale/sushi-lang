# The same mix in the other order: a `foreach(peek r in a.iter())` item reads `a` while
# the `let poke` binding `w` still writes it, so the loop is CE2407.
# EXPECT_ERROR_CODES_EXACT: CE2407

fn main() i32:
    let i32[] a = from([1, 2, 3])
    let poke i32[] w = a
    foreach(peek r in a.iter()):
        println(r)
    w.push(9)
    return 0
