# Test: `- Returns:` is a singleton; a second one is an error.
# EXPECT_ERROR_CODE: CE7003

##:
Adds two numbers.

- Returns: The sum.
- Returns: The sum, said twice.
:##
fn add(i32 a, i32 b) i32:
    return Result.Ok(a + b)

fn main() i32:
    let i32 n = add(1, 2)??
    println("{n}")
    return Result.Ok(0)
