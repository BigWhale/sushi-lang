# A consumer declares a struct `Color`, and a source library's public enum `Color`
# holds the name. The struct is refused at its declaration (CE0006), with a note at the
# enum. The constructions and the field reads that follow read the lost name and are
# silent: CE0006 is the one diagnostic.
# EXPECT_ERROR_CODE: CE0006
# EXPECT_STDERR_CONTAINS: "already defined as an enum here"
use <lib/types_lib>

struct Color:
    i32 m

fn main() i32:
    let Color p = Color(3)
    let Color q = Color(m: 4)
    println("{p.m} {q.m}")
    return 0
