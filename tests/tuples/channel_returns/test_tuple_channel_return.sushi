# A tuple return with a `| E` channel: `??` in a channel body, `.realise` and `match` outside.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "3 1\n0 0\n3 3\nerr\n"
use <math>

fn divmod(i32 a, i32 b) (i32, i32) | MathError:
    if (b == 0):
        return Result.Err(MathError.DivisionByZero)
    return Result.Ok((a / b, a % b))

fn both(i32 a, i32 b) (i32, i32) | MathError:
    let (i32 q, i32 r) = divmod(a, b)??
    return Result.Ok((q + r, q + r))

fn main() i32:
    let (q, r) = divmod(7, 2).realise((0, 0))
    println("{q} {r}")
    let (i32, i32) z = divmod(7, 0).realise((0, 0))
    println("{z.0} {z.1}")
    match both(5, 3):
        Result.Ok(p) -> println("{p.0} {p.1}")
        Result.Err(_) -> println("err")
    match both(5, 0):
        Result.Ok(p) -> println("{p.0} {p.1}")
        Result.Err(_) -> println("err")
    return 0
