# A destructuring rebind from a borrowed tuple of plain values copies each element.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "34\n3 4\n"

fn spread((i32, i32) p) i32:
    let i32 a = 0
    let i32 b = 0
    (a, b) := p
    return a * 10 + b

fn main() i32:
    let (i32, i32) t = (3, 4)
    println(spread(t))
    println("{t.0} {t.1}")
    return 0
