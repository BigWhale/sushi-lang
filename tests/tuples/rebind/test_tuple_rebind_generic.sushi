# A destructuring rebind in a generic body, with a plain and an owning instance.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "2 1\nsy sx\n"

fn swapped@(T)(nom T x, nom T y) (T, T):
    let T a = x
    let T b = y
    (a, b) := (b, a)
    return (a, b)

fn main() i32:
    let (i32, i32) p = swapped(nom 1, nom 2)
    println("{p.0} {p.1}")
    let string seed = "s"
    let (string, string) q = swapped(nom "{seed}x", nom "{seed}y")
    println("{q.0} {q.1}")
    return 0
