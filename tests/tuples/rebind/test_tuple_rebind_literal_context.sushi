# Each target gives its type to the element of a tuple literal, as `x := 7` does.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "55 89\n0 1\n200 5000000000\n"

fn main() i32:
    let u64 a = 0
    let u64 b = 1
    foreach(_ in 0..10):
        (a, b) := (b, a + b)
    println("{a} {b}")
    (a, b) := (0, 1)
    println("{a} {b}")
    let u8 small = 0
    let i64 big = 0
    (small, big) := (200, 5000000000)
    println("{small} {big}")
    return 0
