# Ruling 13: the whole right side is evaluated first, then each target is assigned from
# left to right. A target that reads an earlier target sees its new value.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "right a\nright b\ntarget first\ntarget second\n2 5 6 7\n2 3\n"

fn right(string tag, i32 v) i32:
    println("right {tag}")
    return v

fn at(string tag, i32 i) i32:
    println("target {tag}")
    return i

fn main() i32:
    let i32[] xs = from([0, 0, 0])
    (xs[at("first", 0)], xs[at("second", 1)]) := (right("a", 5), right("b", 6))
    let i32 i = 0
    (i, xs[i]) := (2, 7)
    println("{i} {xs[0]} {xs[1]} {xs[2]}")
    let i32 a = 1
    let i32 b = 2
    (a, b) := (b, a + b)
    println("{a} {b}")
    return 0
