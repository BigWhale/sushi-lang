# A destructuring rebind in a lambda body and in each unrolled `expand` copy.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "7\n1 int\n2 int\n"

perk Render:
    fn display() string

extend i32 with Render:
    fn display() string:
        return "int"

fn show_all@(...Ts: Render)(...Ts args) ~:
    let string last = ""
    let i32 count = 0
    expand(a in args):
        (last, count) := (a.display(), count + 1)
        println("{count} {last}")

fn main() i32:
    let fn(i32) -> i32 step = |i32 k|:
        let i32 a = 1
        let i32 b = 2
        (a, b) := (b, a + k)
        return a + b
    println(step(4))
    show_all(1, 2)
    return 0
