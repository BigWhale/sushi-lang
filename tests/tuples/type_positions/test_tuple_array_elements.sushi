# A tuple is the element type of a dynamic array and of a fixed array.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "3 9\n2 b\n8\n"

fn main() i32:
    let (i32, i32)[] squares = from([(1, 1), (2, 4)])
    squares.push((3, 9))
    let (i32, i32) last = squares[2]
    println("{squares.len()} {last.1}")

    let (i32, string)[] named = new()
    named.push((1, "a"))
    named.push((2, "b"))
    println("{named[1].0} {named[1].1}")

    let (i32, i32)[4] corners = [(0, 0), (0, 1), (1, 0), (1, 1)]
    let i32 sum = 0
    foreach(c in corners.iter()):
        sum := sum + c.0 + c.1 * 3
    println(sum)
    return 0
