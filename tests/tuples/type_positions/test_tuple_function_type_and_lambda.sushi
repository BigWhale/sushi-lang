# A tuple is a parameter and a return type of a function type and of a lambda.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "2 1\n9 4\n"

fn flip((i32, i32) p) (i32, i32):
    return (p.1, p.0)

fn apply(fn((i32, i32)) -> (i32, i32) f, (i32, i32) p) (i32, i32):
    return f(p)

fn main() i32:
    let fn((i32, i32)) -> (i32, i32) g = flip
    let (i32, i32) a = apply(g, (1, 2))
    println("{a.0} {a.1}")
    let (i32, i32) b = apply(|(i32, i32) p| (p.1 * p.1, p.0 * p.0), (2, 3))
    println("{b.0} {b.1}")
    return 0
