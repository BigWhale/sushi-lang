# An arm that two arms above it cover together; a note names each covering arm.
# EXPECT_ERROR_CODES_EXACT: CE2118
# EXPECT_STDERR_CONTAINS: the arm '(Color.Green, _)' matches these values first

enum Color:
    Red
    Green

fn f((Color, Color) p) i32:
    match p:
        (Color.Red, _) -> return 0
        (Color.Green, _) -> return 1
        (_, Color.Red) -> return 2

fn main() i32:
    return f((Color.Red, Color.Red))
