# The literal arms do not cover the integer element, so the match needs a `_` or a
# binding there. The error names the values that no arm matches, as ranges.
# EXPECT_ERROR_CODES_EXACT: CE2040
# EXPECT_STDERR_CONTAINS: (-2147483648..=-1, _)

enum Color:
    Red
    Green

fn f((i32, Color) p) i32:
    match p:
        (0, _) -> return 0
        (1, Color.Red) -> return 1

fn main() i32:
    return f((0, Color.Red))
