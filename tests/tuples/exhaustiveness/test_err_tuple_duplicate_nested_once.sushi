# A duplicate nested arm is CE2041 too, and it is the one diagnostic for that arm.
# EXPECT_ERROR_CODES_EXACT: CE2041

enum Color:
    Red
    Green

fn f(Maybe@(Color) m) i32:
    match m:
        Maybe.Some(Color.Red) -> return 1
        Maybe.Some(Color.Red) -> return 2
        Maybe.Some(Color.Green) -> return 3
        Maybe.None -> return 0

fn main() i32:
    return f(Maybe.None)
