# A tuple prints a held string quoted, and `.clone()` makes a deep, independent copy.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "("towel", [1, 2])\n("towel", [1, 2, 3])\n("towel", [1, 2])\n"

fn main() i32:
    let (string, i32[]) t = ("towel", from([1, 2]))
    println("{t}")
    let (string, i32[]) copy = t.clone()
    copy.1.push(3)
    println("{copy}")
    println("{t}")
    return 0
