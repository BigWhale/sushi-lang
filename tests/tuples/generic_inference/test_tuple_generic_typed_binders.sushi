# A typed destructure binder in a generic body names the type parameter, and each copy
# substitutes it.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "one 1\n2 two\n"

fn flip@(T, U)(nom (T, U) p) (U, T):
    let (T a, U b) = p
    return (b, a)

fn main() i32:
    let (string, i32) x = flip(nom (1, "one"))
    println("{x.0} {x.1}")
    let (i32, string) y = flip(nom ("two", 2))
    println("{y.0} {y.1}")
    return 0
