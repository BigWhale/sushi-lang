# A destructure of an owned local moves every part, with `_` destroyed, and nothing is freed
# twice.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "b 1\n"

fn main() i32:
    let string seed = "s"
    let (string, (string, i32[])) t = ("{seed}a", ("b", from([1])))
    let (_, rest) = t
    let (name, items) = rest
    println("{name} {items.len()}")
    return 0
