# An enum pattern in a tuple pattern takes an owning payload with `nom`; a failed test
# goes to the next arm with nothing taken.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "ate q!\nother 1\nnone 2\n"

fn eat(nom string s) ~:
    println("ate {s}")

fn make(string s, i32 n) (string, i32):
    return ("{s}!", n)

fn pair(bool some, i32 n) (Maybe@(string), i32):
    let string base = "q"
    if (some):
        return (Maybe.Some("{base}!"), n)
    return (Maybe.None, n)

fn main() i32:
    foreach(i in 0..3):
        match pair(i < 2, i):
            (Maybe.Some(nom s), 0) -> eat(nom s)
            (Maybe.Some(_), n) -> println("other {n}")
            (Maybe.None, n) -> println("none {n}")
    return 0
