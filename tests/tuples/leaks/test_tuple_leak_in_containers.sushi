# Owning tuples held in a List, a dynamic array and an enum payload are freed with them.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "2 1 ok\n"

fn main() i32:
    let string s = "x"
    let List@((string, string)) list = List.new()
    list.push(("{s}1", "{s}2"))
    list.push(("{s}3", "{s}4"))
    let (string, i32[])[] arr = from([("{s}", from([1, 2]))])
    let Maybe@((string, string)) m = Maybe.Some(("{s}5", "ok"))
    let (string, string) got = m.realise(("", ""))
    println("{list.len()} {arr.len()} {got.1}")
    return 0
