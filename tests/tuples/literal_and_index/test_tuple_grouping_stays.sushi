# One expression in parentheses stays grouping, and so does one type in parentheses.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "9 4 2\n"

fn double(i32 x) i32:
    return x * 2

fn main() i32:
    let i32 a = (1 + 2) * 3
    let (fn(i32) -> i32)[] fs = from([double])
    let i32 b = fs[0]((2))
    let (i32, i32) p = ((1), (2))
    println("{a} {b} {p.1}")
    return 0
