# `.N` reads an element, `.N.M` reads into a nested tuple, and a chain of both reads deep.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "1 b\n2 3\n5 6\n4\n"

fn main() i32:
    let (i32, string) t = (1, "b")
    println("{t.0} {t.1}")
    let ((i32, i32), (i32, (i32, i32))) deep = ((2, 3), (4, (5, 6)))
    println("{deep.0.0} {deep.0.1}")
    println("{deep.1.1.0} {deep.1.1.1}")
    let i32 four = deep.1.0
    println(four)
    return 0
