# A tuple match inside a loop takes `continue` and `break`, and a lambda body holds one.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "red 1\nred 3\nstop\n5 2\n"

enum Color:
    Red
    Green

fn main() i32:
    let List@((i32, Color)) xs = List.new()
    xs.push((1, Color.Red))
    xs.push((0, Color.Red))
    xs.push((3, Color.Red))
    xs.push((4, Color.Green))
    xs.push((5, Color.Red))
    foreach(p in xs.iter()):
        match p:
            (0, _) -> continue
            (n, Color.Red) -> println("red {n}")
            (_, Color.Green) ->
                println("stop")
                break
    let fn((i32, i32)) -> i32 f = |(i32, i32) p|:
        match p:
            (0, y) -> return y
            (x, _) -> return x
    println("{f((0, 5))} {f((2, 9))}")
    return 0
