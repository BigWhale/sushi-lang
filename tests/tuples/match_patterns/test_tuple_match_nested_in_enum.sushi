# A tuple pattern nested in an enum payload, with literals and bindings inside it.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "origin\nx axis 5\npoint 2 3\nnone\nok 1 a\nerr\n"

fn where(Maybe@((i32, i32)) m) ~:
    match m:
        Maybe.Some((0, 0)) -> println("origin")
        Maybe.Some((x, 0)) -> println("x axis {x}")
        Maybe.Some((x, y)) -> println("point {x} {y}")
        Maybe.None -> println("none")

fn parse(i32 n) (i32, string) | StdError:
    if (n < 0):
        return Result.Err(StdError.Error)
    return Result.Ok((n, "a"))

fn show(i32 n) ~:
    match parse(n):
        Result.Ok((v, s)) -> println("ok {v} {s}")
        Result.Err(_) -> println("err")

fn main() i32:
    where(Maybe.Some((0, 0)))
    where(Maybe.Some((5, 0)))
    where(Maybe.Some((2, 3)))
    where(Maybe.None)
    show(1)
    show(-1)
    return 0
