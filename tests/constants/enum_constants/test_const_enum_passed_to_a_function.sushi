# A constant enum is read-only storage the program shares. Passing it to a function in a
# loop must not disturb it.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "0:5 1:5 2:5\n"

enum Shape:
    Dot
    Circle(i32)

const Shape UNIT = Shape.Circle(5)

fn radius(Shape s) i32:
    match s:
        Shape.Dot -> return Result.Ok(0)
        Shape.Circle(r) -> return Result.Ok(r)

fn main() i32:
    foreach(i in 0..3):
        print("{i}:{radius(UNIT).realise(-1)}")
        if (i < 2):
            print(" ")
    println("")
    return Result.Ok(0)
