# A flat import brings another unit's public constants into the initializer of a
# constant, exactly as it brings them into a body (#561, face 1).
# EXPECT_STDOUT_EXACT: "8 1\n"
use "helpers/shapes"

const Shape SMALL = UNIT
const i32 DOUBLE = SIZE * 2

fn radius(Shape s) i32:
    match s:
        Shape.Dot -> return Result.Ok(0)
        Shape.Circle(r) -> return Result.Ok(r)

fn main() i32:
    println("{DOUBLE} {radius(SMALL).realise(-1)}")
    return Result.Ok(0)
