# An enum variant behind an alias, with a payload and without, folds into a
# constant like the bare spelling does (#561, face 2).
# EXPECT_STDOUT_EXACT: "2 0\n"
use "helpers/shapes" as sh

const sh.Shape TINY = sh.Shape.Circle(2)
const sh.Shape NONE = sh.Shape.Dot

fn radius(sh.Shape s) i32:
    match s:
        sh.Shape.Dot -> return Result.Ok(0)
        sh.Shape.Circle(r) -> return Result.Ok(r)

fn main() i32:
    println("{radius(TINY).realise(-1)} {radius(NONE).realise(-1)}")
    return Result.Ok(0)
