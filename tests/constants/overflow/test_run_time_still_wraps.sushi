# EXPECT_STDOUT_EXACT: "44\n"
# COMPILER_FLAGS: --overflow=wrap
# The rule applies to an expression whose value the compiler reads. Two locals are not
# one, so the compiler reports nothing, and with `--overflow=wrap` their sum wraps at run
# time.

fn main() i32:
    let u8 a = 200
    let u8 b = 100
    let u8 sum = a + b

    println(sum)
    return 0
