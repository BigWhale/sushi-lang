# Every part kind formats as the program would print it: a string part
# as itself, an integer at its declared width, a float as %g, a bool as
# the run-time interpolation prints one (#447).
# EXPECT_STDOUT_EXACT: "Zaphod has 2 heads, ratio 2.5, sure 1, next 3\n"
const string WHO = "Zaphod"
const u8 HEADS = 2
const f64 RATIO = 2.5
const bool SURE = true
const string LINE = "{WHO} has {HEADS} heads, ratio {RATIO}, sure {SURE}, next {HEADS + 1}"

fn main() i32:
    println(LINE)
    return Result.Ok(0)
