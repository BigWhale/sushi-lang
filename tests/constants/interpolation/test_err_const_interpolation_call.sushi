# A hole is a constant expression like any other: a call in one is
# still refused (#447 changes what CE0108 says nothing about).
# EXPECT_ERROR_CODE: CE0108
fn shout() string:
    return Result.Ok("no")

const string BAD = "call {shout()??}"

fn main() i32:
    println(BAD)
    return Result.Ok(0)
