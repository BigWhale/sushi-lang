# A `let` of a `let` that holds a lent iterator moves it (ruling R-BA). A `peek` return of the
# second `let` gives the caller the iterator, with its state on the heap.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "1\n2\na\n"
use <collections/iter>

fn lend(i32[] xs) peek Iterator@(i32):
    let Iterator@(i32) a = xs.iter()
    let Iterator@(i32) b = a
    return b

fn main() i32:
    let i32[] xs = from([1, 2])
    foreach(x in lend(xs)):
        println(x)
    let string[] names = from(["a"])
    let Iterator@(peek string) first = names.iter()
    let Iterator@(peek string) second = first
    foreach(s in second):
        println(s)
    return 0
