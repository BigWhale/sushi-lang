# A producer over a temporary takes the temporary and keeps it with the state on the heap.
# The value leaves the function, the caller walks it, and the walk drops it once.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "Mostly\nHarmless\n"
use <collections/iter>

fn words() Iterator@(peek string):
    return from(["Mostly", "Harmless"]).iter()

fn main() i32:
    foreach(w in words()):
        println(w)
    return 0
