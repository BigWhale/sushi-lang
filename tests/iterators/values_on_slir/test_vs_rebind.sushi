# A rebind of an owned iterator drops the old value, then stores the new one.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "0\n1\nx\ny\n"
use <collections/iter>

fn main() i32:
    let Iterator@(i32) it = 0..5
    it := 0..2
    foreach(x in it):
        println(x)
    let Iterator@(peek string) words = from(["p", "q"]).iter()
    words := from(["x", "y"]).iter()
    foreach(w in words):
        println(w)
    return 0
