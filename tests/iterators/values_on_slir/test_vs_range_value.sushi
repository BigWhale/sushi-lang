# A range is an owned value in a position that expects `Iterator@(i32)`: a `let`, an
# argument, a return, and a reverse range.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "0\n1\n2\n1\n0\n7\n8\n"
use <collections/iter>

fn walk(nom Iterator@(i32) it) ~:
    foreach(x in it):
        println(x)

fn from_seven() Iterator@(i32):
    return 7..9

fn main() i32:
    let Iterator@(i32) up = 0..2
    walk(nom up)
    walk(nom (0..3).rev())
    walk(nom from_seven())
    return 0
