# At an instance whose item owns, the item keeps its mode: `count@(string)` takes
# `Iterator@(peek string)`, which is not `Iterator@(string)`.
# EXPECT_ERROR_CODES_EXACT: CE2006
use <collections/iter>

fn count@(T)(poke Iterator@(peek T) it, i32 depth) i32:
    if (depth == 0):
        return 0
    return count@(T)(poke it, depth - 1)

fn owning(poke Iterator@(string) it) i32:
    return count@(string)(poke it, 1)

fn main() i32:
    return 0
