# A generic template can write `Iterator@(peek T)`. The template keeps the mode, because
# it does not know whether `T` holds a resource.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "Mostly Harmless\n"
use <collections/iter>

fn count@(T)(poke Iterator@(peek T) it, i32 depth) i32:
    if (depth == 0):
        return 0
    return count@(T)(poke it, depth - 1)

fn main() i32:
    println("Mostly Harmless")
    return 0
