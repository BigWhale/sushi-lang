# A plain item makes one type also in a tuple: `(Iterator@(peek i32), i32)` and
# `(Iterator@(i32), i32)` are one tuple.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "Mostly Harmless\n"
use <collections/iter>

fn owned((Iterator@(i32), i32) held, i32 depth) i32:
    if (depth == 0):
        return 0
    return lent(held, depth - 1)

fn lent((Iterator@(peek i32), i32) held, i32 depth) i32:
    if (depth == 0):
        return 0
    return owned(held, depth - 1)

fn main() i32:
    println("Mostly Harmless")
    return 0
