# A plain item makes one type also inside a generic argument: `Maybe@(Iterator@(peek i32))`
# and `Maybe@(Iterator@(i32))` are one instance.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "Mostly Harmless\n"
use <collections/iter>

fn owned(Maybe@(Iterator@(i32)) held, i32 depth) i32:
    if (depth == 0):
        return 0
    return lent(held, depth - 1)

fn lent(Maybe@(Iterator@(peek i32)) held, i32 depth) i32:
    if (depth == 0):
        return 0
    return owned(held, depth - 1)

fn main() i32:
    println("Mostly Harmless")
    return 0
