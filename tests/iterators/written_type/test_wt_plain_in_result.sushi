# A plain item makes one type also in a `Result` payload: `Result@(Iterator@(peek i32), E)`
# and `Result@(Iterator@(i32), E)` are one instance.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "Mostly Harmless\n"
use <collections/iter>

fn owned(Result@(Iterator@(i32), StdError) held, i32 depth) i32:
    if (depth == 0):
        return 0
    return lent(held, depth - 1)

fn lent(Result@(Iterator@(peek i32), StdError) held, i32 depth) i32:
    if (depth == 0):
        return 0
    return owned(held, depth - 1)

fn main() i32:
    println("Mostly Harmless")
    return 0
