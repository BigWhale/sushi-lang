# A binary library's manifest names `Iterator@(peek string)` in a public signature, and
# a consumer calls the function with an argument of that type.
# BUILD_LIB_BINARY: wt_iter_bin_lib.sushi
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "Mostly Harmless\n"
use <collections/iter>
use <lib/wt_iter_bin_lib>

fn forward(poke Iterator@(peek string) it, i32 depth) i32:
    return walk(poke it, depth)

fn main() i32:
    println("Mostly Harmless")
    return 0
