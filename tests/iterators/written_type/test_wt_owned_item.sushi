# `Iterator@(i32)` is a type a program can write after `use <collections/iter>`: in a
# `poke` parameter and in a by-value parameter.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "Mostly Harmless\n"
use <collections/iter>

fn count(poke Iterator@(i32) it, i32 depth) i32:
    if (depth == 0):
        return 0
    return count(poke it, depth - 1)

fn look(Iterator@(i32) it, i32 depth) i32:
    if (depth == 0):
        return 0
    return look(it, depth - 1)

fn main() i32:
    println("Mostly Harmless")
    return 0
