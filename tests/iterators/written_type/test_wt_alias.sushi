# Behind `use <collections/iter> as it`, the name is `it.Iterator`.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "Mostly Harmless\n"
use <collections/iter> as it

fn count(poke it.Iterator@(peek string) items, i32 depth) i32:
    if (depth == 0):
        return 0
    return count(poke items, depth - 1)

fn main() i32:
    println("Mostly Harmless")
    return 0
