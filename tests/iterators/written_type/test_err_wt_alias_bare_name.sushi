# Behind `use <collections/iter> as it` the name is `it.Iterator`. The bare name is not
# in the flat scope.
# EXPECT_ERROR_CODES_EXACT: CE2001
use <collections/iter> as it

fn count(poke Iterator@(i32) items, i32 depth) i32:
    if (depth == 0):
        return 0
    return count(poke items, depth - 1)

fn main() i32:
    return 0
