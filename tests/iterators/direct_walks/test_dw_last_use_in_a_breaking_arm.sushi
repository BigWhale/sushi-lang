# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "a\n"
# EXPECT_NO_LEAKS
# The last use of a view is in an arm that breaks. The path that does not take the arm has
# no use of the view, so the owner may change after the branch.

fn main() i32:
    let string[] xs = from(["a", "b"])
    let i32 i = 0
    while (i < 3):
        let peek string r = xs[0]
        if (i == 1):
            println(r)
            break
        xs.push("z")
        i := i + 1
    return 0
