# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "3\n60\n"
# EXPECT_NO_LEAKS
# A walk of a map goes past the empty slots and the tombstones, and it sees each entry once.
use <collections/hashmap>

fn main() i32:
    let HashMap@(i32, i32) m = HashMap.new()
    foreach(i in 0..5):
        m.insert(i, i * 10)
    let i32 taken = m.remove(0).realise(0) + m.remove(4).realise(0)
    let i32 count = 0
    let i32 total = taken - taken
    foreach(v in m.values()):
        count := count + 1
        total := total + v
    println(count)
    println(total)
    m.free()
    return 0
