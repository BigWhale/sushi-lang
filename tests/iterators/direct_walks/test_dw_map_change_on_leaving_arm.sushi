# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "2\n"
# EXPECT_NO_LEAKS
# An arm that changes the map and leaves the walk of a view, with a use of the owning item after
# the `if`.
use <collections/hashmap>

fn main() i32:
    let i32 n = 0
    let HashMap@(string, i32) m = HashMap.new()
    m.insert("a{n}", 1)
    foreach(k in m.keys()):
        if (k == "a0"):
            m.insert("b{n}", 2)
            break
        println(k)
    println(m.len())
    m.free()
    return 0
