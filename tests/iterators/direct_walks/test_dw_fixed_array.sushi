# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "2\n3\n5\nmostly\nharmless\n"
# EXPECT_NO_LEAKS
# A direct walk of a `T[N]`, a constant included, and an owning element.

const i32[3] PRIMES = [2, 3, 5]

fn main() i32:
    foreach(p in PRIMES.iter()):
        println(p)
    let i32 n = 0
    let string[2] words = ["mostly{n}", "harmless{n}"]
    foreach(w in words.iter()):
        println(w.s(0, w.len() - 1))
    return 0
