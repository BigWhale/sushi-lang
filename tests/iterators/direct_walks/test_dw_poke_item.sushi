# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "2\n4\nnew\nnew\n"
# EXPECT_NO_LEAKS
# A `poke` item writes through the element: a plain element and an owning one, whose old
# value drops at the write.

fn main() i32:
    let i32[] xs = from([1, 2])
    foreach(poke x in xs.iter()):
        x := x * 2
    foreach(x in xs.iter()):
        println(x)
    let i32 n = 0
    let List@(string) words = List.new()
    words.push("a{n}")
    words.push("b{n}")
    foreach(poke w in words.iter()):
        w := "new"
    foreach(peek w in words.iter()):
        println(w)
    return 0
