# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "new\n"
# EXPECT_NO_LEAKS
# A `poke` item of `.values()` points into the slot of the map.
use <collections/hashmap>

fn main() i32:
    let i32 n = 0
    let HashMap@(i32, string) m = HashMap.new()
    m.insert(1, "old{n}")
    foreach(poke v in m.values()):
        v := "new"
    foreach(peek v in m.values()):
        println(v)
    m.free()
    return 0
