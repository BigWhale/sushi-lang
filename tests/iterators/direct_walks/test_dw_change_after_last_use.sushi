# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "a0\nb0\nc\nc\nd0\nb0\n"
# EXPECT_NO_LEAKS
# An in-place change after the last use of the item is legal, and so are a change after the
# loop and a change that leaves the loop.

fn main() i32:
    let i32 n = 0
    let string[] words = from(["a{n}", "b{n}"])
    foreach(w in words.iter()):
        println(w)
        words[0] := "c"
    foreach(w in words.iter()):
        println(w)
        words.push("d{n}")
        break
    println(words[0])
    println(words[2])
    println(words[1])
    return 0
