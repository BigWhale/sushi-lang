# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "1\n2\n3\n6\n"
# EXPECT_NO_LEAKS
# A direct walk of a `T[]`: a binder with no written type and a binder with one.

fn main() i32:
    let i32[] xs = from([1, 2, 3])
    foreach(n in xs.iter()):
        println(n)
    let i32 total = 0
    foreach(i32 m in xs.iter()):
        total := total + m
    println(total)
    return 0
