# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "0\n"
# EXPECT_NO_LEAKS
# A walk of a map with no entry runs no round.
use <collections/hashmap>

fn main() i32:
    let HashMap@(string, string) m = HashMap.new()
    let i32 count = 0
    foreach(k in m.keys()):
        println(k)
        count := count + 1
    println(count)
    m.free()
    return 0
