# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "a0\nb0\nb0\na0\n1\nb0\n"
# EXPECT_NO_LEAKS
# A temporary owner lives for the whole walk and drops at its end, on each exit. The walk
# freezes nothing, so the source may change in the body.
use <collections/hashmap>

fn make(i32 n) string[]:
    return from(["a{n}", "b{n}"])

fn first_of(string[] words) string:
    foreach(w in words.clone().iter()):
        return w.clone()
    return ""

fn main() i32:
    let i32 n = 0
    foreach(w in make(n).iter()):
        println(w)
    let string[] words = make(n)
    foreach(w in words.clone().iter()):
        words.push(w.clone())
        println(words[1])
        println(first_of(words))
        break
    let HashMap@(i32, string) m = HashMap.new()
    m.insert(1, "x{n}")
    foreach(k in m.clone().keys()):
        println(k)
    m.free()
    foreach(w in make(n).iter()):
        if (w == "b0"):
            println(w)
    return 0
