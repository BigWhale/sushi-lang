# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "3\n2\n1\n2\nx0\ny0\n"
# EXPECT_NO_LEAKS
# A walk in the instance of a generic function, with a discarded and with a bound item.

fn count_of@(T)(T[] xs) i32:
    let i32 count = 0
    foreach(_ in xs.iter()):
        count := count + 1
    return count

fn show_all@(T: Display)(T[] xs) ~:
    foreach(x in xs.iter()):
        println(x)

fn main() i32:
    let i32[] xs = from([1, 2, 3])
    println(count_of(xs))
    let i32 n = 0
    let string[] words = from(["x{n}", "y{n}"])
    println(count_of(words))
    show_all(from([1, 2]))
    show_all(words)
    return 0
