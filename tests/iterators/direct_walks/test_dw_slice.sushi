# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "2\n3\nb0\nc0\n"
# EXPECT_NO_LEAKS
# A direct walk of a slice of a `T[]`, of a plain and of an owning element.

fn main() i32:
    let i32[] xs = from([1, 2, 3, 4])
    foreach(x in xs[1..3].iter()):
        println(x)
    let i32 n = 0
    let string[] words = from(["a{n}", "b{n}", "c{n}"])
    foreach(w in words[1..=2].iter()):
        println(w)
    return 0
