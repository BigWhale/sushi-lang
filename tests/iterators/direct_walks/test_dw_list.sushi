# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "4\n8\nsix0\nseven0\n"
# EXPECT_NO_LEAKS
# A direct walk of a `List@(T)`, of a plain and of an owning element.

fn main() i32:
    let List@(i32) xs = List.new()
    xs.push(4)
    xs.push(8)
    foreach(x in xs.iter()):
        println(x)
    let i32 n = 0
    let List@(string) words = List.new()
    words.push("six{n}")
    words.push("seven{n}")
    foreach(w in words.iter()):
        println(w)
    return 0
