# A return from inside a foreach over a poke value leaves the value where the walk
# stopped, and the caller walks the rest.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "found b\nc\nd\n"
# EXPECT_NO_LEAKS

struct Words:
    string[] items
    i32 pos

extend Words next(poke self) Maybe@(string):
    if (self.pos >= self.items.len()):
        return Maybe.None
    self.pos := self.pos + 1
    return Maybe.Some(self.items[self.pos - 1].clone())

fn find(poke Words w, string wanted) bool:
    foreach(s in w):
        if (s == wanted):
            println("found {s}")
            return true
    return false

fn main() i32:
    let Words w = Words(from(["a", "b", "c", "d"]), 0)
    if (not find(poke w, "b")):
        println("missing")
    foreach(s in w):
        println(s)
    return 0
