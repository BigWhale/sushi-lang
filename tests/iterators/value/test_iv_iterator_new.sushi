# `Iterator.new(nom x)` makes an `Iterator@(T)` with owned items from any value with
# `next()`. The value owns a resource and the items own a string: the iterator frees
# both, and a loop item may be given away.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "one\ntwo\n2\nthree\n"
# EXPECT_NO_LEAKS
use <collections/iter>

struct Words:
    string[] items
    i32 pos

extend Words next(poke self) Maybe@(string):
    if (self.pos >= self.items.len()):
        return Maybe.None
    self.pos := self.pos + 1
    return Maybe.Some(self.items[self.pos - 1].clone())

fn main() i32:
    let Iterator@(string) it = Iterator.new(nom Words(from(["one", "two"]), 0))
    let List@(string) kept = List.new()
    foreach(w in it):
        println(w)
        kept.push(w)
    println(kept.len())
    let Iterator@(string) rest = Iterator.new(nom Words(from(["three", "four"]), 0))
    foreach(w in rest):
        println(w)
        break
    return 0
