# A rebind of an OWNED iterator value drops the old iterator and its state, and then
# stores the new one: a range, an iterator over a temporary array, and `Iterator.new`.
# A rebind of an owned adapter chain drops the old chain with each closure and what it
# captured.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "0\n1\nx\ny\n2\n1\nb0:1\nb0:2\n"
use <collections/iter>

struct Countdown:
    i32 left

extend Countdown next(poke self) Maybe@(i32):
    if (self.left == 0):
        return Maybe.None
    self.left := self.left - 1
    return Maybe.Some(self.left + 1)

fn main() i32:
    let Iterator@(i32) it = 0..5
    it := 0..2
    foreach(x in it):
        println(x)
    let Iterator@(peek string) words = from(["p", "q"]).iter()
    words := from(["x", "y"]).iter()
    foreach(w in words):
        println(w)
    let Iterator@(i32) down = Iterator.new(nom Countdown(5))
    down := Iterator.new(nom Countdown(2))
    foreach(x in down):
        println(x)
    let string a = "a{0}"
    let string b = "b{0}"
    let Iterator@(string) chain = from(["m", "n"]).iter().clone_each().map(nom |string s| "{a}:{s}")
    chain := from(["c", "dd"]).iter().clone_each().map(nom |string s| "{b}:{s.len()}")
    foreach(s in chain):
        println(s)
    return 0
