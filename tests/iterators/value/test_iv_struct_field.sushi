# An owned iterator is a struct field. A callee walks the field in place through
# `poke`, a field take moves it out, and a struct that still holds one destroys it.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "1\n2\na\nb\n10\n1\n"
# EXPECT_NO_LEAKS
use <collections/iter>

struct Span:
    i32 tag
    Iterator@(i32) it

struct Names:
    i32 tag
    Iterator@(peek string) it

fn drain(poke Iterator@(i32) it) ~:
    foreach(x in it):
        println(x)

fn main() i32:
    let Span s = Span(0, 1..3)
    drain(poke s.it)
    let Names n = Names(0, from(["a", "b"]).iter())
    let Iterator@(peek string) taken = nom n.it
    foreach(w in taken):
        println(w)
    let Span kept = Span(tag: 10, it: 0..10)
    let Names unread = Names(1, from(["c"]).iter())
    println(kept.tag)
    println(unread.tag)
    return 0
