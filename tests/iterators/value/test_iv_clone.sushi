# `.clone()` copies the cursor and not the container: the clone of a borrowed iterator
# borrows the same owner, and the clone of an owned iterator walks on its own.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "2\n3\n1\n2\n3\nx 1\nx 2\ny 0\ny 1\ny 2\nb\nb\n2\n"
# EXPECT_NO_LEAKS
use <collections/iter>

fn skip(poke Iterator@(i32) it) i32:
    let i32 seen = 0
    foreach(x in it):
        seen := x
        break
    return seen

fn main() i32:
    let i32[] xs = from([1, 2, 3])
    let Iterator@(i32) a = xs.iter()
    let Iterator@(i32) b = a.clone()
    let i32 s1 = skip(poke a)
    foreach(x in a):
        println(x)
    foreach(x in b):
        println(x)
    let Iterator@(i32) r = 0..3
    let i32 s2 = skip(poke r) + s1
    let Iterator@(i32) r2 = r.clone()
    let i32 s3 = skip(poke r2) + s2
    foreach(x in r):
        println("x {x}")
    let Iterator@(i32) r3 = (0..3)
    let Iterator@(i32) r4 = r3.clone()
    foreach(x in r4):
        println("y {x}")
    let Iterator@(peek string) owned = from(["a", "b"]).iter()
    let Iterator@(peek string) twin = owned.clone()
    let Iterator@(peek string) third = twin.clone()
    foreach(s in owned):
        if (s == "b"):
            println(s)
    foreach(s in third):
        if (s == "b"):
            println(s)
    println(s3)
    return 0
