# A borrowed iterator cannot be stored in a struct field.
# EXPECT_ERROR_CODES_EXACT: CE2411
use <collections/iter>

struct Holder:
    Iterator@(i32) it

fn main() i32:
    let i32[] xs = from([1, 2])
    let Holder h = Holder(xs.iter())
    drain(poke h.it)
    return 0

fn drain(poke Iterator@(i32) it) ~:
    foreach(x in it):
        println(x)
