# A `let` iterator over each container source walks through `next_fn`: a `T[]`, a
# `T[N]` and a `List@(T)`. A callee takes two items through `poke`, and the caller walks
# the rest of the same iterator.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "3\n4\n5\n30\n40\n7\nb c\n"
# EXPECT_NO_LEAKS
use <collections/iter>

fn take_two(poke Iterator@(i32) it) i32:
    let i32 total = 0
    let i32 seen = 0
    foreach(x in it):
        total := total + x
        seen := seen + 1
        if (seen == 2):
            break
    return total

fn main() i32:
    let i32[] dynamic = from([1, 2, 3, 4, 5])
    let Iterator@(i32) a = dynamic.iter()
    let i32 first = take_two(poke a)
    foreach(x in a):
        println(x)
    let i32[4] fixed = [10, 20, 30, 40]
    let Iterator@(i32) f = fixed.iter()
    let i32 skipped = take_two(poke f)
    foreach(x in f):
        println(x)
    let List@(string) words = List.new()
    words.push("a")
    words.push("b")
    words.push("c")
    let Iterator@(peek string) w = words.iter()
    foreach(s in w):
        if (s == "a"):
            println(first + skipped - 30)
            continue
        print("{s}")
        if (s == "b"):
            print(" ")
    println("")
    return 0
