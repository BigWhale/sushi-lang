# `Entry@(K, V)` is not a writable type name, so the iterator of `.entries()` is reached
# through a generic: an iterator over a temporary map owns the map, and it goes through
# a generic function by `nom`.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "b=2\nb=2\n"
# EXPECT_NO_LEAKS
use <collections/hashmap>

fn keep@(T)(nom T it) T:
    return it

fn one_entry() HashMap@(string, i32):
    let HashMap@(string, i32) m = HashMap.new()
    m.insert("b", 2)
    return m

fn main() i32:
    foreach(x in keep(nom one_entry().entries())):
        println("{x.key}={x.value}")
    let HashMap@(string, i32) m = one_entry()
    foreach(x in m.entries()):
        println("{x.key}={x.value}")
    return 0
