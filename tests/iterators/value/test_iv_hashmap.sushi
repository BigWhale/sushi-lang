# A HashMap iterator is a value: `keys()`, `values()` and `pairs()` in a `let`, walked
# later. Each map holds one entry, so the order is fixed.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "a\n1\na:1\n"
# EXPECT_NO_LEAKS
use <collections/iter>
use <collections/hashmap>

fn main() i32:
    let HashMap@(string, i32) m = HashMap.new()
    m.insert("a", 1)
    let Iterator@(peek string) k = m.keys()
    foreach(x in k):
        println(x)
    let Iterator@(i32) v = m.values()
    foreach(x in v):
        println(x)
    let Iterator@((peek string, i32)) p = m.pairs()
    foreach(x in p):
        println("{x.0}:{x.1}")
    return 0
