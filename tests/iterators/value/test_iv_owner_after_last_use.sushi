# A borrowed iterator freezes its owner only until its last use. After the walk the
# owner may change again.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "a\nb\n3\n"
# EXPECT_NO_LEAKS
use <collections/iter>

fn main() i32:
    let string[] names = from(["a", "b"])
    let Iterator@(peek string) it = names.iter()
    foreach(s in it):
        println(s)
    names.push("c")
    println(names.len())
    return 0
