# A range is a value in every position where `Iterator@(i32)` is expected: a `let`, an
# argument, a `return`, a constructor field, a payload and a container element. In an
# array literal a range is still a run of elements.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "6\n3\n3\n1\n9\n5\n6\n3\n2\n1\n0\n3\n"
# EXPECT_NO_LEAKS
use <collections/iter>

struct Span:
    Iterator@(i32) it

fn total(nom Iterator@(i32) it) i32:
    let i32 sum = 0
    foreach(x in it):
        sum := sum + x
    return sum

fn upto(i32 n) Iterator@(i32):
    return 0..n

fn main() i32:
    let Iterator@(i32) r = 0..4
    println(total(nom r))
    println(total(nom 1..3))
    println(total(nom upto(3)))
    let Span s = Span(it: 1..=1)
    println(total(nom s.it))
    let Maybe@(Iterator@(i32)) m = Maybe.Some(4..6)
    match nom m:
        Maybe.Some(nom it) -> println(total(nom it))
        Maybe.None -> println("none")
    let List@(Iterator@(i32)) l = List.new()
    l.push(5..6)
    l.push(6..=6)
    match l.pop():
        Maybe.Some(nom it) -> println(total(nom it) - 1)
        Maybe.None -> println("none")
    match l.pop():
        Maybe.Some(nom it) -> println(total(nom it) + 1)
        Maybe.None -> println("none")
    let Iterator@(i32) down = (0..4).rev()
    foreach(x in down):
        println(x)
    let i32[] run = from([0..3])
    println(run.len())
    return 0
