# A borrowed iterator cannot be given to a user function with `nom`: the type does not
# show the borrow, so the callee could keep it.
# EXPECT_ERROR_CODES_EXACT: CE2411
use <collections/iter>

fn total(nom Iterator@(i32) it) i32:
    let i32 sum = 0
    foreach(x in it):
        sum := sum + x
    return sum

fn main() i32:
    let i32[] xs = from([1, 2])
    let Iterator@(i32) it = xs.iter()
    println(total(nom it))
    return 0
