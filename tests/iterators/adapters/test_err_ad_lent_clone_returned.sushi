# The clone of an adapter over a borrowed iterator borrows the same owner, so it cannot
# leave its function either.
# EXPECT_ERROR_CODES_EXACT: CE2411
use <collections/iter>

fn doubled(i32[] xs) Iterator@(i32):
    let Iterator@(i32) twin = xs.iter().map(nom |i32 x| x * 2).clone()
    return twin

fn main() i32:
    let i32[] xs = from([1, 2])
    foreach(x in doubled(xs)):
        println(x)
    return 0
