# The adapters in a generic body: the template is checked one time with `T` opaque, so a
# `peek T` item is copied with `clone_each` before `collect` keeps it.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "1:y\n1:20\n"
# EXPECT_NO_LEAKS

fn numbered@(T: Clone)(T[] xs) List@((i32, T)):
    return xs.iter().clone_each().enumerate().collect()

fn main() i32:
    let string[] names = from(["x", "y"])
    let List@((i32, string)) a = numbered(names)
    let (i, s) = a.get(1).realise((0, ""))
    println("{i}:{s}")
    let i32[] nums = from([10, 20])
    let List@((i32, i32)) b = numbered(nums)
    let (j, n) = b.get(1).realise((0, 0))
    println("{j}:{n}")
    return 0
