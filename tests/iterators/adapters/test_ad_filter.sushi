# `filter` over each source: an array, a List, a range and a HashMap. The item keeps its
# mode: a `peek string` item stays a borrow, and nothing is copied.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "2 4\nbb\nccc\n0 3 6 9\n4\n"
# EXPECT_NO_LEAKS
use <collections/iter>
use <collections/hashmap>

fn show(List@(i32) xs) ~:
    let i32 i = 0
    foreach(x in xs.iter()):
        if (i > 0):
            print(" ")
        print("{x}")
        i := i + 1
    println("")

fn main() i32:
    let i32[] xs = from([1, 2, 3, 4])
    show(xs.iter().filter(nom |i32 x| x % 2 == 0).collect())
    let List@(string) words = List.new()
    words.push("a")
    words.push("bb")
    words.push("ccc")
    let Iterator@(peek string) long = words.iter().filter(nom |string w| w.len() > 1)
    foreach(s in long):
        println(s)
    let Iterator@(i32) r = 0..10
    show(r.filter(nom |i32 x| x % 3 == 0).collect())
    let HashMap@(i32, string) m = HashMap.new()
    m.insert(4, "four")
    m.insert(2, "two")
    show(m.keys().filter(nom |i32 k| k > 3).collect())
    return 0
