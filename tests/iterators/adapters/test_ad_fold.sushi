# `fold` over each source: an array, a List, a range and a HashMap. Each item goes to the
# function as a borrow, and the accumulator is owned: a string accumulator is replaced at
# each step, and the old one is freed.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "6\n3\n<a><bb>\n10\n7\n"
# EXPECT_NO_LEAKS
use <collections/iter>
use <collections/hashmap>

fn main() i32:
    let i32[] xs = from([1, 2, 3])
    println(xs.iter().fold(nom 0, nom |i32 acc, i32 x| acc + x))
    let List@(string) words = List.new()
    words.push("a")
    words.push("bb")
    println(words.iter().fold(nom 0, nom |i32 acc, string w| acc + w.len()))
    println(words.iter().fold(nom "", nom |string acc, string w| "{acc}<{w}>"))
    let Iterator@(i32) r = 0..5
    println(r.fold(nom 0, nom |i32 acc, i32 x| acc + x))
    let HashMap@(string, i32) m = HashMap.new()
    m.insert("seven", 7)
    println(m.values().fold(nom 0, nom |i32 acc, i32 v| acc + v))
    return 0
