# `zip` over each source: an array, a List, a range and a HashMap. It stops at the end of
# the shorter side, and each side keeps its own item mode: two `peek string` sides give
# `Iterator@((peek string, peek string))`, and nothing is copied.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "1 a\n2 bb\na-x\nbb-y\n0 7\n"
# EXPECT_NO_LEAKS
use <collections/iter>
use <collections/hashmap>

fn main() i32:
    let i32[] xs = from([1, 2, 3])
    let List@(string) words = List.new()
    words.push("a")
    words.push("bb")
    foreach(p in xs.iter().zip(nom words.iter())):
        println("{p.0} {p.1}")
    let string[] others = from(["x", "y", "z"])
    let Iterator@((peek string, peek string)) both = words.iter().zip(nom others.iter())
    foreach((w, o) in both):
        println("{w}-{o}")
    let Iterator@(i32) r = 0..5
    let HashMap@(string, i32) m = HashMap.new()
    m.insert("seven", 7)
    foreach(q in r.zip(nom m.values())):
        println("{q.0} {q.1}")
    return 0
