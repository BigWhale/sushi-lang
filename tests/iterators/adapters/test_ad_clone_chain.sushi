# `.clone()` of a chain copies each state and each closure. The clone of a borrowed chain
# borrows the same owner; the clone of an owned chain walks on its own.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "a!\nbb!\na!\nbb!\n2\n4\n2\n4\n"
# EXPECT_NO_LEAKS
use <collections/iter>

fn main() i32:
    let string mark = "!"
    let string[] names = from(["a", "bb"])
    let Iterator@(string) loud = names.iter().map(nom |string s| "{s}{mark}")
    let Iterator@(string) twin = loud.clone()
    foreach(s in loud):
        println(s)
    foreach(s in twin):
        println(s)
    let Iterator@(i32) r = 1..3
    let Iterator@(i32) doubled = r.map(nom |i32 x| x * 2)
    let Iterator@(i32) copy = doubled.clone()
    foreach(x in doubled):
        println(x)
    foreach(x in copy):
        println(x)
    return 0
