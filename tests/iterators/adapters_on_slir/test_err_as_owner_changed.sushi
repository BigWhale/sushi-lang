# A lent chain freezes its owner to its last use: a push to the array before the walk is
# an error.
# EXPECT_ERROR_CODES_EXACT: CE2412
use <collections/iter>

fn main() i32:
    let i32[] xs = from([1, 2])
    let Iterator@(i32) chain = xs.iter().filter(nom |i32 x| x > 0).map(nom |i32 x| x * 2)
    xs.push(3)
    foreach(x in chain):
        println(x)
    return 0
