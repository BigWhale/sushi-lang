# A lent chain cannot leave through an owned return: it borrows the local array.
# EXPECT_ERROR_CODES_EXACT: CE2411
use <collections/iter>

fn leak() Iterator@(i32):
    let i32[] xs = from([1, 2])
    return xs.iter().map(nom |i32 x| x + 1)

fn main() i32:
    foreach(x in leak()):
        println(x)
    return 0
