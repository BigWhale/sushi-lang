# The clone of a chain copies each state and each closure. The clone and the chain walk
# the same items, and each is dropped one time.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "a+\nbb+\na+\nbb+\n2\n4\n2\n4\n"
use <collections/iter>

fn main() i32:
    let string tail = "+"
    let string[] names = from(["a", "bb"])
    let Iterator@(string) lent = names.iter().map(nom |string s| s.concat(tail))
    foreach(s in lent.clone()):
        println(s)
    foreach(s in lent):
        println(s)
    let Iterator@(i32) r = 1..3
    let Iterator@(i32) owned = r.map(nom |i32 x| x * 2)
    let Iterator@(i32) again = owned.clone()
    foreach(x in owned):
        println(x)
    foreach(x in again):
        println(x)
    return 0
