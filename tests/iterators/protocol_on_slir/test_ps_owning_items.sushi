# A `next()` that answers an owning item: the item is an owned local of the round, and the
# iterator and the item drop at the end, at a `break` and at a `return`.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "a\nb\nc\na\nfound b\n"
# EXPECT_NO_LEAKS

struct Words:
    string[] items
    i32 pos

extend Words next(poke self) Maybe@(string):
    if (self.pos >= self.items.len() as i32):
        return Maybe.None
    self.pos := self.pos + 1
    return Maybe.Some(self.items[self.pos - 1].clone())

fn words() Words:
    return Words(from(["a", "b", "c"]), 0)

fn find(string wanted) string:
    let Words w = words()
    foreach(s in w):
        if (s == wanted):
            return "found {s}"
    return "none"

fn main() i32:
    let Words all = words()
    foreach(s in all):
        println(s)
    let Words first = words()
    foreach(s in first):
        println(s)
        break
    println(find("b"))
    return 0
