# A walk of a temporary with `next()`: the loop holds the value, and it drops after the loop.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "p\nq\n1\n"
# EXPECT_NO_LEAKS

struct Words:
    string[] items
    i32 pos

extend Words next(poke self) Maybe@(string):
    if (self.pos >= self.items.len()):
        return Maybe.None
    self.pos := self.pos + 1
    return Maybe.Some(self.items[self.pos - 1].clone())

struct Countdown:
    i32 at

extend Countdown next(poke self) Maybe@(i32):
    if (self.at <= 0):
        return Maybe.None
    let i32 now = self.at
    self.at := self.at - 1
    return Maybe.Some(now)

fn words() Words:
    return Words(from(["p", "q"]), 0)

fn main() i32:
    foreach(s in words()):
        println(s)
    foreach(n in Countdown(1)):
        println(n)
    return 0
