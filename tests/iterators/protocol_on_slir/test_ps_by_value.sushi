# A type with `next()` walked by value: the loop takes the local, and each round calls `next()`.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "3\n2\n1\n"
# EXPECT_NO_LEAKS

struct Countdown:
    i32 at

extend Countdown next(poke self) Maybe@(i32):
    if (self.at <= 0):
        return Maybe.None
    let i32 now = self.at
    self.at := self.at - 1
    return Maybe.Some(now)

fn main() i32:
    let Countdown c = Countdown(3)
    foreach(n in c):
        println(n)
    return 0
