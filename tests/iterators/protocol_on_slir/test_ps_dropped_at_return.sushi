# A protocol iterator that owns a resource drops at a `return` before its end, and an item
# that the body moves away does not drop again.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "2\nmoved a\n"
# EXPECT_NO_LEAKS

struct Words:
    string[] items
    i32 pos

extend Words next(poke self) Maybe@(string):
    if (self.pos >= self.items.len() as i32):
        return Maybe.None
    self.pos := self.pos + 1
    return Maybe.Some(self.items[self.pos - 1].clone())

fn count_to(i32 limit) i32:
    let Words w = Words(from(["x", "y", "z"]), 0)
    let i32 n = 0
    foreach(_ in w):
        n := n + 1
        if (n == limit):
            return n
    return n

fn keep(nom string s) string:
    return "moved {s}"

fn first_moved() string:
    foreach(s in Words(from(["a", "b"]), 0)):
        return keep(nom s)
    return "none"

fn main() i32:
    println(count_to(2))
    println(first_moved())
    return 0
