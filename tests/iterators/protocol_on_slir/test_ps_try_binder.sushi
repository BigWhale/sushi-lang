# A `??` binder over `Maybe@(Result@(string, Bad))` in a `| Bad` function: the first `Err`
# leaves the function, and the iterator and the items drop on that path.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "ok one\nok two\nfailed\nok one\nok two\nok three\nfinished\n"
# EXPECT_NO_LEAKS

error Bad:
    Broken()

struct Steps:
    string[] items
    i32 pos
    i32 fail_at

extend Steps next(poke self) Maybe@(Result@(string, Bad)):
    if (self.pos >= self.items.len() as i32):
        return Maybe.None
    self.pos := self.pos + 1
    if (self.pos == self.fail_at):
        return Maybe.Some(Result.Err(Bad.Broken))
    return Maybe.Some(Result.Ok(self.items[self.pos - 1].clone()))

fn walk(i32 fail_at) ~ | Bad:
    let Steps s = Steps(from(["one", "two", "three"]), 0, fail_at)
    foreach(word?? in s):
        println("ok {word}")
    return Result.Ok(~)

fn report(i32 fail_at) ~:
    match walk(fail_at):
        Result.Ok(_) -> println("finished")
        Result.Err(_) -> println("failed")

fn main() i32:
    report(3)
    report(9)
    return 0
