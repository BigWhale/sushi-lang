# The consumer imports reex_b itself and through the re-export of reex_a: one
# declaration that two paths reach is one candidate.
# BUILD_LIB: reex_b.sushi
# BUILD_LIB: reex_a.sushi
# EXPECT_STDOUT_EXACT: "8\n8\n"
use <lib/reex_a>
use <lib/reex_b>

fn main() i32:
    println("{a_val()}")
    println("{b_val() + 1}")
    return 0
