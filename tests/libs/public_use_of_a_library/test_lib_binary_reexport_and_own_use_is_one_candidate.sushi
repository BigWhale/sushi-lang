# The binary twin: the consumer's own `use <lib/reex_b>` and the record of reex_a name
# one declaration, so `b_val` is one candidate.
# BUILD_LIB: reex_b.sushi
# BUILD_LIB_BINARY: reex_a.sushi
# EXPECT_STDOUT_EXACT: "8\n8\n"
use <lib/reex_a>
use <lib/reex_b>

fn main() i32:
    println("{a_val()}")
    println("{b_val() + 1}")
    return 0
