# A source library says `public use <lib/reex_b>`: the consumer's build loads reex_b,
# and the consumer writes `b_val()` with no import of its own.
# BUILD_LIB: reex_b.sushi
# BUILD_LIB: reex_a.sushi
# EXPECT_STDOUT_EXACT: "8\n8\n"
use <lib/reex_a>

fn main() i32:
    println("{a_val()}")
    println("{b_val() + 1}")
    return 0
