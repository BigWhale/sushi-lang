# A binary library ships its `public use <lib/reex_b>` as a manifest record: the
# consumer's build loads the source library reex_b from the record.
# BUILD_LIB: reex_b.sushi
# BUILD_LIB_BINARY: reex_a.sushi
# EXPECT_STDOUT_EXACT: "8\n8\n"
use <lib/reex_a>

fn main() i32:
    println("{a_val()}")
    println("{b_val() + 1}")
    return 0
