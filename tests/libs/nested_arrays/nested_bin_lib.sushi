# A library with a nested array in each public position.

public const i32[2][3] TABLE = [[1, 2], [3, 4], [5, 6]]

public struct Grid:
    i32[][] rows
    i32[2][3] block

public fn make_grid(i32 n) Grid:
    let i32[][] rows = new()
    foreach(i in 0..n):
        rows.push(from([i; i + 1]))
    return Grid(rows, TABLE)

public fn total(i32[][] g) i32:
    let i32 sum = 0
    foreach(row in g.iter()):
        foreach(x in row.iter()):
            sum := sum + x
    return sum

public fn rows_of(i32[2][3] m) i32[2][]:
    let i32[2][] out = new()
    foreach(row in m.iter()):
        out.push(row)
    return out

public fn grow(poke string[][] g, string v) ~:
    foreach(poke row in g.iter()):
        row.push(v.clone())
