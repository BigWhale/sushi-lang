# a BINARY library hands out a nested array in each public position: a parameter in two
# modes, a return, a struct field and a fixed-of-fixed constant.
# BUILD_LIB_BINARY: nested_bin_lib.sushi
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "3 2 2\n6 3\n5 4\n2 x\n8 2\n"
use <lib/nested_bin_lib>

fn main() i32:
    let Grid g = make_grid(3)
    println("{g.rows.len()} {g.rows[2][0]} {g.rows[1].len()}")
    println("{TABLE[2][1]} {TABLE.len()}")
    let i32[2][] r = rows_of(g.block)
    println("{r[2][0]} {r[1][1]}")
    let string[][] s = from([from(["a"]), new()])
    grow(poke s, "x")
    println("{s[0].len()} {s[1][0]}")
    println("{total(g.rows)} {g.block[0][1]}")
    return 0
