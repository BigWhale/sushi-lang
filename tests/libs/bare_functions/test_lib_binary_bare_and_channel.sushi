# A BINARY library records the channel of each function in its manifest: `double` is
# bare at the consumer and `checked` answers a Result.
# BUILD_LIB_BINARY: bare_bin_lib.sushi
# EXPECT_STDOUT_EXACT: "8\nok 3\nerr\n"
use <lib/bare_bin_lib>

fn show(Result@(i32, StdError) r) ~:
    match r:
        Result.Ok(n) -> println("ok {n}")
        Result.Err(_) -> println("err")

fn main() i32:
    println(double(4))
    show(checked(3))
    show(checked(-3))
    return 0
