# The entry unit. It holds the type and the implementation; the contract is next door.
use "contract"

public struct Gadget:
    i32 base

extend Gadget with Fallible:
    fn probe(i32 n) i32 | GadgetError:
        if (n < 0):
            return Result.Err(GadgetError.OutOfRange)
        return self.base + n
