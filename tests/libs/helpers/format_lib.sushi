# Phase 3 producer: a printf-like variadic-generic (parameter-pack) public
# function. The library ships the `Render` perk definition plus the
# `show_all<...Ts: Render>` pack template; the consumer supplies the per-type
# `Render` implementations for the types it instantiates the pack with.
public perk Render:
    fn display() string

public fn show_all@(...Ts: Render)(...Ts args) ~:
    expand(a in args):
        println(a.display())
