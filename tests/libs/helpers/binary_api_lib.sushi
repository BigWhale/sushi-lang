# A BINARY library whose manifest carries every arm the consumer's `libraries` step
# reads from the registry and the templates: a public struct, a public enum with a
# payload, a public perk with a concrete implementation, a constrained generic
# function, a generic enum template, a parameter pack, and a kept private helper.
public struct Crate:
    i32 weight
    string label

public enum Mood:
    Calm
    Loud(i32)

public perk Weigh:
    fn weigh() i32

extend i32 with Weigh:
    fn weigh() i32:
        return self * 10

extend Crate with Weigh:
    fn weigh() i32:
        return self.weight

public fn heavier@(T: Weigh)(nom T a, nom T b) T:
    if (a.weigh() > b.weigh()):
        return a
    return b

public enum Opt@(T):
    Nope
    Yep(T)

public fn wrap_opt@(T)(nom T v) Opt@(T):
    return Opt.Yep(v)

public perk Display:
    fn display() string

public fn show_all@(...Ts: Display)(...Ts args) ~ | StdError:
    expand(a in args):
        println(a.display())
    return Result.Ok(~)

fn kept(i32 n) i32:
    return n + 1

public fn describe(Crate c, Mood m) string:
    match m:
        Mood.Calm -> return "{c.label} calm {kept(c.weight)}"
        Mood.Loud(n) -> return "{c.label} loud {n}"
