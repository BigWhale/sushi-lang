public fn varlib_total(...i32 nums) i32:
    let i32 sum = 0
    foreach(n in nums.iter()):
        sum := sum + n
    return sum

public fn varlib_join(string prefix, ...string words) string:
    let string text = prefix.clone()
    foreach(w in words.iter()):
        text := "{text} {w}"
    return text
