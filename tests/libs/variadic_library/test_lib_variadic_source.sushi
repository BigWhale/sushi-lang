# A source library has a public native variadic function (`...T`). The consumer calls it with 0, 1 and 3 arguments, and with a bloom of an array.
# BUILD_LIB: varlib.sushi
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "0\n7\n6\nMostly\nMostly Harmless\nMostly Harmless again and again\n15\n"
use <lib/varlib>

fn main() i32:
    println("{varlib_total()}")
    println("{varlib_total(7)}")
    println("{varlib_total(1, 2, 3)}")
    println(varlib_join("Mostly"))
    println(varlib_join("Mostly", "Harmless"))
    println(varlib_join("Mostly", "Harmless", "again", "and again"))
    let i32[] xs = from([4, 5, 6])
    println("{varlib_total(xs...)}")
    return 0
