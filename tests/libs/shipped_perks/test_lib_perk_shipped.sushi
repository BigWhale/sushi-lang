# Consumer instantiates the library's constrained generic max_of<T: Greater> at
# T = i32 WITHOUT redeclaring `perk Greater`. The perk DEFINITION ships in the
# library's .slib templates section (Phase 2 Step A), so the consumer only has
# to provide the implementation for its own instantiation type. Proves perk
# definitions cross the library boundary.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "5\n"

use <lib/generics_lib>

# No `perk Greater:` here - the contract is shipped by the library. We only supply
# the i32 implementation that the constrained generic requires.
extend i32 with Greater:
    fn gt(i32 other) bool:
        return self > other

fn run_test() i32:
    let i32 m = max_of(3, 5)
    return m

fn main() i32:
    let i32 result = run_test()
    println(result)
    return 0
