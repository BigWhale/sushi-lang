# A binary library tagged for linux on an architecture that no host has. On a linux host it is the same OS and another architecture, and the consumer must refuse it (CE3504).
# BUILD_LIB_BINARY: tag_lib.sushi
# LIB_MANIFEST_SET: tag_lib platform=linux_riscv64
# EXPECT_ERROR_CODE: CE3504
# EXPECT_STDERR_CONTAINS: "library compiled for 'linux_riscv64', current platform is '"
use <lib/tag_lib>

fn main() i32:
    println("{tag_area(2, 3)}")
    return 0

