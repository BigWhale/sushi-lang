# C1 (P2-5 Phase 3): the library's constrained generic max_of<T: Greater> is
# instantiated at TWO types (i32 and i64) in one consumer, each with its own
# consumer-supplied Greater implementation. Removing either extend block makes the
# corresponding instantiation fail CE4006, so both witnesses are exercised.
# The i64 values exceed i32 range on purpose (issue #84 regression witness).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_CONTAINS: "7"
# EXPECT_STDOUT_CONTAINS: "40000000000"

use <lib/generics_lib>

# The Greater perk definition ships with the library; the consumer supplies one
# implementation per instantiation type. The perk signature is fixed at
# gt(i32 other), so the i64 impl casts before comparing.
extend i32 with Greater:
    fn gt(i32 other) bool:
        return self > other

extend i64 with Greater:
    fn gt(i32 other) bool:
        return self > (other as i64)

fn max32() i32:
    let i32 m = max_of(3, 7)
    return m

fn max64() i64:
    let i64 big = 40000000000 as i64
    let i64 small = 2 as i64
    let i64 m = max_of(big, small)
    return m

fn main() i32:
    let i32 r32 = max32()
    println(r32)
    let i64 r64 = max64()
    println(r64)
    return 0
