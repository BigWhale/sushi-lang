# A source library's public generic type is a name only in a unit that imports the
# library. The entry unit imports it; the second unit does not.
# BUILD_LIB: lsp_a.sushi
# EXPECT_ERROR_CODE: CE2001
# EXPECT_STDERR_CONTAINS: lsp_helper_generic_type.sushi:
use <lib/lsp_a>
use "lsp_helper_generic_type"

fn main() i32:
    println("{a_val()} {helper_val()}")
    return 0
