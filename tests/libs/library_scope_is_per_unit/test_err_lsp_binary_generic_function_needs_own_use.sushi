# A binary library's public generic function is a name only in a unit that imports the
# library. The entry unit imports it; the second unit does not.
# BUILD_LIB_BINARY: lsp_a.sushi
# EXPECT_ERROR_CODE: CE2008
# EXPECT_STDERR_CONTAINS: lsp_helper_generic_function.sushi:
use <lib/lsp_a>
use "lsp_helper_generic_function"

fn main() i32:
    println("{a_val()} {helper_val()}")
    return 0
