# A binary library's public type is a name only in a unit that imports the
# library. The entry unit imports it; the second unit does not.
# BUILD_LIB_BINARY: lsp_a.sushi
# EXPECT_ERROR_CODE: CE2001
# EXPECT_STDERR_CONTAINS: lsp_helper_type.sushi:
use <lib/lsp_a>
use "lsp_helper_type"

fn main() i32:
    println("{a_val()} {helper_val()}")
    return 0
