# A binary library ships its generic template in the manifest, and the consumer checks
# the instance it makes. The unused parameter and the unused local in that template are
# the author's warnings: the author's build reports them, because a template is checked
# where it is written (#1070), and the consumer reports none of them and exits 0 (#1007).
# BUILD_LIB_WARNS: lint_bin_tpl_lib.sushi binary -> CW1001
# EXPECT_STDOUT_EXACT: "3\n"
# EXPECT_STDERR_EMPTY: true
use <lib/lint_bin_tpl_lib>

fn main() i32:
    println(count_three(5))
    return 0
