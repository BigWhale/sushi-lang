# Two binary libraries each declare `public extend i32 doubled()`, and each of the
# two units of this program imports both and calls the method. Each call is an
# error, with a note at each declaration. Phase 3 of the extension-visibility work
# gives this error its code; until then the fixture reads the exit code and the
# text.
# BUILD_LIB_BINARY: ld_mx_p.sushi
# BUILD_LIB_BINARY: ld_mx_q.sushi
# EXPECT_STDERR_CONTAINS: "ld_mx_helper.sushi:5:"
# EXPECT_STDERR_CONTAINS: "ld_mx_p"
# EXPECT_STDERR_CONTAINS: "ld_mx_q"
# EXPECT_STDERR_CONTAINS: "test_err_lib_dep_binary_extension_in_two_units.sushi:18:"
use <lib/ld_mx_p>
use <lib/ld_mx_q>
use "ld_mx_helper"

fn main() i32:
    let i32 n = 5
    println("{n.doubled()}")
    println("{helped(n)}")
    return 0
