# A source library says a plain `use <lib/ld_b>` over a source ld_b. The plain
# `use` loads ld_b and gives the consumer no name of it.
# BUILD_LIB: ld_b.sushi
# BUILD_LIB: ld_a_plain.sushi
# EXPECT_ERROR_CODES_EXACT: CE2008
use <lib/ld_a_plain>

fn main() i32:
    println("{a_val()}")
    println("{b_val()}")
    return 0
