# A template of a library built with --overflow=wrap is monomorphized in the consumer, so
# it follows the mode of the consumer: in the default mode, the overflow traps.
# BUILD_LIB_BINARY: ovf_wrap_lib.sushi
# LIB_FLAGS: --overflow=wrap
# EXPECT_RUNTIME_EXIT: 1
# EXPECT_STDOUT_EXACT: ""
# EXPECT_STDERR_CONTAINS: "RE2032"
use <lib/ovf_wrap_lib>

fn main(string[] args) i32:
    let Tally@(i32) t = Tally(7)
    println("{t.add(2147483647, args.len())}")
    return 0
