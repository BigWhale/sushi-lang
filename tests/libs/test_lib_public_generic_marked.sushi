# The public half of the same library: marking the generic makes it callable,
# which is what makes `public` the discriminator and not an accident (#467).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_CONTAINS: "7"

use <lib/private_generic_lib>

fn main() i32:
    let i32 a = marked(nom 7).realise(0)
    println("{a}")
    return Result.Ok(0)
