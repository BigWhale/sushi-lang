# A generic ENUM template travels through a BINARY library and is monomorphized at
# the consumer, as a generic struct template does (#675). The consumer names the
# instantiation in a signature, constructs a variant bare and matches on both.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "yep 42\nnope\n"
# EXPECT_NO_LEAKS
use <lib/binary_api_lib>

fn show(Opt@(i32) o) i32:
    match o:
        Opt.Yep(v) -> println("yep {v}")
        Opt.Nope -> println("nope")
    return 0

fn main() i32:
    let i32 answer = 42
    let Opt@(i32) some = wrap_opt(nom answer)
    let Opt@(i32) none = Opt.Nope
    let i32 a = show(some)
    let i32 b = show(none)
    return a + b
