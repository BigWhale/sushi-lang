# A binary library: the consumer calls a conversion of the library: `??` turns a LibError into an AppError.
# The call names the link symbol of the manifest (ir.md 8.6, S26).
# BUILD_LIB_BINARY: lc_callee_lib.sushi -> lc_bin.slib
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "4\nodd\n"
# EXPECT_NO_LEAKS
use <lib/lc_bin>

fn run(i32 n) i32 | AppError:
    let i32 v = half(n)??
    return Result.Ok(v)

fn main() i32:
    println(run(8).realise(0))
    match run(3):
        Result.Ok(v) -> println(v)
        Result.Err(AppError.Lib(LibError.Odd)) -> println("odd")
    return 0
