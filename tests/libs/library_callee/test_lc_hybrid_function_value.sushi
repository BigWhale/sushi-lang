# A hybrid library: the consumer calls a function of the library as a value, passed to a local higher-order function.
# The call names the link symbol of the manifest (ir.md 8.6, S26).
# BUILD_LIB_HYBRID: lc_callee_lib.sushi -> lc_hyb.slib
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "42\n"
# EXPECT_NO_LEAKS
use <lib/lc_hyb>

fn apply(fn(i32) -> i32 f, i32 x) i32:
    return f(x)

fn main() i32:
    println(apply(twice, 21))
    return 0
