# A hybrid library: the consumer calls an extension method and a static of a library type.
# The call names the link symbol of the manifest (ir.md 8.6, S26).
# BUILD_LIB_HYBRID: lc_callee_lib.sushi -> lc_hyb.slib
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "true made\nfalse box\n"
# EXPECT_NO_LEAKS
use <lib/lc_hyb>

fn main() i32:
    let Crate made = Crate.of(150)
    println("{made.heavy()} {made.label}")
    let Crate small = Crate(7, "box")
    println("{small.heavy()} {small.label}")
    return 0
