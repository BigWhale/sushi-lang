# A consumer's enum `Crate` against a BINARY library's public struct `Crate`. A type
# name is one per program, whatever the two kinds are, so the consumer's declaration
# is refused where it stands (CE3011) and the library that holds the name is named.
# The exact code set is not pinned: the runner has no exact-code directive yet
# (#959).
# EXPECT_ERROR_CODE: CE3011
# EXPECT_STDERR_CONTAINS: "binary_api_lib"
use <lib/binary_api_lib>

enum Crate:
    Empty
    Full

fn main() i32:
    let Crate c = Crate.Full
    match c:
        Crate.Empty -> println("e")
        Crate.Full -> println("f")
    return 0
