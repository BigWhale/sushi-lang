# Test type mismatch when passing wrong type to library function expecting Point
# EXPECT_ERROR_CODE: CE2006
# Should produce a type error (CE2006)

use <lib/types_lib>

fn run() i32 | StdError:
    let i32 sum = point_sum(42)??
    println(sum)
    return Result.Ok(0)

fn main() i32:
    match run():
        Result.Ok(code) -> return code
        Result.Err(_) -> return 1
