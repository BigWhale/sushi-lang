# A manifest whose kind is 'hybrid' comes from an older compiler. The hybrid kind is
# removed, so the consumer refuses the library (CE3512).
# BUILD_LIB: hr_lib.sushi
# LIB_MANIFEST_SET: hr_lib kind=hybrid
# EXPECT_ERROR_CODE: CE3512
# EXPECT_STDERR_CONTAINS: "unknown library kind 'hybrid'"
use <lib/hr_lib>

fn main() i32:
    println("{hr_area(2, 3)}")
    return 0
