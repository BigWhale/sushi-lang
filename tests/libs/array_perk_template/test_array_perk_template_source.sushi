# A SOURCE library exports an array template perk implementation. The consumer
# calls it on element types the library never names, and through a constraint.
# BUILD_LIB: apt_src_lib.sushi
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "lib 2\nlib 1\nlib 3\nlib 4\n"
use <lib/apt_src_lib>

fn main() i32:
    let i32[] xs = from([1, 2])
    let string[] names = from(["arthur"])
    println(xs.name())
    println(names.name())
    println(describe(from([true, false, true])))
    println(own_ints())
    return 0
