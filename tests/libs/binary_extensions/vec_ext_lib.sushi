public struct Vec:
    i32 x
    i32 y

public error VecError:
    Negative

public perk Area:
    fn area() i32

perk Hidden:
    fn hidden() i32

public extend Vec sum() i32:
    return self.x + self.y

public extend Vec static at(i32 x, i32 y) Vec:
    return Vec(x, y)

public extend Vec checked_x() i32 | VecError:
    if (self.x < 0):
        return Result.Err(VecError.Negative)
    return Result.Ok(self.x)

public extend Vec grow(poke self, i32 n) ~:
    self.x := self.x + n
    self.y := self.y + n

extend Vec with Area:
    fn area() i32:
        return self.x * self.y

extend Vec with Hidden:
    fn hidden() i32:
        return 99
