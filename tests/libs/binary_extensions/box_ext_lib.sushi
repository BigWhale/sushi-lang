public struct Box@(T):
    T item

public struct Pt:
    i32 x

fn five() i32:
    return 5

public extend Box@(T) tag() i32:
    return five()

public extend Box@(T) echo(nom T x) T:
    return x

public extend Box@(i32) doubled() i32:
    return self.item * 2

public extend Pt pick@(U: Clone)(U a) U:
    return a.clone()

public error BoxError:
    Empty

public extend Box@(T) static wrap(nom T x) Box@(T):
    return Box(x)

public extend Box@(i32) checked() i32 | BoxError:
    if (self.item == 0):
        return Result.Err(BoxError.Empty)
    return Result.Ok(self.item)

public extend Box@(T) put(poke self, nom T x) ~:
    self.item := x
