# A generic struct of a hybrid library holds its type parameter `E` in an error
# position. The consumer writes `Holder@(i32)`, and `i32` is no error type. The note
# names the template's source slice and shows the template's line.
# BUILD_LIB_HYBRID: template_note_lib.sushi
# EXPECT_ERROR_CODES_EXACT: CE2084
# EXPECT_STDERR_CONTAINS: <template:template_note_lib:Holder>:1:15
# EXPECT_STDERR_CONTAINS: public struct Holder@(E):
use <lib/template_note_lib>

fn take(Holder@(i32) h) i32:
    return 0

fn main() i32:
    return 0
