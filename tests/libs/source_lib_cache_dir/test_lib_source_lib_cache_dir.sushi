# With a --cache-dir, the units of a source library are written under that cache, and
# nothing is cached next to the program (#971).
# RUN_IN_FIXTURE_DIR
# BUILD_LIB: geolib.sushi
# FIXTURE_CACHE_DIR: cache
# EXPECT_STDOUT_EXACT: "42\n"
# EXPECT_PATH_EXISTS: cache/libsrc/geolib/geolib.sushi
# EXPECT_PATH_ABSENT: __sushi_cache__
use <lib/geolib>

fn main() i32:
    println(answer())
    return 0
