# A consumer function beside a private constant that a binary library ships
# as source, because a public generic template names it. The consumer's copy of
# the constant and the consumer's function each need a symbol of their own.
# BUILD_LIB_BINARY: tlib.sushi
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "77 9\n"

use <lib/tlib>

fn SECRET() i32:
    return 77

fn main() i32:
    println("{SECRET()} {pick(1)}")
    return 0
