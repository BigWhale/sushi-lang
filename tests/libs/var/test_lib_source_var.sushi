# A source library's public variable is one storage shared by the library's own
# functions and the consumer: `hit()` and the consumer's rebind see each other.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "2\n12\n42\n"
# EXPECT_NO_LEAKS

use <lib/var_lib>

fn main() i32:
    hit()
    hit()
    println("{hits}")
    hits := hits + 10
    println("{hits}")
    println("{secret_plus(2).realise(0)}")
    return Result.Ok(0)
