public struct Res:
    i32 id

extend Res with Drop:
    fn drop(poke self) ~:
        println("drop {self.id}")

public fn make(i32 id) Res:
    return Res(id)

public struct Holder:
    Res res
    string label

public fn hold(i32 id) Holder:
    return Holder(Res(id), "held {id}")

public struct Sink@(T):
    T value

extend Sink@(T) with Drop:
    fn drop(poke self) ~:
        println("sink drop")
