# Only the unit that declares a type may implement Drop for it: a consumer cannot add
# a Drop to a type of a binary library.
# BUILD_LIB_BINARY: drop_res_lib.sushi
# EXPECT_ERROR_CODE: CE4012
use <lib/drop_res_lib>

public struct Plain:
    i32 n

extend Holder with Drop:
    fn drop(poke self) ~:
        println("mine")

fn main() i32:
    let Holder h = hold(1)
    println(h.label)
    return 0
