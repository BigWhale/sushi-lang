# A binary library of two units. The second unit imports a library and the entry
# unit does not. The entry unit's template is checked where it is written, in the
# entry unit's scope, so the other library's function is not in scope there, and the
# build of the library refuses it (#1070).
# BUILD_LIB: ldu_b.sushi
# COMPILER_FLAGS: --lib --lib-version 0.0.0 --lib-kind binary
# OUTPUT_PATH: ldu_pl.slib
# EXPECT_ERROR_CODE: CE2008
use "ldu_pl2"

public fn gen@(T)(T x) i32:
    x
    return b_val()
