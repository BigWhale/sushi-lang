# A source library of two units. The entry unit imports the other library itself,
# so a copy of its template calls that library's function.
# BUILD_LIB: ldu_b.sushi
# BUILD_LIB: ldu_pl_own.sushi
# EXPECT_STDOUT_EXACT: "7\n"
use <lib/ldu_pl_own>

fn main() i32:
    println("{gen_own(1)}")
    return 0
