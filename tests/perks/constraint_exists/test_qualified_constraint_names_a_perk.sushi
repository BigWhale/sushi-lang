# The positive half of the same rule: a real perk behind the alias still compiles
# and still runs (#733).
# EXPECT_STDOUT_EXACT: "Mostly Harmless\n30\n"
use "helpers/kinds" as k

fn use_it@(T: k.Loud)(T x) i32:
    return x.volume()

fn main() i32:
    println("Mostly Harmless")
    println("{use_it(3)}")
    return 0
