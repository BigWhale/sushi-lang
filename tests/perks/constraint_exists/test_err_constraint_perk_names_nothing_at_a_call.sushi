# The same constraint, with the function CALLED. The instantiation asked whether
# i32 IMPLEMENTS the perk before anything asked whether the perk EXISTS, so the
# reader was told "i32 does not implement perk Nothing" about a perk that is
# declared nowhere (#703).
# EXPECT_ERROR_CODE: CE4003

fn need@(T: Nothing)(T x) u64:
    return Result.Ok(0)

fn main() i32:
    let u64 n = need(5).realise(0)
    println("{n}")
    return Result.Ok(0)
