# A perk method reads the SAME argument check as an extension method, so CE2006 on a
# parameter that wants a borrow names the repair here too. One rule, one code, one help.
# TEST_TYPE: error
# EXPECT_ERROR_CODE: CE2006
# EXPECT_STDERR_CONTAINS: help: borrow it at the call site: `peek t`

perk Shout:
    fn say(peek string data) ~ | StdError

struct Horn:
    i32 n

extend Horn with Shout:
    fn say(peek string data) ~ | StdError:
        println(data)
        return Result.Ok(~)

fn main() i32:
    let Horn h = Horn(1)
    let string t = "hi"
    h.say(t)
    return Result.Ok(0)
