# A perk method's arity mismatch answers CE2009, the same code an extension method's does.
# It used to answer CE0023, which is in the INTERNAL family and documented as a codegen
# check -- not a user's miscount.
# TEST_TYPE: compile_error
# EXPECT_ERROR_CODE: CE2009

perk Wr:
    fn put(string data) ~ | StdError

struct Sink:
    i32 n

extend Sink with Wr:
    fn put(string data) ~ | StdError:
        println(data)
        return ~

fn main() i32:
    let Sink s = Sink(1)
    s.put("one", "two")
    return Result.Ok(0)
