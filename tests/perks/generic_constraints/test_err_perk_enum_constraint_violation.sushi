# Test CE4006: Generic enum constraint violation
# EXPECT_ERROR_CODE: CE4006

use <collections/hashmap>

struct Index:
    HashMap@(i32, string) slots

# Index holds a HashMap, which has no derived hash, so it does not satisfy Hashable

enum Option@(T: Hashable):
    Some(T)
    None()

fn main() i32:
    let Index ix = Index(HashMap.new())
    # Should fail: Index doesn't satisfy Hashable constraint
    let Option@(Index) opt = Option.Some(ix)
    return Result.Ok(0)
