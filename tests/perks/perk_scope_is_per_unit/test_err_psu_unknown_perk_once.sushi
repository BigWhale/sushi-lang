# No unit declares the perk. The implementation is refused one time, and the
# method call gives no second diagnostic.
# EXPECT_ERROR_CODE: CE4003
# EXPECT_ERROR_CODES_EXACT: CE4003

struct Dog:
    i32 x

extend Dog with Named:
    fn name() string:
        return "dog"

fn main() i32:
    let Dog d = Dog(1)
    println(d.name())
    return 0
