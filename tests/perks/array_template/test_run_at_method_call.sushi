# One perk implementation on an array template covers every dynamic array. The copy
# for each element type is made where a call names it.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "arr of 2\narr of 3\n"

perk Named:
    fn name() string

extend T[] with Named:
    fn name() string:
        return "arr of {self.len()}"

fn main() i32:
    let i32[] xs = from([1, 2])
    let string[] names = from(["arthur", "ford", "trillian"])
    println(xs.name())
    println(names.name())
    return 0
