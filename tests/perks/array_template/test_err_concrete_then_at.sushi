# The overlap rule does not read the declaration order: a concrete `i32[]`
# implementation followed by a template of the same perk is refused too.
# EXPECT_ERROR_CODES_EXACT: CE4002

perk Named:
    fn name() string

extend i32[] with Named:
    fn name() string:
        return "ints"

extend T[] with Named:
    fn name() string:
        return "arr"

fn main() i32:
    let i32[] xs = from([1])
    println(xs.name())
    return 0
