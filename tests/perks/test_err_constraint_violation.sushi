# Test constraint violation on generic struct (should emit CE4006)
# EXPECT_ERROR_CODE: CE4006

use <collections/hashmap>

struct Index:
    HashMap@(i32, string) slots

# Index holds a HashMap, which has no derived hash, so it does not satisfy Hashable

# Generic struct with perk constraint
struct Container@(T: Hashable):
    T value

fn main() i32:
    # Error CE4006: Index does not implement perk Hashable
    let Container@(Index) c = Container(Index(HashMap.new()))
    return Result.Ok(0)
