# An `Ord` implementation answers an explicit `compare` call.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "-1\n1\n"

struct Score:
    i32 points

extend Score with Ord:
    fn compare(Score other) i32:
        if (self.points > other.points):
            return -1
        if (self.points < other.points):
            return 1
        return 0

fn main() i32:
    let Score a = Score(9)
    let Score b = Score(3)
    println(a.compare(b))
    println(b.compare(a))
    return 0
