# A perk-implementation method with a '| E' channel spells its success too. A bare
# 'return value' is CE2030, the same rule an extension channel body obeys (#848).
# EXPECT_ERROR_CODE: CE2030
enum SourceError:
    Closed

perk Source:
    fn read_one() i32 | SourceError

struct Counter:
    i32 value

extend Counter with Source:
    fn read_one() i32 | SourceError:
        return self.value

fn main() i32:
    let Counter c = Counter(1)
    println("{c.read_one().realise(0)}")
    return Result.Ok(0)
