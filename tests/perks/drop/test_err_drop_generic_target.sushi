# A perk implementation is keyed by the name of the type it targets, and a generic
# target's key carries the TYPE-PARAMETER names -- a name no concrete instance
# matches. So the implementation would register and never fire, and the resource
# would silently leak. A silent no-op is worse than a refusal.
# TEST_TYPE: error
# EXPECT_ERROR_CODE: CE4013
struct Box@(T):
    T value

extend Box@(T) with Drop:
    fn drop(poke self) ~:
        println("dropping a box")

fn main() i32:
    let Box@(i32) b = Box(1)
    println("{b.value}")
    return Result.Ok(0)
