# `Drop` declares a resource, and only the unit that declares a type may say what
# releasing it means. No unit declares a built-in type, so `Drop` on `T[]` is refused.
# EXPECT_ERROR_CODES_EXACT: CE4016

extend T[] with Drop:
    fn drop(poke self) ~:
        println("released")

fn main() i32:
    return 0
