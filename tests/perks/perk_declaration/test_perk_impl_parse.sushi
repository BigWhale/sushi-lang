# tests/perks/perk_declaration/test_perk_impl_parse.sushi
# Perk implementation parsing test

struct Point:
    i32 x
    i32 y

extend Point with Hashable:
    fn hash() u64:
        return 42 as u64

fn main() i32:
    let Point p = Point(1, 2)
    if (p.hash() != 42 as u64):
        return Result.Ok(1)
    return Result.Ok(0)
