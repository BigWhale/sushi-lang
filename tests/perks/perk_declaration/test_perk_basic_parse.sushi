# tests/perks/perk_declaration/test_perk_basic_parse.sushi
# Basic perk definition parsing test

perk Display:
    fn display() string

extend i32 with Display:
    fn display() string:
        return "42"

fn main() i32:
    let i32 n = 7
    if (n.display() != "42"):
        return 1
    return 0
