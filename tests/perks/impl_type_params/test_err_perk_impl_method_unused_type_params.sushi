# The silent half of #704: the signature MATCHES the contract, so nothing else had
# anything to complain about and the `@(U: Hidden)` list was accepted and inert. A
# constraint written there is read by no rule, so a private perk in that position
# crossed the unit boundary unchecked.
# EXPECT_ERROR_CODE: CE4010

perk Hidden:
    fn h() i32

perk Shown:
    fn show() i32

struct Box:
    i32 n

extend Box with Shown:
    fn show@(U: Hidden)() i32:
        return 1

fn main() i32:
    println("Mostly Harmless")
    return Result.Ok(0)
