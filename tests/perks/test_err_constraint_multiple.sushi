# Test constraint violation error reporting with multiple types
# EXPECT_ERROR_CODE: CE4006

use <collections/hashmap>

struct Point:
    i32 x
    i32 y

extend Point with Hashable:
    fn hash() u64:
        let u64 hx = self.x as u64
        let u64 hy = self.y as u64
        return hx + hy

struct NoHash:
    HashMap@(i32, i32) slots
# NoHash has no derived hash, so it does not satisfy Hashable

struct Container@(T: Hashable):
    T data

fn main() i32:
    # This should compile (Point implements Hashable)
    let Container@(Point) good = Container(Point(10, 20))
    println(good.data.x)

    # This should fail with CE4006 (NoHash has no derived hash)
    let Container@(NoHash) bad = Container(NoHash(HashMap.new()))

    return Result.Ok(0)
