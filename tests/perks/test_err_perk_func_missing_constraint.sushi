# Test CE4006: Generic function constraint violation
# EXPECT_ERROR_CODE: CE4006
# Type doesn't implement required perk

use <collections/hashmap>

struct Index:
    HashMap@(i32, string) slots

# Index holds a HashMap, which has no derived hash, so it does not satisfy Hashable

fn compute_hash@(T: Hashable)(T value) u64:
    return value.hash()

fn main() i32:
    let Index ix = Index(HashMap.new())
    # Should fail: Index doesn't implement Hashable
    let u64 h = compute_hash(ix)
    println(h)
    return Result.Ok(0)
