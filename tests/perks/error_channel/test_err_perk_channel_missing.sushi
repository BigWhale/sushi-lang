# The contract declares a channel and the implementation does not. CE0133 is
# relational: the primary at the implementation, a note at the contract method.
# TEST_TYPE: error
# EXPECT_ERROR_CODE: CE0133
# EXPECT_STDERR_CONTAINS: "perk 'Source' declares"
enum SourceError:
    Closed

perk Source:
    fn read_one() i32 | SourceError

struct Counter:
    i32 value

extend Counter with Source:
    fn read_one() i32:
        return self.value

fn main() i32:
    let Counter c = Counter(1)
    println("{c.read_one()}")
    return Result.Ok(0)
