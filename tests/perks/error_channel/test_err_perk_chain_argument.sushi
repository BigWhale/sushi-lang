# Ruling 5, the argument row: an unhandled channel handed to a bare parameter is
# CE2006, the same answer the extension arm gives.
# TEST_TYPE: error
# EXPECT_ERROR_CODE: CE2006
enum SourceError:
    Closed

perk Source:
    fn read_one() i32 | SourceError

struct Counter:
    i32 value

extend Counter with Source:
    fn read_one() i32 | SourceError:
        return self.value

fn eat(i32 n) ~:
    println("{n}")
    return Result.Ok(~)

fn main() i32:
    let Counter c = Counter(1)
    eat(c.read_one())
    return Result.Ok(0)
