# Ruling 5, the '??' row: a BARE perk method has no channel to propagate, so '??'
# at the CALL SITE is CE2507 -- the bare-body gate (CE0131) is a different rule.
# EXPECT_ERROR_CODE: CE2507
perk Bare:
    fn plain() i32

struct Counter:
    i32 value

extend Counter with Bare:
    fn plain() i32:
        return self.value

fn run() i32 | StdError:
    let Counter c = Counter(1)
    let i32 x = c.plain()??
    println("{x}")
    return Result.Ok(0)

fn main() i32:
    match run():
        Result.Ok(code) -> return code
        Result.Err(_) -> return 1
