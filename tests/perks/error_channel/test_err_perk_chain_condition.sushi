# Ruling 5, the condition row: no wrapper is truthy, so an unhandled channel in an
# `if` is CE2516 whichever kind of method produced it.
# TEST_TYPE: error
# EXPECT_ERROR_CODE: CE2516
enum SourceError:
    Closed

perk Source:
    fn read_one() i32 | SourceError

struct Counter:
    i32 value

extend Counter with Source:
    fn read_one() i32 | SourceError:
        return self.value

fn main() i32:
    let Counter c = Counter(1)
    if (c.read_one()):
        println("truthy")
    return Result.Ok(0)
