# The contract is bare and the implementation declares a channel. The same
# relational CE0133, read the other way.
# TEST_TYPE: error
# EXPECT_ERROR_CODE: CE0133
# EXPECT_STDERR_CONTAINS: "perk 'Greet' declares"
perk Greet:
    fn hello() string

struct Robot:
    i32 head_count

extend Robot with Greet:
    fn hello() string | StdError:
        return "life, do not talk to me about life"

fn main() i32:
    let Robot marvin = Robot(1)
    println(marvin.hello().realise(""))
    return Result.Ok(0)
