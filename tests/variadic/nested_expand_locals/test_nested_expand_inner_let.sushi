# A `let` in an `expand` nested in another `expand` over the same pack. Every
# unrolled copy is its own hygiene scope, so the four inner copies each declare
# their own `t` (#1018).
# EXPECT_STDOUT_EXACT: "int\nint\nint\nint\n"
perk Render:
    fn display() string

extend i32 with Render:
    fn display() string:
        return "int"

fn f@(...Ts: Render)(...Ts args) ~:
    expand(_ in args):
        expand(b in args):
            let string t = b.display()
            println(t)

fn main() i32:
    f(1, 2)
    return 0
