# A type pack bloomed into a native `...i32` parameter is one CE0144 at the pack name,
# and not CE1001 (#1109).
# EXPECT_ERROR_CODES_EXACT: CE0144
# EXPECT_STDERR_CONTAINS: 'args' is a type pack

perk Show:
    fn show() string

extend i32 with Show:
    fn show() string:
        return "i32"

fn sum(...i32 xs) i32:
    return xs.len()

fn outer@(...Ts: Show)(...Ts args) i32:
    return sum(args...)

fn main() i32:
    println(outer(1, 2))
    return 0
