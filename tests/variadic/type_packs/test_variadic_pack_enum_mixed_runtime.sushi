# E2 (#71): mixed pack args -- an enum-constructor DotCall alongside primitive
# args. Flat key ('show_all', (Color, i32, string)); per-element display dispatch.
# EXPECT_STDOUT_EXACT: "red\n7\nhi\n"
perk Render:
    fn display() string

enum Color:
    Red()
    Green()

extend Color with Render:
    fn display() string:
        match self:
            Color.Red() -> return "red"
            Color.Green() -> return "green"

extend i32 with Render:
    fn display() string:
        return "7"

extend string with Render:
    fn display() string:
        return self.clone()

fn show_all@(...Ts: Render)(...Ts args) ~:
    expand(a in args):
        println(a.display())

fn main() i32:
    show_all(Color.Red(), 7, "hi")
    return 0
