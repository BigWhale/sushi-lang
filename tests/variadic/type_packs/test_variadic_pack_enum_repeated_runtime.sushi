# E2 (#71): repeated same-enum-type pack args. `Color.Red()`/`Color.Green()`
# parse to DotCalls (pre-lowering enum constructors); the instantiate pass must infer their
# enum type so the pack instantiation ('show_all', (Color, Color)) registers.
# EXPECT_STDOUT_EXACT: "red\ngreen\n"
perk Render:
    fn display() string

enum Color:
    Red()
    Green()

extend Color with Render:
    fn display() string:
        match self:
            Color.Red() -> return "red"
            Color.Green() -> return "green"

fn show_all@(...Ts: Render)(...Ts args) ~:
    expand(a in args):
        println(a.display())

fn main() i32:
    show_all(Color.Red(), Color.Green())
    return 0
