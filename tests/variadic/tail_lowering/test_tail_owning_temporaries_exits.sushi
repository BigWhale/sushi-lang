# A tail of `...string` takes temporaries that own, in a loop that the caller leaves by
# `break`, and in a `return` that leaves the loop early. Each value moves into the array of
# the call, and the caller drops the array once, at the end of the statement.
# EXPECT_STDOUT_EXACT: "8\n18\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true

fn size(...string xs) i32:
    return xs.len() as i32

fn mk(i32 a) string:
    return "v{a}"

fn walk(i32 stop) i32:
    let i32 seen = 0
    foreach(i in 0..10):
        if (i == stop):
            return seen + size(mk(i), mk(i + 1))
        if (i > 5):
            break
        seen := seen + size(mk(i), "{i}", mk(i))
    return seen

fn main() i32:
    println(walk(2))
    println(walk(20))
    return 0
