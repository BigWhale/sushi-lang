# A variadic function has no function type, so a function value of it is CE2093, of a
# function of this unit and of a function behind an alias (decision E6).
# EXPECT_ERROR_CODES_EXACT: CE2093, CE2093
# EXPECT_STDERR_CONTAINS: "a variadic function has no function type"
use "helpers/tail_unit" as t

fn sum(...i32 xs) i32:
    return xs.len()

fn main() i32:
    let fn(i32[]) -> i32 f = sum
    let fn(i32[]) -> i32 g = t.total
    let i32[] xs = from([1, 2, 3])
    println(f(xs.clone()))
    println(g(xs))
    return 0
