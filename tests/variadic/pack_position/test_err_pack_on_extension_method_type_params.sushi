# A type pack in the type-parameter list of an extension method is refused where it is
# written. The call adds no second diagnostic.
# EXPECT_ERROR_CODES_EXACT: CE0115
# EXPECT_STDERR_CONTAINS: type pack '...Ts' not allowed in an extension method

extend i32 m@(...Ts)() i32:
    return self

fn main() i32:
    println(1.m())
    return 0
