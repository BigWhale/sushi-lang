# A type pack in the type-parameter list of a static method is refused where it is
# written. The call adds no second diagnostic.
# EXPECT_ERROR_CODES_EXACT: CE0115
# EXPECT_STDERR_CONTAINS: type pack '...Ts' not allowed in a static method

struct Crate:
    i32 w

extend Crate static mk@(...Ts)() Crate:
    return Crate(1)

fn main() i32:
    println(Crate.mk().w)
    return 0
