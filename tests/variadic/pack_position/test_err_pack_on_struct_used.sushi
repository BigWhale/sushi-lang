# A written instance of a struct with a type pack gets no second diagnostic.
# The pack in the type-parameter list is the one fault.
# EXPECT_ERROR_CODES_EXACT: CE0115
# EXPECT_STDERR_CONTAINS: type pack '...Ts' not allowed in a struct

struct Bag@(...Ts):
    Ts items

fn main() i32:
    let Bag@(i32, string) b = Bag(42)
    println("Mostly Harmless")
    return 0
