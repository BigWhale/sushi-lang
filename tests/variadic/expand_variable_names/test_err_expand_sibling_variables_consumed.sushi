# Two sibling `expand`s over one pack rename `a` and `b` to the same hidden names.
# Each diagnostic names its own written variable, because the record of the written
# name sits on each renamed node and not on the hidden name.
# `eat` takes any `Display` type, so the template checks clean, and the consume of
# a borrowed element is a fault of each copy (#1070, R7).
# EXPECT_ERROR_CODES_EXACT: CE2411, CE2411
# EXPECT_STDERR_CONTAINS: cannot consume 'a'
# EXPECT_STDERR_CONTAINS: `a.clone()`
# EXPECT_STDERR_CONTAINS: cannot consume 'b'
# EXPECT_STDERR_CONTAINS: `b.clone()`

fn eat@(T: Display)(nom T s) ~:
    println(s)

fn f@(...Ts: Display)(...Ts args) ~ | StdError:
    expand(a in args):
        eat(nom a)
    expand(b in args):
        eat(nom b)
    return Result.Ok(~)

fn main() i32:
    match f("x", "y"):
        Result.Ok(_) -> println("ok")
        Result.Err(_) -> println("err")
    return 0
