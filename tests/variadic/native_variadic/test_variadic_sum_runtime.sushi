# Native variadic: trailing ...i32 collects into an owned i32[] iterated via foreach.
# EXPECT_STDOUT_EXACT: "sum = 6\n"
fn sum(...i32 nums) i32:
    let i32 total = 0
    foreach(n in nums.iter()):
        total := total + n
    return total

fn main() i32:
    let i32 s = sum(1, 2, 3)
    println("sum = {s}")
    return 0
