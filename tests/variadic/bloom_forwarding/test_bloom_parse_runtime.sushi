# Bloom (spread/forwarding): lend an existing i32[] to a variadic ...i32 slot
# with the postfix `arr...` form. The caller keeps the array.
# EXPECT_STDOUT_EXACT: "sum = 6\n"
fn sum(...i32 nums) i32:
    let i32 total = 0
    foreach(n in nums.iter()):
        total := total + n
    return total

fn main() i32:
    let i32[] xs = from([1, 2, 3])
    let i32 s = sum(xs...)
    println("sum = {s}")
    return 0
