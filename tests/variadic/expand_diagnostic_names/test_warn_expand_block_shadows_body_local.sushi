# A `let` in an `if` block of an `expand` body declares the name of a `let` of
# the same `expand` body. The body's `let` has a hidden name in each copy, and the
# shadow check reads its written name 'u' (#1022). One CW1002 for the written
# `let`; a probe with the reporter's repeat drop turned off measured one.
# EXPECT_ERROR_CODES_EXACT: CW1002
# EXPECT_STDERR_CONTAINS: :18:13: warning [CW1002]: declared variable 'u' already exists in an outer scope.
perk Display:
    fn display() string

extend i32 with Display:
    fn display() string:
        return "{self}"

fn f@(...Ts: Display)(...Ts args) ~:
    expand(a in args):
        let i32 u = 1
        if (u == 1):
            let i32 u = 2
            println("{u} {a.display()}")
    return Result.Ok(~)

fn main() i32:
    f(1, 2)
    return Result.Ok(0)
