# A user local that spells the name the compiler used for a local of an unrolled
# `expand` copy keeps its own value. Each copy keeps its own local.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "int mine\nint mine\n"
# EXPECT_STDERR_EMPTY: true

perk Display:
    fn display() string

extend i32 with Display:
    fn display() string:
        return "int"

fn show_all@(...Ts: Display)(...Ts args) ~:
    let string t__x0 = "mine"
    expand(a in args):
        let string t = a.display()
        println("{t} {t__x0}")

fn main() i32:
    show_all(1, 2)
    return 0
