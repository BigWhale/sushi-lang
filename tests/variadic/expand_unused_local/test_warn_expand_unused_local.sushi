# An unused `let` in an `expand` body is one written declaration. The unroll makes
# one copy of it per pack element; CW1001 is about the written `let`, so it is
# reported ONE time, with the written name `u`, and never with a copy name (#1019).
# The runner has no count directive. The count rule: the scope pass collects the
# copies by their written declaration and emits one CW1001 for the group.
# EXPECT_ERROR_CODES_EXACT: CW1001
# EXPECT_STDERR_CONTAINS: :17:9: warning [CW1001]: unused variable 'u'.
perk Display:
    fn display() string

extend i32 with Display:
    fn display() string:
        return "int"

fn f@(...Ts: Display)(...Ts args) ~:
    expand(a in args):
        let i32 u = 1
        println(a.display())

fn main() i32:
    f(1, 2)
    return 0
