# Two `expand` statements, each with an unused `let t`. They are two written
# declarations, so CW1001 is reported one time for each, with the written name
# `t` and at its own line (#1019).
# EXPECT_ERROR_CODES_EXACT: CW1001
# EXPECT_STDERR_CONTAINS: :16:9: warning [CW1001]: unused variable 't'.
# EXPECT_STDERR_CONTAINS: :19:9: warning [CW1001]: unused variable 't'.
perk Render:
    fn display() string

extend i32 with Render:
    fn display() string:
        return "{self}"

fn f@(...Ts: Render)(...Ts args) ~:
    expand(a in args):
        let i32 t = 1
        println(a.display())
    expand(a in args):
        let i32 t = 2
        println(a.display())

fn main() i32:
    f(1, 2)
    return 0
