# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "3\n"
# EXPECT_NO_LEAKS
# EXPECT_DUMP_SLIR: test_slir_perk_method.slir
#
# The SLIR of a perk method: the body takes the perk symbol and its receiver is `_1` with the
# convention of its `self`. A call of it is a `Direct` callee with the perk symbol.

perk Bumps:
    fn bump(poke self, i32 by) ~
    fn read() i32

struct C:
    i32 n

extend C with Bumps:
    fn bump(poke self, i32 by) ~:
        self.n := self.n + by
    fn read() i32:
        return self.n

fn main() i32:
    let C c = C(1)
    c.bump(2)
    println(c.read())
    return 0
