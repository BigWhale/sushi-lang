unit test_slir_container_statics

fn hold(_1: List@(i32) @guaranteed, _2: HashMap@(string, i32[]) @guaranteed, _3: Own@(i32[]) @guaranteed, _4: i32 @guaranteed) -> i32 {
    let _0: i32
    let _5: bool
    let _6: i32

  bb0:
    StorageLive(_5)
    _5 = user copy _4 == const 0_i32
    switchInt(copy _5) -> [0: bb2, otherwise: bb1]

  bb1:
    StorageDead(_5)
    _0 = const 0_i32
    return

  bb2:
    StorageDead(_5)
    goto -> bb3

  bb3:
    StorageLive(_6)
    _6 = user copy _4 - const 1_i32
    _0 = call @hold(copy _1 @guaranteed, copy _2 @guaranteed, copy _3 @guaranteed, copy _6 @guaranteed)
    StorageDead(_6)
    return
}

