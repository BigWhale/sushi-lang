# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "2 alpha true gamma 1\n"
# EXPECT_NO_LEAKS
# EXPECT_DUMP_SLIR: test_slir_hashmap_methods.slir
#
# A method of a HashMap is ONE `Builtin` call (ir.md 8.6): the receiver first, then the
# key, then the value. `insert` takes the map `Inout`, its key and its value `Owned`; a
# lookup reads the map and borrows its key. The answer of `get` is a view local in a
# region over the map (S7), and the answer of `remove` is an owned value that drops.
use <collections/hashmap>

fn main() i32:
    let HashMap@(string, string) m = HashMap.new()
    m.insert("a".clone(), "alpha".clone())
    m.insert("b".clone(), "beta".clone())
    let Maybe@(string) got = m.get("a")
    let string text = got.realise("none")
    let bool has = m.contains_key("b")
    m.insert("b".clone(), "gamma".clone())
    let string old = m.remove("b").realise("none".clone())
    println("{m.len() + 1} {text} {has} {old} {m.len()}")
    return 0
