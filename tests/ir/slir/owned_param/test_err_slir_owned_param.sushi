# EXPECT_ERROR_CODES_EXACT: CE0155
# EXPECT_STDERR_CONTAINS: "emit, Builtin"
# EXPECT_DUMP_SLIR: test_err_slir_owned_param.slir
#
# A `nom` parameter that no path moves: the callee drops it at the exit (ir.md 8.10,
# rule 5). The body of `shout` reaches its end, so the end writes `_0` and returns. The
# call of `println` writes a destination local that nothing reads.

fn shout(nom string text) ~:
    println(text)

fn main() i32:
    shout(nom "Mostly Harmless")
    return 0
