# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "1\nx\n"
# EXPECT_DUMP_SLIR: test_slir_method_template_copy.slir
#
# the SLIR of two calls of a template method with a method-level type parameter: each solved
# method argument has its copy, and each copy is one body.
struct Box@(T):
    i32 n

extend Box@(T) keep@(U)(nom U x) U:
    return x

fn main() i32:
    let Box@(bool) b = Box(0)
    println(b.keep(nom 1))
    println(b.keep(nom "x"))
    return 0

