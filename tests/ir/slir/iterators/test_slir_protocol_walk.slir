unit test_slir_protocol_walk

fn first(_1: Words @inout) -> ~ {
    let _0: ~
    let _2: Maybe@(string)
    let _3: i32
    let _4: string                         // s
    let _5: ~

  bb0:
    StorageLive(_2)
    goto -> bb1

  bb1:
    _2 = call @Words.next(copy _1 @inout)
    StorageLive(_3)
    _3 = discriminant(_2)
    switchInt(copy _3) -> [1: bb3, otherwise: bb2]

  bb2:
    StorageDead(_3)
    StorageLive(_4)
    _4 = move ((_2 as Some).0)
    StorageLive(_5)
    _5 = call builtin println@(string)(copy _4 @guaranteed)
    StorageDead(_5)
    Drop(_4)
    StorageDead(_4)
    goto -> bb4

  bb3:
    Drop(_2)
    StorageDead(_3)
    goto -> bb4

  bb4:
    StorageDead(_2)
    _0 = const ~
    return
}

fn main() -> i32 {
    let _0: i32
    let _1: string[]
    let _2: Words                          // w
    let _3: ~
    let _4: Words
    let _5: Maybe@(string)
    let _6: i32
    let _7: string                         // s
    let _8: ~

  bb0:
    StorageLive(_1)
    _1 = [const "a", const "b"]
    StorageLive(_2)
    _2 = Words(move _1, const 0_i32)
    StorageDead(_1)
    StorageLive(_3)
    _3 = call @first(copy _2 @inout)
    StorageDead(_3)
    StorageLive(_4)
    _4 = move _2
    StorageLive(_5)
    goto -> bb1

  bb1:
    _5 = call @Words.next(copy _4 @inout)
    StorageLive(_6)
    _6 = discriminant(_5)
    switchInt(copy _6) -> [1: bb3, otherwise: bb2]

  bb2:
    StorageDead(_6)
    StorageLive(_7)
    _7 = move ((_5 as Some).0)
    StorageLive(_8)
    _8 = call builtin println@(string)(copy _7 @guaranteed)
    StorageDead(_8)
    Drop(_7)
    StorageDead(_7)
    goto -> bb1

  bb3:
    Drop(_5)
    StorageDead(_6)
    goto -> bb4

  bb4:
    StorageDead(_5)
    Drop(_4)
    StorageDead(_4)
    _0 = const 0_i32
    StorageDead(_2)
    return
}

fn Words.next(_1: Words @inout) -> Maybe@(string) {
    let _0: Maybe@(string)
    let _2: i32
    let _3: i64
    let _4: i32
    let _5: bool
    let _6: i32
    let _7: i64
    let _8: i32
    let _9: i64
    let _10: u64
    let _11: u64
    let _12: bool
    let _13: string

  bb0:
    StorageLive(_2)
    _2 = copy (_1.1)
    StorageLive(_3)
    _3 = call builtin array.len(copy (_1.0) @guaranteed)
    StorageLive(_4)
    _4 = move _3 as i32
    StorageLive(_5)
    _5 = user copy _2 >= copy _4
    StorageDead(_4)
    StorageDead(_3)
    StorageDead(_2)
    switchInt(copy _5) -> [0: bb2, otherwise: bb1]

  bb1:
    StorageDead(_5)
    _0 = Maybe::None
    return

  bb2:
    StorageDead(_5)
    goto -> bb3

  bb3:
    (_1.1) = user copy (_1.1) + const 1_i32
    StorageLive(_6)
    _6 = user copy (_1.1) - const 1_i32
    StorageLive(_7)
    _7 = copy _6 as i64
    StorageLive(_8)
    _8 = len((_1.0))
    StorageLive(_9)
    _9 = copy _8 as i64
    _10 = copy _7 as u64
    _11 = copy _9 as u64
    _12 = copy _10 < copy _11
    switchInt(copy _12) -> [0: bb4, otherwise: bb5]

  bb4:
    trap RE2020(copy _7, copy _9)

  bb5:
    StorageLive(_13)
    _13 = clone(copy ((_1.0)[copy _7]))
    _0 = Maybe::Some(move _13)
    StorageDead(_13)
    StorageDead(_9)
    StorageDead(_8)
    StorageDead(_7)
    StorageDead(_6)
    return
}
