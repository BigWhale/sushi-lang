# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "1\n1\n7\n"
# EXPECT_NO_LEAKS
# EXPECT_DUMP_SLIR: test_slir_iterator_value.slir
# The SLIR of an iterator value: one aggregate with the row of its source and the heap decision.
# A lent iterator in a `let` has a stack state and a region over its owner, and the walk is in
# place. A range is an owned value, and a hidden temporary holds it for its walk. An owned item
# moves into the binder, and the `None` edge drops the `Maybe`.
use <collections/iter>

struct Spell:
    i32 left

extend Spell next(poke self) Maybe@(string):
    if (self.left == 0):
        return Maybe.None
    self.left := self.left - 1
    return Maybe.Some("{self.left + 1}")

fn main() i32:
    let i32[] xs = from([1])
    let Iterator@(i32) lent = xs.iter()
    foreach(x in lent):
        println(x)
    foreach(s in Iterator.new(nom Spell(1))):
        println(s)
    let Iterator@(i32) range = 7..8
    foreach(x in range):
        println(x)
    return 0
