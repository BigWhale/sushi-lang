# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "x:b\n1:cc\n3\n"
# EXPECT_NO_LEAKS
# EXPECT_DUMP_SLIR: test_slir_adapter_chain.slir
# The SLIR of a lazy adapter and of a consumer. Each adapter is one aggregate with its row: it
# moves the inner iterator and the function value, and it takes the heap decision of its
# chain. A walk of a tuple item whose parts differ in mode holds the owned part in a hidden
# local of the round. A consumer is one call that takes the iterator `Owned`.
use <collections/iter>

fn main() i32:
    let string[] names = from(["b", "cc"])
    foreach(p in names.iter().zip(nom from(["x"]).iter().clone_each())):
        println("{p.1}:{p.0}")
    foreach(p in names.iter().enumerate()):
        if (p.0 == 1):
            println("{p.0}:{p.1}")
    println(names.iter().fold(nom 0, nom |i32 acc, string s| acc + (s.len() as i32)))
    return 0
