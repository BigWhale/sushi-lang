# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "a\nb\n"
# EXPECT_NO_LEAKS
# EXPECT_DUMP_SLIR: test_slir_protocol_walk.slir
# The SLIR of a protocol walk. A walk by value moves the iterable into a temporary of the loop
# statement, and each round calls `next()` with the iterator `Inout` into a `Maybe` local, then
# switches on its tag. An owned item moves into the binder, and the `None` edge drops the
# `Maybe`. A walk in place through a `poke` parameter calls `next()` on the place of the caller.
struct Words:
    string[] items
    i32 pos

extend Words next(poke self) Maybe@(string):
    if (self.pos >= self.items.len()):
        return Maybe.None
    self.pos := self.pos + 1
    return Maybe.Some(self.items[self.pos - 1].clone())

fn first(poke Words w) ~:
    foreach(s in w):
        println(s)
        break

fn main() i32:
    let Words w = Words(from(["a", "b"]), 0)
    first(poke w)
    foreach(s in w):
        println(s)
    return 0
