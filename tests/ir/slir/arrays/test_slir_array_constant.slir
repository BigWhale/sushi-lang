unit test_slir_array_constant

fn pick(_1: i32[4] @guaranteed, _2: i32 @guaranteed) -> i32 {
    let _0: i32
    let _3: i32
    let _4: u32
    let _5: bool

  bb0:
    StorageLive(_3)
    _3 = copy _2
    _4 = copy _3 as u32
    _5 = copy _4 < const 4_u32
    switchInt(copy _5) -> [0: bb1, otherwise: bb2]

  bb1:
    trap RE2020(copy _3, const 4_i32)

  bb2:
    _0 = copy (_1[copy _3])
    StorageDead(_3)
    return
}

fn main() -> i32 {
    let _0: i32
    let _1: i32                            // i
    let _2: i32[4]
    let _3: i32
    let _4: u32
    let _5: bool
    let _6: ~
    let _7: i32
    let _8: ~
    let _9: Grid
    let _10: ~

  bb0:
    StorageLive(_1)
    _1 = const 3_i32
    StorageLive(_2)
    _2 = const [2_i32, 3_i32, 5_i32, 7_i32]
    StorageLive(_3)
    _3 = copy _1
    _4 = copy _3 as u32
    _5 = copy _4 < const 4_u32
    switchInt(copy _5) -> [0: bb1, otherwise: bb2]

  bb1:
    trap RE2020(copy _3, const 4_i32)

  bb2:
    StorageLive(_6)
    _6 = call builtin println@(i32)(copy (_2[copy _3]) @guaranteed)
    StorageDead(_6)
    StorageDead(_3)
    StorageDead(_2)
    StorageLive(_7)
    _7 = call @pick(const [2_i32, 3_i32, 5_i32, 7_i32] @guaranteed, const 2_i32 @guaranteed)
    StorageLive(_8)
    _8 = call builtin println@(i32)(copy _7 @guaranteed)
    StorageDead(_8)
    StorageDead(_7)
    StorageLive(_9)
    _9 = const Grid([4_i32, 5_i32], 1_i32)
    StorageLive(_10)
    _10 = call builtin println@(i32)(copy ((_9.0)[const 1_i32]) @guaranteed)
    StorageDead(_10)
    StorageDead(_9)
    _0 = const 0_i32
    StorageDead(_1)
    return
}
