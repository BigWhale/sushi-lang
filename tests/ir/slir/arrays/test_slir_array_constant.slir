unit test_slir_array_constant

fn pick(_1: i32[4] @guaranteed, _2: i32 @guaranteed) -> i32 {
    let _0: i32
    let _3: i32
    let _4: i64
    let _5: u64
    let _6: bool

  bb0:
    StorageLive(_3)
    _3 = copy _2
    StorageLive(_4)
    _4 = copy _3 as i64
    _5 = copy _4 as u64
    _6 = copy _5 < const 4_u64
    switchInt(copy _6) -> [0: bb1, otherwise: bb2]

  bb1:
    trap RE2020(copy _4, const 4_i64)

  bb2:
    _0 = copy (_1[copy _4])
    StorageDead(_4)
    StorageDead(_3)
    return
}

fn main() -> i32 {
    let _0: i32
    let _1: i32                            // i
    let _2: i32[4]
    let _3: i32
    let _4: i64
    let _5: u64
    let _6: bool
    let _7: ~
    let _8: i32
    let _9: ~
    let _10: Grid
    let _11: ~

  bb0:
    StorageLive(_1)
    _1 = const 3_i32
    StorageLive(_2)
    _2 = const [2_i32, 3_i32, 5_i32, 7_i32]
    StorageLive(_3)
    _3 = copy _1
    StorageLive(_4)
    _4 = copy _3 as i64
    _5 = copy _4 as u64
    _6 = copy _5 < const 4_u64
    switchInt(copy _6) -> [0: bb1, otherwise: bb2]

  bb1:
    trap RE2020(copy _4, const 4_i64)

  bb2:
    StorageLive(_7)
    _7 = call builtin println@(i32)(copy (_2[copy _4]) @guaranteed)
    StorageDead(_7)
    StorageDead(_4)
    StorageDead(_3)
    StorageDead(_2)
    StorageLive(_8)
    _8 = call @pick(const [2_i32, 3_i32, 5_i32, 7_i32] @guaranteed, const 2_i32 @guaranteed)
    StorageLive(_9)
    _9 = call builtin println@(i32)(copy _8 @guaranteed)
    StorageDead(_9)
    StorageDead(_8)
    StorageLive(_10)
    _10 = const Grid([4_i32, 5_i32], 1_i32)
    StorageLive(_11)
    _11 = call builtin println@(i32)(copy ((_10.0)[const 1_i64]) @guaranteed)
    StorageDead(_11)
    StorageDead(_10)
    _0 = const 0_i32
    StorageDead(_1)
    return
}
