unit test_slir_owning_elements

fn main() -> i32 {
    let _0: i32
    let _1: string                         // name
    let _2: string
    let _3: string[]                       // xs
    let _4: i32
    let _5: u32
    let _6: bool
    let _7: string[3]                      // row
    let _8: string
    let _9: i32
    let _10: u32
    let _11: bool
    let _12: string view                   // first
    let _13: string
    let _14: ~
    let _15: i32
    let _16: u32
    let _17: bool
    let _18: i32
    let _19: string
    let _20: ~

  bb0:
    StorageLive(_1)
    _1 = call builtin string.s(const "Ford" @guaranteed, const 0_i32 @guaranteed, const 4_i32 @guaranteed)
    StorageLive(_2)
    _2 = call builtin string.s(const "Arthur" @guaranteed, const 0_i32 @guaranteed, const 6_i32 @guaranteed)
    StorageLive(_3)
    _3 = [move _1, move _2]
    StorageDead(_2)
    StorageLive(_4)
    _4 = len(_3)
    _5 = copy _4 as u32
    _6 = const 0_u32 < copy _5
    switchInt(copy _6) -> [0: bb1, otherwise: bb2]

  bb1:
    trap RE2020(const 0_i32, copy _4)

  bb2:
    StorageLive(_7)
    _7 = [copy (_3[const 0_i32]); const 3_i32]
    StorageDead(_4)
    StorageLive(_8)
    _8 = call builtin string.s(const "Zaphod" @guaranteed, const 0_i32 @guaranteed, const 6_i32 @guaranteed)
    StorageLive(_9)
    _9 = len(_3)
    _10 = copy _9 as u32
    _11 = const 1_u32 < copy _10
    switchInt(copy _11) -> [0: bb3, otherwise: bb4]

  bb3:
    trap RE2020(const 1_i32, copy _9)

  bb4:
    Drop((_3[const 1_i32]))
    (_3[const 1_i32]) = move _8
    StorageDead(_9)
    StorageDead(_8)
    StorageLive(_12)
    BeginBorrow(b0, _7, peek)
    _12 = copy (_7[const 0_i32])
    StorageLive(_13)
    _13 = clone(copy _12)
    StorageLive(_14)
    _14 = call builtin array.push(copy _3 @inout, move _13 @owned)
    StorageDead(_14)
    StorageDead(_13)
    StorageLive(_15)
    _15 = len(_3)
    _16 = copy _15 as u32
    _17 = const 2_u32 < copy _16
    switchInt(copy _17) -> [0: bb5, otherwise: bb6]

  bb5:
    trap RE2020(const 2_i32, copy _15)

  bb6:
    StorageLive(_18)
    _18 = call builtin array.len(copy _3 @guaranteed)
    StorageLive(_19)
    _19 = call builtin interp@(string, string, string, string, string, string, i32)(copy _12 @guaranteed, const " " @guaranteed, copy (_7[const 1_i32]) @guaranteed, const " " @guaranteed, copy (_3[const 2_i32]) @guaranteed, const " " @guaranteed, copy _18 @guaranteed)
    StorageLive(_20)
    _20 = call builtin println@(string)(copy _19 @guaranteed)
    EndBorrow(b0)
    StorageDead(_20)
    Drop(_19)
    StorageDead(_19)
    StorageDead(_18)
    StorageDead(_15)
    _0 = const 0_i32
    StorageDead(_12)
    Drop(_7)
    StorageDead(_7)
    Drop(_3)
    StorageDead(_3)
    StorageDead(_1)
    return
}
