unit test_slir_owning_elements

fn main() -> i32 {
    let _0: i32
    let _1: string                         // name
    let _2: string
    let _3: string[]                       // xs
    let _4: i32
    let _5: i64
    let _6: u64
    let _7: bool
    let _8: string[3]                      // row
    let _9: string
    let _10: i32
    let _11: i64
    let _12: u64
    let _13: bool
    let _14: string view                   // first
    let _15: string
    let _16: ~
    let _17: i32
    let _18: i64
    let _19: u64
    let _20: bool
    let _21: i64
    let _22: string
    let _23: ~

  bb0:
    StorageLive(_1)
    _1 = call builtin string.s(const "Ford" @guaranteed, const 0_i64 @guaranteed, const 4_i64 @guaranteed)
    StorageLive(_2)
    _2 = call builtin string.s(const "Arthur" @guaranteed, const 0_i64 @guaranteed, const 6_i64 @guaranteed)
    StorageLive(_3)
    _3 = [move _1, move _2]
    StorageDead(_2)
    StorageLive(_4)
    _4 = len(_3)
    StorageLive(_5)
    _5 = copy _4 as i64
    _6 = copy _5 as u64
    _7 = const 0_u64 < copy _6
    switchInt(copy _7) -> [0: bb1, otherwise: bb2]

  bb1:
    trap RE2020(const 0_i64, copy _5)

  bb2:
    StorageLive(_8)
    _8 = [copy (_3[const 0_i64]); const 3_i64]
    StorageDead(_5)
    StorageDead(_4)
    StorageLive(_9)
    _9 = call builtin string.s(const "Zaphod" @guaranteed, const 0_i64 @guaranteed, const 6_i64 @guaranteed)
    StorageLive(_10)
    _10 = len(_3)
    StorageLive(_11)
    _11 = copy _10 as i64
    _12 = copy _11 as u64
    _13 = const 1_u64 < copy _12
    switchInt(copy _13) -> [0: bb3, otherwise: bb4]

  bb3:
    trap RE2020(const 1_i64, copy _11)

  bb4:
    Drop((_3[const 1_i64]))
    (_3[const 1_i64]) = move _9
    StorageDead(_11)
    StorageDead(_10)
    StorageDead(_9)
    StorageLive(_14)
    BeginBorrow(b0, _8, peek, for _14)
    _14 = copy (_8[const 0_i64])
    StorageLive(_15)
    _15 = clone(copy _14)
    StorageLive(_16)
    _16 = call builtin array.push(copy _3 @inout, move _15 @owned)
    StorageDead(_16)
    StorageDead(_15)
    StorageLive(_17)
    _17 = len(_3)
    StorageLive(_18)
    _18 = copy _17 as i64
    _19 = copy _18 as u64
    _20 = const 2_u64 < copy _19
    switchInt(copy _20) -> [0: bb5, otherwise: bb6]

  bb5:
    trap RE2020(const 2_i64, copy _18)

  bb6:
    StorageLive(_21)
    _21 = call builtin array.len(copy _3 @guaranteed)
    StorageLive(_22)
    _22 = call builtin interp@(string, string, string, string, string, string, i64)(copy _14 @guaranteed, const " " @guaranteed, copy (_8[const 1_i64]) @guaranteed, const " " @guaranteed, copy (_3[const 2_i64]) @guaranteed, const " " @guaranteed, copy _21 @guaranteed)
    StorageLive(_23)
    _23 = call builtin println@(string)(copy _22 @guaranteed)
    EndBorrow(b0)
    StorageDead(_23)
    Drop(_22)
    StorageDead(_22)
    StorageDead(_21)
    StorageDead(_18)
    StorageDead(_17)
    _0 = const 0_i32
    StorageDead(_14)
    Drop(_8)
    StorageDead(_8)
    Drop(_3)
    StorageDead(_3)
    StorageDead(_1)
    return
}
