unit test_slir_borrowed_param_rebind

fn pick(_1: string @guaranteed, _2: bool @guaranteed) -> ~ {
    let _0: ~
    let _3: bool
    let _4: ~

  bb0:
    StorageLive(_3)
    _3 = const false
    switchInt(copy _2) -> [0: bb2, otherwise: bb1]

  bb1:
    _1 = call builtin string.concat(const "new" @guaranteed, const "" @guaranteed)
    _3 = const true
    goto -> bb2

  bb2:
    StorageLive(_4)
    _4 = call builtin println@(string)(copy _1 @guaranteed)
    StorageDead(_4)
    _0 = const ~
    DropIfSet(_1, _3)
    StorageDead(_3)
    return
}

fn main() -> i32 {
    let _0: i32
    let _1: string                         // c
    let _2: ~
    let _3: ~
    let _4: ~
    let _5: string
    let _6: Maybe@(string)                 // m
    let _7: i32
    let _8: string                         // n
    let _9: string
    let _10: ~
    let _11: i32
    let _12: string view                   // n
    let _13: ~
    let _14: ~

  bb0:
    StorageLive(_1)
    _1 = call builtin string.concat(const "Mostly" @guaranteed, const "" @guaranteed)
    StorageLive(_2)
    _2 = call @pick(copy _1 @guaranteed, const true @guaranteed)
    StorageDead(_2)
    StorageLive(_3)
    _3 = call @pick(copy _1 @guaranteed, const false @guaranteed)
    StorageDead(_3)
    StorageLive(_4)
    _4 = call builtin println@(string)(copy _1 @guaranteed)
    StorageDead(_4)
    StorageLive(_5)
    _5 = call builtin string.concat(const "Ford" @guaranteed, const "" @guaranteed)
    StorageLive(_6)
    _6 = Maybe::Some(move _5)
    StorageDead(_5)
    _7 = discriminant(_6)
    switchInt(copy _7) -> [0: bb1, 1: bb2, otherwise: unreachable]

  bb1:
    StorageLive(_8)
    BeginBorrow(b0, _6, poke)
    _8 = ref poke ((_6 as Some).0)
    StorageLive(_9)
    _9 = call builtin string.concat(const "Arthur" @guaranteed, const " Dent" @guaranteed)
    Drop(_8)
    _8 = move _9
    EndBorrow(b0)
    StorageDead(_9)
    StorageDead(_8)
    goto -> bb3

  bb2:
    StorageLive(_10)
    _10 = call builtin println@(string)(const "none" @guaranteed)
    StorageDead(_10)
    goto -> bb3

  bb3:
    _11 = discriminant(_6)
    switchInt(copy _11) -> [0: bb4, 1: bb5, otherwise: unreachable]

  bb4:
    StorageLive(_12)
    BeginBorrow(b1, _6, peek, for _12)
    _12 = copy ((_6 as Some).0)
    StorageLive(_13)
    _13 = call builtin println@(string)(copy _12 @guaranteed)
    EndBorrow(b1)
    StorageDead(_13)
    StorageDead(_12)
    goto -> bb6

  bb5:
    StorageLive(_14)
    _14 = call builtin println@(string)(const "none" @guaranteed)
    StorageDead(_14)
    goto -> bb6

  bb6:
    _0 = const 0_i32
    Drop(_6)
    StorageDead(_6)
    Drop(_1)
    StorageDead(_1)
    return
}
