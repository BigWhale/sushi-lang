# EXPECT_ERROR_CODES_EXACT: CE0155
# EXPECT_STDERR_CONTAINS: "emit, eat"
# EXPECT_DUMP_SLIR: test_err_slir_move_rebind_move.slir
#
# A local that is moved, rebound and moved again. On the straight line the state of the
# local is exact: the rebind of the moved local drops nothing and writes the new value in
# place, and the second move leaves nothing to drop at the exit. borrow writes no
# cond_moved row for it, because no exit keeps it.

fn eat(nom string text) ~:
    println(text)

fn main() i32:
    let string word = "{1}"
    eat(nom word)
    word := "{2}"
    eat(nom word)
    return 0
