unit test_slir_range_readable

fn main() -> i32 {
    let _0: i32
    let _1: i64
    let _2: i32
    let _3: bool
    let _4: i32                            // i
    let _5: string
    let _6: ~
    let _7: ~
    let _8: i32                            // count
    let _9: i64
    let _10: i32
    let _11: bool
    let _12: ~

  bb0:
    StorageLive(_1)
    _1 = const 0_i64
    StorageLive(_2)
    _2 = const 0_i32
    goto -> bb1

  bb1:
    StorageLive(_3)
    _3 = copy _1 < const 3_i64
    switchInt(copy _3) -> [0: bb4, otherwise: bb2]

  bb2:
    StorageDead(_3)
    StorageLive(_4)
    _4 = const 4_i32 - copy _2
    StorageLive(_5)
    _5 = call builtin interp@(i32, string)(copy _4 @guaranteed, const " " @guaranteed)
    StorageLive(_6)
    _6 = call builtin print@(string)(copy _5 @guaranteed)
    StorageDead(_6)
    Drop(_5)
    StorageDead(_5)
    StorageDead(_4)
    goto -> bb3

  bb3:
    _1 = copy _1 + const 1_i64
    _2 = copy _2 + const 1_i32
    goto -> bb1

  bb4:
    StorageDead(_3)
    goto -> bb5

  bb5:
    StorageDead(_2)
    StorageDead(_1)
    StorageLive(_7)
    _7 = call builtin println@(string)(const "" @guaranteed)
    StorageDead(_7)
    StorageLive(_8)
    _8 = const 0_i32
    StorageLive(_9)
    _9 = const 0_i64
    StorageLive(_10)
    _10 = const 0_i32
    goto -> bb6

  bb6:
    StorageLive(_11)
    _11 = copy _9 < const 3_i64
    switchInt(copy _11) -> [0: bb9, otherwise: bb7]

  bb7:
    StorageDead(_11)
    _8 = user copy _8 + const 1_i32
    goto -> bb8

  bb8:
    _9 = copy _9 + const 1_i64
    _10 = copy _10 + const 1_i32
    goto -> bb6

  bb9:
    StorageDead(_11)
    goto -> bb10

  bb10:
    StorageDead(_10)
    StorageDead(_9)
    StorageLive(_12)
    _12 = call builtin println@(i32)(copy _8 @guaranteed)
    StorageDead(_12)
    _0 = const 0_i32
    StorageDead(_8)
    return
}
