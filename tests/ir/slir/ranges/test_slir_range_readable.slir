unit test_slir_range_readable

fn main() -> i32 {
    let _0: i32
    let _1: i32
    let _2: bool
    let _3: i32                            // i
    let _4: string
    let _5: ~
    let _6: ~
    let _7: i32                            // count
    let _8: i32
    let _9: bool
    let _10: ~

  bb0:
    StorageLive(_1)
    _1 = const 0_i32
    goto -> bb1

  bb1:
    StorageLive(_2)
    _2 = copy _1 < const 3_i32
    switchInt(copy _2) -> [0: bb4, otherwise: bb2]

  bb2:
    StorageDead(_2)
    StorageLive(_3)
    _3 = const 4_i32 - copy _1
    StorageLive(_4)
    _4 = call builtin interp@(i32, string)(copy _3 @guaranteed, const " " @guaranteed)
    StorageLive(_5)
    _5 = call builtin print@(string)(copy _4 @guaranteed)
    StorageDead(_5)
    Drop(_4)
    StorageDead(_4)
    StorageDead(_3)
    goto -> bb3

  bb3:
    _1 = copy _1 + const 1_i32
    goto -> bb1

  bb4:
    StorageDead(_2)
    goto -> bb5

  bb5:
    StorageDead(_1)
    StorageLive(_6)
    _6 = call builtin println@(string)(const "" @guaranteed)
    StorageDead(_6)
    StorageLive(_7)
    _7 = const 0_i32
    StorageLive(_8)
    _8 = const 0_i32
    goto -> bb6

  bb6:
    StorageLive(_9)
    _9 = copy _8 < const 3_i32
    switchInt(copy _9) -> [0: bb9, otherwise: bb7]

  bb7:
    StorageDead(_9)
    _7 = user copy _7 + const 1_i32
    goto -> bb8

  bb8:
    _8 = copy _8 + const 1_i32
    goto -> bb6

  bb9:
    StorageDead(_9)
    goto -> bb10

  bb10:
    StorageDead(_8)
    StorageLive(_10)
    _10 = call builtin println@(i32)(copy _7 @guaranteed)
    StorageDead(_10)
    _0 = const 0_i32
    StorageDead(_7)
    return
}
