unit test_slir_range_counted

fn lo() -> i32 {
    let _0: i32
    let _1: ~

  bb0:
    StorageLive(_1)
    _1 = call builtin println@(string)(const "lo" @guaranteed)
    StorageDead(_1)
    _0 = const 1_i32
    return
}

fn hi() -> i32 {
    let _0: i32
    let _1: ~

  bb0:
    StorageLive(_1)
    _1 = call builtin println@(string)(const "hi" @guaranteed)
    StorageDead(_1)
    _0 = const 7_i32
    return
}

fn main() -> i32 {
    let _0: i32
    let _1: i32
    let _2: i32
    let _3: i32
    let _4: i32
    let _5: bool
    let _6: i32                            // i
    let _7: i32
    let _8: bool
    let _9: string
    let _10: ~
    let _11: ~
    let _12: i32                           // n
    let _13: i32
    let _14: i32
    let _15: i32
    let _16: bool
    let _17: i32                           // i
    let _18: string                        // word
    let _19: bool
    let _20: ~

  bb0:
    StorageLive(_1)
    _1 = call @lo()
    StorageLive(_2)
    _2 = call @hi()
    StorageLive(_3)
    _3 = copy _2 - copy _1
    StorageLive(_4)
    _4 = const 0_i32
    goto -> bb1

  bb1:
    StorageLive(_5)
    _5 = copy _4 < copy _3
    switchInt(copy _5) -> [0: bb4, otherwise: bb2]

  bb2:
    StorageDead(_5)
    StorageLive(_6)
    _6 = copy _1 + copy _4
    StorageLive(_7)
    _7 = copy _6 % const 2_i32
    StorageLive(_8)
    _8 = copy _7 == const 0_i32
    StorageDead(_7)
    switchInt(copy _8) -> [0: bb7, otherwise: bb6]

  bb3:
    _4 = copy _4 + const 1_i32
    goto -> bb1

  bb4:
    StorageDead(_5)
    goto -> bb5

  bb5:
    StorageDead(_4)
    StorageDead(_3)
    StorageDead(_2)
    StorageDead(_1)
    StorageLive(_11)
    _11 = call builtin println@(string)(const "" @guaranteed)
    StorageDead(_11)
    StorageLive(_12)
    _12 = const 3_i32
    StorageLive(_13)
    _13 = copy _12
    StorageLive(_14)
    _14 = const 6_i32 - copy _13
    _14 = copy _14 + const 1_i32
    StorageLive(_15)
    _15 = const 0_i32
    goto -> bb9

  bb6:
    StorageDead(_8)
    StorageDead(_6)
    goto -> bb3

  bb7:
    StorageDead(_8)
    goto -> bb8

  bb8:
    StorageLive(_9)
    _9 = call builtin interp@(i32, string)(copy _6 @guaranteed, const " " @guaranteed)
    StorageLive(_10)
    _10 = call builtin print@(string)(copy _9 @guaranteed)
    StorageDead(_10)
    Drop(_9)
    StorageDead(_9)
    StorageDead(_6)
    goto -> bb3

  bb9:
    StorageLive(_16)
    _16 = copy _15 < copy _14
    switchInt(copy _16) -> [0: bb12, otherwise: bb10]

  bb10:
    StorageDead(_16)
    StorageLive(_17)
    _17 = const 6_i32 - copy _15
    StorageLive(_18)
    _18 = call builtin interp@(string, i32)(const "n" @guaranteed, copy _17 @guaranteed)
    StorageLive(_19)
    _19 = copy _17 == const 3_i32
    switchInt(copy _19) -> [0: bb15, otherwise: bb14]

  bb11:
    _15 = copy _15 + const 1_i32
    goto -> bb9

  bb12:
    StorageDead(_16)
    goto -> bb13

  bb13:
    StorageDead(_15)
    StorageDead(_14)
    StorageDead(_13)
    _0 = const 0_i32
    StorageDead(_12)
    return

  bb14:
    StorageDead(_19)
    Drop(_18)
    StorageDead(_18)
    StorageDead(_17)
    goto -> bb13

  bb15:
    StorageDead(_19)
    goto -> bb16

  bb16:
    StorageLive(_20)
    _20 = call builtin println@(string)(copy _18 @guaranteed)
    StorageDead(_20)
    Drop(_18)
    StorageDead(_18)
    StorageDead(_17)
    goto -> bb11
}
