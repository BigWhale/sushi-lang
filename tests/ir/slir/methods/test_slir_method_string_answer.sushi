# EXPECT_DUMP_SLIR: test_slir_method_string_answer.slir
#
# A string method that answers a string writes it into a fresh local that owns it. The drop
# of that local comes from the drop placement. The receiver is the first operand, and an
# argument follows it with its convention.

fn main() i32:
    let string s = "Mostly Harmless"
    let string upper = s.upper()
    let string again = upper.replace("M", "m")
    return again.len()
