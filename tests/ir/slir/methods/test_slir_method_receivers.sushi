# EXPECT_RUNTIME_EXIT: 20
# EXPECT_STDOUT_EXACT: "7\n107\nMostly Harmless!\n"
# EXPECT_NO_LEAKS
# EXPECT_DUMP_SLIR: test_slir_method_receivers.slir
#
# A method body is a function whose first parameter is its receiver, with the convention
# of its `self`: no mode is @guaranteed, `peek self` is @in_guaranteed, `poke self` is
# @inout and `nom self` is @owned. A static has no receiver. A call of a method or a static
# is a direct call of the symbol of the method, the receiver first.

struct Counter:
    i32 n

extend Counter static start(i32 n) Counter:
    return Counter(n)

extend Counter read() i32:
    return self.n

extend Counter seen(peek self) i32:
    return self.n + 100

extend Counter bump(poke self, i32 by) ~:
    self.n := self.n + by

extend Counter done(nom self) i32:
    return self.n * 2

extend string shout() string:
    return "{self}!"

fn main() i32:
    let Counter c = Counter.start(3)
    c.bump(4)
    println(c.read())
    println(c.seen())
    let string s = "Mostly Harmless"
    println(s.shout())
    return c.done() + 6
