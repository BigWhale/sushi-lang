unit test_err_slir_while_break_continue

fn main() -> i32 {
    let _0: i32
    let _1: i32                            // i
    let _2: bool
    let _3: string                         // word
    let _4: bool
    let _5: bool
    let _6: ~

  bb0:
    StorageLive(_1)
    _1 = const 0_i32
    goto -> bb1

  bb1:
    StorageLive(_2)
    _2 = copy _1 < const 4_i32
    switchInt(copy _2) -> [0: bb3, otherwise: bb2]

  bb2:
    StorageDead(_2)
    _1 = copy _1 + const 1_i32
    StorageLive(_3)
    _3 = call builtin interp@(i32)(copy _1 @guaranteed)
    StorageLive(_4)
    _4 = copy _1 == const 2_i32
    switchInt(copy _4) -> [0: bb6, otherwise: bb5]

  bb3:
    StorageDead(_2)
    goto -> bb4

  bb4:
    _0 = copy _1
    StorageDead(_1)
    return

  bb5:
    StorageDead(_4)
    Drop(_3)
    StorageDead(_3)
    goto -> bb1

  bb6:
    StorageDead(_4)
    goto -> bb7

  bb7:
    StorageLive(_5)
    _5 = copy _1 == const 3_i32
    switchInt(copy _5) -> [0: bb9, otherwise: bb8]

  bb8:
    StorageDead(_5)
    Drop(_3)
    StorageDead(_3)
    goto -> bb4

  bb9:
    StorageDead(_5)
    goto -> bb10

  bb10:
    StorageLive(_6)
    _6 = call builtin println@(string)(copy _3 @guaranteed)
    StorageDead(_6)
    Drop(_3)
    StorageDead(_3)
    goto -> bb1
}
