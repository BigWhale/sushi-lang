unit test_err_slir_while_break_continue

fn main() -> i32 {
    let _0: i32
    let _1: i32                            // i
    let _2: bool
    let _3: string                         // word
    let _4: bool
    let _5: bool
    let _6: ~

  bb0:
    StorageLive(_1)
    _1 = const 0_i32
    goto -> bb1

  bb1:
    _2 = copy _1 < const 4_i32
    switchInt(copy _2) -> [0: bb3, otherwise: bb2]

  bb2:
    _1 = copy _1 + const 1_i32
    StorageLive(_3)
    _3 = call builtin interp@(i32)(copy _1 @guaranteed)
    _4 = copy _1 == const 2_i32
    switchInt(copy _4) -> [0: bb5, otherwise: bb4]

  bb3:
    _0 = copy _1
    StorageDead(_1)
    return

  bb4:
    Drop(_3)
    StorageDead(_3)
    goto -> bb1

  bb5:
    _5 = copy _1 == const 3_i32
    switchInt(copy _5) -> [0: bb7, otherwise: bb6]

  bb6:
    Drop(_3)
    StorageDead(_3)
    goto -> bb3

  bb7:
    StorageLive(_6)
    _6 = call builtin println@(string)(copy _3 @guaranteed)
    StorageDead(_6)
    Drop(_3)
    StorageDead(_3)
    goto -> bb1
}
