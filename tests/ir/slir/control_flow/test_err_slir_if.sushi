# EXPECT_ERROR_CODES_EXACT: CE0155
# EXPECT_STDERR_CONTAINS: "emit, pick"
# EXPECT_DUMP_SLIR: test_err_slir_if.slir
#
# An `if` switches on its condition: a zero goes to the `else` block, or to the join block
# when there is no `else`; any other value goes to the `then` block (ir.md 8.9). Blocks get
# their ids in the order that lowering makes them: `then`, `else`, then the join. A
# condition that is not a local goes into a local of its own: it is live before its write,
# and dead at the top of each block that the switch goes to. The `else` block of `pick`
# drops its string at its end. Each block of `grade` returns, so no join block is made.

fn pick(bool a, i32 n) i32:
    let i32 x = 1
    if (a):
        x := 2
    if (n == 3):
        x := x + 3
    else:
        let string word = "{n}"
        println(word)
    return x

fn grade(i32 n) i32:
    if (n < 3):
        return 1
    elif (n < 6):
        return 2
    else:
        return 3

fn main() i32:
    return 0
