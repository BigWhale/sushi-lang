unit test_slir_while_short_circuit

fn count(_1: bool @guaranteed, _2: i32 @guaranteed) -> i32 {
    let _0: i32
    let _3: i32                            // i
    let _4: bool

  bb0:
    StorageLive(_3)
    _3 = const 0_i32
    goto -> bb1

  bb1:
    StorageLive(_4)
    _4 = copy _1
    switchInt(copy _4) -> [0: bb3, otherwise: bb2]

  bb2:
    _4 = copy _3 < copy _2
    goto -> bb3

  bb3:
    switchInt(copy _4) -> [0: bb5, otherwise: bb4]

  bb4:
    StorageDead(_4)
    _3 = copy _3 + const 1_i32
    goto -> bb1

  bb5:
    StorageDead(_4)
    goto -> bb6

  bb6:
    _0 = copy _3
    StorageDead(_3)
    return
}

fn main() -> i32 {
    let _0: i32
    let _1: i32
    let _2: ~

  bb0:
    StorageLive(_1)
    _1 = call @count(const true @guaranteed, const 3_i32 @guaranteed)
    StorageLive(_2)
    _2 = call builtin println@(i32)(copy _1 @guaranteed)
    StorageDead(_2)
    StorageDead(_1)
    _0 = const 0_i32
    return
}
