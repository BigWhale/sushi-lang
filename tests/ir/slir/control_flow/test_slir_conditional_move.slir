  bb4:
    StorageLive(_9)
    _9 = call @eat(move _1 @owned)
    _3 = const false
    StorageDead(_9)
    goto -> bb5

  bb5:
    _0 = const ~
    Drop(_4)
    StorageDead(_5)
    StorageDead(_4)
    DropIfSet(_1, _3)
    StorageDead(_3)
    return
}

