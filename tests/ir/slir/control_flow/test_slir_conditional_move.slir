unit test_slir_conditional_move

fn eat(_1: string @owned) -> ~ {
    let _0: ~
    let _2: ~

  bb0:
    StorageLive(_2)
    _2 = call builtin println@(string)(copy _1 @guaranteed)
    StorageDead(_2)
    _0 = const ~
    Drop(_1)
    return
}

fn feed(_1: string @owned, _2: bool @guaranteed) -> ~ {
    let _0: ~
    let _3: bool
    let _4: string                         // word
    let _5: bool
    let _6: ~
    let _7: ~
    let _8: ~
    let _9: ~

  bb0:
    StorageLive(_3)
    _3 = const true
    StorageLive(_4)
    _4 = call builtin interp@(string, string)(copy _1 @guaranteed, const "!" @guaranteed)
    StorageLive(_5)
    _5 = const true
    switchInt(copy _2) -> [0: bb2, otherwise: bb1]

  bb1:
    StorageLive(_6)
    _6 = call @eat(move _4 @owned)
    _5 = const false
    StorageDead(_6)
    goto -> bb3

  bb2:
    StorageLive(_7)
    _7 = call builtin println@(string)(const "kept" @guaranteed)
    StorageDead(_7)
    goto -> bb3

  bb3:
