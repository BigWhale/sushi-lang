# EXPECT_ERROR_CODES_EXACT: CE0155
# EXPECT_STDERR_CONTAINS: "emit, Builtin"
# EXPECT_DUMP_SLIR: test_err_slir_break_flag.slir
#
# A drop flag with a `break`. The `break` path moves `w` and the path of the condition does
# not, so the two states meet at the exit of the loop: `w` gets a flag, and the exit drops
# it with `DropIfSet`. The string `v` of the body is moved before the `continue`, so that
# path drops nothing; the `break` and the end of the body drop it. A condition local is
# live before its first write and dead at the top of each block that its switch goes to;
# with no `else`, the zero edge goes to a block of its own for that.

fn eat(nom string t) ~:
    println(t)

fn main() i32:
    let i32 i = 0
    let string w = "{i}"
    while (i < 4):
        i := i + 1
        let string v = "{i}"
        if (i == 2):
            eat(nom v)
            continue
        if (i == 3):
            eat(nom w)
            break
        println(v)
    return i
