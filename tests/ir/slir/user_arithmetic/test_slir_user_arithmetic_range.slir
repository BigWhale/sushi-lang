unit test_slir_user_arithmetic_range

fn main() -> i32 {
    let _0: i32
    let _1: i32                            // n
    let _2: i32
    let _3: i32
    let _4: i64
    let _5: i64
    let _6: i64
    let _7: i64
    let _8: i32
    let _9: bool
    let _10: i32                           // i
    let _11: i32
    let _12: ~
    let _13: i32
    let _14: i64
    let _15: i64
    let _16: i32
    let _17: i64
    let _18: i32
    let _19: bool
    let _20: i32                           // i
    let _21: i32
    let _22: ~

  bb0:
    StorageLive(_1)
    _1 = const 2_i32
    StorageLive(_2)
    _2 = copy _1
    StorageLive(_3)
    _3 = user copy _1 + const 2_i32
    StorageLive(_4)
    _4 = copy _2 as i64
    StorageLive(_5)
    _5 = copy _3 as i64
    StorageLive(_6)
    _6 = copy _5 - copy _4
    _6 = copy _6 + const 1_i64
    StorageLive(_7)
    _7 = const 0_i64
    StorageLive(_8)
    _8 = const 0_i32
    goto -> bb1

  bb1:
    StorageLive(_9)
    _9 = copy _7 < copy _6
    switchInt(copy _9) -> [0: bb4, otherwise: bb2]

  bb2:
    StorageDead(_9)
    StorageLive(_10)
    _10 = copy _2 + copy _8
    StorageLive(_11)
    _11 = user copy _10 + const 10_i32
    StorageLive(_12)
    _12 = call builtin println@(i32)(copy _11 @guaranteed)
    StorageDead(_12)
    StorageDead(_11)
    StorageDead(_10)
    goto -> bb3

  bb3:
    _7 = copy _7 + const 1_i64
    _8 = copy _8 + const 1_i32
    goto -> bb1

  bb4:
    StorageDead(_9)
    goto -> bb5

  bb5:
    StorageDead(_8)
    StorageDead(_7)
    StorageDead(_6)
    StorageDead(_5)
    StorageDead(_4)
    StorageDead(_3)
    StorageDead(_2)
    StorageLive(_13)
    _13 = copy _1
    StorageLive(_14)
    _14 = copy _13 as i64
    StorageLive(_15)
    _15 = copy _14 - const 1_i64
    StorageLive(_16)
    _16 = copy _13 - const 1_i32
    StorageLive(_17)
    _17 = const 0_i64
    StorageLive(_18)
    _18 = const 0_i32
    goto -> bb6

  bb6:
    StorageLive(_19)
    _19 = copy _17 < copy _15
    switchInt(copy _19) -> [0: bb9, otherwise: bb7]

  bb7:
    StorageDead(_19)
    StorageLive(_20)
    _20 = copy _16 - copy _18
    StorageLive(_21)
    _21 = user copy _20 + const 10_i32
    StorageLive(_22)
    _22 = call builtin println@(i32)(copy _21 @guaranteed)
    StorageDead(_22)
    StorageDead(_21)
    StorageDead(_20)
    goto -> bb8

  bb8:
    _17 = copy _17 + const 1_i64
    _18 = copy _18 + const 1_i32
    goto -> bb6

  bb9:
    StorageDead(_19)
    goto -> bb10

  bb10:
    StorageDead(_18)
    StorageDead(_17)
    StorageDead(_16)
    StorageDead(_15)
    StorageDead(_14)
    StorageDead(_13)
    _0 = const 0_i32
    StorageDead(_1)
    return
}
