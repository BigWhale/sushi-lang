unit test_slir_user_arithmetic_range

fn main() -> i32 {
    let _0: i32
    let _1: i32                            // n
    let _2: i32
    let _3: i32
    let _4: i32
    let _5: i32
    let _6: bool
    let _7: i32                            // i
    let _8: i32
    let _9: ~
    let _10: i32
    let _11: i32
    let _12: i32
    let _13: i32
    let _14: bool
    let _15: i32                           // i
    let _16: i32
    let _17: ~

  bb0:
    StorageLive(_1)
    _1 = const 2_i32
    StorageLive(_2)
    _2 = copy _1
    StorageLive(_3)
    _3 = user copy _1 + const 2_i32
    StorageLive(_4)
    _4 = copy _3 - copy _2
    _4 = copy _4 + const 1_i32
    StorageLive(_5)
    _5 = const 0_i32
    goto -> bb1

  bb1:
    StorageLive(_6)
    _6 = copy _5 < copy _4
    switchInt(copy _6) -> [0: bb4, otherwise: bb2]

  bb2:
    StorageDead(_6)
    StorageLive(_7)
    _7 = copy _2 + copy _5
    StorageLive(_8)
    _8 = user copy _7 + const 10_i32
    StorageLive(_9)
    _9 = call builtin println@(i32)(copy _8 @guaranteed)
    StorageDead(_9)
    StorageDead(_8)
    StorageDead(_7)
    goto -> bb3

  bb3:
    _5 = copy _5 + const 1_i32
    goto -> bb1

  bb4:
    StorageDead(_6)
    goto -> bb5

  bb5:
    StorageDead(_5)
    StorageDead(_4)
    StorageDead(_3)
    StorageDead(_2)
    StorageLive(_10)
    _10 = copy _1
    StorageLive(_11)
    _11 = copy _10 - const 1_i32
    StorageLive(_12)
    _12 = copy _10 - const 1_i32
    StorageLive(_13)
    _13 = const 0_i32
    goto -> bb6

  bb6:
    StorageLive(_14)
    _14 = copy _13 < copy _11
    switchInt(copy _14) -> [0: bb9, otherwise: bb7]

  bb7:
    StorageDead(_14)
    StorageLive(_15)
    _15 = copy _12 - copy _13
    StorageLive(_16)
    _16 = user copy _15 + const 10_i32
    StorageLive(_17)
    _17 = call builtin println@(i32)(copy _16 @guaranteed)
    StorageDead(_17)
    StorageDead(_16)
    StorageDead(_15)
    goto -> bb8

  bb8:
    _13 = copy _13 + const 1_i32
    goto -> bb6

  bb9:
    StorageDead(_14)
    goto -> bb10

  bb10:
    StorageDead(_13)
    StorageDead(_12)
    StorageDead(_11)
    StorageDead(_10)
    _0 = const 0_i32
    StorageDead(_1)
    return
}
