# EXPECT_DUMP_SLIR: test_slir_stdlib_cstr_owning_row.slir
# EXPECT_STDOUT_EXACT: "Mostly Harmless\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
#
# A call of a row with a `cstr` parameter is a `Direct` callee of its module, and the
# string operand is `Guaranteed`: no SLIR local holds the C copy. The answer of `read_dir`
# owns, so its place drops at the end of its scope.
use <io/files>

fn main() i32:
    mkdir("Mostly Harmless", 0o755).realise(-1)
    let string dir = "."
    let string[] names = read_dir(dir).realise(from([]))
    foreach(name in names.iter()):
        println(name)
    rmdir("Mostly Harmless").realise(-1)
    return 0
