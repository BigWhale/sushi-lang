# EXPECT_DUMP_SLIR: test_slir_stdlib_cstr_owning_row.slir
# EXPECT_STDOUT_EXACT: "127.0.0.1\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
#
# A call of a row with a `cstr` parameter is a `Direct` callee of its module, and the
# string operand is `Guaranteed`: no SLIR local holds the C copy. The answer of
# `sock_dns_resolve` owns, so its place drops at the end of its scope.
use <net/socket>

fn main() i32:
    let string host = "127.0.0.1"
    let string[] names = sock_dns_resolve(host).realise(from([]))
    foreach(name in names.iter()):
        println(name)
    return 0
