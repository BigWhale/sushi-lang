unit test_slir_assert_holds

fn check(_1: bool @guaranteed, _2: i32 @guaranteed) -> ~ {
    let _0: ~
    let _3: bool
    let _4: string
    let _5: bool

  bb0:
    switchInt(copy _1) -> [0: bb1, otherwise: bb2]

  bb1:
    trap RE2026(const "./tests/ir/slir/assert/test_slir_assert_holds.sushi:14:5", const "")

  bb2:
    StorageLive(_3)
    _3 = copy _2 > const 0_i32
    switchInt(copy _3) -> [0: bb3, otherwise: bb4]

  bb3:
    StorageDead(_3)
    StorageLive(_4)
    _4 = call builtin interp@(string, i32)(const "n is " @guaranteed, copy _2 @guaranteed)
    trap RE2026(const "./tests/ir/slir/assert/test_slir_assert_holds.sushi:15:5: ", copy _4)

  bb4:
    StorageDead(_3)
    StorageLive(_5)
    _5 = copy _2 < const 10_i32
    switchInt(copy _5) -> [0: bb5, otherwise: bb6]

  bb5:
    StorageDead(_5)
    trap RE2026(const "./tests/ir/slir/assert/test_slir_assert_holds.sushi:16:5: ", const "n is small")

  bb6:
    StorageDead(_5)
    _0 = const ~
    return
}

fn main() -> i32 {
    let _0: i32
    let _1: ~
    let _2: ~

  bb0:
    StorageLive(_1)
    _1 = call @check(const true @guaranteed, const 3_i32 @guaranteed)
    StorageDead(_1)
    StorageLive(_2)
    _2 = call builtin println@(string)(const "Mostly Harmless" @guaranteed)
    StorageDead(_2)
    _0 = const 0_i32
    return
}
