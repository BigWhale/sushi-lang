unit test_slir_assert_fails

fn never() -> ~ {
    let _0: ~

  bb0:
    switchInt(const false) -> [0: bb1, otherwise: bb2]

  bb1:
    trap RE2026(const "./tests/ir/slir/assert/test_slir_assert_fails.sushi:12:5", const "")

  bb2:
    _0 = const ~
    return
}

fn main() -> i32 {
    let _0: i32
    let _1: i32                            // count
    let _2: string                         // why
    let _3: ~
    let _4: bool
    let _5: ~
    let _6: ~

  bb0:
    StorageLive(_1)
    _1 = const 3_i32
    StorageLive(_2)
    _2 = call builtin interp@(string, i32)(const "the count was " @guaranteed, copy _1 @guaranteed)
    StorageLive(_3)
    _3 = call builtin println@(string)(const "before" @guaranteed)
    StorageDead(_3)
    StorageLive(_4)
    _4 = copy _1 == const 4_i32
    switchInt(copy _4) -> [0: bb1, otherwise: bb2]

  bb1:
    StorageDead(_4)
    trap RE2026(const "./tests/ir/slir/assert/test_slir_assert_fails.sushi:18:5: ", copy _2)

  bb2:
    StorageDead(_4)
    StorageLive(_5)
    _5 = call @never()
    StorageDead(_5)
    StorageLive(_6)
    _6 = call builtin println@(string)(const "after" @guaranteed)
    StorageDead(_6)
    _0 = const 0_i32
    Drop(_2)
    StorageDead(_2)
    StorageDead(_1)
    return
}
