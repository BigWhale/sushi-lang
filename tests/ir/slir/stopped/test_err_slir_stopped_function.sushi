# EXPECT_ERROR_CODES_EXACT: CE0155
# EXPECT_STDERR_CONTAINS: "slir, If"
# EXPECT_DUMP_SLIR: test_err_slir_stopped_function.slir
#
# The SLIR lowering finishes `answer`, and it stops in `main` at the `if`, which it does
# not lower yet. The dump prints the SLIR of `answer` and one line for `main`. A stop of
# the SLIR lowering comes before the stop of the next stage, so the program stops at
# `slir, If`.

fn answer() i32:
    return 42

fn main() i32:
    if (answer() == 42):
        return 0
    return 1
