unit test_slir_list_argument_first

fn main() -> i32 {
    let _0: i32
    let _1: List@(i32)                     // xs
    let _2: ~
    let _3: Maybe@(i32)
    let _4: i32
    let _5: i32
    let _6: i32
    let _7: i32
    let _8: ~
    let _9: i32
    let _10: i32
    let _11: bool                          // found
    let _12: i32
    let _13: i32
    let _14: Maybe@(i32)
    let _15: i32
    let _16: i32
    let _17: i32
    let _18: i32
    let _19: string
    let _20: ~

  bb0:
    StorageLive(_1)
    _1 = call builtin List.new()
    StorageLive(_2)
    _2 = call builtin list.push(copy _1 @inout, const 3_i32 @owned)
    StorageDead(_2)
    StorageLive(_3)
    _3 = call builtin list.pop(copy _1 @inout)
    StorageLive(_4)
    _5 = discriminant(_3)
    switchInt(copy _5) -> [0: bb1, otherwise: bb2]

  bb1:
    _4 = copy ((_3 as Some).0)
    goto -> bb3

  bb2:
    _4 = const 0_i32
    goto -> bb3

  bb3:
    StorageLive(_6)
    _6 = copy _4
    StorageLive(_7)
    _7 = copy _6 * const 10_i32
    StorageLive(_8)
    _8 = call builtin list.push(copy _1 @inout, move _7 @owned)
    StorageDead(_8)
    StorageDead(_7)
    StorageDead(_6)
    StorageDead(_4)
    StorageDead(_3)
    StorageLive(_9)
    _9 = call builtin list.len(copy _1 @guaranteed)
    StorageLive(_10)
    _10 = copy _9 + const 1_i32
    StorageLive(_11)
    _11 = call builtin list.contains(copy _1 @guaranteed, copy _10 @guaranteed)
    StorageDead(_10)
    StorageDead(_9)
    StorageLive(_12)
    _12 = call builtin list.len(copy _1 @guaranteed)
    StorageLive(_13)
    _13 = copy _12 + const 1_i32
    StorageLive(_14)
    _14 = call builtin list.last(copy _1 @guaranteed)
    StorageLive(_15)
    _15 = neg const 1_i32
    StorageLive(_16)
    _17 = discriminant(_14)
    switchInt(copy _17) -> [0: bb4, otherwise: bb5]

  bb4:
    _16 = copy ((_14 as Some).0)
    goto -> bb6

  bb5:
    _16 = copy _15
    goto -> bb6

  bb6:
    StorageLive(_18)
    _18 = copy _16
    StorageLive(_19)
    _19 = call builtin interp@(i32, string, i32, string, bool)(copy _13 @guaranteed, const " " @guaranteed, copy _18 @guaranteed, const " " @guaranteed, copy _11 @guaranteed)
    StorageLive(_20)
    _20 = call builtin println@(string)(copy _19 @guaranteed)
    StorageDead(_20)
    Drop(_19)
    StorageDead(_19)
    StorageDead(_18)
    StorageDead(_16)
    StorageDead(_15)
    StorageDead(_14)
    StorageDead(_13)
    StorageDead(_12)
    _0 = const 0_i32
    StorageDead(_11)
    Drop(_1)
    StorageDead(_1)
    return
}
