unit test_slir_list_argument_first

fn main() -> i32 {
    let _0: i32
    let _1: List@(i32)                     // xs
    let _2: ~
    let _3: Maybe@(i32)
    let _4: i32
    let _5: i32
    let _6: i32
    let _7: i32
    let _8: ~
    let _9: i64
    let _10: i32
    let _11: i32
    let _12: bool                          // found
    let _13: i64
    let _14: i64
    let _15: Maybe@(i32)
    let _16: i32
    let _17: i32
    let _18: i32
    let _19: i32
    let _20: string
    let _21: ~

  bb0:
    StorageLive(_1)
    _1 = call builtin List.new()
    StorageLive(_2)
    _2 = call builtin list.push(copy _1 @inout, const 3_i32 @owned)
    StorageDead(_2)
    StorageLive(_3)
    _3 = call builtin list.pop(copy _1 @inout)
    StorageLive(_4)
    _5 = discriminant(_3)
    switchInt(copy _5) -> [0: bb1, otherwise: bb2]

  bb1:
    _4 = copy ((_3 as Some).0)
    goto -> bb3

  bb2:
    _4 = const 0_i32
    goto -> bb3

  bb3:
    StorageLive(_6)
    _6 = copy _4
    StorageLive(_7)
    _7 = user copy _6 * const 10_i32
    StorageLive(_8)
    _8 = call builtin list.push(copy _1 @inout, move _7 @owned)
    StorageDead(_8)
    StorageDead(_7)
    StorageDead(_6)
    StorageDead(_4)
    StorageDead(_3)
    StorageLive(_9)
    _9 = call builtin list.len(copy _1 @guaranteed)
    StorageLive(_10)
    _10 = move _9 as i32
    StorageLive(_11)
    _11 = user copy _10 + const 1_i32
    StorageLive(_12)
    _12 = call builtin list.contains(copy _1 @guaranteed, copy _11 @guaranteed)
    StorageDead(_11)
    StorageDead(_10)
    StorageDead(_9)
    StorageLive(_13)
    _13 = call builtin list.len(copy _1 @guaranteed)
    StorageLive(_14)
    _14 = user copy _13 + const 1_i64
    StorageLive(_15)
    _15 = call builtin list.last(copy _1 @guaranteed)
    StorageLive(_16)
    _16 = const -1_i32
    StorageLive(_17)
    _18 = discriminant(_15)
    switchInt(copy _18) -> [0: bb4, otherwise: bb5]

  bb4:
    _17 = copy ((_15 as Some).0)
    goto -> bb6

  bb5:
    _17 = copy _16
    goto -> bb6

  bb6:
    StorageLive(_19)
    _19 = copy _17
    StorageLive(_20)
    _20 = call builtin interp@(i64, string, i32, string, bool)(copy _14 @guaranteed, const " " @guaranteed, copy _19 @guaranteed, const " " @guaranteed, copy _12 @guaranteed)
    StorageLive(_21)
    _21 = call builtin println@(string)(copy _20 @guaranteed)
    StorageDead(_21)
    Drop(_20)
    StorageDead(_20)
    StorageDead(_19)
    StorageDead(_17)
    StorageDead(_16)
    StorageDead(_15)
    StorageDead(_14)
    StorageDead(_13)
    _0 = const 0_i32
    StorageDead(_12)
    Drop(_1)
    StorageDead(_1)
    return
}
