unit test_slir_own_methods

fn main() -> i32 {
    let _0: i32
    let _1: string
    let _2: Own@(string)                   // o
    let _3: string view                    // got
    let _4: Own@(string)                   // copy
    let _5: string view
    let _6: i32
    let _7: string
    let _8: ~
    let _9: ~
    let _10: string
    let _11: Own@(string)
    let _12: string view
    let _13: ~
    let _14: string
    let _15: Counter
    let _16: Own@(Counter)
    let _17: Holder                        // h
    let _18: i32
    let _19: Counter                       // c
    let _20: string
    let _21: ~
    let _22: i32
    let _23: Counter view                  // c
    let _24: string
    let _25: ~
    let _26: ~

  bb0:
    StorageLive(_1)
    _1 = clone(const "one")
    StorageLive(_2)
    _2 = call builtin Own.alloc@(string)(move _1 @owned)
    StorageDead(_1)
    StorageLive(_3)
    BeginBorrow(b0, _2, peek, for _3)
    _3 = call builtin own.get(copy _2 @guaranteed)
    StorageLive(_4)
    _4 = clone(copy _2)
    StorageLive(_5)
    BeginBorrow(b1, _4, peek, for _5)
    _5 = call builtin own.get(copy _4 @guaranteed)
    StorageLive(_6)
    _6 = call builtin string.len(copy _5 @guaranteed)
    StorageLive(_7)
    _7 = call builtin interp@(string, string, i32)(copy _3 @guaranteed, const " " @guaranteed, copy _6 @guaranteed)
    StorageLive(_8)
    _8 = call builtin println@(string)(copy _7 @guaranteed)
    EndBorrow(b0)
    EndBorrow(b1)
    StorageDead(_8)
    Drop(_7)
    StorageDead(_7)
    StorageDead(_6)
    StorageDead(_5)
    StorageLive(_9)
    _9 = call builtin own.destroy(copy _2 @inout)
    StorageDead(_9)
    StorageLive(_10)
    _10 = clone(const "two")
    StorageLive(_11)
    _11 = call builtin Own.alloc@(string)(move _10 @owned)
    Drop(_2)
    _2 = move _11
    StorageDead(_11)
    StorageDead(_10)
    StorageLive(_12)
    BeginBorrow(b2, _2, peek, for _12)
    _12 = call builtin own.get(copy _2 @guaranteed)
    StorageLive(_13)
    _13 = call builtin println@(string)(copy _12 @guaranteed)
    EndBorrow(b2)
    StorageDead(_13)
    StorageDead(_12)
    StorageLive(_14)
    _14 = clone(const "small")
    StorageLive(_15)
    _15 = Counter(const 1_i32, move _14)
    StorageLive(_16)
    _16 = call builtin Own.alloc@(Counter)(move _15 @owned)
    StorageLive(_17)
    _17 = Holder::Full(move _16)
    StorageDead(_16)
    StorageDead(_15)
    StorageDead(_14)
    _18 = discriminant(_17)
    switchInt(copy _18) -> [0: bb1, 1: bb2, otherwise: unreachable]

  bb1:
    StorageLive(_19)
    BeginBorrow(b3, _17, poke)
    _19 = ref poke (*(((_17 as Full).0).0))
    (_19.0) = user copy (_19.0) + const 41_i32
    StorageLive(_20)
    _20 = clone(const "big")
    Drop((_19.1))
    (_19.1) = move _20
    EndBorrow(b3)
    StorageDead(_20)
    StorageDead(_19)
    goto -> bb3

  bb2:
    StorageLive(_21)
    _21 = call builtin println@(string)(const "nil" @guaranteed)
    StorageDead(_21)
    goto -> bb3

  bb3:
    _22 = discriminant(_17)
    switchInt(copy _22) -> [0: bb4, 1: bb5, otherwise: unreachable]

  bb4:
    StorageLive(_23)
    BeginBorrow(b4, _17, peek, for _23)
    _23 = copy (*(((_17 as Full).0).0))
    StorageLive(_24)
    _24 = call builtin interp@(string, string, i32)(copy (_23.1) @guaranteed, const " " @guaranteed, copy (_23.0) @guaranteed)
    StorageLive(_25)
    _25 = call builtin println@(string)(copy _24 @guaranteed)
    EndBorrow(b4)
    StorageDead(_25)
    Drop(_24)
    StorageDead(_24)
    StorageDead(_23)
    goto -> bb6

  bb5:
    StorageLive(_26)
    _26 = call builtin println@(string)(const "nil" @guaranteed)
    StorageDead(_26)
    goto -> bb6

  bb6:
    _0 = const 0_i32
    Drop(_17)
    StorageDead(_17)
    Drop(_4)
    StorageDead(_4)
    StorageDead(_3)
    Drop(_2)
    StorageDead(_2)
    return
}
