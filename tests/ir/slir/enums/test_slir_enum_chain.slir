    StorageLive(_18)
    _18 = Maybe::Some(const 9_i32)
    StorageLive(_19)
    _19 = call @small(copy _18 @guaranteed)
    StorageLive(_20)
    _20 = call builtin println@(string)(copy _19 @guaranteed)
    StorageDead(_20)
    Drop(_19)
    StorageDead(_19)
    StorageDead(_18)
    StorageLive(_21)
    _21 = Maybe::None
