unit test_slir_enum_chain

fn depth(_1: Outer @guaranteed) -> i32 {
    let _0: i32
    let _2: i32
    let _3: i32
    let _4: i32                            // v
    let _5: i32
    let _6: i32
    let _7: i32

  bb0:
    _2 = discriminant(_1)
    switchInt(copy _2) -> [0: bb1, otherwise: bb3]

  bb1:
    _3 = discriminant(((_1 as Success).0))
    switchInt(copy _3) -> [0: bb2, otherwise: bb3]

  bb2:
    StorageLive(_4)
    _4 = copy ((((_1 as Success).0) as Ok).0)
    _0 = copy _4
    StorageDead(_4)
    return

  bb3:
    _5 = discriminant(_1)
    switchInt(copy _5) -> [0: bb4, otherwise: bb6]

  bb4:
    _6 = discriminant(((_1 as Success).0))
    switchInt(copy _6) -> [1: bb5, otherwise: bb6]

  bb5:
    _0 = const -1_i32
    return

  bb6:
    _7 = discriminant(_1)
    switchInt(copy _7) -> [1: bb7, otherwise: bb8]

  bb7:
    _0 = const -2_i32
    return

  bb8:
    trap RE2023(const "Outer.Failure")
}

fn small(_1: Maybe@(i32) @guaranteed) -> string {
    let _0: string
    let _2: i32
    let _3: i32
    let _4: i32
    let _5: bool
    let _6: bool
    let _7: i32
    let _8: i32                            // n
    let _9: i32

  bb0:
    _2 = discriminant(_1)
    switchInt(copy _2) -> [0: bb1, otherwise: bb2]

  bb1:
    switchInt(copy ((_1 as Some).0)) -> [1: bb4, otherwise: bb2]

  bb2:
    _3 = discriminant(_1)
    switchInt(copy _3) -> [0: bb3, otherwise: bb5]

  bb3:
    switchInt(copy ((_1 as Some).0)) -> [2: bb4, otherwise: bb5]

  bb4:
    _0 = const "one or two"
    return

  bb5:
    _4 = discriminant(_1)
    switchInt(copy _4) -> [0: bb6, otherwise: bb9]

  bb6:
    _5 = copy ((_1 as Some).0) >= const 5_i32
    switchInt(copy _5) -> [0: bb9, otherwise: bb7]

  bb7:
    _6 = copy ((_1 as Some).0) <= const 7_i32
    switchInt(copy _6) -> [0: bb9, otherwise: bb8]

  bb8:
    _0 = const "five to seven"
    return

  bb9:
    _7 = discriminant(_1)
    switchInt(copy _7) -> [0: bb10, otherwise: bb11]

  bb10:
    StorageLive(_8)
    _8 = copy ((_1 as Some).0)
    _0 = call builtin interp@(string, i32)(const "other " @guaranteed, copy _8 @guaranteed)
    StorageDead(_8)
    return

  bb11:
    _9 = discriminant(_1)
    switchInt(copy _9) -> [1: bb12, otherwise: bb13]

  bb12:
    _0 = const "none"
    return

  bb13:
    trap RE2023(const "Maybe.None")
}

fn word(_1: Maybe@(string) @guaranteed) -> i32 {
    let _0: i32
    let _2: i32
    let _3: bool
    let _4: i32
    let _5: i32

  bb0:
    _2 = discriminant(_1)
    switchInt(copy _2) -> [0: bb1, otherwise: bb3]

  bb1:
    _3 = call builtin eq@(string, string)(copy ((_1 as Some).0) @guaranteed, const "go" @guaranteed)
    switchInt(copy _3) -> [0: bb3, otherwise: bb2]

  bb2:
    _0 = const 1_i32
    return

  bb3:
    _4 = discriminant(_1)
    switchInt(copy _4) -> [0: bb4, otherwise: bb5]

  bb4:
    _0 = const 2_i32
    return

  bb5:
    _5 = discriminant(_1)
    switchInt(copy _5) -> [1: bb6, otherwise: bb7]

  bb6:
    _0 = const 0_i32
    return

  bb7:
    trap RE2023(const "Maybe.None")
}

fn first(_1: Pair @guaranteed) -> i32 {
    let _0: i32
    let _2: i32
    let _3: i32
    let _4: i32                            // n

  bb0:
    _2 = discriminant(_1)
    switchInt(copy _2) -> [0: bb1, otherwise: bb2]

  bb1:
    switchInt(copy ((_1 as Left).0)) -> [0: bb4, otherwise: bb2]

  bb2:
    _3 = discriminant(_1)
    switchInt(copy _3) -> [1: bb3, otherwise: bb7]

  bb3:
    switchInt(copy ((_1 as Right).1)) -> [0: bb5, otherwise: bb7]

  bb4:
    StorageLive(_4)
    _4 = copy ((_1 as Left).1)
    goto -> bb6

  bb5:
    StorageLive(_4)
    _4 = copy ((_1 as Right).0)
    goto -> bb6

  bb6:
    _0 = copy _4
    StorageDead(_4)
    return

  bb7:
    _0 = const -1_i32
    return
}

