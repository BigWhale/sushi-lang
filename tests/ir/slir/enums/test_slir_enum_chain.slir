    StorageDead(_23)
    Drop(_22)
    StorageDead(_22)
    StorageDead(_21)
    StorageLive(_24)
    _24 = Maybe::Some(const "go")
    StorageLive(_25)
    _25 = call @word(copy _24 @guaranteed)
    StorageLive(_26)
    _26 = call builtin println@(i32)(copy _25 @guaranteed)
    StorageDead(_26)
    StorageDead(_25)
    Drop(_24)
    StorageDead(_24)
    StorageLive(_27)
    _27 = Maybe::Some(const "stop")
    StorageLive(_28)
    _28 = call @word(copy _27 @guaranteed)
    StorageLive(_29)
    _29 = call builtin println@(i32)(copy _28 @guaranteed)
    StorageDead(_29)
    StorageDead(_28)
