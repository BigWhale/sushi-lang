unit test_slir_enum_constant

fn size(_1: Shape @guaranteed) -> i32 {
    let _0: i32
    let _2: i32
    let _3: i32                            // r
    let _4: i32                            // w

  bb0:
    _2 = discriminant(_1)
    switchInt(copy _2) -> [0: bb1, 1: bb2, otherwise: unreachable]

  bb1:
    StorageLive(_3)
    _3 = copy ((_1 as Circle).0)
    _0 = copy _3
    StorageDead(_3)
    return

  bb2:
    StorageLive(_4)
    _4 = copy ((_1 as Square).0)
    _0 = copy _4
    StorageDead(_4)
    return
}

fn main() -> i32 {
    let _0: i32
    let _1: Sign
    let _2: i32
    let _3: ~
    let _4: ~
    let _5: i32
    let _6: ~
    let _7: Maybe@(Shape)
    let _8: i32
    let _9: i32
    let _10: i32                           // w
    let _11: string
    let _12: ~
    let _13: ~
    let _14: bool
    let _15: ~

  bb0:
    StorageLive(_1)
    _1 = const Sign::Plus
    _2 = discriminant(_1)
    switchInt(copy _2) -> [0: bb1, 1: bb2, otherwise: unreachable]

  bb1:
    StorageLive(_3)
    _3 = call builtin println@(string)(const "plus" @guaranteed)
    StorageDead(_3)
    goto -> bb3

  bb2:
    StorageLive(_4)
    _4 = call builtin println@(string)(const "minus" @guaranteed)
    StorageDead(_4)
    goto -> bb3

  bb3:
    StorageDead(_1)
    StorageLive(_5)
    _5 = call @size(const Shape::Circle(5_i32) @guaranteed)
    StorageLive(_6)
    _6 = call builtin println@(i32)(copy _5 @guaranteed)
    StorageDead(_6)
    StorageDead(_5)
    StorageLive(_7)
    _7 = const Maybe::Some(Shape::Square(3_i32))
    _8 = discriminant(_7)
    switchInt(copy _8) -> [0: bb4, otherwise: bb6]

  bb4:
    _9 = discriminant(((_7 as Some).0))
    switchInt(copy _9) -> [1: bb5, otherwise: bb6]

  bb5:
    StorageLive(_10)
    _10 = copy ((((_7 as Some).0) as Square).0)
    StorageLive(_11)
    _11 = call builtin interp@(string, i32)(const "square " @guaranteed, copy _10 @guaranteed)
    StorageLive(_12)
    _12 = call builtin println@(string)(copy _11 @guaranteed)
    StorageDead(_12)
    Drop(_11)
    StorageDead(_11)
    StorageDead(_10)
    goto -> bb7

  bb6:
    StorageLive(_13)
    _13 = call builtin println@(string)(const "other" @guaranteed)
    StorageDead(_13)
    goto -> bb7

  bb7:
    StorageDead(_7)
    StorageLive(_14)
    _14 = call builtin maybe.is_none(const Maybe::None @guaranteed)
    StorageLive(_15)
    _15 = call builtin println@(bool)(copy _14 @guaranteed)
    StorageDead(_15)
    StorageDead(_14)
    _0 = const 0_i32
    return
}
