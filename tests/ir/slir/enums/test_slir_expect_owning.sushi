# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "towel\nkept towel\ncrew\n"
# EXPECT_NO_LEAKS
# EXPECT_DUMP_SLIR: test_slir_expect_owning.slir
#
# `expect` on a receiver that keeps its value reads an owning payload with a `Clone`, and
# the receiver keeps it (ir.md 8.9). On a temporary receiver with an `adopt` row, the
# payload moves out of the temporary.

fn named(bool ok) Maybe@(string):
    if (ok):
        return Maybe.Some("crew")
    return Maybe.None

fn main() i32:
    let Maybe@(string) m = Maybe.Some("towel")
    let string got = m.expect("no towel")
    println(got)
    let string again = m.expect("no towel")
    println("kept {again}")
    println(named(true).expect("no crew"))
    return 0
