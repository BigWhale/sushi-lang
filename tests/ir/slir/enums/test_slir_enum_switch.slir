unit test_slir_enum_switch

fn area(_1: Shape @guaranteed) -> i32 {
    let _0: i32
    let _2: i32
    let _3: i32                            // r
    let _4: i32
    let _5: i32                            // w
    let _6: i32                            // h

  bb0:
    _2 = discriminant(_1)
    switchInt(copy _2) -> [0: bb1, 1: bb2, 2: bb3, otherwise: unreachable]

  bb1:
    StorageLive(_3)
    _3 = copy ((_1 as Circle).0)
    StorageLive(_4)
    _4 = user const 3_i32 * copy _3
    _0 = user copy _4 * copy _3
    StorageDead(_4)
    StorageDead(_3)
    return

  bb2:
    StorageLive(_5)
    _5 = copy ((_1 as Rect).0)
    StorageLive(_6)
    _6 = copy ((_1 as Rect).1)
    _0 = user copy _5 * copy _6
    StorageDead(_6)
    StorageDead(_5)
    return

  bb3:
    _0 = const 0_i32
    return
}

fn stops(_1: Light @guaranteed) -> bool {
    let _0: bool
    let _2: i32

  bb0:
    _2 = discriminant(_1)
    switchInt(copy _2) -> [0: bb1, 1: bb1, otherwise: bb2]

  bb1:
    _0 = const true
    return

  bb2:
    _0 = const false
    return
}

fn side(_1: Shape @guaranteed) -> i32 {
    let _0: i32
    let _2: i32                            // out
    let _3: i32
    let _4: i32                            // n

  bb0:
    StorageLive(_2)
    _2 = const 0_i32
    _3 = discriminant(_1)
    switchInt(copy _3) -> [0: bb1, 1: bb2, 2: bb4, otherwise: unreachable]

  bb1:
    StorageLive(_4)
    _4 = copy ((_1 as Circle).0)
    goto -> bb3

  bb2:
    StorageLive(_4)
    _4 = copy ((_1 as Rect).0)
    goto -> bb3

  bb3:
    _2 = copy _4
    StorageDead(_4)
    goto -> bb5

  bb4:
    _2 = const -1_i32
    goto -> bb5

  bb5:
    _0 = copy _2
    StorageDead(_2)
    return
}

fn note(_1: i32 @guaranteed) -> Note {
    let _0: Note
    let _2: bool
    let _3: string

  bb0:
    StorageLive(_2)
    _2 = user copy _1 > const 0_i32
    switchInt(copy _2) -> [0: bb2, otherwise: bb1]

  bb1:
    StorageDead(_2)
    StorageLive(_3)
    _3 = call builtin interp@(string, i32)(const "n" @guaranteed, copy _1 @guaranteed)
    _0 = Note::Text(move _3)
    StorageDead(_3)
    return

  bb2:
    StorageDead(_2)
    goto -> bb3

  bb3:
    _0 = Note::Empty
    return
}

fn make(_1: i32 @guaranteed) -> Shape {
    let _0: Shape
    let _2: bool

  bb0:
    StorageLive(_2)
    _2 = user copy _1 > const 0_i32
    switchInt(copy _2) -> [0: bb2, otherwise: bb1]

  bb1:
    StorageDead(_2)
    _0 = Shape::Circle(copy _1)
    return

  bb2:
    StorageDead(_2)
    goto -> bb3

  bb3:
    _0 = Shape::Dot
    return
}

