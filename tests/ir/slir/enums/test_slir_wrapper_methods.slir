    _3 = copy _2 == const 1_i32
    StorageDead(_2)
    switchInt(copy _3) -> [0: bb2, otherwise: bb1]

  bb1:
    StorageDead(_3)
    StorageLive(_4)
    _4 = Odd::Value(copy _1)
    _0 = Result::Err(move _4)
    StorageDead(_4)
    return

  bb2:
    StorageDead(_3)
    goto -> bb3

  bb3:
    StorageLive(_5)
    _5 = copy _1 / const 2_i32
    _0 = Result::Ok(move _5)
    StorageDead(_5)
    return
}

