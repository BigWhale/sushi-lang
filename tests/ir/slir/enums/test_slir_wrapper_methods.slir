fn reason(_1: Maybe@(TokenError) @guaranteed) -> string {
    let _0: string
    let _2: i32
    let _3: i32
    let _4: i32

  bb0:
    _2 = discriminant(_1)
    switchInt(copy _2) -> [0: bb1, otherwise: bb3]

  bb1:
    _3 = discriminant(((_1 as Some).0))
    switchInt(copy _3) -> [0: bb2, otherwise: bb3]

  bb2:
    _0 = const "bad"
    return

  bb3:
    _4 = discriminant(_1)
    switchInt(copy _4) -> [1: bb4, otherwise: bb5]

  bb4:
    _0 = const "none"
    return

  bb5:
    trap RE2023(const "Maybe.None")
}

