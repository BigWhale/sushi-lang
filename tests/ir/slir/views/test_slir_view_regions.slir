    let _2: i32
    let _3: string view                    // s
    let _4: i32

  bb0:
    _2 = discriminant(_1)
    switchInt(copy _2) -> [0: bb1, 1: bb2, otherwise: unreachable]

  bb1:
    StorageLive(_3)
    BeginBorrow(b0, _1, peek, for _3)
    _3 = copy ((_1 as Ok).0)
    StorageLive(_4)
    _4 = call builtin string.len(copy _3 @guaranteed)
    _0 = Result::Ok(move _4)
    EndBorrow(b0)
    StorageDead(_4)
    StorageDead(_3)
    return

  bb2:
    _0 = Result::Err(copy ((_1 as Err).0))
    return
}

fn make() -> Result@(string, StdError) {
