# EXPECT_DUMP_SLIR: test_slir_extern_var_arg.slir
# EXPECT_STDOUT_EXACT: "5: 12 ok\n"
# EXPECT_NO_LEAKS
# EXPECT_RUNTIME_EXIT: 0
#
# A function of an `unsafe external` block is a `Direct` callee with its link name. A
# `poke u8[]` argument is `@inout`, every other declared argument and each value of the
# variadic tail is `@guaranteed`.
unsafe external "C" as c because "formatted text through snprintf":
    fn snprintf(poke u8[] buf, i64 n, string fmt, ...) i32 = "snprintf"

fn main() i32:
    let u8[] buf = from([0; 16])
    let i32 got = c.snprintf(poke buf, 16, "%d %s", 12, "ok")
    buf.truncate(got)
    println("{got}: {string.from_bytes(nom buf)}")
    return 0
