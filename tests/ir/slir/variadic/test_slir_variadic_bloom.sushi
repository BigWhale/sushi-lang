# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "3\n"
# EXPECT_NO_LEAKS: true
# EXPECT_DUMP_SLIR: test_slir_variadic_bloom.slir
#
# A bloom `xs...` lends its source: the place of the source is the `Guaranteed` argument
# of the call, with no temporary, and the caller drops the source at its scope exit (ir.md
# 7.4, 8.9).

fn count(...string xs) i32:
    return xs.len() as i32

fn main() i32:
    let string[] words = from(["a", "b", "{'c'}"])
    println(count(words...))
    return 0
