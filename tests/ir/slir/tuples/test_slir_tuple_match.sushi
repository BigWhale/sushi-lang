# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "zero a\none or two\nsmall digit\nz 40\nrest 121\n5\n6\n6\n2\n10\none then 2\nx 3 four\nz 3\nall 7 8\n206\n"
# EXPECT_NO_LEAKS
# EXPECT_DUMP_SLIR: test_slir_tuple_match.slir
#
# A match on a plain tuple is a chain of tests in source order over the `Field` paths of
# each tuple pattern (ir.md 8.9). Each part is tested by the rule of its own kind: a
# literal, a range, a variant, a nested tuple. A bare binder is a `Copy` of its `Field`
# path. An `Or` gives one path for each alternative. A tuple that is no place goes into a
# temporary of the statement first. The trap RE2023 follows the last arm that tests.

enum Dir:
    Up
    Down

fn kind((i32, u8) p) string:
    match p:
        (0, a'a') -> return "zero a"
        (1 | 2, _) -> return "one or two"
        (3..=9, a'0'..=a'9') -> return "small digit"
        (n, a'z') -> return "z {n}"
        (_, c) -> return "rest {c}"

fn pick((i32, i32) p) i32:
    match p:
        (x, 0) | (0, x) -> return x
        (x, y) -> return x * y

fn go((Dir, i32) d) i32:
    match d:
        (Dir.Up, n) -> return n + 1
        (Dir.Down, n) -> return n - 1

fn pair() (i32, i32):
    return (3, 4)

fn main() i32:
    println(kind((0, a'a')))
    println(kind((2, a'q')))
    println(kind((5, a'7')))
    println(kind((40, a'z')))
    println(kind((40, a'y')))
    println(pick((5, 0)))
    println(pick((0, 6)))
    println(pick((2, 3)))
    println(go((Dir.Up, 1)))
    println(go((Dir.Down, 11)))
    let i32 a = 1
    let i32 b = 2
    match (a, b):
        (1, x) -> println("one then {x}")
        _ -> println("other")
    match pair():
        (x, 4) -> println("x {x} four")
        (x, y) -> println("{x} {y}")
    match (b, (a, a + b)):
        (2, (1, 9)) -> println("nested literal")
        (_, (_, z)) -> println("z {z}")
    let (i32, i32) t = (7, 8)
    match t:
        (l, r) -> println("all {l} {r}")
    let i32 total = 0
    let i32 i = -1
    while (i < 6):
        i := i + 1
        match (i % 2, i):
            (0, 0) -> continue
            (0, n) -> total := total + n
            (_, 5) -> break
            (_, _) -> total := total + 100
    println(total)
    return 0
