# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "1\ntrue\n2\n3\n9\n10\n5\n"
# EXPECT_NO_LEAKS
# EXPECT_DUMP_SLIR: test_slir_tuple_construction.slir
#
# A tuple literal evaluates its parts in the written order, then builds ONE
# `Aggregate(Tuple)` of its instance type (ir.md 8.9). A local that a later part can change
# is copied into a temporary first. `.N` is a `Copy` of the `Field` projection N; a part of
# a part is a projection of the projection, and a tuple that is no place goes into a
# temporary of the statement first.

fn bump(poke i32 n) i32:
    n := n + 1
    return n

fn pair(i32 a) (i32, i32):
    return (a, a + 1)

fn second((i32, bool) t) bool:
    return t.1

fn main() i32:
    let (i32, bool) t = (1, true)
    println(t.0)
    println(second(t))
    let ((i32, i32), i32) nested = ((2, 3), 4)
    println(nested.0.0)
    println(nested.0.1)
    let i32 n = 9
    let (i32, i32) kept = (n, bump(poke n))
    println(kept.0)
    println(kept.1)
    println(pair(4).1)
    return 0
