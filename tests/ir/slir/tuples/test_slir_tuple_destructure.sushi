# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "1 2\n3 4 5\n6 8\n2 1\n9 1\n4 3 0\n7 8\n"
# EXPECT_NO_LEAKS
# EXPECT_DUMP_SLIR: test_slir_tuple_destructure.slir
#
# A destructure gives one `Field` place for each target, at its path (ir.md 8.9). A `let`
# form reads a place of the value where it is, and any other value goes into a temporary
# of the statement first; each binder is a new local of the block. A rebind form puts the
# value into a temporary first, then rebinds each place from left to right: a local, or a
# field as a field write. So `(a, b) := (b, a)` swaps. `_` writes nothing.

struct Point:
    i32 x
    i32 y

fn pair() (i32, i32):
    return (6, 7)

fn main() i32:
    let (a, b) = (1, 2)
    println("{a} {b}")
    let ((c, d), u8 e) = ((3, 4), 5)
    println("{c} {d} {e}")
    let (i32, i32) t = pair()
    let (f, _) = t
    let (_, g) = pair()
    println("{f} {g + 1}")
    (a, b) := (b, a)
    println("{a} {b}")
    let Point p = Point(0, 0)
    (p.x, p.y) := (9, b)
    println("{p.x} {p.y}")
    ((a, b), c) := ((4, 3), 0)
    println("{a} {b} {c}")
    (a, b) := (pair().1, 8)
    println("{a} {b}")
    return 0
