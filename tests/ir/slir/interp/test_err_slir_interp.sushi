# EXPECT_ERROR_CODES_EXACT: CE0155
# EXPECT_STDERR_CONTAINS: "emit, Str"
# EXPECT_DUMP_SLIR: test_err_slir_interp.slir
#
# An interpolation is one call of the intrinsic `interp`, with one operand for each part
# and the display type of each operand. The hole `who()` and the interpolation are
# temporaries that nothing moves, so each one drops at the end of its statement, the
# newest first.

fn who() string:
    return "Arthur"

fn main() i32:
    let i32 n = 42
    println("{who()} is {n}")
    return 0
