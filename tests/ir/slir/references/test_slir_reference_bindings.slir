unit test_slir_reference_bindings

fn main() -> i32 {
    let _0: i32
    let _1: string
    let _2: Holder                         // h
    let _3: i32                            // r
    let _4: i32[]                          // xs
    let _5: i32
    let _6: u32
    let _7: bool
    let _8: i32                            // e
    let _9: string
    let _10: ~
    let _11: ~
    let _12: string
    let _13: Holder
    let _14: Own@(Holder)                  // o
    let _15: Holder                        // p
    let _16: i32[]
    let _17: Shape                         // s
    let _18: i32
    let _19: i32                           // n
    let _20: i32[]                         // sides
    let _21: i32
    let _22: i32
    let _23: i32
    let _24: ~
    let _25: i32
    let _26: i32                           // n
    let _27: Holder view
    let _28: i32
    let _29: i32
    let _30: Holder view
    let _31: string
    let _32: ~
    let _33: ~
    let _34: i32
    let _35: i32                           // c
    let _36: ~

  bb0:
    StorageLive(_1)
    _1 = call builtin string.concat(const "Mostly" @guaranteed, const "" @guaranteed)
    StorageLive(_2)
    _2 = Holder(const 1_i32, move _1)
    StorageDead(_1)
    StorageLive(_3)
    BeginBorrow(b0, _2, poke)
    _3 = ref poke (_2.0)
    _3 = const 5_i32
    EndBorrow(b0)
    StorageLive(_4)
    _4 = [const 1_i32, const 2_i32]
    StorageLive(_5)
    _5 = len(_4)
    _6 = copy _5 as u32
    _7 = const 1_u32 < copy _6
    switchInt(copy _7) -> [0: bb1, otherwise: bb2]

  bb1:
    trap RE2020(const 1_i32, copy _5)

  bb2:
    StorageLive(_8)
    BeginBorrow(b1, _4, peek)
    _8 = ref peek (_4[const 1_i32])
    StorageDead(_5)
    StorageLive(_9)
    _9 = call builtin interp@(i32, string, i32)(copy (_2.0) @guaranteed, const " " @guaranteed, copy _8 @guaranteed)
    StorageLive(_10)
    _10 = call builtin println@(string)(copy _9 @guaranteed)
    EndBorrow(b1)
    StorageDead(_10)
    Drop(_9)
    StorageDead(_9)
    StorageLive(_11)
    _11 = call builtin array.push(copy _4 @inout, const 3_i32 @owned)
    StorageDead(_11)
    StorageLive(_12)
    _12 = call builtin string.concat(const "Mostly" @guaranteed, const "" @guaranteed)
    StorageLive(_13)
    _13 = Holder(const 2_i32, move _12)
    StorageLive(_14)
    _14 = call builtin Own.alloc@(Holder)(move _13 @owned)
    StorageDead(_13)
    StorageDead(_12)
    StorageLive(_15)
    BeginBorrow(b2, _14, poke)
    _15 = ref poke (*(_14.0))
    (_15.0) = const 9_i32
    EndBorrow(b2)
    StorageLive(_16)
    _16 = [const 4_i32]
    StorageLive(_17)
    _17 = Shape::Named(const 1_i32, move _16)
    StorageDead(_16)
    _18 = discriminant(_17)
    switchInt(copy _18) -> [0: bb3, 1: bb4, otherwise: unreachable]

  bb3:
    StorageLive(_19)
    BeginBorrow(b3, _17, poke)
    _19 = ref poke ((_17 as Named).0)
    StorageLive(_20)
    BeginBorrow(b4, _17, peek)
    _20 = ref peek ((_17 as Named).1)
    StorageLive(_21)
    _21 = copy _19
    StorageLive(_22)
    _22 = call builtin array.len(copy _20 @guaranteed)
    StorageLive(_23)
    _23 = user copy _21 + copy _22
    _19 = user copy _23 + const 1_i32
    EndBorrow(b4)
    EndBorrow(b3)
    StorageDead(_23)
    StorageDead(_22)
    StorageDead(_21)
    StorageDead(_20)
    StorageDead(_19)
    goto -> bb5

  bb4:
    StorageLive(_24)
    _24 = call builtin println@(string)(const "empty" @guaranteed)
    StorageDead(_24)
    goto -> bb5

  bb5:
    _25 = discriminant(_17)
    switchInt(copy _25) -> [0: bb6, 1: bb7, otherwise: unreachable]

  bb6:
    StorageLive(_26)
    _26 = copy ((_17 as Named).0)
    StorageLive(_27)
    BeginBorrow(b5, _14, peek, for _27)
    _27 = call builtin own.get(copy _14 @guaranteed)
    StorageLive(_28)
    _28 = copy (_27.0)
    StorageLive(_29)
    _29 = copy _26
    StorageLive(_30)
    BeginBorrow(b6, _14, peek, for _30)
    _30 = call builtin own.get(copy _14 @guaranteed)
    StorageLive(_31)
    _31 = call builtin interp@(i32, string, i32, string, string)(copy _28 @guaranteed, const " " @guaranteed, copy _29 @guaranteed, const " " @guaranteed, copy (_30.1) @guaranteed)
    StorageLive(_32)
    _32 = call builtin println@(string)(copy _31 @guaranteed)
    EndBorrow(b6)
    EndBorrow(b5)
    StorageDead(_32)
    Drop(_31)
    StorageDead(_31)
    StorageDead(_30)
    StorageDead(_29)
    StorageDead(_28)
    StorageDead(_27)
    StorageDead(_26)
    goto -> bb8

  bb7:
    StorageLive(_33)
    _33 = call builtin println@(string)(const "empty" @guaranteed)
    StorageDead(_33)
    goto -> bb8

  bb8:
    StorageLive(_34)
    _34 = const 7_i32
    StorageLive(_35)
    BeginBorrow(b7, _34, peek)
    _35 = ref peek _34
    StorageLive(_36)
    _36 = call builtin println@(i32)(copy _35 @guaranteed)
    EndBorrow(b7)
    StorageDead(_36)
    _0 = const 0_i32
    StorageDead(_35)
    StorageDead(_34)
    Drop(_17)
    StorageDead(_17)
    StorageDead(_15)
    Drop(_14)
    StorageDead(_14)
    StorageDead(_8)
    Drop(_4)
    StorageDead(_4)
    StorageDead(_3)
    Drop(_2)
    StorageDead(_2)
    return
}
