unit test_slir_reference_bindings

fn main() -> i32 {
    let _0: i32
    let _1: string
    let _2: Holder                         // h
    let _3: i32                            // r
    let _4: i32[]                          // xs
    let _5: i32
    let _6: i64
    let _7: u64
    let _8: bool
    let _9: i32                            // e
    let _10: string
    let _11: ~
    let _12: ~
    let _13: string
    let _14: Holder
    let _15: Own@(Holder)                  // o
    let _16: Holder                        // p
    let _17: i32[]
    let _18: Shape                         // s
    let _19: i32
    let _20: i32                           // n
    let _21: i32[]                         // sides
    let _22: i32
    let _23: i32
    let _24: i32
    let _25: ~
    let _26: i32
    let _27: i32                           // n
    let _28: Holder view
    let _29: i32
    let _30: i32
    let _31: Holder view
    let _32: string
    let _33: ~
    let _34: ~
    let _35: i32
    let _36: i32                           // c
    let _37: ~

  bb0:
    StorageLive(_1)
    _1 = call builtin string.concat(const "Mostly" @guaranteed, const "" @guaranteed)
    StorageLive(_2)
    _2 = Holder(const 1_i32, move _1)
    StorageDead(_1)
    StorageLive(_3)
    BeginBorrow(b0, _2, poke)
    _3 = ref poke (_2.0)
    _3 = const 5_i32
    EndBorrow(b0)
    StorageLive(_4)
    _4 = [const 1_i32, const 2_i32]
    StorageLive(_5)
    _5 = len(_4)
    StorageLive(_6)
    _6 = copy _5 as i64
    _7 = copy _6 as u64
    _8 = const 1_u64 < copy _7
    switchInt(copy _8) -> [0: bb1, otherwise: bb2]

  bb1:
    trap RE2020(const 1_i64, copy _6)

  bb2:
    StorageLive(_9)
    BeginBorrow(b1, _4, peek)
    _9 = ref peek (_4[const 1_i64])
    StorageDead(_6)
    StorageDead(_5)
    StorageLive(_10)
    _10 = call builtin interp@(i32, string, i32)(copy (_2.0) @guaranteed, const " " @guaranteed, copy _9 @guaranteed)
    StorageLive(_11)
    _11 = call builtin println@(string)(copy _10 @guaranteed)
    EndBorrow(b1)
    StorageDead(_11)
    Drop(_10)
    StorageDead(_10)
    StorageLive(_12)
    _12 = call builtin array.push(copy _4 @inout, const 3_i32 @owned)
    StorageDead(_12)
    StorageLive(_13)
    _13 = call builtin string.concat(const "Mostly" @guaranteed, const "" @guaranteed)
    StorageLive(_14)
    _14 = Holder(const 2_i32, move _13)
    StorageLive(_15)
    _15 = call builtin Own.alloc@(Holder)(move _14 @owned)
    StorageDead(_14)
    StorageDead(_13)
    StorageLive(_16)
    BeginBorrow(b2, _15, poke)
    _16 = ref poke (*(_15.0))
    (_16.0) = const 9_i32
    EndBorrow(b2)
    StorageLive(_17)
    _17 = [const 4_i32]
    StorageLive(_18)
    _18 = Shape::Named(const 1_i32, move _17)
    StorageDead(_17)
    _19 = discriminant(_18)
    switchInt(copy _19) -> [0: bb3, 1: bb4, otherwise: unreachable]

  bb3:
    StorageLive(_20)
    BeginBorrow(b3, _18, poke)
    _20 = ref poke ((_18 as Named).0)
    StorageLive(_21)
    BeginBorrow(b4, _18, peek)
    _21 = ref peek ((_18 as Named).1)
    StorageLive(_22)
    _22 = copy _20
    StorageLive(_23)
    _23 = call builtin array.len(copy _21 @guaranteed)
    StorageLive(_24)
    _24 = user copy _22 + copy _23
    _20 = user copy _24 + const 1_i32
    EndBorrow(b4)
    EndBorrow(b3)
    StorageDead(_24)
    StorageDead(_23)
    StorageDead(_22)
    StorageDead(_21)
    StorageDead(_20)
    goto -> bb5

  bb4:
    StorageLive(_25)
    _25 = call builtin println@(string)(const "empty" @guaranteed)
    StorageDead(_25)
    goto -> bb5

  bb5:
    _26 = discriminant(_18)
    switchInt(copy _26) -> [0: bb6, 1: bb7, otherwise: unreachable]

  bb6:
    StorageLive(_27)
    _27 = copy ((_18 as Named).0)
    StorageLive(_28)
    BeginBorrow(b5, _15, peek, for _28)
    _28 = call builtin own.get(copy _15 @guaranteed)
    StorageLive(_29)
    _29 = copy (_28.0)
    StorageLive(_30)
    _30 = copy _27
    StorageLive(_31)
    BeginBorrow(b6, _15, peek, for _31)
    _31 = call builtin own.get(copy _15 @guaranteed)
    StorageLive(_32)
    _32 = call builtin interp@(i32, string, i32, string, string)(copy _29 @guaranteed, const " " @guaranteed, copy _30 @guaranteed, const " " @guaranteed, copy (_31.1) @guaranteed)
    StorageLive(_33)
    _33 = call builtin println@(string)(copy _32 @guaranteed)
    EndBorrow(b6)
    EndBorrow(b5)
    StorageDead(_33)
    Drop(_32)
    StorageDead(_32)
    StorageDead(_31)
    StorageDead(_30)
    StorageDead(_29)
    StorageDead(_28)
    StorageDead(_27)
    goto -> bb8

  bb7:
    StorageLive(_34)
    _34 = call builtin println@(string)(const "empty" @guaranteed)
    StorageDead(_34)
    goto -> bb8

  bb8:
    StorageLive(_35)
    _35 = const 7_i32
    StorageLive(_36)
    BeginBorrow(b7, _35, peek)
    _36 = ref peek _35
    StorageLive(_37)
    _37 = call builtin println@(i32)(copy _36 @guaranteed)
    EndBorrow(b7)
    StorageDead(_37)
    _0 = const 0_i32
    StorageDead(_36)
    StorageDead(_35)
    Drop(_18)
    StorageDead(_18)
    StorageDead(_16)
    Drop(_15)
    StorageDead(_15)
    StorageDead(_9)
    Drop(_4)
    StorageDead(_4)
    StorageDead(_3)
    Drop(_2)
    StorageDead(_2)
    return
}
