unit test_slir_match_string

fn verb(_1: string @guaranteed) -> i32 {
    let _0: i32
    let _2: bool
    let _3: bool
    let _4: bool

  bb0:
    _2 = call builtin eq@(string, string)(copy _1 @guaranteed, const "get" @guaranteed)
    switchInt(copy _2) -> [0: bb1, otherwise: bb2]

  bb1:
    _3 = call builtin eq@(string, string)(copy _1 @guaranteed, const "fetch" @guaranteed)
    switchInt(copy _3) -> [0: bb3, otherwise: bb2]

  bb2:
    _0 = const 1_i32
    return

  bb3:
    _4 = call builtin eq@(string, string)(copy _1 @guaranteed, const "put" @guaranteed)
    switchInt(copy _4) -> [0: bb5, otherwise: bb4]

  bb4:
    _0 = const 2_i32
    return

  bb5:
    _0 = const 9_i32
    return
}

fn code_of(_1: i32 @guaranteed) -> i32 {
    let _0: i32
    let _2: i32                            // code
    let _3: string
    let _4: bool
    let _5: bool

  bb0:
    StorageLive(_2)
    _2 = const 0_i32
    StorageLive(_3)
    _3 = call builtin interp@(i32)(copy _1 @guaranteed)
    _4 = call builtin eq@(string, string)(copy _3 @guaranteed, const "1" @guaranteed)
    switchInt(copy _4) -> [0: bb2, otherwise: bb1]

  bb1:
    _0 = const 10_i32
    Drop(_3)
    StorageDead(_3)
    StorageDead(_2)
    return

  bb2:
    _5 = call builtin eq@(string, string)(copy _3 @guaranteed, const "2" @guaranteed)
    switchInt(copy _5) -> [0: bb4, otherwise: bb3]

  bb3:
    _2 = const 20_i32
    goto -> bb5

  bb4:
    _2 = const 30_i32
    goto -> bb5

  bb5:
    Drop(_3)
    StorageDead(_3)
    _0 = copy _2
    StorageDead(_2)
    return
}

fn main() -> i32 {
    let _0: i32
    let _1: i32
    let _2: ~
    let _3: i32
    let _4: ~
    let _5: i32
    let _6: ~
    let _7: i32
    let _8: ~
    let _9: i32
    let _10: ~
    let _11: i32
    let _12: ~
    let _13: i32
    let _14: ~
    let _15: string                        // base
    let _16: string                        // taken
    let _17: string
    let _18: bool
    let _19: ~
    let _20: ~

  bb0:
    StorageLive(_1)
    _1 = call @verb(const "get" @guaranteed)
    StorageLive(_2)
    _2 = call builtin println@(i32)(copy _1 @guaranteed)
    StorageDead(_2)
    StorageDead(_1)
    StorageLive(_3)
    _3 = call @verb(const "fetch" @guaranteed)
    StorageLive(_4)
    _4 = call builtin println@(i32)(copy _3 @guaranteed)
    StorageDead(_4)
    StorageDead(_3)
    StorageLive(_5)
    _5 = call @verb(const "put" @guaranteed)
    StorageLive(_6)
    _6 = call builtin println@(i32)(copy _5 @guaranteed)
    StorageDead(_6)
    StorageDead(_5)
    StorageLive(_7)
    _7 = call @verb(const "drop" @guaranteed)
    StorageLive(_8)
    _8 = call builtin println@(i32)(copy _7 @guaranteed)
    StorageDead(_8)
    StorageDead(_7)
    StorageLive(_9)
    _9 = call @code_of(const 1_i32 @guaranteed)
    StorageLive(_10)
    _10 = call builtin println@(i32)(copy _9 @guaranteed)
    StorageDead(_10)
    StorageDead(_9)
    StorageLive(_11)
    _11 = call @code_of(const 2_i32 @guaranteed)
    StorageLive(_12)
    _12 = call builtin println@(i32)(copy _11 @guaranteed)
    StorageDead(_12)
    StorageDead(_11)
    StorageLive(_13)
    _13 = call @code_of(const 3_i32 @guaranteed)
    StorageLive(_14)
    _14 = call builtin println@(i32)(copy _13 @guaranteed)
    StorageDead(_14)
    StorageDead(_13)
    StorageLive(_15)
    _15 = const "wri"
    StorageLive(_16)
    _16 = call builtin interp@(string, string)(copy _15 @guaranteed, const "te" @guaranteed)
    StorageLive(_17)
    _17 = move _16
    _18 = call builtin eq@(string, string)(copy _17 @guaranteed, const "write" @guaranteed)
    switchInt(copy _18) -> [0: bb2, otherwise: bb1]

  bb1:
    StorageLive(_19)
    _19 = call builtin println@(string)(const "nom write" @guaranteed)
    StorageDead(_19)
    goto -> bb3

  bb2:
    StorageLive(_20)
    _20 = call builtin println@(string)(const "nom other" @guaranteed)
    StorageDead(_20)
    goto -> bb3

  bb3:
    Drop(_17)
    StorageDead(_17)
    _0 = const 0_i32
    StorageDead(_16)
    Drop(_15)
    StorageDead(_15)
    return
}
