unit test_slir_match_ranges

fn class(_1: i32 @guaranteed) -> i32 {
    let _0: i32
    let _2: i32                            // code
    let _3: bool
    let _4: bool
    let _5: bool
    let _6: bool

  bb0:
    StorageLive(_2)
    _2 = const 0_i32
    switchInt(copy _1) -> [0: bb1, otherwise: bb2]

  bb1:
    _2 = const 1_i32
    goto -> bb10

  bb2:
    _3 = copy _1 >= const 1_i32
    switchInt(copy _3) -> [0: bb5, otherwise: bb3]

  bb3:
    _4 = copy _1 <= const 9_i32
    switchInt(copy _4) -> [0: bb5, otherwise: bb4]

  bb4:
    _2 = const 2_i32
    goto -> bb10

  bb5:
    _5 = copy _1 >= const -9_i32
    switchInt(copy _5) -> [0: bb7, otherwise: bb6]

  bb6:
    _6 = copy _1 <= const -1_i32
    switchInt(copy _6) -> [0: bb7, otherwise: bb8]

  bb7:
    switchInt(copy _1) -> [100: bb8, otherwise: bb9]

  bb8:
    _2 = const 3_i32
    goto -> bb10

  bb9:
    _2 = const 4_i32
    goto -> bb10

  bb10:
    _0 = copy _2
    StorageDead(_2)
    return
}

fn half(_1: u8 @guaranteed) -> i32 {
    let _0: i32
    let _2: bool
    let _3: bool
    let _4: bool
    let _5: bool

  bb0:
    _2 = copy _1 >= const 0_u8
    switchInt(copy _2) -> [0: bb3, otherwise: bb1]

  bb1:
    _3 = copy _1 <= const 127_u8
    switchInt(copy _3) -> [0: bb3, otherwise: bb2]

  bb2:
    _0 = const 0_i32
    return

  bb3:
    _4 = copy _1 >= const 128_u8
    switchInt(copy _4) -> [0: bb6, otherwise: bb4]

  bb4:
    _5 = copy _1 <= const 255_u8
    switchInt(copy _5) -> [0: bb6, otherwise: bb5]

  bb5:
    _0 = const 1_i32
    return

  bb6:
    trap RE2023(const "0x80..=0xff")
}

fn last_small(_1: i32 @guaranteed) -> i32 {
    let _0: i32
    let _2: i32                            // i
    let _3: i32                            // found
    let _4: bool
    let _5: bool
    let _6: bool

  bb0:
    StorageLive(_2)
    _2 = const 0_i32
    StorageLive(_3)
    _3 = neg const 1_i32
    goto -> bb1

  bb1:
    StorageLive(_4)
    _4 = copy _2 < copy _1
    switchInt(copy _4) -> [0: bb3, otherwise: bb2]

  bb2:
    StorageDead(_4)
    _2 = copy _2 + const 1_i32
    _5 = copy _2 >= const 0_i32
    switchInt(copy _5) -> [0: bb7, otherwise: bb5]

  bb3:
    StorageDead(_4)
    goto -> bb4

  bb4:
    _0 = copy _3
    StorageDead(_3)
    StorageDead(_2)
    return

  bb5:
    _6 = copy _2 <= const 2_i32
    switchInt(copy _6) -> [0: bb7, otherwise: bb6]

  bb6:
    goto -> bb1

  bb7:
    switchInt(copy _2) -> [7: bb8, otherwise: bb9]

  bb8:
    goto -> bb4

  bb9:
    _3 = copy _2
    goto -> bb10

  bb10:
    goto -> bb1
}

fn main() -> i32 {
    let _0: i32
    let _1: i32
    let _2: ~
    let _3: i32
    let _4: ~
    let _5: i32
    let _6: i32
    let _7: ~
    let _8: i32
    let _9: i32
    let _10: ~
    let _11: i32
    let _12: ~
    let _13: i32
    let _14: ~
    let _15: i32
    let _16: ~
    let _17: i32
    let _18: ~
    let _19: i32
    let _20: ~
    let _21: i32
    let _22: ~
    let _23: i32
    let _24: ~

  bb0:
    StorageLive(_1)
    _1 = call @class(const 0_i32 @guaranteed)
    StorageLive(_2)
    _2 = call builtin println@(i32)(copy _1 @guaranteed)
    StorageDead(_2)
    StorageDead(_1)
    StorageLive(_3)
    _3 = call @class(const 9_i32 @guaranteed)
    StorageLive(_4)
    _4 = call builtin println@(i32)(copy _3 @guaranteed)
    StorageDead(_4)
    StorageDead(_3)
    StorageLive(_5)
    _5 = neg const 9_i32
    StorageLive(_6)
    _6 = call @class(copy _5 @guaranteed)
    StorageLive(_7)
    _7 = call builtin println@(i32)(copy _6 @guaranteed)
    StorageDead(_7)
    StorageDead(_6)
    StorageDead(_5)
    StorageLive(_8)
    _8 = neg const 1_i32
    StorageLive(_9)
    _9 = call @class(copy _8 @guaranteed)
    StorageLive(_10)
    _10 = call builtin println@(i32)(copy _9 @guaranteed)
    StorageDead(_10)
    StorageDead(_9)
    StorageDead(_8)
    StorageLive(_11)
    _11 = call @class(const 100_i32 @guaranteed)
    StorageLive(_12)
    _12 = call builtin println@(i32)(copy _11 @guaranteed)
    StorageDead(_12)
    StorageDead(_11)
    StorageLive(_13)
    _13 = call @class(const 10_i32 @guaranteed)
    StorageLive(_14)
    _14 = call builtin println@(i32)(copy _13 @guaranteed)
    StorageDead(_14)
    StorageDead(_13)
    StorageLive(_15)
    _15 = call @half(const 0_u8 @guaranteed)
    StorageLive(_16)
    _16 = call builtin println@(i32)(copy _15 @guaranteed)
    StorageDead(_16)
    StorageDead(_15)
    StorageLive(_17)
    _17 = call @half(const 127_u8 @guaranteed)
    StorageLive(_18)
    _18 = call builtin println@(i32)(copy _17 @guaranteed)
    StorageDead(_18)
    StorageDead(_17)
    StorageLive(_19)
    _19 = call @half(const 128_u8 @guaranteed)
    StorageLive(_20)
    _20 = call builtin println@(i32)(copy _19 @guaranteed)
    StorageDead(_20)
    StorageDead(_19)
    StorageLive(_21)
    _21 = call @half(const 255_u8 @guaranteed)
    StorageLive(_22)
    _22 = call builtin println@(i32)(copy _21 @guaranteed)
    StorageDead(_22)
    StorageDead(_21)
    StorageLive(_23)
    _23 = call @last_small(const 10_i32 @guaranteed)
    StorageLive(_24)
    _24 = call builtin println@(i32)(copy _23 @guaranteed)
    StorageDead(_24)
    StorageDead(_23)
    _0 = const 0_i32
    return
}
