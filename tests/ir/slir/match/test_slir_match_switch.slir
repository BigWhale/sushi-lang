    let _0: i32
    let _1: i32
    let _2: ~
    let _3: i32
    let _4: ~
    let _5: i32
    let _6: ~
    let _7: i8
    let _8: i32
    let _9: ~
    let _10: i32
    let _11: ~
    let _12: i32
    let _13: ~
    let _14: i32
    let _15: ~
    let _16: i32
    let _17: ~
    let _18: ~
    let _19: ~
    let _20: ~

  bb0:
    StorageLive(_1)
    _1 = call @kind(const 0_i8 @guaranteed)
    StorageLive(_2)
    _2 = call builtin println@(i32)(copy _1 @guaranteed)
    StorageDead(_2)
    StorageDead(_1)
    StorageLive(_3)
    _3 = call @kind(const 1_i8 @guaranteed)
    StorageLive(_4)
    _4 = call builtin println@(i32)(copy _3 @guaranteed)
    StorageDead(_4)
    StorageDead(_3)
    StorageLive(_5)
    _5 = call @kind(const 3_i8 @guaranteed)
    StorageLive(_6)
    _6 = call builtin println@(i32)(copy _5 @guaranteed)
    StorageDead(_6)
    StorageDead(_5)
    StorageLive(_7)
