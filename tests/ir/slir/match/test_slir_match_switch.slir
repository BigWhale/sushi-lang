unit test_slir_match_switch

fn take(_1: string @owned) -> ~ {
    let _0: ~
    let _2: string
    let _3: ~

  bb0:
    StorageLive(_2)
    _2 = call builtin interp@(string, string)(const "moved " @guaranteed, copy _1 @guaranteed)
    StorageLive(_3)
    _3 = call builtin println@(string)(copy _2 @guaranteed)
    StorageDead(_3)
    Drop(_2)
    StorageDead(_2)
    _0 = const ~
    Drop(_1)
    return
}

fn kind(_1: i8 @guaranteed) -> i32 {
    let _0: i32
    let _2: i32                            // code

  bb0:
    StorageLive(_2)
    _2 = const 0_i32
    switchInt(copy _1) -> [0: bb1, 1: bb2, 2: bb2, 3: bb2, -1: bb3, otherwise: bb4]

  bb1:
    _2 = const 1_i32
    goto -> bb5

  bb2:
    _2 = const 2_i32
    goto -> bb5

  bb3:
    _2 = const 3_i32
    goto -> bb5

  bb4:
    _2 = const 9_i32
    goto -> bb5

  bb5:
    _0 = copy _2
    StorageDead(_2)
    return
}

fn letter(_1: u8 @guaranteed) -> i32 {
    let _0: i32

  bb0:
    switchInt(copy _1) -> [97: bb1, 98: bb2, 99: bb2, otherwise: bb3]

  bb1:
    _0 = const 1_i32
    return

  bb2:
    _0 = const 2_i32
    return

  bb3:
    _0 = const 0_i32
    return
}

fn pick(_1: i32 @guaranteed) -> ~ {
    let _0: ~
    let _2: string                         // word
    let _3: bool
    let _4: ~
    let _5: string                         // note
    let _6: ~

  bb0:
    StorageLive(_2)
    _2 = call builtin interp@(i32)(copy _1 @guaranteed)
    StorageLive(_3)
    _3 = const true
    switchInt(copy _1) -> [1: bb1, otherwise: bb2]

  bb1:
    StorageLive(_4)
    _4 = call @take(move _2 @owned)
    _3 = const false
    StorageDead(_4)
    goto -> bb3

  bb2:
    StorageLive(_5)
    _5 = const "kept"
    StorageLive(_6)
    _6 = call builtin println@(string)(copy _5 @guaranteed)
    StorageDead(_6)
    Drop(_5)
    StorageDead(_5)
    goto -> bb3

  bb3:
    _0 = const ~
    DropIfSet(_2, _3)
    StorageDead(_3)
    StorageDead(_2)
    return
}

