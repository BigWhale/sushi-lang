    StorageLive(_8)
    _8 = call @kind(copy _7 @guaranteed)
    StorageLive(_9)
    _9 = call builtin println@(i32)(copy _8 @guaranteed)
    StorageDead(_9)
    StorageDead(_8)
    StorageDead(_7)
    StorageLive(_10)
    _10 = call @kind(const 100_i8 @guaranteed)
    StorageLive(_11)
    _11 = call builtin println@(i32)(copy _10 @guaranteed)
    StorageDead(_11)
    StorageDead(_10)
    StorageLive(_12)
    _12 = call @letter(const 97_u8 @guaranteed)
    StorageLive(_13)
