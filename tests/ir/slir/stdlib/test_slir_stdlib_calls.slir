unit test_slir_stdlib_calls

fn main() -> i32 {
    let _0: i32
    let _1: f64                            // r
    let _2: u8                             // a
    let _3: u8                             // lo
    let _4: i32                            // hi
    let _5: Result@(i32, FileError)
    let _6: i32
    let _7: i32
    let _8: i32                            // removed
    let _9: bool                           // found
    let _10: string
    let _11: ~
    let _12: string
    let _13: ~

  bb0:
    StorageLive(_1)
    _1 = call @sqrt(const 16.0_f64 @guaranteed)
    StorageLive(_2)
    _2 = const 9_u8
    StorageLive(_3)
    _3 = call @u8.min(copy _2 @guaranteed, const 3_u8 @guaranteed)
    StorageLive(_4)
    _4 = call @i32.max(const 7_i32 @guaranteed, const 2_i32 @guaranteed)
    StorageLive(_5)
    _5 = call @<io/files>.remove(const "slir_stdlib_no_such_file" @guaranteed)
    StorageLive(_6)
    _7 = discriminant(_5)
    switchInt(copy _7) -> [0: bb1, otherwise: bb2]

  bb1:
    _6 = copy ((_5 as Ok).0)
    goto -> bb3

  bb2:
    _6 = const 9_i32
    goto -> bb3

  bb3:
    StorageLive(_8)
    _8 = copy _6
    StorageDead(_6)
    StorageDead(_5)
    StorageLive(_9)
    _9 = call @<io/files>.is_dir(const "slir_stdlib_no_such_file" @guaranteed)
    StorageLive(_10)
    _10 = call builtin interp@(f64, string, u8, string, i32)(copy _1 @guaranteed, const " " @guaranteed, copy _3 @guaranteed, const " " @guaranteed, copy _4 @guaranteed)
    StorageLive(_11)
    _11 = call builtin println@(string)(copy _10 @guaranteed)
    StorageDead(_11)
    Drop(_10)
    StorageDead(_10)
    StorageLive(_12)
    _12 = call builtin interp@(i32, string, bool)(copy _8 @guaranteed, const " " @guaranteed, copy _9 @guaranteed)
    StorageLive(_13)
    _13 = call builtin println@(string)(copy _12 @guaranteed)
    StorageDead(_13)
    Drop(_12)
    StorageDead(_12)
    _0 = const 0_i32
    StorageDead(_9)
    StorageDead(_8)
    StorageDead(_4)
    StorageDead(_3)
    StorageDead(_2)
    StorageDead(_1)
    return
}
