unit test_slir_stdlib_calls

fn main() -> i32 {
    let _0: i32
    let _1: f64                            // r
    let _2: u8                             // a
    let _3: u8                             // lo
    let _4: i32                            // hi
    let _5: Result@(i64, FileError)
    let _6: i64
    let _7: i64
    let _8: i32
    let _9: i64                            // stamp
    let _10: Result@(i64, FileError)
    let _11: bool                          // found
    let _12: string
    let _13: ~
    let _14: string
    let _15: ~

  bb0:
    StorageLive(_1)
    _1 = call @sqrt(const 16.0_f64 @guaranteed)
    StorageLive(_2)
    _2 = const 9_u8
    StorageLive(_3)
    _3 = call @u8.min(copy _2 @guaranteed, const 3_u8 @guaranteed)
    StorageLive(_4)
    _4 = call @i32.max(const 7_i32 @guaranteed, const 2_i32 @guaranteed)
    StorageLive(_5)
    _5 = call @<io/files>.fd_write_str(const -1_i32 @guaranteed, const "slir_stdlib" @guaranteed)
    StorageLive(_6)
    _6 = const 9_i64 as i64
    StorageLive(_7)
    _8 = discriminant(_5)
    switchInt(copy _8) -> [0: bb1, otherwise: bb2]

  bb1:
    _7 = copy ((_5 as Ok).0)
    goto -> bb3

  bb2:
    _7 = copy _6
    goto -> bb3

  bb3:
    StorageLive(_9)
    _9 = copy _7
    StorageDead(_7)
    StorageDead(_6)
    StorageDead(_5)
    StorageLive(_10)
    _10 = call @<io/files>.fd_write_str(const -1_i32 @guaranteed, const "slir_stdlib_found" @guaranteed)
    StorageLive(_11)
    _11 = call builtin result.is_ok(copy _10 @guaranteed)
    StorageDead(_10)
    StorageLive(_12)
    _12 = call builtin interp@(f64, string, u8, string, i32)(copy _1 @guaranteed, const " " @guaranteed, copy _3 @guaranteed, const " " @guaranteed, copy _4 @guaranteed)
    StorageLive(_13)
    _13 = call builtin println@(string)(copy _12 @guaranteed)
    StorageDead(_13)
    Drop(_12)
    StorageDead(_12)
    StorageLive(_14)
    _14 = call builtin interp@(i64, string, bool)(copy _9 @guaranteed, const " " @guaranteed, copy _11 @guaranteed)
    StorageLive(_15)
    _15 = call builtin println@(string)(copy _14 @guaranteed)
    StorageDead(_15)
    Drop(_14)
    StorageDead(_14)
    _0 = const 0_i32
    StorageDead(_11)
    StorageDead(_9)
    StorageDead(_4)
    StorageDead(_3)
    StorageDead(_2)
    StorageDead(_1)
    return
}
