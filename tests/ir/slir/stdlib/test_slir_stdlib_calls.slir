unit test_slir_stdlib_calls

fn main() -> i32 {
    let _0: i32
    let _1: f64                            // r
    let _2: u8                             // a
    let _3: u8                             // lo
    let _4: i32                            // hi
    let _5: i64
    let _6: Result@(i32, StdError)
    let _7: i32
    let _8: i32
    let _9: i32                            // slept
    let _10: i64
    let _11: Result@(i32, StdError)
    let _12: i32
    let _13: i32
    let _14: i32                           // failed
    let _15: string
    let _16: ~
    let _17: string
    let _18: ~

  bb0:
    StorageLive(_1)
    _1 = call @<math>.sqrt(const 16.0_f64 @guaranteed)
    StorageLive(_2)
    _2 = const 9_u8
    StorageLive(_3)
    _3 = call @<math>.min(copy _2 @guaranteed, const 3_u8 @guaranteed)
    StorageLive(_4)
    _4 = call @<math>.max(const 7_i32 @guaranteed, const 2_i32 @guaranteed)
    StorageLive(_5)
    _5 = const 0_i64 as i64
    StorageLive(_6)
    _6 = call @<time>.msleep(copy _5 @guaranteed)
    StorageLive(_7)
    _8 = discriminant(_6)
    switchInt(copy _8) -> [0: bb1, otherwise: bb2]

  bb1:
    _7 = copy ((_6 as Ok).0)
    goto -> bb3

  bb2:
    _7 = const 9_i32
    goto -> bb3

  bb3:
    StorageLive(_9)
    _9 = copy _7
    StorageDead(_7)
    StorageDead(_6)
    StorageDead(_5)
    StorageLive(_10)
    _10 = const -1_i64 as i64
    StorageLive(_11)
    _11 = call @<time>.msleep(copy _10 @guaranteed)
    StorageLive(_12)
    _13 = discriminant(_11)
    switchInt(copy _13) -> [0: bb4, otherwise: bb5]

  bb4:
    _12 = copy ((_11 as Ok).0)
    goto -> bb6

  bb5:
    _12 = const 9_i32
    goto -> bb6

  bb6:
    StorageLive(_14)
    _14 = copy _12
    StorageDead(_12)
    StorageDead(_11)
    StorageDead(_10)
    StorageLive(_15)
    _15 = call builtin interp@(f64, string, u8, string, i32)(copy _1 @guaranteed, const " " @guaranteed, copy _3 @guaranteed, const " " @guaranteed, copy _4 @guaranteed)
    StorageLive(_16)
    _16 = call builtin println@(string)(copy _15 @guaranteed)
    StorageDead(_16)
    Drop(_15)
    StorageDead(_15)
    StorageLive(_17)
    _17 = call builtin interp@(i32, string, i32)(copy _9 @guaranteed, const " " @guaranteed, copy _14 @guaranteed)
    StorageLive(_18)
    _18 = call builtin println@(string)(copy _17 @guaranteed)
    StorageDead(_18)
    Drop(_17)
    StorageDead(_17)
    _0 = const 0_i32
    StorageDead(_14)
    StorageDead(_9)
    StorageDead(_4)
    StorageDead(_3)
    StorageDead(_2)
    StorageDead(_1)
    return
}
