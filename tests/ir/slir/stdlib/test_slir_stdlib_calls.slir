unit test_slir_stdlib_calls

fn main() -> i32 {
    let _0: i32
    let _1: f64                            // r
    let _2: u8                             // a
    let _3: u8                             // lo
    let _4: i32                            // hi
    let _5: Result@(i32, EnvError)
    let _6: i32
    let _7: i32
    let _8: i32                            // set
    let _9: Result@(i32, EnvError)
    let _10: i32
    let _11: i32
    let _12: i32                           // failed
    let _13: string
    let _14: ~
    let _15: string
    let _16: ~

  bb0:
    StorageLive(_1)
    _1 = call @sqrt(const 16.0_f64 @guaranteed)
    StorageLive(_2)
    _2 = const 9_u8
    StorageLive(_3)
    _3 = call @u8.min(copy _2 @guaranteed, const 3_u8 @guaranteed)
    StorageLive(_4)
    _4 = call @i32.max(const 7_i32 @guaranteed, const 2_i32 @guaranteed)
    StorageLive(_5)
    _5 = call @<sys/env>.setenv(const "SUSHI_SLIR_STDLIB" @guaranteed, const "1" @guaranteed)
    StorageLive(_6)
    _7 = discriminant(_5)
    switchInt(copy _7) -> [0: bb1, otherwise: bb2]

  bb1:
    _6 = copy ((_5 as Ok).0)
    goto -> bb3

  bb2:
    _6 = const 9_i32
    goto -> bb3

  bb3:
    StorageLive(_8)
    _8 = copy _6
    StorageDead(_6)
    StorageDead(_5)
    StorageLive(_9)
    _9 = call @<sys/env>.setenv(const "" @guaranteed, const "1" @guaranteed)
    StorageLive(_10)
    _11 = discriminant(_9)
    switchInt(copy _11) -> [0: bb4, otherwise: bb5]

  bb4:
    _10 = copy ((_9 as Ok).0)
    goto -> bb6

  bb5:
    _10 = const 9_i32
    goto -> bb6

  bb6:
    StorageLive(_12)
    _12 = copy _10
    StorageDead(_10)
    StorageDead(_9)
    StorageLive(_13)
    _13 = call builtin interp@(f64, string, u8, string, i32)(copy _1 @guaranteed, const " " @guaranteed, copy _3 @guaranteed, const " " @guaranteed, copy _4 @guaranteed)
    StorageLive(_14)
    _14 = call builtin println@(string)(copy _13 @guaranteed)
    StorageDead(_14)
    Drop(_13)
    StorageDead(_13)
    StorageLive(_15)
    _15 = call builtin interp@(i32, string, i32)(copy _8 @guaranteed, const " " @guaranteed, copy _12 @guaranteed)
    StorageLive(_16)
    _16 = call builtin println@(string)(copy _15 @guaranteed)
    StorageDead(_16)
    Drop(_15)
    StorageDead(_15)
    _0 = const 0_i32
    StorageDead(_12)
    StorageDead(_8)
    StorageDead(_4)
    StorageDead(_3)
    StorageDead(_2)
    StorageDead(_1)
    return
}
