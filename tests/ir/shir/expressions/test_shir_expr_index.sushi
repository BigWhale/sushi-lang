# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "20\n6\n2\n3\n25\n9\nMostly Harmless\n"
# EXPECT_DUMP_SHIR: test_shir_expr_index.shir
#
# the SHIR dump of an index and of a slice. `xs[i]` is an `Index` with the index as the
# source writes it, and `unchecked: false` outside a `dont_panic` body. An index of an
# element (`grid[2][1]`) is an `Index` of an `Index`, and an indexed rebind has an `Index`
# as its target. A range in the index position is a slice: `xs[1..3]` and `xs[1..=3]` are
# a `Slice` with the bounds of the range and `inclusive`. An index and each bound record
# their value when the compiler can read it (ruling E3). An index is not opaque: the
# divisor `[4, 2][0]` has the value 4. A slice is opaque: its value is a view.

fn width(i32[] row) i32:
    return row.len()

fn main() i32:
    let i32[] xs = from([10, 20, 30, 40])
    let i32 i = 1
    println(xs[i])
    let i32[2][3] grid = [[1, 2], [3, 4], [5, 6]]
    println(grid[2][1])
    println(width(xs[1..3]))
    println(width(xs[1..=3]))
    println(100 / [4, 2][0])
    xs[i] := 9
    println(xs[1])
    println("Mostly Harmless")
    return 0
