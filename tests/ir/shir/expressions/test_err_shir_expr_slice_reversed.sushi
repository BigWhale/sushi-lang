# EXPECT_ERROR_CODE: CE2122
# EXPECT_DUMP_SHIR: test_err_shir_expr_slice_reversed.shir
#
# the SHIR dump of a slice with a reversed range. A `Slice` has no field for `.rev()`,
# and the program has an error, so the index is a hole that names its AST class
# (`IndexAccess`). The typecheck pass refuses the range (CE2122) after the dump is
# written.

fn main() i32:
    let i32[] xs = from([1, 2, 3])
    return xs[(0..2).rev()].len()
