unit test_shir_expr_interp

ShirBody main
  params : []
  locals : [_0 "name": string, _1 "n": i32, _2 "v": Vec, _3 "xs": i32[]]
  block  :
    Assign(LocalRef(_0), adopt Lit("Arthur"), is_init: true)
    Assign(LocalRef(_1), adopt Lit(42), is_init: true)
    Assign(LocalRef(_2), adopt StructInit(@Vec, [adopt Lit(3), adopt Lit(4)], written_order: [0, 1]), is_init: true)
    Assign(LocalRef(_3), adopt ArrayInit(Dynamic, [Single(adopt Lit(2)), Single(adopt Lit(9))]), is_init: true)
    ExprStmt(Call(Intrinsic("println"), [(Interp(["Mostly Harmless, ", LocalRef(_0), ""]), Guaranteed)]))
    ExprStmt(Call(Intrinsic("println"), [(Interp(["", LocalRef(_1), ""]), Guaranteed)]))
    ExprStmt(Call(Intrinsic("println"), [(Interp(["x=", Field(LocalRef(_2), "x"), " y=", Field(LocalRef(_2), "y"), " sum=", Call(Method(LocalRef(_2), @Vec.sum, Guaranteed), []), " big=", Binary(>, LocalRef(_1), Lit(40)), ""]), Guaranteed)]))
    ExprStmt(Call(Intrinsic("println"), [(Interp(["[", Index(LocalRef(_3), Lit(0), unchecked: false), "] ", Index(LocalRef(_3), Lit(1), unchecked: false), " ", Binary(/, Cast(adopt LocalRef(_1), f64), Lit(12.0)), ""]), Guaranteed)]))
    Return(adopt Lit(0))

ShirBody Vec.sum
  params : [(_0 "self": Vec, Guaranteed)]
  locals : []
  block  :
