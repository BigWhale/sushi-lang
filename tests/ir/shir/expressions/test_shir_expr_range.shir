unit test_shir_expr_range

ShirBody TOP (Initializer)
  params : []
  locals : []
  block  :
    Return(Lit(10))

ShirBody total
  params : [(_0 "it": Iterator@(i32), Owned)]
  locals : [_1 "sum": i32, _2 "i"]
  block  :
    Assign(LocalRef(_1), Lit(0), is_init: true)
    Loop(Items(LocalRef(_0), _2, Bare), [Assign(LocalRef(_1), Binary(+, LocalRef(_1), LocalRef(_2)), is_init: false)])
    Return(LocalRef(_1))

ShirBody main
  params : []
  locals : [_0 "up": Iterator@(i32), _1 "all": Iterator@(i32), _2 "n": i32, _3 "down": Iterator@(i32)]
  block  :
    Assign(LocalRef(_0), Range(Lit(0) = 0, ConstRef(@TOP) = 10, inclusive: false, reverse: false), is_init: true)
    ExprStmt(Call(BuiltinFn("println"), [Call(Named(GlobalRef(@total)), [(LocalRef(_0), Owned)])]))
    Assign(LocalRef(_1), Range(Lit(0) = 0, Lit(10) = 10, inclusive: true, reverse: false), is_init: true)
    ExprStmt(Call(BuiltinFn("println"), [Call(Named(GlobalRef(@total)), [(LocalRef(_1), Owned)])]))
    Assign(LocalRef(_2), Lit(10), is_init: true)
    Assign(LocalRef(_3), Range(Lit(0) = 0, LocalRef(_2), inclusive: false, reverse: true), is_init: true)
    ExprStmt(Call(BuiltinFn("println"), [Call(Named(GlobalRef(@total)), [(LocalRef(_3), Owned)])]))
    ExprStmt(Call(BuiltinFn("println"), [Lit("Mostly Harmless")]))
    Return(Lit(0))
