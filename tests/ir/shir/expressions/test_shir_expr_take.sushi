# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "alpha\nbeta\ngamma\nMostly Harmless\n"
# EXPECT_DUMP_SHIR: test_shir_expr_take.shir
#
# the SHIR dump of a marked field take. `nom a.inner` in a `let` initializer and
# `nom w.inner` in a `return` are a `Take` of the field read, as the source writes them.
# In a call argument the take is the `Owned` marker of the `Arg` on the `Field`, with no
# `Take`. Whether the place is one step off a name that the function owns is a rule of the
# borrow pass, not of lowering.

struct Wrap:
    string inner
    i32 tag

fn eat(nom string s) ~:
    println(s)

fn unwrap(nom Wrap w) string:
    return nom w.inner

fn main() i32:
    let Wrap a = Wrap("alpha", 1)
    let string got = nom a.inner
    println(got)
    let Wrap b = Wrap("beta", 2)
    println(unwrap(nom b))
    let Wrap c = Wrap("gamma", 3)
    eat(nom c.inner)
    println("Mostly Harmless")
    return 0
