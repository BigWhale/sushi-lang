# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "45\n55\n45\nMostly Harmless\n"
# EXPECT_DUMP_SHIR: test_shir_expr_range.shir
#
# the SHIR dump of a range as a value, in a position that expects `Iterator@(i32)`.
# `0..TOP` and `0..=10` are a `Range` with `inclusive`. The AST builder folds `.rev()` into
# the range, so `(0..n).rev()` is a `Range` with `reverse: true`, and no call. Each bound
# records its value when the compiler can read it (ruling E3), a constant too; the local
# bound `n` has no value.

use <collections/iter>

const i32 TOP = 10

fn total(nom Iterator@(i32) it) i32:
    let i32 sum = 0
    foreach(i in it):
        sum := sum + i
    return sum

fn main() i32:
    let Iterator@(i32) up = 0..TOP
    println(total(nom up))
    let Iterator@(i32) all = 0..=10
    println(total(nom all))
    let i32 n = 10
    let Iterator@(i32) down = (0..n).rev()
    println(total(nom down))
    println("Mostly Harmless")
    return 0
