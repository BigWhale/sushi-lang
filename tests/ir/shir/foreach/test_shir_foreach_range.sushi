# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "6\n"
# EXPECT_DUMP_SHIR: test_shir_foreach_range.shir
#
# the SHIR dump of a `foreach` over a range: `0..10`, `(0..10).rev()` and `1..=3`. The
# loop is a `Loop` with an `Items` source. A range is a hole until its lowering exists
# (P1.12), so the iterable of each loop is `<hole: RangeExpr>`. The AST builder folds
# `.rev()` into the range, so the second loop has no call.

fn main() i32:
    let i32 total = 0
    foreach(i in 0..10):
        total := total + i
    foreach(j in (0..10).rev()):
        total := total - j
    foreach(k in 1..=3):
        total := total + k
    println(total)
    return 0
