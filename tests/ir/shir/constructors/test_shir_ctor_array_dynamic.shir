unit test_shir_ctor_array_dynamic

ShirBody calls (Initializer)
  params : []
  locals : []
  block  :
    Return(adopt Lit(0))

ShirBody mark
  params : [(_0 "v": i32, Guaranteed)]
  locals : []
  block  :
    Assign(StorageRef(@calls), adopt Binary(+, StorageRef(@calls), Lit(1)), is_init: false)
    Return(adopt LocalRef(_0))

ShirBody main
  params : []
  locals : [_0 "n": i32, _1 "listed": i32[], _2 "empty": i32[], _3 "filled": i32[], _4 "ranged": i32[], _5 "marked": i32[]]
  block  :
    Assign(LocalRef(_0), adopt Lit(3), is_init: true)
    Assign(LocalRef(_1), adopt ArrayInit(Dynamic, [Single(adopt Lit(1)), Single(adopt Lit(2)), Single(adopt Lit(3))]), is_init: true)
    Assign(LocalRef(_2), adopt ArrayInit(Dynamic, []), is_init: true)
    Assign(LocalRef(_3), adopt ArrayInit(Dynamic, [Repeat(Lit(0), LocalRef(_0))]), is_init: true)
    Assign(LocalRef(_4), adopt ArrayInit(Dynamic, [RangeRun(Range(Lit(0), LocalRef(_0), inclusive: false, reverse: false))]), is_init: true)
    Assign(LocalRef(_5), adopt ArrayInit(Dynamic, [Repeat(Call(Free(@mark), [(Lit(7), Guaranteed)]), Call(Free(@mark), [(Lit(2), Guaranteed)]))]), is_init: true)
    ExprStmt(Call(Intrinsic("println"), [(Call(Builtin(LocalRef(_1), "len"), []), Guaranteed)]))
    ExprStmt(Call(Intrinsic("println"), [(Call(Builtin(LocalRef(_2), "len"), []), Guaranteed)]))
    ExprStmt(Call(Intrinsic("println"), [(Call(Builtin(LocalRef(_3), "len"), []), Guaranteed)]))
    ExprStmt(Call(Intrinsic("println"), [(Call(Builtin(LocalRef(_4), "len"), []), Guaranteed)]))
    ExprStmt(Call(Intrinsic("println"), [(Call(Builtin(LocalRef(_5), "len"), []), Guaranteed)]))
    ExprStmt(Call(Intrinsic("println"), [(StorageRef(@calls), Guaranteed)]))
    ExprStmt(Call(Intrinsic("println"), [(Lit("Mostly Harmless"), Guaranteed)]))
    Return(adopt Lit(0))
