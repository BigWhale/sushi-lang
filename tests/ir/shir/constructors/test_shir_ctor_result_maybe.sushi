# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "4\n0\n7\n0\nMostly Harmless\n"
# EXPECT_NO_LEAKS: true
# EXPECT_DUMP_SHIR: test_shir_ctor_result_maybe.shir
#
# the SHIR dump of the constructions of the predefined enums: `Result.Ok`, `Result.Err`,
# `Maybe.Some` and the bare `Maybe.None`. Each is an `EnumInit` that names the enum as
# written. An error enum in a payload is an `EnumInit` in the payload, and a payload
# argument keeps its written marker (`Result.Ok(nom s)`).

error Odd:
    Found

fn half(i32 n) i32 | Odd:
    if (n % 2 == 1):
        return Result.Err(Odd.Found)
    return Result.Ok(n / 2)

fn maybe(bool has) Maybe@(i32):
    if (has):
        return Maybe.Some(7)
    return Maybe.None

fn keep(nom string s) string | Odd:
    return Result.Ok(nom s)

fn main() i32:
    println(half(8).realise(0))
    println(half(3).realise(0))
    println(maybe(true).realise(0))
    println(maybe(false).realise(0))
    let string s = "Mostly Harmless"
    println(keep(nom s).realise("none"))
    return 0
