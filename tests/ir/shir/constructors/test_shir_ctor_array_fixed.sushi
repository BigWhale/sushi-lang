# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "3\n4\n4\n7\n4\n3\nMostly Harmless\n"
# EXPECT_DUMP_SHIR: test_shir_ctor_array_fixed.shir
#
# the SHIR dump of a fixed array literal: an `ArrayInit` of the kind `Fixed`, with one run
# for each element as written. A plain element is `Single`. A repeat `[v; n]` is `Repeat`
# with the value first and then the count (ruling R2), and the count that the compiler
# can read has its value after it (ruling E3). A range element is `RangeRun` with the
# bounds of its `Range` read in the same way, and `(0..3).rev()` sets `reverse`.

const i32 LEN = 4

fn main() i32:
    let i32[3] plain = [1, 2, 3]
    let i32[4] zeros = [0; 4]
    let i32[4] counted = [0..=3]
    let i32[7] mixed = [9, 0; 2, 1..=3, 5]
    let i32[4] sized = [7; LEN]
    let i32[3] down = [(0..3).rev()]
    println(plain.len())
    println(zeros.len())
    println(counted.len())
    println(mixed.len())
    println(sized.len())
    println(down.len())
    println("Mostly Harmless")
    return 0
