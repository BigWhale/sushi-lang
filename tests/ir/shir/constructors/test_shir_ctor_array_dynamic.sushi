# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "3\n0\n3\n3\n2\n2\nMostly Harmless\n"
# EXPECT_NO_LEAKS: true
# EXPECT_DUMP_SHIR: test_shir_ctor_array_dynamic.shir
#
# the SHIR dump of a dynamic array: `from([...])` is an `ArrayInit` of the kind `Dynamic`
# with the runs of its literal (ir.md 7.10), and `new()` is one with no run. A count or a
# bound that holds a local has no value after it. In the repeat `[mark(7); mark(2)]` the
# value is the first field and the count the second, so the value is evaluated first
# (ruling R2). The count of the calls does not depend on the order, so the output is the
# same on the old pipeline.

var i32 calls = 0

fn mark(i32 v) i32:
    calls := calls + 1
    return v

fn main() i32:
    let i32 n = 3
    let i32[] listed = from([1, 2, 3])
    let i32[] empty = new()
    let i32[] filled = from([0; n])
    let i32[] ranged = from([0..n])
    let i32[] marked = from([mark(7); mark(2)])
    println(listed.len())
    println(empty.len())
    println(filled.len())
    println(ranged.len())
    println(marked.len())
    println(calls)
    println("Mostly Harmless")
    return 0
