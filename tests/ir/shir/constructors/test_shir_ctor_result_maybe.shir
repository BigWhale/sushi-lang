unit test_shir_ctor_result_maybe

ShirBody half
  params : [(_0 "n": i32, Guaranteed)]
  locals : []
  block  :
    If(Binary(==, Binary(%, LocalRef(_0), Lit(2)), Lit(1)), then: [Return(adopt EnumInit(@Result, "Err", [adopt EnumInit(@Odd, "Found", [])]))])
    Return(adopt EnumInit(@Result, "Ok", [adopt Binary(/, LocalRef(_0), Lit(2))]))

ShirBody maybe
  params : [(_0 "has": bool, Guaranteed)]
  locals : []
  block  :
    If(LocalRef(_0), then: [Return(adopt EnumInit(@Maybe, "Some", [adopt Lit(7)]))])
    Return(adopt EnumInit(@Maybe, "None", []))

ShirBody keep
  params : [(_0 "s": string, Owned)]
  locals : []
  block  :
    Return(adopt EnumInit(@Result, "Ok", [(move LocalRef(_0), Owned)]))

ShirBody main
  params : []
  locals : [_0 "s": string]
  block  :
    ExprStmt(Call(Intrinsic("println"), [(Call(Builtin(Call(Free(@half), [(Lit(8), Guaranteed)]), "realise"), [(Lit(0), Guaranteed)]), Guaranteed)]))
    ExprStmt(Call(Intrinsic("println"), [(Call(Builtin(Call(Free(@half), [(Lit(3), Guaranteed)]), "realise"), [(Lit(0), Guaranteed)]), Guaranteed)]))
    ExprStmt(Call(Intrinsic("println"), [(Call(Builtin(Call(Free(@maybe), [(Lit(true), Guaranteed)]), "realise"), [(Lit(0), Guaranteed)]), Guaranteed)]))
    ExprStmt(Call(Intrinsic("println"), [(Call(Builtin(Call(Free(@maybe), [(Lit(false), Guaranteed)]), "realise"), [(Lit(0), Guaranteed)]), Guaranteed)]))
    Assign(LocalRef(_0), adopt Lit("Mostly Harmless"), is_init: true)
    ExprStmt(Call(Intrinsic("println"), [(Call(Builtin(Call(Free(@keep), [(adopt LocalRef(_0), Owned)]), "realise"), [(Lit("none"), Guaranteed)]), Guaranteed)]))
    Return(adopt Lit(0))
