unit test_shir_variadic_expand_rebind

ShirBody swap_each (TemplateCheck("test_shir_variadic_expand_rebind.swap_each"))
  params : [(_0 "args": Ts, Guaranteed, pack: true)]
  locals : [_1 "a": i32, _2 "b": i32, _3: Ts]
  block  :
    Assign(LocalRef(_1), adopt Lit(1), is_init: true)
    Assign(LocalRef(_2), adopt Lit(2), is_init: true)
    Expand(_3, "args", [Destructure([Place(LocalRef(_1)), Place(LocalRef(_2))], adopt TupleInit([adopt LocalRef(_2), adopt LocalRef(_1)]))])
    ExprStmt(Call(Intrinsic("println"), [(Interp(["", LocalRef(_1), " ", LocalRef(_2), ""]), Guaranteed)]))
    Return(adopt Lit(0))

ShirBody main
  params : []
  locals : []
  block  :
    Return(adopt Call(Free(@swap_each__i32_i32_i32.pack3), [(Lit(1), Guaranteed), (Lit(2), Guaranteed), (Lit(3), Guaranteed)]))

