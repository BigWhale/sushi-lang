unit test_shir_match_nested

ShirBody area
  params : [(_0 "s": Slot, Guaranteed)]
  locals : [_1 "out": i32, _2 "r", _3 "side"]
  block  :
    Assign(LocalRef(_1), Lit(0), is_init: true)
    Match(LocalRef(_0), [Arm(Variant(@Slot, "Has", [Variant(@Shape, "Circle", [(_2, Bare)])]), [Assign(LocalRef(_1), Binary(*, Binary(*, Lit(3), LocalRef(_2)), LocalRef(_2)), is_init: false)]), Arm(Variant(@Slot, "Has", [Variant(@Shape, "Square", [Or([Literal(1), Literal(2)])])]), [Assign(LocalRef(_1), Lit(1), is_init: false)]), Arm(Variant(@Slot, "Has", [Variant(@Shape, "Square", [(_3, Bare)])]), [Assign(LocalRef(_1), Binary(*, LocalRef(_3), LocalRef(_3)), is_init: false)]), Arm(Variant(@Slot, "Nothing", []), [Assign(LocalRef(_1), Lit(0), is_init: false)])], consumes: false)
    Return(LocalRef(_1))

ShirBody size
  params : [(_0 "sh": Shape, Guaranteed)]
  locals : [_1 "out": i32, _2 "n"]
  block  :
    Assign(LocalRef(_1), Lit(0), is_init: true)
    Match(LocalRef(_0), [Arm(Or([Variant(@Shape, "Circle", [(_2, Bare)]), Variant(@Shape, "Square", [(_2, Bare)])]), [Assign(LocalRef(_1), LocalRef(_2), is_init: false)])], consumes: false)
    Return(LocalRef(_1))

ShirBody main
  params : []
  locals : []
  block  :
    ExprStmt(Call(Intrinsic("println"), [(Call(Free(@area), [(EnumInit(@Slot, "Has", [adopt EnumInit(@Shape, "Circle", [adopt Lit(2)])]), Guaranteed)]), Guaranteed)]))
    ExprStmt(Call(Intrinsic("println"), [(Call(Free(@area), [(EnumInit(@Slot, "Has", [adopt EnumInit(@Shape, "Square", [adopt Lit(2)])]), Guaranteed)]), Guaranteed)]))
    ExprStmt(Call(Intrinsic("println"), [(Call(Free(@area), [(EnumInit(@Slot, "Has", [adopt EnumInit(@Shape, "Square", [adopt Lit(3)])]), Guaranteed)]), Guaranteed)]))
    ExprStmt(Call(Intrinsic("println"), [(Call(Free(@area), [(EnumInit(@Slot, "Nothing", []), Guaranteed)]), Guaranteed)]))
    ExprStmt(Call(Intrinsic("println"), [(Call(Free(@size), [(EnumInit(@Shape, "Square", [adopt Lit(6)]), Guaranteed)]), Guaranteed)]))
    ExprStmt(Call(Intrinsic("println"), [(Lit("Mostly Harmless"), Guaranteed)]))
    Return(adopt Lit(0))
