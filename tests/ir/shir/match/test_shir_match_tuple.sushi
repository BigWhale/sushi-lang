# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "1\n5\n7\nMostly Harmless\n"
# EXPECT_DUMP_SHIR: test_shir_match_tuple.shir
#
# the SHIR dump of tuple patterns: a `Tuple` holds one item for each element, an enum
# pattern, a literal, a binding or `_`.

enum Color:
    Red
    Green

fn describe((Color, i32) pair) i32:
    let i32 out = 0
    match pair:
        (Color.Red, 0) -> out := 1
        (Color.Red, n) -> out := n
        (Color.Green, _) -> out := 7
    return out

fn main() i32:
    println(describe((Color.Red, 0)))
    println(describe((Color.Red, 5)))
    println(describe((Color.Green, 3)))
    println("Mostly Harmless")
    return 0
