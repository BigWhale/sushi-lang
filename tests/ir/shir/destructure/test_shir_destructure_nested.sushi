# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "42\n"
# EXPECT_DUMP_SHIR: test_shir_destructure_nested.shir
#
# the SHIR dump of a nested destructure, `let ((a, b), c) = v`. The nested targets are a
# `Nested` target, which prints as a list in the list.

fn main() i32:
    let ((i32, i32), i32) v = ((40, 1), 1)
    let ((a, b), c) = v
    println(a + b + c)
    return 0
