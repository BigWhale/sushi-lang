unit test_shir_destructure_call

ShirBody split
  params : [(_0 "n": i32, Guaranteed)]
  locals : []
  block  :
    Return(adopt TupleInit([adopt Binary(/, LocalRef(_0), Lit(10)), adopt Binary(%, LocalRef(_0), Lit(10))]))

ShirBody main
  params : []
  locals : [_1 "tens": i32, _2 "ones": i32]
  block  :
    Destructure([_1, _2], adopt Call(Free(@split), [(Lit(42), Guaranteed)]))
    ExprStmt(Call(Intrinsic("println"), [(Binary(+, Binary(*, LocalRef(_1), Lit(10)), LocalRef(_2)), Guaranteed)]))
    Return(adopt Lit(0))
