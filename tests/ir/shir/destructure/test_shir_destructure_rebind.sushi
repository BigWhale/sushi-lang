# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "2 1\n"
# EXPECT_DUMP_SHIR: test_shir_destructure_rebind.shir
#
# the SHIR dump of a tuple rebind, `(a, b) := (b, a)`: ONE `Destructure` whose targets are
# the places, `Place(a)` and `Place(b)`. The AST builder splits the rebind into a
# destructure into hidden binders and one rebind of each place; lowering joins the split
# again, so the hidden binders are no locals of the body.

fn main() i32:
    let i32 a = 1
    let i32 b = 2
    (a, b) := (b, a)
    println("{a} {b}")
    return 0
