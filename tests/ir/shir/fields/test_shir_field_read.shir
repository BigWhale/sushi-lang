unit test_shir_field_read

ShirBody ORIGIN (Initializer)
  params : []
  locals : []
  block  :
    Return(adopt StructInit(@Vec, [adopt Lit(0), adopt Lit(0)], written_order: [0, 1]))

ShirBody make
  params : []
  locals : []
  block  :
    Return(adopt StructInit(@Vec, [adopt Lit(5), adopt Lit(6)], written_order: [0, 1]))

ShirBody ratio
  params : [(_0 "v": Vec, Guaranteed)]
  locals : []
  block  :
    Return(adopt Binary(/, Lit(100), Field(LocalRef(_0), "x")))

ShirBody main
  params : []
  locals : [_0 "l": Line]
  block  :
    Assign(LocalRef(_0), adopt StructInit(@Line, [adopt StructInit(@Vec, [adopt Lit(1), adopt Lit(2)], written_order: [0, 1]), adopt StructInit(@Vec, [adopt Lit(3), adopt Lit(4)], written_order: [0, 1])], written_order: [0, 1]), is_init: true)
    ExprStmt(Call(Intrinsic("println"), [(Field(Field(LocalRef(_0), "start"), "x"), Guaranteed)]))
    ExprStmt(Call(Intrinsic("println"), [(Field(Field(LocalRef(_0), "stop"), "y"), Guaranteed)]))
    ExprStmt(Call(Intrinsic("println"), [(Field(Call(Free(@make), []), "y"), Guaranteed)]))
    ExprStmt(Call(Intrinsic("println"), [(Field(ConstRef(@ORIGIN), "x"), Guaranteed)]))
    ExprStmt(Call(Intrinsic("println"), [(Call(Free(@ratio), [(Field(LocalRef(_0), "stop"), Guaranteed)]), Guaranteed)]))
    ExprStmt(Call(Intrinsic("println"), [(Call(Method(Field(LocalRef(_0), "start"), @Vec.sum, Guaranteed), []), Guaranteed)]))
    ExprStmt(Call(Intrinsic("println"), [(Lit("Mostly Harmless"), Guaranteed)]))
    Return(adopt Lit(0))

ShirBody Vec.sum
  params : [(_0 "self": Vec, Guaranteed)]
  locals : []
  block  :
    Return(adopt Binary(+, Field(LocalRef(_0), "x"), Field(LocalRef(_0), "y")))
