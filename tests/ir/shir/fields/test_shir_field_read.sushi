# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "1\n4\n6\n0\n33\n3\nMostly Harmless\n"
# EXPECT_DUMP_SHIR: test_shir_field_read.shir
#
# the SHIR dump of a field read: `p.x` is a `Field` of its base, a nested read `l.start.x`
# is a `Field` of a `Field`, and the base can be a call, a constant or `self`. Which field
# it is, and its index, are answers of the typecheck pass. A field read is not a value
# that lowering reads: the divisor `v.x` has no value after it (ruling E3).

struct Vec:
    i32 x
    i32 y

struct Line:
    Vec start
    Vec stop

const Vec ORIGIN = Vec(0, 0)

extend Vec sum() i32:
    return self.x + self.y

fn make() Vec:
    return Vec(5, 6)

fn ratio(Vec v) i32:
    return 100 / v.x

fn main() i32:
    let Line l = Line(Vec(1, 2), Vec(3, 4))
    println(l.start.x)
    println(l.stop.y)
    println(make().y)
    println(ORIGIN.x)
    println(ratio(l.stop))
    println(l.start.sum())
    println("Mostly Harmless")
    return 0
