unit test_shir_field_rebind

ShirBody main
  params : []
  locals : [_0 "v": Vec, _1 "l": Line, _2 "t": (i32, i32)]
  block  :
    Assign(LocalRef(_0), adopt StructInit(@Vec, [adopt Lit(1), adopt Lit(2)], written_order: [0, 1]), is_init: true)
    Assign(Field(LocalRef(_0), "x"), adopt Lit(10), is_init: false)
    ExprStmt(Call(Method(LocalRef(_0), @Vec.shift, Inout), [(Lit(5), Guaranteed)]))
    Assign(LocalRef(_1), adopt StructInit(@Line, [adopt StructInit(@Vec, [adopt Lit(1), adopt Lit(2)], written_order: [0, 1]), adopt StructInit(@Vec, [adopt Lit(3), adopt Lit(4)], written_order: [0, 1])], written_order: [0, 1]), is_init: true)
    Assign(Field(Field(LocalRef(_1), "stop"), "y"), adopt Lit(40), is_init: false)
    Assign(LocalRef(_2), adopt TupleInit([adopt Lit(5), adopt Lit(6)]), is_init: true)
    Assign(Field(LocalRef(_2), "1"), adopt Lit(60), is_init: false)
    ExprStmt(Call(Intrinsic("println"), [(Field(LocalRef(_0), "x"), Guaranteed)]))
    ExprStmt(Call(Intrinsic("println"), [(Field(Field(LocalRef(_1), "stop"), "y"), Guaranteed)]))
    ExprStmt(Call(Intrinsic("println"), [(Field(LocalRef(_2), "1"), Guaranteed)]))
    ExprStmt(Call(Intrinsic("println"), [(Lit("Mostly Harmless"), Guaranteed)]))
    Return(adopt Lit(0))

ShirBody Vec.shift
  params : [(_0 "self": Vec, Inout), (_1 "d": i32, Guaranteed)]
  locals : []
  block  :
    Assign(Field(LocalRef(_0), "x"), adopt Binary(+, Field(LocalRef(_0), "x"), LocalRef(_1)), is_init: false)
