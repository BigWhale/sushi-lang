unit helpers/shir_geo

ShirBody LIMIT (Initializer)
  params : []
  locals : []
  block  :
    Return(adopt Lit(4))

ShirBody ORIGIN (Initializer)
  params : []
  locals : []
  block  :
    Return(adopt StructInit(@Vec, [adopt Lit(0), adopt Lit(7)], written_order: [0, 1]))

ShirBody hits (Initializer)
  params : []
  locals : []
  block  :
    Return(adopt Lit(0))

ShirBody twice
  params : [(_0 "x": i32, Guaranteed)]
  locals : []
  block  :
    Return(adopt Binary(*, LocalRef(_0), Lit(2)))

unit test_shir_field_alias

ShirBody main
  params : []
  locals : [_0 "f": fn(i32) -> i32, _1 "o": Vec]
  block  :
    Assign(LocalRef(_0), adopt GlobalRef(@geo.twice), is_init: true)
    Assign(LocalRef(_1), adopt ConstRef(@geo.ORIGIN), is_init: true)
    Assign(StorageRef(@geo.hits), adopt Binary(+, StorageRef(@geo.hits), Lit(1)), is_init: false)
    ExprStmt(Call(Intrinsic("println"), [(Binary(/, Lit(100), ConstRef(@geo.LIMIT)), Guaranteed)]))
    ExprStmt(Call(Intrinsic("println"), [(Field(LocalRef(_1), "y"), Guaranteed)]))
    ExprStmt(Call(Intrinsic("println"), [(Call(Indirect(LocalRef(_0)), [(Lit(21), Guaranteed)]), Guaranteed)]))
    ExprStmt(Call(Intrinsic("println"), [(StorageRef(@geo.hits), Guaranteed)]))
    ExprStmt(Call(Intrinsic("println"), [(Lit("Mostly Harmless"), Guaranteed)]))
    Return(adopt Lit(0))
