unit helpers/shir_geo

ShirBody LIMIT (Initializer)
  params : []
  locals : []
  block  :
    Return(Lit(4))

ShirBody ORIGIN (Initializer)
  params : []
  locals : []
  block  :
    Return(StructInit(@Vec, [Lit(0), Lit(7)], written_order: [0, 1]))

ShirBody hits (Initializer)
  params : []
  locals : []
  block  :
    Return(Lit(0))

ShirBody twice
  params : [(_0 "x": i32, Guaranteed)]
  locals : []
  block  :
    Return(Binary(*, LocalRef(_0), Lit(2) = 2))

unit test_shir_field_alias

ShirBody main
  params : []
  locals : [_0 "f": fn(i32) -> i32, _1 "o": Vec]
  block  :
    Assign(LocalRef(_0), GlobalRef(@geo.twice), is_init: true)
    Assign(LocalRef(_1), ConstRef(@geo.ORIGIN), is_init: true)
    Assign(StorageRef(@geo.hits), Binary(+, StorageRef(@geo.hits), Lit(1) = 1), is_init: false)
    ExprStmt(Call(BuiltinFn("println"), [Binary(/, Lit(100), ConstRef(@geo.LIMIT))]))
    ExprStmt(Call(BuiltinFn("println"), [Field(LocalRef(_1), "y")]))
    ExprStmt(Call(BuiltinFn("println"), [Call(Named(LocalRef(_0)), [Lit(21)])]))
    ExprStmt(Call(BuiltinFn("println"), [StorageRef(@geo.hits)]))
    ExprStmt(Call(BuiltinFn("println"), [Lit("Mostly Harmless")]))
    Return(Lit(0))
