unit test_shir_call_markers

ShirBody count (Initializer)
  params : []
  locals : []
  block  :
    Return(adopt Lit(0))

ShirBody size
  params : [(_0 "s": string, Guaranteed)]
  locals : []
  block  :
    Return(adopt Cast(adopt Call(Builtin(LocalRef(_0), "len"), []), i32))

ShirBody look
  params : [(_0 "s": string, InGuaranteed)]
  locals : []
  block  :
    Return(adopt Cast(adopt Call(Builtin(LocalRef(_0), "len"), []), i32))

ShirBody take
  params : [(_0 "s": string, Owned)]
  locals : []
  block  :
    Return(adopt Cast(adopt Call(Builtin(LocalRef(_0), "len"), []), i32))

ShirBody bump
  params : [(_0 "n": i32, Inout)]
  locals : []
  block  :
    Return(adopt Binary(+, LocalRef(_0), Lit(1)))

ShirBody add
  params : [(_0 "a": i32, Guaranteed), (_1 "b": i32, Guaranteed)]
  locals : []
  block  :
    Return(adopt Binary(+, LocalRef(_0), LocalRef(_1)))

ShirBody markers
  params : [(_0 "s": string, Owned)]
  locals : []
  block  :
    ExprStmt(Call(Free(@bump), [(StorageRef(@count), Inout)]))
    ExprStmt(Call(Free(@add), [(Call(Free(@size), [(LocalRef(_0), Guaranteed)]), Guaranteed), (Call(Free(@look), [(LocalRef(_0), InGuaranteed)]), Guaranteed)]))
    Return(adopt Call(Free(@take), [(move LocalRef(_0), Owned)]))

ShirBody main
  params : []
  locals : []
  block  :
    Return(adopt Lit(0))
