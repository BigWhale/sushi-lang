# EXPECT_RUNTIME_EXIT: 0
# EXPECT_DUMP_SHIR: test_shir_call_methods.shir
#
# the SHIR dump of a method call: the target is `Dotted`, with the receiver as written
# and the name of the method. Which method the name calls is the typecheck pass's
# answer. A receiver that is a call is the child of the call on it, so a chain reads
# from the inside out. A call is never a value that the compiler reads, so the divisor
# `(5).twice()` has no value after it, though its receiver is a literal.

extend i32 twice() i32:
    return self * 2

fn length(string s) i32:
    return s.trim().len()

fn sliced(string s) string:
    return s.s(0, 3)

fn literal() i32:
    return "Mostly Harmless".len()

fn opaque() i32:
    return 100 / (5).twice()

fn main() i32:
    return 0
