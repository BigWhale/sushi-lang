# EXPECT_RUNTIME_EXIT: 0
# EXPECT_DUMP_SHIR: test_shir_call_namespace.shir
#
# the SHIR dump of a call through a namespace: a stdlib module behind `use ... as`, and
# a C function behind an `unsafe external` block. The typecheck pass resolves the callee
# through the alias: a stdlib function is `Stdlib` with its module, a C function is `Extern`
# with its link name, and a built-in static on a type behind an alias is `BuiltinStatic` on
# the instance type, as on a bare type name.

use <math> as m
use <collections/hashmap> as hm

unsafe external "C" as libc because "the SHIR dump of an extern call":
    fn abs(i32 x) i32 = "abs"

fn root(f64 x) f64:
    return m.sqrt(x)

fn magnitude(i32 x) i32:
    return libc.abs(x)

fn table() hm.HashMap@(i32, i32):
    return hm.HashMap.new()

fn main() i32:
    return 0
