unit test_shir_call_print

ShirBody greet
  params : [(_0 "name": string, Guaranteed)]
  locals : []
  block  :
    ExprStmt(Call(Intrinsic("println"), [(Interp(["Mostly Harmless, ", LocalRef(_0), ""]), Guaranteed)]))
    ExprStmt(Call(Intrinsic("print"), [(LocalRef(_0), Guaranteed)]))

ShirBody main
  params : []
  locals : []
  block  :
    ExprStmt(Call(Free(@greet), [(Lit("Arthur"), Guaranteed)]))
    Return(Lit(0))
