# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "3\n4\nMostly Harmless\n2.5\n7\nbehind an alias\n"
# EXPECT_NO_LEAKS
# EXPECT_DUMP_SLIR: test_emit_const_to_a_peek_parameter.slir
#
# A constant passed to a `peek` parameter, bare and behind an alias: an integer, a float
# and a string. The argument is a constant operand, which has no place. So the emitter
# stores the value in a slot and passes the address of the slot. An initializer body does
# not go to SLIR: the global of a constant takes the value of the constant evaluator.

use "helpers/peek_levels" as lv

const i32 STEP = 3
const i32 NEXT = STEP + 1
const string NAME = "Mostly Harmless"
const f64 RATIO = 2.5

fn show_i32(peek i32 n) ~:
    println(n)

fn show_string(peek string s) ~:
    println(s)

fn show_f64(peek f64 x) ~:
    println(x)

fn main() i32:
    show_i32(peek STEP)
    show_i32(peek NEXT)
    show_string(peek NAME)
    show_f64(peek RATIO)
    show_i32(peek lv.LIMIT)
    show_string(peek lv.LABEL)
    return 0
