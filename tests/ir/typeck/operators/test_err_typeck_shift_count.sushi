# EXPECT_ERROR_CODES_EXACT: CE2512
# EXPECT_STDERR_CONTAINS: "shift count 8 is out of range for u8: a count must be from 0 to 7"
# EXPECT_DUMP_SHIR: test_err_typeck_shift_count.shir
#
# A shift count that the compiler can read must be from 0 to the width of the value less
# one. A count that it cannot read, a local for example, is not checked. A literal count
# takes the type of the value. The last shift moves a `u8` by 8, which is CE2512.

fn main() i32:
    let u8 small = 1
    let i32 wide = 1
    let i32 by = 40
    let u8 top = small << 7
    let i32 far = wide << 31
    let i32 any = wide << by
    let i32 down = far >> (31 - 1)
    let u8 low = top >> 7
    let i32 sum = any + down
    let u8 bad = small << 8
    low := bad
    return sum
