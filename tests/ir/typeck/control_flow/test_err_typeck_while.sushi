# EXPECT_ERROR_CODES_EXACT: CE2005
# EXPECT_STDERR_CONTAINS: "condition must be bool"
# EXPECT_DUMP_SHIR: test_err_typeck_while.shir
#
# The condition of a `while` is a `bool`. Its body may hold `break`, `continue`, an `if`
# and a `while` of its own. The last `while` takes an `i32` as its condition, which is
# CE2005.

fn main() i32:
    let i32 i = 0
    let i32 total = 0
    while (i < 10):
        i := i + 1
        if (i % 2 == 0):
            continue
        let i32 j = 0
        while (true):
            j := j + 1
            if (j > i):
                break
            total := total + j
        if (total > 100):
            break
    while (total):
        total := total - 1
    return 0
