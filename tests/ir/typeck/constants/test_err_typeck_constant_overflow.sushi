# EXPECT_ERROR_CODES_EXACT: CE2077
# EXPECT_STDERR_CONTAINS: "gives 300, which is out of range for u8"
# EXPECT_DUMP_SHIR: test_err_typeck_constant_overflow.shir
#
# The constant evaluator reads the initializer at the declared type before the typecheck
# pass walks it: a sum that a `u8` cannot hold is CE2077, and the walk does not run. The
# constant has no value, so `main` reads a constant with no value. That is no second error,
# and the body of `main` does not go on to the next stage.

const u8 TOO_BIG = 200 + 100

fn main() i32:
    println(TOO_BIG)
    return 0
