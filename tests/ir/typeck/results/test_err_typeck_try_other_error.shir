unit test_err_typeck_try_other_error

ShirBody half
  params : [(_0 "n": i32, Guaranteed)]
  locals : []
  block  :
    If(Binary(==, Binary(%, LocalRef(_0), Lit(2)), Lit(1)), then: [Return(adopt EnumInit(@Result, "Err", [adopt EnumInit(@Odd, "Found", [])]))])
    Return(adopt EnumInit(@Result, "Ok", [adopt Binary(/, LocalRef(_0), Lit(2))]))

ShirBody show
  params : [(_0 "n": i32, Guaranteed)]
  locals : []
  block  :
    ExprStmt(Call(Intrinsic("println"), [(Try(Call(Free(@half), [(LocalRef(_0), Guaranteed)])), Guaranteed)]))
    Return(EnumInit(@Result, "Ok", [Lit(Blank)]))

ShirBody main
  params : []
  locals : []
  block  :
    ExprStmt(Call(Free(@show), [(Lit(8), Guaranteed)]))
    Return(adopt Lit(0))
