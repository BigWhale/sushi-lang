unit test_err_typeck_channel

ShirBody half
  params : [(_0 "n": i32, Guaranteed)]
  locals : []
  block  :
    If(Binary(==, Binary(%, LocalRef(_0), Lit(2)), Lit(1)), then: [Return(EnumInit(@Result, "Err", [EnumInit(@StdError, "Error", [])]))])
    Return(EnumInit(@Result, "Ok", [Binary(/, LocalRef(_0), Lit(2))]))

ShirBody quarter
  params : [(_0 "n": i32, Guaranteed)]
  locals : [_1 "h": i32, _2 "q": Result@(i32, StdError)]
  block  :
    Assign(LocalRef(_1), Try(Call(Free(@half), [(LocalRef(_0), Guaranteed)])), is_init: true)
    Assign(LocalRef(_2), EnumInit(@Result, "Ok", [LocalRef(_1)]), is_init: true)
    Return(EnumInit(@Result, "Ok", [Try(Call(Free(@half), [(Try(LocalRef(_2)), Guaranteed)]))]))

ShirBody show
  params : [(_0 "n": i32, Guaranteed)]
  locals : []
  block  :
    ExprStmt(Call(Intrinsic("println"), [(Try(Call(Free(@quarter), [(LocalRef(_0), Guaranteed)])), Guaranteed)]))
    Return(EnumInit(@Result, "Ok", [Lit(Blank)]))

