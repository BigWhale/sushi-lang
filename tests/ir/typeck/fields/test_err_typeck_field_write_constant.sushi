# EXPECT_ERROR_CODES_EXACT: CE2096
# EXPECT_STDERR_CONTAINS: "cannot assign to a field of constant 'ORIGIN': constants are immutable."
# EXPECT_STDERR_CONTAINS: "  |     geo.ORIGIN.x := 1\n  `     --------+--------\n"
# EXPECT_DUMP_SHIR: test_err_typeck_field_write_constant.shir
#
# A constant lives in .rodata, so a write into one of its fields is CE2096 at the
# statement, also behind an alias. A read of the field is legal.

use "units/fieldgeo" as geo

fn main() i32:
    let i32 x = geo.ORIGIN.x
    geo.ORIGIN.x := 1
    return x
