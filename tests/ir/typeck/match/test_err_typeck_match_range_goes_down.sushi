# EXPECT_ERROR_CODES_EXACT: CE2125
# EXPECT_STDERR_CONTAINS: "range '0x8f..=0x80' goes down: a range always goes up"
# EXPECT_STDERR_CONTAINS: "write '0x80..=0x8f'"
# EXPECT_DUMP_SHIR: test_err_typeck_match_range_goes_down.shir
#
# A range arm goes up, and the bounds are read at the type of the scrutinee. `0x8f..=0x80`
# goes down: CE2125, and the help gives the bounds in the other order.

fn f(u8 b) string:
    match b:
        0x00..=0x7f -> return "low"
        0x8f..=0x80 -> return "down"
        _ -> return "other"

fn main() i32:
    println(f(1))
    return 0
