  locals : []
  block  :
    Match(LocalRef(_0), [Arm(IntRange(0x0, 0x7f, inclusive: true), [Return(Lit("low"))]), Arm(IntRange(0x80, 0xff, inclusive: true), [Return(Lit("high"))]), Arm(Wildcard, [Return(Lit("other"))])], consumes: false)

ShirBody main
