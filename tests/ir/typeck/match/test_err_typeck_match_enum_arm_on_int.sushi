# EXPECT_ERROR_CODES_EXACT: CE2076
# EXPECT_STDERR_CONTAINS: "match arm does not fit the scrutinee: enum-pattern arm on a 'i32' scrutinee"
# EXPECT_DUMP_SHIR: test_err_typeck_match_enum_arm_on_int.shir
#
# An alternative of an integer arm is an integer arm. An enum pattern among the
# alternatives is CE2076 at that alternative.

enum Color:
    Red
    Green

fn name(i32 n) i32:
    match n:
        1 | Color.Red -> return 1
        _ -> return 0

fn main() i32:
    println(name(1))
    return 0
