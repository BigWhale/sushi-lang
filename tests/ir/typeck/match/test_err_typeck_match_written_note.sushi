# EXPECT_ERROR_CODES_EXACT: CE2118
# EXPECT_STDERR_CONTAINS: "the arm '0x00..=0x7f' matches these values first"
# EXPECT_STDERR_CONTAINS: "the arm '0x80..=0xFF' matches these values first"
# EXPECT_DUMP_SHIR: test_err_typeck_match_written_note.shir
#
# A note that names an arm quotes the arm as it is written. The two ranges cover every u8,
# so the `_` arm is dead: CE2118, with a note at each range.

fn f(u8 b) string:
    match b:
        0x00..=0x7f -> return "low"
        0x80..=0xFF -> return "high"
        _ -> return "other"

fn main() i32:
    println(f(1))
    return 0
