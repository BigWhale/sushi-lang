# EXPECT_ERROR_CODES_EXACT: CE2073
# EXPECT_STDERR_CONTAINS: "literal 0x1_00 out of range for u8"
# EXPECT_DUMP_SHIR: test_err_typeck_match_written_bound.shir
#
# A diagnostic quotes a range bound as it is written: the underscore stays. On a u8, the
# bound `0x1_00` is 256 and does not fit: CE2073.

fn f(u8 b) string:
    match b:
        0x80..=0x1_00 -> return "high"
        _ -> return "other"

fn main() i32:
    println(f(1))
    return 0
