# EXPECT_ERROR_CODES_EXACT: CE2125
# EXPECT_STDERR_CONTAINS: "range '0x7F..=0x00' goes down: a range always goes up"
# EXPECT_STDERR_CONTAINS: "write '0x00..=0x7F'"
# EXPECT_DUMP_SHIR: test_err_typeck_match_written_range.shir
#
# A range that goes down is quoted as it is written, and the help gives the two bounds as
# they are written, in the other order: the leading zeros and the upper-case digits stay.

fn f(u8 b) string:
    match b:
        0x7F..=0x00 -> return "down"
        _ -> return "other"

fn main() i32:
    println(f(1))
    return 0
