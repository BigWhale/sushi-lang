# EXPECT_ERROR_CODES_EXACT: CE2002
# EXPECT_STDERR_CONTAINS: "type mismatch: cannot assign i32 to string."
# EXPECT_STDERR_CONTAINS: "  |     ((a, b), c) := ((1, 2), 3)\n  `       ^\n"
# EXPECT_DUMP_SHIR: test_err_typeck_destructure_place_nested_mismatch.shir
#
# A place at a nested level keeps its own type: an element that it does not fit is CE2002
# at the place.

fn main() i32:
    let string a = ""
    let i32 b = 0
    let i32 c = 0
    ((a, b), c) := ((1, 2), 3)
    println(a)
    return b + c
