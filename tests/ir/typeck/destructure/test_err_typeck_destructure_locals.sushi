# EXPECT_ERROR_CODES_EXACT: CE2002
# EXPECT_STDERR_CONTAINS: "type mismatch: cannot assign i32 to string."
# EXPECT_STDERR_CONTAINS: "  |     let ((string g, h), i) = ((1, 2), 3)\n  `           ---+--\n"
# EXPECT_DUMP_SHIR: test_err_typeck_destructure_locals.shir
#
# A bare binder takes the type of its element, and `_` binds nothing. A written type gives
# the part of a tuple literal its type, also at a nested level, so `200` is a `u8` and
# `5000000000` an `i64`. A value that is no tuple literal is checked at no type. A written
# type that its element does not fit is CE2002 at the written type, with no note.

fn pair() (i32, string):
    return (7, "seven")

fn main() i32:
    let (a, b) = (1, 2)
    let (u8 c, _) = (200, true)
    let ((i64 d, e), f) = ((5000000000, false), "Mostly Harmless")
    let (q, string r) = pair()
    println("{a} {b} {c} {d} {e} {f} {q} {r}")
    let ((string g, h), i) = ((1, 2), 3)
    println("{g} {h} {i}")
    return 0
