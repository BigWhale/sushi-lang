# EXPECT_ERROR_CODES_EXACT: CW2001, CE2505
# EXPECT_DUMP_SHIR: test_err_typeck_let_of_a_result.shir
#
# A `let` of a `Result` type takes a `Result` parameter. A statement that drops the
# `Result` loses its error: CW2001. A `let` of an `i32` from the same parameter is an
# unhandled `Result`: CE2505 and not CE2002, because CE2505 names the fix.

fn take(Result@(i32, StdError) r) i32:
    let Result@(i32, StdError) kept = r
    kept
    let i32 x = r
    return x

fn main() i32:
    return 0
