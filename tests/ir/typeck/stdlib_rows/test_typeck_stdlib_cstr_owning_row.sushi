# EXPECT_DUMP_SHIR: test_typeck_stdlib_cstr_owning_row.shir
# EXPECT_STDOUT_EXACT: "Mostly Harmless\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
#
# A row of <io/files> is a `Stdlib` callee and its call answers the type of its row. The
# `cstr` parameter of `read_dir` takes a `string` that borrows (`Guaranteed`), and the
# answer `Result@(string[], FileError)` owns: it is a fresh value.
use <io/files>

fn main() i32:
    mkdir("Mostly Harmless", 0o755).realise(-1)
    let string dir = "."
    let string[] names = read_dir(dir).realise(from([]))
    foreach(name in names.iter()):
        println(name)
    rmdir("Mostly Harmless").realise(-1)
    return 0
