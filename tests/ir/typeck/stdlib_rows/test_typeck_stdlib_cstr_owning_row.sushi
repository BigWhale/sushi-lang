# EXPECT_DUMP_SHIR: test_typeck_stdlib_cstr_owning_row.shir
# EXPECT_STDOUT_EXACT: "Mostly Harmless\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
#
# A row of <sys/env> is a `Stdlib` callee and its call answers the type of its row. The
# `cstr` parameter of `getenv` takes a `string` that borrows (`Guaranteed`), and the answer
# `Maybe@(string)` owns: it is a fresh value.
use <sys/env>

fn main() i32:
    setenv("TYPECK_STDLIB_ROW", "Mostly Harmless").realise(-1)
    let string key = "TYPECK_STDLIB_ROW"
    let Maybe@(string) value = getenv(key)
    println(value.realise("none"))
    return 0
