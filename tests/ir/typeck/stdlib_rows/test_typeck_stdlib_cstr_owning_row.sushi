# EXPECT_DUMP_SHIR: test_typeck_stdlib_cstr_owning_row.shir
# EXPECT_STDOUT_EXACT: "127.0.0.1\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
#
# A row of <net/socket> is a `Stdlib` callee and its call answers the type of its row. The
# `cstr` parameter of `sock_dns_resolve` takes a `string` that borrows (`Guaranteed`), and
# the answer `Result@(string[], NetError)` owns: it is a fresh value.
use <net/socket>

fn main() i32:
    let string host = "127.0.0.1"
    let string[] names = sock_dns_resolve(host).realise(from([]))
    foreach(name in names.iter()):
        println(name)
    return 0
