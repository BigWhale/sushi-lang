# EXPECT_ERROR_CODES_EXACT: CE2002
# EXPECT_DUMP_SHIR: test_err_typeck_method_string_return_mismatch.shir
#
# A string method call yields the return type of its row: a string, a number, a bool, a
# Maybe. `upper` is a string, so an i32 binding is a mismatch.

fn main() i32:
    let string s = "Mostly Harmless"
    let string up = s.upper()
    let i32 where = s.count("l")
    let bool empty = s.is_empty()
    let Maybe@(i32) at = s.find("H")
    let string copy = s.clone()
    let i32 bad = s.upper()
    if (empty):
        return up.len() + copy.len()
    if (at.is_some()):
        return 2
    return where + bad
