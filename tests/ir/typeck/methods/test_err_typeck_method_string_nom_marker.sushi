# EXPECT_ERROR_CODES_EXACT: CE2427
# EXPECT_DUMP_SHIR: test_err_typeck_method_string_nom_marker.shir
#
# A string method borrows its arguments. A `nom` marker on one is CE2427, and the
# parameter has the name of its position.

fn main() i32:
    let string s = "Mostly Harmless"
    let string t = "H"
    let bool a = s.contains(nom t)
    if (a):
        return 1
    return 0
