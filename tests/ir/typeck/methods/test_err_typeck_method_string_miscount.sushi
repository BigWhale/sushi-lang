# EXPECT_ERROR_CODES_EXACT: CE2009, CE2009
# EXPECT_DUMP_SHIR: test_err_typeck_method_string_miscount.shir
#
# A string method takes the arguments of its row. A wrong count is CE2009, for a method
# of the table and for an inline method, and the call still yields the type of its row.

fn main() i32:
    let string s = "Mostly Harmless"
    let bool a = s.contains()
    let bool b = s.is_empty(1)
    let i32 n = s.len()
    if (a and b):
        return 1
    return n
