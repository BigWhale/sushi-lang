# EXPECT_ERROR_CODES_EXACT: CE2002
# EXPECT_DUMP_SHIR: test_err_typeck_method_primitive_return_mismatch.shir
#
# A primitive method call yields the return type of its row. `to_bits` on an f64 is a u64,
# so a u32 binding is a mismatch. The call keeps its `Builtin` callee row.

fn main() i32:
    let f64 pi = 3.14
    let u64 whole = pi.to_bits()
    let u32 half = pi.to_bits()
    return (whole as i32) + (half as i32)
