# EXPECT_ERROR_CODES_EXACT: CE0155
# EXPECT_STDERR_CONTAINS: "typecheck, Call(method string array)"
#
# A string method whose row answers a dynamic array (`split`, `to_bytes`) stops the walk
# with `typecheck, Call(method string array)`.

fn main() i32:
    let string s = "Mostly Harmless"
    let string[] parts = s.split(" ")
    return parts.len()
