unit test_err_typeck_call_conventions

ShirBody twice
  params : [(_0 "n": i32, Guaranteed)]
  locals : []
  block  :
    Return(Binary(*, LocalRef(_0), Lit(2)))

ShirBody length
  params : [(_0 "text": string, Owned)]
  locals : []
  block  :
    ExprStmt(Call(Intrinsic("println"), [(LocalRef(_0), Guaranteed)]))
    Return(Lit(1))

ShirBody read
  params : [(_0 "n": i32, InGuaranteed)]
  locals : []
  block  :
    Return(Binary(+, LocalRef(_0), Lit(1)))

ShirBody bump
  params : [(_0 "n": i32, Inout)]
  locals : []
  block  :
    Assign(LocalRef(_0), Binary(+, LocalRef(_0), Lit(1)), is_init: false)

ShirBody main
  params : []
  locals : [_0 "a": i32, _1 "b": i32, _2 "c": i32, _3 "s": string, _4 "d": i32, _5 "t": string, _6 "e": i32]
  block  :
    Assign(LocalRef(_0), Call(Free(@twice), [(Lit(4), Guaranteed)]), is_init: true)
    Assign(LocalRef(_1), Call(Free(@read), [(LocalRef(_0), InGuaranteed)]), is_init: true)
    ExprStmt(Call(Free(@bump), [(LocalRef(_0), Inout)]))
    Assign(LocalRef(_2), Call(Free(@read), [(LocalRef(_0), InGuaranteed)]), is_init: true)
    Assign(LocalRef(_3), Lit("Mostly Harmless"), is_init: true)
    Assign(LocalRef(_4), Call(Free(@length), [(LocalRef(_3), Owned)]), is_init: true)
    Assign(LocalRef(_5), Lit("So long"), is_init: true)
    Assign(LocalRef(_6), Call(Free(@length), [LocalRef(_5)]), is_init: true)
    Return(Binary(+, Binary(+, Binary(+, Binary(+, LocalRef(_0), LocalRef(_1)), LocalRef(_2)), LocalRef(_4)), LocalRef(_6)))
