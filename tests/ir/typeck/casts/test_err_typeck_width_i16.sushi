# EXPECT_ERROR_CODES_EXACT: CE2077
# EXPECT_STDERR_CONTAINS: "operator '+' gives 32768, which is out of range for i16"
# EXPECT_DUMP_SHIR: test_err_typeck_width_i16.shir
#
# A value of the type `i16`: a literal at the type, a cast into the type and out of it, a
# comparison, an operation and a print. A literal under a cast keeps the low bits of the
# type. The compiler reads an operation on two literals at `i16`, and the last one leaves
# the type: CE2077.

fn main() i32:
    let i16 high = 32767
    let i16 low = -32768
    let i16 cut = 40000 as i16
    let i64 wide = high as i64
    let i16 back = wide as i16
    let bool less = low < high
    let i16 mid = high / 2 + low / 2
    let i16 shifted = high >> 4
    println(high)
    println(cut)
    println(back == high)
    println(less)
    println(mid)
    println(shifted)
    let i16 over = 32767 + 1
    println(over)
    return 0
