# EXPECT_ERROR_CODES_EXACT: CE2077
# EXPECT_STDERR_CONTAINS: "operator '+' gives 65536, which is out of range for u16"
# EXPECT_DUMP_SHIR: test_err_typeck_width_u16.shir
#
# A value of the type `u16`: a literal at the type, a cast into the type and out of it, a
# comparison, an operation and a print. A literal under a cast keeps the low bits of the
# type. The compiler reads an operation on two literals at `u16`, and the last one leaves
# the type: CE2077.

fn main() i32:
    let u16 high = 65535
    let u16 low = 0
    let u16 cut = 70000 as u16
    let i64 wide = high as i64
    let u16 back = wide as u16
    let bool less = low < high
    let u16 mid = high / 2 + low / 2
    let u16 shifted = high >> 4
    println(high)
    println(cut)
    println(back == high)
    println(less)
    println(mid)
    println(shifted)
    let u16 over = 65535 + 1
    println(over)
    return 0
