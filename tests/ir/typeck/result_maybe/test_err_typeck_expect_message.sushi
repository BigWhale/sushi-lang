# EXPECT_ERROR_CODES_EXACT: CE2503, CE2503
# EXPECT_STDERR_CONTAINS: "realise() default type mismatch: expected 'string', got 'i32'"
# EXPECT_STDERR_CONTAINS: "realise() default type mismatch: expected 'string', got 'bool'"
# EXPECT_DUMP_SHIR: test_err_typeck_expect_message.shir
#
# The message of `expect` is a string, for a `Result` and for a `Maybe`. A message of
# another type is CE2503 at the message, and the call still yields the payload type.

fn parse(i32 n) i32 | StdError:
    return Result.Ok(n)

fn half(i32 n) Maybe@(i32):
    return Maybe.Some(n / 2)

fn main() i32:
    let i32 a = parse(3).expect(42)
    let i32 b = half(4).expect(false)
    let i32 c = half(6).expect("Mostly Harmless")
    return a + b + c
