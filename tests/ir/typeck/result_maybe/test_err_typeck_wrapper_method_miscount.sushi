# EXPECT_ERROR_CODES_EXACT: CE2009, CE2009, CE2009
# EXPECT_DUMP_SHIR: test_err_typeck_wrapper_method_miscount.shir
#
# A method of `Result@(T, E)` or `Maybe@(T)` takes the arguments of its row. A wrong count
# is CE2009 and skips the argument types, and the call still yields the type of its row.

fn parse(i32 n) i32 | StdError:
    return Result.Ok(n)

fn half(i32 n) Maybe@(i32):
    return Maybe.Some(n / 2)

fn main() i32:
    let bool ok = parse(1).is_ok(2)
    let i32 a = half(4).realise()
    let i32 b = parse(5).expect("Mostly", "Harmless")
    if (ok):
        return a + b
    return 0
