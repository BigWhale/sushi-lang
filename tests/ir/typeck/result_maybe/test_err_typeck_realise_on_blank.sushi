# EXPECT_ERROR_CODES_EXACT: CE2506, CE2506, CE2506, CE2002
# EXPECT_STDERR_CONTAINS: "cannot call .realise() on 'Result@(~, StdError)'"
# EXPECT_STDERR_CONTAINS: "cannot call .realise() on 'Maybe@(~)'"
# EXPECT_STDERR_CONTAINS: "cannot assign ~ to i32"
# EXPECT_DUMP_SHIR: test_err_typeck_realise_on_blank.shir
#
# A `~` payload has no value to extract, so `realise` on a `Result@(~, E)` or on a
# `Maybe@(~)` is CE2506 at the call. The default is not checked. The call still yields
# `~`, so a binding of another type is a mismatch too.

fn step() ~ | StdError:
    return Result.Ok(~)

fn main() i32:
    let Maybe@(~) m = Maybe.Some(~)
    step().realise(~)
    m.realise(~)
    let i32 x = step().realise(0)
    return x
