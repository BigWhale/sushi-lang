# EXPECT_ERROR_CODES_EXACT: CE2009
# EXPECT_STDERR_CONTAINS: "'Vec.at' expects 2, got 1"
# EXPECT_DUMP_SHIR: test_err_typeck_static_miscount.shir
#
# A call on a type name that names a static of the type is a `Static` callee, with the
# written name of the method. Its arguments go through the one argument check: a wrong
# count is CE2009 at the call, and the call still yields the return type of the static.

struct Vec:
    i32 x
    i32 y

extend Vec static at(i32 x, i32 y) Vec:
    return Vec(x, y)

fn main() i32:
    let Vec v = Vec.at(3)
    return v.x
