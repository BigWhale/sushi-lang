# EXPECT_ERROR_CODES_EXACT: CE2002
# EXPECT_STDERR_CONTAINS: "type mismatch: cannot assign poke string to string."
# EXPECT_STDERR_CONTAINS: "  |     println((poke s, 1).1)\n  `              ---+--\n"
# EXPECT_DUMP_SHIR: test_err_typeck_tuple_poke_part_no_type.shir
#
# Ruling R-I, where the position gives the tuple no type: the element type is the type
# of the borrowed place, so a `poke` part is CE2002 at the part too.

fn main() i32:
    let string s = "Mostly Harmless"
    println((poke s, 1).1)
    return 0
