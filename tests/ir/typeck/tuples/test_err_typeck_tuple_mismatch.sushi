# EXPECT_ERROR_CODES_EXACT: CE2002
# EXPECT_STDERR_CONTAINS: "type mismatch: cannot assign (i32, i32) to (string, i32)."
# EXPECT_STDERR_CONTAINS: "  |     let (string, i32) w = (1, 1)\n  `                           ---+--\n"
# EXPECT_STDERR_CONTAINS: "= note: declared here"
# EXPECT_DUMP_SHIR: test_err_typeck_tuple_mismatch.shir
#
# A tuple literal checks each part at the element type of its position, so a literal
# takes the type of its element (`i64`), also in a nested tuple. It answers the tuple of
# its part types, and `.N` reads an element. A tuple that does not fit its position is
# CE2002 at the whole tuple.

fn main() i32:
    let (i64, i32) t = (1, 2)
    let (i32, (bool, string)) u = (1, (true, "Mostly Harmless"))
    let bool c = u.1.0
    println("{t.0} {c} {u.1.1}")
    let (string, i32) w = (1, 1)
    println(w.1)
    return 0
