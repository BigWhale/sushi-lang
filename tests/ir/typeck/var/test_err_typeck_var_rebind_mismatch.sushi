# EXPECT_ERROR_CODES_EXACT: CE2002
# EXPECT_STDERR_CONTAINS: "cannot assign bool to i32"
# EXPECT_DUMP_SHIR: test_err_typeck_var_rebind_mismatch.shir
#
# A name of a `var` is a `StorageRef`, and the typecheck pass gives it the declared type of
# the `var`. A read, a rebind and a field write of a `var` are checked as the same positions
# of a local are. The last rebind gives a `bool` to an `i32`, which is CE2002.

struct Point:
    i32 x
    i32 y

var i32 counter = 0
var Point origin = Point(1, 2)

fn main() i32:
    counter := counter + origin.y
    origin.x := counter
    counter := true
    return 0
