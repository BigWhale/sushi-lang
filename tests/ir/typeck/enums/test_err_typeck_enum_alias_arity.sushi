# EXPECT_ERROR_CODES_EXACT: CE2050
# EXPECT_STDERR_CONTAINS: "enum variant 'Turn' expects 2 argument(s), got 1"
# EXPECT_DUMP_SHIR: test_err_typeck_enum_alias_arity.shir
#
# A variant behind an alias takes the payload count of its declaration: one argument
# where the variant holds two is CE2050.

use "units/compass" as cp

fn pick(cp.Heading h) cp.Heading:
    return h

fn main() i32:
    pick(cp.Heading.Turn(1))
    return 0
