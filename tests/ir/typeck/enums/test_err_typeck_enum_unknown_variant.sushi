# EXPECT_ERROR_CODES_EXACT: CE2045
# EXPECT_STDERR_CONTAINS: "enum variant 'Blink' not found in enum 'Light'"
# EXPECT_DUMP_SHIR: test_err_typeck_enum_unknown_variant.shir
#
# A name behind an enum's dot that is no variant is a `Static` call. When no unit
# declares a method of that name, the enum's dot holds no such member: CE2045.

enum Light:
    Red
    Green

fn shade(Light l) Light:
    return l

fn main() i32:
    shade(Light.Green())
    shade(Light.Blink(1))
    return 0
