# EXPECT_ERROR_CODES_EXACT: CE2074, CE2074
# EXPECT_DUMP_SHIR: test_err_typeck_match_not_covered_ends_no_path.shir
#
# A match whose arms miss a value is CE2074. The arm that the author adds decides the
# path, so the match does not end the path: the statement after it is not dead (no
# CE0140). As the last statement of a body that answers a value, it gives no CE0107.

fn first(i32 n) i32:
    match n:
        1 -> return 1
    return 0

fn last(i32 n) i32:
    match n:
        1 -> return 1

fn main() i32:
    return first(1) + last(1)
