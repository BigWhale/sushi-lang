unit test_err_typeck_dead_statement

ShirBody half
  params : [(_0 "n": i32, Guaranteed)]
  locals : []
  block  :
    If(Binary(==, Binary(%, LocalRef(_0), Lit(2)), Lit(1)), then: [Return(adopt EnumInit(@Result, "Err", [adopt EnumInit(@StdError, "Error", [])]))], otherwise: [Return(adopt EnumInit(@Result, "Ok", [adopt Binary(/, LocalRef(_0), Lit(2))]))])
    ExprStmt(Call(Intrinsic("println"), [(LocalRef(_0), Guaranteed)]))

ShirBody show
  params : [(_0 "n": i32, Guaranteed)]
  locals : []
  block  :
    ExprStmt(Call(Intrinsic("println"), [(Try(adopt Call(Free(@half), [(LocalRef(_0), Guaranteed)])), Guaranteed)]))
    Return(adopt EnumInit(@Result, "Ok", [adopt Lit(Blank)]))

ShirBody main
  params : []
  locals : []
  block  :
    ExprStmt(Call(Free(@show), [(Lit(8), Guaranteed)]))
    Return(adopt Lit(0))
