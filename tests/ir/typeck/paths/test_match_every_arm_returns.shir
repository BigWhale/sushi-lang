  params : [(_0 "n": i32, Guaranteed)]
  locals : []
  block  :
    Match(LocalRef(_0), [Arm(Literal(0), [Return(Lit("zero"))]), Arm(IntRange(1, 9, inclusive: true), [Return(Lit("small"))]), Arm(Wildcard, [Return(Lit("other"))])], consumes: false)

