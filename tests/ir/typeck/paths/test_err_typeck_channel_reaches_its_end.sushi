# EXPECT_ERROR_CODES_EXACT: CE0107
# EXPECT_DUMP_SHIR: test_err_typeck_channel_reaches_its_end.shir
#
# A `~` body with a channel ends with `return Result.Ok(~)`: a path that reaches the end
# of the body is CE0107. A bare `~` body may end.

fn half(i32 n) i32 | StdError:
    if (n % 2 == 1):
        return Result.Err(StdError.Error)
    return Result.Ok(n / 2)

fn say(i32 n) ~:
    println(n)

fn show(i32 n) ~ | StdError:
    say(n)
    println(half(n)??)

fn main() i32:
    show(8)
    return 0
