# EXPECT_ERROR_CODES_EXACT: CE2118, CE2118
# EXPECT_STDERR_CONTAINS: "unreachable match arm 'Shape.Circle(0)': the arms above it match every value it matches"
# EXPECT_STDERR_CONTAINS: "the arm 'Shape.Circle(r)' matches these values first"
# EXPECT_STDERR_CONTAINS: "unreachable match arm 'Maybe.Some(Shape.Square(_))': the arms above it match every value it matches"
# EXPECT_STDERR_CONTAINS: "the alternative 'Maybe.Some(_)' matches these values first"
# EXPECT_DUMP_SHIR: test_err_typeck_match_enum_dead_arm.shir
#
# An arm that the arms above match all of can never run: CE2118, with a note at each arm
# above that matches its values first. An alternative that the alternatives before it
# match all of is CE2118 too. The notes quote the patterns as they are written.

enum Shape:
    Circle(i32)
    Square(i32)

fn covered(Shape s) i32:
    match s:
        Shape.Circle(r) -> return r
        Shape.Square(_) -> return 0
        Shape.Circle(0) -> return 1

fn alternative(Maybe@(Shape) m) i32:
    match m:
        Maybe.Some(_) | Maybe.Some(Shape.Square(_)) -> return 1
        _ -> return 0

fn main() i32:
    return covered(Shape.Circle(2)) + alternative(Maybe.None)
