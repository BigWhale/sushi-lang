# EXPECT_ERROR_CODES_EXACT: CE2400
# EXPECT_STDERR_CONTAINS: "cannot borrow 'TONE' with `poke`"
# EXPECT_STDERR_CONTAINS: "cannot borrow 'TONE' with `poke`"
# EXPECT_STDERR_CONTAINS: "a constant is read-only storage: `peek` reads it, and `poke` writes it; declare a `var` for storage that you can write"
# EXPECT_DUMP_SHIR: test_err_typeck_match_enum_poke_constant.shir
#
# A `poke` binding points into the payload of the scrutinee. A constant is read-only
# storage, so a `poke` binding into it is CE2400. A `peek` binding reads it, and is legal.

enum Shade:
    Dim(i32)
    Bright(i32)

const Shade TONE = Shade.Dim(2)

fn read() i32:
    match TONE:
        Shade.Dim(peek r) -> return r
        Shade.Bright(_) -> return 0

fn write() i32:
    match TONE:
        Shade.Dim(poke r) -> return r
        Shade.Bright(_) -> return 0

fn main() i32:
    return read() + write()
