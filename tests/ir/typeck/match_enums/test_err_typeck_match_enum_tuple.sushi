# EXPECT_ERROR_CODES_EXACT: CE2120
# EXPECT_STDERR_CONTAINS: "the destructure names 3 elements, but '(i32, string)' has 2"
# EXPECT_DUMP_SHIR: test_err_typeck_match_enum_tuple.shir
#
# A tuple pattern in a payload position has one item for each element of the tuple:
# CE2120 when the count differs. The tuple pattern that fits gives its binders their types.

fn first(Maybe@((i32, string)) m) i32:
    match m:
        Maybe.Some((n, _)) -> return n
        Maybe.None -> return 0

fn wrong(Maybe@((i32, string)) m) i32:
    match m:
        Maybe.Some((n, _, _)) -> return n
        Maybe.None -> return 0

fn main() i32:
    return first(Maybe.None) + wrong(Maybe.None)
