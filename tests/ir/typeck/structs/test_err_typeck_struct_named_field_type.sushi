# EXPECT_ERROR_CODES_EXACT: CE2083
# EXPECT_STDERR_CONTAINS: "field 'y' expects type 'i32', got 'bool'"
# EXPECT_STDERR_CONTAINS: "  |     keep(Point(y: true, x: 1))\n  `                   --+-\n"
# EXPECT_DUMP_SHIR: test_err_typeck_struct_named_field_type.shir
#
# A named construction checks each field at the type of the field that it names. A value
# that does not fit is CE2083 at the value. The fields are in the declaration order, and
# `written_order` keeps the order that the source writes.

struct Point:
    i32 x
    i32 y

fn keep(Point p) Point:
    return p

fn main() i32:
    keep(Point(y: true, x: 1))
    return 0
