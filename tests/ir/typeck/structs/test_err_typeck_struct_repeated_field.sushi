# EXPECT_ERROR_CODES_EXACT: CE2081
# EXPECT_STDERR_CONTAINS: "duplicate field 'x' in struct constructor"
# EXPECT_STDERR_CONTAINS: "  |     keep(Point(x: 1, y: 2, x: 3))\n  `          --+--\n"
# EXPECT_DUMP_SHIR: test_err_typeck_struct_repeated_field.shir
#
# A named construction that names one field two times is CE2081 at the written type.

struct Point:
    i32 x
    i32 y

fn keep(Point p) Point:
    return p

fn main() i32:
    keep(Point(x: 1, y: 2, x: 3))
    return 0
