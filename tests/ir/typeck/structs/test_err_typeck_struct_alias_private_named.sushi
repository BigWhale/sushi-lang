# EXPECT_ERROR_CODES_EXACT: CE3005, CE6104
# EXPECT_STDERR_CONTAINS: "cannot use private struct 'Hidden'"
# EXPECT_STDERR_CONTAINS: "the named argument 'n:' is only supported in a struct construction"
# EXPECT_DUMP_SHIR: test_err_typeck_struct_alias_private_named.shir
#
# A named construction of a private struct of another unit behind an alias is CE3005,
# then CE6104 at the construction, as the old pipeline reports it.

use "units/plane" as pl

fn main() i32:
    pl.Hidden(n: true)
    return 0
