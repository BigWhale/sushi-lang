# EXPECT_ERROR_CODES_EXACT: CE2080
# EXPECT_STDERR_CONTAINS: "unknown field 'z' for struct 'Point'"
# EXPECT_STDERR_CONTAINS: "  |     keep(Point(x: 1, z: 2))\n  `          --+--\n"
# EXPECT_DUMP_SHIR: test_err_typeck_struct_unknown_field.shir
#
# A named construction with a name that the struct does not declare is CE2080 at the
# written type. Lowering keeps the written names.

struct Point:
    i32 x
    i32 y

fn keep(Point p) Point:
    return p

fn main() i32:
    keep(Point(x: 1, z: 2))
    return 0
