# EXPECT_ERROR_CODES_EXACT: CE6102
# EXPECT_STDERR_CONTAINS: "explicit type arguments are only supported on direct function calls"
# EXPECT_STDERR_CONTAINS: "  |     keep(Pair@(i32, i32)(1, 2))\n  `          ----------+----------\n"
# EXPECT_DUMP_SHIR: test_err_typeck_struct_type_args.shir
#
# A struct construction takes no written type arguments. `Pair@(i32, i32)(1, 2)` is an
# error hole, and the typecheck pass reports CE6102 at it. The old pipeline compiled this
# program with no error.

struct Pair@(T, U):
    T first
    U second

fn keep(Pair@(i32, i32) p) Pair@(i32, i32):
    return p

fn main() i32:
    keep(Pair@(i32, i32)(1, 2))
    return 0
