# EXPECT_ERROR_CODES_EXACT: CE2008
# EXPECT_STDERR_CONTAINS: "undefined function 'Sign'"
# EXPECT_STDERR_CONTAINS: "  |     Sign(1)\n  `     --+-\n"
# EXPECT_DUMP_SHIR: test_err_typeck_struct_not_a_struct.shir
#
# A positional construction on a type name that is no struct is a `StructInit` as
# written. The typecheck pass refuses it with CE2008 at the type name.

enum Sign:
    Plus
    Minus

fn main() i32:
    Sign(1)
    return 0
