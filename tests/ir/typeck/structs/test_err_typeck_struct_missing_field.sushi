# EXPECT_ERROR_CODES_EXACT: CE2082
# EXPECT_STDERR_CONTAINS: "missing required field(s) 'y' for struct 'Point'"
# EXPECT_STDERR_CONTAINS: "  |     keep(Point(x: 1))\n  `          --+--\n"
# EXPECT_DUMP_SHIR: test_err_typeck_struct_missing_field.shir
#
# A named construction that does not name each field is CE2082 at the written type.

struct Point:
    i32 x
    i32 y

fn keep(Point p) Point:
    return p

fn main() i32:
    keep(Point(x: 1))
    return 0
