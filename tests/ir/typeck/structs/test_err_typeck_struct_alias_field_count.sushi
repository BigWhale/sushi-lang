# EXPECT_ERROR_CODES_EXACT: CE2027
# EXPECT_STDERR_CONTAINS: "struct 'Vec' expects 2 field(s), got 1"
# EXPECT_STDERR_CONTAINS: "  |     keep(pl.Vec(1))\n  `          ----+----\n"
# EXPECT_DUMP_SHIR: test_err_typeck_struct_alias_field_count.shir
#
# A wrong count of fields behind an alias is CE2027. Behind an alias, the caret covers
# the whole construction.

use "units/plane" as pl

fn keep(pl.Vec v) pl.Vec:
    return v

fn main() i32:
    keep(pl.Vec(1))
    return 0
