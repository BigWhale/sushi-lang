unit test_err_borrow_two_pokes_of_fields

ShirBody swap
  params : [(_0 "a": i32, Inout), (_1 "b": i32, Inout)]
  locals : [_2 "t": i32]
  block  :
    Assign(LocalRef(_2), adopt LocalRef(_0), is_init: true)
    Assign(LocalRef(_0), adopt LocalRef(_1), is_init: false)
    Assign(LocalRef(_1), adopt LocalRef(_2), is_init: false)

ShirBody main
  params : []
  locals : [_0 "p": Point, _1 "q": Point]
  block  :
    Assign(LocalRef(_0), adopt StructInit(@Point, [adopt Lit(1), adopt Lit(2)], written_order: [0, 1]), is_init: true)
    Assign(LocalRef(_1), adopt StructInit(@Point, [adopt Lit(3), adopt Lit(4)], written_order: [0, 1]), is_init: true)
    ExprStmt(Call(Free(@swap), [(Field(LocalRef(_0), "x"), Inout), (Field(LocalRef(_1), "y"), Inout)]))
    ExprStmt(Call(Free(@swap), [(Field(LocalRef(_0), "x"), Inout), (Field(LocalRef(_0), "y"), Inout)]))
    Return(adopt Field(LocalRef(_0), "x"))
