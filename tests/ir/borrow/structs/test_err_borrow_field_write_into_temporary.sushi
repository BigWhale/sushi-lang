# EXPECT_ERROR_CODES_EXACT: CE2429
# EXPECT_STDERR_CONTAINS: "cannot write through an unbound chained borrow."
# EXPECT_STDERR_CONTAINS: "the value past this expression is a temporary copy, not the owner's storage"
# EXPECT_STDERR_CONTAINS: ":19:5"
# EXPECT_DUMP_SHIR: test_err_borrow_field_write_into_temporary.shir
#
# A field of a call result is a field of a temporary copy. A read of it is legal, and a
# write of it is CE2429 at the statement, with a note at the call.

struct Point:
    i32 x
    i32 y

fn make() Point:
    return Point(1, 2)

fn main() i32:
    println(make().y)
    make().x := 1
    return 0
