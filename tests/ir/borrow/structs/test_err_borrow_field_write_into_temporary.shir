unit test_err_borrow_field_write_into_temporary

ShirBody make
  params : []
  locals : []
  block  :
    Return(adopt StructInit(@Point, [adopt Lit(1), adopt Lit(2)], written_order: [0, 1]))

ShirBody main
  params : []
  locals : []
  block  :
    ExprStmt(Call(Intrinsic("println"), [(Field(Call(Free(@make), []), "y"), Guaranteed)]))
    Assign(Field(Call(Free(@make), []), "x"), adopt Lit(1), is_init: false)
    Return(adopt Lit(0))
