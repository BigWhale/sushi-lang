unit test_err_borrow_consume_an_owning_field

ShirBody show
  params : [(_0 "s": string, Guaranteed)]
  locals : []
  block  :
    ExprStmt(Call(Intrinsic("println"), [(LocalRef(_0), Guaranteed)]))

ShirBody name_of
