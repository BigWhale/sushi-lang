unit test_err_borrow_destructure_plain_values

ShirBody pair
  params : []
  locals : []
  block  :
    Return(adopt TupleInit([adopt Lit(1), adopt Lit(2)]))

ShirBody sum
  params : [(_0 "t": (i32, i32), Guaranteed)]
  locals : [_2 "a": i32, _3 "b": i32, _5 "c": i32, _6 "d": i32]
  block  :
    Destructure([_2, _3], adopt LocalRef(_0))
    Assign(LocalRef(_2), adopt Binary(+, LocalRef(_2), Lit(1)), is_init: false)
    Destructure([[_5, _], _6], adopt TupleInit([adopt TupleInit([adopt LocalRef(_2), adopt LocalRef(_3)]), adopt Lit(3)]))
    Return(adopt Binary(+, Binary(+, Binary(+, LocalRef(_2), LocalRef(_3)), LocalRef(_5)), LocalRef(_6)))

ShirBody swap
  params : [(_0 "a": i32, Guaranteed)]
  locals : [_1 "b": i32, _5 "p": Point]
  block  :
    Assign(LocalRef(_1), adopt Lit(2), is_init: true)
    Destructure([Place(LocalRef(_0)), Place(LocalRef(_1))], adopt TupleInit([adopt LocalRef(_1), adopt LocalRef(_0)]))
    Assign(LocalRef(_5), adopt StructInit(@Point, [adopt Lit(1), adopt Lit(2)], written_order: [0, 1]), is_init: true)
    Destructure([Place(Field(LocalRef(_5), "x")), Place(LocalRef(_1))], adopt Call(Free(@pair), []))
    Destructure([[Place(Field(LocalRef(_5), "y")), Place(LocalRef(_0))], Place(LocalRef(_1))], adopt TupleInit([adopt TupleInit([adopt LocalRef(_1), adopt Field(LocalRef(_5), "x")]), adopt LocalRef(_0)]))
    Return(adopt Binary(+, Binary(+, LocalRef(_0), LocalRef(_1)), Field(LocalRef(_5), "x")))

ShirBody shift
  params : [(_0 "p": Point, Inout)]
  locals : [_1 "b": i32]
  block  :
    Assign(LocalRef(_1), adopt Lit(0), is_init: true)
    Destructure([Place(Field(LocalRef(_0), "x")), Place(LocalRef(_1))], adopt TupleInit([adopt Field(LocalRef(_0), "y"), adopt Field(LocalRef(_0), "x")]))
    ExprStmt(Call(Intrinsic("println"), [(LocalRef(_1), Guaranteed)]))

ShirBody set
  params : [(_0 "p": Point, InGuaranteed)]
  locals : [_1 "b": i32]
  block  :
    Assign(LocalRef(_1), adopt Lit(0), is_init: true)
    Destructure([Place(Field(LocalRef(_0), "x")), Place(LocalRef(_1))], adopt TupleInit([adopt Lit(1), adopt Lit(2)]))
    ExprStmt(Call(Intrinsic("println"), [(LocalRef(_1), Guaranteed)]))

ShirBody main
  params : []
  locals : [_0 "p": Point]
  block  :
    Assign(LocalRef(_0), adopt StructInit(@Point, [adopt Lit(1), adopt Lit(2)], written_order: [0, 1]), is_init: true)
    ExprStmt(Call(Free(@shift), [(LocalRef(_0), Inout)]))
    ExprStmt(Call(Free(@set), [(LocalRef(_0), InGuaranteed)]))
    Return(adopt Binary(+, Call(Free(@sum), [(Call(Free(@pair), []), Guaranteed)]), Call(Free(@swap), [(Lit(1), Guaranteed)])))
