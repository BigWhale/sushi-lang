    Assign(LocalRef(_0), adopt Binary(+, Binary(+, Call(Free(@first), [(Call(Free(@pair), [(Lit(1), Guaranteed)]), Guaranteed)]), Call(Free(@both), [(Lit(2), Guaranteed), (Lit(3), Guaranteed)])), Call(Free(@inner), [(EnumInit(@Maybe, "Some", [adopt TupleInit([adopt Lit(1), adopt Lit(2)])]), Guaranteed)])), is_init: true)
    Return(adopt Binary(+, Binary(+, Binary(+, LocalRef(_0), Call(Free(@outer), [(TupleInit([adopt EnumInit(@Maybe, "Some", [adopt Lit(1)]), adopt Lit(2)]), Guaranteed)])), Call(Free(@taken), [(Lit(3), Guaranteed)])), Call(Free(@pick), [(TupleInit([adopt Lit(1), adopt Lit(2)]), Guaranteed)])))
