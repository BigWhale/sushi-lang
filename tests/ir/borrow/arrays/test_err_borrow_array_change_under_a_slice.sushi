# EXPECT_ERROR_CODES_EXACT: CE2412
# EXPECT_STDERR_CONTAINS: "cannot mutate 'a' while 'view' borrows from it"
# EXPECT_STDERR_CONTAINS: "'view' borrows from 'a' here"
# EXPECT_STDERR_CONTAINS: "'view' is used here, after the change"
# EXPECT_DUMP_SHIR: test_err_borrow_array_change_under_a_slice.shir
#
# An element read and a plain element write copy a value. A slot of `push` and of
# `insert` takes its value by position. A `let` of a slice is a let-borrow of the array:
# a method that changes the array invalidates it, and a read after the change is CE2412.

fn main() i32:
    let i32[] a = from([1, 2, 3])
    let i32 first = a[0]
    a[1] := first + 1
    a.push(first)
    let bool put = a.insert(0, a[2]).is_ok()
    let i32[] view = a[0..2]
    println(view[0])
    a.push(4)
    if (put):
        println(view[1])
    return a.len() as i32
