unit test_err_borrow_var_copy_and_take

ShirBody counter (Initializer)
  params : []
  locals : []
  block  :
    Return(adopt Lit(5))

ShirBody table (Initializer)
  params : []
  locals : []
  block  :
    Return(adopt ArrayInit(Dynamic, []))

ShirBody twice
  params : [(_0 "n": i32, Guaranteed)]
  locals : []
  block  :
    Return(adopt Binary(*, LocalRef(_0), Lit(2)))

ShirBody main
  params : []
  locals : [_0 "copy": i32, _1 "more": i32, _2 "mine": i32[]]
  block  :
    Assign(LocalRef(_0), adopt StorageRef(@counter), is_init: true)
    Assign(LocalRef(_1), adopt Call(Free(@twice), [(StorageRef(@counter), Guaranteed)]), is_init: true)
    Assign(LocalRef(_2), move StorageRef(@table), is_init: true)
    Return(adopt Binary(+, Binary(+, LocalRef(_0), LocalRef(_1)), Cast(adopt Call(Builtin(LocalRef(_2), "len"), []), i32)))
