# EXPECT_ERROR_CODES_EXACT: CE2408
# EXPECT_STDERR_CONTAINS: "cannot modify 'n' through peek reference (read-only)"
# EXPECT_DUMP_SHIR: test_err_borrow_poke_of_a_peek.shir
#
# A `poke` argument for a `peek` parameter is a safe downgrade: its convention is the
# `InGuaranteed` of the parameter. The written `poke` still asks for a borrow that can
# write, and the borrow pass checks the borrow as it is written: a `poke` of a local that
# can write is legal, and a `poke` of a `peek` parameter is a write through a read-only
# reference, CE2408.

fn read(peek i32 n) i32:
    return n + 1

fn pass_on(peek i32 n) i32:
    return read(poke n)

fn main() i32:
    let i32 a = 1
    let i32 b = read(poke a)
    return pass_on(peek b)
