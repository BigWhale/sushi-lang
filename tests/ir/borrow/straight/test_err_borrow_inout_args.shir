unit test_err_borrow_inout_args

ShirBody START (Initializer)
  params : []
  locals : []
  block  :
    Return(adopt Lit(40))

ShirBody grow
  params : [(_0 "text": string, Inout)]
  locals : []
  block  :
    Assign(LocalRef(_0), adopt Interp(["", LocalRef(_0), "!"]), is_init: false)

ShirBody add
  params : [(_0 "into": i32, Inout), (_1 "extra": i32, Inout)]
  locals : []
  block  :
    Assign(LocalRef(_0), adopt Binary(+, LocalRef(_0), LocalRef(_1)), is_init: false)

ShirBody main
  params : []
  locals : [_0 "text": string, _1 "total": i32, _2 "more": i32]
  block  :
    Assign(LocalRef(_0), adopt Interp(["", Lit(2), " towels"]), is_init: true)
    ExprStmt(Call(Free(@grow), [(LocalRef(_0), Inout)]))
    ExprStmt(Call(Intrinsic("println"), [(LocalRef(_0), Guaranteed)]))
    Assign(LocalRef(_1), adopt ConstRef(@START), is_init: true)
    Assign(LocalRef(_2), adopt Lit(2), is_init: true)
    ExprStmt(Call(Free(@add), [(LocalRef(_1), Inout), (LocalRef(_2), Inout)]))
    ExprStmt(Call(Free(@add), [(LocalRef(_1), Inout), (LocalRef(_1), Inout)]))
    Return(adopt LocalRef(_1))
