unit test_err_borrow_move_before_a_rebind

ShirBody eat
  params : [(_0 "text": string, Owned)]
  locals : []
  block  :
    ExprStmt(Call(Intrinsic("println"), [(LocalRef(_0), Guaranteed)]))

ShirBody make
  params : [(_0 "n": i32, Guaranteed)]
  locals : []
  block  :
    Return(adopt Interp(["", LocalRef(_0), " towels"]))

ShirBody refill
  params : [(_0 "n": i32, Guaranteed)]
  locals : [_1 "s": string]
  cond_moved : [_1]
  block  :
    Assign(LocalRef(_1), adopt Call(Free(@make), [(LocalRef(_0), Guaranteed)]), is_init: true)
    If(Binary(>, LocalRef(_0), Lit(0)), then: [ExprStmt(Call(Free(@eat), [(move LocalRef(_1), Owned)]))])
    Assign(LocalRef(_1), adopt Call(Free(@make), [(Lit(2), Guaranteed)]), is_init: false)
    ExprStmt(Call(Free(@eat), [(move LocalRef(_1), Owned)]))
    Return(adopt Lit(0))

ShirBody reuse
  params : [(_0 "n": i32, Guaranteed)]
  locals : [_1 "s": string]
  block  :
    Assign(LocalRef(_1), adopt Call(Free(@make), [(LocalRef(_0), Guaranteed)]), is_init: true)
    If(Binary(>, LocalRef(_0), Lit(0)), then: [ExprStmt(Call(Free(@eat), [(move LocalRef(_1), Owned)]))])
    Assign(LocalRef(_1), adopt Call(Free(@make), [(Lit(3), Guaranteed)]), is_init: false)
    ExprStmt(Call(Free(@eat), [(move LocalRef(_1), Owned)]))
    ExprStmt(Call(Intrinsic("println"), [(LocalRef(_1), Guaranteed)]))

ShirBody main
  params : []
  locals : []
  block  :
    ExprStmt(Call(Free(@refill), [(Lit(1), Guaranteed)]))
    ExprStmt(Call(Free(@reuse), [(Lit(0), Guaranteed)]))
    Return(adopt Lit(0))
