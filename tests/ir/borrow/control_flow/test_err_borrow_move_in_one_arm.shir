unit test_err_borrow_move_in_one_arm

ShirBody eat
  params : [(_0 "text": string, Owned)]
  locals : []
  block  :
    ExprStmt(Call(Intrinsic("println"), [(LocalRef(_0), Guaranteed)]))

ShirBody maybe
  params : [(_0 "give": bool, Guaranteed)]
  locals : [_1 "msg": string]
  cond_moved : [_1]
  block  :
    Assign(LocalRef(_1), adopt Interp(["", Lit(1), " towels"]), is_init: true)
    If(LocalRef(_0), then: [ExprStmt(Call(Free(@eat), [(move LocalRef(_1), Owned)]))])
    ExprStmt(Call(Intrinsic("println"), [(Lit("done"), Guaranteed)]))

ShirBody pick
  params : [(_0 "n": i32, Guaranteed)]
  locals : [_1 "msg": string]
  cond_moved : [_1]
  block  :
    Assign(LocalRef(_1), adopt Interp(["", Lit(2), " towels"]), is_init: true)
    If(Binary(==, LocalRef(_0), Lit(0)), then: [ExprStmt(Call(Free(@eat), [(move LocalRef(_1), Owned)]))], otherwise: [If(Binary(==, LocalRef(_0), Lit(1)), then: [ExprStmt(Call(Intrinsic("println"), [(Lit("kept"), Guaranteed)]))], otherwise: [ExprStmt(Call(Free(@eat), [(move LocalRef(_1), Owned)]))])])

ShirBody reuse
  params : [(_0 "give": bool, Guaranteed)]
  locals : [_1 "msg": string]
  block  :
    Assign(LocalRef(_1), adopt Interp(["", Lit(3), " towels"]), is_init: true)
    If(LocalRef(_0), then: [ExprStmt(Call(Free(@eat), [(move LocalRef(_1), Owned)]))])
    ExprStmt(Call(Intrinsic("println"), [(LocalRef(_1), Guaranteed)]))

ShirBody main
  params : []
  locals : []
  block  :
    ExprStmt(Call(Free(@maybe), [(Lit(true), Guaranteed)]))
    ExprStmt(Call(Free(@pick), [(Lit(1), Guaranteed)]))
    ExprStmt(Call(Free(@reuse), [(Lit(false), Guaranteed)]))
    Return(adopt Lit(0))
