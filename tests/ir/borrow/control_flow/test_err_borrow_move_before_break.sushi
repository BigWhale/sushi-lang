# EXPECT_ERROR_CODES_EXACT: CE2405
# EXPECT_STDERR_CONTAINS: "cannot borrow moved variable 'msg'"
# EXPECT_DUMP_SHIR: test_err_borrow_move_before_break.shir
#
# A move in the body of a `while` before a `break` leaves the loop with the local moved
# on that path only: the loop can also end when its condition is false. `drain` finishes
# with no error, and `msg` is in the row of the conditionally moved locals. `line` is
# declared in the body and moved on each round, so it has no row. A move in the body with
# no `break` reaches the next round over the back edge: the move of `again` is a use
# after a move on its second round, CE2405.

fn eat(nom string text) ~:
    println(text)

fn drain(i32 n) ~:
    let string msg = "{n} towels"
    let i32 i = 0
    while (i < n):
        let string line = "{i}"
        eat(nom line)
        if (i == 2):
            eat(nom msg)
            break
        i := i + 1
    println("done")

fn again(i32 n) ~:
    let string msg = "{n} towels"
    let i32 i = 0
    while (i < n):
        eat(nom msg)
        i := i + 1

fn main() i32:
    drain(4)
    again(1)
    return 0
