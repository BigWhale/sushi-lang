unit test_err_borrow_continue_before_move

ShirBody eat
  params : [(_0 "text": string, Owned)]
  locals : []
  block  :
    ExprStmt(Call(Intrinsic("println"), [(LocalRef(_0), Guaranteed)]))

ShirBody skip
  params : [(_0 "n": i32, Guaranteed)]
  locals : [_1 "i": i32, _2 "line": string]
  cond_moved : [_2]
  block  :
    Assign(LocalRef(_1), adopt Lit(0), is_init: true)
    Loop(Cond(Binary(<, LocalRef(_1), LocalRef(_0))), [Assign(LocalRef(_2), adopt Interp(["", LocalRef(_1), ""]), is_init: true), Assign(LocalRef(_1), adopt Binary(+, LocalRef(_1), Lit(1)), is_init: false), If(Binary(==, LocalRef(_1), Lit(2)), then: [Continue]), ExprStmt(Call(Free(@eat), [(move LocalRef(_2), Owned)]))])

ShirBody last
  params : [(_0 "n": i32, Guaranteed)]
  locals : [_1 "msg": string, _2 "i": i32]
  block  :
    Assign(LocalRef(_1), adopt Interp(["", LocalRef(_0), " towels"]), is_init: true)
    Assign(LocalRef(_2), adopt Lit(0), is_init: true)
    Loop(Cond(Binary(<, LocalRef(_2), LocalRef(_0))), [Assign(LocalRef(_2), adopt Binary(+, LocalRef(_2), Lit(1)), is_init: false), If(Binary(<, LocalRef(_2), Lit(2)), then: [Continue]), ExprStmt(Call(Free(@eat), [(move LocalRef(_1), Owned)])), Break])
    ExprStmt(Call(Intrinsic("println"), [(LocalRef(_1), Guaranteed)]))

ShirBody main
  params : []
  locals : []
  block  :
    ExprStmt(Call(Free(@skip), [(Lit(3), Guaranteed)]))
    ExprStmt(Call(Free(@last), [(Lit(3), Guaranteed)]))
    Return(adopt Lit(0))
