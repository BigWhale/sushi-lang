unit test_err_borrow_let_borrow_across_a_branch

ShirBody look
  params : [(_0 "text": string, Guaranteed), (_1 "loud": bool, Guaranteed)]
  locals : [_2 "view": string]
  block  :
    Assign(LocalRef(_2), reject LocalRef(_0), is_init: true)
    If(LocalRef(_1), then: [ExprStmt(Call(Intrinsic("println"), [(LocalRef(_2), Guaranteed)]))], otherwise: [ExprStmt(Call(Intrinsic("println"), [(Interp(["", LocalRef(_2), "."]), Guaranteed)]))])

ShirBody change
  params : [(_0 "text": string, Guaranteed), (_1 "reset": bool, Guaranteed)]
  locals : [_2 "view": string]
  block  :
    Assign(LocalRef(_2), reject LocalRef(_0), is_init: true)
    If(LocalRef(_1), then: [Assign(LocalRef(_0), adopt Interp(["", Lit(1), " towels"]), is_init: false)])
    ExprStmt(Call(Intrinsic("println"), [(LocalRef(_2), Guaranteed)]))

ShirBody main
  params : []
  locals : []
  block  :
    ExprStmt(Call(Free(@look), [(Interp(["", Lit(2), " towels"]), Guaranteed), (Lit(true), Guaranteed)]))
    ExprStmt(Call(Free(@change), [(Interp(["", Lit(3), " towels"]), Guaranteed), (Lit(false), Guaranteed)]))
    Return(adopt Lit(0))
