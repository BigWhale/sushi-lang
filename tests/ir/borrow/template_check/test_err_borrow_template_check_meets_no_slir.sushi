# EXPECT_ERROR_CODES_EXACT: CE0155
# EXPECT_STDERR_CONTAINS: "slir, main"
#
# The borrow pass checks the template check of `ident`, but a template check never goes
# to SLIR. So the first body that meets the next stage is `main`, and not `ident`. The
# stop of the next stage is the internal error CE0155 until SLIR is built.

fn ident@(T)(nom T x) T:
    return x

fn main() i32:
    return 0
