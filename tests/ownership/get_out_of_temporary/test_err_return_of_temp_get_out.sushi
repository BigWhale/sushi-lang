# A `return` is a consuming position. A get-out from a temporary container is a read
# through its owner, so the function cannot return the element itself.
# EXPECT_ERROR_CODE: CE2411
fn give() string[]:
    return from(["ford {1}", "arthur {2}"])

fn run() string | StdError:
    return Result.Ok(give().last().or_err(nom StdError.Error)??)

fn main() i32:
    println(run().realise("none"))
    return 0
