# A get-out from an array literal is a read through that temporary array. A `nom`
# argument cannot take it, because the temporary frees the element at scope exit.
# EXPECT_ERROR_CODE: CE2411
fn keep(nom string s) string:
    return s

fn run() string | StdError:
    let i32 k = 1
    return Result.Ok(keep(nom ["ford {k}", "arthur"].get(0).or_err(nom StdError.Error)??))

fn main() i32:
    println(run().realise("none"))
    return 0
