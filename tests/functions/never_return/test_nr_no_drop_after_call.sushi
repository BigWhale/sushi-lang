# No drop runs after a call of a `!` function: the locals stay live when the process ends
# (#1325). `keeps` drops its list at its end, and `leaves` has no drop after the call.
# COMPILER_FLAGS: --opt none
# EXPECT_IR_HOLDS: keeps @free
# EXPECT_IR_LACKS: leaves @free
# EXPECT_IR_HOLDS: leaves unreachable
# EXPECT_STDOUT_EXACT: "2\nMostly Harmless\n"
# EXPECT_RUNTIME_EXIT: 2
use <sys/process>

fn keeps() i32:
    let List@(i32) xs = List.new()
    xs.push(1)
    xs.push(2)
    return xs.len() as i32

fn leaves(i32 code) i32:
    let List@(i32) xs = List.new()
    xs.push(code)
    let string s = "Mostly ".concat("Harmless")
    println(s)
    exit(code)

fn main() i32:
    println(keeps())
    return leaves(2)
