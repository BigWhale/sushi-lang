# A generic function without `| E` is bare too, in every instance.
# EXPECT_STDOUT_EXACT: "7 fish\n"
# EXPECT_STDERR_EMPTY: true
fn pick@(T)(bool left, nom T a, nom T b) T:
    if (left):
        return a
    return b

fn main() i32:
    let i32 n = pick(true, nom 7, nom 8)
    let string s = pick(false, nom "towel", nom "fish")
    println("{n} {s}")
    return 0
