# A bare function has no error channel, so a `??` in its body has nothing to propagate
# into (CE0131). Handle the Result in the body, or write `| E` in the signature.
# EXPECT_ERROR_CODES_EXACT: CE0131
# EXPECT_STDERR_CONTAINS: 11:12: error [CE0131]
fn parse(i32 x) i32 | StdError:
    if (x < 0):
        return Result.Err(StdError.Error)
    return Result.Ok(x)

fn total(i32 x) i32:
    return parse(x)?? + 1

fn main() i32:
    println(total(3))
    return 0
