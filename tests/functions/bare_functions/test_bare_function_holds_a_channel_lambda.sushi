# A `??` inside a lambda that has its own channel is legal in a bare function: the
# `??` belongs to the lambda (#399).
# EXPECT_STDOUT_EXACT: "5\n-1\n"
fn parse(i32 x) i32 | StdError:
    if (x < 0):
        return Result.Err(StdError.Error)
    return Result.Ok(x)

fn shifted(i32 x) i32:
    let fn(i32) -> i32 | StdError f = |i32 v| parse(v)?? + 1
    return f(x).realise(-1)

fn main() i32:
    println(shifted(4))
    println(shifted(-4))
    return 0
