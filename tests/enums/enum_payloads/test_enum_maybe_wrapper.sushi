# Test Maybe@(CustomEnum): functions returning Maybe@(EnumType), match on Some/None
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "Found red\nPurple not found\nMaybe@(Color): all passed\n"

enum Color:
    Red
    Green
    Blue

fn find_color(string name) Maybe@(Color):
    if (name == "red"):
        return Maybe.Some(Color.Red())
    if (name == "green"):
        return Maybe.Some(Color.Green())
    if (name == "blue"):
        return Maybe.Some(Color.Blue())
    return Maybe.None()

fn main() i32:
    let Maybe@(Color) c1 = find_color("red")
    match c1:
        Maybe.Some(Color.Red) ->
            println("Found red")
        Maybe.Some(_) ->
            println("FAIL: wrong color")
            return 1
        Maybe.None ->
            println("FAIL: red not found")
            return 1

    let Maybe@(Color) c2 = find_color("purple")
    match c2:
        Maybe.None ->
            println("Purple not found")
        Maybe.Some(_) ->
            println("FAIL: purple should not exist")
            return 1

    println("Maybe@(Color): all passed")
    return 0
