# Test enum variant with bool associated data: construct and read via match
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "on with true\noff\n"

enum Toggle:
    On(bool)
    Off

fn describe_toggle(Toggle t) string:
    match t:
        Toggle.On(flag) ->
            if (flag):
                return "on with true"
            return "on with false"
        Toggle.Off ->
            return "off"

fn main() i32:
    let Toggle t1 = Toggle.On(true)
    let string s1 = describe_toggle(t1)

    let Toggle t2 = Toggle.Off()
    let string s2 = describe_toggle(t2)

    println("{s1}")
    println("{s2}")

    if (s1 != "on with true"):
        return 1
    if (s2 != "off"):
        return 1

    return 0
