# Test generic enum Either@(T, U): left/right variants with generic type inference
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "Right: 42\n"

enum Either@(T, U):
    Left(T)
    Right(U)

fn swap@(T: Clone, U: Clone)(Either@(T, U) e) Either@(U, T):
    # A match binding borrows the payload the scrutinee still owns, so re-wrapping it into
    # a new enum needs an independent value.
    match e:
        Either.Left(v) ->
            return Either.Right(v.clone())
        Either.Right(v) ->
            return Either.Left(v.clone())

fn main() i32:
    let Either@(i32, string) e1 = Either.Left(42)
    let Either@(string, i32) swapped = swap(e1)

    match swapped:
        Either.Left(s) ->
            println("FAIL: expected Right not Left({s})")
            return 1
        Either.Right(n) ->
            println("Right: {n}")
            if (n != 42):
                return 1

    let Either@(string, i32) e2 = Either.Right(99)
    let Either@(i32, string) s2 = swap(e2)
    match s2:
        Either.Left(n) ->
            if (n != 99):
                println("FAIL: expected 99 got {n}")
                return 1
        Either.Right(_) ->
            println("FAIL: expected Left")
            return 1

    return 0
