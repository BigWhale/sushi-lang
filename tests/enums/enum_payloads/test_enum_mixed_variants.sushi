# Test enum with unit, struct, string, and multi-i32 variant types in one enum
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "quit\nmove 3,7\nwrite: hello\ncolor 255,128,0\n"

struct Vec2:
    i32 x
    i32 y

enum Command:
    Quit
    Move(Vec2)
    Write(string)
    ChangeColor(i32, i32, i32)

fn describe_command(Command cmd) string:
    match cmd:
        Command.Quit ->
            return "quit"
        Command.Move(v) ->
            return "move {v.x},{v.y}"
        Command.Write(text) ->
            return "write: {text}"
        Command.ChangeColor(r, g, b) ->
            return "color {r},{g},{b}"

fn main() i32:
    let string s1 = describe_command(Command.Quit())
    let string s2 = describe_command(Command.Move(Vec2(3, 7)))
    let string s3 = describe_command(Command.Write("hello"))
    let string s4 = describe_command(Command.ChangeColor(255, 128, 0))

    println("{s1}")
    println("{s2}")
    println("{s3}")
    println("{s4}")

    if (s1 != "quit"):
        return 1
    if (s2 != "move 3,7"):
        return 1
    if (s3 != "write: hello"):
        return 1
    if (s4 != "color 255,128,0"):
        return 1

    return 0
