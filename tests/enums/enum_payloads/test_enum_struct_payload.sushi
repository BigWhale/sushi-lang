# Test enum variant with struct associated data: construct and read via match
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "Circle area: 25\nRect area: 12\n"

struct Point:
    i32 x
    i32 y

enum Shape:
    Circle(i32)
    Rect(Point, Point)

fn area(Shape s) i32:
    match s:
        Shape.Circle(r) ->
            return r * r
        Shape.Rect(p1, p2) ->
            let i32 w = p2.x - p1.x
            let i32 h = p2.y - p1.y
            return w * h

fn main() i32:
    let Shape c = Shape.Circle(5)
    let i32 a1 = area(c)

    let Point tl = Point(0, 0)
    let Point br = Point(4, 3)
    let Shape r = Shape.Rect(tl, br)
    let i32 a2 = area(r)

    println("Circle area: {a1}")
    println("Rect area: {a2}")

    if (a1 != 25):
        return 1
    if (a2 != 12):
        return 1

    return 0
