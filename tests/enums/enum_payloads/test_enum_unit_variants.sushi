# Test basic unit-variant enum: construction, match on each variant, printing
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "north east south west\n"

enum Direction:
    North
    South
    East
    West

fn direction_name(Direction d) string:
    match d:
        Direction.North ->
            return "north"
        Direction.South ->
            return "south"
        Direction.East ->
            return "east"
        Direction.West ->
            return "west"

fn main() i32:
    let Direction d1 = Direction.North()
    let Direction d2 = Direction.East()
    let Direction d3 = Direction.South()
    let Direction d4 = Direction.West()

    let string n1 = direction_name(d1)
    let string n2 = direction_name(d2)
    let string n3 = direction_name(d3)
    let string n4 = direction_name(d4)

    println("{n1} {n2} {n3} {n4}")
    return 0
