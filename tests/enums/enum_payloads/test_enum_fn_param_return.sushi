# Test enum used as function parameter and return type
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "Enum param/return: all passed\n"

enum Token:
    Number(i32)
    Plus
    Minus
    Star

fn is_operator(Token t) bool:
    match t:
        Token.Plus ->
            return true
        Token.Minus ->
            return true
        Token.Star ->
            return true
        Token.Number(_) ->
            return false

fn negate(Token t) Token:
    match t:
        Token.Plus ->
            return Token.Minus()
        Token.Minus ->
            return Token.Plus()
        Token.Star ->
            return Token.Star()
        Token.Number(n) ->
            return Token.Number(0 - n)

fn get_value(Token t) i32:
    match t:
        Token.Number(n) ->
            return n
        _ ->
            return 0

fn main() i32:
    let Token t1 = Token.Number(42)
    let Token t2 = Token.Plus()

    let bool is_op1 = is_operator(t1)
    let bool is_op2 = is_operator(t2)

    if (is_op1):
        println("FAIL: Number is not operator")
        return 1
    if (not is_op2):
        println("FAIL: Plus is operator")
        return 1

    let Token neg = negate(t1)
    let i32 v = get_value(neg)
    if (v != -42):
        println("FAIL: expected -42 got {v}")
        return 1

    println("Enum param/return: all passed")
    return 0
