# Test enum as state machine: transition functions returning new enum values
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "Done: 110\nState machine: all passed\n"

enum State:
    Idle
    Running(i32)
    Done(i32)

fn step(State s, i32 progress) State:
    match s:
        State.Idle ->
            return State.Running(progress)
        State.Running(p) ->
            if (p + progress >= 100):
                return State.Done(p + progress)
            return State.Running(p + progress)
        State.Done(total) ->
            return State.Done(total)

fn main() i32:
    let State s1 = State.Idle()
    let State s2 = step(s1, 40)
    let State s3 = step(s2, 40)
    let State s4 = step(s3, 30)

    match s4:
        State.Done(total) ->
            println("Done: {total}")
            if (total != 110):
                println("FAIL: expected 110 got {total}")
                return 1
        State.Running(p) ->
            println("FAIL: still running at {p}")
            return 1
        State.Idle ->
            println("FAIL: still idle")
            return 1

    println("State machine: all passed")
    return 0
