fn leaf(E32 x) i32:
    match x:
        E32.Node(E31.Node(E30.Node(E29.Node(E28.Node(E27.Node(E26.Node(E25.Node(E24.Node(E23.Node(E22.Node(E21.Node(E20.Node(E19.Node(E18.Node(E17.Node(E16.Node(E15.Node(E14.Node(E13.Node(E12.Node(E11.Node(E10.Node(E9.Node(E8.Node(E7.Node(E6.Node(E5.Node(E4.Node(E3.Node(E2.Node(E1.Node(E0.Leaf(v))))))))))))))))))))))))))))))))) -> return v

fn main() i32:
    let E32 x = E32.Node(E31.Node(E30.Node(E29.Node(E28.Node(E27.Node(E26.Node(E25.Node(E24.Node(E23.Node(E22.Node(E21.Node(E20.Node(E19.Node(E18.Node(E17.Node(E16.Node(E15.Node(E14.Node(E13.Node(E12.Node(E11.Node(E10.Node(E9.Node(E8.Node(E7.Node(E6.Node(E5.Node(E4.Node(E3.Node(E2.Node(E1.Node(E0.Leaf(7)))))))))))))))))))))))))))))))))
    println(leaf(x))
    return 0
