# A bloom argument `arr...` is only allowed as the last argument of a variadic '...T'
# call. An enum variant's payload is not a variadic slot, so the one argument check
# refuses it with CE0120.
# TEST_TYPE: error
# EXPECT_ERROR_CODE: CE0120
enum Shape:
    Circle(i32)

fn main() i32:
    let i32[] xs = from([1, 2, 3])
    let Shape s = Shape.Circle(xs...)
    match s:
        Shape.Circle(r) -> println("{r}")
    return Result.Ok(0)
