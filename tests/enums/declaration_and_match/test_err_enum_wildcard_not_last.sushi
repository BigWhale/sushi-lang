# Error test: wildcard must be last
# EXPECT_ERROR_CODE: CE2041
enum Color:
    Red
    Green
    Blue

fn test_color(Color c) i32:
    match c:
        _ ->
            return 0
        Color.Red ->
            return 1
        Color.Green ->
            return 2
        Color.Blue ->
            return 3

fn main() i32:
    return 0
