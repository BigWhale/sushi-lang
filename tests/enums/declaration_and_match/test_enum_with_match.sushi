# Enum test with match expression


enum Color:
    Red
    Green
    Blue

fn test_color(Color c) i32:
    match c:
        Color.Red ->
            return 1
        Color.Green ->
            return 2
        Color.Blue ->
            return 3

fn main() i32:
    let i32 result = test_color(Color.Red())
    let i32 expected = 1
    return result - expected
