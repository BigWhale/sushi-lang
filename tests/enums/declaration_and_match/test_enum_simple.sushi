# Simple enum test - unit variants

enum Color:
    Red
    Green
    Blue

fn test_color() Color | StdError:
    return Result.Ok(Color.Red())

fn main() i32:
    let Result@(Color, StdError) result = test_color()
    match result.realise(Color.Blue()):
        Color.Red -> return 0
        Color.Green -> return 1
        Color.Blue -> return 2
