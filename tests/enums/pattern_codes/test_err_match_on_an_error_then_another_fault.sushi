# A match whose scrutinee has an error reads no arm, and the body goes on: the fault of a
# later statement is reported too.
# EXPECT_ERROR_CODES_EXACT: CE2008, CE2048, CE2002
# EXPECT_STDERR_CONTAINS: test_err_match_on_an_error_then_another_fault.sushi:14:17: error [CE2002]
fn main() i32:
    match gone("x"):
        Result.Ok(_) -> println("a")
        Result.Err(_) -> println("no a")
    let f64 v = 1.5
    match v:
        1 -> println("one")
        _ -> println("other")
    println("Mostly Harmless")
    let i32 n = "s"
    return n
