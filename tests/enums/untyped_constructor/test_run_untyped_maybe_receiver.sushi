# An untyped generic enum constructor as a method receiver, in a `let` initializer and
# in an interpolation hole (#1005). The payload gives the type in each position.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "true\ntrue\n3\n"

fn main() i32:
    println(Maybe.Some(1).is_some())
    let bool b = Maybe.Some(1).is_some()
    println(b)
    println("{Maybe.Some(3).realise(0)}")
    return Result.Ok(0)
