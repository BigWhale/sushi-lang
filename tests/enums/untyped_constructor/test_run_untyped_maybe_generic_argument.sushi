# An untyped generic enum constructor as the argument of a generic function (#1005). The
# payload fixes the instance, so `T` is `Maybe@(i32)`. It was CE2060.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "1\n"

fn id@(T)(nom T x) T:
    return x

fn main() i32:
    let Maybe@(i32) m = id(nom Maybe.Some(1))
    println(m.realise(0))
    return 0
