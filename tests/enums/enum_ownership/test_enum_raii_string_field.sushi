# Test RAII cleanup: enum variant holding a string is freed when leaving scope
# Uses repeated allocation to detect heap corruption (would crash if not freed)
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "Received: Alice\nReceived: Bob\nReceived: Carol\n"

enum Message:
    Greeting(string)
    Farewell(string)
    Silent

fn process(Message m) string:
    match m:
        Message.Greeting(text) ->
            return "Received: {text}"
        Message.Farewell(text) ->
            return "Bye: {text}"
        Message.Silent ->
            return "Silence"

fn make_greeting(nom string name) string:
    let Message m = Message.Greeting(name)
    let string result = process(m)
    # m leaves scope here; string payload freed
    return result

fn main() i32:
    let string s1 = make_greeting(nom "Alice")
    let string s2 = make_greeting(nom "Bob")
    let string s3 = make_greeting(nom "Carol")

    println("{s1}")
    println("{s2}")
    println("{s3}")

    if (s1 != "Received: Alice"):
        return 1
    if (s2 != "Received: Bob"):
        return 1
    if (s3 != "Received: Carol"):
        return 1

    return 0
