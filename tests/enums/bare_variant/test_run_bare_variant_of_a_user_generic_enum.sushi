# The same rule for a user's generic enum: the bare spelling reaches the typecheck pass,
# takes the declared type, and the backend constructs the variant (#545).
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "empty\nfilled towel\n"

enum Slot@(T):
    Filled(T)
    Empty

fn describe(nom Slot@(string) s) string:
    match s:
        Slot.Filled(v) ->
            return Result.Ok("filled {v}")
        Slot.Empty ->
            return Result.Ok("empty")

fn main() i32:
    let Slot@(string) a = Slot.Empty
    println(describe(nom a).realise("?"))
    println(describe(nom Slot.Filled("towel")).realise("?"))
    return Result.Ok(0)
