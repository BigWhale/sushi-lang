# A unit's own declaration wins over a name a re-export offers, as it wins over a flat
# import (section 8's ladder, row 2 over row 3). `origin` here is main's, and shapes'
# `area` still reads geometry's `Vec`.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "30\n"
use "helpers/shapes"

fn origin() Vec:
    return Vec(5, 6)

fn main() i32:
    let Vec o = origin()
    println("{area(o)}")
    return 0
