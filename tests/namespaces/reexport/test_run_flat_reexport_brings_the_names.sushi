# `use "shapes"` where `shapes` says `public use "geometry"`: main writes `Vec` and
# `Sign` bare, constructs a Vec, matches on geometry's variants and calls geometry's
# `origin()` beside shapes' own `area()`. One flat import, two units' names
# (unit-namespaces.md section 8.1, Ruling 7, rule 1).
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "2 9 3 minus\n"
use "helpers/shapes"

fn main() i32:
    let Vec o = origin().realise(Vec(0, 0))
    let Vec sq = unit_square().realise(Vec(0, 0))
    let i32 a = area(o).realise(-1)
    let i32 b = area(sq).realise(-1)
    let Sign s = sign_of(-4).realise(Sign.Plus)
    let string word = "plus"
    match s:
        Sign.Plus -> word := "plus"
        Sign.Minus -> word := "minus"
    println("{a} {b} {SIZE} {word}")
    return Result.Ok(0)
