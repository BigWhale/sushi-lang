# Re-exports compose: `outer` says `public use "shapes"`, `shapes` says `public use
# "geometry"`, and an importer of `outer` writes `Vec` and calls `origin()` (Ruling 7,
# rule 2).
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "1x2 3x3\n"
use "helpers/outer"

fn main() i32:
    let Vec o = origin().realise(Vec(0, 0))
    let Vec sq = unit_square().realise(Vec(0, 0))
    println("{describe(o).realise('?')} {describe(sq).realise('?')}")
    return Result.Ok(0)
