# The unit declares its own concrete `pick`, and an import brings a concrete
# `pick` too. The function value `pick` names the unit's own function, as the
# bare call does (#1003, #1013).
# EXPECT_STDOUT_EXACT: "3\n3\n"
use "helpers/pick_plain"
use <collections/strings>

fn pick(string s) i32:
    return s.len()

fn main() i32:
    let fn(string) -> i32 f = pick
    println(f("abc"))
    println(pick("abc"))
    return 0
