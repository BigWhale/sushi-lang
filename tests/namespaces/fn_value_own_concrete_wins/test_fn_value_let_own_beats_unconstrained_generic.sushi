# The unit declares its own concrete `pick`, and an import brings a generic
# `pick` with no constraint. The function value `pick` names the unit's own
# function, as the bare call does, so the own function runs (#1003).
# EXPECT_STDOUT_EXACT: "3\n"
use "helpers/pick_any"
use <collections/strings>

fn pick(string s) i32:
    return s.len()

fn main() i32:
    let fn(string) -> i32 f = pick
    println(f("abc"))
    return 0
