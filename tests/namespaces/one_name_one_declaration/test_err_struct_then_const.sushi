# One name has one declaration in a unit, whatever its kind (#1076). The
# constant is the second declaration of 'box' in source order, so it is the
# error, with a note at the struct. The struct keeps the name, so its uses
# give no more errors.
# EXPECT_ERROR_CODES_EXACT: CE1005
# EXPECT_STDERR_CONTAINS: :14:11: error [CE1005]: constant 'box' already declared in this unit as a struct
# EXPECT_STDERR_CONTAINS: first declared here, as a struct
# EXPECT_STDERR_CONTAINS: :11:8
#

struct box:
    i32 n

const i32 box = 3

fn main() i32:
    let box b = box(3)
    println(b.n)
    return 0
