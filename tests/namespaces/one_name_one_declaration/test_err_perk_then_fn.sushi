# One name has one declaration in a unit, whatever its kind (#1076). The
# function is the second declaration of 'box' in source order, so it is the
# error, with a note at the perk. The perk keeps the name, so its uses
# give no more errors.
# EXPECT_ERROR_CODES_EXACT: CE1005
# EXPECT_STDERR_CONTAINS: :14:4: error [CE1005]: function 'box' already declared in this unit as a perk
# EXPECT_STDERR_CONTAINS: first declared here, as a perk
# EXPECT_STDERR_CONTAINS: :11:6
#

perk box:
    fn size() i32

fn box() i32:
    return 4

fn main() i32:
    return 0
