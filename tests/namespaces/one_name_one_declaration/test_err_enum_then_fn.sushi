# One name has one declaration in a unit, whatever its kind (#1076). The
# function is the second declaration of 'box' in source order, so it is the
# error, with a note at the enum. The enum keeps the name, so its uses
# give no more errors.
# EXPECT_ERROR_CODES_EXACT: CE1005
# EXPECT_STDERR_CONTAINS: :15:4: error [CE1005]: function 'box' already declared in this unit as an enum
# EXPECT_STDERR_CONTAINS: first declared here, as an enum
# EXPECT_STDERR_CONTAINS: :11:6
#

enum box:
    Big
    Huge

fn box() i32:
    return Result.Ok(4)

fn main() i32:
    let box b = box.Big
    match b:
        box.Big -> println(1)
        box.Huge -> println(2)
    return Result.Ok(0)
