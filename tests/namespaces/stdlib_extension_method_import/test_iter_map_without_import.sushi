# `.map()` on `T[]` is a method of <collections/iter>. A method of a built-in type
# needs no import, so this unit calls it with none.
# EXPECT_STDOUT_EXACT: "2\n"
# EXPECT_NO_LEAKS: true
fn dbl(i32 x) i32:
    return x * 2

fn main() i32:
    let i32[] xs = from([1, 2])
    let List@(i32) ys = xs.map(dbl)
    println(ys.len())
    return 0
