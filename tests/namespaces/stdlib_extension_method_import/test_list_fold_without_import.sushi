# `.fold()` on `List@(T)` is a method of <collections/iter>. A method of a built-in
# type needs no import, so this unit calls it with none.
# EXPECT_STDOUT_EXACT: "1\n"
# EXPECT_NO_LEAKS: true
fn add(i32 a, i32 b) i32:
    return a + b

fn main() i32:
    let List@(i32) xs = List.new()
    xs.push(1)
    println(xs.fold(0, add))
    return 0
