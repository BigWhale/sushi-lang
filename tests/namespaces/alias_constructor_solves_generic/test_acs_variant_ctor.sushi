# An enum variant behind a unit alias, without and with a payload, solves the
# type parameter of a generic call (#1147).
# EXPECT_STDOUT_EXACT: "1\n0\n1\n1\n2\n"
use "helpers/acs_shapes" as sh

fn one@(T)(T d) i32:
    if (d == d):
        return 1
    return 0

fn cnt@(T)(T[] xs, T d) i32:
    let i32 n = 0
    foreach(x in xs.iter()):
        if (x == d):
            n := n + 1
    return n

fn main() i32:
    println(one(sh.Mark.Off()))
    let sh.Mark[] ms = from([sh.Mark.On()])
    println(cnt(ms, sh.Mark.Off()))
    println(cnt(ms, sh.Mark.On))
    let sh.Shape[] ss = from([sh.Shape.Circle(1), sh.Shape.Square(2)])
    println(cnt(ss, sh.Shape.Square(2)))
    println(one(sh.Shape.Circle(3)) + one(sh.Shape.Square(9)))
    return 0
