# A constructor behind a unit alias solves a generic call that is itself an
# argument of another call (#1147).
# EXPECT_STDOUT_EXACT: "9\n2\n"
use "helpers/acs_shapes" as sh

fn one@(T: Eq)(T d) i32:
    if (d == d):
        return 1
    return 0

fn same@(T: Clone)(T d) T:
    return d.clone()

fn add(i32 a, i32 b) i32:
    return a + b

fn main() i32:
    let sh.Pt p = same(same(sh.Pt(9)))
    println(p.x)
    println(add(one(sh.Pt(0)), one(sh.Mark.On())))
    return 0
