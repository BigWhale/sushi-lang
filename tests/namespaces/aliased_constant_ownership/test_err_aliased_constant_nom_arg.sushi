# A nom argument that names a constant of an owning type behind an alias hands
# it to the callee, as for the flat name (#1016).
# EXPECT_ERROR_CODES_EXACT: CE2436
use "helpers/libc5" as c

fn take(nom string s) i32:
    println(s)
    return 0

fn main() i32:
    println(take(nom c.GREETING))
    return 0
