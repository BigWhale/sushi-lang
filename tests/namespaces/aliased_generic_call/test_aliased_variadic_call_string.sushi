# A native `...string` function behind a unit alias takes an owning trailing
# argument and frees it once (#1125).
# EXPECT_STDOUT_EXACT: "2\n"
# EXPECT_NO_LEAKS: true
use "helpers/agc_unit" as l

fn main() i32:
    let string w = "Harmless"
    let string s = "Mostly {w}"
    println(l.take_all(s, "b"))
    return 0
