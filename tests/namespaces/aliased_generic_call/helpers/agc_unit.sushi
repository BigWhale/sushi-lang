use <collections/strings>

public fn gen@(T)(nom T x) T:
    return x

public fn look@(T: Display)(T x) i32:
    return "{x}".len()

public fn count_all@(...Ts)(...Ts xs) i32:
    return 3

public struct Holder:
    i32 n

public extend Holder pass@(U)(nom U x) U:
    return x

public fn coll(...i32 xs) i32:
    return xs.len()

public fn take_all(...string xs) i32:
    return xs.len()

public fn first_or(i32 d, ...i32 xs) i32:
    return xs.get(0).realise(d)
