# Every position that hands a qualified generic variant its type: a return, a struct
# argument, a call argument, a rebind -- the same rule as the bare spelling.
# EXPECT_STDOUT_EXACT: "true false 7\n"
use "helpers/slot" as slot

struct Holder:
    slot.Slot@(string) name

fn filled() slot.Slot@(string):
    return Result.Ok(slot.Slot.Filled("towel"))

fn take(nom slot.Slot@(i32) s) i32:
    match s:
        slot.Slot.Filled(v) -> return Result.Ok(v)
        slot.Slot.Empty -> return Result.Ok(7)

fn is_filled(slot.Slot@(string) s) bool:
    match s:
        slot.Slot.Filled(_) -> return Result.Ok(true)
        slot.Slot.Empty -> return Result.Ok(false)

fn main() i32:
    let Holder h = Holder(slot.Slot.Empty)
    let slot.Slot@(string) f = filled().realise(slot.Slot.Empty)
    let i32 t = take(nom slot.Slot.Empty).realise(-1)
    let bool a = is_filled(f).realise(false)
    let bool b = is_filled(h.name).realise(true)
    h.name := slot.Slot.Filled("later")
    println("{a} {b} {t}")
    return Result.Ok(0)
