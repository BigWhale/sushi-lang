# A NAMED construction behind a dot. `geo.Vec(y: 4, x: 3)` parses as a method
# call on `geo`, and the builder used to drop the names, so the arguments landed
# positionally and the value was silently wrong (found under #561).
# EXPECT_STDOUT_EXACT: "3 4\n"
use "helpers/geo" as geo

fn main() i32:
    let geo.Vec v = geo.Vec(y: 4, x: 3)
    println("{v.x} {v.y}")
    return Result.Ok(0)
