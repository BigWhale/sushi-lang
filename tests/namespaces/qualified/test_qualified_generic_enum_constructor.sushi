# A GENERIC enum's constructor behind a dot: `slot.Slot.Filled("x")` takes the type its
# position declares exactly as the bare `Slot.Filled("x")` does. Propagation read the
# receiver as a bare name only, so the qualified spelling carried no stamp and reached
# the backend as a CE0113 compiler bug.
# EXPECT_STDOUT_EXACT: "filled towel\nempty\n"
use "helpers/slot" as slot

fn main() i32:
    let slot.Slot@(string) s = slot.Slot.Filled("towel")
    let slot.Slot@(string) e = slot.Slot.Empty
    match s:
        slot.Slot.Filled(v) -> println("filled {v}")
        slot.Slot.Empty -> println("empty")
    match e:
        slot.Slot.Filled(v) -> println("filled {v}")
        slot.Slot.Empty -> println("empty")
    return Result.Ok(0)
