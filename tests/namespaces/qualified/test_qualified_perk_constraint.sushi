# A perk takes the qualifier the same way every other written name does, in a
# constraint and in an implementation: the alias puts nothing in the flat scope
# (section 8).
# EXPECT_STDOUT_EXACT: "5\n"
use "helpers/geo" as geo

struct Horn:
    i32 pitch

extend Horn with geo.Loud:
    fn shout() i32:
        return self.pitch

fn noise@(T: geo.Loud)(T thing) i32:
    return thing.shout()

fn run() i32:
    let Horn h = Horn(5)
    return noise(h)

fn main() i32:
    println("{run()}")
    return 0
