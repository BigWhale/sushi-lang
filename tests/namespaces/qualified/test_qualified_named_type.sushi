# A qualified name stands wherever a type is written: a `let` annotation, a
# parameter, and a struct field (unit-namespaces.md section 5, first row).
# EXPECT_STDOUT_EXACT: "3\n"
use "helpers/geo" as geo

struct Holder:
    geo.Vec spot

fn total(geo.Vec v) i32:
    return v.x + v.y

fn run() i32:
    let geo.Vec v = geo.origin()
    let Holder h = Holder(v)
    return total(h.spot)

fn main() i32:
    println("{run()}")
    return 0
