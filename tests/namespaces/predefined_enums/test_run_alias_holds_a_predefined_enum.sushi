# A predefined enum has a HOME module, and the alias over that module holds it (#574,
# Ruling 3): `fs.FileMode` behind `use <io/fs> as fs`, `io.IoError` behind
# `use <io/contracts> as io`, and a registry module's `m.MathError` behind `use <math> as m`.
# The dot works in every written-name position: a type, a constructor, a match arm, a
# channel.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "read\nnot found\nzero\n"
use <io/fs> as fs
use <io/contracts> as io
use <math> as m

fn mode_name(fs.FileMode mode) string:
    match mode:
        fs.FileMode.Read -> return Result.Ok("read")
        _ -> return Result.Ok("other")

fn fail() i32 | io.IoError:
    return Result.Err(io.IoError.NotFound)

fn halve(i32 v) i32 | m.MathError:
    if (v == 0):
        return Result.Err(m.MathError.DivisionByZero)
    return Result.Ok(v / 2)

fn main() i32:
    let fs.FileMode mode = fs.FileMode.Read()
    println(mode_name(mode).realise("?"))
    match fail():
        Result.Ok(_) -> println("ok")
        Result.Err(e) ->
            match e:
                io.IoError.NotFound -> println("not found")
                _ -> println("other")
    match halve(0):
        Result.Ok(_) -> println("half")
        Result.Err(m.MathError.DivisionByZero) -> println("zero")
        Result.Err(_) -> println("other")
    return Result.Ok(0)
