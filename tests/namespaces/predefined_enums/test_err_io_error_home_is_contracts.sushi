# `IoError` is homed at `<io/contracts>`, the module whose every method answers it, and
# `<io/fs>` alone does not bring the name (#574, Ruling 3). Scope is per unit and not
# transitive: a public signature may name a type its caller cannot write, and the help
# says which import is missing.
# EXPECT_ERROR_CODE: CE2001
# EXPECT_STDERR_CONTAINS: use <io/contracts>
use <io/fs>

fn read_it(string path) string | IoError:
    let File f = open(path, FileMode.Read())??
    return f.read_all()
