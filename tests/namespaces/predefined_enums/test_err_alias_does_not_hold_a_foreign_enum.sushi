# A namespace holds exactly what its import brings (unit-namespaces.md, Ruling 3):
# `IoError` is `<io/contracts>`'s, so `fs.IoError` names no member of `<io/fs>`.
# EXPECT_ERROR_CODE: CE2001
use <io/fs> as fs

fn fail() i32 | fs.IoError:
    return Result.Err(fs.IoError.NotFound)

fn main() i32:
    return Result.Ok(0)
