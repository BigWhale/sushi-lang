# The flat import brings the bare name, one home per enum: `FileMode` and `FileError`
# from `<io/fs>`, `IoError` and `SeekFrom` from `<io/contracts>`, `NetError` from the new
# `<net/error>`, `ProcessError` from `<sys/process>`, and `EnvError` from
# `<sys/env>` (#574, Ruling 3).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "7\n"
use <io/fs>
use <net/error>
use <sys/process>
use <sys/env>

fn main() i32:
    let FileMode a = FileMode.Read()
    let FileError b = FileError.NotFound
    let IoError c = IoError.TimedOut
    let SeekFrom d = SeekFrom.Start
    let NetError e = NetError.TimedOut
    let ProcessError f = ProcessError.SpawnFailed
    let EnvError g = EnvError.NotFound
    let i32 count = 0
    match a:
        FileMode.Read -> count := count + 1
        _ -> count := count
    match b:
        FileError.NotFound -> count := count + 1
        _ -> count := count
    match c:
        IoError.TimedOut -> count := count + 1
        _ -> count := count
    match d:
        SeekFrom.Start -> count := count + 1
        _ -> count := count
    match e:
        NetError.TimedOut -> count := count + 1
        _ -> count := count
    match f:
        ProcessError.SpawnFailed -> count := count + 1
        _ -> count := count
    match g:
        EnvError.NotFound -> count := count + 1
        _ -> count := count
    println("{count}")
    return 0
