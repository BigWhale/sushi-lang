# `<collections>` is a method interface: a directory import that enables `s.upper()`
# and brings no name at all. The `as` bound an empty namespace, and the import still
# did its work, so this warns (section 4.4, CW3004).
#
# It used to say this with `<io/stdio>`, and then with `<collections/strings>`. The
# first was retired when the console handles became File constants; the second has a
# Sushi half that exports `StringBuilder`, so its alias binds a name.
# EXPECT_ERROR_CODE: CW3004
# EXPECT_STDOUT_EXACT: "MOSTLY\n"
use <collections> as s

fn main() i32:
    let string text = "mostly"
    println(text.upper())
    return 0
