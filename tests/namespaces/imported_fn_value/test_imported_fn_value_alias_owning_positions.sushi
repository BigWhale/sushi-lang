# A function value behind an alias in the positions that take ownership: a
# `return`, an enum payload, a `nom` argument and a rebind. Each one is a new
# value, as the bare function value is (#1013).
# EXPECT_STDOUT_EXACT: "5\n5\n5\n5\n"
# EXPECT_NO_LEAKS
use "helpers/lib3" as l
use <collections/strings>

fn take(nom fn(string) -> i32 f) i32:
    return f("a")

fn chooser() fn(string) -> i32:
    return l.plain

fn one(string s) i32:
    return 1 + s.len() * 0

fn main() i32:
    let fn(string) -> i32 f = chooser()
    println(f("ab"))
    let Maybe@(fn(string) -> i32) m = Maybe.Some(l.plain)
    let fn(string) -> i32 g = m.realise(one)
    println(g("ab"))
    println(take(nom l.plain))
    let fn(string) -> i32 h = one
    h := l.plain
    println(h("ab"))
    return 0
