# An imported generic function is a function value in an argument position:
# the parameter type solves its type arguments, as for a generic of the unit
# itself (#1013, #1021).
# EXPECT_STDOUT_EXACT: "7\n"
use "helpers/lib3"

fn take(fn(i32) -> i32 f) i32:
    return Result.Ok(f(1)??)

fn main() i32:
    println(take(gen).realise(0))
    return Result.Ok(0)
