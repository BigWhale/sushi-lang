# An imported generic function in an argument position with no typed binding
# is not a function value, as for a generic of the unit itself (#1013).
# EXPECT_ERROR_CODES_EXACT: CE2093
use "helpers/lib3"

fn take(fn(i32) -> i32 f) i32:
    return Result.Ok(f(1)??)

fn main() i32:
    println(take(gen).realise(0))
    return Result.Ok(0)
