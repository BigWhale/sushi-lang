# A public function of another unit, brought by a flat import, is a function
# value in a `return` (#1013).
# EXPECT_STDOUT_EXACT: "5\n"
use "helpers/lib3"

fn chooser() fn(string) -> i32:
    return Result.Ok(plain)

fn main() i32:
    let fn(string) -> i32 f = chooser().realise(plain)
    println(f("ab").realise(0))
    return Result.Ok(0)
