# Section 4.3.1: the built-in generic table holds `HashMap` unconditionally and
# the SCOPE decides who may write the name. `mapper` imported the module; this
# unit did not.
# EXPECT_ERROR_CODE: CE2001
use "helpers/mapper"

fn main() i32:
    let HashMap@(i32, i32) m = HashMap.new()
    m.free()
    return Result.Ok(counted().realise(0))
