# A GENERIC still holds one name for the whole program. `FunctionTable` carries a
# per-unit view and `GenericFunctionTable` does not, so two generics of one name would
# leave each unit's call measured against the other's declaration -- section 13.1 of
# docs/design/unit-namespaces.md, in the shape a concrete function just left.
# EXPECT_ERROR_CODE: CE0101
use "helpers/generic_twin"

fn twin@(T)(T x, i32 y) i32:
    return Result.Ok(y)

fn main() i32:
    println("{twin(2, 99).realise(0)} {twin_use().realise(0)}")
    return Result.Ok(0)
