# Two units each declare a private `SCRATCH`, and a private `DOUBLE` that reads it.
# A constant is a symbol too, so the globals must coexist and every unit must read
# its own -- the value the evaluator folds included.
# EXPECT_STDOUT_EXACT: "41 82 58 116\n"
use "helpers/const_left"
use "helpers/const_right"

fn main() i32:
    println("{left_scratch().realise(0)} {left_double().realise(0)} {right_scratch().realise(0)} {right_double().realise(0)}")
    return Result.Ok(0)
