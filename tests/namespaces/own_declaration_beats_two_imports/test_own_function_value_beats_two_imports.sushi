# The unit declares its own `pick`, and two flat imports offer `pick` too. The
# own declaration wins in the value position, as it does at the call.
# EXPECT_STDOUT_EXACT: "2\n2\n"
use "helpers/obti_pick_ten"
use "helpers/obti_pick_twenty"

fn pick(i32 x) i32:
    return x + 1

fn main() i32:
    let fn(i32) -> i32 f = pick
    println(f(1))
    println(pick(1))
    return 0
