# The unit declares its own `pick`, and two flat imports offer `pick` too. The
# own declaration wins, so the bare call answers 2.
# EXPECT_STDOUT_EXACT: "2\n"
use "helpers/obti_pick_ten"
use "helpers/obti_pick_twenty"

fn pick(i32 x) i32:
    return x + 1

fn main() i32:
    println(pick(1))
    return 0
