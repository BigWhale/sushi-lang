# The result of a generic call behind a unit alias solves the generic call that
# takes it as an argument, as the flat call does (#1159).
# EXPECT_STDOUT_EXACT: "5 7\nMostly Harmless 7\nMostly Harmless\n5\n"
# EXPECT_NO_LEAKS: true
use "helpers/acr_unit" as bx

fn k@(T: Display)(T x) i32:
    print("{x} ")
    return 7

fn idk@(T)(nom T x) T:
    return x

fn main() i32:
    println(k(bx.sid(nom 5)))
    let string w = "Harmless"
    let string s = "Mostly {w}"
    println(k(bx.sid(nom s.clone())))
    println(idk(nom bx.sid(nom s)))
    println(bx.sid(nom bx.sid(nom 5)))
    return 0
