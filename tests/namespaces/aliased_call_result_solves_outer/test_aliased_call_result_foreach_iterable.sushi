# The result of a generic call behind a unit alias solves the generic call that
# makes a `foreach` iterable, over a `List@(T)` and over a `T[]` (#1159).
# EXPECT_STDOUT_EXACT: "5\n6\n"
# EXPECT_NO_LEAKS: true
use "helpers/acr_unit" as bx

fn listed@(T)(nom T x) List@(T):
    let List@(T) out = List.new()
    out.push(nom x)
    return out

fn arrayed@(T)(nom T x) T[]:
    let T[] out = from([])
    out.push(nom x)
    return out

fn main() i32:
    foreach(e in listed(nom bx.sid(nom 5)).iter()):
        println(e)
    foreach(f in arrayed(nom bx.sid(nom 6)).iter()):
        println(f)
    return 0
