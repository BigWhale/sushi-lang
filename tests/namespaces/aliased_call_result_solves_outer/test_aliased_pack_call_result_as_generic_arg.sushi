# The result of a type-pack call behind a unit alias solves the generic call that
# takes it as an argument: a pack alone, and a leading parameter whose type the call
# answers (#1159, #1160).
# EXPECT_STDOUT_EXACT: "2 7\n4 7\n9\n"
use "helpers/acr_unit" as bx

fn k@(T: Display)(T x) i32:
    print("{x} ")
    return 7

fn idk@(T)(nom T x) T:
    return x

fn main() i32:
    println(k(bx.count_two(1, 2)))
    println(k(bx.lead_of(nom 4, "a", 2.5)))
    println(idk(nom bx.lead_of(nom 9, 1)))
    return 0
