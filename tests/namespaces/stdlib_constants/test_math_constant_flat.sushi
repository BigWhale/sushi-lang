# The flat import brings the three constants bare, typed f64, in a body and in a
# `let` initializer alike.
# EXPECT_STDOUT_EXACT: "6.28319 3.14159 2.71828\n"
use <math>

fn main() i32:
    let f64 whole = TAU
    let f64 twice = PI * 2.0
    println("{whole} {twice / 2.0} {E}")
    return Result.Ok(0)
