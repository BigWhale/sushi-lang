# The other direction: the helper imports <collections/strings> for itself, and
# that import does not reach this unit, so the call here is refused (#942).
# EXPECT_ERROR_CODE: CE3015
# EXPECT_STDERR_CONTAINS: "string.ends_with()"
use "helpers/prefix_own"

fn main() i32:
    let string s = "a,b"
    println(begins_with_a(s).realise(false))
    println(s.ends_with("b"))
    return Result.Ok(0)
