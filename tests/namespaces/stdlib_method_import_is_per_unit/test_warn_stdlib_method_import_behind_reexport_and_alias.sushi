# A unit may reach the string methods through a `public use` of one of its own
# imports, or behind an alias. Both helpers import the directory `<collections>`,
# a method interface that brings no name, and call a string method; both calls
# compile (#942). The two warnings say that the `public` and the `as` bring no
# name, and the imports still do their work.
# EXPECT_ERROR_CODE: CW3005
# EXPECT_STDERR_CONTAINS: "CW3004"
# EXPECT_STDOUT_EXACT: "true\ntrue\n"
use "helpers/prefix_through_bridge"
use "helpers/prefix_aliased"

fn main() i32:
    let string s = "a,b"
    println(opens_with_a(s))
    println(leads_with_a(s))
    return 0
