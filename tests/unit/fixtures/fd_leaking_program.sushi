# A program that deliberately leaks a DESCRIPTOR, used by
# tests/unit/test_fd_gate_wiring.py.
#
# It is NOT named test_*.sushi on purpose, for the same reason the malloc fixture
# beside it is not: the suite discovers tests/**/test_*.sushi, and a permanently
# failing program under that glob would make the suite permanently red.
#
# The point of the fixture is that it leaks NOTHING the malloc interposer can see.
# It opens a descriptor and never closes it, so `leaked` is 0 and `open_fds` is 1 --
# which is exactly why EXPECT_NO_LEAKS gives a handle test no coverage at all, and why
# the descriptor directive below exists (HANDLES.md, Phase 2).
#
# It leaks through fd_open, the raw descriptor primitive, and NOT through open(): a
# `File` owns its descriptor and closes it on drop, so a leak is no longer something a
# program can write by forgetting. That is Phase 5 working, and it is why this fixture
# had to drop a level to keep saying what it says.
# EXPECT_NO_OPEN_FDS: true
# EXPECT_STDOUT_CONTAINS: "fd fixture ran"
use <io/files>

fn main() i32:
    let i32 fd = fd_open("fd_fixture_probe.txt", 1, 420).realise(-1)
    if (fd < 0):
        println("open failed")
    println("fd fixture ran")
    return Result.Ok(0)
