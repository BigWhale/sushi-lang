# List.insert with an index out of bounds destroys a temporary string element (#869).
# The element is evaluated and consumed before the bounds check; the Err path frees it.
# EXPECT_STDOUT_EXACT: "err\nerr\nend 0\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS
use <collections/strings>

fn main() i32:
    let List@(string) l = List.new()
    match l.insert(5, "z".concat("y")):
        Result.Ok(_) -> println("ok")
        Result.Err(_) -> println("err")
    match l.insert(-1, "a".concat("b")):
        Result.Ok(_) -> println("ok")
        Result.Err(_) -> println("err")
    println("end {l.len()}")
    return Result.Ok(0)
