# List.insert with an index out of bounds destroys a moved owning local (#869).
# The insert consumes `s` by position, so the call owns it and frees it on Err.
# EXPECT_STDOUT_EXACT: "err\nend 0\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS
use <collections/strings>

fn main() i32:
    let List@(string) l = List.new()
    let string s = "z".concat("y")
    match l.insert(5, s):
        Result.Ok(_) -> println("ok")
        Result.Err(_) -> println("err")
    println("end {l.len()}")
    return Result.Ok(0)
