# Test error: pop() with arguments (expects 0)
# EXPECT_ERROR_CODE: CE2009
fn run_test() i32 | StdError:
    let List@(i32) data = List.new()
    data.push(42)
    # ERROR: pop() expects no arguments
    let i32 val = data.pop(1).or_err(nom StdError.Error)??
    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return result
