# TEST_TYPE: compilation
# EXPECT_ERROR_CODE: CE2002
# Error test for an unhandled Result@(T) assignment
# Should fail with CE2505: cannot assign Result@(T) to non-Result variable

fn get_value() i32:
    return Result.Ok(42)

fn main() i32:
    let i32 x = get_value()
    println(x)
    return Result.Ok(0)
