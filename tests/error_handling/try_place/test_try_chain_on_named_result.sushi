# `r??.len()`: the unwrapped value is a temporary the chain owns, and `r` is spent by
# the `??`, so the buffer is freed once.
# EXPECT_STDOUT_EXACT: "15\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
use <collections/strings>

fn make() string:
    let string base = "Mostly"
    return Result.Ok(base.concat(" Harmless"))

fn run() i32:
    let Result@(string, StdError) r = make()
    let i32 n = r??.len()
    return Result.Ok(n)

fn main() i32:
    println("{run().realise(0)}")
    return Result.Ok(0)
