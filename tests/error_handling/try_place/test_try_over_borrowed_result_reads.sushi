# `??` over a BORROWED Result (a parameter) is a read through its owner: the `let` is
# a borrow, so the caller's local stays the one owner. Before the fix the binding took
# a second ownership and the value was freed twice.
# EXPECT_STDOUT_EXACT: "Mostly Harmless\nMostly Harmless\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
use <collections/strings>

fn make() string:
    let string base = "Mostly"
    return Result.Ok(base.concat(" Harmless"))

fn show(Result@(string, StdError) r) ~:
    let string s = r??
    println(s)
    return Result.Ok(~)

fn run() ~:
    let Result@(string, StdError) r = make()
    show(r)??
    show(r)??
    return Result.Ok(~)

fn main() i32:
    match run():
        Result.Ok(_) -> return Result.Ok(0)
        Result.Err(_) -> return Result.Ok(1)
