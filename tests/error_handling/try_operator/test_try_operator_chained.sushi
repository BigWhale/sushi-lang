# EXPECT_STDOUT_EXACT: "Result: 60\n"
# EXPECT_RUNTIME_EXIT: 0
# Test chained ?? operators

fn first() i32:
    return 10

fn second(i32 x) i32:
    return x + 20

fn third(i32 x) i32:
    return x + 30

fn compute() i32:
    # Chained ?? operators
    let i32 result = third(second(first()))
    return result

fn main() i32:
    let i32 result = compute()
    println("Result: {result}")
    let i32 expected = 60
    return result - expected
