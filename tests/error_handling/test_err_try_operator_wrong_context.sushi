# An extension method returns a bare value, so a `??` in its body has no error
# channel to propagate into. This used to be CE2508 by accident of
# `current_function is None`; #398 gave the rule its own code, emitted from
# Phase 0 (see tests/extensions/try_guard/).
# EXPECT_ERROR_CODE: CE0131

fn get_value() i32:
    return Result.Ok(42)

extend string bad_method() i32:
    let i32 x = get_value()??
    return x

fn main() i32:
    let string val = "test"
    let i32 result = val.bad_method()
    return Result.Ok(result)
