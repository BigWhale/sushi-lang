# EXPECT_STDOUT_EXACT: "Default: Left(99)\n"
# EXPECT_RUNTIME_EXIT: 0
# Test: Using Result@(T).realise() with error case where T is a user-defined generic

enum Either@(T, U):
    Left(T)
    Right(U)

fn test_return_error() Either@(i32, string) | StdError:
    return Result.Err(StdError.Error)

fn main() i32:
    # Use .realise() directly on function call to extract with default
    let Either@(i32, string) either_val = test_return_error().realise(Either.Left(99))

    # Verify we got the default value
    match either_val:
        Either.Left(x) ->
            println("Default: Left({x})")
        Either.Right(s) ->
            println("Default: Right({s})")

    return 0
