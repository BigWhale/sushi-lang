# EXPECT_STDOUT_EXACT: "Successfully read: Mostly Harmless\n"
# EXPECT_RUNTIME_EXIT: 0
# Test ?? operator over the IoError channel - success path
# Creates a test file and uses ?? to read from it

use <io/files>
use <io/fs>
use <collections/strings>

fn write_test_file() ~:
    # Use pattern matching to handle the Result from open()
    match open("/tmp/sushi_test_try.txt", FileMode.Write()):
        Result.Ok(nom f) ->
            f.writeln("Mostly Harmless")
            f.writeln("Second line here.")
            f.close()
        Result.Err(_) ->
            println("Failed to create test file")
    return Result.Ok(~)

fn read_first_line(string path) string | IoError:
    # Use ?? to unwrap the Result from open()
    let File f = open(path, FileMode.Read())??

    # Read the first line
    let string line = f.line_or_empty()
    f.close()

    return Result.Ok(line)

# Reads one line and substitutes an empty string for the end of the file. readln()
# answers Maybe@(string) now, so a caller that does not care which of the two it got
# says so once, here, rather than losing the distinction at every call.
extend File line_or_empty() string:
    match self.readln():
        Result.Ok(Maybe.Some(line)) -> return line.clone()
        Result.Ok(Maybe.None) -> return ""
        Result.Err(_) -> return ""

fn main() i32:
    # Write test file
    write_test_file()

    # Use .realise() to read from the file (should succeed)
    let string first_line = read_first_line("/tmp/sushi_test_try.txt").realise("")

    println("Successfully read: {first_line}")

    return Result.Ok(0)
