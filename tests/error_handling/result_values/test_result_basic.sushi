# EXPECT_STDOUT_EXACT: "Sum: 8, Prod: 42\n"
# EXPECT_RUNTIME_EXIT: 42
# Basic Result@(T) test with Ok() returns
# EXPECT_RUNTIME_EXIT: 42


fn add(i32 a, i32 b) i32:
  return a + b

fn multiply(i32 x, i32 y) i32:
  return x * y

fn main() i32:
  let i32 sum = add(5, 3)
  let i32 product = multiply(6, 7)

  # sum = 8, product = 42
  println("Sum: {sum}, Prod: {product}")
  return product
