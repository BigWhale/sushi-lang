# EXPECT_STDOUT_EXACT: "Result: Error reading config\n"
# EXPECT_RUNTIME_EXIT: 0
# Test ?? operator over the IoError channel that open() and every read answer.
# This demonstrates error propagation for file operations

use <io/files>
use <io/fs>
use <io/contracts>

fn read_first_line(string path) string | IoError:
    # Use ?? to unwrap the Result from open()
    # If file doesn't exist, propagates Result.Err() to caller
    let File f = open(path, FileMode.Read())??

    # Read the first line
    let string line = f.line_or_empty()
    f.close()

    return Result.Ok(line)

fn process_config() string | IoError:
    # Use ?? to propagate errors from read_first_line()
    # If read_first_line returns Result.Err(), propagates to caller
    let string first_line = read_first_line("config.txt")??

    return Result.Ok(first_line)

# Reads one line and substitutes an empty string for the end of the file. readln()
# answers Maybe@(string) now, so a caller that does not care which of the two it got
# says so once, here, rather than losing the distinction at every call.
extend File line_or_empty() string:
    match self.readln():
        Result.Ok(Maybe.Some(line)) -> return line.clone()
        Result.Ok(Maybe.None) -> return ""
        Result.Err(_) -> return ""

fn main() i32:
    # Test error propagation over the IoError channel
    let string result = process_config().realise("Error reading config")
    println("Result: {result}")

    return Result.Ok(0)
