# A run-time repeat count that is negative CLAMPS to zero. A count of zero was already
# data rather than an error (#478, Ruling 2), so a negative one reaching the same answer
# needs no rule of its own. It also keeps the unsigned walk safe by construction.
#
# A RANGE follows the same rule: a range always goes up, so `0..neg` with a negative
# `neg` is empty and agrees with `foreach(i in 0..neg)`, which yields nothing.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "0\n0\n1 7\n"


fn run_test() i32:
    let i32 neg = 0 - 1
    let i32[] a = from([7; neg])
    println(a.len())

    let i32[] b = from([0..neg])
    println(b.len())

    # Still an ordinary array afterwards.
    a.push(7)
    println("{a.len()} {a[0]}")
    return 0

fn main() i32:
    let i32 result = run_test()
    return result
