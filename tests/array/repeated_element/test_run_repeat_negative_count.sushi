# Ruling 6: a run-time repeat count that is negative TRAPS. `emit_container_walk` compares
# with an unsigned predicate, so -1 would read as four billion and the fill would run off
# the end of the buffer. A clamp to zero would turn a wrong program into a silent one.
# EXPECT_RUNTIME_EXIT: 1
# EXPECT_STDERR_CONTAINS: "RE2024"
# EXPECT_STDOUT_EXACT: ""

use <io/stdio>

fn run_test() i32:
    let i32 n = 0 - 1
    let i32[] a = from([7; n])
    println(a.len())
    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
