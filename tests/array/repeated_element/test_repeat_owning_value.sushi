# Ruling 7: CE2018 retires. A repeated OWNING value is a BORROW, and every slot takes its
# own `copy_out` -- the shape `.fill()` already uses (#479). The literal twin of
# tests/array/fill/test_fill_owning_named_local.sushi.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "babel babel babel\nbabel babel\nbabel\n"

use <collections/strings>

fn run_test() i32:
    let string word = "babelfish".s(0, 5)
    let i32 n = 3

    let string[] a = from([word; n])
    println("{a[0]} {a[1]} {a[2]}")

    let string[2] b = [word; 2]
    println("{b[0]} {b[1]}")

    println(word)
    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
