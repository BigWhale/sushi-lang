# An owning fixed array MOVES: `a := b` frees the old elements of `a` and takes the
# elements of `b`, so each element is freed once.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "pre-p pre-q\n"
# EXPECT_NO_LEAKS: true

fn main() i32:
    let string prefix = "pre"
    let string[2] a = ["{prefix}-x", "{prefix}-y"]
    let string[2] b = ["{prefix}-p", "{prefix}-q"]
    a := b
    println("{a[0]} {a[1]}")
    return 0
