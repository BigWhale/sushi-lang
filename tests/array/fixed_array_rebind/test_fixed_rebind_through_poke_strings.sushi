# A rebind through a `poke` parameter frees the caller's old elements and stores the
# new value in the caller's array.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "pre-p pre-q\n"
# EXPECT_NO_LEAKS: true

fn reset(poke string[2] a) ~:
    let string prefix = "pre"
    a := ["{prefix}-p", "{prefix}-q"]

fn main() i32:
    let string prefix = "pre"
    let string[2] local = ["{prefix}-x", "{prefix}-y"]
    reset(poke local)
    println("{local[0]} {local[1]}")
    return 0
