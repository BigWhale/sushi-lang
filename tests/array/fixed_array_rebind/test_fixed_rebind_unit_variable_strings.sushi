# A rebind of an owning fixed-array unit variable drops the old elements and takes the
# new value. The second rebind drops heap strings. The last value is from a literal,
# because a unit variable is never destroyed at exit.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "p q\npre-r pre-s\nt u\n"
# EXPECT_NO_LEAKS: true

var string[2] names = ["x", "y"]

fn main() i32:
    names := ["p", "q"]
    println("{names[0]} {names[1]}")
    let string prefix = "pre"
    names := ["{prefix}-r", "{prefix}-s"]
    println("{names[0]} {names[1]}")
    names := ["t", "u"]
    println("{names[0]} {names[1]}")
    return 0
