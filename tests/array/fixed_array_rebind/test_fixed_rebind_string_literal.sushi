# An owning fixed array rebind destroys the old elements, then takes the new value.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "pre-p pre-q\n"
# EXPECT_NO_LEAKS: true

fn main() i32:
    let string prefix = "pre"
    let string[2] a = ["{prefix}-x", "{prefix}-y"]
    a := ["{prefix}-p", "{prefix}-q"]
    println("{a[0]} {a[1]}")
    return 0
