# Every primitive element type across a dynamic array, exercising the paths that ask
# for an element size: the initial malloc, the growth realloc under push, and the
# strided read. Nothing enumerated this matrix, which is how four cells (#375) stayed
# broken. Values are chosen so a wrong stride changes the printed sum.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_CONTAINS: "i8 60 i16 600 i32 60000 i64 6000000000"
# EXPECT_STDOUT_CONTAINS: "u8 60 u16 600 u32 60000 u64 6000000000"
# EXPECT_STDOUT_CONTAINS: "f32 6.5 f64 6.5 bool 2"
# EXPECT_NO_LEAKS: true

fn sum_i64(i64[] xs) i64:
    let i64 total = 0 as i64
    foreach(x in xs.iter()):
        total := total + x
    return Result.Ok(total)

fn run_test() i32:
    # Each array is built, then GROWN with a push, so the realloc path sizes elements too.
    let i8[] a8 = from([10 as i8, 20 as i8])
    a8.push(30 as i8)
    let i16[] a16 = from([100 as i16, 200 as i16])
    a16.push(300 as i16)
    let i32[] a32 = from([10000, 20000])
    a32.push(30000)
    let i64[] a64 = from([1000000000 as i64, 2000000000 as i64])
    a64.push(3000000000 as i64)

    let i8 s8 = a8[0] + a8[1] + a8[2]
    let i16 s16 = a16[0] + a16[1] + a16[2]
    let i32 s32 = a32[0] + a32[1] + a32[2]
    let i64 s64 = sum_i64(a64)??
    println("i8 {s8} i16 {s16} i32 {s32} i64 {s64}")

    let u8[] b8 = from([10 as u8, 20 as u8])
    b8.push(30 as u8)
    let u16[] b16 = from([100 as u16, 200 as u16])
    b16.push(300 as u16)
    let u32[] b32 = from([10000 as u32, 20000 as u32])
    b32.push(30000 as u32)
    let u64[] b64 = from([1000000000 as u64, 2000000000 as u64])
    b64.push(3000000000 as u64)

    let u8 t8 = b8[0] + b8[1] + b8[2]
    let u16 t16 = b16[0] + b16[1] + b16[2]
    let u32 t32 = b32[0] + b32[1] + b32[2]
    let u64 t64 = b64[0] + b64[1] + b64[2]
    println("u8 {t8} u16 {t16} u32 {t32} u64 {t64}")

    let f32[] c32 = from([1.5, 2.0])
    c32.push(3.0)
    let f64[] c64 = from([1.5, 2.0])
    c64.push(3.0)
    let bool[] flags = from([true, false])
    flags.push(true)

    let f32 u32sum = c32[0] + c32[1] + c32[2]
    let f64 u64sum = c64[0] + c64[1] + c64[2]
    let i32 trues = 0
    foreach(f in flags.iter()):
        if (f):
            trues := trues + 1
    println("f32 {u32sum} f64 {u64sum} bool {trues}")

    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
