# Regression for #476: `.fill()` overwrote each slot without destroying what it held, so
# an array of owning elements leaked one buffer per slot. The store goes through the same
# destroy-then-store shape that `arr[i] := v` already used.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_CONTAINS: "clean clean"

use <io/stdio>
use <collections/strings>

fn run_test() i32:
    let string[] towels = from(["dirty".upper(), "wet".upper()])
    towels.fill("clean")

    println("{towels.get(0)??} {towels.get(1)??}")
    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
