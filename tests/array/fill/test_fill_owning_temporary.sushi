# Regression for #476, the issue's own program: an owning TEMPORARY filled into a two
# element array gave one buffer two owners, so one free hit a dead pointer.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_CONTAINS: "cde cde"

use <collections/strings>

fn run_test() i32:
    let string src = "abcdefghij"
    let string[] arr = from(["x", "y"])
    arr.fill(src.s(2, 5))

    println("{arr.get(0)??} {arr.get(1)??}")
    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
