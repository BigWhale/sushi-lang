# Guard for #476: an EMPTY array of an owning element type has no slot to copy into. The
# argument stays a borrow, so nothing is orphaned and nothing is freed twice.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_CONTAINS: "len = 0"

use <collections/strings>

fn run_test() i32:
    let string towel = "mostly harmless".upper()
    let string[] arr = from([])
    arr.fill(towel)

    if (arr.len() != 0):
        return Result.Err(StdError.Error)
    if (towel != "MOSTLY HARMLESS"):
        return Result.Err(StdError.Error)

    println("len = {arr.len()}")
    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
