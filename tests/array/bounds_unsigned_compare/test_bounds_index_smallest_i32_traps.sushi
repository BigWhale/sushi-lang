# The smallest i32 fails the bounds check.
# EXPECT_RUNTIME_EXIT: 1
# EXPECT_STDOUT_EXACT: ""
# EXPECT_STDERR_CONTAINS: "RE2020: array index -2147483648 out of bounds for array of size 3"

fn same(i32 x) i32:
    return x

fn main() i32:
    let i32[] xs = from([10, 20, 30])
    let i32 i = same(-2147483647 - 1)
    println(xs[i])
    return 0
