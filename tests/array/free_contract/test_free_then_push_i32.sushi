# A `T[]` of a plain element grows again from no buffer after `free()`.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "0 0\n3 4\n7 8 9\n"

fn main() i32:
    let i32[] a = from([1, 2, 3, 4, 5])
    a.free()
    println("{a.len()} {a.capacity()}")
    a.push(7)
    a.push(8)
    a.push(9)
    println("{a.len()} {a.capacity()}")
    println("{a[0]} {a[1]} {a[2]}")
    return 0
