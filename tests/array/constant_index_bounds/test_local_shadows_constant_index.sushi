# A local with the name of a constant shadows it: the index is the local, and the
# compile-time bound check does not read the constant (#1137).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: 3\n
const i32 K = 7

fn main() i32:
    let i32[3] a = [1, 2, 3]
    let i32 K = 2
    println(a[K])
    return 0
