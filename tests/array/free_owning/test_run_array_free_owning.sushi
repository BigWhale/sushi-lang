# `free()` on an array of owning elements destroys each element, frees the buffer and
# leaves an empty array that is still usable. A plain element array frees the buffer only.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "0\n1\nagain\n0\n"
use <collections/strings>

fn main() i32:
    let string[] words = from(["mostly", "harmless"])
    words.push("towel".s(0, 5))
    words.free()
    println(words.len())
    words.push("again".s(0, 5))
    println(words.len())
    println(words[0])
    let i32[] nums = from([1, 2, 3])
    nums.free()
    println(nums.len())
    return Result.Ok(0)
