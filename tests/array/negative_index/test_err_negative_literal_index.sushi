# EXPECT_ERROR_CODE: CE2056
# A '-1' is a UnaryOp over an IntLit and not an IntLit, so the bounds guard asked
# for the wrong node and never saw a negative index at all. The program compiled
# and RE2020 trapped it at run time, although the compiler held the answer (#450).

fn main() i32:
    let i32[3] numbers = [10, 20, 30]
    let i32 before = numbers[-1]
    println("{before}")
    return Result.Ok(0)
