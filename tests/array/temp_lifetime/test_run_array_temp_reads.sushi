# An owning ARRAY temporary that no binding names is freed at scope exit, whichever
# way it is read (issue #382). The bound spelling was already clean, so this is the
# unbound column of that matrix: a call result, an inline `from(...)`, and a clone.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "7\n2\n8\n7\n2\n7\n2\n"
fn give() i32[]:
    return Result.Ok(from([7, 8]))

fn run_test() i32:
    println(give()??[0])
    println(give()??.len())
    println(give()??.get(1)??)

    println(from([7, 8])[0])
    println(from([7, 8]).len())

    let i32[] owned = from([7, 8])
    println(owned.clone()[0])
    println(owned.clone().len())

    return Result.Ok(0)

fn main() i32:
    return Result.Ok(run_test().realise(9))
