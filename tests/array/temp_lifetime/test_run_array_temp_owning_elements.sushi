# The temporary's ELEMENTS are freed with it (issue #382): a `string[]` whose strings
# are heap-allocated leaks one block per element as well as the data buffer, so the
# element walk is what the block count proves.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "ford1\nford1\n2\n"
fn give() string[]:
    let string a = "ford{1}"
    let string b = "arthur{2}"
    return Result.Ok(from([a, b]))

fn run_test() i32:
    println(give()??[0])
    println(give()??.get(0)??)
    println(give()??.len())
    return Result.Ok(0)

fn main() i32:
    return Result.Ok(run_test().realise(9))
