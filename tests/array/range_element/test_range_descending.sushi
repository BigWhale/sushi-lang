# Ruling 1: the direction follows `foreach`. `5..0` yields 5, 4, 3, 2, 1 and `5..=0` adds 0.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "5 5 4 3 2 1\n6 5 0\n"

use <io/stdio>

fn run_test() i32:
    let i32[] a = from([5..0])
    println("{a.len()} {a[0]} {a[1]} {a[2]} {a[3]} {a[4]}")

    let i32[] b = from([5..=0])
    println("{b.len()} {b[0]} {b[5]}")
    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
