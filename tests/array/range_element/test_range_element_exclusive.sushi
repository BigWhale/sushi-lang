# A range element fills the slots it spans (#478). `0..5` yields 5 values.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "5 0 1 2 3 4\n3 7 8 9\n"


fn run_test() i32:
    let i32[] a = from([0..5])
    println("{a.len()} {a[0]} {a[1]} {a[2]} {a[3]} {a[4]}")

    let i32[3] b = [7..10]
    println("{b.len()} {b[0]} {b[1]} {b[2]}")
    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
