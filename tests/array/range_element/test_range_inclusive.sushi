# `0..=5` yields 6 values: the formula adds one for an inclusive end (#478).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "6 0 5\n4 7 10\n"

use <io/stdio>

fn run_test() i32:
    let i32[] a = from([0..=5])
    println("{a.len()} {a[0]} {a[5]}")

    let i32[4] b = [7..=10]
    println("{b.len()} {b[0]} {b[3]}")
    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
