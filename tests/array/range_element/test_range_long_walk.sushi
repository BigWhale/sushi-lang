# Above UNROLL_LIMIT a readable range is a counted walk with a constant trip count, not a
# list of stores. This pins the VALUES; test_range_fill_tiers.py pins the IR shape.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "40 0 39 780\n"


fn run_test() i32:
    let i32[] a = from([0..40])
    let i32 total = 0
    foreach(n in a.iter()):
        total := total + n
    println("{a.len()} {a[0]} {a[39]} {total}")
    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
