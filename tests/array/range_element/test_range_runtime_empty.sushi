# Ruling 2: a count you cannot see is DATA. A run-time zero gives an empty `T[]`, the same
# value `new()` gives, and it must free cleanly.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "0\n0\n1 7\n"

use <io/stdio>

fn run_test() i32:
    let i32 n = 0
    let i32[] a = from([0..n])
    println(a.len())

    let i32[] b = from([7; n])
    println(b.len())

    b.push(7)
    println("{b.len()} {b[0]}")
    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
