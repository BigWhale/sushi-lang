# A range mixes with plain elements and with runs, and the absolute position of each is
# the sum of the counts before it (#478).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "9 0 1 2 7 7 10 11 12 99\n"


fn run_test() i32:
    let i32[] a = from([0, 1..3, 7; 2, 10..=12, 99])
    println("{a.len()} {a[0]} {a[1]} {a[2]} {a[3]} {a[4]} {a[5]} {a[6]} {a[7]} {a[8]}")
    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
