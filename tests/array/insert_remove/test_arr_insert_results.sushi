# `insert` answers `Result@(~, StdError)`: `??` in a `| StdError` body, `.is_ok()`, and
# a match on the Err. an index past `len` or below zero is an Err, and the consumed
# owning element is destroyed. a self-alias through `.clone()` is legal, and so is one of
# a plain element.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "fill 3\nfill failed\ntrue false false\nerr past\nerr below 2\ny,x,y,\n2 1 2\n"
use <collections/strings>

fn fill(poke string[] a, i32 at) ~ | StdError:
    a.insert(at, "w".concat("x"))??
    a.insert(0, "v".clone())??
    return Result.Ok(~)

fn main() i32:
    let string[] s = from(["a".clone()])
    match fill(poke s, 1):
        Result.Ok(_) -> println("fill {s.len()}")
        Result.Err(_) -> println("fill failed")
    match fill(poke s, 9):
        Result.Ok(_) -> println("fill {s.len()}")
        Result.Err(_) -> println("fill failed")

    let i32[] n = from([1])
    let bool a = n.insert(1, 2).is_ok()
    let bool b = n.insert(3, 3).is_ok()
    let bool c = n.insert(-1, 3).is_ok()
    println("{a} {b} {c}")

    let string[] t = from(["p".clone(), "q".clone()])
    match t.insert(3, "z".concat("z")):
        Result.Ok(_) -> println("ok")
        Result.Err(StdError.Error) -> println("err past")
    match t.insert(-1, "y".concat("y")):
        Result.Ok(_) -> println("ok")
        Result.Err(_) -> println("err below {t.len()}")

    let string[] w = from(["x".clone(), "y".clone()])
    w.insert(0, w[1].clone())
    let string out = ""
    foreach(x in w.iter()):
        out := "{out}{x},"
    println(out)
    let i32[] v = from([1, 2])
    v.insert(0, v[1])
    println("{v[0]} {v[1]} {v[2]}")
    return 0
