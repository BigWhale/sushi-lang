# A blank-typed `new()` takes the element type of its `let`, and push and destroy work on it.
# EXPECT_NO_LEAKS

fn test_push() ~ | StdError:
  let i32[] arr = new()
  arr.push(42)
  arr.push(100)
  if (arr.len() != 2 or arr[1] != 100):
    return Result.Err(StdError.Error)
  arr.destroy()
  return Result.Ok(~)

fn test_destroy() ~ | StdError:
  let i32[] arr = new()
  arr.destroy()
  return Result.Ok(~)

fn main() i32:
  if (not test_push().is_ok()):
    return 1
  if (not test_destroy().is_ok()):
    return 2
  return 0
