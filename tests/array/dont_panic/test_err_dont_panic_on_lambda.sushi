# The marker on a lambda is refused: a lambda can outlive its function.
# COMPILER_FLAGS: --dont-panic
# EXPECT_ERROR_CODES_EXACT: CE6111

fn main() i32:
    let i32[3] a = [1, 2, 3]
    let fn(i32) -> i32 f = |i32 i| -> i32 dont_panic because "i is in range":
        return a[i]
    return f(0) - 1
