# A binary library ships a marked generic template as source. The consumer does not
# pass --dont-panic, so the template meets the gate in the consumer's build.
# BUILD_LIB_BINARY: dp_bin_tpl_lib.sushi
# LIB_FLAGS: --dont-panic
# EXPECT_ERROR_CODES_EXACT: CE0152
# EXPECT_STDERR_CONTAINS: "dp_bin_tpl_lib"
# EXPECT_STDERR_CONTAINS: "--dont-panic"
use <lib/dp_bin_tpl_lib>

fn main() i32:
    let i32[] xs = from([4, 2])
    return first_of(xs) - 4
