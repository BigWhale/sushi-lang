# A `const string[N]` never emitted its global, so EVERY use of it was CE0055 --
# including the copy-into-a-local shape that works for every other element type (#260).
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_CONTAINS: "len: 3"
# EXPECT_STDOUT_CONTAINS: "get: arthur"
# EXPECT_STDOUT_CONTAINS: "index: trillian"
# EXPECT_STDOUT_CONTAINS: "copy: ford"
# EXPECT_STDOUT_CONTAINS: "iter: trillian"
# EXPECT_NO_LEAKS: true

const string[3] NAMES = ["ford", "arthur", "trillian"]

fn run_test() i32:
    println("len: {NAMES.len()}")
    println("get: {NAMES.get(1)??}")
    println("index: {NAMES[2]}")

    # The copy is an ordinary local. Every element carries owned = 0, so RAII never
    # frees the bytes in .rodata.
    let string[3] copy = NAMES
    println("copy: {copy[0]}")

    foreach(name in NAMES.iter()):
        println("iter: {name}")

    let u64 h = NAMES.hash()
    if (h == 0):
        return Result.Ok(1)

    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
