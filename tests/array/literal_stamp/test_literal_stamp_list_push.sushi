# A fixed array literal with a name as a `List.push` element, where the list declares
# `i32[2]` elements (#889). It was the internal error CE0000.
# EXPECT_STDOUT_EXACT: "1 3\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true

fn main() i32:
    let i32 a = 1
    let List@(i32[2]) l = List.new()
    l.push([a, 2])
    match l.get(0):
        Maybe.Some(p) -> println("{l.len()} {p[0] + p[1]}")
        Maybe.None() -> println("none")
    return Result.Ok(0)
