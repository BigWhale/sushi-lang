# Regression for #482: a `from()` temporary is a receiver with no name, so `.iter()` and
# `.hash()` on one were CE0072 and CE0056. The element type comes from the receiver's own
# semantic type now, which every receiver has.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "6\ntrue\n"
# EXPECT_NO_LEAKS: true


fn run_test() i32:
    let i32 total = 0
    foreach(n in from([1, 2, 3]).iter()):
        total := total + n
    println(total)

    println(from([1, 2, 3]).hash() == from([1, 2, 3]).hash())
    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
