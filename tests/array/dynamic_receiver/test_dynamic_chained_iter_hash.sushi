# Regression for #482: a chained call result is the receiver #462 made ordinary to write.
# `src.ss(1, 3)` returns a fresh `T[]` with no name, so iterating it was CE0072.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "9\ntrue\n5\n"
# EXPECT_NO_LEAKS: true

use <io/stdio>

fn run_test() i32:
    let i32[] src = from([1, 2, 3, 4, 5])

    let i32 total = 0
    foreach(n in src.ss(1, 3).iter()):
        total := total + n
    println(total)

    println(src.clone().hash() == src.hash())
    println(src.len())
    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
