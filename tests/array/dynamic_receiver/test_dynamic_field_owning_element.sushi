# Regression for #482: the element type an unnamed receiver could not find is the ITERATOR's
# item type, so an owning element is where a wrong answer would show. A `string[]` field
# iterates by borrow, and the struct still owns every word.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "mostly\nharmless\n2\n"
# EXPECT_NO_LEAKS: true


struct Bag:
    string[] words

fn run_test() i32:
    let Bag b = Bag(words: from(["mostly", "harmless"]))
    foreach(w in b.words.iter()):
        println(w)
    println(b.words.len())
    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
