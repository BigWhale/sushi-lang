# Regression for #482: `.iter()` and `.hash()` on a dynamic-array FIELD. Every other method
# on a `T[]` already worked through this receiver, because `as_array_address` keeps an
# address that arrives. These two read their element type out of the name tables instead,
# and a field has no name there.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "60\ntrue\n"
# EXPECT_NO_LEAKS: true


struct Holder:
    i32[] nums

fn run_test() i32:
    let Holder h = Holder(nums: from([10, 20, 30]))

    let i32 total = 0
    foreach(n in h.nums.iter()):
        total := total + n
    println(total)

    let i32[] plain = from([10, 20, 30])
    println(h.nums.hash() == plain.hash())
    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
