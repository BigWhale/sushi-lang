# A slice bound compares at 64 bits too, and the trap prints the 64-bit bound.
# EXPECT_RUNTIME_EXIT: 1
# EXPECT_STDOUT_EXACT: ""
# EXPECT_STDERR_CONTAINS: "RE2028: slice 0..4294967296 is out of bounds for an array of size 3"
fn main() i32:
    let i32[] a = from([1, 2, 3])
    let i64 end = 4294967296
    let i32[] v = a[0..end]
    println("{v.len()}")
    return 0
