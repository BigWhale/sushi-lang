# The check of a method that traps compares at 64 bits, and the trap prints the 64-bit index.
# EXPECT_RUNTIME_EXIT: 1
# EXPECT_STDOUT_EXACT: ""
# EXPECT_STDERR_CONTAINS: "RE2020: array index 4294967296 out of bounds for array of size 3"
fn main() i32:
    let i32[] a = from([1, 2, 3])
    let i64 at = 4294967296
    a.swap(0, at)
    println("{a[0]}")
    return 0
