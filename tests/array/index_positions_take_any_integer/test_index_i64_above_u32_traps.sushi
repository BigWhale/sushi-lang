# The bounds check compares at 64 bits. An i64 index of 2^32 must not read as 0 and pass.
# EXPECT_RUNTIME_EXIT: 1
# EXPECT_STDOUT_EXACT: ""
# EXPECT_STDERR_CONTAINS: "RE2020: array index 4294967296 out of bounds for array of size 3"
fn main() i32:
    let i32[] a = from([1, 2, 3])
    let i64 at = 4294967296
    println("{a[at]}")
    return 0
