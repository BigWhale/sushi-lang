# `from([(0..n).rev()])` counts down at run time, and it is empty when n is 0. A long
# run with a computed bound is a walk.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "4 3 0\n0\n3 7 5\n0\n12 11 0\n4 1 9 8 2\n"

fn run_test() i32:
    let i32 n = 4
    let i32[] a = from([(0..n).rev()])
    println("{a.len()} {a[0]} {a[3]}")

    let i32 zero = 0
    let i32[] b = from([(0..zero).rev()])
    println(b.len())

    let i32 lo = 5
    let i32 hi = 7
    let i32[] c = from([(lo..=hi).rev()])
    println("{c.len()} {c[0]} {c[2]}")

    let i32[] d = from([(hi..=lo).rev()])
    println(d.len())

    let i32 twelve = 12
    let i32[] e = from([(0..twelve).rev()])
    println("{e.len()} {e[0]} {e[11]}")

    let i32[] f = from([1, (8..=hi + 2).rev(), 2])
    println("{f.len()} {f[0]} {f[1]} {f[2]} {f[3]}")
    return 0

fn main() i32:
    let i32 result = run_test()
    return result
