# Regression for #460: the cause was `new()` emitting a scalar placeholder, so every position
# that reads it as a VALUE was broken. A call argument was CE0017, an enum payload packed the
# placeholder and aborted at scope exit, and a rebind crashed the compiler outright.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "arg = 0\npayload = 0\nrebind = 0\nfield = 0\n"
# EXPECT_NO_LEAKS: true

struct Holder:
    i32[] nums

fn count(i32[] xs) i32:
    return Result.Ok(xs.len())

fn mk() i32[]:
    return Result.Ok(new())

fn probe() ~:
    println("arg = {count(new())??}")

    match mk():
        Result.Ok(m) -> println("payload = {m.len()}")
        Result.Err(_) -> println("payload = ?")

    let i32[] r = from([1, 2])
    r := new()
    println("rebind = {r.len()}")

    let Holder h = Holder(nums: new())
    println("field = {h.nums.len()}")
    return Result.Ok(~)

fn main() i32:
    probe()
    return Result.Ok(0)
