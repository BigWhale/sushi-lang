# Regression for #460: `Maybe@(i32[]).realise(new())` failed the same way as the Result twin,
# through the same emitter.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "some = 3\nnone = 0\n"
# EXPECT_NO_LEAKS: true

fn probe() ~:
    let i32[] src = from([7, 8, 9])
    let Maybe@(i32[]) some = Maybe.Some(src.clone())
    let i32[] v = some.realise(new())
    println("some = {v.len()}")

    let Maybe@(i32[]) none = Maybe.None()
    let i32[] e = none.realise(new())
    println("none = {e.len()}")
    return Result.Ok(~)

fn main() i32:
    probe()
    return Result.Ok(0)
