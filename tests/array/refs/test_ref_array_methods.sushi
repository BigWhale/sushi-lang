# EXPECT_STDOUT_EXACT: "3\n10\n30\n3\n20\n"
# Test reference to dynamic array with method calls

fn array_info(poke i32[] arr) ~ | StdError:
    println(arr.len())
    println(arr.get(0).or_err(nom StdError.Error)??)
    println(arr.get(2).or_err(nom StdError.Error)??)
    return Result.Ok(~)

fn run_test() i32 | StdError:
    let i32[] numbers = from([10, 20, 30])

    # Pass array by reference
    array_info(poke numbers)

    # Array still valid and unchanged
    println(numbers.len())
    println(numbers.get(1).or_err(nom StdError.Error)??)

    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return result
