# An array whose elements transitively contain a dynamic array HASHES (#284).
#
# This file replaces `test_err_hash_nested_arrays.sushi`, which pinned CE0052 for this
# shape. That rejection was not a backend limit -- it was issue #284 wearing a different
# code. `Row[]` parsed as DynamicArrayType(UnknownType("Row")), so the element hasher
# matched neither its StructType arm nor its EnumType arm and fell to the `else`, which
# raises CE0052. With the element resolved, it takes the StructType arm and calls the
# `Row.hash()` the compiler already auto-derives -- a lone `Row` with an `i32[]` field
# has always hashed.
#
# CE0052 stays reachable for the shape it is really about: an element the compiler gives
# no hash at all, such as a foreign `ptr`.
#
# Pinned by BEHAVIOUR, never by value: equal contents hash equal, different contents do
# not. The hash algorithm is free to change.
# EXPECT_STDOUT_EXACT: "same: 1\ndiff: 0\nelement: 1\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS
struct Row:
    i32[] cells

fn main() i32:
    let Row[] rows = from([Row(from([1, 2]))])
    let Row[] same = from([Row(from([1, 2]))])
    let Row[] diff = from([Row(from([1, 3]))])
    println("same: {rows.hash() == same.hash()}")
    println("diff: {rows.hash() == diff.hash()}")

    let Row one = Row(from([1, 2]))
    let Row two = Row(from([1, 2]))
    println("element: {one.hash() == two.hash()}")
    return Result.Ok(0)
