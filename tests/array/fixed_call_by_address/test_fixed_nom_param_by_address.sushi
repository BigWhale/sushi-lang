# a `nom` parameter of a fixed array of more than 64 bytes is a pointer too. The element
# is plain, so the caller keeps its value: a write in the callee changes the copy of the
# callee only. The IR has no first-class load, store or parameter of the whole array.
# The IR is read before any pass.
# COMPILER_FLAGS: --opt none
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "6 1\n"
# EXPECT_IR_LACKS: eat load [4 x [32 x i32]]
# EXPECT_IR_LACKS: eat [4 x [32 x i32]] %
# EXPECT_IR_LACKS: user_main load [4 x [32 x i32]]
# EXPECT_IR_LACKS: user_main store [4 x [32 x i32]]
# EXPECT_IR_LACKS: user_main ([4 x [32 x i32]]
fn eat(nom i32[32][4] g) i32:
    g[0][0] := 5
    return g[0][0] + g[1][1]

fn main() i32:
    let i32[32][4] g = [[1; 32]; 4]
    println("{eat(nom g)} {g[0][0]}")
    return 0
