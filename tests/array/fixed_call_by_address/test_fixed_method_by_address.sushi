# an extension method on a struct takes a fixed array of more than 64 bytes by address,
# and answers one in a slot of the caller. The IR has no first-class load, store,
# parameter or return of the whole array in the method and in the caller. The IR is read
# before any pass.
# COMPILER_FLAGS: --opt none
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "8 4\n"
# EXPECT_IR_LACKS: Board_score load [4 x [32 x i32]]
# EXPECT_IR_LACKS: Board_score [4 x [32 x i32]] %
# EXPECT_IR_LACKS: Board_fill [4 x [32 x i32]] @
# EXPECT_IR_LACKS: Board_fill ret [4 x [32 x i32]]
# EXPECT_IR_LACKS: user_main load [4 x [32 x i32]]
# EXPECT_IR_LACKS: user_main store [4 x [32 x i32]]
# EXPECT_IR_LACKS: user_main , [4 x [32 x i32]]
# EXPECT_IR_LACKS: user_main call [4 x [32 x i32]]
struct Board:
    i32 base

extend Board score(i32[32][4] g) i32:
    return self.base + g[2][9]

extend Board fill() i32[32][4]:
    return [[self.base + 3; 32]; 4]

fn main() i32:
    let Board b = Board(1)
    let i32[32][4] g = [[7; 32]; 4]
    let i32[32][4] f = b.fill()
    println("{b.score(g)} {f[0][0]}")
    return 0
