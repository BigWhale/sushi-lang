# a fixed array of more than 64 bytes crosses a call boundary by address: a by-value
# parameter is a pointer, and the callee copies the bytes into its own slot. The IR has
# no first-class load, store or parameter of the whole array, in the callee and in the
# caller. A write to the parameter does not change the value of the caller. The IR is
# read before any pass.
# COMPILER_FLAGS: --opt none
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "7 9 1\n"
# EXPECT_IR_LACKS: total load [4 x [32 x i32]]
# EXPECT_IR_LACKS: total [4 x [32 x i32]] %
# EXPECT_IR_LACKS: bump load [4 x [32 x i32]]
# EXPECT_IR_LACKS: bump [4 x [32 x i32]] %
# EXPECT_IR_LACKS: user_main load [4 x [32 x i32]]
# EXPECT_IR_LACKS: user_main store [4 x [32 x i32]]
# EXPECT_IR_LACKS: user_main ([4 x [32 x i32]]
fn total(i32[32][4] g) i32:
    return g[3][31]

fn bump(i32[32][4] g) i32:
    g := [[9; 32]; 4]
    return g[0][0]

fn main() i32:
    let i32[32][4] g = [[1; 32]; 4]
    g[3][31] := 7
    println("{total(g)} {bump(g)} {g[0][0]}")
    return 0
