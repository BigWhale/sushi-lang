# a function that answers a fixed array of more than 64 bytes writes it into a slot that
# the caller gives, and answers nothing. The IR has no first-class return, load, store or
# call result of the whole array. The answer goes into a local, into an element of a
# nested array and into a rebound local. The IR is read before any pass.
# COMPILER_FLAGS: --opt none
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "7 8 3 7\n"
# EXPECT_IR_LACKS: make load [4 x [32 x i32]]
# EXPECT_IR_LACKS: make ret [4 x [32 x i32]]
# EXPECT_IR_LACKS: make [4 x [32 x i32]] @
# EXPECT_IR_LACKS: user_main load [4 x [32 x i32]]
# EXPECT_IR_LACKS: user_main store [4 x [32 x i32]]
# EXPECT_IR_LACKS: user_main call [4 x [32 x i32]]
fn make(i32 v) i32[32][4]:
    let i32[32][4] g = [[v; 32]; 4]
    g[2][2] := 3
    return g

fn main() i32:
    let i32[32][4] g = make(7)
    let i32[32][4][2] pair = [g, g]
    pair[1] := make(8)
    g := make(g[0][0])
    println("{g[0][0]} {pair[1][3][3]} {g[2][2]} {pair[0][1][1]}")
    return 0
