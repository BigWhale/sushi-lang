# An empty array: `.min()` and `.max()` give `Maybe.None()`, and `.add_up()` gives zero.
# EXPECT_STDOUT_EXACT: "none none 0 0\n"
# EXPECT_RUNTIME_EXIT: 0
fn word(Maybe@(i32) m) string:
    match m:
        Maybe.Some(_) -> return "some"
        Maybe.None() -> return "none"

fn main() i32:
    let i32[] xs = from([])
    let f64[] ys = from([])
    println("{word(xs.min())} {word(xs.max())} {xs.add_up()} {ys.add_up()}")
    return 0
