# A struct element is read through the wrapper `.get()` answers, never through a dot
# on the wrapper itself. The second read used to be `points.get(1).x`, which compiled
# clean and printed the enum TAG -- 0, where the element's `x` is 11 (#666).
# EXPECT_STDOUT_EXACT: "P: 11\nS: 32\n"
struct Point:
    i32 x
    i32 y

fn run_test() i32:
    let Point[] points = from([Point(10, 32), Point(11, 33), Point(12, 34)])
    let Point single = points.get(0)??
    let Point second = points.get(1)??
    println("P: {second.x}")
    println("S: {single.y}")
    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
