# `clear()` empties the array and KEEPS the buffer: len goes to 0, capacity and the
# data pointer stay -- the point is reuse in a loop without a realloc. An owning
# element is destroyed, not leaked.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "0\ntrue\n9\n1\n0\n"
fn run_test() i32:
    let i32[] a = from([1, 2, 3])
    let i32 cap_before = a.capacity()
    a.clear()
    println(a.len())
    println("{a.capacity() == cap_before}")

    a.push(9)
    println(a.get(0).realise(-1))
    println(a.len())

    let string[] words = from(["alpha", "beta"])
    words.clear()
    println(words.len())

    return Result.Ok(0)

fn main() i32:
    return Result.Ok(run_test().realise(9))
