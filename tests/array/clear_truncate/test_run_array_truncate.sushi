# `truncate(n)` keeps the first n elements and destroys the rest. A count past the
# length is a no-op -- truncate never grows. A negative count clamps to 0, the way
# the slice family clamps. Capacity and the buffer stay.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "2\n2\n2\n0\n1\nalpha\n"
fn run_test() i32:
    let i32[] a = from([1, 2, 3, 4, 5])
    a.truncate(2)
    println(a.len())
    println(a.get(1).realise(-1))

    a.truncate(9)
    println(a.len())

    a.truncate(-3)
    println(a.len())

    let string[] words = from(["alpha", "beta", "gamma"])
    words.truncate(1)
    println(words.len())
    match words.first():
        Maybe.Some(w) -> println(w)
        Maybe.None() -> println("none")

    return Result.Ok(0)

fn main() i32:
    return Result.Ok(run_test().realise(9))
