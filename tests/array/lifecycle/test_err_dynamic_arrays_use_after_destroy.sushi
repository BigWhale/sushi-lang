# A use after `destroy()` is ONE error, CE2406 from the borrow pass (#1137).
# EXPECT_ERROR_CODES_EXACT: CE2406
fn main() i32:
  let i32[] numbers = from([1, 2, 3])
  print(numbers.len())      # Should work - prints 3

  numbers.destroy()         # Manual destruction

  # This should fail - use after destroy
  print(numbers.len())

  return 0
