# `first()` and `last()` are `get()` with the index built in: 0, and len - 1.
# Both answer Maybe@(T) the way `get` does, on a fixed and on a dynamic array.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "10\n30\n7\n7\n10\n30\n3\n"
fn run_test() i32:
    let i32[] a = from([10, 20, 30])
    println(a.first().realise(-1))
    println(a.last().realise(-1))

    let i32[] single = from([7])
    println(single.first().realise(-1))
    println(single.last().realise(-1))

    let i32[3] f = [10, 20, 30]
    println(f.first().realise(-1))
    println(f.last().realise(-1))

    # Both are READS: the array keeps every element.
    println(a.len())

    return Result.Ok(0)

fn main() i32:
    return Result.Ok(run_test().realise(9))
