# `first()` and `last()` on an owning element type. Both are BORROWS, like `get()`:
# the array keeps the element and still frees it, so the reads must not double free.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "alpha\ngamma\n3\nalpha\n"
fn run_test() i32:
    let string[] words = from(["alpha", "beta", "gamma"])

    let string head = words.first()??
    println(head)

    let string tail = words.last()??
    println(tail)

    println(words.len())
    println(words.first()??)

    return Result.Ok(0)

fn main() i32:
    return Result.Ok(run_test().realise(9))
