# An empty array has no first and no last element, so both answer `Maybe.None()`
# for every element type. Nothing is invented and nothing leaks.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "true\ntrue\ntrue\ntrue\n-1\nnone\n"
fn run_test() i32:
    let i32[] ints = from([])
    println("{ints.first().is_none()}")
    println("{ints.last().is_none()}")

    let string[] words = from([])
    println("{words.first().is_none()}")
    println("{words.last().is_none()}")

    println(ints.last().realise(-1))

    match words.first():
        Maybe.Some(_) -> println("some")
        Maybe.None() -> println("none")

    return Result.Ok(0)

fn main() i32:
    return Result.Ok(run_test().realise(9))
