# A length is an i64 (ADR 0001, the contract step), and Sushi has no implicit narrowing:
# `let i32 n = xs.len()` is refused, once for each container kind. `as i32` is the escape.
# EXPECT_ERROR_CODES_EXACT: CE2002, CE2002, CE2002, CE2002, CE2002
use <collections/hashmap>

fn main() i32:
    let i32[] xs = from([1, 2, 3])
    let List@(i32) list = List.new()
    let HashMap@(i32, i32) map = HashMap.new()
    let string s = "Mostly Harmless"
    let i32 a = xs.len()
    let i32 b = list.len()
    let i32 c = map.len()
    let i32 d = s.len()
    let i32 e = s.size()
    let i32 ok = xs.len() as i32
    println("{a} {b} {c} {d} {e} {ok}")
    list.free()
    map.free()
    return 0
