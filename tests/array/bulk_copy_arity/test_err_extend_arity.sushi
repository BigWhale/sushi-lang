# A miscount on `extend` is an ordinary user mistake, so it reads CE2009 like every other
# built-in array method, and never the internal CE0023.
# EXPECT_ERROR_CODE: CE2009
# EXPECT_STDERR_CONTAINS: wrong number of arguments: 'i32[].extend' expects 1, got 2

fn main() i32:
    let i32[] a = from([1, 2, 3, 4])
    let i32[] b = from([5, 6])
    a.extend(b, 1)
    println("{a.len()}")
    return Result.Ok(0)
