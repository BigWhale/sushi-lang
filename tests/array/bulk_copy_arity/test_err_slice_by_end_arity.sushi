# A miscount on `s` is an ordinary user mistake, so it reads CE2009 like every other
# built-in array method, and never the internal CE0023.
# EXPECT_ERROR_CODE: CE2009
# EXPECT_STDERR_CONTAINS: wrong number of arguments: 'i32[].s' expects 2, got 1

fn main() i32:
    let i32[] a = from([1, 2, 3, 4])
    println("{a.s(1).len()}")
    println("{a.len()}")
    return Result.Ok(0)
