# CE2009 names what the user wrote and agrees in number: `i32[].get` is a method, and
# not a function, and it takes one argument.
# EXPECT_ERROR_CODE: CE2009
# EXPECT_STDERR_CONTAINS: wrong number of arguments: 'i32[].get' expects 1, got 2

fn main() i32:
    let i32[] a = from([1, 2, 3])
    let Maybe@(i32) m = a.get(1, 2)
    println("{m.realise(0)}")
    return Result.Ok(0)
