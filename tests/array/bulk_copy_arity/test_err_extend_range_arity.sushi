# A miscount on `extend_range` is an ordinary user mistake, so it reads CE2009 like every other
# built-in array method, and never the internal CE0023.
# EXPECT_ERROR_CODE: CE2009
# EXPECT_STDERR_CONTAINS: wrong number of arguments: 'i32[].extend_range' expects 3, got 1

fn main() i32:
    let i32[] a = from([1, 2, 3, 4])
    let i32[] b = from([5, 6])
    a.extend_range(b)
    println("{a.len()}")
    return Result.Ok(0)
