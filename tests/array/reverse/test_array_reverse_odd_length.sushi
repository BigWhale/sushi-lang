fn run_test() i32 | StdError:
    # Test reverse() with odd length - Arthur Dent's tea problem
    let i32[] tea_attempts = from([1, 2, 3, 4, 5, 6, 7])
    tea_attempts.reverse()

    # Verify order is reversed
    if (tea_attempts.get(0).or_err(nom StdError.Error)?? != 7):
        return Result.Err(StdError.Error)
    if (tea_attempts.get(1).or_err(nom StdError.Error)?? != 6):
        return Result.Err(StdError.Error)
    if (tea_attempts.get(2).or_err(nom StdError.Error)?? != 5):
        return Result.Err(StdError.Error)
    if (tea_attempts.get(3).or_err(nom StdError.Error)?? != 4):
        return Result.Err(StdError.Error)
    if (tea_attempts.get(4).or_err(nom StdError.Error)?? != 3):
        return Result.Err(StdError.Error)
    if (tea_attempts.get(5).or_err(nom StdError.Error)?? != 2):
        return Result.Err(StdError.Error)
    if (tea_attempts.get(6).or_err(nom StdError.Error)?? != 1):
        return Result.Err(StdError.Error)

    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return result
