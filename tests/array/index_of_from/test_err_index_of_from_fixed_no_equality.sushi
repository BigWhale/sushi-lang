# A fixed array of an element type with no equality cannot be searched either.
# EXPECT_ERROR_CODE: CE2100

struct Handler:
    fn(i32) -> i32 f

fn twice(i32 x) i32:
    return x * 2

fn main() i32:
    let Handler[1] hs = [Handler(twice)]
    return hs.index_of_from(Handler(twice), 0).realise(-1)
