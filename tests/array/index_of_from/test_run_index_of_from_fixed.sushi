# `index_of_from(v, start)` on a `T[N]`: the rule of the dynamic array, start clamped into
# 0..len(). Each line prints the index, or -1 for None.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "0\n0\n2\n4\n-1\n-1\n2\n4\n-1\n3\n-1\n3\n-1\n"
fn main() i32:
    let i32[5] f = [7, 3, 7, 5, 7]
    println(f.index_of_from(7, -1).realise(-1))
    println(f.index_of_from(7, 0).realise(-1))
    println(f.index_of_from(7, 2).realise(-1))
    println(f.index_of_from(7, 4).realise(-1))
    println(f.index_of_from(7, 5).realise(-1))
    println(f.index_of_from(7, 10).realise(-1))
    println(f.index_of_from(7, 1).realise(-1))
    println(f.index_of_from(7, 3).realise(-1))
    println(f.index_of_from(3, 2).realise(-1))
    println(f.index_of_from(5, 3).realise(-1))
    println(f.index_of_from(9, 0).realise(-1))

    let u8[4] b = [1, 2, 1, 2]
    println(b.index_of_from(2, 2).realise(-1))
    println(b.index_of_from(1, 3).realise(-1))
    return 0
