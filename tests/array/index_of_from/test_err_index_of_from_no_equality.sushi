# An element type with no equality cannot be searched: a function value has none.
# EXPECT_ERROR_CODE: CE2100

struct Handler:
    fn(i32) -> i32 f

fn twice(i32 x) i32:
    return x * 2

fn main() i32:
    let Handler[] hs = from([Handler(twice)])
    return hs.index_of_from(Handler(twice), 0).realise(-1)
