# An enum element compares by variant, then by payload. Each line prints the index, or
# -1 for None.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "1\n3\n2\n-1\n-1\n1\n-1\n1\n-1\n"
fn run_test() i32:
    let Maybe@(i32)[] ms = from([Maybe.Some(1), Maybe.None(), Maybe.Some(1), Maybe.None()])
    println(ms.index_of_from(Maybe.None(), 0).realise(-1))
    println(ms.index_of_from(Maybe.None(), 2).realise(-1))
    println(ms.index_of_from(Maybe.Some(1), 1).realise(-1))
    println(ms.index_of_from(Maybe.Some(2), 0).realise(-1))
    println(ms.index_of_from(Maybe.Some(1), 3).realise(-1))
    println(ms.index_of_from(Maybe.None(), -1).realise(-1))
    println(ms.index_of_from(Maybe.None(), 4).realise(-1))

    let Maybe@(i32)[2] fixed = [Maybe.None(), Maybe.Some(7)]
    println(fixed.index_of_from(Maybe.Some(7), 0).realise(-1))
    println(fixed.index_of_from(Maybe.None(), 1).realise(-1))
    return 0

fn main() i32:
    return run_test()
