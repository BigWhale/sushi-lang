# A struct element reads its derived equality, or its `Eq` implementation where it has
# one. Each line prints the index, or -1 for None.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "2\n-1\n0\n-1\n-1\n1\n-1\n2\n"
struct Point:
    i32 x
    i32 y

struct Tagged:
    i32 key
    i32 noise

extend Tagged with Eq:
    fn eq(Tagged other) bool:
        return self.key == other.key

fn run_test() i32:
    let Point[] pts = from([Point(1, 2), Point(3, 4), Point(1, 2)])
    println(pts.index_of_from(Point(1, 2), 1).realise(-1))
    println(pts.index_of_from(Point(3, 4), 2).realise(-1))
    println(pts.index_of_from(Point(1, 2), -1).realise(-1))
    println(pts.index_of_from(Point(9, 9), 0).realise(-1))
    println(pts.index_of_from(Point(1, 2), 3).realise(-1))

    let Point[3] fixed = [Point(1, 2), Point(3, 4), Point(1, 2)]
    println(fixed.index_of_from(Point(3, 4), 1).realise(-1))
    println(fixed.index_of_from(Point(1, 2), 8).realise(-1))

    let Tagged[] tags = from([Tagged(5, 0), Tagged(6, 0), Tagged(5, 1)])
    println(tags.index_of_from(Tagged(5, 99), 1).realise(-1))
    return 0

fn main() i32:
    return run_test()
