# `index_of_from(v, start)` on a `T[]`: the first index i >= start whose element equals v.
# The start is clamped into 0..len(): a negative start reads from 0, and a start at or past
# the end answers None. Each line prints the index, or -1 for None.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "0\n0\n2\n4\n-1\n-1\n2\n4\n-1\n3\n-1\n1\n-1\n-1\n"
fn run_test() i32:
    let i32[] a = from([7, 3, 7, 5, 7])
    println(a.index_of_from(7, -1).realise(-1))
    println(a.index_of_from(7, 0).realise(-1))
    println(a.index_of_from(7, 2).realise(-1))
    println(a.index_of_from(7, 4).realise(-1))
    println(a.index_of_from(7, 5).realise(-1))
    println(a.index_of_from(7, 10).realise(-1))
    println(a.index_of_from(7, 1).realise(-1))
    println(a.index_of_from(7, 3).realise(-1))
    println(a.index_of_from(3, 2).realise(-1))
    println(a.index_of_from(5, 3).realise(-1))
    println(a.index_of_from(9, 0).realise(-1))

    let i32 start = -7
    println(a.index_of_from(3, start).realise(-1))

    let i32[] empty = from([])
    println(empty.index_of_from(1, 0).realise(-1))
    println(empty.index_of_from(1, -1).realise(-1))
    return 0

fn main() i32:
    return run_test()
