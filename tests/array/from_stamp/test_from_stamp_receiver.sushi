# A `from()` literal as a method receiver has no declared type, so the typecheck pass
# stamps the element type it infers from the elements (#868). The backend used to guess
# it from the LLVM type: i32 for a u32, an f32 and a string element alike.
# EXPECT_STDOUT_EXACT: "4000000000\n2.25\nMOSTLY\n1\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true

use <collections/strings>

fn main() i32:
    let u32 big = 4000000000
    let string s = "mostly"
    println(from([big, 1 as u32]).get(0).realise(0 as u32))
    println(from([1.5 as f32, 2.25 as f32]).get(1).realise(0.0 as f32))
    println(from([s.upper(), "harmless"]).get(0).realise("none"))
    println(from([s.upper()]).len())
    return Result.Ok(0)
