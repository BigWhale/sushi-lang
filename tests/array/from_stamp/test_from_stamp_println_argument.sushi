# A `from()` literal inside a `println` argument -- an interpolation hole -- has no
# declared type, so the typecheck pass stamps the element type it infers (#868).
# EXPECT_STDOUT_EXACT: "4000000000 2.25 MOSTLY 2\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true

use <collections/strings>

fn main() i32:
    let u32 big = 4000000000
    let string s = "mostly"
    println("{from([big]).get(0).realise(0 as u32)} {from([2.25 as f32]).get(0).realise(0.0 as f32)} {from([s.upper()]).get(0).realise('none')} {from([s.upper(), s.lower()]).len()}")
    return Result.Ok(0)
