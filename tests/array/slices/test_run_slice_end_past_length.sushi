# S2: an end past the length traps at run time, with both bounds and the length.
# EXPECT_RUNTIME_EXIT: 1
# EXPECT_STDOUT_EXACT: ""
# EXPECT_STDERR_CONTAINS: "RE2028"
# EXPECT_STDERR_CONTAINS: "slice 0..4 is out of bounds for an array of size 3"

fn main() i32:
    let i32[] data = from([1, 2, 3])
    let i32 n = data.len()
    println(data[0..n + 1].len())
    return 0
