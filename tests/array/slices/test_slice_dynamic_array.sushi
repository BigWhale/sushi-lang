# A slice of a T[] views a part of the array: `a..b`, `a..=b`, and `a..a` is empty.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "2: 20 30\n3: 20 30 40\n0:\n3: 20 30 40\n20\n5\n"
# EXPECT_NO_LEAKS

fn show(i32[] xs) ~:
    let string line = "{xs.len()}:"
    foreach(x in xs.iter()):
        line := "{line} {x}"
    println(line)

fn main() i32:
    let i32[] data = from([10, 20, 30, 40, 50])
    show(data[1..3])
    show(data[1..=3])
    show(data[2..2])
    let i32[] mid = data[1..4]
    show(mid)
    println(mid[0])
    println(data.len())
    return 0
