# A slice of a string[] borrows the strings: nothing is copied, and nothing is freed twice.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "2: bb cc\n3: bb cc dd\n0:\ncc\n2\n4\n"
# EXPECT_NO_LEAKS

fn show(string[] xs) ~:
    let string line = "{xs.len()}:"
    foreach(x in xs.iter()):
        line := "{line} {x}"
    println(line)

fn main() i32:
    let string[] words = from(["aa", "bb", "cc", "dd"])
    words.push("e{words.len()}")
    show(words[1..3])
    show(words[1..=3])
    show(words[0..0])
    let string[] tail = words[2..4]
    println(tail[0])
    println(tail.len())
    println(words[1..=4].len())
    return 0
