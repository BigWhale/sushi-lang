# S8: a slice of a temporary lives for one statement, so it is legal as an argument.
# The temporary is freed after the call.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "5\n4\nbbcc\n2\n"
# EXPECT_NO_LEAKS

fn make() i32[]:
    return from([1, 2, 3, 4])

fn names() string[]:
    let string[] out = from(["aa"])
    out.push("bb")
    out.push("cc")
    return out

fn total(i32[] xs) i32:
    let i32 sum = 0
    foreach(x in xs.iter()):
        sum := sum + x
    return sum

fn joined(string[] xs) string:
    let string out = ""
    foreach(x in xs.iter()):
        out := "{out}{x}"
    return out

fn main() i32:
    println(total(make()[1..3]))
    println(make()[0..=3][3])
    println(joined(names()[1..3]))
    println(names()[1..3].len())
    return 0
