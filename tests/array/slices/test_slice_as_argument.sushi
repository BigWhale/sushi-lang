# A slice goes to a function as a plain argument and as `peek`, inline and through a `let`.
# A slice of a slice and a method call on a slice read the same storage.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "9\n9\n3\n3\n5\n2\n3\n6\n"
# EXPECT_NO_LEAKS

fn total(i32[] xs) i32:
    let i32 sum = 0
    foreach(x in xs.iter()):
        sum := sum + x
    return sum

fn total_peek(peek i32[] xs) i32:
    return total(xs)

fn main() i32:
    let i32[] data = from([1, 2, 3, 4, 5])
    println(total(data[1..4]))
    println(total_peek(peek data[1..4]))
    let i32[] head = data[0..2]
    println(total(head))
    println(total_peek(peek head))
    let i32[3] fixed = [2, 3, 0]
    println(total(fixed[0..=1]))
    println(data[1..4][1..3].len())
    println(data[1..4][1])
    println(total(head[1..2]) + total(data[3..4]) + data[1..4][0] - 2)
    return 0
