# A marked body whose only `[]` is a slice removes no check: the slice keeps its range
# check (S7). The marker is inert.
# COMPILER_FLAGS: --dont-panic
# EXPECT_ERROR_CODES_EXACT: CW0004

fn head_len(i32[] xs) i32 dont_panic because "the caller passes two elements":
    return xs[0..2].len()

fn main() i32:
    let i32[] data = from([1, 2, 3])
    return head_len(data) - 2
