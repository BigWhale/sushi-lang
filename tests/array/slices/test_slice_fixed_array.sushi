# A slice of a T[N] is a T[]: `a..b`, `a..=b`, and `a..a` is empty.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "2: 2 3\n3: 2 3 4\n0:\n5: 1 2 3 4 5\n4\n"
# EXPECT_NO_LEAKS

fn show(i32[] xs) ~:
    let string line = "{xs.len()}:"
    foreach(x in xs.iter()):
        line := "{line} {x}"
    println(line)

fn main() i32:
    let i32[5] data = [1, 2, 3, 4, 5]
    show(data[1..3])
    show(data[1..=3])
    show(data[4..4])
    let i32[] all = data[0..5]
    show(all)
    println(all[3])
    return 0
