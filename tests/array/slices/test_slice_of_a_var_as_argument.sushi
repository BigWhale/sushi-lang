# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: 2\n16 28\n
# EXPECT_NO_LEAKS
#
# A slice of a unit-level `var` array, read by value as an argument. The slice is a view
# into the storage of the `var`: it owns nothing, and nothing frees it.

var i32[6] data = [1, 2, 3, 4, 5, 6]

fn first(i32[] xs) i32:
    return xs[0]

fn sum(i32[] xs) i32:
    let i32 t = 0
    foreach(i in 0..xs.len()):
        t := t + xs[i]
    return t

fn main() i32:
    println("{first(data[1..4])}")
    let i32 lo = 1
    let i32 hi = 4
    data[2] := 10
    println("{sum(data[lo..hi])} {sum(data[0..=5])}")
    return 0
