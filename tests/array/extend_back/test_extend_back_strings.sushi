# An owning element is copied one slot at a time: each new slot holds its own string, so
# the array frees every slot once.
# EXPECT_STDOUT_EXACT: "["s0", "s1", "s2", "s1", "s2"]\n["s0", "s1", "s2", "s1", "s2", "s1", "s2", "s1", "s2", "s1"]\n["s0", "s1", "s2", "s1", "s2", "s1", "s2", "s1", "s2", "s1", "s1", "s1", "s1"]\n["s0", "s1", "s2", "s1", "s2", "s1", "s2", "s1", "s2", "s1", "s1", "s1", "s1", "s0", "s1"]\n["s0", "s1", "s2", "s1", "s2", "s1", "s2", "s1", "s2", "s1", "s1", "s1", "s1", "s0", "s1"]\n"
# EXPECT_NO_LEAKS
# EXPECT_RUNTIME_EXIT: 0

fn main() i32:
    let string[] s = from([])
    foreach(i in 0..3):
        s.push("s{i}")
    s.extend_back(2, 2)
    println("{s}")
    s.extend_back(2, 5)
    println("{s}")
    s.extend_back(1, 3)
    println("{s}")
    s.extend_back(13, 2)
    println("{s}")
    s.extend_back(16, 2)
    s.extend_back(1, 0)
    println("{s}")
    return 0
