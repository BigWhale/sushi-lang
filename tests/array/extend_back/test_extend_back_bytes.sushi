# `extend_back` on a `u8[]` is the LZ77 back-reference copy of a decompressor.
# EXPECT_STDOUT_EXACT: "abcabcabc\nabcabcabcab\nabcabcabcabzzzz\nabcabcabcabzzzzabca\n"
# EXPECT_RUNTIME_EXIT: 0

fn main() i32:
    let u8[] out = from([a'a', a'b', a'c'])
    out.extend_back(3, 6)
    println(out.to_string())
    out.extend_back(3, 2)
    println(out.to_string())
    out.push(a'z')
    out.extend_back(1, 3)
    println(out.to_string())
    out.extend_back(15, 4)
    println(out.to_string())
    return 0
