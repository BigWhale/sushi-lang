# A `dist` outside `1..len()`, or a `count` of 0 or less, appends nothing and reports
# nothing. An empty array has no valid `dist`.
# EXPECT_STDOUT_EXACT: "[1, 2, 3]\n[1, 2, 3]\n[1, 2, 3]\n[1, 2, 3]\n[1, 2, 3]\n[1, 2, 3]\n[1, 2, 3]\n[]\n[]\n[1, 2, 3, 1]\n"
# EXPECT_RUNTIME_EXIT: 0

fn main() i32:
    let i32[] a = from([1, 2, 3])
    a.extend_back(0, 2)
    println("{a}")
    a.extend_back(-1, 2)
    println("{a}")
    a.extend_back(4, 2)
    println("{a}")
    a.extend_back(-2147483648, 2)
    println("{a}")
    a.extend_back(1, 0)
    println("{a}")
    a.extend_back(1, -3)
    println("{a}")
    a.extend_back(2, -2147483648)
    println("{a}")

    let i32[] empty = from([])
    empty.extend_back(1, 3)
    println("{empty}")
    empty.extend_back(0, 3)
    println("{empty}")

    a.extend_back(3, 1)
    println("{a}")
    return 0
