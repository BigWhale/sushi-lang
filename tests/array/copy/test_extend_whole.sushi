# `.extend(src)` appends all of another array (#462). `zlib_compress` writes this loop.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "5 1 2 3 4 5\n3 3 4 5\n"

use <io/stdio>

fn run_test() i32:
    let i32[] out = from([1, 2])
    let i32[] body = from([3, 4, 5])
    out.extend(body)
    println("{out.len()} {out[0]} {out[1]} {out[2]} {out[3]} {out[4]}")

    # The source is a BORROW, so it stays usable.
    println("{body.len()} {body[0]} {body[1]} {body[2]}")
    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
