# `.extend_range()` clamps exactly as the slices do: one rule, one `clamp_range`.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "3 0 2 3\n1 0\n1 0\n"


fn run_test() i32:
    let i32[] src = from([1, 2, 3])
    let i32 neg = 0 - 1

    # A count past the end stops at the end.
    let i32[] a = from([0])
    a.extend_range(src, 1, 9)
    println("{a.len()} {a[0]} {a[1]} {a[2]}")

    # A negative count appends nothing.
    let i32[] b = from([0])
    b.extend_range(src, 0, neg)
    println("{b.len()} {b[0]}")

    # A start past the end appends nothing.
    let i32[] c = from([0])
    c.extend_range(src, 9, 2)
    println("{c.len()} {c[0]}")
    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
