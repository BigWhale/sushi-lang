# The source may not alias the destination (#462). Growing the destination may reallocate
# its buffer, which invalidates the source pointer mid-copy. It is also why the LZ77 loop
# in `compression/zlib` must stay a per-element loop: it copies from `out` into `out` on
# purpose, and the regions overlap.
# EXPECT_ERROR_CODE: CE2430

fn main() i32:
    let i32[] out = from([1, 2, 3])
    out.extend(out)
    println(out.len())
    return Result.Ok(0)
