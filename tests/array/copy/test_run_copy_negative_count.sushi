# A negative count traps RE2024, the same code a negative repeat count takes: one hazard,
# one code, because the walk compares with an unsigned predicate (#478, Ruling 6).
# EXPECT_RUNTIME_EXIT: 1
# EXPECT_STDOUT_EXACT: ""
# EXPECT_STDERR_CONTAINS: "RE2024"

use <io/stdio>

fn run_test() i32:
    let i32[] src = from([1, 2, 3])
    let i32[] out = new()
    let i32 n = 0 - 1
    out.extend_range(src, 0, n)
    println(out.len())
    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
