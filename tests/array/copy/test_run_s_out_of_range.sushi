# An end past the source traps RE2020. Unlike `string.s`, an array does NOT clamp: an
# array index traps everywhere in Sushi, and `.s()` shares `.ss()`'s bounds rule.
# EXPECT_RUNTIME_EXIT: 1
# EXPECT_STDOUT_EXACT: ""
# EXPECT_STDERR_CONTAINS: "RE2020"

use <io/stdio>

fn run_test() i32:
    let i32[] src = from([1, 2, 3])
    let i32[] part = src.s(1, 9)
    println(part.len())
    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
