# `.s(start, end)` slices by INDEX, with an exclusive end, the way `string.s` does (#462).
# `.ss(start, count)` slices by length. Same operation, two argument spellings.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "3 30 40 50\n6 10 60\n2 8 9\n1 20\n"

use <io/stdio>

fn run_test() i32:
    let i32[] src = from([10, 20, 30, 40, 50, 60])
    let i32[] part = src.s(2, 5)
    println("{part.len()} {part[0]} {part[1]} {part[2]}")

    # A borrow, so the source is untouched.
    println("{src.len()} {src[0]} {src[5]}")

    let i32[3] fixed = [7, 8, 9]
    let i32[] tail = fixed.s(1, 3)
    println("{tail.len()} {tail[0]} {tail[1]}")

    let i32[] one = src.s(1, 2)
    println("{one.len()} {one[0]}")
    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
