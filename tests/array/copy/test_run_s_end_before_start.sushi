# An end BEFORE the start is a negative count, which traps RE2024 -- the same code the
# copy family already uses. `string.s` answers an empty string here; an array does not
# invent one.
# EXPECT_RUNTIME_EXIT: 1
# EXPECT_STDOUT_EXACT: ""
# EXPECT_STDERR_CONTAINS: "RE2024"

use <io/stdio>

fn run_test() i32:
    let i32[] src = from([1, 2, 3])
    let i32[] part = src.s(2, 1)
    println(part.len())
    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
