# Ten thousand two-element `extend` appends keep every element in its position. The
# capacity doubles on each growth, so it ends at the first power of two that holds them.
# EXPECT_STDOUT_EXACT: "20000 32768 149985000 0\n"
# EXPECT_NO_LEAKS
# EXPECT_RUNTIME_EXIT: 0

fn main() i32:
    let i32[] out = from([])
    let i32[] chunk = from([0, 0])
    foreach(i in 0..10000):
        chunk[0] := i
        chunk[1] := i * 2
        out.extend(chunk)

    let i32 sum = 0
    let i32 wrong = 0
    foreach(k in 0..10000):
        sum := sum + out[2 * k] + out[2 * k + 1]
        if (out[2 * k] != k or out[2 * k + 1] != 2 * k):
            wrong := wrong + 1
    println("{out.len()} {out.capacity()} {sum} {wrong}")
    return 0
