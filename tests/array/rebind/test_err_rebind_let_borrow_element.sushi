# A `let` bound from a field read BORROWS the owner's storage. A write through it
# reaches storage the owner still frees, so it is CE2426.
# EXPECT_ERROR_CODE: CE2426

struct Bag:
    i32[] items

fn main() i32:
    let Bag bag = Bag(from([1, 2]))
    let i32[] view = bag.items
    view[0] := 9
    return Result.Ok(0)
