# A CONSTANT is read-only (CE2096), but a local copy of one is an ordinary local and
# is writable. A local that SHADOWS the constant name is writable too -- local wins,
# and the CE2096 gate must apply that rule, not the bare name.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_CONTAINS: "copy: 99 3 5"
# EXPECT_STDOUT_CONTAINS: "shadowed: 11"
# EXPECT_STDOUT_CONTAINS: "constant intact: 2"

const i32[3] PRIMES = [2, 3, 5]

fn shadowed() i32:
    let i32[3] PRIMES = [7, 8, 9]
    PRIMES[0] := 11
    println("shadowed: {PRIMES[0]}")
    return Result.Ok(PRIMES[0])

fn main() i32:
    let i32[3] copy = PRIMES
    copy[0] := 99
    println("copy: {copy[0]} {copy[1]} {copy[2]}")

    let i32 s = shadowed().realise(0)
    if (s != 11):
        return Result.Ok(1)

    println("constant intact: {PRIMES[0]}")

    return Result.Ok(0)
