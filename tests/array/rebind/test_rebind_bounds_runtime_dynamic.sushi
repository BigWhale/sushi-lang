# TEST_TYPE: runtime
# An indexed assignment is bounds-checked exactly like an indexed read: a dynamic
# index past the end traps RE2020 instead of writing past the buffer.
# EXPECT_RUNTIME_EXIT: 1
# EXPECT_STDOUT_CONTAINS: "before the write"

fn main() i32:
    let i32[] numbers = from([10, 20, 30])
    let i32 far = 7

    println("before the write")
    numbers[far] := 1
    println("this line must not run")

    return Result.Ok(0)
