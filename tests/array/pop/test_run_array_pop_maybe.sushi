# `arr.pop()` returns `Maybe@(T)`, matching `List@(T).pop()` and `arr.get()` (issue #377).
# A pop from an empty array has no element, so there is nothing to invent: the old bare
# `T` returned a zero, which for an `i32[]` is indistinguishable from a genuinely popped 0.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "some 8\nsome 7\nnone\n0\ntrue\nfalse\n99\n42\n255\ntrue\n"
fn run_test() i32:
    let i32[] a = from([7, 8])

    match a.pop():
        Maybe.Some(v) -> println("some {v}")
        Maybe.None() -> println("none")
    match a.pop():
        Maybe.Some(v) -> println("some {v}")
        Maybe.None() -> println("none")
    match a.pop():
        Maybe.Some(v) -> println("some {v}")
        Maybe.None() -> println("none")

    println(a.len())

    let i32[] b = from([42])
    println("{b.pop().is_some()}")
    println("{b.pop().is_some()}")

    let i32[] c = from([42, 99])
    println(c.pop().realise(-1))
    println(c.pop()??)

    let u8[] bytes = from([255 as u8])
    println(bytes.pop().realise(0 as u8))
    println("{bytes.pop().is_none()}")

    return Result.Ok(0)

fn main() i32:
    return Result.Ok(run_test().realise(9))
