# The defect issue #377 names: `.pop()` on an element type that OWNS heap. The empty
# branch of the result phi fed `Constant(element_type, 0)`, which is not a valid
# initializer for an aggregate, so a `string[]` or a struct-with-heap failed to compile
# at all -- discarding the result failed the same way.
#
# The popped element is REMOVED, so the array stops owning it and the caller starts:
# bound, it lives to scope exit; discarded, the temporary owns and frees it.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "arthur2\n1\n1\n0\n2\ntrue\n"
struct Bag:
    i32[] items

fn run_test() i32:
    let string[] words = from(["ford{1}", "arthur{2}"])
    let string last = words.pop().realise("")
    println(last)
    println(words.len())

    words.pop()
    println(words.len() + 1)
    println(words.len())

    let Bag[] bags = from([Bag(from([1, 2]))])
    let Bag b = bags.pop().realise(Bag(from([])))
    println(b.items.len())
    println("{bags.pop().is_none()}")

    return Result.Ok(0)

fn main() i32:
    return Result.Ok(run_test().realise(9))
