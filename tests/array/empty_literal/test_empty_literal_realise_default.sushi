# A bare `[]` as a `.realise()` default takes the `T[]` of the Maybe (#1345).
# EXPECT_STDOUT_EXACT: "0 2\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true

fn main() i32:
    let Maybe@(string[]) none = Maybe.None()
    let Maybe@(string[]) some = Maybe.Some(from(["a", "b"]))
    let string[] a = none.realise([])
    let string[] b = some.realise([])
    println("{a.len()} {b.len()}")
    return 0
