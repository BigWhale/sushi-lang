# A bare `[]` as an argument and as a return takes the `T[]` of its position (#1345).
# EXPECT_STDOUT_EXACT: "0 0\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true

fn count(u8[] xs) i64:
    return xs.len()

fn none() string[]:
    return []

fn main() i32:
    println("{count([])} {none().len()}")
    return 0
