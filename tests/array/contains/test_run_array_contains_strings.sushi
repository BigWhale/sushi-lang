# A string element compares by CONTENT: size, then bytes -- the `==` the language
# already defines. The needle is a BORROW: it stays usable after the call, and the
# array keeps every element, so nothing double frees.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "true\n1\nfalse\nnone\n0\ntrue\ngamma\n3\n"
use <collections/strings>

fn run_test() i32:
    let string[] words = from(["alpha", "beta", "gamma"])

    let bool has_beta = words.contains("beta")
    println("{has_beta}")
    println(words.index_of("beta").realise(-1))

    let string needle = "delta"
    let bool has_delta = words.contains(needle)
    println("{has_delta}")
    match words.index_of(needle):
        Maybe.Some(_) -> println("some")
        Maybe.None() -> println("none")

    println(words.index_of("alpha").realise(-1))

    # A heap needle: built at run time, borrowed by the call, then still ours to print.
    let string built = "gam".concat("ma")
    let bool has_built = words.contains(built)
    println("{has_built}")
    println(built)

    println(words.len())

    return Result.Ok(0)

fn main() i32:
    return Result.Ok(run_test().realise(9))
