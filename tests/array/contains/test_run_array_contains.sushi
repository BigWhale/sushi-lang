# `contains(v)` asks membership and `index_of(v)` asks WHERE, as Maybe@(i32).
# Both walk left to right, so `index_of` answers the FIRST match. An empty array
# contains nothing. Both array kinds answer.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "true\nfalse\n1\nnone\ntrue\n0\n2\nfalse\nnone\ntrue\n"
fn run_test() i32:
    let i32[] a = from([10, 20, 30])
    println("{a.contains(20)}")
    println("{a.contains(99)}")
    println(a.index_of(20).realise(-1))
    match a.index_of(99):
        Maybe.Some(_) -> println("some")
        Maybe.None() -> println("none")

    let i32[3] f = [5, 6, 5]
    println("{f.contains(6)}")
    println(f.index_of(5).realise(-1))

    let f64[] xs = from([1.5, 2.5, 3.5])
    println(xs.index_of(3.5).realise(-1))

    let i32[] empty = from([])
    println("{empty.contains(1)}")
    match empty.index_of(1):
        Maybe.Some(_) -> println("some")
        Maybe.None() -> println("none")

    let bool[] flags = from([false, true])
    println("{flags.contains(true)}")

    return Result.Ok(0)

fn main() i32:
    return Result.Ok(run_test().realise(9))
