# A `from([...])` literal handed to `.extend()` or `.extend_range()` takes the receiver's
# element type, as a `let u8[]` and a user function's `u8[]` parameter already do (#544).
# It defaulted to `i32[]` here and was CE2023 (#576).
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "6 250\n"

fn main() i32:
    let u8[] b = from([1, 2])
    b.extend(from([5, 6]))
    b.extend_range(from([250, 251, 252]), 0, 2)
    println("{b.len()} {b[4]}")
    return Result.Ok(0)
