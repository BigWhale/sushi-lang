# A new length that an i32 length cannot hold stops the program.
# EXPECT_RUNTIME_EXIT: 1
# EXPECT_STDOUT_EXACT: ""
# EXPECT_STDERR_CONTAINS: "RE2033: count 4294967297 is too large for a length"
fn main() i32:
    let i32[] a = from([1, 2, 3])
    let i64 big = 4294967297
    a.resize(big, 0)
    println(a.len())
    return 0
