# A reserve count that an i32 length cannot hold stops the program.
# EXPECT_RUNTIME_EXIT: 1
# EXPECT_STDOUT_EXACT: ""
# EXPECT_STDERR_CONTAINS: "RE2033: count 4294967297 is too large for a length"
fn main() i32:
    let List@(i32) xs = List.new()
    let i64 big = 4294967297
    xs.reserve(big)
    println(xs.capacity())
    return 0
