# A pad width that an i32 length cannot hold stops the program.
# EXPECT_RUNTIME_EXIT: 1
# EXPECT_STDOUT_EXACT: ""
# EXPECT_STDERR_CONTAINS: "RE2033: count 2147483648 is too large for a length"
fn main() i32:
    let i64 width = 2147483648
    let string s = "ab".pad_right(width, " ")
    println(s.len())
    return 0
