# `len()`, `capacity()`, `index_of` and `index_of_from` of an array answer i64 (ADR 0001,
# the contract step). The answer goes into an i64 with no cast, and arithmetic on it goes
# above 2^31 with no overflow.
# EXPECT_STDOUT_EXACT: "3000000000 true 3 2 1 3 4000000000\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS

fn main() i32:
    let i32[] xs = from([7, 8, 9])
    xs.push(8)
    let i32[3] fixed = [1, 2, 3]
    let i64 n = xs.len() - 1
    let i64 big = n * 1000000000
    let i64 cap = xs.capacity()
    let i64 fixed_len = fixed.len()
    let i64 at = xs.index_of(9).realise(-1)
    let i64 from_at = xs.index_of_from(8, 0).realise(-1)
    let i64 later = xs.index_of_from(8, 2).realise(-1)
    let i64 above = xs.len() * 1000000000
    println("{big} {cap >= xs.len()} {fixed_len} {at} {from_at} {later} {above}")
    return 0
