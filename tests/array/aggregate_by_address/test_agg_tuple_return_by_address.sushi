# a tuple whose LLVM type is more than 64 bytes moves by address, as a struct does. The IR
# has no first-class load, store, insertvalue, return or call result of the whole tuple.
# The IR is read before any pass.
# COMPILER_FLAGS: --opt none
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "x 7\n"
# EXPECT_IR_LACKS: make insertvalue %"$Tuple<string[512][4], i32>
# EXPECT_IR_LACKS: make store %"$Tuple<string[512][4], i32>
# EXPECT_IR_LACKS: make load [4 x [512 x
# EXPECT_IR_LACKS: make ret %"$Tuple<string[512][4], i32>
# EXPECT_IR_LACKS: user_main call %"$Tuple<string[512][4], i32>
# EXPECT_IR_LACKS: user_main store %"$Tuple<string[512][4], i32>
# EXPECT_IR_LACKS: user_main load %"$Tuple<string[512][4], i32>
fn make() (string[512][4], i32):
    return ([["x".clone(); 512]; 4], 7)

fn main() i32:
    let (string[512][4], i32) t = make()
    println("{t.0[3][511]} {t.1}")
    return 0
