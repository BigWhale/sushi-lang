# a closure that captures a fixed array of more than 64 bytes by move copies the bytes into
# its environment. The IR of `main` has no first-class load or store of the whole array.
# The IR is read before any pass.
# COMPILER_FLAGS: --opt none
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "4 x\n"
# EXPECT_IR_LACKS: user_main load [4 x [512 x
# EXPECT_IR_LACKS: user_main store [4 x [512 x
fn main() i32:
    let string[512][4] g = [["x".clone(); 512]; 4]
    let fn() -> i32 f = |~| g.len()
    let string[512][4] h = [["x".clone(); 512]; 4]
    let fn() -> string w = |~| h[3][511].clone()
    println("{f()} {w()}")
    return 0
