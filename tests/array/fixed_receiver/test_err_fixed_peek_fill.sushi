# A `peek` receiver is read-only, so `fill` through one is rejected in the borrow pass and
# never reaches the backend. #480 must not widen the write path far enough to lose this.
# EXPECT_ERROR_CODE: CE2408

fn zap(peek i32[3] arr) ~:
    arr.fill(0)
    return Result.Ok(~)

fn main() i32:
    let i32[3] a = [1, 2, 3]
    zap(peek a)
    return Result.Ok(0)
