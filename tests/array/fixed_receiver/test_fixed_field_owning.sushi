# Regression for #480, with #479's per-slot copy: an owning element type through a FIELD
# receiver. The write must reach the owner, each slot must take its own copy, and the
# elements the fill replaces must be destroyed.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "babel babel babel\nbabel\n"

use <io/stdio>
use <collections/strings>

struct Names:
    string[3] slots

fn run_test() i32:
    let Names n = Names(slots: ["towel", "guide", "vogon"])
    let string word = "babelfish".s(0, 5)
    n.slots.fill(word)
    println("{n.slots[0]} {n.slots[1]} {n.slots[2]}")
    println(word)
    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
