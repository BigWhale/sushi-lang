# Regression for #480: the read-only methods on a fixed-array FIELD work today, and the
# address seam must keep them working. A read may spill a temporary; a write may not.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "3\n10\n30\n60\ntrue\n"


struct Buf:
    i32[3] slots

fn run_test() i32:
    let Buf b = Buf(slots: [10, 20, 30])
    println(b.slots.len())
    println(b.slots.get(0)??)
    println(b.slots[2])

    let i32 total = 0
    foreach(n in b.slots.iter()):
        total := total + n
    println(total)

    let i32[3] plain = [10, 20, 30]
    println(b.slots.hash() == plain.hash())
    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
