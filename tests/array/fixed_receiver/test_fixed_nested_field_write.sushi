# Regression for #480: the address seam must walk a nested field chain, which is what
# `try_get_struct_alloca` already does for a dynamic array field.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "5 5 5\n"


struct Inner:
    i32[3] slots

struct Outer:
    Inner inner

fn run_test() i32:
    let Outer o = Outer(inner: Inner(slots: [1, 2, 3]))
    o.inner.slots.fill(5)
    println("{o.inner.slots[0]} {o.inner.slots[1]} {o.inner.slots[2]}")
    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
