# Regression for #480: `fill` and `reverse` on a fixed-array FIELD wrote into an alloca'd
# copy of the field, so both compiled, ran, and changed nothing. The receiver had no
# address seam, and the `alloca` fallback swallowed every receiver that was not a Name.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "9 9 9 9\n4 3 2 1\n"

use <io/stdio>

struct Buf:
    i32[4] slots

fn run_test() i32:
    let Buf b = Buf(slots: [1, 2, 3, 4])
    b.slots.fill(9)
    println("{b.slots[0]} {b.slots[1]} {b.slots[2]} {b.slots[3]}")

    let Buf c = Buf(slots: [1, 2, 3, 4])
    c.slots.reverse()
    println("{c.slots[0]} {c.slots[1]} {c.slots[2]} {c.slots[3]}")
    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
