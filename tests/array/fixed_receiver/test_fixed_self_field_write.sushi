# Regression for #480: a `poke self` receiver reaches the caller, but a fixed-array field
# read through it still produced a value, so the write went to a copy.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "7 7 7\n3 2 1\n"

use <io/stdio>

struct Buf:
    i32[3] slots

extend Buf zap(poke self) ~:
    self.slots.fill(7)
    return ~

extend Buf flip(poke self) ~:
    self.slots.reverse()
    return ~

fn run_test() i32:
    let Buf b = Buf(slots: [1, 2, 3])
    b.zap()
    println("{b.slots[0]} {b.slots[1]} {b.slots[2]}")

    let Buf c = Buf(slots: [1, 2, 3])
    c.flip()
    println("{c.slots[0]} {c.slots[1]} {c.slots[2]}")
    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
