# Regression for #480: every built-in method on a fixed array was CE0000 through a `poke`
# receiver, because such a receiver arrives as `[N x T]*` and the gate accepted only an
# `ir.ArrayType` value or a dynamic-array pointer.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "3\n1\n3\n8 8 8\n3 2 1\n"


fn report(poke i32[3] arr) ~:
    println(arr.len())
    println(arr.get(0)??)
    println(arr[2])
    return Result.Ok(~)

fn zap(poke i32[3] arr) ~:
    arr.fill(8)
    return Result.Ok(~)

fn flip(poke i32[3] arr) ~:
    arr.reverse()
    return Result.Ok(~)

fn run_test() i32:
    let i32[3] a = [1, 2, 3]
    report(poke a)

    zap(poke a)
    println("{a[0]} {a[1]} {a[2]}")

    let i32[3] b = [1, 2, 3]
    flip(poke b)
    println("{b[0]} {b[1]} {b[2]}")
    return Result.Ok(0)

fn main() i32:
    let i32 result = run_test().realise(99)
    return Result.Ok(result)
