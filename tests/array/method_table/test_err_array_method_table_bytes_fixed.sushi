# EXPECT_ERROR_CODE: CE2023
#
# to_string() reads a `u8[]`. A FIXED array of bytes is not one: its length is part of
# its type, so the row accepts a dynamic receiver alone.
fn main() i32:
    let u8[3] bytes = [104 as u8, 105 as u8, 33 as u8]
    let string text = bytes.to_string()
    println(text)
    return Result.Ok(0)
