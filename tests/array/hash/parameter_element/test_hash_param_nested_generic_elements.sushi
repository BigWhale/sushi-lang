# A struct element that holds an array of a generic instance hashes as a parameter.

struct Box@(T):
    T v

fn id(Box@(Box@(i32)[])[] x) u64:
    return x.hash()

fn main() i32:
    let Box@(i32)[] inner = from([Box(1), Box(2)])
