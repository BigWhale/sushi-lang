# An array index is an i32 position (#870): an u8 index is refused, and the help
# names the cast.
# EXPECT_ERROR_CODE: CE2006
# EXPECT_STDERR_CONTAINS: expected i32, got u8
# EXPECT_STDERR_CONTAINS: as i32
fn main() i32:
    let string[] arr = from(["hello", "world"])
    let u8 n = 0 as u8
    println(arr.get(n).realise("none"))
    return Result.Ok(0)
