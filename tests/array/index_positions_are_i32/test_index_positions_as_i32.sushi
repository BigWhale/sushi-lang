# Every i32 position takes a bare literal, and a narrow value takes 'as i32' (#870).
# The cast of a signed value sign-extends, so a negative count clamps to zero and a
# negative bound walks the right span.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "len 0\n3\niters 4\nworld\nhello\nin\n5\n7\n2\n"
fn main() i32:
    let i8 n = -1 as i8
    let i32[] a = from([7; n as i32])
    println("len {a.len()}")
    let i8 k = -3 as i8
    let i32[] c = from([k as i32..0])
    println("{c.len()}")
    let i8 lo = -2 as i8
    let i32 cnt = 0
    foreach(i in lo as i32..2):
        if (i > -100):
            cnt := cnt + 1
    println("iters {cnt}")
    let string[] arr = from(["hello", "world"])
    let u16 w = 1 as u16
    println(arr.get(w as i32).realise("none"))
    println(arr.get(0).realise("none"))
    let List@(i32) l = List.with_capacity(2)
    l.push(5)
    let u8 at = 0 as u8
    match l.insert(at as i32, 7):
        Result.Ok(_) -> println("in")
        Result.Err(_) -> println("out")
    println("{l.get(1).realise(-1)}")
    println("{l.remove(0).realise(-1)}")
    let i32[] s = from([1, 2, 3]).s(1, 3)
    println("{s.len()}")
    return Result.Ok(0)
