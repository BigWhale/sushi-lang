# A range bound is an i32 position (#870). An i8 bound was zero-extended, so -2..2 ran
# 252 times.
# EXPECT_ERROR_CODE: CE2121
# EXPECT_STDERR_CONTAINS: a range bound is i32, got i8
# EXPECT_STDERR_CONTAINS: as i32
fn main() i32:
    let i8 lo = -2 as i8
    let i32 cnt = 0
    foreach(i in lo..2):
        cnt := cnt + 1
    println("iters {cnt}")
    return 0
