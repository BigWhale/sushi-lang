# A range element's bound is an i32 position (#870). from([k..0]) with k = -3 as i8
# held 253 elements.
# EXPECT_ERROR_CODE: CE2002
# EXPECT_STDERR_CONTAINS: cannot assign i8 to i32
fn main() i32:
    let i8 k = -3 as i8
    let i32[] c = from([k..0])
    println("{c.len()}")
    return Result.Ok(0)
