# A repeat count is an i32 position (#870). A count of -1 as i8 made 255 elements.
# EXPECT_ERROR_CODE: CE2002
# EXPECT_STDERR_CONTAINS: cannot assign i8 to i32
# EXPECT_STDERR_CONTAINS: as i32
fn main() i32:
    let i8 n = -1 as i8
    let i32[] a = from([7; n])
    println("len {a.len()}")
    return Result.Ok(0)
