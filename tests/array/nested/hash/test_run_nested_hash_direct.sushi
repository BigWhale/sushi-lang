# the hash of a nested array, read on the array itself: equal values hash equal, the
# order of the rows and of the elements matters, and a fixed and a dynamic array of the
# same elements hash alike at each level.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "equal=true true\norder=false false\nkind=true true true\n"
fn main() i32:
    let i32[][] a = from([from([1]), from([2, 3])])
    let i32[][] b = from([from([1]), from([2, 3])])
    let i32[][] rows_swapped = from([from([2, 3]), from([1])])
    let i32[2][3] m = [[1, 2], [3, 4], [5, 6]]
    let i32[2][3] n = [[1, 2], [3, 4], [5, 6]]
    let i32[2][3] cells_swapped = [[2, 1], [3, 4], [5, 6]]
    println("equal={a.hash() == b.hash()} {m.hash() == n.hash()}")
    println("order={a.hash() == rows_swapped.hash()} {m.hash() == cells_swapped.hash()}")
    let i32[2][2] ff = [[1, 2], [3, 4]]
    let i32[2][] fd = from([[1, 2], [3, 4]])
    let i32[][] dd = from([from([1, 2]), from([3, 4])])
    let i32[][2] df = [from([1, 2]), from([3, 4])]
    println("kind={ff.hash() == fd.hash()} {dd.hash() == df.hash()} {ff.hash() == dd.hash()}")
    return 0
