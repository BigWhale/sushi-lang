# an owning struct element at depth inside a holder is destroyed with the holder: a
# struct field, an enum payload, a `Maybe` payload, a generic struct and a `List`.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "a 2\nb\nc 1\nd\ne\nf\n1 1 1\ndrop t\ndrop u\ndrop v\ndrop w\n"
struct Row:
    string name
    i32[] cells

struct Tok:
    string name

extend Tok with Drop:
    fn drop(poke self) ~:
        println("drop {self.name}")

struct Grid:
    Row[][] rows
    Row[3][] blocks
    Row[][2] pair

enum Shape:
    Rows(Row[][])
    Empty

struct Box@(T):
    T[] items

fn row(string n) Row:
    return Row(n.clone(), from([1, 2]))

fn main() i32:
    let Grid gr = Grid(from([from([row("a")])]), from([[row("x"), row("y"), row("c")]]), [from([row("b")]), new()])
    println("{gr.rows[0][0].name} {gr.rows[0][0].cells.len()}")
    println(gr.pair[0][0].name)
    println("{gr.blocks[0][2].name} {gr.pair[1].len() + 1}")
    let Shape s = Shape.Rows(from([from([row("d")])]))
    match s:
        Shape.Rows(r) -> println(r[0][0].name)
        Shape.Empty -> println("empty")
    let Maybe@(Row[][]) m = Maybe.Some(from([from([row("e")])]))
    match m:
        Maybe.Some(r) -> println(r[0][0].name)
        Maybe.None -> println("none")
    let Box@(Row[]) b = Box(from([from([row("f")])]))
    println(b.items[0][0].name)
    let List@(Tok[][]) l = List.new()
    l.push(from([from([Tok("w")])]))
    let Box@(Tok[2]) t = Box(from([[Tok("u"), Tok("v")]]))
    let Tok[][] solo = from([from([Tok("t")])])
    println("{solo.len()} {t.items.len()} {l.len()}")
    return 0
