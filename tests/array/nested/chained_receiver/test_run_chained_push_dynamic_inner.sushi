# A push through a chained index, `d.rows[i].push(v)`, where `d.rows[i]` is a DYNAMIC
# array, must grow the inner array in place. The push went to a copy of the descriptor:
# the length was lost, the grown buffer leaked, and the old buffer was freed twice.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "5 1 7\n1\n3 x\n"
struct H@(T):
    T[] rows

fn main() i32:
    let H@(i32[]) d = H(from([from([1, 2]), from([3])]))
    d.rows[0].push(5)
    d.rows[0].push(6)
    d.rows[0].push(7)
    println("{d.rows[0].len()} {d.rows[0][0]} {d.rows[0][4]}")
    println(d.rows[1].len())
    let H@(string[]) s = H(from([from(["a"]), from(["b"])]))
    s.rows[0].push("x")
    s.rows[0].push("y")
    println("{s.rows[0].len()} {s.rows[0][1]}")
    return 0
