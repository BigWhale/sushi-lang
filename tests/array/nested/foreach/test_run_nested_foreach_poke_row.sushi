# `foreach(poke row in ...)` over a nested array writes into each row in place: a `push`
# and an element write on `i32[][]` and `string[][]`, and an element write on `i32[3][]`
# and `i32[2][3]`.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "3 9 2\n2 9 4\nx z\ny z\n9 2 3\n9 5 6\n9 2\n9 4\n"
fn main() i32:
    let i32[][] d = from([from([1, 2]), from([4])])
    foreach(poke row in d.iter()):
        row.push(row.len() + 3)
        row[0] := 9
    println("{d[0].len()} {d[0][0]} {d[0][1]}")
    println("{d[1].len()} {d[1][0]} {d[1][1]}")
    let string[][] s = from([from(["a"]), from(["b"])])
    foreach(poke row in s.iter()):
        row.push("z")
    s[0][0] := "x"
    s[1][0] := "y"
    println("{s[0][0]} {s[0][1]}")
    println("{s[1][0]} {s[1][1]}")
    let i32[3][] f = from([[1, 2, 3], [4, 5, 6]])
    foreach(poke row in f.iter()):
        row[0] := 9
    println("{f[0][0]} {f[0][1]} {f[0][2]}")
    println("{f[1][0]} {f[1][1]} {f[1][2]}")
    let i32[2][3] m = [[1, 2], [3, 4], [5, 6]]
    foreach(poke row in m.iter()):
        row[0] := 9
    println("{m[0][0]} {m[0][1]}")
    println("{m[1][0]} {m[1][1]}")
    return 0
