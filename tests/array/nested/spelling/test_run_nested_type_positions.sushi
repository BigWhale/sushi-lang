# a nested array type in the positions where a `[` can follow a type or a cast: a
# cast inside an index, a cast whose operand is an index chain, a typed `foreach`
# binder, a lambda parameter and a function type.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "3 4\n5\n3\n6 2\n"
fn apply(fn(i32[2][3]) -> i32 f, i32[2][3] m) i32:
    return f(m)

fn main() i32:
    let i32[][] d = from([from([1]), from([2, 3, 4])])
    let u8 k = 1
    let i64 wide = d[(k as i32)][2] as i64
    println("{d[k as i32].len()} {wide}")
    let i32 sum = 0
    foreach(i32[] row in d.iter()):
        sum := sum + row.len() + row[0] - 1
    println(sum)
    let i32[2][3] m = [[1, 2], [3, 4], [5, 6]]
    let fn(i32[2][3]) -> i32 rows = |i32[2][3] g| g.len()
    println(rows(m))
    println("{apply(|i32[2][3] g| g[2][1], m)} {apply(|i32[2][3] g| g[0].len(), m)}")
    return 0
