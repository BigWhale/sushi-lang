# a write to an inner element through a `peek` root is a write through the peek, for
# a dynamic and for a fixed nested array.
# EXPECT_ERROR_CODES_EXACT: CE2408, CE2408
fn ragged(peek i32[][] a) ~:
    a[0][0] := 1

fn grid(peek i32[2][3] m) ~:
    m[2][1] := 1

fn main() i32:
    let i32[][] a = from([from([0])])
    let i32[2][3] m = [[0, 0]; 3]
    ragged(peek a)
    grid(peek m)
    return 0
