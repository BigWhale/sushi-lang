# A literal bound takes the type of the other bound, at the start and at the end. A
# negative i8 start walks up through zero.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "i16 7 8 9\ni8 -2 -1 0 1\nu32 4000000000 4000000001\n"
fn main() i32:
    let i16 start = 7
    let string a = "i16"
    foreach(x in start..10):
        let i16 v = x
        a := a.concat(" {v}")
    println(a)
    let i8 lo = -2 as i8
    let string b = "i8"
    foreach(x in lo..2):
        let i8 v = x
        b := b.concat(" {v}")
    println(b)
    let u32 end = 4000000001
    let string c = "u32"
    foreach(x in 4000000000..=end):
        let u32 v = x
        c := c.concat(" {v}")
    println(c)
    return 0
