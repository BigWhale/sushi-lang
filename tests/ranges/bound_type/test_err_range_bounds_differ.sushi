# Two typed bounds of different integer types are a type error, with help to use `as`.
# EXPECT_ERROR_CODE: CE2121
# EXPECT_STDERR_CONTAINS: a range bound is i64, got u8
# EXPECT_STDERR_CONTAINS: as i64
fn main() i32:
    let i64 a = 0
    let u8 b = 3
    foreach(i in a..b):
        println(i)
    return 0
