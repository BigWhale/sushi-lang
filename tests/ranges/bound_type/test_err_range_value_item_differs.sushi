# A range value has the item type of its bounds; an `Iterator@(i64)` does not take a u8
# range.
# EXPECT_ERROR_CODE: CE2121
# EXPECT_STDERR_CONTAINS: a range bound is i64, got u8
use <collections/iter>

fn main() i32:
    let u8 n = 3
    let Iterator@(i64) it = 0..n
    foreach(x in it):
        println(x)
    return 0
