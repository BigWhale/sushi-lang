# Two literal bounds of a run take the integer element type of the array, as in an
# `Iterator@(T)` position: an i64 run above 2^31, a u8 run, a fixed i64 array, and a run
# between single elements.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "5 0 4\n12 3000000000 3000000011\n3 250 252\n0 2\n5 -1 99\n"
fn main() i32:
    let i64[] a = from([0..5])
    println("{a.len()} {a[0]} {a[4]}")
    let i64[] b = from([3000000000..3000000012])
    println("{b.len()} {b[0]} {b[11]}")
    let u8[] c = from([250..=252])
    println("{c.len()} {c[0]} {c[2]}")
    let i64[3] d = [0..3]
    println("{d[0]} {d[2]}")
    let i64[] e = from([-1, 0..3, 99])
    println("{e.len()} {e[0]} {e[4]}")
    return 0
