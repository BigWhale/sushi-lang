# A run has the type of its bounds, and the array type of the position gives nothing to
# them: a u8 run is no i64 array.
# EXPECT_ERROR_CODE: CE2002
# EXPECT_STDERR_CONTAINS: cannot assign u8[] to i64[]
fn main() i32:
    let u8 k = 3
    let i64[] a = from([0..k])
    println("{a.len()}")
    return 0
