# R9: `public` never stands before a conversion `extend A as B:`. The design names no
# code for the refusal, only a parse or syntax error, so the fixture reads the exit
# code and the code family.
# EXPECT_STDERR_CONTAINS: error [CE6
error Low:
    Bad

error High:
    Wrapped(Low)

public extend Low as High:
    return High.Wrapped(self)

fn main() i32:
    return 0
