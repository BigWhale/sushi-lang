# R9: `public` never stands before a conversion `extend A as B:`. The refusal is the
# parse error CE6001, with a help that tells the user to remove the marker.
# EXPECT_ERROR_CODES_EXACT: CE6001
# EXPECT_STDERR_CONTAINS: error [CE6
error Low:
    Bad

error High:
    Wrapped(Low)

public extend Low as High:
    return High.Wrapped(self)

fn main() i32:
    return 0
