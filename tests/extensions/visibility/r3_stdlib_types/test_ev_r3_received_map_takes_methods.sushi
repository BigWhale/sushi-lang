# R3: the methods of a type that a stdlib module adds travel with the type. This unit
# does not import <collections/hashmap>, and it calls the methods of a map that the
# helper makes.
# EXPECT_STDOUT_EXACT: "2\ntrue\n"
# EXPECT_NO_LEAKS: true
use "helpers/ev_r3_maps"

fn main() i32:
    println(small_map().len())
    println(small_map().contains_key(1))
    return 0
