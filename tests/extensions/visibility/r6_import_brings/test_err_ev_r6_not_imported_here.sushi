# R6: the unit that declares the extension is in the program, because the helper
# imports it, but this unit does not import it. The call is refused, and the help
# names the import. The code is CE3022.
# EXPECT_ERROR_CODES_EXACT: CE3022
# EXPECT_STDERR_CONTAINS: use "helpers/ev_r6_bytes"
# EXPECT_STDERR_CONTAINS: "test_err_ev_r6_not_imported_here.sushi:11:"
use "helpers/ev_r6_user"

fn main() i32:
    println(doubled_by_user(21))
    println(21.twice_r6())
    return 0
