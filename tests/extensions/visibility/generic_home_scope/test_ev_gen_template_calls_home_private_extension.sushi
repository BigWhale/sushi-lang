# A template resolves an extension call in the scope of its home unit. Each template
# in the helper calls a private extension of the helper, and this unit instantiates
# both with its own type.
# EXPECT_STDOUT_EXACT: "30\n31\n"
use "helpers/ev_gen_home"

struct Mine:
    i32 a

fn main() i32:
    let Bag@(Mine) b = Bag(Mine(1), 3)
    println(bag_total(b))
    println(b.weight())
    return 0
