# C3: this unit declares its own `label` on `i32`, and it imports a public `label` on
# `i32`. The own extension wins in this unit, and the helper still calls its own. A
# warning (CW3007) stands at the own declaration, with a note at the imported one.
# EXPECT_ERROR_CODES_EXACT: CW3007
# The leak check below makes the runner run the binary of this warning fixture.
# EXPECT_STDOUT_EXACT: "2\n1\n"
# EXPECT_NO_LEAKS: true
use "helpers/ev_c3_labels"

extend i32 label() i32:
    return 2

fn main() i32:
    println(5.label())
    println(label_there(5))
    return 0
