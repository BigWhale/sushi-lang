# The T[] composition: the array binder (ruling 3) and the method-level parameter
# compose -- T from the receiver's element, U from the closure argument.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "n1\nn2\nn3\n"
extend T[] mapv@(U)(fn(T) -> U f) List@(U) | StdError:
    let List@(U) out = List.new()
    foreach(x in self.iter()):
        out.push(f(x)??)
    return out

fn to_str(i32 x) string:
    return Result.Ok("n{x}")

fn main() i32:
    let i32[] xs = from([1, 2, 3])
    match xs.mapv(to_str):
        Result.Ok(ss) ->
            foreach(s in ss.iter()):
                println(s)
        Result.Err(_) ->
            println("err")
    return Result.Ok(0)
