# An extension on the dynamic-array template that has the name of a built-in array
# method can never run, because the built-in is always chosen first. The template is
# judged where it is written, with the target shown as `T[]`.
# EXPECT_ERROR_CODES_EXACT: CE2097
# EXPECT_STDERR_CONTAINS: 'T[].len()'
extend T[] len() i32:
    return 99

fn main() i32:
    let i32[] xs = from([1, 2, 3])
    println(xs.len())
    return 0
