# One template that shadows a built-in is one written fault. The program names two
# instances of the target. The compiler reports the declaration once, names the
# template in the help, and names the colliding instance in the note.
# EXPECT_ERROR_CODES_EXACT: CE2097
# EXPECT_STDERR_CONTAINS: extend Box@(T) with <Perk>
# EXPECT_STDERR_CONTAINS: 'Box@(i32).hash()' is defined by the compiler
struct Box@(T):
    T v

extend Box@(T) hash() u64:
    return 7 as u64

fn main() i32:
    let Box@(i32) a = Box(1)
    let Box@(string) b = Box("Mostly Harmless")
    println(a.v)
    println(b.v)
    return 0
