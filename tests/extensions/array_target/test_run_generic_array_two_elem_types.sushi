# Two element types instantiate one `extend T[]` template in one program. The body is
# checked one time, with `T: Eq`, and each instantiation runs with its own element type.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "true\ntrue\nfalse\n"
extend (T: Eq)[] holds(T probe) bool:
    foreach(x in self.iter()):
        if (x == probe):
            return true
    return false

fn main() i32:
    let i32[] nums = from([1, 2, 3])
    println("{nums.holds(3)}")
    let string[] names = from(["arthur", "zaphod"])
    let bool has_zaphod = names.holds("zaphod")
    println("{has_zaphod}")
    let bool has_ford = names.holds("ford")
    println("{has_ford}")
    return 0
