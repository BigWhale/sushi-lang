# A generic array extension's body is validated per instantiation: the same body is
# legal over i32 and a type error over string, and the call site is what instantiates.
# TEST_TYPE: error
# EXPECT_ERROR_CODE: CE2002
# EXPECT_STDERR_CONTAINS: "cannot assign string to i32"
extend T[] first_as_i32() i32:
    let i32 n = self[0]
    return n

fn main() i32:
    let string[] names = from(["arthur", "ford"])
    println("{names.first_as_i32()}")
    return Result.Ok(0)
