# A concrete dynamic-array target registers and resolves. The isinstance tuple in the
# collect pass lacked DynamicArrayType, so `extend i32[]` was silently never registered
# and every call was CE2008.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "10\n"
extend i32[] sum() i32:
    let i32 total = 0
    foreach(n in self.iter()):
        total := total + n
    return total

fn main() i32:
    let i32[] xs = from([1, 2, 3, 4])
    println("{xs.sum()}")
    return Result.Ok(0)
