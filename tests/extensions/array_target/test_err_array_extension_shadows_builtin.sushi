# An extension on a dynamic-array target that collides with a built-in array method
# can never run -- the built-in always wins -- so it is CE2097, exactly as it is for
# every other receiver kind (docs/design/method-resolution.md).
# TEST_TYPE: error
# EXPECT_ERROR_CODE: CE2097
extend i32[] push(i32 v) i32:
    return v

fn main() i32:
    return Result.Ok(0)
