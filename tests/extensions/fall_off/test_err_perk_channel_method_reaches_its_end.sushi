# A perk-implementation method with a `| E` channel returns a Result, so a body that
# reaches its end is CE0107, as it is for an extension with a channel.
# EXPECT_ERROR_CODE: CE0107
enum SinkError:
    Closed

perk Sink:
    fn put(i32 v) ~ | SinkError

struct Printer:
    i32 id

extend Printer with Sink:
    fn put(i32 v) ~ | SinkError:
        println("put {v}")

fn main() i32:
    let Printer p = Printer(1)
    match p.put(3):
        Result.Ok(_) -> println("ok")
        Result.Err(_) -> println("err")
    return Result.Ok(0)
