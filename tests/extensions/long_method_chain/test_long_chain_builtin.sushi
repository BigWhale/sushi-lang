# A chain of 40 built-in string method calls compiles in linear time and runs.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "ab\n"
use <collections/strings>

fn main() i32:
    let string s = "  ab  "
    let string t = s.trim().trim().trim().trim().trim().trim().trim().trim().trim().trim().trim().trim().trim().trim().trim().trim().trim().trim().trim().trim().trim().trim().trim().trim().trim().trim().trim().trim().trim().trim().trim().trim().trim().trim().trim().trim().trim().trim().trim().trim()
    println(t)
    return 0
