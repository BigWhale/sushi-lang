# The HashMap half. `is_empty` and `contains_key` read the same rule, and the
# conversion their dispatcher carried only ever went the other way (#737).
# EXPECT_STDOUT_EXACT: "true false\nfalse true\nfalse\n"
use <collections/hashmap>

extend HashMap@(K, V) empty_now() bool:
    return self.is_empty()

extend HashMap@(K, V) holds(K key) bool:
    return self.contains_key(key)

extend HashMap@(K, V) empty_ch() bool | StdError:
    return Result.Ok(self.is_empty())

fn main() i32:
    let HashMap@(i32, i32) m = HashMap.new()
    println("{m.empty_now()} {m.holds(1)}")
    m.insert(1, 2)
    println("{m.empty_now()} {m.holds(1)}")
    println("{m.empty_ch().realise(true)}")
    m.free()
    return Result.Ok(0)
