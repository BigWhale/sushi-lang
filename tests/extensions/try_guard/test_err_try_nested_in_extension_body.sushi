# The `??` guard walks the whole body, so a `??` nested under control flow is
# found too (#398).
# TEST_TYPE: error
# EXPECT_ERROR_CODE: CE0131
fn tag(i32 n) i32:
    return Result.Ok(n)

extend i32 summed() i32:
    let i32 acc = 0
    foreach(i in 0..3):
        if (i > 1):
            acc := acc + tag(i)??
    return acc

fn main() i32:
    println("{8.summed()}")
    return Result.Ok(0)
