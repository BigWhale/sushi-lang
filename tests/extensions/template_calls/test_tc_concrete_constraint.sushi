# A concrete type argument in a target is a constraint: `extend Box@(i32)` and
# `extend Maybe@(i32)`.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "8\n5\n"
struct Box@(T):
    T v

extend Box@(i32) twice() i32:
    return self.v * 2

extend Maybe@(i32) or_five() i32:
    return self.realise(5)

fn main() i32:
    let Box@(i32) b = Box(4)
    println(b.twice())
    let Maybe@(i32) m = Maybe.None
    println(m.or_five())
    return 0

