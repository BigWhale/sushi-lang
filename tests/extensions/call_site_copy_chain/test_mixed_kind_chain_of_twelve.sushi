# A chain of twelve methods of three kinds of template. A method on a generic struct
# target calls a method on a `T[]` target, that one calls a method with a method-level
# type parameter, and so on. Each copy is cut at a call in the body of the copy before
# it, so the three kinds go through one queue. The chain makes no new instance.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "11\n"

struct Box@(T):
    T[] items

extend Box@(T) k1() i32:
    return self.items.k2() + 1

extend T[] k2() i32:
    let i32 n = self.len()
    let i32 m = n
    return n.k3(nom m) + 1

extend i32 k3@(U)(nom U u) i32:
    return Box(from([u])).k4() + 1

extend Box@(T) k4() i32:
    return self.items.k5() + 1

extend T[] k5() i32:
    let i32 n = self.len()
    let i32 m = n
    return n.k6(nom m) + 1

extend i32 k6@(U)(nom U u) i32:
    return Box(from([u])).k7() + 1

extend Box@(T) k7() i32:
    return self.items.k8() + 1

extend T[] k8() i32:
    let i32 n = self.len()
    let i32 m = n
    return n.k9(nom m) + 1

extend i32 k9@(U)(nom U u) i32:
    return Box(from([u])).k10() + 1

extend Box@(T) k10() i32:
    return self.items.k11() + 1

extend T[] k11() i32:
    let i32 n = self.len()
    let i32 m = n
    return n.k12(nom m) + 1

extend i32 k12@(U)(nom U u) i32:
    return Box(from([u])).items.len() - 1

fn main() i32:
    let Box@(i32) b = Box(from([1, 2, 3]))
    println(b.k1())
    return 0
