# Twelve extension methods on a `T[]` target. The body of each copy calls a generic
# free function, and that function calls the next method. Each round of the copy
# fixpoint cuts a function copy at the same type arguments, so the chain makes no new
# instance and every copy is cut.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "11\n"

extend T[] a1() i32:
    return h1(self) + 1

fn h1@(T)(T[] xs) i32:
    return xs.a2()

extend T[] a2() i32:
    return h2(self) + 1

fn h2@(T)(T[] xs) i32:
    return xs.a3()

extend T[] a3() i32:
    return h3(self) + 1

fn h3@(T)(T[] xs) i32:
    return xs.a4()

extend T[] a4() i32:
    return h4(self) + 1

fn h4@(T)(T[] xs) i32:
    return xs.a5()

extend T[] a5() i32:
    return h5(self) + 1

fn h5@(T)(T[] xs) i32:
    return xs.a6()

extend T[] a6() i32:
    return h6(self) + 1

fn h6@(T)(T[] xs) i32:
    return xs.a7()

extend T[] a7() i32:
    return h7(self) + 1

fn h7@(T)(T[] xs) i32:
    return xs.a8()

extend T[] a8() i32:
    return h8(self) + 1

fn h8@(T)(T[] xs) i32:
    return xs.a9()

extend T[] a9() i32:
    return h9(self) + 1

fn h9@(T)(T[] xs) i32:
    return xs.a10()

extend T[] a10() i32:
    return h10(self) + 1

fn h10@(T)(T[] xs) i32:
    return xs.a11()

extend T[] a11() i32:
    return h11(self) + 1

fn h11@(T)(T[] xs) i32:
    return xs.a12()

extend T[] a12() i32:
    return 0

fn main() i32:
    let i32[] xs = from([1, 2, 3])
    println(xs.a1())
    return 0
