# The same rule for a declared generic ENUM: `Opt` names a type, so `Box@(Opt)` is a
# constraint on the perk-implementation path and not a template over every Box (#653).
# TEST_TYPE: error
# EXPECT_ERROR_CODE: CE2001
perk Named:
    fn name() string

enum Opt@(T):
    Some(T)
    Nothing

struct Box@(T):
    T item

extend Box@(Opt) with Named:
    fn name() string:
        return "box"

fn main() i32:
    let Box@(i32) b = Box(1)
    println("{b.name()}")
    return Result.Ok(0)
