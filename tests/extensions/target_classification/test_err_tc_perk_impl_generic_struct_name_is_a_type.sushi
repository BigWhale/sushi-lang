# A bare name in a target's argument position is a type PARAMETER only when no
# declaration holds it. `Cage` is a declared generic struct, so `Box@(Cage)` is a
# constraint on the perk-implementation path exactly as it is on the extension path,
# and `Box@(i32)` does not get the method. The perk collector used to read a generic's
# name as a fresh parameter, so this implementation applied to every Box (#653).
# TEST_TYPE: error
# EXPECT_ERROR_CODE: CE2001
perk Named:
    fn name() string

struct Cage@(T):
    T item

struct Box@(T):
    T item

extend Box@(Cage) with Named:
    fn name() string:
        return "box"

fn main() i32:
    let Box@(i32) b = Box(1)
    println("{b.name()}")
    return Result.Ok(0)
