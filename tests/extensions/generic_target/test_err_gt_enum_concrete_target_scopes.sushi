# A concrete ENUM target is a constraint (#393 rule, #394 enum half): the method
# answers its own instantiation and no other.
# TEST_TYPE: error
# EXPECT_ERROR_CODE: CE2008
# EXPECT_STDERR_CONTAINS: "Wrap@(string).tag"
enum Wrap@(T):
    Full(T)
    Empty

extend Wrap@(i32) tag() i32:
    return 1

fn run_test() i32:
    let Wrap@(i32) n = Wrap.Full(7)
    println(n.tag())
    let Wrap@(string) s = Wrap.Full("marvin")
    println(s.tag())
    return Result.Ok(0)

fn main() i32:
    return Result.Ok(run_test().realise(9))
