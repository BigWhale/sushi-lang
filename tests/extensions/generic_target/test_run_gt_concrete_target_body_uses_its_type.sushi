# The body of a concrete-target extension may USE the type it names, while another
# instantiation of the same base type is live (#393). The declared argument used to be
# substituted positionally for every instantiation, so a copy of `doubled()` was emitted
# for `Box@(string)` as well and `self.value * 2` reached the backend with a string
# operand: `CE0000 ... Operands must be the same type, got ({i8*, i32, i8}, i32)`.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "84\n6\n"
use <collections/strings>

struct Box@(T):
    T value

extend Box@(i32) doubled() i32:
    return self.value * 2

extend Box@(string) measured() i32:
    return self.value.len()

fn run_test() i32:
    let Box@(i32) n = Box(42)
    println(n.doubled())
    let Box@(string) s = Box("marvin")
    println(s.measured())
    return Result.Ok(0)

fn main() i32:
    return Result.Ok(run_test().realise(9))
