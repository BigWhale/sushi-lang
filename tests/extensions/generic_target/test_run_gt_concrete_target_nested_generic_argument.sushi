# A concrete target argument that is itself a GENERIC type (#393). The target key is the
# instantiation's interned name, so a nested argument has to render the same way on both
# sides of the comparison -- this is the case that would silently stop matching if the
# declared spelling and the interned name ever disagreed.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "2\n9\n"
struct Box@(T):
    T value

extend Box@(List@(i32)) counted() i32:
    return self.value.len()

extend Box@(i32) raw() i32:
    return self.value

fn run_test() i32:
    let List@(i32) xs = List.new()
    xs.push(1)
    xs.push(2)
    let Box@(List@(i32)) b = Box(xs)
    println(b.counted())

    let Box@(i32) n = Box(9)
    println(n.raw())
    return Result.Ok(0)

fn main() i32:
    return Result.Ok(run_test().realise(9))
