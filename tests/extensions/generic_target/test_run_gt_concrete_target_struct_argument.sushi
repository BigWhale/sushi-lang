# A concrete target argument that names a user STRUCT, not a primitive (#393). This is the
# shape that proves the defect was the CLASSIFICATION and not the spelling: `Point` parses
# as an `UnknownType` exactly like a type-parameter name does, so it was converted into a
# `TypeParameter` and substituted -- the body of `summed()` was emitted for `Box@(i32)` too,
# reading `.x` off an `i32`.
#
# The struct name in the SIGNATURE is the same cell one position over: a return type and a
# parameter type used to be rewritten to the type parameter and substituted back, which
# happened to land on the right type only for the matching instantiation.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "7\n42\n3\n14\n"
struct Point:
    i32 x
    i32 y

struct Box@(T):
    T value

extend Box@(Point) summed() i32:
    return self.value.x + self.value.y

extend Box@(Point) copy_out() Point:
    return self.value.clone()

extend Box@(Point) take(Point p) i32:
    return p.x + self.value.y

extend Box@(i32) raw() i32:
    return self.value

fn run_test() i32:
    let Box@(Point) p = Box(Point(3, 4))
    println(p.summed())

    let Box@(i32) n = Box(42)
    println(n.raw())

    let Point q = p.copy_out()
    println(q.x)
    println(p.take(Point(10, 0)))
    return Result.Ok(0)

fn main() i32:
    return Result.Ok(run_test().realise(9))
