# The BODY of a generic-target extension is collected too, not only its signature (#389).
# Nothing walked `program.generic_extensions`, so a generic type named anywhere in such a
# declaration was missing from the tables -- a `let List@(i32)` in the body reported the
# same false CE2001 as a return type did.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "1\n7\nmarvin\n"
struct Box@(T):
    T value

extend Box@(i32) counted() i32:
    let List@(i32) out = List.new()
    out.push(self.value)
    let i32 n = out.len()
    out.destroy()
    return n

extend Box@(i32) held() i32:
    let Own@(i32) o = Own.alloc(self.value)
    let i32 v = o.get()
    o.destroy()
    return v

extend Box@(i32) named() string:
    let Maybe@(string) m = Maybe.Some("marvin")
    return m.realise("none")

fn run_test() i32:
    let Box@(i32) b = Box(7)
    println(b.counted())
    println(b.held())
    println(b.named())
    return Result.Ok(0)

fn main() i32:
    return Result.Ok(run_test().realise(9))
