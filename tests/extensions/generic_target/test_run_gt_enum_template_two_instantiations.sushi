# An extension on a generic ENUM target (#394): the template monomorphizes per
# instantiation, exactly like the struct twin. The monomorphization loop used to
# walk struct instantiations only, so no copy was made and every call was CE2008.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "1\n3\n0\n9\nmarvin\n"
enum Wrap@(T):
    Full(T)
    Empty

extend Wrap@(T) present() bool:
    match self:
        Wrap.Full(_) -> return true
        Wrap.Empty -> return false

extend Wrap@(T) got(T fallback) T:
    match self:
        Wrap.Full(v) -> return v.clone()
        Wrap.Empty -> return fallback.clone()

fn run_test() i32:
    let Wrap@(i32) w = Wrap.Full(3)
    println(w.present())
    println(w.got(9))

    let Wrap@(i32) e = Wrap.Empty()
    println(e.present())
    println(e.got(9))

    let Wrap@(string) s = Wrap.Full("marvin")
    println(s.got("none"))
    return Result.Ok(0)

fn main() i32:
    return Result.Ok(run_test().realise(9))
