# Two fully concrete ENUM targets are two methods, so one method name serves both
# (#394, under the #393 constraint rule). Each answers its own instantiation.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "1\n2\n"
enum Wrap@(T):
    Full(T)
    Empty

extend Wrap@(i32) tag() i32:
    return 1

extend Wrap@(string) tag() i32:
    return 2

fn run_test() i32:
    let Wrap@(i32) n = Wrap.Full(7)
    println(n.tag())
    let Wrap@(string) s = Wrap.Full("marvin")
    println(s.tag())
    return Result.Ok(0)

fn main() i32:
    return Result.Ok(run_test().realise(9))
