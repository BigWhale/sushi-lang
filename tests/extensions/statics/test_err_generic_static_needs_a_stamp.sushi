# A static whose parameters name no type parameter reads its type arguments from the
# declared type at the call site, because there is no receiver to read them from. A
# position that declares none has no answer, and saying so is CE2060 -- it used to reach
# the backend as a CE0055 ICE. (`Cage.holding(9)` was this test's shape until #573, when
# an argument became the first source and that shape became legal.)
# EXPECT_ERROR_CODE: CE2060
struct Cage@(T):
    T[] items

extend Cage@(T) static empty() Cage@(T):
    return Cage(from([]))

fn main() i32:
    println("{Cage.empty().items.len()}")
    return Result.Ok(0)
