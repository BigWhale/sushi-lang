# The signature of wrap() names a larger instance of its own target. No call reaches
# wrap(), so no copy is made and no chain of instances grows from it.
# EXPECT_STDOUT_EXACT: "7\n"
# EXPECT_IR_NO_FUNCTION: *_wrap
struct Box@(T):
    T v

extend Box@(T) wrap(nom self) Box@(Box@(T)):
    return Box(self)

fn main() i32:
    let Box@(i32) b = Box(7)
    println(b.v)
    return 0
