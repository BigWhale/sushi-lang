# C2 for R1, for a template: <collections/iter> declares a public filter() on
# List@(T), and that method is visible in every unit. A template filter() on List@(T)
# is refused at its declaration, also when no call names it.
# EXPECT_ERROR_CODES_EXACT: CE2097
# EXPECT_STDERR_CONTAINS: the stdlib module <collections/iter> declares
extend List@(T) filter(fn(T) -> bool keep) i32:
    foreach(x in self.iter()):
        if (keep(x)):
            return 1
    return 0

fn main() i32:
    let List@(i32) a = List.new()
    a.push(1)
    println(a.len())
    return 0
