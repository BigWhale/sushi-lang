# Ten extension methods on a generic struct target. The body of each copy calls a
# generic free function, and that function calls the next method. Each round of the
# copy fixpoint cuts a function copy at the same type arguments, so the chain makes no
# new instance and every copy is cut.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "9\n"

struct Box@(T):
    T v

extend Box@(T) b1() i32:
    return g1(self) + 1

fn g1@(T)(Box@(T) b) i32:
    return b.b2()

extend Box@(T) b2() i32:
    return g2(self) + 1

fn g2@(T)(Box@(T) b) i32:
    return b.b3()

extend Box@(T) b3() i32:
    return g3(self) + 1

fn g3@(T)(Box@(T) b) i32:
    return b.b4()

extend Box@(T) b4() i32:
    return g4(self) + 1

fn g4@(T)(Box@(T) b) i32:
    return b.b5()

extend Box@(T) b5() i32:
    return g5(self) + 1

fn g5@(T)(Box@(T) b) i32:
    return b.b6()

extend Box@(T) b6() i32:
    return g6(self) + 1

fn g6@(T)(Box@(T) b) i32:
    return b.b7()

extend Box@(T) b7() i32:
    return g7(self) + 1

fn g7@(T)(Box@(T) b) i32:
    return b.b8()

extend Box@(T) b8() i32:
    return g8(self) + 1

fn g8@(T)(Box@(T) b) i32:
    return b.b9()

extend Box@(T) b9() i32:
    return g9(self) + 1

fn g9@(T)(Box@(T) b) i32:
    return b.b10()

extend Box@(T) b10() i32:
    return 0

fn main() i32:
    let Box@(i32) b = Box(1)
    println(b.b1())
    return 0
