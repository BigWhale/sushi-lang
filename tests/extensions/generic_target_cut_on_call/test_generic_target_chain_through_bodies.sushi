# A chain of twelve generic-target methods. Each method is first reached from the body
# of the method before it, so each copy is cut while the copy before it is checked.
# EXPECT_STDOUT_EXACT: "12\n"
struct Box@(T):
    T v

extend Box@(T) m1() i32:
    return self.m2() + 1

extend Box@(T) m2() i32:
    return self.m3() + 1

extend Box@(T) m3() i32:
    return self.m4() + 1

extend Box@(T) m4() i32:
    return self.m5() + 1

extend Box@(T) m5() i32:
    return self.m6() + 1

extend Box@(T) m6() i32:
    return self.m7() + 1

extend Box@(T) m7() i32:
    return self.m8() + 1

extend Box@(T) m8() i32:
    return self.m9() + 1

extend Box@(T) m9() i32:
    return self.m10() + 1

extend Box@(T) m10() i32:
    return self.m11() + 1

extend Box@(T) m11() i32:
    return self.m12() + 1

extend Box@(T) m12() i32:
    return 1

fn main() i32:
    let Box@(string) b = Box("Mostly Harmless")
    println(b.m1())
    return 0
