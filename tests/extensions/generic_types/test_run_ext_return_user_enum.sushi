# A USER generic enum in the return position of an extension method, with one type
# parameter and with two. Issue #387: not about `Maybe`, and not about enums -- about a
# generic enum returned from an extension or perk method.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "wrap 42\nempty\nleft 3\nright zaphod\n"
enum Box@(T):
    Wrap(T)
    Empty

enum Either@(A, B):
    Left(A)
    Right(B)

extend i32 boxed() Box@(i32):
    return Box.Wrap(self)

extend i32 unboxed() Box@(i32):
    return Box.Empty()

extend i32 sided() Either@(i32, string):
    return Either.Left(self)

# `self` is a borrow, so a `string` payload has to be cloned out (the #338 ruling).
extend string sided() Either@(i32, string):
    return Either.Right(self.clone())

fn run_test() i32:
    match 42.boxed():
        Box.Wrap(v) -> println("wrap {v}")
        Box.Empty() -> println("empty")

    match 42.unboxed():
        Box.Wrap(v) -> println("wrap {v}")
        Box.Empty() -> println("empty")

    match 3.sided():
        Either.Left(n) -> println("left {n}")
        Either.Right(s) -> println("right {s}")

    match "zaphod".sided():
        Either.Left(n) -> println("left {n}")
        Either.Right(s) -> println("right {s}")

    return Result.Ok(0)

fn main() i32:
    return Result.Ok(run_test().realise(9))
