# A generic STRUCT in the return position of an extension method. The issue text calls
# this half fine, measured with `List.new()` -- a builtin static constructor, which needs
# no stamp. A USER generic struct constructor needs the same propagation the enum arm
# needs, and reported CE2008 'undefined function Pair' without it (#387).
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "12\nford\n1\n7\n"
struct Pair@(T, U):
    T first
    U second

extend i32 paired() Pair@(i32, i32):
    return Pair(self, self)

extend i32 named() Pair@(i32, string):
    return Pair(second: "ford", first: self)

# Control: a builtin static constructor in the return position already worked.
extend i32 listed() List@(i32):
    let List@(i32) out = List.new()
    out.push(self)
    return out

# Control: a PLAIN enum in the return position already worked.
enum Col:
    Red
    Green

extend i32 hue() Col:
    if (self > 0):
        return Col.Red
    return Col.Green

fn run_test() i32:
    let Pair@(i32, i32) p = 6.paired()
    println(p.first + p.second)

    let Pair@(i32, string) q = 7.named()
    println(q.second)

    let List@(i32) l = 4.listed()
    println(l.len())
    l.destroy()

    match 1.hue():
        Col.Red -> println(q.first)
        Col.Green -> println("green")

    return Result.Ok(0)

fn main() i32:
    return Result.Ok(run_test().realise(9))
