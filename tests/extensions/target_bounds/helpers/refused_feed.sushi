# A unit that calls a bounded extension with a type argument that fails the bound, as
# the scrutinee of a `match`. The importer calls it the same way.
public error Bad:
    Oops

public struct Res:
    i32 id

extend Res with Drop:
    fn drop(poke self) ~:
        self.id := 0

public struct Feed@(T):
    T[] items

extend Feed@(T: Clone) first() Result@(i32, Bad):
    return Result.Ok(1)

public fn g() i32:
    match Feed(from([Res(1)])).first():
        Result.Ok(_) -> return 1
        Result.Err(_) -> return 0
