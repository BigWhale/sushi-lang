# A perk template whose target bound fails does not cover the instance, so the
# instance does not satisfy a constraint that names the perk (#1070).
# EXPECT_ERROR_CODES_EXACT: CE4006

perk Show:
    fn show() string

struct Box@(T):
    T value

struct Fnv:
    fn(i32) -> i32 f

extend Box@(T: Hashable) with Show:
    fn show() string:
        return "box"

fn describe@(X: Show)(X x) string:
    return x.show()

fn twice(i32 x) i32:
    return x * 2

fn main() i32:
    let Box@(Fnv) b = Box(Fnv(twice))
    println(describe(b))
    return 0
