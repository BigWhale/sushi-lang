# A public extension and a perk implementation on a public target may not hand out a
# private perk in a bound (#1070): the leak rule of a constraint, for both alike.
# EXPECT_ERROR_CODES_EXACT: CE3010, CE3010

perk Loud:
    fn shout() string

public perk Show:
    fn show() string

public struct Crate@(T):
    T value

public extend Crate@(T: Loud) f() i32:
    return 1

extend Crate@(T: Loud) with Show:
    fn show() string:
        return "crate"

fn main() i32:
    println("Mostly Harmless")
    return 0
