# A `use` whose only reader is a target bound is used (#1070): the dead-code lint
# reads the bound through the one walk over constraints.
# COMPILER_FLAGS: --warn-unused
# EXPECT_STDOUT_EXACT: "0\n"
# EXPECT_STDERR_EMPTY: true

use "helpers/loud_public" as h

extend List@(T: h.Loud) count_loud() i32:
    return self.len()

fn main() i32:
    let List@(i32) xs = List.new()
    println(xs.len())
    return 0
