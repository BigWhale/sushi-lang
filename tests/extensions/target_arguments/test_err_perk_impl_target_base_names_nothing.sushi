# The target's BASE still has to name a declared generic. It is the one part of a
# `@(...)` target that was already checked, and it stays checked (#698).
# EXPECT_ERROR_CODE: CE2001

perk Named:
    fn named() i32

extend NoSuchBase@(i32) with Named:
    fn named() i32:
        return 1

fn main() i32:
    println("Mostly Harmless")
    return Result.Ok(0)
