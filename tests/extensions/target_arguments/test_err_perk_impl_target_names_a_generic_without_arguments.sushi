# The perk-implementation path reads the same header, so it answers the same way
# (#698). It used to answer twice: once for `Cage` and once for the instantiation
# `Box@(Cage)` that `Cage` made impossible.
# EXPECT_ERROR_CODE: CE2001

struct Box@(T):
    T v

struct Cage@(T):
    T v

perk Show:
    fn show() i32

extend Box@(Cage) with Show:
    fn show() i32:
        return 1

fn main() i32:
    println("Mostly Harmless")
    return Result.Ok(0)
