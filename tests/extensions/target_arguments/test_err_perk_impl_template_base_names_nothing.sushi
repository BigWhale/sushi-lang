# The perk-implementation half of the same rule. The two paths have disagreed before
# (#698), so each spelling carries its own fixture (#728).
# EXPECT_ERROR_CODE: CE2001

perk Named:
    fn named() i32

extend NoSuchBase@(T) with Named:
    fn named() i32:
        return 1

fn main() i32:
    println("Mostly Harmless")
    return Result.Ok(0)
