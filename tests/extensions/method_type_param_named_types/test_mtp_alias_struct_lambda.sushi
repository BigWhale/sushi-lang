# The lambda parameter is a struct from another unit, written behind an alias (#1135).
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "5\n"
use <collections/iter>
use "helpers/mtp_shapes" as sh

fn main() i32:
    let sh.Pt[] ps = from([sh.Pt(5)])
    let List@(i32) r = ps.map(|sh.Pt p| p.x)
    foreach(v in r.iter()):
        println(v)
    return 0
