# A named function whose parameter is a struct solves the method-level type parameter
# of map (#1135).
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "10\n20\n"
use <collections/iter>

struct P:
    i32 x

fn tenx(P p) i32:
    return p.x * 10

fn main() i32:
    let P[] ps = from([P(1), P(2)])
    let List@(i32) r = ps.map(tenx)
    foreach(v in r.iter()):
        println(v)
    return 0
