# The receiver is a List@(P), and the lambda takes a P (#1135).
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "30\n"
use <collections/iter>

struct P:
    i32 x

fn main() i32:
    let List@(P) lp = List.new()
    lp.push(P(3))
    let List@(i32) r = lp.map(|P p| p.x * 10)
    foreach(v in r.iter()):
        println(v)
    return 0
