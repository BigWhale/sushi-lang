# An annotated lambda whose parameter is a struct solves the method-level type
# parameter of map (#1135).
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "10\n20\n"
use <collections/iter>

struct P:
    i32 x

fn main() i32:
    let P[] ps = from([P(1), P(2)])
    let List@(i32) r = ps.map(|P p| p.x * 10)
    foreach(v in r.iter()):
        println(v)
    return 0
