# The free function map with a declared List@(P) local and an annotated lambda that
# takes a P (#1134, #1135).
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "3\n"
use <collections/iter>

struct P:
    i32 x

fn main() i32:
    let List@(P) lp = List.new()
    lp.push(P(3))
    let List@(i32) r = map(lp, |P p| p.x)
    foreach(v in r.iter()):
        println(v)
    return 0
