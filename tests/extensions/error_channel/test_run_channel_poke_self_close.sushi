# 'poke self' composes with the channel: the write through the receiver is
# visible at the call site, the second call reads it, and each bare success
# wraps into Ok. This is the close-writes-minus-1 contract of <net/tcp>.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "first close ok\nthe field reads -1\nsecond close ok\n"
enum PortError:
    Broken

struct Port:
    i32 fd

extend Port close(poke self) ~ | PortError:
    if (self.fd == 13):
        return Result.Err(PortError.Broken)
    self.fd := -1
    return ~

fn run() ~ | PortError:
    let Port p = Port(7)
    p.close()??
    println("first close ok")
    if (p.fd == -1):
        println("the field reads -1")
    p.close()??
    println("second close ok")
    return Result.Ok(~)

fn main() i32:
    match run():
        Result.Ok(_) -> return Result.Ok(0)
        Result.Err(_) -> return Result.Ok(1)
