# An Err spelled in a channel body propagates: through '??' inside another channel
# holder, and into a match at the outermost call.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "2\nerr\n"
enum OddError:
    TooOdd

extend i32 half_checked() i32 | OddError:
    if (self % 2 == 1):
        return Result.Err(OddError.TooOdd)
    return self / 2

fn run() i32 | OddError:
    let i32 eight = 8
    let i32 a = eight.half_checked()??
    let i32 seven = 7
    let i32 b = seven.half_checked()??
    println("{a} {b}")
    return Result.Ok(0)

fn main() i32:
    let i32 four = 4
    let i32 half = four.half_checked().realise(0)
    println("{half}")
    match run():
        Result.Ok(_) -> println("ok")
        Result.Err(_) -> println("err")
    return Result.Ok(0)
