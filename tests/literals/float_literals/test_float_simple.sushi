# EXPECT_RUNTIME_EXIT: 0
fn main() i32:
  let f64 x = 3.14
  # Validate float literal assignment
  let i32 validation_count = 0

  if (x > 3.0 and x < 4.0):  # x should be approximately 3.14
    validation_count := validation_count + 1

  if (validation_count == 1):
    return 0  # All tests passed)
  else:
    return validation_count  # Return count for debugging)
