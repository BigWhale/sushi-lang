# EXPECT_STDOUT_EXACT: "4\n"
# A float takes underscores in all three digit runs: the integer part, the
# fraction and the exponent.

fn main() i32:
    let f64 a = 1_000.5
    let f64 b = 3.141_592
    let f64 c = 1e1_0
    let f64 d = 1_0.2_5
    let i32 ok = 0
    if (a > 1000.0 and a < 1001.0):
        ok := ok + 1
    if (b > 3.14 and b < 3.15):
        ok := ok + 1
    if (c > 9999999999.0 and c < 10000000001.0):
        ok := ok + 1
    if (d > 10.2 and d < 10.3):
        ok := ok + 1
    println("{ok}")
    return Result.Ok(0)
