# `s[i]` answers a u8, so a byte literal compares with it directly: a count of the
# slashes of a path, and a digit test.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "3\n4\ntrue\nfalse\n"
use <collections/strings>

fn is_digit(u8 b) bool:
    return b >= a'0' and b <= a'9'

fn count_slashes(string path) i32:
    let i32 n = 0
    foreach(i in 0..path.size()):
        if (path[i] == a'/'):
            n := n + 1
    return n

fn count_digits(string s) i32:
    let i32 n = 0
    foreach(i in 0..s.size()):
        if (is_digit(s[i])):
            n := n + 1
    return n

fn main() i32:
    println(count_slashes("/usr/local/bin"))
    println(count_digits("abc123x9"))
    let string code = "7z"
    println(is_digit(code[0]))
    println(is_digit(code[1]))
    return 0
