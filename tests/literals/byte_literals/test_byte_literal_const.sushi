# A byte literal is a constant expression: a u8 constant, an element of an array
# constant, the value of a run, and a field of a struct constant.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "47\n47\n46\n10\n32\n32\n120\n7\n"

struct Mark:
    u8 sign
    i32 weight

const u8 SLASH = a'/'
const u8[3] SEPS = [a'/', a'.', a'\n']
const u8[4] PAD = [a' '; 4]
const Mark X_MARK = Mark(a'x', 7)

fn main() i32:
    println(SLASH)
    println(SEPS[0])
    println(SEPS[1])
    println(SEPS[2])
    println(PAD[0])
    println(PAD[3])
    println(X_MARK.sign)
    println(X_MARK.weight)
    return 0
