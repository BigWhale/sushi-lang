# A diagnostic about the VALUE of a member access marks the whole expression, from
# the receiver's first column, as the flat name is marked from its own (#1030).
# EXPECT_ERROR_CODES_EXACT: CE2436
# EXPECT_STDERR_CONTAINS: test_err_member_move_span.sushi:8:22: error [CE2436]
use "helpers/libspan" as c

fn back() string:
    return Result.Ok(c.GREETING)

fn main() i32:
    println(back().realise(""))
    return Result.Ok(0)
