# The CE0131 of a propagation in the bare `main` starts at the operand of `??`, because
# the propagation has one span over the whole expression.
# EXPECT_ERROR_CODES_EXACT: CE0131
# EXPECT_STDERR_CONTAINS: "test_err_propagation_in_main_span.sushi:10:17: error [CE0131]"
# EXPECT_STDERR_CONTAINS: "  |     let i32 n = f()??\n  `                 --+--\n"
fn f() i32 | StdError:
    return Result.Ok(1)

fn main() i32:
    let i32 n = f()??
    println("{n}")
    return 0
