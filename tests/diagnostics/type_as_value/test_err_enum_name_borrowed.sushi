# The borrow position asks the same ladder (#600). An enum name used to read CE2400,
# "only a local variable can be borrowed", which is true and is not the fault: the name
# is a type, and no borrow of it would ever be writable.
# EXPECT_ERROR_CODE: CE2105
enum Color:
    Red

fn read_value(peek i32 x) i32:
    return Result.Ok(x)

fn main() i32:
    let i32 y = read_value(peek Color).realise(0)
    println("{y}")
    return Result.Ok(0)
