# A nest of 500 calls, each with `??`, compiles. Each walk of the compiler goes down
# for each level, and the compiler runs on a deep stack, so the nest has room.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "500\n"
error StepError:
    Overflow

struct Pt:
    i32 x

fn step(Pt p) Pt | StepError:
    return Result.Ok(Pt(p.x + 1))

fn walk(Pt p) Pt | StepError:
    let Pt q = step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(step(p)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??)??
    return Result.Ok(q)

fn main() i32:
    let Pt r = walk(Pt(0)).realise(Pt(-1))
    println(r.x)
    return 0
