# A chain of 500 method calls compiles. Each call is the receiver of the next one,
# so the chain is a nest of 500 levels.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "500\n"
struct Pt:
    i32 x

extend Pt step() Pt:
    return Pt(self.x + 1)

