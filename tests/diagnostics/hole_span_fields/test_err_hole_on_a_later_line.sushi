# A string literal can go across lines. A hole on a later line of the literal is
# reported on its own file line and column, not on the line of the opening quote (#1038).
# EXPECT_ERROR_CODES_EXACT: CE2062
# EXPECT_STDERR_CONTAINS: test_err_hole_on_a_later_line.sushi:11:10: error [CE2062]
fn pick@(T)(T x) i32:
    return 1


fn show() ~:
    println("value
  {pick@(i32, i32)(5)}")

fn main() i32:
    return 0
