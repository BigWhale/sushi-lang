# EXPECT_STDERR_CONTAINS: test_err_hole_ptr_type_arg.sushi:10:27: error [CE5009]
fn size@(T)() i32:
    return 8


fn show() ~:
    println("value {size@(ptr)()}")

fn main() i32:
    return 0
