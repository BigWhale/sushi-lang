# A wrong count of written type arguments in an interpolation hole is reported at
# the type arguments in the file, not at a column inside the text of the hole (#1038).
# EXPECT_ERROR_CODES_EXACT: CE2062
# EXPECT_STDERR_CONTAINS: test_err_hole_type_args_arity.sushi:10:27: error [CE2062]
fn pick@(T)(T x) i32:
    return 1


fn show() ~:
    println("value {pick@(i32, i32)(5)}")

fn main() i32:
    return 0
