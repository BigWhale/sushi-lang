# A variant constructor that names no member of the enum reports the enum with the
# SOURCE spelling, in the message and in the help.
# TEST_TYPE: error
# EXPECT_ERROR_CODE: CE2045
# EXPECT_STDERR_CONTAINS: "not found in enum 'Maybe@(i32)'"
# EXPECT_STDERR_CONTAINS: "extend Maybe@(i32) static Nope(...)"
fn main() i32:
    let Maybe@(i32) m = Maybe.Nope(1)
    println("{m.is_some()}")
    return Result.Ok(0)
