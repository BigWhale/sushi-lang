# A diagnostic names a type with the SOURCE spelling. `List<i32>` is the internal
# identity name: the user cannot write it, and the source line under the message
# spells the same type `List@(i32)`.
# TEST_TYPE: error
# EXPECT_ERROR_CODE: CE4002
# EXPECT_STDERR_CONTAINS: "type List@(i32) already implements perk Show"
perk Show:
    fn show() u64

extend List@(i32) with Show:
    fn show() u64:
        return 1 as u64

extend List@(i32) with Show:
    fn show() u64:
        return 2 as u64

fn main() i32:
    return Result.Ok(0)
