# Test: what --warn-unused never reports. A private function reached only from an
# `extend` block; a private name used only by a public one; a constant used only as an
# array size; a generic reached from main; a `public use`, which re-exports and is a
# root (here and in the bridge unit); an import used through what a `public use` in it
# hands on, and through a public extension method; an import used only behind its
# alias; and a string method, which needs no import.
# COMPILER_FLAGS: --warn-unused
# EXPECT_STDERR_EMPTY: true
# EXPECT_STDOUT_EXACT: "6\n3\n8\n6\n5\ntrue\n"
use <math> as m
use "helpers/unused_bridge"
public use <time>

const i32 WIDTH = 3

struct Counter:
    i32 n

fn triple(i32 x) i32:
    return x * 3

extend Counter tripled() i32:
    return triple(self.n)

fn secret() i32:
    return 8

public fn exposed() i32:
    return secret()

fn same@(T)(nom T x) T:
    return x

fn main() i32:
    let Counter c = Counter(2)
    println(c.tripled())
    let i32[WIDTH] cells = [1, 2, 3]
    println(cells[2])
    println(exposed())
    let i32 side = square_of(3).side
    println(same(nom side).doubled())
    println(m.abs(-5))
    println("abc".starts_with("a"))
    return 0
