# `use <io/files>` used to satisfy the `io/stdio` gate, because an import recorded
# its own parent directory as imported too. The program reached the linker and
# failed there on a mangled C symbol (#501).
# EXPECT_ERROR_CODE: CE3015
# EXPECT_STDERR_CONTAINS: "stderr.write()"
use <io/files>

fn main() i32:
    stderr.write("Mostly Harmless\n")
    return Result.Ok(0)
