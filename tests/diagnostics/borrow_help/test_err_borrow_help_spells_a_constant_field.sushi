# A field chain off a constant spells the constant first: the help offers text that the
# user could type.
# EXPECT_ERROR_CODES_EXACT: CE2006
# EXPECT_STDERR_CONTAINS: help: borrow it at the call site: `peek ORIGIN.x`
struct Point:
    i32 x
    i32 y

const Point ORIGIN = Point(3, 4)

fn look(peek i32 v) i32:
    return v

fn main() i32:
    println(look(ORIGIN.x))
    return 0
