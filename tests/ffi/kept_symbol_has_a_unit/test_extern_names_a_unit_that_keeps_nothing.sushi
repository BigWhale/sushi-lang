# The link name `kept_unit_b$helper` is a foreign name (#1112): the unit
# `kept_unit_b` of the binary library keeps no `helper`, so no body defines that
# symbol. The extern is never called, so the program links.
# BUILD_LIB_BINARY: kept_unit_lib.sushi
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "5\n"
use <lib/kept_unit_lib>

unsafe external "C" as raw because "a foreign name":
    fn h(i32 n) i32 = "kept_unit_b$helper"

fn main() i32:
    println(both(1))
    return 0
