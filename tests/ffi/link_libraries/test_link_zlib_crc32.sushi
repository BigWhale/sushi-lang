# A `link` clause names a C library, and the program links it (`-lz`). Two blocks name
# the same library: the link plan keeps it one time.
# EXPECT_STDOUT_EXACT: "3413997946\n777324008\n"
unsafe external "C" link "z" as zlib because "CRC-32 from zlib":
    fn crc32(u64 crc, string buf, u32 len) u64 = "crc32"

unsafe external "C" link "z" as adler because "Adler-32 from zlib":
    fn adler32(u64 adler, string buf, u32 len) u64 = "adler32"

fn main() i32:
    println(zlib.crc32(0, "Mostly Harmless", 15))
    println(adler.adler32(1, "Mostly Harmless", 15))
    return 0
