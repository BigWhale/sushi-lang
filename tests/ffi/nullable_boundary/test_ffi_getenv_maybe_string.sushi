# A `char*` return that may be null is declared `Maybe@(string)` (#1085). A NULL is
# `Maybe.None`; any other pointer is copied into an owned string inside `Maybe.Some`.
# EXPECT_STDOUT_EXACT: "missing: none\nset: Mostly Harmless\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
unsafe external "C" as libc because "reading the process environment":
    fn getenv(string key) Maybe@(string) = "getenv"
    fn setenv(string key, string value, i32 overwrite) i32 = "setenv"

fn show(string label, string key) i32:
    match libc.getenv(key):
        Maybe.Some(v) -> println("{label}: {v}")
        Maybe.None -> println("{label}: none")
    return 0

fn main() i32:
    let i32 a = show("missing", "SUSHI_NO_SUCH_KEY_42")
    let i32 b = libc.setenv("SUSHI_FFI_NULLABLE_KEY", "Mostly Harmless", 1)
    let i32 c = show("set", "SUSHI_FFI_NULLABLE_KEY")
    return a + b + c
