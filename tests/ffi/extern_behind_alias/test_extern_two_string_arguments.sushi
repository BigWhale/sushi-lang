# Two string arguments of one C call each get a C copy, and both copies are freed after the call.
# EXPECT_STDOUT_EXACT: "same\ndiffer\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
unsafe external "C" as c because "string compare":
    fn strcmp(string a, string b) i32 = "strcmp"

fn main() i32:
    let string left = "sushi"
    foreach(i in 0..2):
        let string right = "sushi"
        if (i == 1):
            right := "nori"
        if (c.strcmp(left, right) == 0):
            println("same")
        else:
            println("differ")
    return 0
