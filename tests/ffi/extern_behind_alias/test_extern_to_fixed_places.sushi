# `to_fixed` of <collections/strings> calls C `snprintf` behind the private alias of its
# unit. A count of places of 0, of 2, and below 0 (which is 0).
# EXPECT_STDOUT_EXACT: "3\n3.14\n3\n2.5\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
use <collections/strings>

fn main() i32:
    let f64 pi = 3.14159
    println(pi.to_fixed(0))
    println(pi.to_fixed(2))
    println(pi.to_fixed(-3))
    let f32 half = 2.5
    println(half.to_fixed(1))
    return 0
