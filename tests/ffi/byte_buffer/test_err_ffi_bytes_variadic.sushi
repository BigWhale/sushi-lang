# A `u8[]` is a declared parameter only (#1088); in the `...` position it stays CE5005.
# EXPECT_ERROR_CODE: CE5005
use <collections/strings>

unsafe external "C" as libc because "probe":
    fn printf(string fmt, ...) i32 = "printf"

fn main() i32:
    let u8[] buf = "x".to_bytes()
    let i32 n = libc.printf("%s\n", buf)
    return Result.Ok(n)
