# A temporary `u8[]` argument is freed after the call (#1088): the array crosses as a
# pointer, and nothing else owns it.
# EXPECT_STDOUT_EXACT: "Mostly Harmless\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
use <collections/strings>

unsafe external "C" as libc because "writing bytes to a descriptor":
    fn write(i32 fd, u8[] buf, i64 n) i64 = "write"

fn main() i32:
    let i64 sent = libc.write(1, "Mostly Harmless\n".to_bytes(), 16)
    return (sent - 16) as i32
