# The same namespace and function twice in ONE unit stays a duplicate.
# EXPECT_ERROR_CODE: CE0101

unsafe external "C" as libc because "the first binding":
    fn abs(i32 x) i32 = "abs"

unsafe external "C" as libc because "the second binding":
    fn abs(i32 x) i32 = "abs"

fn main() i32:
    println("{libc.abs(-3)}")
    return 0
