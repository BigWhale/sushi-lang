# CE5013 reads the folded link name (#1089): a constant that spells a symbol this
# program emits is refused as the literal is.
# EXPECT_ERROR_CODE: CE5013
const string HELPER = "test_err_ffi_link_name_constant_names_emitted$helper"

unsafe external "C" as libc because "probe":
    fn twice() i32 = HELPER

fn helper() i32:
    return 2

fn main() i32:
    return 0
