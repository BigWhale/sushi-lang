# FFI: a public GENERIC fn is as public as any other. The fence ran from
# `validate_function`, which the typecheck runner skips for a generic.
# EXPECT_ERROR_CODE: CE5008
unsafe external "C" as libc because "intentional public ptr exposure":
    fn free(ptr p) ~ = "free"

public fn release@(T)(ptr p, T witness) ~:
    libc.free(p)
    return Result.Ok(~)

fn main() i32:
    let i32 n = 1
    return Result.Ok(0)
