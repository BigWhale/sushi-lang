# FFI: an extension is as visible as its target type, and `i32` is public, so an
# extension may not take a foreign `ptr` either. The fence never ran on an extension.
# EXPECT_ERROR_CODE: CE5008
unsafe external "C" as libc because "intentional public ptr exposure":
    fn free(ptr p) ~ = "free"

extend i32 release_with(ptr p) i32:
    libc.free(p)
    return self

fn main() i32:
    return Result.Ok(0)
