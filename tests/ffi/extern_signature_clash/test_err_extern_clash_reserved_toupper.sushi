# The compiler declares `toupper` itself in every module, and that declaration takes
# part in the one rule (#1099): a user declaration with another signature does not
# agree with it.
# EXPECT_ERROR_CODE: CE5001
unsafe external "C" as libc because "changing the case of a letter":
    fn toupper(u8 c) u8 = "toupper"

fn main() i32:
    println(libc.toupper(97))
    return 0
