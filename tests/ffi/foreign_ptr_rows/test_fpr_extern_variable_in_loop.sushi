# A read of an extern variable in a loop: each read loads the C global again. `optind`
# is 1 before any `getopt` call.
# EXPECT_STDOUT_EXACT: "total: 3\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
unsafe external "C" as libc because "reading getopt state":
    var i32 optind = "optind"

fn main() i32:
    let i32 total = 0
    let i32 round = 0
    while (round < 3):
        total := total + libc.optind
        round := round + 1
    println("total: {total}")
    return 0
