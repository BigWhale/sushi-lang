# A private function that a binary library keeps emits `clash_bin_lib$tolower` in
# the library bitcode (#1098), so an extern with the link name `tolower` reaches
# the C function.
# BUILD_LIB_BINARY: clash_bin_lib.sushi
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "4001\n97\n"
use <lib/clash_bin_lib>

unsafe external "C" as libc because "a C function with the name of a library function":
    fn tolower(i32 c) i32 = "tolower"

fn main() i32:
    println(abs(1))
    println(libc.tolower(65))
    return 0
