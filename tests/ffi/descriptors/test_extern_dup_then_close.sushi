# A program that opens a descriptor through C and closes it has no open descriptor at its
# end. The descriptor check of the runner reads the program on the new pipeline.
# EXPECT_STDOUT_EXACT: "closed 0\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_OPEN_FDS
unsafe external "C" as c because "a second descriptor of stdout":
    fn dup(i32 fd) i32 = "dup"
    fn close(i32 fd) i32 = "close"

fn main() i32:
    let i32 fd = c.dup(1)
    let i32 done = c.close(fd)
    println("closed {done}")
    return 0
