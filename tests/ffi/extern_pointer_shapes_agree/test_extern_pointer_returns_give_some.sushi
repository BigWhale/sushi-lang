# A `Maybe@(string)` return and a `Maybe@(ptr)` return of one symbol agree, and a
# pointer that is not NULL gives `Some` through each declaration.
# TEST_ENV: SUSHI_POINTER_SHAPES_PROBE=Mostly Harmless
# EXPECT_STDOUT_EXACT: "Mostly Harmless\nMostly Harmless\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
unsafe external "C" as text because "reading an environment variable":
    fn getenv(string name) Maybe@(string) = "getenv"

unsafe external "C" as raw because "reading an environment variable as an address":
    fn getenv(string name) Maybe@(ptr) = "getenv"

fn main() i32:
    match text.getenv("SUSHI_POINTER_SHAPES_PROBE"):
        Maybe.Some(value) -> println(value)
        Maybe.None -> println("none")
    match raw.getenv("SUSHI_POINTER_SHAPES_PROBE"):
        Maybe.Some(address) -> println(address.to_string(0))
        Maybe.None -> println("none")
    return 0
