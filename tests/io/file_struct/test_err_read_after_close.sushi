# The defect ruling R26 removes. close() CONSUMES the handle now, so a read after it is
# refused while compiling instead of answering EBADF at run time.
# EXPECT_ERROR_CODE: CE2435
# EXPECT_STDERR_CONTAINS: 'close' consumed it
use <io/fs>

fn read_after_close(string path) string | IoError:
    let File f = open(path, FileMode.Read())??
    f.close()??
    return Result.Ok(f.read_all()??)

fn main() i32:
    match read_after_close("nowhere.txt"):
        Result.Ok(text) -> println(text)
        Result.Err(_) -> println("failed")
    return Result.Ok(0)
