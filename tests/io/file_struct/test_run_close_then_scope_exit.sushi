# An explicit close() spends the handle, so the scope exit that follows has nothing to
# drop and the descriptor is released exactly once.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_NO_OPEN_FDS: true
# EXPECT_STDOUT_EXACT: "closed\ndone\n"
use <io/files>
use <io/fs>

fn write_and_close(string path) ~ | IoError:
    let File f = open(path, FileMode.Write())??
    f.write("Mostly Harmless")??
    f.close()??
    return Result.Ok(~)

fn main() i32:
    match write_and_close("close_then_exit.txt"):
        Result.Ok(_) -> println("closed")
        Result.Err(_) -> println("close failed")
    remove("close_then_exit.txt").realise(0)
    println("done")
    return Result.Ok(0)
