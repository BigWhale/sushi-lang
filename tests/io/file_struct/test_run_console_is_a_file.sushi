# The three console handles are ordinary Files over descriptors 0, 1 and 2, declared as
# unit variables. They carry owned = false, so a rebind that drops one does NOT close the
# descriptor -- the same guarded shape a string literal uses for its buffer -- and a borrow
# of one ends with the call. That is what lets one type serve both.
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_NO_OPEN_FDS: true
# EXPECT_STDOUT_EXACT: "0 1 2\nfalse false false\nout\nstill open\n"
use <io/fs>

fn main() i32:
    println("{stdin.fd} {stdout.fd} {stderr.fd}")
    println("{stdin.owned} {stdout.owned} {stderr.owned}")

    stdout.write("out\n")

    # A borrow of a console handle ends with the call and must not close it, and the
    # rebind that puts a fresh handle in drops the old one without closing descriptor 1.
    let bool ok = borrow(peek stdout).realise(false)
    stdout := File(fd: STDOUT_FD, owned: false)
    if (ok):
        stdout.write("still open\n")
    return Result.Ok(0)

fn borrow(peek File out) bool:
    return Result.Ok(out.is_open())
