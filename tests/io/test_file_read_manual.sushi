# EXPECT_STDOUT_EXACT: "Line 1: First line\nLine 2: Second line\nLine 3: Third line\nRead 3 lines total\n"
# EXPECT_RUNTIME_EXIT: 0
# TEST_TYPE: runtime
# EXPECTED_OUTPUT: Line 1: First line
# EXPECTED_OUTPUT: Line 2: Second line
# EXPECTED_OUTPUT: Line 3: Third line
# EXPECTED_OUTPUT: Read 3 lines total

use <io/fs>
use <io/files>
use <collections/strings>

fn main() i32:
    # Write test file with multiple lines
    let Result@(File, IoError) write_result = open("test_read_manual.txt", FileMode.Write())
    match write_result:
        Result.Ok(poke out) ->
            out.writeln("First line")
            out.writeln("Second line")
            out.writeln("Third line")
            out.close()
        Result.Err(_) ->
            stderr.write("Error: cannot create test file\n")
            return Result.Err(StdError.Error)

    # Read file line by line manually using readln()
    let Result@(File, IoError) read_result = open("test_read_manual.txt", FileMode.Read())
    match read_result:
        Result.Ok(poke f) ->
            let i32 count = 1

            let string line1 = f.readln().realise('')
            println("Line {count}: {line1}")
            count := count + 1

            let string line2 = f.readln().realise('')
            println("Line {count}: {line2}")
            count := count + 1

            let string line3 = f.readln().realise('')
            println("Line {count}: {line3}")
            count := count + 1

            f.close()

            let i32 total = count - 1
            println("Read {total} lines total")
            return Result.Ok(0)
        Result.Err(_) ->
            stderr.write("Error: cannot read test file\n")
            return Result.Err(StdError.Error)

    return Result.Ok(0)
