# EXPECT_STDOUT_EXACT: "Hello, Sushi!\nThis is a test file.\nFile write and read successful!\n"
# EXPECT_RUNTIME_EXIT: 0
# TEST_TYPE: runtime
# EXPECTED_OUTPUT: Hello, Sushi!
# EXPECTED_OUTPUT: This is a test file.
# EXPECTED_OUTPUT: File write and read successful!

use <io/fs>
use <io/files>
use <io/contracts>

# Reads one line and substitutes an empty string for the end of the file. readln()
# answers Maybe@(string) now, so a caller that does not care which of the two it got
# says so once, here, rather than losing the distinction at every call.
extend File line_or_empty() string:
    match self.readln():
        Result.Ok(Maybe.Some(line)) -> return line.clone()
        Result.Ok(Maybe.None) -> return ""
        Result.Err(_) -> return ""

fn main() i32:
    # Write text to file
    let Result@(File, IoError) write_result = open("test_output.txt", FileMode.Write())
    match nom write_result:
        Result.Ok(nom out) ->
            out.writeln("Hello, Sushi!")
            out.writeln("This is a test file.")
            out.close()
        Result.Err(_) ->
            stderr.write("Error: cannot open output.txt for writing\n")
            return Result.Err(StdError.Error)

    # Read text from file
    let Result@(File, IoError) read_result = open("test_output.txt", FileMode.Read())
    match nom read_result:
        Result.Ok(nom f) ->
            let string line1 = f.line_or_empty()
            let string line2 = f.line_or_empty()
            println(line1)
            println(line2)
            f.close()
        Result.Err(_) ->
            stderr.write("Error: cannot open file for reading\n")
            return Result.Err(StdError.Error)

    println("File write and read successful!")
    return Result.Ok(0)
