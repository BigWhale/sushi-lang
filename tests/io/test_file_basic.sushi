# EXPECT_STDOUT_EXACT: "Hello, Sushi!\nThis is a test file.\nFile write and read successful!\n"
# EXPECT_RUNTIME_EXIT: 0
# TEST_TYPE: runtime
# EXPECTED_OUTPUT: Hello, Sushi!
# EXPECTED_OUTPUT: This is a test file.
# EXPECTED_OUTPUT: File write and read successful!

use <io/fs>
use <io/files>

fn main() i32:
    # Write text to file
    let Result@(File, FileError) write_result = open("test_output.txt", FileMode.Write())
    match write_result:
        Result.Ok(poke out) ->
            out.writeln("Hello, Sushi!")
            out.writeln("This is a test file.")
            out.close()
        Result.Err(_) ->
            stderr.write("Error: cannot open output.txt for writing\n")
            return Result.Err(StdError.Error)

    # Read text from file
    let Result@(File, FileError) read_result = open("test_output.txt", FileMode.Read())
    match read_result:
        Result.Ok(poke f) ->
            let string line1 = f.readln().realise('')
            let string line2 = f.readln().realise('')
            println(line1)
            println(line2)
            f.close()
        Result.Err(_) ->
            stderr.write("Error: cannot open file for reading\n")
            return Result.Err(StdError.Error)

    println("File write and read successful!")
    return Result.Ok(0)
