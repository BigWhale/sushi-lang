# Reading standard input line by line: a BufReader takes a handle it OWNS, and the console
# handle is a unit variable that is never moved out of (CE2436) -- so `stdin.share()` hands
# over a second descriptor on the same input, and dropping the reader closes that one only.
# TEST_TYPE: runtime
# STDIN_INPUT: "First\nSecond\nThird\n"
# EXPECT_STDOUT_EXACT: "Reading lines from stdin:\n  > First\n  > Second\n  > Third\nDone!\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true

use <io/fs>
use <io/buf>
use <io/contracts>

fn echo_lines() ~ | IoError:
    stdout.write("Reading lines from stdin:\n")??
    let BufReader@(File) r = BufReader.new(nom stdin.share()??, 8192)??
    foreach(line?? in r.lines()):
        stdout.write("  > ")??
        stdout.write(line)??
        stdout.write("\n")??
    stdout.write("Done!\n")??
    return Result.Ok(~)

fn main() i32:
    match echo_lines():
        Result.Ok(_) -> return Result.Ok(0)
        Result.Err(_) -> return Result.Ok(1)
