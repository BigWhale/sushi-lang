# EXPECT_STDOUT_EXACT: "Binary file opened for writing\nWrote 5 bytes\nBinary file opened for reading\nRead 5 bytes\nBinary file test completed\n"
# EXPECT_RUNTIME_EXIT: 0
# TEST_TYPE: runtime
# EXPECTED_OUTPUT: Binary file opened for writing
# EXPECTED_OUTPUT: Wrote 5 bytes
# EXPECTED_OUTPUT: Binary file opened for reading
# EXPECTED_OUTPUT: Read 5 bytes
# EXPECTED_OUTPUT: Binary file test completed

use <io/files>
use <io/fs>

fn main() i32:
    # Create byte array
    let u8[] data = new()
    data.push(72 as u8)
    data.push(101 as u8)
    data.push(108 as u8)
    data.push(108 as u8)
    data.push(111 as u8)

    # Open binary file for writing
    let Result@(File, IoError) write_result = open("test_binary_minimal.bin", FileMode.WriteB())
    match nom write_result:
        Result.Ok(nom out) ->
            println("Binary file opened for writing")
            out.write_bytes(data)
            println("Wrote {data.len()} bytes")
            out.close()
        Result.Err(_) ->
            stderr.write("Error: cannot create binary file\n")
            return Result.Err(StdError.Error)

    data.destroy()

    # Open binary file for reading
    let Result@(File, IoError) read_result = open("test_binary_minimal.bin", FileMode.ReadB())
    match nom read_result:
        Result.Ok(nom f) ->
            println("Binary file opened for reading")
            let u8[] bytes = new()
            let u8[] nothing = from([])
            bytes := f.read_bytes(5).realise(nothing)
            println("Read {bytes.len()} bytes")
            f.close()
            bytes.destroy()
        Result.Err(_) ->
            stderr.write("Error: cannot read binary file\n")
            return Result.Err(StdError.Error)

    println("Binary file test completed")
    return Result.Ok(0)
