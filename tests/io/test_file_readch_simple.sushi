# EXPECT_STDOUT_EXACT: "H\nDone\n"
# EXPECT_RUNTIME_EXIT: 0
# TEST_TYPE: runtime
# EXPECTED_OUTPUT: H
# EXPECTED_OUTPUT: Done

use <io/fs>
use <io/files>

fn main() i32:
    # Write test file
    let Result@(File, FileError) write_result = open("test_readch_simple.txt", FileMode.Write())
    match write_result:
        Result.Ok(poke out) ->
            out.write("H")
            out.close()
        Result.Err(_) ->
            stderr.write("Error: cannot create test file\n")
            return Result.Err(StdError.Error)

    # Read file character by character using readch()
    let Result@(File, FileError) read_result = open("test_readch_simple.txt", FileMode.Read())
    match read_result:
        Result.Ok(poke f) ->
            let string ch = f.readch().realise('')
            println(ch)
            f.close()
            println("Done")
            return Result.Ok(0)
        Result.Err(_) ->
            stderr.write("Error: cannot read test file\n")
            return Result.Err(StdError.Error)

    return Result.Ok(0)
