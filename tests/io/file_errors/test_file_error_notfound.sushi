# EXPECT_STDOUT_EXACT: "Error: File not found - nonexistent_file_12345.txt\nHandled file error successfully\n"
# EXPECT_RUNTIME_EXIT: 0

use <io/fs>
use <io/files>

fn main() i32:
    # Try to open a file that doesn't exist
    let Result@(File, IoError) result = open("nonexistent_file_12345.txt", FileMode.Read())

    match nom result:
        Result.Ok(nom f) ->
            stderr.write("Error: should not have succeeded!\n")
            f.close()
            return 1
        Result.Err(err) ->
            # We have the IoError enum value, now match on it
            match err:
                IoError.NotFound ->
                    println("Error: File not found - nonexistent_file_12345.txt")
                    println("Handled file error successfully")
                    return 0
                _ ->
                    stderr.write("Error: unexpected error type\n")
                    return 1
