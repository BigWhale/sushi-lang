# EXPECT_STDOUT_EXACT: "Reading character by character:\nH\ne\nl\nl\no\nRead 5 characters\n"
# EXPECT_RUNTIME_EXIT: 0
# TEST_TYPE: runtime
# EXPECTED_OUTPUT: Reading character by character:
# EXPECTED_OUTPUT: H
# EXPECTED_OUTPUT: e
# EXPECTED_OUTPUT: l
# EXPECTED_OUTPUT: l
# EXPECTED_OUTPUT: o
# EXPECTED_OUTPUT: Read 5 characters

use <io/fs>
use <io/files>
use <collections/strings>

fn main() i32:
    # Write test file
    let Result@(File, IoError) write_result = open("test_readch_output.txt", FileMode.Write())
    match nom write_result:
        Result.Ok(nom out) ->
            out.write("Hello")
            out.close()
        Result.Err(_) ->
            stderr.write("Error: cannot create test file\n")
            return Result.Err(StdError.Error)

    # Read file character by character using readch()
    let Result@(File, IoError) read_result = open("test_readch_output.txt", FileMode.Read())
    match nom read_result:
        Result.Ok(nom f) ->
            println("Reading character by character:")
            let i32 count = 0

            let string ch = f.readch().realise('')
            while (ch != ""):
                println(ch)
                count := count + 1
                ch := f.readch().realise('')

            f.close()

            println("Read {count} characters")
            return Result.Ok(0)
        Result.Err(_) ->
            stderr.write("Error: cannot read test file\n")
            return Result.Err(StdError.Error)

    return Result.Ok(0)
