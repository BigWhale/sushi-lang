# TEST_TYPE: runtime
# STDIN_INPUT: "\n"
# EXPECT_STDOUT_EXACT: "\n"
# EXPECT_RUNTIME_EXIT: 0
# Test stdin.line_or_empty() with >1024 byte line (2010 chars: 2000 A's + 10 B's)

use <io/fs>

# Reads one line and substitutes an empty string for the end of the file. readln()
# answers Maybe@(string) now, so a caller that does not care which of the two it got
# says so once, here, rather than losing the distinction at every call.
extend File line_or_empty() string:
    match self.readln():
        Result.Ok(Maybe.Some(line)) -> return line.clone()
        Result.Ok(Maybe.None) -> return ""
        Result.Err(_) -> return ""

fn main() i32:
    let string line = stdin.line_or_empty()
    stdout.write(line)
    stdout.write("\n")
    return Result.Ok(0)
