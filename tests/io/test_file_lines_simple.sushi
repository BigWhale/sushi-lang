# Simple test for file.lines() type inference
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "Mostly Harmless\n"
use <io/files>
use <io/fs>

fn main() i32:
    # Write the file first. This test used to open a test.txt that nothing ever
    # created, so it always took the Err arm and exited 1 without reaching lines().
    let Result@(File, IoError) write_result = open("test_lines_simple.txt", FileMode.Write())
    match nom write_result:
        Result.Ok(nom out) ->
            out.writeln("Mostly Harmless")
            out.close()
        Result.Err(_) ->
            return Result.Err(StdError.Error)

    let Result@(File, IoError) result = open("test_lines_simple.txt", FileMode.Read())
    match result:
        Result.Ok(f) ->
            # Just call f.lines() to see if type inference works
            f.lines()
            println("Mostly Harmless")
        Result.Err(_) ->
            return Result.Err(StdError.Error)

    return Result.Ok(0)
