# EXPECT_STDOUT_EXACT: "Wrote 5 bytes\nRead 5 bytes back\nBinary file test completed\n"
# EXPECT_RUNTIME_EXIT: 0
# TEST_TYPE: runtime
# EXPECTED_OUTPUT: Wrote 5 bytes
# EXPECTED_OUTPUT: Read 5 bytes back
# EXPECTED_OUTPUT: Binary file test completed

use <io/files>
use <io/fs>

fn main() i32:
    # Write binary data to file
    let Result@(File, IoError) write_result = open("test_binary_simple.bin", FileMode.WriteB())
    match nom write_result:
        Result.Ok(nom out) ->
            # Create byte array with "Hello" (72, 101, 108, 108, 111)
            let u8[] data = from([72, 101, 108, 108, 111])
            out.write_bytes(data)
            println("Wrote {data.len()} bytes")
            out.close()
            data.destroy()
        Result.Err(_) ->
            stderr.write("Error: cannot create binary file\n")
            return Result.Err(StdError.Error)

    # Read binary data from file
    let Result@(File, IoError) read_result = open("test_binary_simple.bin", FileMode.ReadB())
    match nom read_result:
        Result.Ok(nom f) ->
            let u8[] bytes = new()
            let u8[] nothing = from([])
            bytes := f.read_bytes(5).realise(nothing)
            println("Read {bytes.len()} bytes back")
            f.close()
            bytes.destroy()
            println("Binary file test completed")
            return Result.Ok(0)
        Result.Err(_) ->
            stderr.write("Error: cannot read binary file\n")
            return Result.Err(StdError.Error)

    return Result.Ok(0)
