# A user variable that spells the name the compiler used for the raw item of a
# `foreach(x?? in ...)` loop keeps its own value and its own type.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "101\n102\n"
# EXPECT_STDERR_EMPTY: true

fn item(i32 n) Result@(i32, StdError):
    return Result.Ok(n)

fn walk() ~:
    let i32 __fe_item0 = 100
    foreach(v?? in from([item(1), item(2)]).iter()):
        println(v + __fe_item0)
    return Result.Ok(~)

fn main() i32:
    match walk():
        Result.Ok(_) -> return Result.Ok(0)
        Result.Err(_) -> return Result.Ok(1)
