# A user variable that spells the name the compiler used for the `_` binder of a
# `foreach(_?? in ...)` loop keeps its own value. A name the compiler makes can never
# collide with a name the user writes.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "100\n100\n"
# EXPECT_STDERR_EMPTY: true

fn item(i32 n) Result@(i32, StdError):
    return Result.Ok(n)

fn walk() ~ | StdError:
    let i32 __fe_discard0 = 100
    foreach(_?? in from([item(1), item(2)]).iter()):
        println(__fe_discard0)
    return Result.Ok(~)

fn main() i32:
    match walk():
        Result.Ok(_) -> return 0
        Result.Err(_) -> return 1
