# An arm with alternatives that bind a string payload, and a body that leaves by a
# `break`, a `continue` or a `return`. Each exit ends the regions of the binders.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "skip a0\nkeep b1\nstop a2\nfound b1\n4\n"

enum Word:
    A(string)
    B(string)
    Gone

fn make(i32 k) Word:
    let string text = "{k}"
    if (k % 2 == 0):
        return Word.A("a{text}")
    return Word.B("b{text}")

fn find(i32 k) i32:
    let Word w = make(k)
    match w:
        Word.A(s) | Word.B(s) ->
            if (s == "b1"):
                println("found {s}")
                return s.len() + 2
            return 0
        Word.Gone -> return 0

fn main() i32:
    foreach(k in 0..5):
        let Word w = make(k)
        match w:
            Word.A(s) | Word.B(s) ->
                if (k == 0):
                    println("skip {s}")
                    continue
                if (k == 2):
                    println("stop {s}")
                    break
                println("keep {s}")
            Word.Gone -> println("gone")
    println(find(1))
    return 0
