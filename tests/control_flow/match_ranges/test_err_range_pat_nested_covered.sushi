# The arm above matches every value of `Maybe.Some(3..=4)`, so the arm can never run.
# EXPECT_ERROR_CODES_EXACT: CE2118

fn f(Maybe@(i32) m) string:
    match m:
        Maybe.Some(0..=9) -> return "digit"
        Maybe.Some(3..=4) -> return "never"
        _ -> return "other"

fn main() i32:
    println(f(Maybe.Some(1)))
    return 0
