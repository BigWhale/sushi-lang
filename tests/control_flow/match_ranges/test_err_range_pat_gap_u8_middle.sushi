# The ranges leave out the u8 value 0x80 (128), and there is no `_` arm.
# EXPECT_ERROR_CODES_EXACT: CE2074
# EXPECT_STDERR_CONTAINS: 128

fn f(u8 b) string:
    match b:
        0x00..=0x7f -> return "low"
        0x81..=0xff -> return "high"
    return "other"

fn main() i32:
    println(f(1))
    return 0
