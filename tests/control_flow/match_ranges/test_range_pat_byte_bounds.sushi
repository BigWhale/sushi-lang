# A byte literal is a range bound on a u8 scrutinee. Ranges and a literal mix as `|`
# alternatives of one arm.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "digit\ndigit\nword\nword\nword\nword\nword\nother\nother\n"

fn kind(u8 c) string:
    match c:
        a'0'..=a'9' -> return "digit"
        a'a'..=a'z' | a'A'..=a'Z' | a'_' -> return "word"
        _ -> return "other"

fn main() i32:
    println(kind(a'0'))
    println(kind(a'9'))
    println(kind(a'a'))
    println(kind(a'z'))
    println(kind(a'A'))
    println(kind(a'Z'))
    println(kind(a'_'))
    println(kind(a'-'))
    println(kind(a' '))
    return 0
