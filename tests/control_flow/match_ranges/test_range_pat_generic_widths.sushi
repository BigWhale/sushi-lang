# One generic function reads its literal and range arms at two types. A hex bound is a
# bit pattern of the type at its position: `0xff` is -1 on an i8 and 255 on a u8, and
# `0x80..=0xfe` is -128 to -2 on an i8 and 128 to 254 on a u8. A range in an `Own(...)`
# pattern reads the pointee.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "all bits\nall bits\nhigh\nhigh\nother\nsmall\nsmall\nbig\n"

fn wide@(T)(Maybe@(T) m) string:
    match m:
        Maybe.Some(0xff) -> return "all bits"
        Maybe.Some(0x80..=0xfe) -> return "high"
        _ -> return "other"

fn boxed(Maybe@(Own@(i32)) o) string:
    match o:
        Maybe.Some(Own(0..=9 | 20)) -> return "small"
        _ -> return "big"

fn main() i32:
    let i8 a = -1
    let u8 b = 255
    let i8 c = -100
    let u8 d = 200
    let u8 e = 3
    println(wide(Maybe.Some(a)))
    println(wide(Maybe.Some(b)))
    println(wide(Maybe.Some(c)))
    println(wide(Maybe.Some(d)))
    println(wide(Maybe.Some(e)))
    println(boxed(Maybe.Some(Own.alloc(5))))
    println(boxed(Maybe.Some(Own.alloc(20))))
    println(boxed(Maybe.Some(Own.alloc(11))))
    return 0
