# Literal arms and ranges together hold every value of an i8, so the match needs no `_`
# arm. A hex literal is a bit pattern of the i8: `0xff` is -1.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "minus one\nminus one\nnegative\nzero\npositive\n"

fn name(i8 n) string:
    match n:
        0xff -> return "minus one"
        -128..=-2 -> return "negative"
        0 -> return "zero"
        1..=127 -> return "positive"

fn main() i32:
    let i8 a = -1
    let i8 b = -128
    println(name(a))
    println(name(0xff))
    println(name(b))
    println(name(0))
    println(name(127))
    return 0
