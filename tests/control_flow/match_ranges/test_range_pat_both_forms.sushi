# An integer range is a pattern in two forms. `a..b` matches a to b-1, and `a..=b`
# matches a to b. A value that no range holds goes to the `_` arm.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "low\nlow\nteen\nteen\nother\nother\n"

fn classify(i32 n) string:
    match n:
        0..10 -> return "low"
        10..=19 -> return "teen"
        _ -> return "other"

fn main() i32:
    println(classify(0))
    println(classify(9))
    println(classify(10))
    println(classify(19))
    println(classify(20))
    println(classify(-1))
    return 0
