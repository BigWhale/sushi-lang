# `|` alternatives of enum variants, with a payload and with none. The arms cover the
# enum only through alternatives, so the match is exhaustive with no `_` arm.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "true\ntrue\nfalse\n0\n0\n4\n1\n1\n1\n"

enum Color:
    Red
    Green
    Blue

enum Shape:
    Circle(i32)
    Square(i32)
    Dot

fn warm(Color c) bool:
    match c:
        Color.Red | Color.Green -> return true
        Color.Blue -> return false

fn corners(Shape s) i32:
    match s:
        Shape.Circle(_) | Shape.Dot -> return 0
        Shape.Square(_) -> return 4

fn one(Color c) i32:
    match c:
        Color.Blue | Color.Red | Color.Green -> return 1

fn main() i32:
    println(warm(Color.Red))
    println(warm(Color.Green))
    println(warm(Color.Blue))
    println(corners(Shape.Circle(3)))
    println(corners(Shape.Dot))
    println(corners(Shape.Square(2)))
    println(one(Color.Red))
    println(one(Color.Green))
    println(one(Color.Blue))
    return 0
