# `|` alternatives over a tuple: string alternatives in an element, and whole tuple
# patterns as alternatives over a tuple literal. Each element of a tuple literal is its
# own scrutinee, so a binding, a `poke` binding included, reads the element of the
# alternative that matched.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
# EXPECT_STDOUT_EXACT: "read zero\nread 4\nother\n3\n4\n-1\nblue\n101\ngreen\n2\n1\n"
use <collections/strings>
enum Color:
    Red
    Green
    Blue

fn verb((string, i32) p) string:
    match p:
        ("get" | "head", 0) -> return "read zero"
        ("get" | "head", n) -> return "read {n}"
        (_, _) -> return "other"

fn pair(Color c, i32 n) i32:
    match (c, n):
        (Color.Red, k) | (Color.Blue, k) -> return k
        (Color.Green, _) -> return -1

fn bump(Color c, i32 n) i32:
    let i32 v = n
    let string s = "{n}x"
    match (c, v):
        (Color.Red, poke k) | (Color.Blue, poke k) -> k := k + 100
        (Color.Green, _) -> println("green")
    match (c, s):
        (Color.Red, x) | (Color.Green, x) -> println(x.len())
        (Color.Blue, _) -> println("blue")
    return v

fn main() i32:
    println(verb(("get", 0)))
    println(verb(("head", 4)))
    println(verb(("put", 4)))
    println(pair(Color.Red, 3))
    println(pair(Color.Blue, 4))
    println(pair(Color.Green, 4))
    println(bump(Color.Blue, 1))
    println(bump(Color.Green, 1))
    return 0
