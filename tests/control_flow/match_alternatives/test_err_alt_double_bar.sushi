# The lexer reads `||` as the logical operator, so `1||2` is not two alternatives. The
# parse error tells the user to put a space between the alternatives.
# EXPECT_ERROR_CODE: CE6001
# EXPECT_STDERR_CONTAINS: "put a space: '1 | 2'"

fn name(i32 n) i32:
    match n:
        1||2 -> return 1
        _ -> return 0

fn main() i32:
    println(name(1))
    return 0
