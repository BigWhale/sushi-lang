# `5..5` is empty: the loop body does not run, and there is no diagnostic. A range that
# goes down (`5..=4`) is CE2125, see tests/control_flow/range_direction/.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDERR_EMPTY: true
# EXPECT_STDOUT_EXACT: "Empty range (5..5):\nDone\n"
fn main() i32:
    println("Empty range (5..5):")
    foreach(i in 5..5):
        println(i)
        println("Should not print")

    println("Done")
    return 0
