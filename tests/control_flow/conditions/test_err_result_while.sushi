# A while condition follows the same rule as an if condition (#522).
# EXPECT_ERROR_CODE: CE2516
fn step(i32 n) i32:
    if (n >= 3):
        return Result.Err(StdError.Error)
    return Result.Ok(n + 1)

fn main() i32:
    let i32 count = 0
    while (step(count)):
        count := count + 1
    return Result.Ok(0)
