# EXPECT_STDOUT_EXACT: "Using default config (file not found)\nConfig: default=true\n"
# TEST_TYPE: runtime
# EXPECTED_OUTPUT: Using default config (file not found)
# EXPECTED_OUTPUT: Config: default=true

# Realistic nested pattern example over a handle's error channel, which is IoError
# This tests nested pattern matching with the file I/O system

use <io/files>
use <io/fs>

fn load_config() string:
    let Result@(File, IoError) result = open("nonexistent_nested_test.txt", FileMode.Read())
    match result:
        Result.Ok(poke f) ->
            let string content = f.read_all().realise('')
            f.close()
            return Result.Ok(content)
        Result.Err(IoError.NotFound) ->
            println("Using default config (file not found)")
            return Result.Ok("default=true")
        Result.Err(IoError.PermissionDenied) ->
            println("Error: Permission denied")
            return Result.Err(StdError.Error)
        Result.Err(_) ->
            println("Error: Other I/O error")
            return Result.Err(StdError.Error)

fn main() i32:
    let string config = load_config().realise("")
    println("Config: {config}")
    return Result.Ok(0)
