# A range as an array-literal element inside a generic call's argument, bare and inside a
# constructor argument. The call is solved from the argument (#1165).
# EXPECT_STDOUT_EXACT: "4\n2\n"
struct Holder@(T):
    T it

fn size@(T)(T[] xs) i32:
    return xs.len()

fn held@(T)(Holder@(T[]) h) i32:
    return h.it.len()

fn main() i32:
    println(size(from([0..3, 7])))
    println(held(Holder(from([5..=6]))))
    return 0
