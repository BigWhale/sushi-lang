# `foreach(_?? in it)` propagates the Err of an item and discards the value of an Ok
# item. The third step fails, so the body runs twice and the caller sees the error.
# The Ok payload is an owning string, and the discarded value is destroyed.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "step\nstep\nfailed\n"
# EXPECT_STDERR_EMPTY: true
# EXPECT_NO_LEAKS

enum Bad:
    Broken()

struct Steps:
    i32 at

extend Steps next(poke self) Maybe@(Result@(string, Bad)):
    self.at := self.at + 1
    if (self.at > 4):
        let Maybe@(Result@(string, Bad)) ended = Maybe.None()
        return ended
    if (self.at == 3):
        let Maybe@(Result@(string, Bad)) failed = Maybe.Some(Result.Err(Bad.Broken))
        return failed
    let string text = "item {self.at}"
    let Maybe@(Result@(string, Bad)) got = Maybe.Some(Result.Ok(text))
    return got

fn walk() ~ | Bad:
    let Steps s = Steps(0)
    foreach(_?? in s):
        println("step")
    return Result.Ok(~)

fn main() i32:
    match walk():
        Result.Ok(_) -> println("finished")
        Result.Err(_) -> println("failed")
    return Result.Ok(0)
