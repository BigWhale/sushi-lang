# An 'if' with an 'else' whose every arm returns ends the path, so the next
# statement is dead (#854).
# EXPECT_ERROR_CODE: CE0140
# EXPECT_STDERR_CONTAINS: test_err_dead_after_if_else.sushi:10:5
fn g(i32 x) i32:
    if (x > 0):
        return 1
    else:
        return 2
    println("never")
    return 3

fn main() i32:
    println("{g(1)}")
    return 0
