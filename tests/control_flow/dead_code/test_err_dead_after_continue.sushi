# A statement after a 'continue' in the same block can never run (#854).
# EXPECT_ERROR_CODE: CE0140
# EXPECT_STDERR_CONTAINS: test_err_dead_after_continue.sushi:8:9
fn main() i32:
    let i32 total = 0
    foreach(i in 0..3):
        continue
        total := total + i
    println("{total}")
    return Result.Ok(0)
