# EXPECT_STDOUT_EXACT: "42\n"

# Simple nested pattern with nested enums
# This tests the basic functionality of nested pattern matching


enum Inner:
    Some(i32)
    None

enum Outer:
    Value(Inner)
    Empty

fn test_nested() i32:
    let Outer w = Outer.Value(Inner.Some(42))
    match w:
        Outer.Value(Inner.Some(x)) ->
            return x
        Outer.Value(Inner.None) ->
            return 0
        Outer.Empty ->
            return -1

fn main() i32:
    let i32 result = test_nested()
    println("{result}")
    return 0
