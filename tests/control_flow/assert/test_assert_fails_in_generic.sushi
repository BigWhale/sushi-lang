# A false assert in a generic body reports the position of the template.
# EXPECT_RUNTIME_EXIT: 1
# EXPECT_STDOUT_EXACT: "same\n"
# EXPECT_STDERR_CONTAINS: "test_assert_fails_in_generic.sushi:7:5: the two values differ\n"

fn same@(T: Eq)(T x, T y) ~:
    assert(x == y, "the two values differ")
    println("same")

fn main() i32:
    same(1, 1)
    same("a", "b")
    return 0
