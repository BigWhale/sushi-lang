# A second `.rev()` turns the range back: `(0..3).rev().rev()` yields 0, 1, 2.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "0 1 2 \n0 1 2 \n3 2 1 \n"

fn main() i32:
    foreach(i in (0..3).rev().rev()):
        print("{i} ")
    println("")
    foreach(i in ((0..3).rev()).rev()):
        print("{i} ")
    println("")
    foreach(i in (1..=3).rev().rev().rev()):
        print("{i} ")
    println("")
    return 0
