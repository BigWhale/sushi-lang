# A foreach inside a loop, over a local that the outer scope declares, moves the local in
# the first round, so the second round uses a moved value.
# EXPECT_ERROR_CODES_EXACT: CE2405

error Bad:
    Oops

struct Feed:
    i32[] items
    i32 at

extend Feed next(poke self) Maybe@(Result@(i32, Bad)):
    let i32 at = self.at
    self.at := self.at + 1
    match self.items.get(at):
        Maybe.Some(v) -> return Maybe.Some(Result.Ok(v))
        Maybe.None -> return Maybe.None

fn main() i32:
    let Feed f = Feed(from([4, 5]), 0)
    foreach(n in 0..2):
        foreach(r in f):
            println(r.realise(n))
    return 0
