# A foreach consumes its iterable: a mention of the local after the loop is a use after
# a move.
# EXPECT_ERROR_CODES_EXACT: CE2405

enum Bad:
    Oops

struct Feed:
    i32[] items
    i32 at

extend Feed next(poke self) Maybe@(Result@(i32, Bad)):
    let i32 at = self.at
    self.at := self.at + 1
    match self.items.get(at):
        Maybe.Some(v) -> return Maybe.Some(Result.Ok(v))
        Maybe.None -> return Maybe.None

fn main() i32:
    let Feed f = Feed(from([4, 5]), 0)
    foreach(r in f):
        println(r.realise(0))
    println(f.at)
    return 0
