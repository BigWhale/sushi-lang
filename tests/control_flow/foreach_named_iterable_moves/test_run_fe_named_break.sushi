# A break out of a foreach over a named local destroys the iterator one time.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "4\ndone\n"
# EXPECT_NO_LEAKS

enum Bad:
    Oops

struct Feed:
    i32[] items
    i32 at

extend Feed next(poke self) Maybe@(Result@(i32, Bad)):
    let i32 at = self.at
    self.at := self.at + 1
    match self.items.get(at):
        Maybe.Some(v) -> return Maybe.Some(Result.Ok(v))
        Maybe.None -> return Maybe.None

fn main() i32:
    let Feed f = Feed(from([4, 5, 6]), 0)
    foreach(r in f):
        let i32 v = r.realise(0)
        if (v == 5):
            break
        println(v)
    println("done")
    return 0
