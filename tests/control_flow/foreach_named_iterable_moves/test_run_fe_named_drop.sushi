# A foreach over a named local whose type implements Drop: drop() runs one time, when the
# loop ends, and never at the scope exit of the local.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "1\n2\ndropped\ndone\n"
# EXPECT_NO_LEAKS

struct Ticker:
    string label
    i32 at
    i32 stop

extend Ticker with Drop:
    fn drop(poke self) ~:
        println(self.label)

extend Ticker next(poke self) Maybe@(i32):
    if (self.at >= self.stop):
        return Maybe.None
    self.at := self.at + 1
    return Maybe.Some(self.at)

fn main() i32:
    let Ticker t = Ticker("dropped".clone(), 0, 2)
    foreach(n in t):
        println(n)
    println("done")
    return 0
