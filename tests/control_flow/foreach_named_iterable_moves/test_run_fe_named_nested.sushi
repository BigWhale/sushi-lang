# A foreach over a named local inside a foreach over a named local: each loop moves its
# own local, and each iterator is destroyed one time per round.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "1:4\n1:5\n2:4\n2:5\ndone\n"
# EXPECT_NO_LEAKS

enum Bad:
    Oops

struct Feed:
    i32[] items
    i32 at

extend Feed next(poke self) Maybe@(Result@(i32, Bad)):
    let i32 at = self.at
    self.at := self.at + 1
    match self.items.get(at):
        Maybe.Some(v) -> return Maybe.Some(Result.Ok(v))
        Maybe.None -> return Maybe.None

fn main() i32:
    let Feed outer = Feed(from([1, 2]), 0)
    foreach(o in outer):
        let Feed inner = Feed(from([4, 5]), 0)
        foreach(i in inner):
            println("{o.realise(0)}:{i.realise(0)}")
    println("done")
    return 0
