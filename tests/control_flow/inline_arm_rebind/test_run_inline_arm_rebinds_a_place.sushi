# A rebind target is a PLACE, not only a bare name: a field and an array slot are the
# same statement, so the inline arm takes them too (#552).
# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "7 9\n"

struct Tally:
    i32 hits

fn main() i32:
    let Tally t = Tally(0)
    let i32[] slots = from([0, 0])
    let Maybe@(i32) m = Maybe.Some(7)
    match m:
        Maybe.Some(v) -> t.hits := v
        Maybe.None -> ~
    match m:
        Maybe.Some(v) -> slots[1] := v + 2
        Maybe.None -> ~
    println("{t.hits} {slots[1]}")
    return Result.Ok(0)
