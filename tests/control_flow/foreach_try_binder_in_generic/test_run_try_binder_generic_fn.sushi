# A `??` binder on a `foreach` in a GENERIC function body compiles as it does in a plain
# body (#1140). The template has two instances; the second step of the walk fails, so
# each call leaves the function at the Err.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "walk 1\nstep 1\nerr\nwalk two\nstep 1\nerr\n"
# EXPECT_NO_LEAKS

struct Counter:
    i32 n

extend Counter next(poke self) Maybe@(Result@(i32, StdError)):
    if (self.n >= 3):
        return Maybe.None
    self.n := self.n + 1
    if (self.n == 2):
        return Maybe.Some(Result.Err(StdError.Error))
    return Maybe.Some(Result.Ok(self.n))

fn total@(T: Display)(T label) i32 | StdError:
    println("walk {label}")
    let i32 sum = 0
    foreach(x?? in Counter(0)):
        println("step {x}")
        sum := sum + x
    return Result.Ok(sum)

fn main() i32:
    match total(1):
        Result.Ok(v) -> println("ok {v}")
        Result.Err(_) -> println("err")
    match total("two"):
        Result.Ok(v) -> println("ok {v}")
        Result.Err(_) -> println("err")
    return 0
