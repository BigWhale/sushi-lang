# A `??` binder on a `foreach` in the body of an extension on a GENERIC target compiles
# (#1140). The template has two instances, and the walk of the second meets an Err.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "ok 3\nerr\n"

enum Bad:
    Broken()

struct Steps:
    i32 n
    i32 fail_at

extend Steps next(poke self) Maybe@(Result@(i32, Bad)):
    if (self.n >= 2):
        return Maybe.None
    self.n := self.n + 1
    if (self.n == self.fail_at):
        return Maybe.Some(Result.Err(Bad.Broken))
    return Maybe.Some(Result.Ok(self.n))

struct Box@(T):
    T value
    i32 fail_at

extend Box@(T) walk() i32 | Bad:
    let i32 sum = 0
    foreach(x?? in Steps(0, self.fail_at)):
        sum := sum + x
    return Result.Ok(sum)

fn main() i32:
    let Box@(i32) a = Box(1, 0)
    match a.walk():
        Result.Ok(v) -> println("ok {v}")
        Result.Err(_) -> println("err")
    let Box@(bool) b = Box(true, 2)
    match b.walk():
        Result.Ok(v) -> println("ok {v}")
        Result.Err(_) -> println("err")
    return 0
