# A `??` binder on a `foreach` in the body of a lambda that a GENERIC function holds
# compiles (#1140): the copy of the template copies the lambda body too.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "run 1\nok 6\n"

error Bad:
    Broken()

struct Steps:
    i32 n

extend Steps next(poke self) Maybe@(Result@(i32, Bad)):
    if (self.n >= 3):
        return Maybe.None
    self.n := self.n + 1
    return Maybe.Some(Result.Ok(self.n))

fn run@(T: Display)(T label) i32 | Bad:
    println("run {label}")
    let fn() -> i32 | Bad walk = |~|:
        let i32 sum = 0
        foreach(x?? in Steps(0)):
            sum := sum + x
        return Result.Ok(sum)
    return Result.Ok(walk()??)

fn main() i32:
    match run(1):
        Result.Ok(v) -> println("ok {v}")
        Result.Err(_) -> println("err")
    return 0
