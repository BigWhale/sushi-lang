# A dependency reorders the fields of a public struct. The consumer's source does not
# move, and its object bakes the field offsets in, so the cache must rebuild it: a stale
# object reads x from the slot that now holds y and prints "4 3".
# EXPECT_STDOUT_EXACT_BEFORE_REBUILD: "3 4\n"
# EXPECT_STDOUT_EXACT: "3 4\n"
# EXPECT_REBUILT: geo, test_cache_struct_shape
use "geo"

fn main() i32:
    match make():
        Result.Ok(v) -> println("{v.x} {v.y}")
        Result.Err(_) -> return Result.Ok(1)
    return Result.Ok(0)
