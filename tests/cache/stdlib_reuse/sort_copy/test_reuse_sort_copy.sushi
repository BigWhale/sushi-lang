# The program makes collections/sort hold a copy of its template sort. The object of that
# unit depends on the program, so the compiler checks the unit again and keeps its object
# in the project cache, not in the per-user cache.
# RUN_IN_FIXTURE_DIR
# FIXTURE_SUSHI_HOME: home
# THEN_CLEAN_CACHE: source
# EXPECT_STDOUT_EXACT: "1 2 3\n"
# EXPECT_REBUILT: test_reuse_sort_copy, collections/sort
use <collections/sort>

fn main() i32:
    let i32[] xs = from([3, 1, 2])
    xs.sort()
    println("{xs[0]} {xs[1]} {xs[2]}")
    return 0
