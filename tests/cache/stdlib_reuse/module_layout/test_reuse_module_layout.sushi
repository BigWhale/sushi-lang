# A stdlib module takes a struct from another stdlib module. A change of the field order
# changes the interface of the module, so the key of each unit that reads it changes.
# STDLIB_MODULE: fixture/base=base.sushi
# STDLIB_MODULE: fixture/top=top.sushi
# FIXTURE_SUSHI_HOME: home
# EXPECT_STDOUT_EXACT_BEFORE_REBUILD: "1 2\n"
# EXPECT_STDOUT_EXACT: "1 2\n"
# EXPECT_REBUILT: fixture/base, fixture/top, test_reuse_module_layout
use <fixture/top>
use <fixture/base>

fn main() i32:
    let Pair p = make()
    println("{p.left} {p.right}")
    return 0
