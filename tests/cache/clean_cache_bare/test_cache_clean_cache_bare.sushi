# A bare `sushic --clean-cache` in the user's directory removes the cache of that
# directory. The runner also fails the fixture if the checkout's own cache is gone (#976).
# RUN_IN_FIXTURE_DIR
# EXPECT_STDOUT_EXACT: "1\n"
# EXPECT_PATH_EXISTS_BEFORE_CLEAN: __sushi_cache__/units
# THEN_CLEAN_CACHE: bare
# EXPECT_PATH_ABSENT: __sushi_cache__
use "unit"

fn main() i32:
    println(one().realise(0))
    return Result.Ok(0)
