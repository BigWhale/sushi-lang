# A binary library built again from the same source is the same file, so the second
# build of the consumer reuses every unit: its own units, and the stdlib units of the
# per-user cache. v2/ holds a byte-equal copy of the library source.
# FIXTURE_SUSHI_HOME: home
# BUILD_LIB_BINARY: probelib.sushi
# EXPECT_STDOUT_EXACT_BEFORE_REBUILD: "Mostly Harmless\n"
# EXPECT_STDOUT_EXACT: "Mostly Harmless\n"
# EXPECT_CACHED: test_lib_rebuild_same_binary, probe_util, io/fs, io/contracts, io/error
# EXPECT_CACHED: io/path, net/error, sys/platform, text/ascii, collections/strings
use <lib/probelib>
use <io/fs>
use "probe_util"

fn main() i32:
    if (probe_twice(2) != 4):
        return 3
    return probe_say("Mostly Harmless\n")
