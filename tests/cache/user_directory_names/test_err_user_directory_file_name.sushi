# The compiler starts in the user's directory. A diagnostic names the file relative to
# that directory, the way the user wrote it on the command line.
# RUN_IN_FIXTURE_DIR
# EXPECT_ERROR_CODE: CE2002
# EXPECT_STDERR_CONTAINS: "./test_err_user_directory_file_name.sushi:7:"
fn main() i32:
    let i32 x = "not a number"
    println(x)
    return Result.Ok(0)
