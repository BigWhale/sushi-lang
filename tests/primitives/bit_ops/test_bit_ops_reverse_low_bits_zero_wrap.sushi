# COMPILER_FLAGS: --overflow=wrap
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "u8 208\nu16 53248\nu32 3489660928\nu64 14987979559889010688\n4294967295\n"
#
# The low n bits of c, reversed, for n = 0, with --overflow=wrap: the count W - n is the
# width, which is masked to 0, so the answer is the full reversal. The value is 11 (0b1011).
fn low8(u8 c, i32 n) u8:
    return c.reverse_bits() >> (8 - n)

fn low16(u16 c, i32 n) u16:
    return c.reverse_bits() >> (16 - n)

fn low32(u32 c, i32 n) u32:
    return c.reverse_bits() >> (32 - n)

fn low64(u64 c, i32 n) u64:
    return c.reverse_bits() >> (64 - n)

fn main() i32:
    println("u8 {low8(11, 0)}")
    println("u16 {low16(11, 0)}")
    println("u32 {low32(11, 0)}")
    println("u64 {low64(11, 0)}")
    let u32 c = 0xFFFF_FFFF
    let i32 none = 0
    let u32 z = c.reverse_bits() >> (32 - none)
    println("{z}")
    return 0
