# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "0 0 8 8\n1 128 7 0\n255 255 0 0\n128 1 0 7\n22 104 3 1\n"
#
# reverse_bits, leading_zeros and trailing_zeros on u8 (8 bits): zero, one, the maximum,
# the top bit alone, and a pattern. Each line is: value, reversed, leading, trailing.
fn show(u8 x) ~:
    let u8 r = x.reverse_bits()
    let i32 lead = x.leading_zeros()
    let i32 trail = x.trailing_zeros()
    println("{x} {r} {lead} {trail}")

fn main() i32:
    show(0)
    show(1)
    show(255)
    show(0x80)
    show(0b0001_0110)
    return 0
