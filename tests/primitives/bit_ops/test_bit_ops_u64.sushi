# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "0 0 64 64\n1 9223372036854775808 63 0\n18446744073709551615 18446744073709551615 0 0\n9223372036854775808 1 0 63\n1030792151296 36028797270622208 24 8\n"
#
# reverse_bits, leading_zeros and trailing_zeros on u64 (64 bits): zero, one, the maximum,
# the top bit alone, and a pattern. Each line is: value, reversed, leading, trailing.
fn show(u64 x) ~:
    let u64 r = x.reverse_bits()
    let i32 lead = x.leading_zeros()
    let i32 trail = x.trailing_zeros()
    println("{x} {r} {lead} {trail}")

fn main() i32:
    show(0)
    show(1)
    show(0xFFFF_FFFF_FFFF_FFFF)
    show(0x8000_0000_0000_0000)
    show(0x0000_00F0_0000_0100)
    return 0
