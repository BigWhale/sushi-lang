# The right operand of `or` runs on some paths only. A `nom` move in it is a move on
# those paths, and the local is freed one time on each path.
# EXPECT_STDOUT_EXACT: "n=1\nm=6\n"
# EXPECT_NO_LEAKS

fn take(nom string s) bool:
    return s.len() > 5

fn main() i32:
    let string s = "Mostly Harmless {1}"
    let i32 n = 0
    if (n > 3 or take(nom s)):
        n := n + 1
    println("n={n}")
    let string t = "Mostly Harmless {2}"
    let i32 m = 5
    if (m > 3 or take(nom t)):
        m := m + 1
    println("m={m}")
    return 0
