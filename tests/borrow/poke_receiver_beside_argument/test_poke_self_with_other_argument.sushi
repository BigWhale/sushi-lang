# A `poke self` receiver beside a plain argument of a different owner is legal.
# EXPECT_STDOUT_EXACT: "5\n"
# EXPECT_NO_LEAKS

extend i32[] append_all(poke self, i32[] xs) ~:
    foreach(x in xs.iter()):
        self.push(x)

fn main() i32:
    let i32[] data = from([1, 2, 3])
    let i32[] extra = from([4, 5])
    data.append_all(extra)
    println(data.len())
    return 0
