# A write through a `let`-borrow is CE2426. A `List@(File)` owns a resource, so
# `v.clone()` is refused (CE2431) and the help must not offer the copy escape: it
# names the escapes that compile.
# EXPECT_ERROR_CODES_EXACT: CE2426
# EXPECT_STDERR_CONTAINS: "write to the owner directly -- otherwise a descriptor cannot be deep-copied, so there is no `v.clone()`, and its type has no `share()` that gives a second owner; restructure so only one owner is needed\n"

use <io/fs>

struct H:
    List@(File) items

fn main() i32:
    let H h = H(List.new())
    let List@(File) v = h.items
    v.clear()
    println(h.items.len())
    return 0
