# A write through a `peek` parameter is CE2408. A `List@(File)` owns a resource, so
# `v.clone()` is refused (CE2431) and the help must not offer the copy escape: it
# names the escapes that compile.
# EXPECT_ERROR_CODES_EXACT: CE2408
# EXPECT_STDERR_CONTAINS: "declare it `poke` if the write must reach the owner -- otherwise a descriptor cannot be deep-copied, so there is no `v.clone()`, and its type has no `share()` that gives a second owner; restructure so only one owner is needed\n"

use <io/fs>

fn f(peek List@(File) v) ~:
    v.clear()

fn main() i32:
    return 0
