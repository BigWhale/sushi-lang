# A move of a local the loop does not walk is no change under the iterator. The use on
# the next round is a use after move, CE2405, and nothing else (#995).
# EXPECT_ERROR_CODES_EXACT: CE2405
# EXPECT_STDERR_CONTAINS: 14:17: error [CE2405]

fn eat(nom i32[] a) ~:
    println(a.len())

fn walk() ~ | StdError:
    let i32[] a = from([1, 2, 3])
    let i32[] b = from([4, 5])
    foreach(x in a.iter()):
        println(x)
        eat(nom b)
    return Result.Ok(~)

fn main() i32:
    match walk():
        Result.Ok(_) -> return 0
        Result.Err(_) -> return 1
