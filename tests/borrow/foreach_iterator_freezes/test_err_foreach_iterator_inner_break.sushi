# A `break` leaves its own loop only: the change reaches the outer loop's next round
# and conflicts with the outer iterator (#993).
# EXPECT_ERROR_CODES_EXACT: CE2412

fn main() i32:
    let i32[] a = from([1, 2, 3])
    foreach(x in a.iter()):
        println(x)
        while (true):
            a.push(5)
            break
    println(a.len())
    return 0
