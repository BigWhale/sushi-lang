# The iterator reports the move of the walked container (CE2412). A use of the
# container after the move in the SAME round is a use after move of its own, and it is
# still CE2405 (#995).
# EXPECT_ERROR_CODES_EXACT: CE2412, CE2405
# EXPECT_STDERR_CONTAINS: 16:17: error [CE2412]
# EXPECT_STDERR_CONTAINS: 17:17: error [CE2405]

fn eat(nom i32[] a) ~:
    println(a.len())

fn walk() ~ | StdError:
    let i32[] a = from([1, 2, 3])
    foreach(x in a.iter()):
        println(x)
        eat(nom a)
        println(a.len())
    return Result.Ok(~)

fn main() i32:
    match walk():
        Result.Ok(_) -> return 0
        Result.Err(_) -> return 1
