# A `remove` changes the buckets the loop's iterator reads, so it is refused in the body
# of a `foreach` over the map (#956).
# EXPECT_ERROR_CODE: CE2412

use <collections/hashmap>

fn main() i32:
    let HashMap@(i32, i32) m = HashMap.new()
    m.insert(1, 10)
    m.insert(2, 20)
    foreach(k in m.keys()):
        m.remove(k)
    println("{m.len()}")
    m.free()
    return Result.Ok(0)
