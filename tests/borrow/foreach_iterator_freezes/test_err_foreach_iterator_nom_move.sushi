# A `nom` move of the container the loop walks is one fault: the change under the
# iterator (CE2412). The use of the moved value on the next round, at the same
# expression, is a consequence and is not reported as well (#995).
# EXPECT_ERROR_CODES_EXACT: CE2412
# EXPECT_STDERR_CONTAINS: 15:17: error [CE2412]

fn eat(nom i32[] a) ~:
    println(a.len())

fn walk() ~ | StdError:
    let i32[] a = from([1, 2, 3])
    foreach(x in a.iter()):
        println(x)
        eat(nom a)
    return Result.Ok(~)

fn main() i32:
    match walk():
        Result.Ok(_) -> return 0
        Result.Err(_) -> return 1
