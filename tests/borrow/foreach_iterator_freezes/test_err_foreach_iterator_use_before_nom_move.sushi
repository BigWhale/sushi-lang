# A use of the walked container before its `nom` move fails on the next round only
# because of the move that came round the loop. The iterator reports that move
# (CE2412), and the use is not reported as well (#995).
# EXPECT_ERROR_CODES_EXACT: CE2412
# EXPECT_STDERR_CONTAINS: 14:17: error [CE2412]

fn eat(nom i32[] a) ~:
    println(a.len())

fn walk() ~ | StdError:
    let i32[] a = from([1, 2, 3])
    foreach(x in a.iter()):
        println(a.len() + x)
        eat(nom a)
    return Result.Ok(~)

fn main() i32:
    match walk():
        Result.Ok(_) -> return 0
        Result.Err(_) -> return 1
