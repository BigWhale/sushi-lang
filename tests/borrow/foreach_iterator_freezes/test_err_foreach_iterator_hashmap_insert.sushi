# A `foreach` over `m.keys()` views the map's buckets for the whole loop. An `insert` can
# rehash them, so it is refused in the body (#956).
# EXPECT_ERROR_CODE: CE2412

use <collections/hashmap>

fn main() i32:
    let HashMap@(i32, i32) m = HashMap.new()
    m.insert(1, 10)
    foreach(k in m.keys()):
        m.insert(k + 100, 0)
    println("{m.len()}")
    m.free()
    return Result.Ok(0)
