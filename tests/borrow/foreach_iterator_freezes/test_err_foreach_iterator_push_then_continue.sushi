# A `continue` goes to the loop's next round, so a change before it still conflicts
# with the iterator (#993).
# EXPECT_ERROR_CODE: CE2412

fn main() i32:
    let i32[] a = from([1, 2, 3])
    foreach(x in a.iter()):
        if (x == 1):
            a.push(5)
            continue
    println(a.len())
    return Result.Ok(0)
