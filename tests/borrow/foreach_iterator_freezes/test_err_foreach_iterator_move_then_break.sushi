# A move followed by `break` is not a move on the next round, and it does not conflict
# with the iterator. The move reaches the code after the loop, so the use there is
# CE2405 (#993).
# EXPECT_ERROR_CODES_EXACT: CE2405
# EXPECT_STDERR_CONTAINS: 16:13: error [CE2405]

fn eat(nom i32[] a) ~:
    println(a.len())

fn walk() ~ | StdError:
    let i32[] a = from([1, 2, 3])
    foreach(x in a.iter()):
        if (x == 1):
            eat(nom a)
            break
    println(a.len())
    return Result.Ok(~)

fn main() i32:
    match walk():
        Result.Ok(_) -> return 0
        Result.Err(_) -> return 1
