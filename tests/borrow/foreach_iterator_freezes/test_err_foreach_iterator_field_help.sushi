# The CE2412 help of a change under the iterator names the receiver the loop walks
# (`h.items`), not the root of the place (#994).
# EXPECT_ERROR_CODE: CE2412
# EXPECT_STDERR_CONTAINS: help: call `.push()` after the loop, or walk an independent value: `h.items.clone().iter()`

struct H:
    i32[] items

fn main() i32:
    let H h = H(from([1, 2, 3]))
    foreach(_x in h.items.iter()):
        h.items.push(4)
    return 0
