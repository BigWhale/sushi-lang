# A `while` loop has no iterator. A `nom` move of a local in its body is a use after
# move on the next round, CE2405 (#995).
# EXPECT_ERROR_CODES_EXACT: CE2405
# EXPECT_STDERR_CONTAINS: 15:17: error [CE2405]

fn eat(nom i32[] a) ~:
    println(a.len())

fn walk() ~ | StdError:
    let i32[] a = from([1, 2, 3])
    let i32 n = 0
    while (n < 2):
        n := n + 1
        eat(nom a)
    return Result.Ok(~)

fn main() i32:
    match walk():
        Result.Ok(_) -> return 0
        Result.Err(_) -> return 1
