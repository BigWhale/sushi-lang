# A `File` is borrowed and moved in one statement. The CE2401 help offers no `.clone()`,
# because a `File` owns a resource (CE2431) (#994).
# EXPECT_ERROR_CODE: CE2401
# EXPECT_STDERR_CONTAINS: help: the new owner frees this value while the borrow still points at it; borrow it twice: 'f' owns a resource and cannot be cloned

use <io/fs>

fn both(peek File a, nom File b) ~:
    return Result.Ok(~)

fn go() ~:
    let File f = stdout.share().realise(stdout)
    both(peek f, nom f)??
    return Result.Ok(~)

fn main() i32:
    if (go().is_err()):
        return Result.Ok(1)
    return Result.Ok(0)
