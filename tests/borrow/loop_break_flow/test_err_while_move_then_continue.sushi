# A `continue` goes to the next round, so a move before it is a use after move on that
# round (#993).
# EXPECT_ERROR_CODES_EXACT: CE2405

fn eat(nom i32[] a) ~:
    println(a.len())
    return Result.Ok(~)

fn walk() ~:
    let i32[] a = from([1, 2, 3])
    let i32 n = 0
    while (n < 3):
        n := n + 1
        if (n == 2):
            eat(nom a)??
            continue
    return Result.Ok(~)

fn main() i32:
    match walk():
        Result.Ok(_) -> return Result.Ok(0)
        Result.Err(_) -> return Result.Ok(1)
