# The facts of a `break` path reach the code after the loop: a move, a `break`, then a
# use after the loop is CE2405 at the use (#993).
# EXPECT_ERROR_CODES_EXACT: CE2405
# EXPECT_STDERR_CONTAINS: 18:13: error [CE2405]

fn eat(nom i32[] a) ~:
    println(a.len())

fn walk() ~ | StdError:
    let i32[] a = from([1, 2, 3])
    let i32 n = 0
    while (n < 3):
        n := n + 1
        if (n == 2):
            eat(nom a)
            break
    println(a.len())
    return Result.Ok(~)

fn main() i32:
    match walk():
        Result.Ok(_) -> return 0
        Result.Err(_) -> return 1
