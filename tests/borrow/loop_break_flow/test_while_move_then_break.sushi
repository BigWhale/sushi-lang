# A move followed by `break` in a `while` loop is not a move on the next round (#993).
# EXPECT_STDOUT_EXACT: "3\n"
# EXPECT_NO_LEAKS

fn eat(nom i32[] a) ~:
    println(a.len())

fn walk() ~ | StdError:
    let i32[] a = from([1, 2, 3])
    let i32 n = 0
    while (n < 3):
        n := n + 1
        eat(nom a)
        break
    return Result.Ok(~)

fn main() i32:
    match walk():
        Result.Ok(_) -> return 0
        Result.Err(_) -> return 1
