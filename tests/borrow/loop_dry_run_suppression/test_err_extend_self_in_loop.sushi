# A self-aliased bulk write inside a loop body is CE2430, reported ONCE at 13:19. The
# borrow pass checks a loop body in two rounds, and the first round is a dry run that
# emits nothing, so the fault is told once, as it is outside a loop. The runner cannot
# count lines; the count rule is held by the gate that every borrow diagnostic goes
# through the pass's one reporter (tests/unit/test_borrow_emits_through_one_reporter.py).
# EXPECT_ERROR_CODES_EXACT: CE2430
# EXPECT_STDERR_CONTAINS: test_err_extend_self_in_loop.sushi:13:19: error [CE2430]

fn main() i32:
    let i32[] xs = from([1, 2])
    let i32 n = 0
    while (n < 2):
        xs.extend(xs)
        n := n + 1
    println(xs.len())
    return 0
