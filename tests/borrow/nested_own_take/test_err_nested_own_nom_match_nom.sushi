# A `nom` binding nested inside an `Own(...)` pattern takes the value out of the heap
# cell, which leaves the cell with nothing to free it. `match nom r:` owns the scrutinee,
# so the fault is the Own position (CE2434) and not a borrowed scrutinee (CE2432).
# TEST_TYPE: error
# EXPECT_ERROR_CODE: CE2434
enum Inner:
    Word(string)
    Nil

enum Outer:
    Full(Own@(Inner))
    Empty

fn main() i32:
    let string kept = "none".clone()
    let Outer r = Outer.Full(Own.alloc(Inner.Word("Mostly Harmless".clone())))
    match nom r:
        Outer.Full(Own(Inner.Word(nom s))) ->
            kept := s
        Outer.Full(Own(Inner.Nil)) -> println("nil")
        Outer.Empty -> println("empty")
    println(kept)
    return Result.Ok(0)
