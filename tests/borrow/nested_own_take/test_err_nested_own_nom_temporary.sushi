# A temporary scrutinee is owned by the match, and a `nom` binding nested inside an
# `Own(...)` pattern is still refused: the heap cell would have no owner (CE2434).
# TEST_TYPE: error
# EXPECT_ERROR_CODE: CE2434
enum Inner:
    Word(string)
    Nil

enum Outer:
    Full(Own@(Inner))
    Empty

fn make() Outer:
    return Result.Ok(Outer.Full(Own.alloc(Inner.Word("Mostly Harmless".clone()))))

fn main() i32:
    let string kept = "none".clone()
    match make().realise(Outer.Empty):
        Outer.Full(Own(Inner.Word(nom s))) ->
            kept := s
        Outer.Full(Own(Inner.Nil)) -> println("nil")
        Outer.Empty -> println("empty")
    println(kept)
    return Result.Ok(0)
