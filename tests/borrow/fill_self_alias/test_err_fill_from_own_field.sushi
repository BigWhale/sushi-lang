# An element that is a struct with a `string` field owns a resource too (#867).
# EXPECT_ERROR_CODE: CE2430

use <collections/strings>

struct Tag:
    string label
    i32 weight

fn main() i32:
    let string s = "abcdefghijklmnopqrstuvwxyz0123456789"
    let Tag[] a = from([Tag(s.upper(), 1), Tag(s.lower(), 2)])
    a.fill(a[0])
    println(a[1].label)
    return Result.Ok(0)
