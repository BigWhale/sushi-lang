# A fixed array follows the rule a dynamic array does (#867).
# EXPECT_ERROR_CODE: CE2430

use <collections/strings>

fn main() i32:
    let string s = "abcdefghijklmnopqrstuvwxyz0123456789"
    let string[3] a = [s.upper(), s.lower(), s.upper()]
    a.fill(a[0])
    println(a[1])
    return Result.Ok(0)
