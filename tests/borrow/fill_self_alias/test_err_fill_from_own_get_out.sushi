# An element get-out borrows the slot as an index does, so `a.get(0)??` is refused (#867).
# EXPECT_ERROR_CODE: CE2430

fn refill(poke string[] a) ~:
    a.fill(a.get(0)??)
    return Result.Ok(~)

fn main() i32:
    let string[] a = from(["x", "y", "z"])
    match refill(poke a):
        Result.Ok(_) -> println(a[2])
        Result.Err(_) -> println("failed")
    return Result.Ok(0)
