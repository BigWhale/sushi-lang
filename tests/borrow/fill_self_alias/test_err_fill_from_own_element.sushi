# `fill` destroys each slot and stores a copy of its argument there (#867). When the
# argument is a slot of the same array and the element owns a resource, the loop destroys
# that slot and then copies from freed memory into every later slot. It is refused.
# EXPECT_ERROR_CODE: CE2430

use <collections/strings>

fn main() i32:
    let string s = "abcdefghijklmnopqrstuvwxyz0123456789"
    let string[] a = from([s.upper(), s.lower(), s.upper()])
    a.fill(a[0])
    println(a[0])
    println(a[1])
    println(a[2])
    return Result.Ok(0)
