# The first arm of an `if` chain moves `s`, and the two later arms rebind it. The use
# after the chain is CE2405, and the note points at the move in the first arm.
# EXPECT_ERROR_CODES_EXACT: CE2405
# EXPECT_STDERR_CONTAINS: test_err_move_in_elif_rebind_in_rest.sushi:21:13: error [CE2405]
# EXPECT_STDERR_CONTAINS: 's' was moved here
# EXPECT_STDERR_CONTAINS: test_err_move_in_elif_rebind_in_rest.sushi:16:17

use <collections/strings>

fn eat(nom string s) ~:
    println(s)

fn f(i32 k) i32:
    let string s = "tow".concat("el")
    if (k == 0):
        eat(nom s)
    elif (k == 1):
        s := "c".concat("d")
    else:
        s := "e".concat("f")
    println(s)
    return 0

fn main() i32:
    return f(0)
