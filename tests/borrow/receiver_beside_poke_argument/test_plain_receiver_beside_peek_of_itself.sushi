# A plain receiver beside a plain argument and a `peek` argument of the same array is
# legal: every borrow is shared.
# EXPECT_STDOUT_EXACT: "9\n"
# EXPECT_NO_LEAKS

extend i32[] three_lengths(i32[] a, peek i32[] b) i32:
    return self.len() + a.len() + b.len()

fn main() i32:
    let i32[] xs = from([1, 2, 3])
    println(xs.three_lengths(xs, peek xs))
    return 0
