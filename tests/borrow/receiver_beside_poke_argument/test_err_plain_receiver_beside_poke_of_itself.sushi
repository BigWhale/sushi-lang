# A plain receiver is a shared borrow of its owner for the length of the call. A `poke`
# argument of the same array is refused.
# EXPECT_ERROR_CODE: CE2407

extend i32[] f(poke i32[] y) i32:
    y.clear()
    y.push(7)
    y.push(8)
    return self[0] + self.len()

fn main() i32:
    let i32[] xs = from([1, 2, 3])
    let i32 r = xs.f(poke xs)
    println("{r}")
    return 0
