# A `peek self` receiver is a shared borrow of its owner for the length of the call. A
# `poke` argument of the same array is refused.
# EXPECT_ERROR_CODE: CE2407

extend i32[] g(peek self, poke i32[] y) i32:
    y.clear()
    return self.len()

fn main() i32:
    let i32[] xs = from([1, 2, 3])
    println(xs.g(poke xs))
    return 0
