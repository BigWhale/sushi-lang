# A plain receiver that is an element borrows the root owner. A `poke` of the owner is
# refused.
# EXPECT_ERROR_CODE: CE2407

extend i32[] first_after(poke i32[][] rows) i32:
    rows.clear()
    return self[0]

fn main() i32:
    let i32[][] rows = from([from([1, 2])])
    println(rows[0].first_after(poke rows))
    return 0
