# A `poke` item over a by-value receiver writes through a read-only borrow. It is
# refused, as a direct element write is.
# EXPECT_ERROR_CODE: CE2421

extend i32[] zero_each() ~:
    foreach(poke r in self.iter()):
        r := 0

fn main() i32:
    let i32[] d = from([1, 2])
    d.zero_each()
    println(d[0])
    return 0
