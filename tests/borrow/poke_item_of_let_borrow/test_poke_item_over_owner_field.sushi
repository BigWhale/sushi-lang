# A `poke` item over the owner itself writes into storage the owner keeps. It is legal.
# EXPECT_STDOUT_EXACT: "0\n"
# EXPECT_NO_LEAKS

struct H:
    i32[] items

fn main() i32:
    let H h = H(from([1, 2, 3]))
    foreach(poke r in h.items.iter()):
        r := 0
    println(h.items[0])
    return 0
