# A `poke` item of a `foreach` is a write position. A write through a let-borrow is
# refused there too.
# EXPECT_ERROR_CODE: CE2426

struct H:
    i32[] items

fn main() i32:
    let H h = H(from([1, 2, 3]))
    let i32[] v = h.items
    foreach(poke r in v.iter()):
        r := 0
    println(h.items[0])
    return 0
