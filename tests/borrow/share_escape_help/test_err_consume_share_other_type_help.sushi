# A borrowed user type that implements `Drop` declares a `share()` that answers an `i32`.
# That call gives no second owner, so the CE2411 help does not offer it (#1023).
# EXPECT_ERROR_CODES_EXACT: CE2411
# EXPECT_STDERR_CONTAINS: there is no `t.clone()`, and its type has no `share()`

struct Token:
    i32 id

extend Token with Drop:
    fn drop(poke self) ~:
        println("drop")

extend Token share() i32:
    return self.id

fn eat(nom Token t) ~:
    println(t.share())
    return Result.Ok(~)

fn go(Token t) ~:
    eat(nom t)??
    return Result.Ok(~)

fn main() i32:
    let Token t = Token(1)
    match go(t):
        Result.Ok(_) -> println("ok")
        Result.Err(_) -> println("err")
    return Result.Ok(0)
