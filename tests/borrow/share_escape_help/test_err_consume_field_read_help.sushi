# A `File` field is consumed through a borrowed owner. The value read is a `File`, which
# has `share()`, so the CE2411 help offers it on the read and not on the owner (#1023).
# EXPECT_ERROR_CODES_EXACT: CE2411
# EXPECT_STDERR_CONTAINS: take a second owner with `h.f.share()`

use <io/fs>

struct Holder:
    File f

fn eat(nom File f) ~:
    println(f.is_open())

fn go(Holder h) ~ | StdError:
    eat(nom h.f)
    return Result.Ok(~)

fn main() i32:
    let Holder h = Holder(stdout.share().realise(stdout))
    match go(h):
        Result.Ok(_) -> println("ok")
        Result.Err(_) -> println("err")
    return 0
