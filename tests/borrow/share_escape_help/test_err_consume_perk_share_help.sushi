# A borrowed user type that implements `Drop` and a perk whose `share()` answers the type
# is consumed. The CE2411 help offers `share()`: a perk implementation answers the call as
# an extension method does (#1023).
# EXPECT_ERROR_CODES_EXACT: CE2411
# EXPECT_STDERR_CONTAINS: take a second owner with `t.share()`

struct Token:
    i32 id

extend Token with Drop:
    fn drop(poke self) ~:
        println("drop")

perk Twin:
    fn share() Token

extend Token with Twin:
    fn share() Token:
        return Token(self.id)

fn eat(nom Token t) ~:
    println(t.id)

fn go(Token t) ~ | StdError:
    eat(nom t)
    return Result.Ok(~)

fn main() i32:
    let Token t = Token(1)
    match go(t):
        Result.Ok(_) -> println("ok")
        Result.Err(_) -> println("err")
    return 0
