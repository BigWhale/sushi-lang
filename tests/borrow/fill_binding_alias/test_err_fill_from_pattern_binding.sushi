# A bare `match` payload binding over `b.get(0)` views the slot that `b` owns. `fill`
# destroys that slot while it reads the binding, so the call is refused (#888).
# EXPECT_ERROR_CODE: CE2412

use <collections/strings>

fn main() i32:
    let string s = "abcdefghijklmnopqrstuvwxyz0123456789"
    let string[] b = from([s.upper(), s.lower(), s.upper()])
    match b.get(0):
        Maybe.Some(v) -> b.fill(v)
        Maybe.None -> println("none")
    println(b[2])
    return Result.Ok(0)
