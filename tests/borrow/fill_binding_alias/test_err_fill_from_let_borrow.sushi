# A `let` bound from a slot of `a` borrows that slot. `fill` reads its argument while it
# destroys each slot of `a`, so the borrow is still alive when the owner changes (#888).
# EXPECT_ERROR_CODE: CE2412

use <collections/strings>

fn main() i32:
    let string s = "abcdefghijklmnopqrstuvwxyz0123456789"
    let string[] a = from([s.upper(), s.lower(), s.upper()])
    let string first = a[0]
    a.fill(first)
    println(a[1])
    return Result.Ok(0)
