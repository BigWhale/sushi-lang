# A `poke self` extension method changes its receiver. A `let`-borrow of the receiver,
# passed as a borrowed argument, is still alive during that change (#888).
# EXPECT_ERROR_CODE: CE2412

use <collections/strings>

struct Shelf:
    string[] items

extend Shelf restock(poke self, string label) ~:
    self.items := from([label.clone(), label.clone()])

fn main() i32:
    let string s = "abcdefghijklmnopqrstuvwxyz0123456789"
    let Shelf sh = Shelf(from([s.upper(), s.lower()]))
    let string first = sh.items[0]
    sh.restock(first)
    println(sh.items[1])
    return Result.Ok(0)
