# A bare `match` payload binding over `b.get(0)` views the slot that `b` owns, so a change
# to `b` while the binding is still used is refused, as for a `let`-borrow (#888).
# EXPECT_ERROR_CODE: CE2412

use <collections/strings>

fn main() i32:
    let string s = "abcdefghijklmnopqrstuvwxyz0123456789"
    let string[] b = from([s.upper(), s.lower(), s.upper()])
    match b.get(0):
        Maybe.Some(v) ->
            b.clear()
            println(v)
        Maybe.None -> println("none")
    return Result.Ok(0)
