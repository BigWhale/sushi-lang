# `.s()` returns a new owned array. A `foreach` over `a.s(0, 3).iter()` walks that copy,
# so a `push` on `a` in the body is legal (#1014).
# EXPECT_STDOUT_EXACT: "4\n"
# EXPECT_NO_LEAKS

fn main() i32:
    let i32[] a = from([1, 2, 3])
    foreach(x in a.s(0, 3).iter()):
        if (x == 1):
            a.push(5)
    println(a.len())
    return 0
