# A `foreach` over `l.clone().iter()` walks its own copy of the list, so a `push` on
# `l` in the body is legal (#1014).
# EXPECT_STDOUT_EXACT: "4\n"
# EXPECT_NO_LEAKS

fn main() i32:
    let List@(i32) l = List.new()
    l.push(1)
    l.push(2)
    l.push(3)
    foreach(x in l.clone().iter()):
        if (x == 1):
            l.push(5)
    println(l.len())
    return Result.Ok(0)
