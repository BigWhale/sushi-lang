# A `let` bound from a let-borrow reads the storage of the first owner. A change of
# that owner while the second binding lives is refused.
# EXPECT_ERROR_CODE: CE2412

struct H:
    i32[] items

fn main() i32:
    let H h = H(from([1, 2, 3]))
    let i32[] v = h.items
    let i32[] w = v
    h.items.push(4)
    println(w.len())
    return 0
