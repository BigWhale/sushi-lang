# A returned iterator borrows the array argument: the array is frozen while the
# iterator lives.
# EXPECT_ERROR_CODES_EXACT: CE2412
use <collections/iter>

fn evens(i32[] xs) peek Iterator@(i32):
    return xs.iter().filter(nom |i32 x| x % 2 == 0)

fn main() i32:
    let i32[] xs = from([1, 2, 3, 4])
    let Iterator@(i32) it = evens(xs)
    xs.push(6)
    foreach(x in it):
        println(x)
    return 0
