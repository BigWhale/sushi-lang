# The answer of a borrowed return from a binary library freezes the owner of its source
# argument, as the answer of a local one does.
# BUILD_LIB_BINARY: br_bin_lib.sushi
# EXPECT_ERROR_CODES_EXACT: CE2412
use <lib/br_bin_lib>

fn main() i32:
    let i32[] a = from([1, 2, 3])
    let i32[] b = from([1])
    let i32[] w = wider(a, b)
    b.push(2)
    println(w.len())
    return 0
