# The body of a borrowed return returns a borrow of a local, which the function frees.
# EXPECT_ERROR_CODES_EXACT: CE2443

fn head(i32[] xs) peek i32[]:
    println(xs.len())
    let i32[] local = from([1, 2, 3])
    return local[0..2]

fn main() i32:
    let i32[] data = from([1, 2])
    println(head(data).len())
    return 0
