# The answer of a borrowed return is a borrow: a caller cannot give it with `nom`.
# EXPECT_ERROR_CODES_EXACT: CE2411

fn head(i32[] xs) peek i32[]:
    return xs[0..1]

fn eat(nom i32[] xs) i32:
    return xs.len()

fn main() i32:
    let i32[] data = from([1, 2])
    let i32[] h = head(data)
    println(eat(nom h))
    return 0
