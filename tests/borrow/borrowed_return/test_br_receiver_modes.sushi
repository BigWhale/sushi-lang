# A `poke self` method and a `peek self` method return a view of the receiver. A `let` of
# a lent iterator leaves on one branch as it is and on the other through an adapter; both
# move their state to the heap. A `peek T | StdError` answer is matched.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "2\n4\n1\n2\n3\n0\n2\n0\n1\n"
# EXPECT_NO_LEAKS
use <collections/iter>

struct Store:
    i32[] data

extend Store front(poke self) peek i32[]:
    self.data.push(0)
    return self.data[0..2]

extend Store whole(peek self) peek Store:
    return self

fn evens_or_all(i32[] xs, bool all) peek Iterator@(i32):
    let Iterator@(i32) it = xs.iter()
    if (all):
        return it
    return it.filter(nom |i32 x| x % 2 == 0)

fn checked(i32[] xs) peek i32[] | StdError:
    if (xs.len() == 0):
        return Result.Err(StdError.Error)
    return Result.Ok(xs[0..1])

fn main() i32:
    let Store s = Store(from([1, 2, 3]))
    let i32[] f = s.front()
    println(f.len())
    println(s.whole().data.len())
    foreach(x in evens_or_all(s.data, true)):
        println(x)
    foreach(x in evens_or_all(s.data, false)):
        println(x)
    match checked(s.data):
        Result.Ok(v) -> println(v.len())
        Result.Err(_) -> println("err")
    return 0
