# With two sources, the answer freezes the owners of both arguments, also the one that
# the function did not return this time.
# EXPECT_ERROR_CODES_EXACT: CE2412

fn wider(i32[] a, i32[] b) peek i32[]:
    if (a.len() >= b.len()):
        return a
    return b

fn main() i32:
    let i32[] a = from([1, 2, 3])
    let i32[] b = from([1])
    let i32[] w = wider(a, b)
    b.push(2)
    println(w.len())
    return 0
