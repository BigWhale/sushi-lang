# A borrowed parameter of a plain type is not a source: its field is not a borrow of a
# source of the answer.
# EXPECT_ERROR_CODES_EXACT: CE2443

struct Pair:
    i32 a
    i32 b

fn pick(i32[] xs, Pair p) peek i32:
    return p.a

fn main() i32:
    let i32[] data = from([1, 2])
    println(pick(data, Pair(3, 4)))
    return 0
