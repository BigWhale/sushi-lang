# The answer of a borrowed return is a borrow: a caller with an owned return cannot
# return it.
# EXPECT_ERROR_CODES_EXACT: CE2411

fn head(i32[] xs) peek i32[]:
    return xs[0..1]

fn copy_head(i32[] xs) i32[]:
    return head(xs)

fn main() i32:
    let i32[] data = from([1, 2])
    println(copy_head(data).len())
    return 0
