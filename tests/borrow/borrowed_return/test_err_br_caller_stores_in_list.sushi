# The answer of a borrowed return is a borrow: a caller cannot push it into a container.
# EXPECT_ERROR_CODES_EXACT: CE2411

fn head(i32[] xs) peek i32[]:
    return xs[0..1]

fn main() i32:
    let i32[] data = from([1, 2])
    let List@(i32[]) kept = List.new()
    let i32[] h = head(data)
    kept.push(h)
    println(kept.len())
    return 0
