# A function with a borrowed return cannot be a function value: the type of a function
# value cannot say what the answer borrows.
# EXPECT_ERROR_CODES_EXACT: CE2441

fn head(i32[] xs) peek i32[]:
    return xs[0..1]

fn main() i32:
    let fn(i32[]) -> i32[] f = head
    let i32[] data = from([1, 2])
    println(f(data).len())
    return 0
