# The escape: `.clone()` gives the call an independent value, so the borrow and the
# `poke` do not meet (#920).
# EXPECT_STDOUT_EXACT: "ok\nABC\nABC\n"
# EXPECT_NO_LEAKS

use <collections/strings>

fn put(string v, poke string[] dst) ~:
    dst.fill(v)
    return Result.Ok(~)

fn main() i32:
    let string s = "abc"
    let string[] a = from([s.upper(), s.lower()])
    let string first = a[0]
    match put(first.clone(), poke a):
        Result.Ok(_) -> println("ok")
        Result.Err(_) -> println("err")
    println(a[0])
    println(a[1])
    return Result.Ok(0)
