# The reversed order of the same call: `poke a` first, then the borrow of a slot of `a`
# (#920).
# EXPECT_ERROR_CODE: CE2412

use <collections/strings>

fn put(poke string[] dst, string v) ~:
    dst.fill(v)
    return Result.Ok(~)

fn main() i32:
    let string s = "abcdefghijklmnopqrstuvwxyz0123456789"
    let string[] a = from([s.upper(), s.lower(), s.upper()])
    let string first = a[0]
    match put(poke a, first):
        Result.Ok(_) -> println("ok")
        Result.Err(_) -> println("err")
    println(a[1])
    return Result.Ok(0)
