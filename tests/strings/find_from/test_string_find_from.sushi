# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "[abc] [] find=0 from0=0\n[] [] find=0 from0=0\n[] [a] find=-1 from0=-1\n[ab] [abc] find=-1 from0=-1\n[aaa] [aa] find=0 from0=0\n[aaaa] [aa] find=0 from0=0\n[héllo héllo] [llo] find=2 from0=2\n[héllo] [é] find=1 from0=1\n[日本語日本] [本] find=1 from0=1\n[日本語] [] find=0 from0=0\n--\n8\n2\n8\n-1\n4\n1\n1\n1\n--\n1\n0\n--\n5\n-1\n3\n-1\n--\n-1\n-1\n-1\n"
# EXPECT_NO_LEAKS: true
# `find_from(needle, start)` gives the first match at or after the character index
# `start`. With start 0 it gives the answer of `find`, for every edge case of the four
# string searches. A negative start counts as 0. A start equal to the character count
# matches only an empty needle. A start past the character count gives no match. The
# value -1 stands for Maybe.None.
use <collections/strings>

fn index_of(Maybe@(i32) m) i32:
    match m:
        Maybe.Some(i) -> return i
        Maybe.None -> return -1

fn oracle(string text, string needle) ~:
    let i32 first = index_of(text.find(needle))
    let i32 from0 = index_of(text.find_from(needle, 0))
    println("[{text}] [{needle}] find={first} from0={from0}")

fn main() i32:
    oracle("abc", "")
    oracle("", "")
    oracle("", "a")
    oracle("ab", "abc")
    oracle("aaa", "aa")
    oracle("aaaa", "aa")
    oracle("héllo héllo", "llo")
    oracle("héllo", "é")
    oracle("日本語日本", "本")
    oracle("日本語", "")
    println("--")
    println(index_of("héllo héllo".find_from("llo", 3)))
    println(index_of("héllo héllo".find_from("llo", 2)))
    println(index_of("héllo héllo".find_from("llo", 8)))
    println(index_of("héllo héllo".find_from("llo", 9)))
    println(index_of("日本語日本".find_from("本", 2)))
    println(index_of("aaaa".find_from("aa", 1)))
    println(index_of("abc".find_from("", 1)))
    println(index_of("héllo".find_from("é", 1)))
    println("--")
    println(index_of("abcabc".find_from("bc", -5)))
    println(index_of("abc".find_from("", -1)))
    println("--")
    println(index_of("héllo".find_from("", 5)))
    println(index_of("héllo".find_from("o", 5)))
    println(index_of("日本語".find_from("", 3)))
    println(index_of("日本語".find_from("語", 3)))
    println("--")
    println(index_of("héllo".find_from("", 6)))
    println(index_of("abc".find_from("a", 9)))
    println(index_of("".find_from("", 1)))
    return 0
