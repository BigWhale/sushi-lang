# TEST_TYPE: runtime
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "made-1\nalias-9\nalias-9\ntwice-2\ntwice-2\nmade-1\n"
# EXPECT_STDERR_EMPTY: true
# The post-flip shape of tests/strings/test_string_raii_struct_field.sushi: the alias and
# the two constructor fields say `.clone()`. That is the copy the compiler inserts for
# them today, written by hand, so the same clone emitter runs over the same buffers and
# each owner still frees exactly once.
#
# This shape is correct before and after Phase 9. The implicit shape it replaces is the
# COPY tier itself, and stays pinned in the file named above until Phase 9 deletes it.

struct P:
    string name

fn make(i32 k) P:
    let P p = P(name: "made-{k}")
    return Result.Ok(p)

fn run() i32:
    # returned by value (move): caller owns and frees once
    let P r = make(1)??
    println(r.name)

    # alias: p and p2 each own an independent buffer
    let i32 nine = 9
    let P p = P(name: "alias-{nine}")
    let P p2 = p.clone()
    println(p.name)
    println(p2.name)

    # owned-string variable used in TWO constructors (each clones; no double-free)
    let string s = "twice-{2}"
    let P a = P(name: s.clone())
    let P b = P(name: s.clone())
    println(a.name)
    println(b.name)

    # struct stored in a dynamic array, extracted by index (get-out clone)
    let P[] arr = from([make(1)??, make(1)??])
    let P e0 = arr[0]
    println(e0.name)

    return Result.Ok(0)

fn main() i32:
    let i32 rc = run().realise(1)
    return Result.Ok(rc)
