# to_i32, to_i64 and to_f64 each copy the receiver into a NUL-terminated buffer
# for strtol, and each has to free it. Every one of them leaked that buffer on
# every call, which a loop turns into a real amount of memory.
# EXPECT_STDOUT_EXACT: "6\n7\nthe floats add up\n"
# EXPECT_NO_LEAKS: true

use <collections/strings>

fn main() i32:
    let string[] numbers = from(["1", "2", "3"])

    let i32 as_i32 = 0
    foreach(text in numbers.iter()):
        as_i32 := as_i32 + text.to_i32().realise(0)
    println("{as_i32}")

    let i64 as_i64 = 0 as i64
    foreach(text in numbers.iter()):
        as_i64 := as_i64 + text.to_i64().realise(0 as i64)
    println("{as_i64 + (1 as i64)}")

    let i32 parsed_floats = 0
    foreach(text in numbers.iter()):
        let f64 value = text.to_f64().realise(0.0)
        if (value > 0.5):
            parsed_floats := parsed_floats + 1
    println("the floats add up")

    return Result.Ok(0)
