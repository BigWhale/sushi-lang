# split bound by let, read by index, and as a temporary.
#
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "3 a b c\n4\n"
# EXPECT_NO_LEAKS

fn main() i32:
    let string s = "a,b,c"
    let string[] parts = s.split(",")
    println("{parts.len()} {parts[0]} {parts[1]} {parts[2]}")
    println(s.split(",").len() + 1)
    return 0
