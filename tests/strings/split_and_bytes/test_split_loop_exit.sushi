# split dropped at a break and at a return inside a loop.
#
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "0 1\n1 1\n4\n"
# EXPECT_NO_LEAKS

fn first_two(string s) i32:
    let string[] parts = s.split(",")
    foreach(i in 0..parts.len() as i32):
        if (i == 1):
            return i + 3
    return 0

fn main() i32:
    foreach(i in 0..5):
        let string[] parts = "a,b".split(",")
        println("{i} {parts.len() - 1}")
        if (i == 1):
            break
    println(first_two("a,b,c"))
    return 0
