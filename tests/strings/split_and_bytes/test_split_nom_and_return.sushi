# split passed nom to a function, and returned from one.
#
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "2\nx\n"
# EXPECT_NO_LEAKS

fn count(nom string[] xs) i32:
    return xs.len()

fn pieces(string s) string[]:
    return s.split("-")

fn main() i32:
    println(count(nom "p,q".split(",")))
    let string[] got = pieces("x-y-z")
    println(got[0])
    return 0
