# A function returns `to_str()` of a borrowed parameter. The caller owns the copy,
# and the argument keeps its own buffer.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "towel\ntowel\n"
# EXPECT_NO_LEAKS

use <collections/strings>

fn show(string s) string:
    return s.to_str()

fn main() i32:
    let string s = "tow".concat("el")
    let string t = show(s)
    println(t)
    println(s)
    return 0
