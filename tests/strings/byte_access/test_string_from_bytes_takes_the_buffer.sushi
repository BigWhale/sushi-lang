# `string.from_bytes(nom b)` takes the array: its data becomes the string's (#1091).
# EXPECT_STDOUT_EXACT: "Mostly 6\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
use <collections/strings>

fn main() i32:
    let u8[] b = from([77, 111, 115, 116, 108, 121])
    let string s = string.from_bytes(nom b)
    println("{s} {s.size()}")
    return 0
