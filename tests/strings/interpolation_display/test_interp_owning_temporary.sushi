# A temporary that owns a heap value is freed after it is printed.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "[Tag(t: "a")] Tag(t: "b")\n"
# EXPECT_NO_LEAKS: true

struct Tag:
    string t

fn make(string t) Tag:
    return Tag(t.clone())

fn main() i32:
    println("[{make('a')}] {make('b')}")
    return 0
