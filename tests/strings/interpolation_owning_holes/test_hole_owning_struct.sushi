# A hole holds a struct that owns a string and a struct that owns a List.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "Named(name: "zaphod", n: 2)\nBag(items: ["a", "b"])\nNamed(name: "ford", n: 1) Bag(items: ["a", "b"])\n"
# EXPECT_NO_LEAKS: true

struct Named:
    string name
    i32 n

struct Bag:
    List@(string) items

fn make_named() Named:
    return Named("zaphod", 2)

fn main() i32:
    let Bag b = Bag(List.new())
    b.items.push("a")
    b.items.push("b")
    println("{make_named()}")
    println("{b}")
    println("{Named('ford', 1)} {b}")
    return 0
