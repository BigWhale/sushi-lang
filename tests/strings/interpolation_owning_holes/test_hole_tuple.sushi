# A hole holds a field of a tuple that owns, and a call that answers one.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "arthur 42\nARTHUR 42\n"
# EXPECT_NO_LEAKS: true

fn pair() (string, i32):
    return ("arthur", 42)

fn main() i32:
    let (string, i32) t = pair()
    println("{t.0} {t.1}")
    println("{pair().0.upper()} {pair().1}")
    return 0
