# A hole that reads a field of an owning local leaves the local usable.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "trillian [5]\ntrillian\ntrillian\nPerson(name: "trillian", marks: [5])\n"
# EXPECT_NO_LEAKS: true

struct Person:
    string name
    List@(i32) marks

fn main() i32:
    let Person p = Person("trillian", List.new())
    p.marks.push(5)
    let string s = "{p.name} {p.marks}"
    println(s)
    println("{p.name}")
    println(p.name)
    println("{p}")
    return 0
