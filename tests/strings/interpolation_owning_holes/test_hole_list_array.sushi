# A hole holds a List answered by a call and a dynamic array.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "[2, 4]\n[1, 2, 3] [1, 2, 3]\n"
# EXPECT_NO_LEAKS: true

fn evens() List@(i32):
    let List@(i32) out = List.new()
    out.push(2)
    out.push(4)
    return out

fn main() i32:
    println("{evens()}")
    let i32[] a = from([1, 2, 3])
    println("{a} {a.clone()}")
    return 0
