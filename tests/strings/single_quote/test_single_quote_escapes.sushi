# EXPECT_STDOUT_EXACT: "PASS: Escaped single quote\n\nPASS: Escaped backslash\n\nPASS: Newline escape\n\nPASS: Tab escape\n\n"
use <collections/strings>

fn test_escaped_single_quote() ~ | StdError:
    let string s = 'can\'t'
    if (s == "can't"):
        println("PASS: Escaped single quote")
    else:
        println("FAIL: Escaped single quote")
    return Result.Ok(~)

fn test_escaped_backslash() ~ | StdError:
    let string s = 'path\\file'
    if (s == "path\\file"):
        println("PASS: Escaped backslash")
    else:
        println("FAIL: Escaped backslash")
    return Result.Ok(~)

fn test_newline() ~ | StdError:
    let string s = 'line1\nline2'
    if (s.contains("\n")):
        println("PASS: Newline escape")
    else:
        println("FAIL: Newline escape")
    return Result.Ok(~)

fn test_tab() ~ | StdError:
    let string s = 'col1\tcol2'
    if (s.contains("\t")):
        println("PASS: Tab escape")
    else:
        println("FAIL: Tab escape")
    return Result.Ok(~)

fn main() i32:
    if (test_escaped_single_quote().is_ok()):
        println("")
    if (test_escaped_backslash().is_ok()):
        println("")
    if (test_newline().is_ok()):
        println("")
    if (test_tab().is_ok()):
        println("")
    return 0
