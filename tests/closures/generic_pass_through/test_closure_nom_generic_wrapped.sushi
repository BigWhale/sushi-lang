# A capturing lambda solved into a type argument that a wrapper holds (a `Maybe@(T)`
# payload), and the parameter that the instance does not return and drops. Each
# environment is freed one time.
# EXPECT_STDOUT_EXACT: "8\n9\n6\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
use <collections/strings>

fn wrap@(T)(nom T x) Maybe@(T):
    return Maybe.Some(x)

fn pick@(T)(nom T x, nom T y, bool left) T:
    if (left):
        return x
    return y

fn main() i32:
    let i32 a = 5
    let string s = "Mostly {a}"
    let string t = "Mostly {a}"
    let Maybe@(fn(i32) -> i32) m = wrap(nom |i32 x| x + a)
    match m:
        Maybe.Some(f) -> println(f(3))
        Maybe.None -> println(0)
    let fn(i32) -> i32 k = pick(nom |i32 x| x + s.len(), nom |i32 x| x + a, true)
    println(k(1))
    let fn(i32) -> i32 j = pick(nom |i32 x| x + t.len(), nom |i32 x| x + a, false)
    println(j(1))
    return 0
