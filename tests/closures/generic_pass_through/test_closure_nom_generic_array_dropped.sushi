# An array of capturing lambdas, freed where no name holds it: in the instance that
# takes it and does not return it, and as the temporary that a pass-through returns.
# Each exit frees every environment the array holds.
# EXPECT_STDOUT_EXACT: "1\n1\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
fn count@(T)(nom T[] xs) i32:
    return xs.len()

fn kb@(T)(nom T x) T:
    return x

fn main() i32:
    let i32 a = 5
    let i32 n = count(nom from([|i32 x| x + a]))
    println(n)
    println(kb(nom from([|i32 x| x * a])).len())
    return 0
