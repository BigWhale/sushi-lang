# A lambda passed to a GENERIC parameter of type `fn(T) -> T | E` takes the channel from
# that parameter, as it does for a concrete one.
# EXPECT_STDOUT_EXACT: "4\n-1\n"
fn half(i32 x) i32 | StdError:
    if (x % 2 == 1):
        return Result.Err(StdError.Error)
    return Result.Ok(x / 2)

fn tryapply@(T)(fn(T) -> T | StdError f, nom T v) T | StdError:
    return Result.Ok(f(v)??)

fn main() i32:
    println(tryapply(|i32 x| half(x)??, nom 8).realise(-1))
    println(tryapply(|i32 x| half(x)??, nom 7).realise(-1))
    return 0
