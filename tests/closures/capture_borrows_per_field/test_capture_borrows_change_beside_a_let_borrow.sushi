# In a lambda body, a change to one captured variable does not end a `let peek` of a
# different captured variable (#1129).
# EXPECT_STDOUT_EXACT: "4\n"
# EXPECT_NO_LEAKS: true
fn main() i32:
    let i32[] xs = from([1, 2])
    let i32[] ys = from([3])
    let fn(i32) -> i32 f = |i32 k|:
        let peek i32[] y = ys
        xs.push(k)
        return xs.len() + y.len()
    println(f(0))
    return 0
