# In a lambda body, a change to a captured variable while a `let peek` of it lives,
# and a read of the binding after the change, is refused (#1129).
# EXPECT_ERROR_CODE: CE2412
# EXPECT_ERROR_CODES_EXACT: CE2412
# EXPECT_STDERR_CONTAINS: "'xs'"
fn main() i32:
    let i32[] xs = from([1, 2])
    let i32[] ys = from([3])
    let fn(i32) -> i32 f = |i32 k|:
        let peek i32[] y = ys
        let peek i32[] b = xs
        xs.push(k)
        return b.len() + y.len()
    println(f(0))
    return 0
