# In a lambda body, a `poke` borrow of one captured variable and a `peek` borrow of a
# different captured variable in one call do not conflict (#1129).
# EXPECT_STDOUT_EXACT: "3\n"
# EXPECT_NO_LEAKS: true
fn both(poke i32[] a, peek i32[] b) i32:
    a.push(b.len())
    return a.len()

fn main() i32:
    let i32[] xs = from([1, 2])
    let i32[] ys = from([3])
    let fn(i32) -> i32 f = |i32 k|:
        return both(poke xs, peek ys) + k
    println(f(0))
    return 0
