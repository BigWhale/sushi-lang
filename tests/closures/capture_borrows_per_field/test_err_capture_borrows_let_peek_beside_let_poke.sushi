# In a lambda body, a `let peek` beside a live `let poke` of ONE captured variable
# conflicts (#1129).
# EXPECT_ERROR_CODE: CE2407
# EXPECT_ERROR_CODES_EXACT: CE2407
# EXPECT_STDERR_CONTAINS: "cannot have peek and poke borrows of 'xs' simultaneously"
fn main() i32:
    let i32[] xs = from([1, 2])
    let i32[] ys = from([3])
    let fn(i32) -> i32 f = |i32 k|:
        let poke i32[] y = ys
        let poke i32[] a = xs
        let peek i32[] b = xs
        a.push(k)
        return b.len() + y.len()
    println(f(0))
    return 0
