# The elif arm rides the same (cond, Block) tuple as the if arm (#400).
# EXPECT_STDOUT_EXACT: "9\n"
fn pick(i32 n) i32:
    let i32 base = 2
    if (n == 0):
        return 0
    elif (n == 1):
        let fn(i32) -> i32 f = |i32 x| x * base + 1
        return f(4)
    return 0

fn main() i32:
    let i32 v = pick(1)
    println("{v}")
    return 0
