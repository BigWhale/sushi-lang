# The elif arm rides the same (cond, Block) tuple as the if arm (#400).
# EXPECT_OUTPUT: 9
fn pick(i32 n) i32:
    let i32 base = 2
    if (n == 0):
        return Result.Ok(0)
    elif (n == 1):
        let fn(i32) -> i32 f = |i32 x| x * base + 1
        return Result.Ok(f(4).realise(0))
    return Result.Ok(0)

fn main() i32:
    let i32 v = pick(1).realise(0)
    println("{v}")
    return Result.Ok(0)
