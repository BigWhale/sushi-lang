# `xs.map(f)` is bare: `??` on it is refused (CE2507).
# EXPECT_ERROR_CODES_EXACT: CE2507
use <collections/iter>

fn run() i32 | StdError:
    let i32[] xs = from([1, 2])
    let List@(i32) ys = xs.map(|i32 x| x * 2)??
    return Result.Ok(ys.len())

fn main() i32:
    println(run().realise(0))
    return 0
