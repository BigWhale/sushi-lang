# A rebind drops the old closure. A local that a named function fills holds no environment,
# and after a rebind to a capturing lambda it holds one, so a `let` of it moves.
# EXPECT_STDOUT_EXACT: "2\n5\n8\n"
# EXPECT_NO_LEAKS
fn inc(i32 x) i32:
    return x + 1

fn main() i32:
    let fn(i32) -> i32 f = inc
    println(f(1))
    let string s = "abcd".clone()
    f := |i32 x| x + (s.len() as i32)
    println(f(1))
    let fn(i32) -> i32 g = f
    let string t = "abcdefg".clone()
    let fn(i32) -> i32 h = |i32 x| x + (t.len() as i32)
    g := h
    println(g(1))
    return 0
