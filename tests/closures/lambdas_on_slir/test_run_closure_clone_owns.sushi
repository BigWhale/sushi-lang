# `f.clone()` of a closure that owns gives a second environment. Each value frees its own.
# EXPECT_STDOUT_EXACT: "2\n3\n2\n"
# EXPECT_NO_LEAKS
fn main() i32:
    let List@(i32) xs = List.new()
    xs.push(1)
    let fn() -> i32 f = |~|:
        xs.push(0)
        return xs.len() as i32
    let fn() -> i32 g = f.clone()
    println(f())
    println(f())
    println(g())
    return 0
