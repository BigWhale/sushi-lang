# A rebind on one path of a branch: the local can hold an environment after the join, so a
# `let` of it moves, and one value frees the environment.
# EXPECT_STDOUT_EXACT: "5\n"
# EXPECT_NO_LEAKS
fn inc(i32 x) i32:
    return x + 1

fn run(bool yes) fn(i32) -> i32:
    let fn(i32) -> i32 f = inc
    let string s = "abcd".clone()
    if (yes):
        f := |i32 x| x + (s.len() as i32)
    let fn(i32) -> i32 g = f
    return g

fn main() i32:
    let fn(i32) -> i32 h = run(true)
    println(h(1))
    return 0
