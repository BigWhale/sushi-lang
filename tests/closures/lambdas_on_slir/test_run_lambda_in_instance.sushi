# A lambda in an instance is cut once for each instance.
# EXPECT_STDOUT_EXACT: "41\nMostly Harmless\n"
# EXPECT_NO_LEAKS
fn keep@(T: Display)(nom T value) fn() -> string:
    let fn() -> string f = |~| "{value}"
    return f

fn main() i32:
    let fn() -> string a = keep(nom 41)
    let fn() -> string b = keep(nom "Mostly Harmless".clone())
    println(a())
    println(b())
    return 0
