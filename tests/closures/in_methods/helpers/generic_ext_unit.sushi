public struct Crate@(T):
    T value

public perk Measured:
    fn measure() i32

public extend Crate@(T: Measured) doubled_len() i32:
    let i32 two = 2
    let fn(i32) -> i32 f = |i32 x| x * two
    let i32 r = f(self.value.measure())
    return r

extend i32 with Measured:
    fn measure() i32:
        return self
