# A lambda in a generic-target extension body lifts once PER INSTANTIATION:
# each monomorphized copy owns its body, so each copy owns its lambda (#399).
# The copies get no scope-pass walk of their own, so their captures must be
# stamped before lifting.
# EXPECT_STDOUT_EXACT: "11 21\n"
struct Box@(T):
    T value

perk Tagged:
    fn tagvalue() i32

extend Box@(T: Tagged) bumped() i32:
    let i32 bump = 1
    let fn(i32) -> i32 f = |i32 x| x + bump
    let i32 r = f(self.value.tagvalue())
    return r

extend i32 with Tagged:
    fn tagvalue() i32:
        return self

extend string with Tagged:
    fn tagvalue() i32:
        return 20

fn main() i32:
    let Box@(i32) a = Box(10)
    let Box@(string) b = Box("x")
    println("{a.bumped()} {b.bumped()}")
    return 0
