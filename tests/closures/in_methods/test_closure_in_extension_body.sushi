# A lambda in a plain-target extension body is lifted like one in a plain
# function (#399). It used to be a CE0055 ICE: the lifter walked only
# program.functions.
# EXPECT_STDOUT_EXACT: "25\n"
fn main() i32:
    println("{8.padded()}")
    return Result.Ok(0)

extend i32 padded() i32:
    let i32 pad = 17
    let fn(i32) -> i32 f = |i32 x| x + pad
    let i32 r = f(self).realise(0)
    return r
