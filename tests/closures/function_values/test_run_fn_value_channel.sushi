# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "4\n-1\n8\n"
# EXPECT_NO_LEAKS

fn half(i32 x) i32 | StdError:
    if (x % 2 == 1):
        return Result.Err(StdError.Error)
    return Result.Ok(x / 2)

fn run(fn(i32) -> i32 | StdError f, i32 x) i32 | StdError:
    let i32 n = f(x)??
    return Result.Ok(n * 2)

fn main() i32:
    let fn(i32) -> i32 | StdError f = half
    println(f(8).realise(-1))
    println(f(7).realise(-1))
    println(run(half, 8).realise(-1))
    return 0
