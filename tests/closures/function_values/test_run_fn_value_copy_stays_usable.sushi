# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "2\n2\n3\n"
# EXPECT_NO_LEAKS

fn inc(i32 x) i32:
    return x + 1

fn twice(i32 x) i32:
    return x + 2

fn take(nom fn(i32) -> i32 f) i32:
    return f(1)

fn main() i32:
    let fn(i32) -> i32 f = inc
    let fn(i32) -> i32 g = f
    println(g(1))
    println(take(nom f))
    f := twice
    println(f(1))
    return 0
