# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "true\n5\n"
# EXPECT_NO_LEAKS

struct Holder:
    i32 n
    fn(i32) -> i32 f

enum Pick:
    None
    One(i32, fn(i32) -> i32)
    Both(Holder)

fn inc(i32 x) i32:
    return x + 1

const Maybe@(fn(i32) -> i32) X = Maybe.Some(inc)
const Pick P = Pick.Both(Holder(3, inc))

fn run(Pick p) i32:
    match p:
        Pick.None -> return 0
        Pick.One(n, f) -> return f(n)
        Pick.Both(h) -> return h.f(h.n + 1)

fn main() i32:
    println(X.is_some())
    println(run(P))
    return 0
