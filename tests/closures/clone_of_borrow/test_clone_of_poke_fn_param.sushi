# `.clone()` on a function value that a `poke` parameter holds. The parameter arrives
# as a pointer, and the clone must load it before it copies the environment.
# EXPECT_STDOUT_EXACT: "16\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
use <collections/strings>

fn dup(poke fn(i32) -> i32 f) i32:
    let fn(i32) -> i32 g = f.clone()
    return Result.Ok(g(10).realise(0))

fn main() i32:
    let string tag = "abcd {1}"
    let fn(i32) -> i32 c = |i32 x| x + tag.len()
    println("{dup(poke c).realise(0)}")
    return Result.Ok(0)
