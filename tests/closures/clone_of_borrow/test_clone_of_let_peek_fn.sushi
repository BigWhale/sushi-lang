# `.clone()` on a function value through a `let peek` binding. The binding is a
# pointer into `c`, and the clone must load it before it copies the environment.
# EXPECT_STDOUT_EXACT: "r=102 c=102\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS: true
use <collections/strings>

fn main() i32:
    let string tag = "ab"
    let fn(i32) -> i32 c = |i32 x| x + tag.len()
    let peek fn(i32) -> i32 r = c
    let fn(i32) -> i32 g = r.clone()
    println("r={g(100).realise(0)} c={c(100).realise(0)}")
    return Result.Ok(0)
