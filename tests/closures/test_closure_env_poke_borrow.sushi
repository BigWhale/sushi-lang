# A `&poke` borrow of a CAPTURED value, taken inside the closure body. After lifting
# this is `grow(&poke __closure_env.xs)`, so it goes through the synthesized environment
# parameter -- which is why that parameter must be declared `&poke` (docs/design/
# closures.md, "Lambda lowering"). With `&peek` it is CE2408.
#
# The env owns the moved-in list, so the mutation persists across calls:
# start [1]; f(0) -> [1,99] len 2; f(0) -> [1,99,99] len 3; 2 + 3 = 5.
# EXPECT_STDOUT_EXACT: "5\n"
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_NO_LEAKS
fn grow(&poke List@(i32) l) ~:
    l.push(99)
    return Result.Ok(~)

fn run() i32:
    let List@(i32) xs = List.new()
    xs.push(1)
    let fn() -> i32 f = |~|:
        grow(&poke xs)
        return Result.Ok(xs.len())
    let i32 a = f()??
    let i32 b = f()??
    return Result.Ok(a + b)

fn main() i32:
    println(run().realise(-1))
    return Result.Ok(0)
