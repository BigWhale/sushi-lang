# A lambda in the expression body of a lambda captures a local of the function (#1127).
# The outer lambda captures `k` too, so the inner capture reads the outer environment.
# EXPECT_STDOUT_EXACT: "11\n"
fn apply(fn(i32) -> i32 f, i32 v) i32:
    return f(v)

fn main() i32:
    let i32 k = 10
    let fn(i32) -> i32 g = |i32 p| apply(|i32 q| k + q, p)
    println(g(1))
    return 0
