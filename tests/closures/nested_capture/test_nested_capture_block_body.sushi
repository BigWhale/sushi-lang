# A `let fn` in the block body of a lambda captures a local of the function and a
# parameter of the outer lambda (#1127).
# EXPECT_STDOUT_EXACT: "111\n"
fn main() i32:
    let i32 k = 10
    let fn(i32) -> i32 g = |i32 p|:
        let fn(i32) -> i32 inner = |i32 q| k + q + p
        return inner(100)
    println(g(1))
    return 0
