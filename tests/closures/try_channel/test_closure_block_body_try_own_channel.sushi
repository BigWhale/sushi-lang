# Control: the block-body twin always used its own channel. Pins the boundary
# of #403.
# EXPECT_STDOUT_EXACT: "4\n"
error CalcError:
    Boom

fn may_fail(i32 n) i32 | CalcError:
    if (n < 0):
        return Result.Err(CalcError.Boom)
    return Result.Ok(n)

fn outer() i32:
    let fn(i32) -> i32 | CalcError f = |i32 x| -> i32 | CalcError:
        return Result.Ok(may_fail(x)??)
    let i32 v = f(4).realise(0)
    return v

fn main() i32:
    let i32 v = outer()
    println("{v}")
    return 0
