# A fixed array of function values: `(fn(i32) -> i32)[3]` (#1128).
# EXPECT_STDOUT_EXACT: "3\n6\n10\n11\n"
# EXPECT_STDERR_EMPTY: true
fn inc(i32 x) i32:
    return x + 1

fn dbl(i32 x) i32:
    return x * 2

fn main() i32:
    let (fn(i32) -> i32)[3] fs = [inc, dbl, inc]
    println(fs.len())
    println(fs[1](3))
    let i32 r = fs[0](9)
    println(r)
    println(fs[2](10))
    return 0
