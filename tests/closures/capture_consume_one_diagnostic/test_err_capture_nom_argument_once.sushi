# A `nom` argument that names a captured variable keeps its marker in the lifted body:
# the consume of the capture is CE2411 alone, and the marker is not CE2427.
# EXPECT_ERROR_CODES_EXACT: CE2411
# EXPECT_STDERR_CONTAINS: cannot consume 's'

fn take(nom i32[] s) i32:
    return s.len()

fn main() i32:
    let i32[] s = from([1, 2, 3])
    let fn(i32) -> i32 f = |i32 k| take(nom s) + k
    println(f(0))
    return 0
