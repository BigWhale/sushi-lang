# A division and a remainder by a divisor that is not zero give the answer, also near the
# limits of a signed type and by -1.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "2 1 -3 1 2147483647 0 -2147483647 0 25 2\n"

fn main(string[] args) i32:
    let i32 one = args.len()
    let i32 seven = 6 + one
    let i32 three = 2 + one
    let i32 minus = 0 - one
    let i32 big = 2147483647 * one
    let u8 two_hundred = 199 + (one as u8)
    let u8 eight = 7 + (one as u8)
    let u8 nine = eight + 1
    println("{seven / three} {seven % three} {seven / (0 - 2)} {seven % (0 - 2)} {big / one} {big % one} {big / minus} {big % minus} {two_hundred / eight} {two_hundred % nine}")
    return 0
