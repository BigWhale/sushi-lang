# The smallest i64 remainder by -1 stops the program, as the division does.
# EXPECT_RUNTIME_EXIT: 1
# EXPECT_STDOUT_EXACT: ""
# EXPECT_STDERR_CONTAINS: "RE2031"
# EXPECT_STDERR_CONTAINS: "integer division overflow"

fn main(string[] args) i32:
    let i64 a = -9223372036854775807 - 1
    let i64 b = (args.len() - 2) as i64
    println("{a % b}")
    return 0
