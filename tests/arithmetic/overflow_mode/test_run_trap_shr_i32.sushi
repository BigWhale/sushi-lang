# A right shift on a signed type with a count at the width stops the program in the
# default mode.
# EXPECT_RUNTIME_EXIT: 1
# EXPECT_STDOUT_EXACT: ""
# EXPECT_STDERR_CONTAINS: "RE2034"
# EXPECT_STDERR_CONTAINS: "shift count 32 is out of range: '>>' on i32"

fn shr(i32 value, i32 places) i32:
    return value >> places

fn main() i32:
    println("{shr(-8, 32)}")
    return 0
