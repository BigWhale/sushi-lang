# The count of a range from the smallest i32 to the largest is the arithmetic of the
# compiler, and the overflow mode does not check it. So the walk does not trap.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "done\n"

fn walk(i32 low, i32 high) i32:
    let i32 seen = 0
    foreach(i in low..high):
        seen := seen + 1
        if (seen == 3 or i == high):
            break
    return seen

fn main() i32:
    if (walk(-2147483648, 2147483647) >= 0):
        println("done")
    return 0
