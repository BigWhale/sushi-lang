# With --overflow=wrap, a shift count is masked to the width: 1 << 32 on an i32 is 1 << 0.
# COMPILER_FLAGS: --overflow=wrap
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "1\n2\n-2147483648\n"

fn shl(i32 value, i32 places) i32:
    return value << places

fn main() i32:
    println("{shl(1, 32)}")
    println("{shl(1, 33)}")
    println("{shl(1, -1)}")
    return 0
