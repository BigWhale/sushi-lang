# A negative count of a signed count type is out of range, and stops the program in the
# default mode.
# EXPECT_RUNTIME_EXIT: 1
# EXPECT_STDOUT_EXACT: ""
# EXPECT_STDERR_CONTAINS: "RE2034"
# EXPECT_STDERR_CONTAINS: "shift count -1 is out of range: '>>' on i64"

fn shr(i64 value, i32 places) i64:
    return value >> places

fn main() i32:
    println("{shr(16, -1)}")
    return 0
