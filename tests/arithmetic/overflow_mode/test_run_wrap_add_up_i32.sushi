# With --overflow=wrap, an `.add_up()` total loses the bits that leave the type.
# COMPILER_FLAGS: --overflow=wrap
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "-2147483648\n"

fn main(string[] args) i32:
    let i32[] xs = from([2147483647, args.len()])
    println("{xs.add_up()}")
    return 0
