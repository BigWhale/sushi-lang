# An i64 product that the type cannot hold stops the program in the default mode.
# EXPECT_RUNTIME_EXIT: 1
# EXPECT_STDOUT_EXACT: ""
# EXPECT_STDERR_CONTAINS: "RE2032"
# EXPECT_STDERR_CONTAINS: "integer overflow: '*' on i64"

fn mul(i64 a, i64 b) i64:
    return a * b

fn main(string[] args) i32:
    println("{mul(4611686018427387904, (args.len() + 1) as i64)}")
    return 0
