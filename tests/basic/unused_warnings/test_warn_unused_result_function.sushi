# EXPECT_ERROR_CODE: CW2001
# Test for unused-Result detection
# This test should emit a warning when a function with a channel is called and its
# Result is not used

fn get_value() i32 | StdError:
    return Result.Ok(42)

fn main() i32:
    get_value()  # Warning: unused Result@(i32, StdError)
    return 0
