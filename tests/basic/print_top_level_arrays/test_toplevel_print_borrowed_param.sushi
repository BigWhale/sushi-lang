# An array that a function borrows prints, in a hole and in `println`, through every
# parameter mode, and so does a reference binding.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "plain: [1, 2]\n[1, 2]\npeek: [1, 2]\n[1, 2]\npoke: [1, 2, 3]\n[1, 2, 3]\nlist: [5]\nview: [1, 2, 3]\n[1, 2, 3]\n"
# EXPECT_NO_LEAKS: true

fn plain(i32[] a) ~:
    println("plain: {a}")
    println(a)

fn look(peek i32[] a) ~:
    println("peek: {a}")
    println(a)

fn grow(poke i32[] a) ~:
    a.push(3)
    println("poke: {a}")
    println(a)

fn show_list(peek List@(i32) xs) ~:
    println("list: {xs}")

fn main() i32:
    let i32[] a = from([1, 2])
    plain(a)
    look(peek a)
    grow(poke a)
    let List@(i32) xs = List.new()
    xs.push(5)
    show_list(peek xs)
    let peek i32[] view = a
    println("view: {view}")
    println(view)
    return 0
