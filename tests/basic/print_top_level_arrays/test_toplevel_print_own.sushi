# A top-level `Own@(T)` prints its payload, as it does when a type holds it.
# EXPECT_RUNTIME_EXIT: 0
# EXPECT_STDOUT_EXACT: "42\nPoint(x: 1, y: 2)\n42\nPoint(x: 1, y: 2)\n"
# EXPECT_NO_LEAKS: true

struct Point:
    i32 x
    i32 y

fn main() i32:
    let Own@(i32) n = Own.alloc(42)
    let Own@(Point) p = Own.alloc(Point(1, 2))
    println("{n}")
    println("{p}")
    println(n)
    println(p)
    return 0
