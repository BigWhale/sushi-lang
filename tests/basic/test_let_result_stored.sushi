# EXPECT_STDOUT_EXACT: "x = 42\n"
# TEST_TYPE: runtime
# TEST_EXPECTED_OUTPUT: x = 42
# Success test for storing a Result@(T) in a Result variable
# Should pass: storing in Result@(i32) variable then calling .realise()


fn get_value() i32:
    return Result.Ok(42)

fn main() i32:
    let Result@(i32, StdError) result = get_value()
    let i32 x = result.realise(0)
    println("x = {x}")
    return Result.Ok(0)
