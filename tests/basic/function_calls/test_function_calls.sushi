# EXPECT_RUNTIME_EXIT: 0

fn add(i32 a, i32 b) i32:
  return a + b

fn multiply(i32 x, i32 y) i32:
  let i32 result = x * y
  return result

fn greet(nom string name) string:
  println("Hello")
  println(name)
  return name


fn main() i32:
  let i32 sum = add(5, 3)
  let i32 product = multiply(4, 7)

  # Function calls in expressions
  let i32 complex = add(product, multiply(2, 3))

  # sum = 8
  # product = 28
  # complex = add(28, 6) = 34
  # total = 8 + 28 + 34 = 70

  let i32 total = sum + product + complex
  let i32 expected = 70
  return expected - total
