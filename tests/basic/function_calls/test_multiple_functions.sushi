# EXPECT_STDOUT_EXACT: "test"
# EXPECT_RUNTIME_EXIT: 14


fn helper1(i32 x) i32:
  return x * 2

fn helper2(bool flag) i32:
  if (flag):
    return 1
  return 0

fn helper3() string:
  return "test"

fn compute(i32 a, i32 b, bool use_flag) i32:
  let i32 doubled = helper1(a)
  let i32 flag_val = helper2(use_flag)
  return doubled + b + flag_val

fn main() i32:
  let i32 result = compute(5, 3, true)
  let string msg = helper3()
  print(msg)
  # result = compute(5, 3, true) = helper1(5) + 3 + helper2(true) = 10 + 3 + 1 = 14
  return result
