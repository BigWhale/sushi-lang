# Example 29: Move Semantics - one program, three ways to fix it
#
# Sushi moves owning values instead of silently copying them, so an expensive
# copy is never invisible. This example takes ONE small program that does not
# compile and shows the three ways to fix it.
#
# The rule:
#   A value MOVES if it transitively owns heap memory - a dynamic array T[],
#   List@(T), Own@(T), a capturing closure, or any struct/enum holding one.
#   Everything else COPIES: primitives, string, and plain-data composites.
#
# The five ownership sinks - passing an owning value into any of these
# CONSUMES it:
#   - a by-value function argument     take(pts)
#   - a let binding                    let b = pts
#   - a rebind                         b := pts
#   - a struct constructor field       Canvas(pts)
#   - an enum constructor payload      Shape.Poly(pts)
#
# ---------------------------------------------------------------------
# THE PROGRAM THAT DOES NOT COMPILE
#
#     enum Shape:
#         Poly(i32[])
#         Empty
#
#     fn main() i32:
#         let i32[] pts = from([1, 2, 3])
#         let Shape s = Shape.Poly(pts)
#         println("points: {pts.len()}")
#         return Result.Ok(0)
#
#     error [CE2405]: cannot borrow moved variable 'pts'.
#       |     println("points: {pts.len()}")
#       `                       --+-
#       = note: 'pts' was moved here
#         |     let Shape s = Shape.Poly(pts)
#         `                              --+-
#
# The shape owns those points now, and frees them. Reading `pts` afterwards
# would read memory the shape controls, so the compiler stops you.
#
# The fix is to ask the SHAPE for the count, not the moved variable.
# ---------------------------------------------------------------------

enum Shape:
    Poly(i32[])
    Empty

# Fix 3 uses this. The shape is taken BY VALUE, so it moves into the helper -
# which is what you want for a function that is the shape's final consumer.
fn point_count(Shape s) i32:
    match s:
        Shape.Poly(p) -> return Result.Ok(p.len())
        Shape.Empty -> return Result.Ok(0)

fn main() i32:
    # -----------------------------------------------------------------
    # FIX 1: ask the shape - the right fix
    #
    # One line changed from the broken version. A match binding BORROWS the
    # payload, so nothing is copied. Prefer this whenever you just need to
    # read the value through its new owner.
    # -----------------------------------------------------------------
    let i32[] pts1 = from([1, 2, 3])
    let Shape s1 = Shape.Poly(pts1)
    match s1:
        Shape.Poly(p) -> println("fix 1 - points: {p.len()}")
        Shape.Empty -> println("fix 1 - points: 0")

    # -----------------------------------------------------------------
    # FIX 2: .clone() - when you need the original as well
    #
    # Use this only when you genuinely need two independent arrays. The
    # O(n) copy is explicit at the call site, which is the whole point of
    # the move model: the cost is visible, not hidden.
    # -----------------------------------------------------------------
    let i32[] pts2 = from([1, 2, 3])
    let Shape s2 = Shape.Poly(pts2.clone())
    match s2:
        Shape.Poly(p) -> println("fix 2 - points: {p.len()}")
        Shape.Empty -> println("fix 2 - points: 0")
    println("fix 2 - pts still usable: {pts2.len()}")

    # -----------------------------------------------------------------
    # FIX 3: factor the question into a function
    #
    # Same idea as fix 1, moved behind a name. `point_count` takes the shape
    # by value, so the shape moves into it and is freed there.
    # -----------------------------------------------------------------
    let i32[] pts3 = from([1, 2, 3])
    let Shape s3 = Shape.Poly(pts3)
    println("fix 3 - points: {point_count(s3).realise(-1)}")

    # -----------------------------------------------------------------
    # Reordering is NOT a fix here
    #
    # Printing `pts.len()` before building the shape does compile:
    #
    #     let i32[] pts = from([1, 2, 3])
    #     println("points: {pts.len()}")
    #     let Shape s = Shape.Poly(pts)
    #
    # ...but now nothing ever uses `s`, which is warning CW1001 - the same
    # warning the broken version already had. If you are building the shape
    # at all, fix 1 is the answer.
    # -----------------------------------------------------------------

    # -----------------------------------------------------------------
    # Borrowing avoids the move entirely
    #
    # A peek parameter borrows rather than consumes, so the caller keeps
    # ownership and can keep using the value. Reach for a borrow before you
    # reach for .clone().
    # -----------------------------------------------------------------
    let i32[] pts4 = from([1, 2, 3])
    println("borrowed - points: {counted(peek pts4).realise(-1)}")
    println("borrowed - pts still ours: {pts4.len()}")

    return Result.Ok(0)

fn counted(peek i32[] xs) i32:
    return Result.Ok(xs.len())
