# Example 26: Libraries
#
# This example demonstrates how to create and use libraries in Sushi.
#
# Libraries let you reuse code in many programs. This enables a modular
# architecture and code sharing.
#
# LIBRARY COMPILATION:
#
#   # Step 1: Compile the source to a library. A library states its version:
#   # --lib-version gives it, or a nori.toml in the current directory does.
#   mkdir -p /tmp/sushilib
#   ./sushic --lib --lib-version 1.0.0 docs/examples/mathlib.sushi -o /tmp/sushilib/mathlib.slib
#
#   This makes one .slib file. The default kind is a SOURCE library: it carries
#   the source text and the metadata, and the program that uses it compiles it.
#   (--lib-kind binary ships LLVM bitcode instead.)
#
# USING THE LIBRARY:
#
#   # Step 2: Change the import below to `use <lib/mathlib>`, set the library
#   # search path, and compile the program
#   export SUSHI_LIB_PATH=/tmp/sushilib
#   ./sushic docs/examples/26-libraries.sushi -o program
#
#   The use <lib/mathlib> statement tells the compiler to:
#   1. Find mathlib.slib on SUSHI_LIB_PATH and read its metadata
#   2. Compile the library units with the program, and link them in
#
# As written, this example imports the library source directly, which is
# useful during development:
#   use "mathlib"  # Import the source file directly

use "mathlib"

fn main() i32:
    println("Library Functions Demo")
    println("======================")

    # Use functions from mathlib.sushi (imported as source)
    # .realise(default) safely unwraps Result.Ok or returns default on error
    let i32 sum = add(10, 20).realise(0)
    println("add(10, 20) = {sum}")

    let i32 product = multiply(7, 8).realise(0)
    println("multiply(7, 8) = {product}")

    let i32 fact = factorial(5).realise(0)
    println("factorial(5) = {fact}")

    let i32 doubled = double(21).realise(0)
    println("double(21) = {doubled}")

    println("")
    println("All library functions work correctly!")

    return Result.Ok(0)
