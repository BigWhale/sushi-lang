# Example 03: Functions
#
# Demonstrates:
# - Function definitions with parameters and return types
# - Multiple parameter passing
# - Blank type (~) for functions with no return value
# - The error channel `| E`: the call returns Result@(T, E)
# - Bare functions (no `| E`): the call returns the value itself
# - Function calls and .realise() for unwrapping
# - Error returns using Result.Err(error_value)
#
# A function has an error channel only when its signature writes `| E`.
# A function with a channel returns Result.Ok(value) or
# Result.Err(error_value) on all code paths. A function with no `| E` is
# bare and returns the value directly. A bare function is the exception:
# use it only for a function that is total over its inputs and will stay
# so. See docs/design/error-channel.md.

# Function with two parameters returning i32.
# Parameters are declared as: <type> <name>
# Return type comes after the closing parenthesis.
# This function writes no `| E`, so it is bare: it cannot fail.
fn calculate_answer(i32 a, i32 b) i32:
    let i32 result = a * b
    # A bare function returns the value directly
    return result

# Function with no return value uses the blank type (~).
# The blank type represents "nothing" or "void".
# A bare blank-returning function needs no return statement.
fn greet(string name) ~:
    println("Hello, {name}! Welcome aboard the Heart of Gold.")
    # A bare ~ body can reach its end

# Function demonstrating explicit error handling.
# It writes the channel `| StdError`, so it can return Result.Err(error_value).
# Caller must handle both success and error cases.
fn divide_pangalactic(i32 numerator, i32 denominator) i32 | StdError:
    # Check for error conditions and return Result.Err(error_value)
    if (denominator == 0):
        println("Error: Can't divide by zero gargle blasters!")
        return Result.Err(StdError.Error)

    # Return successful result wrapped in Result.Ok()
    return Result.Ok(numerator / denominator)

fn main() i32:
    # calculate_answer is bare, so its call returns the i32 directly.
    # No .realise() and no ?? are necessary (they are errors on a bare call).
    let i32 answer = calculate_answer(6, 7)
    println("Calculated answer: {answer}")

    # Call blank-returning functions.
    # greet is bare, so the call returns nothing and there is no Result to check.
    greet("Arthur")
    greet("Ford")
    greet("Zaphod")

    # Proper error handling: store Result and check it.
    # A condition is a bool, so a Result names the question it asks:
    # - result.is_ok() answers true for Ok
    # - result.is_err(), or the else branch, answers for Err
    let Result@(i32, StdError) result = divide_pangalactic(100, 5)

    if (result.is_ok()):
        # Use .realise() inside the Ok branch to extract the value
        println("Division successful: {result.realise(0)}")
    else:
        println("Division failed!")

    # Demonstrate error path handling.
    # This function call will fail due to division by zero.
    let Result@(i32, StdError) failed = divide_pangalactic(42, 0)

    if (failed.is_ok()):
        println("This won't print")
    else:
        # The else branch executes when Result is Err
        println("As expected, division by zero failed")

    return 0
