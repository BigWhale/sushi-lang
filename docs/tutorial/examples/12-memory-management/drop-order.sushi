# A type that implements the predefined Drop perk runs its own release
# step when the value is destroyed. Values are destroyed in reverse
# declaration order.

struct Towel:
    string owner

extend Towel with Drop:
    fn drop(poke self) ~:
        println("{self.owner} hands back the towel")

fn main() i32:
    let Towel arthur = Towel("Arthur")
    let Towel ford = Towel("Ford")
    println("{arthur.owner} and {ford.owner} have towels")
    return 0
