# Move semantics vs copy semantics.
#
# Primitives are COPIED on assignment: the original stays valid.
# A string that owns heap MOVES, like every other owning type. A string
# bound directly from a literal points into read-only program data and
# owns nothing, so it copies (both sides stay valid). Dynamic arrays
# always MOVE: the source is consumed and cannot be used again.

fn main() i32:
    let i32 x = 42
    let i32 y = 0
    y := x
    println("x is still usable: {x}")
    println("y is a copy: {y}")

    let string s1 = "Mostly Harmless"
    let string s2 = ""
    s2 := s1
    println("s1: {s1}")
    println("s2: {s2}")

    let string built = "Mostly Harmless, edition {x}"
    let string taken = built
    # println(built) here is CE2405: `built` moved into `taken`.
    println("taken: {taken}")

    let i32[] source = from([1, 2, 3])
    let i32[] dest = new()
    dest := source
    # `source` moved out and cannot be used again.
    println("dest length after move: {dest.len()}")

    return 0
