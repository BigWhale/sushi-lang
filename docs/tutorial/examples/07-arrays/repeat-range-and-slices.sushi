const i32[3] PRIMES = [2, 3, 5]

fn show(string label, i32[] values) ~:
    print("{label}:")
    foreach(v in values.iter()):
        print(" {v}")
    println("")

fn main() i32:
    let i32[4] zeros = [0; 4]
    println("zeros: {zeros[0]} {zeros[1]} {zeros[2]} {zeros[3]}")
    println("second prime: {PRIMES[1]}")

    let i32[] counted = from([1..=3, 42, 7; 2])
    show("counted", counted)

    let i32 seats = 3
    let i32[] empty_seats = from([0; seats])
    show("empty seats", empty_seats)

    let i32[] log = from([1, 2, 3])
    let i32[] more = from([10, 20, 30, 40])
    log.extend(more)
    show("extended", log)

    log.extend_range(more, 1, 2)
    show("extend_range", log)

    show("s(1, 4)", log.s(1, 4))
    show("ss(3, 2)", log.ss(3, 2))
    show("s(5, 99)", log.s(5, 99))

    return 0
