use <math>

fn main() i32:
    # abs, min and max are methods of the number types. They need no import.
    let i32 seven = 7
    let i32 biggest = seven.max(42)
    let i32 neg = -42
    let i32 magnitude = neg.abs()

    # Floating-point intrinsics.
    let f64 root = sqrt(1764.0)
    let f64 hyp = hypot(3.0, 4.0)

    println("7.max(42) = {biggest}")
    println("(-42).abs() = {magnitude}")
    println("sqrt(1764) = {root}")
    println("hypot(3, 4) = {hyp}")

    return 0
