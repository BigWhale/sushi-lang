fn main() i32:
    println("Exclusive 0..5:")
    foreach(i in 0..5):
        println("  {i}")

    println("Inclusive 1..=3:")
    foreach(i in 1..=3):
        println("  {i}")

    println("Descending (1..=3).rev():")
    foreach(i in (1..=3).rev()):
        println("  {i}")

    println("Over an array:")
    let string[] crew = from(["Arthur", "Ford", "Trillian"])
    foreach(name in crew.iter()):
        println("  {name}")

    return 0
