struct Point:
    i32 x
    i32 y

extend Point with Hashable:
    fn hash() u64:
        return (self.x as u64) + (self.y as u64)

fn fingerprint@(T: Hashable)(T value) u64:
    return value.hash()

fn main() i32:
    let Point p = Point(10, 20)
    let u64 hp = fingerprint(p)
    println("Point fingerprint: {hp}")

    let u64 hi = fingerprint(42)
    let u64 hb = fingerprint(true)
    println("i32 and bool hashed through the predefined Hashable: {hi}, {hb}")

    return 0
