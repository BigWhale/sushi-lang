struct Cage@(T):
    T item

extend Cage@(T) static holding(nom T item) Cage@(T):
    return Cage(item)

struct Pair@(A, B):
    A first
    B[] rest

extend Pair@(A, B) static of_first(nom A a) Pair@(A, B):
    return Pair(a, from([]))

fn weight(Cage@(i32) c) i32:
    return c.item

fn main() i32:
    let Cage@(i32) c = Cage.holding(nom 9)
    println("the cage holds {c.item}")

    println("an argument gives the type too: {weight(Cage.holding(nom 12))}")

    let Pair@(i32, string) p = Pair.of_first(nom 3)
    println("first {p.first}, {p.rest.len()} more")
    return 0
