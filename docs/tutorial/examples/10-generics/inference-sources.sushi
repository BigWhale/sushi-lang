struct Pair@(A, B):
    A first
    B second

fn head@(T: Clone)(T[] xs) T | StdError:
    let T v = xs.get(0).or_err(nom StdError.Error)??
    return Result.Ok(v.clone())

fn last_of_three@(T: Clone)(T[3] xs) T:
    return xs[2].clone()

fn second_of@(A, B: Clone)(peek Pair@(A, B) p) B:
    return p.second.clone()

fn apply@(T, U)(T x, fn(T) -> U f) U:
    return f(x)

fn main() i32:
    let i32[] numbers = from([5, 6, 7])
    println("head of a T[]: {head(numbers).realise(0)}")

    let f64[3] ratios = [0.5, 1.5, 2.5]
    println("last of a T[3]: {last_of_three(ratios)}")

    let Pair@(string, i32) p = Pair("answer", 42)
    println("second of a peek Pair@(A, B): {second_of(peek p)}")

    println("apply with fn(T) -> U: {apply(21, |i32 x| x * 2)}")
    return 0
