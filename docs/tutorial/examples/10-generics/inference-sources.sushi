struct Pair@(A, B):
    A first
    B second

fn head@(T)(T[] xs) T:
    let T v = xs.get(0)??
    return Result.Ok(v)

fn last_of_three@(T)(T[3] xs) T:
    return Result.Ok(xs[2])

fn second_of@(A, B)(peek Pair@(A, B) p) B:
    return Result.Ok(p.second)

fn apply@(T, U)(T x, fn(T) -> U f) U:
    return Result.Ok(f(x)??)

fn main() i32:
    let i32[] numbers = from([5, 6, 7])
    println("head of a T[]: {head(numbers).realise(0)}")

    let f64[3] ratios = [0.5, 1.5, 2.5]
    println("last of a T[3]: {last_of_three(ratios).realise(0.0)}")

    let Pair@(string, i32) p = Pair("answer", 42)
    println("second of a peek Pair@(A, B): {second_of(peek p).realise(0)}")

    println("apply with fn(T) -> U: {apply(21, |i32 x| x * 2).realise(0)}")
    return Result.Ok(0)
