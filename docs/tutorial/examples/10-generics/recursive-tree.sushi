enum Tree@(T):
    Leaf(T)
    Node(Own@(Tree@(T)), Own@(Tree@(T)))

fn count_leaves@(T)(Tree@(T) tree) i32:
    match tree:
        Tree.Leaf(_) -> return 1
        Tree.Node(left, right) ->
            let i32 l = count_leaves(left.get())
            let i32 r = count_leaves(right.get())
            return l + r

fn main() i32:
    let Tree@(i32) a = Tree.Leaf(1)
    let Tree@(i32) b = Tree.Leaf(2)
    let Tree@(i32) c = Tree.Leaf(3)
    let Tree@(i32) pair = Tree.Node(Own.alloc(a), Own.alloc(b))
    let Tree@(i32) root = Tree.Node(Own.alloc(pair), Own.alloc(c))

    println("The tree has {count_leaves(root)} leaves")
    return 0
