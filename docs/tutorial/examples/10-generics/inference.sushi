struct Pair@(T, U):
    T first
    U second

fn identity@(T)(nom T x) T:
    return x

fn make_pair@(T, U)(nom T a, nom U b) Pair@(T, U):
    return Pair(first: a, second: b)

fn main() i32:
    let i32 n = identity(nom 7)
    let string s = identity(nom "towel")

    println("identity gives {n} and {s}")

    let Pair@(string, i32) p = make_pair(nom "answer", nom 42)
    println("make_pair built ({p.first}, {p.second})")

    return 0
