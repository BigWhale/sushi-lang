fn count(string[] crew) i32:
    return crew.len()

fn add_one(poke i32 counter) ~:
    counter := counter + 1

fn board(nom string[] crew) ~:
    foreach(name in crew.iter()):
        println("Boarding: {name}")

fn main() i32:
    let string[] crew = from(["Arthur", "Ford"])
    println("Crew size: {count(crew)}")
    println("Still ours: {crew.len()}")

    let i32 jumps = 0
    add_one(poke jumps)
    add_one(poke jumps)
    println("Jumps: {jumps}")

    board(nom crew)
    return 0
