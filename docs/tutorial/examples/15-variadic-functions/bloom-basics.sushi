# A bloom (`arr...`) forwards an existing array into a `...T` slot instead of
# passing its elements one at a time. The callee borrows the source array, and
# the caller keeps it.
fn sum(...i32 nums) i32:
    let i32 total = 0
    foreach(n in nums.iter()):
        total := total + n
    return total

fn main() i32:
    let i32[] xs = from([1, 2, 3, 4])
    let i32 s = sum(xs...)   # bloom: sum borrows xs
    println("sum = {s}")
    return 0
