fn describe(i32 n) string:
    match n:
        0 ->
            return "nothing at all"
        42 ->
            return "the answer"
        0x2A_00 ->
            return "a much larger answer"
        _ ->
            return "just a number"

fn main() i32:
    println("0: {describe(0)}")
    println("42: {describe(42)}")
    println("10752: {describe(10752)}")
    println("7: {describe(7)}")
    return 0
