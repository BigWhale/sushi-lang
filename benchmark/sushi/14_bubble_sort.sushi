fn main() i32:
    let i32 n = 2500
    let i32[] a = from([0; n])
    let i32 seed = 12345
    foreach(i in 0..n):
        seed := (seed * 1103 + 12345) % 65536
        a[i] := seed
    let i32 i = 0
    while (i < n):
        let i32 j = 0
        while (j < n - 1 - i):
            if (a[j] > a[j + 1]):
                let i32 t = a[j]
                a[j] := a[j + 1]
                a[j + 1] := t
            j := j + 1
        i := i + 1
    println("{a[0]} {a[n / 2]} {a[n - 1]}")
    return Result.Ok(0)
