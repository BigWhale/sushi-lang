fn qsort(poke i32[] a, i32 lo, i32 hi) ~:
    if (lo >= hi):
        return Result.Ok(~)
    let i32 p = a[(lo + hi) / 2]
    let i32 i = lo
    let i32 j = hi
    while (i <= j):
        while (a[i] < p):
            i := i + 1
        while (a[j] > p):
            j := j - 1
        if (i <= j):
            let i32 t = a[i]
            a[i] := a[j]
            a[j] := t
            i := i + 1
            j := j - 1
    qsort(poke a, lo, j)??
    qsort(poke a, i, hi)??
    return Result.Ok(~)

fn main() i32:
    let i32 n = 500000
    let i32[] a = from([0; n])
    let i64 seed = 42
    foreach(i in 0..n):
        seed := (seed * 1103515245 + 12345) % 2147483648
        a[i] := (seed % 1000000) as i32
    let i64 check = 0
    match qsort(poke a, 0, n - 1):
        Result.Ok(_) -> check := 0
        Result.Err(_) -> check := 0
    foreach(i in 0..1000):
        check := check + (a[i * 499] as i64)
    println("{a[0]} {a[n - 1]} {check}")
    return Result.Ok(0)
