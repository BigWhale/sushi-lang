fn gcd(i32 a, i32 b) i32:
    let i32 x = a
    let i32 y = b
    while (y != 0):
        let i32 t = x % y
        x := y
        y := t
    return x

fn main() i32:
    let i64 total = 0
    foreach(i in 1..1200):
        foreach(j in 1..1200):
            total := total + (gcd(i, j) as i64)
    println(total)
    return 0
